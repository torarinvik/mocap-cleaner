# Runtime fixtures for bounded selection, recovery veto, preset defaults, and
# totals accumulation via the shared overflow-safe totals kernel.
include "../src/studio/storage_selection_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioStorageSelectionPolicy::retention_preset_valid(0)
    return 2 if not StudioStorageSelectionPolicy::retention_preset_valid(3)
    return 3 if StudioStorageSelectionPolicy::retention_preset_valid(-1)
    return 4 if StudioStorageSelectionPolicy::retention_preset_valid(4)
    return 5 if StudioStorageSelectionPolicy::retention_days(0) != 7
    return 6 if StudioStorageSelectionPolicy::retention_days(1) != 30
    return 7 if StudioStorageSelectionPolicy::DEFAULT_RETENTION_DAYS != 30
    return 8 if StudioStorageSelectionPolicy::retention_days(2) != 90
    return 9 if StudioStorageSelectionPolicy::retention_days(3) != 365

    return 10 if StudioStorageSelectionPolicy::may_toggle(257, 0, true, false, false, 0)
    return 11 if StudioStorageSelectionPolicy::may_toggle(1, -1, true, false, false, 0)
    return 12 if StudioStorageSelectionPolicy::may_toggle(1, 1, true, false, false, 0)
    return 13 if StudioStorageSelectionPolicy::may_toggle(1, 0, true, false, false, 1)
    return 14 if StudioStorageSelectionPolicy::may_toggle(1, 0, true, true, false, 0)
    return 15 if StudioStorageSelectionPolicy::may_toggle(1, 0, false, false, false, 0)
    return 16 if not StudioStorageSelectionPolicy::may_toggle(1, 0, false, true, true, 1)
    return 17 if not StudioStorageSelectionPolicy::must_clear_stale_selection(true, true, true)
    return 18 if not StudioStorageSelectionPolicy::must_clear_stale_selection(true, false, false)
    return 19 if StudioStorageSelectionPolicy::must_clear_stale_selection(false, false, true)

    mutable count: i64 = 0
    mutable total: i64 = 0
    while count < StudioStorageSelectionPolicy::MAX_ROWS:
        return 20 if not StudioStorageSelectionPolicy::can_add_selected(StudioStorageSelectionPolicy::MAX_ROWS, count, total, StudioStorageTotalsKernel::MAX_ITEM_BYTES)
        total <- StudioStorageSelectionPolicy::next_selected_bytes(total, StudioStorageTotalsKernel::MAX_ITEM_BYTES)
        count <- StudioStorageSelectionPolicy::next_selected_count(count, StudioStorageSelectionPolicy::MAX_ROWS)
    return 21 if count != 256
    return 22 if total != StudioStorageSelectionPolicy::MAX_BYTES
    return 23 if StudioStorageSelectionPolicy::can_add_selected(256, count, total, 0)
    return 24 if StudioStorageSelectionPolicy::can_add_selected(256, 0, total, 1)
    return 25 if StudioStorageSelectionPolicy::can_add_selected(256, 0, -1, 1)
    return 26 if StudioStorageSelectionPolicy::can_add_selected(256, 0, 0, StudioStorageTotalsKernel::MAX_ITEM_BYTES + 1)

    _ = puts("PASS bounded Storage selection and totals")
    0
