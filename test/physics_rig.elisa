include "../src/io/console.elisa"
include "../src/physics/rig_physics.elisa"
include "../src/io/console.elisa"

def load_or_empty(path: cstr) -> GlbDocument::Document:
    doc: GlbDocument::Document = catch GlbDocument::load(path):
        value: value
        error failure: GlbDocument::Document()
    return move doc

def one(kind: i64, fix: bool) -> darray[Physics::PhysOp]:
    mutable ops: darray[Physics::PhysOp] = []
    if kind == 0:
        ops.push(Physics::balance(fix))
    elif kind == 1:
        ops.push(Physics::ballistic(fix))
    else:
        ops.push(Physics::momentum(fix, 0))
    return ops

def main() -> i32:
    path: cstr = "../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"
    present: i32 = catch GlbDocument::load(path):
        value: 1
        GlbDocument::GlbDocumentError.OpenFailed: 0
        error failure: 2
    # Support region on synthetic feet: square 0..100000 um, 6 cm margin.
    xs: darray[i64] = [0, 100000, 0, 100000]
    zs: darray[i64] = [0, 0, 100000, 100000]
    return 20 if not Physics::inside(&xs, &zs, 50000, 50000, 60000)
    return 21 if not Physics::inside(&xs, &zs, 50000, 140000, 60000)
    return 22 if Physics::inside(&xs, &zs, 50000, 200000, 60000)
    return 23 if Physics::inside(&xs, &zs, 300000, 300000, 60000)
    one_foot_x: darray[i64] = [0, 0]
    one_foot_z: darray[i64] = [0, 200000]
    return 24 if not Physics::inside(&one_foot_x, &one_foot_z, 30000, 100000, 60000)
    return 25 if Physics::inside(&one_foot_x, &one_foot_z, 90000, 100000, 60000)
    empty: darray[i64] = []
    return 26 if Physics::inside(&empty, &empty, 0, 0, 60000)
    return 0 if present == 0
    return 9 if present != 1
    mutable doc: GlbDocument::Document = load_or_empty(path)
    anim: i64 = GlbDocument::find_animation(&doc, "jab")
    return 1 if anim < 0

    # Centre of mass sits between the feet and above them in the first frame.
    c0: Rig::Clip = Rig::load(&doc, anim.usize())
    coms: darray[MotionQuat::V] = Physics::com_track(&c0)
    return 2 if coms.count.i64() != c0.frames
    floor: i64 = Physics::floor_of(&c0)
    length: f64 = Physics::leg_length(&c0)
    return 3 if length <= 0.1
    height: f64 = coms[0].y - Limb::unmicro(floor)
    return 4 if height < length * 0.8 or height > length * 1.6

    # Detector: a standing jab is planted throughout and mostly balanced.
    mutable c1: Rig::Clip = Rig::load(&doc, anim.usize())
    b_ops: darray[Physics::PhysOp] = one(0, false)
    b: Physics::Findings = Physics::run_clip(&c1, &b_ops)
    Out::field("jab planted: ", b.planted)
    Out::field("jab unbalanced: ", b.unbalanced)
    Out::field("frames: ", c1.frames)
    Out::field("worst first: ", b.worst_first)
    Out::field("worst run: ", b.worst_run)
    return 5 if b.planted < c1.frames * 9 / 10
    return 6 if b.unbalanced * 4 > c1.frames
    return 7 if b.changed != 0

    # Momentum: detector changes nothing; the fix never adds spikes.
    mutable c2: Rig::Clip = Rig::load(&doc, anim.usize())
    m_ops: darray[Physics::PhysOp] = one(2, true)
    m: Physics::Findings = Physics::run_clip(&c2, &m_ops)
    Out::field("jab momentum cap: ", m.momentum_cap)
    Out::field("jab momentum before: ", m.momentum_before)
    Out::field("jab momentum after: ", m.momentum_after)
    return 8 if m.momentum_cap < 2000
    return 10 if m.momentum_after > m.momentum_before
    return 14 if m.momentum_drift > Physics::MomentumSettings::MAX_DRIFT

    # Ballistic on a synthetic flight: lift the hips by a bump that breaks
    # the parabola; the fix restores a gravity arc (residual drops).
    mutable c3: Rig::Clip = Rig::load(&doc, anim.usize())
    hips: i64 = Rig::node_of(&c3, Roles::Joint.Hips.i64())
    return 11 if hips < 0 or c3.frames < 20
    mutable left: darray[bool] = []
    mutable right: darray[bool] = []
    for f in 0..<c3.frames:
        air: bool = f >= 5 and f <= 14
        left.push(not air)
        right.push(not air)
        if f == 9:
            p: MotionQuat::V = Rig::local_pos(&c3, f, hips)
            _ = Rig::set_local_pos(&c3, f, hips, Rig::vadd(p, Rig::v(0.0, 6.0, 0.0)))
    mutable s: Physics::Findings = Physics::empty_findings()
    Physics::ballistic_fix(&c3, Physics::ballistic(true), &left, &right, &s)
    Out::field("synthetic flights: ", s.flights)
    Out::field("synthetic residual before: ", s.ballistic_before)
    Out::field("synthetic residual after: ", s.ballistic_after)
    return 12 if s.flights != 1 or s.airborne != 10
    return 13 if s.ballistic_after * 10 > s.ballistic_before
    return 0
