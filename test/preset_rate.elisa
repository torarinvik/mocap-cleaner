# The default cleanup keeps its time span at any frame rate: the 120 Hz
# boxing preset's 20-frame leg median is 5 frames at 30 Hz and 10 at 60 Hz;
# its 32 smoothing passes become 2 and 8; despike keeps its passes.
include "../src/ops/presets.elisa"

def strengths(rate: i64, out: mutable darray[i64]&) -> void:
    for op in Presets::operations_at(Presets::Preset.Boxing, rate) |out|:
        out.push(op.strength)

def main() -> i32:
    mutable tuned: darray[i64] = []
    strengths(120, &tuned)
    return 1 if tuned.count != 3 or tuned[0] != 20 or tuned[1] != 32 or tuned[2] != 2
    mutable thirty: darray[i64] = []
    strengths(30, &thirty)
    return 2 if thirty[0] != 5 or thirty[1] != 2 or thirty[2] != 2
    mutable sixty: darray[i64] = []
    strengths(60, &sixty)
    return 3 if sixty[0] != 10 or sixty[1] != 8 or sixty[2] != 2
    mutable slow: darray[i64] = []
    strengths(1, &slow)
    return 4 if slow[0] != 1 or slow[1] != 1
    mutable bogus: darray[i64] = []
    strengths(0, &bogus)
    return 5 if bogus[0] != 20 or bogus[1] != 32
    0
