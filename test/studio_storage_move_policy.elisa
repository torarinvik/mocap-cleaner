include "../src/studio/storage_move_policy.elisa"

extern puts(text: cstr) -> i64

def expected_outcome(move_state: i64, write_state: i64, rollback_state: i64) -> i64:
    if move_state < StudioStorageMovePolicy::MoveState.NotAttempted.i64() or move_state > StudioStorageMovePolicy::MoveState.UnknownAfterFailure.i64():
        return StudioStorageMovePolicy::Outcome.Invalid.i64()
    if write_state < StudioStorageMovePolicy::WriteState.NotAttempted.i64() or write_state > StudioStorageMovePolicy::WriteState.Unknown.i64():
        return StudioStorageMovePolicy::Outcome.Invalid.i64()
    if rollback_state < StudioStorageMovePolicy::RollbackState.NotAttempted.i64() or rollback_state > StudioStorageMovePolicy::RollbackState.Unknown.i64():
        return StudioStorageMovePolicy::Outcome.Invalid.i64()
    if move_state != StudioStorageMovePolicy::MoveState.Verified.i64():
        return StudioStorageMovePolicy::Outcome.Invalid.i64() if write_state != StudioStorageMovePolicy::WriteState.NotAttempted.i64() or rollback_state != StudioStorageMovePolicy::RollbackState.NotAttempted.i64()
        return StudioStorageMovePolicy::Outcome.NotStarted.i64() if move_state == StudioStorageMovePolicy::MoveState.NotAttempted.i64()
        return StudioStorageMovePolicy::Outcome.MoveFailedOriginal.i64() if move_state == StudioStorageMovePolicy::MoveState.FailedOriginalKnown.i64()
        return StudioStorageMovePolicy::Outcome.MoveUnknown.i64()
    if write_state == StudioStorageMovePolicy::WriteState.NotAttempted.i64():
        return StudioStorageMovePolicy::Outcome.ReceiptPending.i64() if rollback_state == StudioStorageMovePolicy::RollbackState.NotAttempted.i64()
        return StudioStorageMovePolicy::Outcome.Invalid.i64()
    if write_state == StudioStorageMovePolicy::WriteState.Unknown.i64():
        return StudioStorageMovePolicy::Outcome.DurabilityUnknown.i64() if rollback_state == StudioStorageMovePolicy::RollbackState.NotAttempted.i64()
        return StudioStorageMovePolicy::Outcome.Invalid.i64()
    if write_state == StudioStorageMovePolicy::WriteState.Succeeded.i64():
        return StudioStorageMovePolicy::Outcome.Recorded.i64() if rollback_state == StudioStorageMovePolicy::RollbackState.NotAttempted.i64()
        return StudioStorageMovePolicy::Outcome.Invalid.i64()
    return StudioStorageMovePolicy::Outcome.RollbackRequired.i64() if rollback_state == StudioStorageMovePolicy::RollbackState.NotAttempted.i64()
    return StudioStorageMovePolicy::Outcome.OriginalRestored.i64() if rollback_state == StudioStorageMovePolicy::RollbackState.Succeeded.i64()
    return StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64() if rollback_state == StudioStorageMovePolicy::RollbackState.Failed.i64()
    StudioStorageMovePolicy::Outcome.RollbackUnknownReceiptRetained.i64()

def main() -> i32:
    mutable mask: i64 = 0
    while mask < 32:
        durable: bool = mask % 2 == 1
        identity_valid: bool = (mask / 2) % 2 == 1
        fresh_match: bool = (mask / 4) % 2 == 1
        fresh_eligible: bool = (mask / 8) % 2 == 1
        confirmed: bool = (mask / 16) % 2 == 1
        return 1 if StudioStorageMovePolicy::may_move(durable, identity_valid, fresh_match, fresh_eligible, confirmed) != (mask == 31)
        mask <- mask + 1

    mutable move_state: i64 = 0
    while move_state < 4:
        mutable write_state: i64 = 0
        while write_state < 4:
            mutable rollback_state: i64 = 0
            while rollback_state < 4:
                expected: i64 = expected_outcome(move_state, write_state, rollback_state)
                actual: i64 = StudioStorageMovePolicy::outcome(move_state, write_state, rollback_state)
                return 2 if actual != expected
                rollback_state <- rollback_state + 1
            write_state <- write_state + 1
        move_state <- move_state + 1

    return 3 if StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.Verified.i64(), StudioStorageMovePolicy::WriteState.Failed.i64(), StudioStorageMovePolicy::RollbackState.NotAttempted.i64()) != StudioStorageMovePolicy::Outcome.RollbackRequired.i64()
    return 4 if StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.Verified.i64(), StudioStorageMovePolicy::WriteState.Failed.i64(), StudioStorageMovePolicy::RollbackState.Succeeded.i64()) != StudioStorageMovePolicy::Outcome.OriginalRestored.i64()
    return 5 if StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.Verified.i64(), StudioStorageMovePolicy::WriteState.Failed.i64(), StudioStorageMovePolicy::RollbackState.Failed.i64()) != StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64()
    return 6 if StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.Verified.i64(), StudioStorageMovePolicy::WriteState.Failed.i64(), StudioStorageMovePolicy::RollbackState.Unknown.i64()) != StudioStorageMovePolicy::Outcome.RollbackUnknownReceiptRetained.i64()
    return 7 if StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.FailedOriginalKnown.i64(), StudioStorageMovePolicy::WriteState.NotAttempted.i64(), StudioStorageMovePolicy::RollbackState.NotAttempted.i64()) == StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.UnknownAfterFailure.i64(), StudioStorageMovePolicy::WriteState.NotAttempted.i64(), StudioStorageMovePolicy::RollbackState.NotAttempted.i64())
    return 8 if StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MoveState.NotAttempted.i64(), StudioStorageMovePolicy::WriteState.Failed.i64(), StudioStorageMovePolicy::RollbackState.NotAttempted.i64()) != StudioStorageMovePolicy::Outcome.Invalid.i64()
    _ = puts("studio storage move policy: gate and 64 transaction states pass")
    return 0
