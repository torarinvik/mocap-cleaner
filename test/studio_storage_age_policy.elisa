# Boundary checks for storage timestamp validation and completed age days.
include "../src/studio/storage_age_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioStorageAgePolicy::timestamp_status(100, 100) != StudioStorageAgePolicy::Status::VALID
    return 2 if StudioStorageAgePolicy::completed_age_days(100, 100) != 0
    return 3 if StudioStorageAgePolicy::completed_age_days(1, 86400) != 0
    return 4 if StudioStorageAgePolicy::completed_age_days(0, 86400) != 1
    return 5 if StudioStorageAgePolicy::completed_age_days(0, StudioStorageAgePolicy::Age::MAX_SECONDS) != StudioStorageAgePolicy::Age::MAX_DAYS
    return 6 if StudioStorageAgePolicy::completed_age_days(0, StudioStorageAgePolicy::Age::MAX_SECONDS + 1) != StudioStorageAgePolicy::Age::MAX_DAYS
    return 7 if StudioStorageAgePolicy::completed_age_days(0 - 86400, 0) != 1
    return 8 if StudioStorageAgePolicy::timestamp_status(101, 100) != StudioStorageAgePolicy::Status::FUTURE
    return 9 if StudioStorageAgePolicy::timestamp_status(0, 0 - 1) != StudioStorageAgePolicy::Status::INVALID
    return 10 if StudioStorageAgePolicy::timestamp_status(StudioStorageAgePolicy::Time::MAX_TIMESTAMP_SECONDS + 1, 0) != StudioStorageAgePolicy::Status::INVALID
    return 11 if StudioStorageAgePolicy::timestamp_status(0 - StudioStorageAgePolicy::Time::MAX_TIMESTAMP_SECONDS - 1, 0) != StudioStorageAgePolicy::Status::INVALID
    return 12 if StudioStorageAgePolicy::timestamp_status(StudioStorageAgePolicy::Time::MAX_TIMESTAMP_SECONDS, StudioStorageAgePolicy::Time::MAX_TIMESTAMP_SECONDS) != StudioStorageAgePolicy::Status::VALID
    return 13 if StudioStorageAgePolicy::completed_age_days(0 - StudioStorageAgePolicy::Time::MAX_TIMESTAMP_SECONDS, 0) != StudioStorageAgePolicy::Age::MAX_DAYS
    return 14 if StudioStorageAgePolicy::timestamp_status(0, StudioStorageAgePolicy::Time::MAX_TIMESTAMP_SECONDS + 1) != StudioStorageAgePolicy::Status::INVALID
    _ = puts("studio storage age policy: timestamp and age boundaries pass")
    return 0
