include "../src/studio/io/storage_manifest.elisa"
include "../src/studio/io/storage_manifest_file.elisa"

@link_name("fopen")
extern test_manifest_fopen(path: u8&, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("fwrite")
extern test_manifest_fwrite(bytes: u8&, size: usize, count: usize, file: mutable heap void&) -> usize can[Blocking.IO]
@link_name("fclose")
extern test_manifest_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]
@link_name("unlink")
extern test_manifest_unlink(path: u8&) -> i32 can[Blocking.IO]

extern puts(text: cstr) -> i64

def bytes(text: sview) -> darray[u8]:
    mutable out: darray[u8] = []
    for byte in text:
        out.push(byte)
    out

def same_bytes(a: darray[u8]&, b: darray[u8]&) -> bool:
    return false if a.count != b.count
    for index in 0..<a.count |a, b|:
        return false if a[index] != b[index]
    true

def write_file(path: cstr, contents: darray[u8]&) -> bool:
    mutable ok: bool = false
    can Blocking.IO, Memory.Allocate, Memory.Release:
        file: mutable heap void&? = test_manifest_fopen(path.cast[u8&], "wb".cast[u8&])
        if file is opened:
            wrote: usize = test_manifest_fwrite(&contents[0], 1, contents.count, opened) if contents.count > 0 else 0
            closed: i32 = test_manifest_fclose(opened)
            ok <- wrote == contents.count and closed == 0
    ok

def main() -> i32:
    return 18 if StudioStorageCleanupPolicy::Kind.Recovery.i64() != StudioStorageReceiptPolicy::Kind.Recovery.i64()
    return 19 if StudioStorageCleanupPolicy::Kind.TempExport.i64() != StudioStorageReceiptPolicy::Kind.TemporaryExport.i64()
    return 20 if StudioStorageCleanupPolicy::Kind.GeneratedReport.i64() != StudioStorageReceiptPolicy::Kind.GeneratedReport.i64()
    return 21 if StudioStorageCleanupPolicy::Capacity::KIND_COUNT != StudioStorageReceiptPolicy::Limit::KIND_COUNT
    return 22 if StudioStorageCleanupPolicy::Limit::MAX_ITEM_BYTES != StudioStorageReceiptPolicy::Limit::MAX_ITEM_BYTES
    receipt: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
        state: StudioStorageManifest::IN_TRASH,
        kind: StudioStorageCleanupPolicy::Kind.GeneratedReport.i64(),
        device: 17, inode: 987654321, size_bytes: 12345,
        modified_seconds: 0 - 1791288000, modified_nanoseconds: 765432100,
        original_path: bytes("build/reports/line\n\t😀.report.json"),
        trashed_path: bytes("/Users/example/.Trash/report copy.json")
    }
    return 1 if not StudioStorageManifest::valid(receipt)
    records: darray[StudioStorageManifest::Entry] = [receipt]
    encoded: darray[u8] = []
    return 2 if not StudioStorageManifest::encode(records, &encoded)
    return 3 if encoded.count < 32
    decoded: darray[StudioStorageManifest::Entry] = []
    return 4 if not StudioStorageManifest::decode(encoded, &decoded)
    return 5 if decoded.count != 1
    restored: StudioStorageManifest::Entry = decoded[0]
    return 25 if restored.state != StudioStorageManifest::IN_TRASH
    return 6 if restored.kind != receipt.kind or restored.device != receipt.device or restored.inode != receipt.inode
    return 7 if restored.size_bytes != receipt.size_bytes or restored.modified_seconds != receipt.modified_seconds or restored.modified_nanoseconds != receipt.modified_nanoseconds
    return 8 if not same_bytes(restored.original_path, receipt.original_path)
    return 9 if not same_bytes(restored.trashed_path, receipt.trashed_path)

    preserved: darray[StudioStorageManifest::Entry] = [receipt]
    wrong_version: darray[u8] = encoded
    wrong_version[28] <- 50
    return 10 if StudioStorageManifest::decode(wrong_version, &preserved)
    return 11 if preserved.count != 1 or not same_bytes(preserved[0].original_path, receipt.original_path)

    bad_hex: darray[u8] = encoded
    bad_hex[bad_hex.count - 2] <- 122
    return 12 if StudioStorageManifest::decode(bad_hex, &preserved)
    return 13 if preserved.count != 1 or not same_bytes(preserved[0].trashed_path, receipt.trashed_path)

    mutable invalid: StudioStorageManifest::Entry = receipt
    invalid.modified_nanoseconds <- 1000000000
    return 14 if StudioStorageManifest::valid(invalid)
    invalid <- receipt
    invalid.original_path <- [47, 0, 97]
    return 15 if StudioStorageManifest::valid(invalid)
    invalid.original_path <- [47, 192, 175]
    return 23 if StudioStorageManifest::valid(invalid)
    invalid.original_path <- [47, 237, 160, 128]
    return 24 if StudioStorageManifest::valid(invalid)

    duplicate: darray[StudioStorageManifest::Entry] = [receipt, receipt]
    untouched: darray[u8] = bytes("leave this buffer as-is")
    before: darray[u8] = untouched
    return 16 if StudioStorageManifest::encode(duplicate, &untouched)

    registered: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
        state: StudioStorageManifest::REGISTERED,
        kind: StudioStorageCleanupPolicy::Kind.TempExport.i64(),
        device: 17, inode: 987654322, size_bytes: 124,
        modified_seconds: 1791288000, modified_nanoseconds: 0,
        original_path: bytes("build/exports/result.glb"), trashed_path: []
    }
    return 26 if not StudioStorageManifest::valid(registered)
    active_records: darray[StudioStorageManifest::Entry] = [registered]
    active_bytes: darray[u8] = []
    return 27 if not StudioStorageManifest::encode(active_records, &active_bytes)
    active_decoded: darray[StudioStorageManifest::Entry] = []
    return 28 if not StudioStorageManifest::decode(active_bytes, &active_decoded)
    return 29 if active_decoded.count != 1 or active_decoded[0].state != StudioStorageManifest::REGISTERED
    return 30 if active_decoded[0].trashed_path.count != 0
    current_at_old_destination: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
        state: StudioStorageManifest::REGISTERED,
        kind: StudioStorageCleanupPolicy::Kind.TempExport.i64(),
        device: 17, inode: 987654322, size_bytes: 124,
        modified_seconds: 1791288000, modified_nanoseconds: 0,
        original_path: receipt.original_path, trashed_path: []
    }
    mutable older_receipt: StudioStorageManifest::Entry = receipt
    older_receipt.inode <- older_receipt.inode + 1
    coexist: darray[StudioStorageManifest::Entry] = [receipt, current_at_old_destination, older_receipt]
    coexist_bytes: darray[u8] = []
    return 37 if not StudioStorageManifest::encode(coexist, &coexist_bytes)
    coexist_decoded: darray[StudioStorageManifest::Entry] = []
    return 38 if not StudioStorageManifest::decode(coexist_bytes, &coexist_decoded)
    return 39 if coexist_decoded.count != 3

    path: cstr = "build/studio_storage_manifest_test.txt"
    return 31 if not write_file(path, active_bytes)
    mutable loaded: darray[StudioStorageManifest::Entry] = []
    return 32 if not StudioStorageManifestFile::load(path, &loaded)
    return 33 if loaded.count != 1 or loaded[0].state != StudioStorageManifest::REGISTERED
    malformed: darray[u8] = bytes("not a storage manifest\n")
    return 34 if not write_file(path, malformed)
    previous_loaded: darray[StudioStorageManifest::Entry] = loaded
    return 35 if StudioStorageManifestFile::load(path, &loaded)
    return 36 if loaded.count != previous_loaded.count or loaded[0].state != previous_loaded[0].state
    _ = test_manifest_unlink(path.cast[u8&])
    return 17 if not same_bytes(untouched, before)

    _ = puts("studio storage manifest: ownership/Trash states, path escaping, bounds, and failure atomicity pass")
    0
