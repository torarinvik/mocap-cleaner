include "../src/studio/export_result.elisa"

def main() -> i64:
    return 1 if StudioExportResult::move_focus(StudioExportResult::Action::OPEN, -1) != StudioExportResult::Action::DONE
    return 2 if StudioExportResult::move_focus(StudioExportResult::Action::OPEN, 1) != StudioExportResult::Action::SHOW_IN_FOLDER
    return 3 if StudioExportResult::move_focus(StudioExportResult::Action::SHOW_IN_FOLDER, 1) != StudioExportResult::Action::DONE
    return 4 if StudioExportResult::move_focus(StudioExportResult::Action::DONE, 1) != StudioExportResult::Action::OPEN
    return 5 if StudioExportResult::move_focus(StudioExportResult::Action::DONE, -1) != StudioExportResult::Action::SHOW_IN_FOLDER
    0
