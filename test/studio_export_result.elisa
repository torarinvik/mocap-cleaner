include "../src/studio/export_result.elisa"

def main() -> i64:
    return 1 if StudioExportResult::move_focus(StudioExportResult::OPEN, -1) != StudioExportResult::DONE
    return 2 if StudioExportResult::move_focus(StudioExportResult::OPEN, 1) != StudioExportResult::SHOW_IN_FOLDER
    return 3 if StudioExportResult::move_focus(StudioExportResult::SHOW_IN_FOLDER, 1) != StudioExportResult::DONE
    return 4 if StudioExportResult::move_focus(StudioExportResult::DONE, 1) != StudioExportResult::OPEN
    return 5 if StudioExportResult::move_focus(StudioExportResult::DONE, -1) != StudioExportResult::SHOW_IN_FOLDER
    0
