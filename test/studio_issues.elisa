# Issue samples collapse into deterministic, selectable contiguous rows.
include "../src/studio/issues.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    mutable samples: darray[StudioIssues::Sample] = []
    samples.push(StudioIssues::Sample{frame: 1, issue_type: 2, subject_id: -1, source_revision: 7, severity: 200, value: 110, threshold: 100})
    samples.push(StudioIssues::Sample{frame: 2, issue_type: 2, subject_id: -1, source_revision: 7, severity: 400, value: 120, threshold: 100})
    samples.push(StudioIssues::Sample{frame: 3, issue_type: 2, subject_id: -1, source_revision: 7, severity: 400, value: 120, threshold: 100})
    samples.push(StudioIssues::Sample{frame: 4, issue_type: 3, subject_id: -1, source_revision: 7, severity: 100, value: 900, threshold: 100})
    samples.push(StudioIssues::Sample{frame: 5, issue_type: 3, subject_id: -1, source_revision: 8, severity: 700, value: 130, threshold: 100})
    samples.push(StudioIssues::Sample{frame: 7, issue_type: 3, subject_id: -1, source_revision: 8, severity: 800, value: 140, threshold: 100})
    rows: darray[StudioIssues::Issue] = StudioIssues::group(&samples)
    return 1 if rows.count != 4
    return 2 if not rows[0].selectable or rows[0].first_frame != 1 or rows[0].last_frame != 3
    return 3 if rows[0].peak_frame != 2 or rows[0].severity != 400 or rows[0].peak_value != 120 or rows[0].threshold != 100
    return 4 if rows[1].issue_type != 3 or rows[1].source_revision != 7
    return 5 if rows[2].source_revision != 8 or rows[2].first_frame != 5
    return 6 if rows[3].first_frame != 7 or rows[3].last_frame != 7
    _ = puts("studio_issues: grouping boundaries, peak and revision identity pass")
    return 0
