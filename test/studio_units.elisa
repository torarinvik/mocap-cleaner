# Headless test of parameter units and drag readouts: each operation kind's
# strength unit, channel deviation units, frame windows in milliseconds,
# and the gizmo angle / distance readouts.
include "../src/studio/state/readout.elisa"
include "../src/studio/state/session_state.elisa"

extern puts(text: cstr) -> i64

def main() -> i32 can[Global{Read, Write}]:
    can Global{Read, Write}:
        return 1 if StudioChrome::param_unit(SessionState::kind_code(Ops::Kind.Despike)) != StudioChrome::ParameterUnit.Passes
        return 2 if StudioChrome::param_unit(SessionState::kind_code(Ops::Kind.SmoothPath)) != StudioChrome::ParameterUnit.Passes
        return 3 if StudioChrome::param_unit(SessionState::kind_code(Ops::Kind.CloseSeam)) != StudioChrome::ParameterUnit.Frames
        return 4 if StudioChrome::param_unit(SessionState::kind_code(Ops::Kind.Median)) != StudioChrome::ParameterUnit.Frames
        return 5 if StudioChrome::param_unit(SessionState::kind_code(Ops::Kind.LimitWring)) != StudioChrome::ParameterUnit.ChannelMillionths
        return 6 if StudioChrome::param_unit(SessionState::kind_code(Ops::Kind.PinContacts)) != StudioChrome::ParameterUnit.None
        # Legacy small-angle display approximation, not the generic channel limit unit.
        return 7 if StudioChrome::wring_degrees(200000) != 23
        return 8 if StudioChrome::wring_degrees(0) != 0
        # A 4-frame median radius at 120 fps is 33 ms.
        return 9 if StudioChrome::clip_millis(4, 120) != 33
        # 30 degrees about z, read to the tenth.
        q: Geometry::Quat = Geometry::Quat{x: 0.0, y: 0.0, z: 0.258819, w: 0.965926}
        a: i64 = StudioReadout::angle_tenths(q)
        return 10 if a < 299 or a > 301
        # The long way round (negated quaternion) reads the same short arc.
        return 11 if StudioReadout::angle_tenths(Geometry::Quat{x: 0.0, y: 0.0, z: 0.0 - 0.258819, w: 0.0 - 0.965926}) != a
        return 12 if StudioReadout::angle_tenths(Geometry::Quat{x: 0.0, y: 0.0, z: 0.0, w: 1.0}) != 0
        # 90 degrees and a 3-4-5 offset of 5 cm.
        r: i64 = StudioReadout::angle_tenths(Geometry::Quat{x: 0.707107, y: 0.0, z: 0.0, w: 0.707107})
        return 13 if r < 899 or r > 901
        return 14 if StudioReadout::millimetres(Geometry::Vec3{x: 0.03, y: 0.04, z: 0.0}) != 50
        _ = puts("studio units: ok")
        return 0
