# A separate character model bound to a take: the boxer as its own model
# binds every skin joint by name and skins exactly like the take's embedded
# mesh; a model with no skin is refused; the binding policy holds.
include "../src/studio/app/scene.elisa"
include "../src/studio/app/character.elisa"

extern puts(text: cstr) -> i64

const PATH: cstr = "../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"

def close(a: Geometry::Vec3, b: Geometry::Vec3) -> bool:
    d: Geometry::Vec3 = Geometry::vec3_sub(a, b)
    return Geometry::vec3_length_squared(d) < 0.0000001

def run(c: StudioModel::Clip&, m: StudioCharacter::Model&) -> i32:
    b: StudioCharacter::Binding = StudioCharacter::bind(m, c)
    joints: usize = GlbSkinMesh::joint_count(&m.mesh)
    return 3 if b.slot.count != joints or b.mode.count != joints
    return 4 if b.coverage != StudioCharacterBind::Coverage::FULL or not StudioCharacter::drawable(&b)
    for j in 0..<joints |j, b|:
        return 5 if b.mode[j] != StudioCharacterBind::Mode.Direct
    mesh: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(PATH):
        value: value
        error failure: GlbSkinMesh::empty()
    frame: i64 = c.frames / 2
    malformed: StudioCharacter::Binding = StudioCharacter::Binding{slot: b.slot, mode: [], anchor: [], offset: [], bound: b.bound, coverage: b.coverage}
    return 8 if StudioCharacter::pose(m, &malformed, c, frame).count != 0
    want: darray[Geometry::Vec3] = StudioScene::pose_mesh(c, &mesh, frame)
    got: darray[Geometry::Vec3] = StudioCharacter::pose(m, &b, c, frame)
    return 6 if want.count == 0 or got.count != want.count
    for v in 0..<got.count |v, got, want|:
        return 7 if not close(got[v], want[v])
    return 0

def main() -> i32:
    # Rest metadata is an exact parallel array, including the empty shape.
    return 32 if not StudioCharacterBind::rest_shape_valid(0, 0)
    return 33 if not StudioCharacterBind::rest_shape_valid(4, 4)
    return 34 if StudioCharacterBind::rest_shape_valid(4, 3)
    return 35 if StudioCharacterBind::rest_shape_valid(4, 5)
    return 36 if StudioCharacterBind::rest_shape_valid(-1, -1)
    return 37 if StudioCharacterBind::rest_shape_valid(0, -1)
    return 20 if StudioCharacterBind::match_slot(3, 5) != 3
    return 21 if StudioCharacterBind::match_slot(-1, 5) != 5
    return 22 if StudioCharacterBind::match_slot(-1, -1) != -1
    return 29 if StudioCharacterBind::match_slot(-1, 7) != 7
    return 30 if StudioCharacterBind::slot_ok(-1, 4) or not StudioCharacterBind::slot_ok(3, 4)
    return 31 if StudioCharacterBind::slot_ok(4, 4)
    return 23 if StudioCharacterBind::mode(-1, 2) != StudioCharacterBind::Mode.Inherited
    return 24 if StudioCharacterBind::mode(-1, -1) != StudioCharacterBind::Mode.Rest
    return 25 if StudioCharacterBind::coverage(1, 3) != 333
    return 26 if StudioCharacterBind::drawable(499) or not StudioCharacterBind::drawable(500)
    # Coverage is monotone in the bound share (G84: not yet proved).
    for t in 1..<257 |t|:
        for k in 0..<t |k, t|:
            return 28 if StudioCharacterBind::coverage(k.i64(), t.i64()) > StudioCharacterBind::coverage(k.i64() + 1, t.i64())
    return 27 if StudioCharacter::load("build/no-such-model.glb") != null
    empty: StackState::Stack = StudioModel::initial_stack()
    built: StudioModel::Clip? = StudioModel::build(PATH, "jab", &empty)
    model: StudioCharacter::Model? = StudioCharacter::load(PATH)
    if built is c:
        if model is m:
            code: i32 = run(c, m)
            return code if code != 0
            _ = puts("studio character: name binding, policy and skinning pass")
            return 0
        return 2
    return 1
