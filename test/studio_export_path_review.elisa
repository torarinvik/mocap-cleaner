include "../src/studio/export_path_review.elisa"

def main() -> i64:
    return 1 if StudioExportPathReview::initial_focus(0, 3) != StudioExportPathReview::Control.Next.i64()
    return 2 if StudioExportPathReview::initial_focus(0, 1) != StudioExportPathReview::Control.Done.i64()
    return 3 if StudioExportPathReview::move_focus(StudioExportPathReview::Control.Next.i64(), -1, 0, 3) != StudioExportPathReview::Control.Done.i64()
    return 4 if StudioExportPathReview::move_focus(StudioExportPathReview::Control.Next.i64(), 1, 1, 3) != StudioExportPathReview::Control.Done.i64()
    return 5 if StudioExportPathReview::move_focus(StudioExportPathReview::Control.Done.i64(), 1, 1, 3) != StudioExportPathReview::Control.Previous.i64()
    return 6 if StudioExportPathReview::move_focus(StudioExportPathReview::Control.Previous.i64(), 1, 2, 3) != StudioExportPathReview::Control.Done.i64()
    return 7 if StudioExportPathReview::move_page(0, -1, 3) != 0
    return 8 if StudioExportPathReview::move_page(2, 1, 3) != 2
    return 9 if StudioExportPathReview::move_page(1, 1, 3) != 2
    return 10 if StudioExportPathReview::move_page(1, -1, 3) != 0
    0
