include "../src/studio/export_path_review.elisa"

def main() -> i64:
    return 1 if StudioExportPathReview::initial_focus(0, 3) != StudioExportPathReview::NEXT
    return 2 if StudioExportPathReview::initial_focus(0, 1) != StudioExportPathReview::DONE
    return 3 if StudioExportPathReview::move_focus(StudioExportPathReview::NEXT, -1, 0, 3) != StudioExportPathReview::DONE
    return 4 if StudioExportPathReview::move_focus(StudioExportPathReview::NEXT, 1, 1, 3) != StudioExportPathReview::DONE
    return 5 if StudioExportPathReview::move_focus(StudioExportPathReview::DONE, 1, 1, 3) != StudioExportPathReview::PREVIOUS
    return 6 if StudioExportPathReview::move_focus(StudioExportPathReview::PREVIOUS, 1, 2, 3) != StudioExportPathReview::DONE
    return 7 if StudioExportPathReview::move_page(0, -1, 3) != 0
    return 8 if StudioExportPathReview::move_page(2, 1, 3) != 2
    return 9 if StudioExportPathReview::move_page(1, 1, 3) != 2
    return 10 if StudioExportPathReview::move_page(1, -1, 3) != 0
    0
