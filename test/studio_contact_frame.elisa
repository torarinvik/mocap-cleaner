# Typed inclusive contact interval endpoint edits.
include "../src/studio/contact_frame_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    first: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::FIRST, 1)
    return 1 if not first.valid or first.first != 0 or first.last != 20
    first_middle: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::FIRST, 15)
    return 2 if not first_middle.valid or first_middle.first != 14 or first_middle.last != 20
    last: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::LAST, 100)
    return 3 if not last.valid or last.first != 10 or last.last != 99
    last_middle: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::LAST, 11)
    return 4 if not last_middle.valid or last_middle.first != 10 or last_middle.last != 10
    reject_first_inversion: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::FIRST, 22)
    return 5 if reject_first_inversion.valid or reject_first_inversion.first != 10 or reject_first_inversion.last != 20
    reject_last_inversion: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::LAST, 9)
    return 6 if reject_last_inversion.valid or reject_last_inversion.first != 10 or reject_last_inversion.last != 20
    reject_below_clip: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::FIRST, 0)
    return 7 if reject_below_clip.valid or reject_below_clip.first != 10 or reject_below_clip.last != 20
    reject_above_clip: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, StudioContactFramePolicy::LAST, 101)
    return 8 if reject_above_clip.valid or reject_above_clip.first != 10 or reject_above_clip.last != 20
    reject_target: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(10, 20, 100, 7, 15)
    return 9 if reject_target.valid or reject_target.first != 10 or reject_target.last != 20
    maximum: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(0, 999998, StudioContactFramePolicy::MAX_FRAMES, StudioContactFramePolicy::LAST, StudioContactFramePolicy::MAX_FRAMES)
    return 10 if not maximum.valid or maximum.first != 0 or maximum.last != 999999
    maximum_first: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(1, 999999, StudioContactFramePolicy::MAX_FRAMES, StudioContactFramePolicy::FIRST, 1)
    return 11 if not maximum_first.valid or maximum_first.first != 0 or maximum_first.last != 999999
    _ = puts("studio_contact_frame: exact typed endpoints and atomic validation pass")
    return 0
