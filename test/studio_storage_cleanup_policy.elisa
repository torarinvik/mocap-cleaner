# Storage cleanup review never exposes unsafe or unverified files as candidates.
include "../src/studio/storage_cleanup_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    safe: StudioStorageCleanupPolicy::Facts = StudioStorageCleanupPolicy::Facts{
        kind: StudioStorageCleanupPolicy::RECOVERY, studio_managed: true,
        canonical_under_build: true, symlink: false, source_take: false,
        open_document: false, session_referenced: false,
        identity_state: StudioStorageCleanupPolicy::IDENTITY_MATCHES, age_days: 45,
        retention_days: 30, size_bytes: 4096
    }
    return 1 if not StudioStorageCleanupPolicy::eligible(safe)
    return 2 if StudioStorageCleanupPolicy::may_trash(safe, true, true, false)
    return 3 if StudioStorageCleanupPolicy::may_trash(safe, true, false, true)
    return 4 if not StudioStorageCleanupPolicy::may_trash(safe, true, true, true)
    return 5 if StudioStorageCleanupPolicy::next_total_bytes(100, safe) != 4196
    return 15 if StudioStorageCleanupPolicy::protection_reason(safe) != StudioStorageCleanupPolicy::PROTECT_NONE

    young: StudioStorageCleanupPolicy::Facts = safe
    young.age_days <- 29
    return 6 if StudioStorageCleanupPolicy::eligible(young)
    return 16 if StudioStorageCleanupPolicy::protection_reason(young) != StudioStorageCleanupPolicy::PROTECT_RETENTION
    linked: StudioStorageCleanupPolicy::Facts = safe
    linked.symlink <- true
    return 7 if StudioStorageCleanupPolicy::eligible(linked)
    return 17 if StudioStorageCleanupPolicy::protection_reason(linked) != StudioStorageCleanupPolicy::PROTECT_SYMLINK
    source: StudioStorageCleanupPolicy::Facts = safe
    source.source_take <- true
    return 8 if StudioStorageCleanupPolicy::eligible(source)
    return 18 if StudioStorageCleanupPolicy::protection_reason(source) != StudioStorageCleanupPolicy::PROTECT_SOURCE_TAKE
    open: StudioStorageCleanupPolicy::Facts = safe
    open.open_document <- true
    return 9 if StudioStorageCleanupPolicy::eligible(open)
    referenced: StudioStorageCleanupPolicy::Facts = safe
    referenced.session_referenced <- true
    return 10 if StudioStorageCleanupPolicy::eligible(referenced)
    outside: StudioStorageCleanupPolicy::Facts = safe
    outside.canonical_under_build <- false
    return 11 if StudioStorageCleanupPolicy::eligible(outside)
    return 19 if StudioStorageCleanupPolicy::protection_reason(outside) != StudioStorageCleanupPolicy::PROTECT_OUTSIDE_BUILD
    unmanaged: StudioStorageCleanupPolicy::Facts = safe
    unmanaged.studio_managed <- false
    return 12 if StudioStorageCleanupPolicy::eligible(unmanaged)
    return 20 if StudioStorageCleanupPolicy::protection_reason(unmanaged) != StudioStorageCleanupPolicy::PROTECT_UNMANAGED

    huge: StudioStorageCleanupPolicy::Facts = safe
    huge.size_bytes <- StudioStorageCleanupPolicy::MAX_ITEM_BYTES
    return 13 if StudioStorageCleanupPolicy::next_total_bytes(1, huge) != 1
    bad_kind: StudioStorageCleanupPolicy::Facts = safe
    bad_kind.kind <- 9
    return 14 if StudioStorageCleanupPolicy::eligible(bad_kind)
    return 21 if StudioStorageCleanupPolicy::protection_reason(bad_kind) != StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS
    changed_identity: StudioStorageCleanupPolicy::Facts = safe
    changed_identity.identity_state <- StudioStorageCleanupPolicy::IDENTITY_CHANGED
    return 22 if StudioStorageCleanupPolicy::eligible(changed_identity)
    return 23 if StudioStorageCleanupPolicy::protection_reason(changed_identity) != StudioStorageCleanupPolicy::PROTECT_IDENTITY_CHANGED
    unverified_identity: StudioStorageCleanupPolicy::Facts = safe
    unverified_identity.identity_state <- StudioStorageCleanupPolicy::IDENTITY_UNVERIFIED
    return 24 if StudioStorageCleanupPolicy::eligible(unverified_identity)
    return 25 if StudioStorageCleanupPolicy::protection_reason(unverified_identity) != StudioStorageCleanupPolicy::PROTECT_IDENTITY_UNVERIFIED
    invalid_identity: StudioStorageCleanupPolicy::Facts = safe
    invalid_identity.identity_state <- 3
    return 26 if StudioStorageCleanupPolicy::eligible(invalid_identity)
    return 27 if StudioStorageCleanupPolicy::protection_reason(invalid_identity) != StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS
    _ = puts("studio storage cleanup policy: safe eligibility and review gates pass")
    return 0
