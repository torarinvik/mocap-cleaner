# A no-op preset must not open a cleanup preview or create an apply action.
include "../src/studio/state/stack_state.elisa"
include "../src/studio/suggestion_policy.elisa"

def main() -> i32:
    base: StackState::Stack = StackState::empty()
    same_candidate: StackState::Stack = base
    unchanged: StudioSuggestionPolicy::Decision = StudioSuggestionPolicy::open_decision(
        StudioSuggestionPolicy::State.Closed, true,
        not StackState::same(base, same_candidate), 4, 9)
    return 1 if unchanged != StudioSuggestionPolicy::Decision.NoChange

    changed_candidate: mutable StackState::Stack = base
    return 2 if not StackState::add(&changed_candidate, Ops::median(0, 99, -1, 2))
    changed: StudioSuggestionPolicy::Decision = StudioSuggestionPolicy::open_decision(
        StudioSuggestionPolicy::State.Closed, true,
        not StackState::same(base, changed_candidate), 4, 9)
    return 3 if changed != StudioSuggestionPolicy::Decision.Opened
    already_open: StudioSuggestionPolicy::Decision = StudioSuggestionPolicy::open_decision(
        StudioSuggestionPolicy::State.Open, true,
        not StackState::same(base, changed_candidate), 4, 9)
    return 4 if already_open != StudioSuggestionPolicy::Decision.NoChange
    0
