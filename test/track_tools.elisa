include "../src/tools/track.elisa"

def main() -> i32:
    raw: mutable darray[i64] = []
    for i in 0..<40 |raw|:
        raw.push(0)
    raw[20] <- 900
    return 1 if Track::spike_count(raw, 100, false) != 1
    clean: darray[i64] = Track::despike(raw, 1, 5, false)
    return 2 if clean[20] != 0
    return 3 if Track::spike_count(clean, 100, false) != 0
    return 4 if clean.count != raw.count
    ramp: mutable darray[i64] = []
    for i in 0..<40 |ramp|:
        ramp.push(i.i64() * 10)
    kept: darray[i64] = Track::despike(ramp, 2, 5, false)
    for i in 0..<40 |kept, ramp|:
        return 5 if kept[i] != ramp[i]
    edge: mutable darray[i64] = []
    for i in 0..<10 |edge|:
        edge.push(0)
    edge[0] <- 500
    fixed: darray[i64] = Track::despike(edge, 1, 3, false)
    return 6 if fixed[0] != 500
    heights: mutable darray[i64] = []
    speeds: mutable darray[i64] = []
    for i in 0..<10 |heights, speeds|:
        heights.push(40 if i < 3 else 8)
        speeds.push(0)
    heights[6] <- 15
    flags: darray[bool] = Track::contacts(heights, speeds, 10, 20, 100)
    return 7 if flags[0] or not flags[3] or not flags[6]
    pinned: darray[i64] = Track::pin(heights, flags, 0)
    return 8 if pinned[6] != 0 or pinned[0] != 40
    loop: mutable darray[i64] = []
    for i in 0..<21 |loop|:
        loop.push(i.i64() * 5)
    closed: darray[i64] = Track::close_seam(loop, 5)
    return 9 if closed[20] != 0
    return 10 if closed[10] != 50
    flat: mutable darray[i64] = []
    for i in 0..<30 |flat|:
        flat.push(70)
    smoothed: darray[i64] = Track::smooth(flat, 4, 3, true)
    for i in 0..<30 |smoothed|:
        return 11 if smoothed[i] != 70
    bump: mutable darray[i64] = []
    for i in 0..<30 |bump|:
        bump.push(0)
    bump[15] <- 400
    soft: darray[i64] = Track::smooth(bump, 1, 3, false)
    return 12 if soft[15] != 200 or soft[14] != 100
    return 0
