# The practice take adds findable problems to a real take without touching
# it: the boxer jab gains spikes on exactly the marked frames, keeps its key
# counts, and the source document is unchanged.
include "../src/io/practice_take.elisa"
include "../src/io/shared_grid.elisa"
include "../src/studio/state/clip_state.elisa"
include "../src/ops/presets.elisa"

def spike_frames(doc: GlbDocument::Document&, anim: usize, frames: i64) -> darray[i64]:
    StudioClip::problems(doc, anim, frames, Presets::spike_threshold(Presets::Preset.Boxing))

def main() -> i32 can[Global{Read, Write}]:
    can Global{Read, Write}:
        mutable src: GlbDocument::Document = catch GlbDocument::load("../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"):
            value: value
            error failure: return 1
        if SharedGrid::align(&src, 9) is grid:
            src <- move grid
        frames: i64 = StudioClip::frame_count(src, 9)
        return 2 if frames < PracticeTake::Problems::MIN_FRAMES
        before: darray[i64] = spike_frames(src, 9, frames)
        if PracticeTake::make(&src, 9) is practice:
            after: darray[i64] = spike_frames(practice, 9, frames)
            marked: darray[i64] = PracticeTake::problem_frames(frames)
            for m in marked |after, before|:
                return 3 if after[m.usize()] <= before[m.usize()]
            return 4 if StudioClip::frame_count(practice, 9) != frames
            again: darray[i64] = spike_frames(src, 9, frames)
            for f in 0..<again.count |again, before|:
                return 5 if again[f] != before[f]
            return 0
        return 6
