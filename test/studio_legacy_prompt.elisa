# Legacy session prompt policy defaults to cancellation, allows navigation
# between the explicit Load and Cancel actions, and ignores closed prompts.
include "../src/studio/legacy_session_prompt.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioLegacyPrompt::initial_focus() != StudioLegacyPrompt::FOCUS_CANCEL
    return 2 if StudioLegacyPrompt::move_focus(StudioLegacyPrompt::FOCUS_CANCEL, 1) != StudioLegacyPrompt::FOCUS_LOAD
    return 3 if StudioLegacyPrompt::move_focus(StudioLegacyPrompt::FOCUS_LOAD, -1) != StudioLegacyPrompt::FOCUS_CANCEL
    return 4 if StudioLegacyPrompt::resolve(false, StudioLegacyPrompt::LOAD) != StudioLegacyPrompt::NONE
    return 5 if StudioLegacyPrompt::resolve(true, StudioLegacyPrompt::LOAD) != StudioLegacyPrompt::LOAD
    return 6 if StudioLegacyPrompt::resolve(true, StudioLegacyPrompt::CANCEL) != StudioLegacyPrompt::CANCEL
    _ = puts("legacy session prompt policy: safe default and explicit choice pass")
    return 0
