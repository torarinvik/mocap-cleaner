# Legacy session prompt policy defaults to cancellation, allows navigation
# between the explicit Load and Cancel actions, and ignores closed prompts.
include "../src/studio/legacy_session_prompt.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioLegacyPrompt::initial_focus() != StudioLegacyPrompt::Focus.Cancel.i64()
    return 2 if StudioLegacyPrompt::move_focus(StudioLegacyPrompt::Focus.Cancel.i64(), 1) != StudioLegacyPrompt::Focus.Load.i64()
    return 3 if StudioLegacyPrompt::move_focus(StudioLegacyPrompt::Focus.Load.i64(), -1) != StudioLegacyPrompt::Focus.Cancel.i64()
    return 4 if StudioLegacyPrompt::resolve(false, StudioLegacyPrompt::Choice.Load.i64()) != StudioLegacyPrompt::Choice.None.i64()
    return 5 if StudioLegacyPrompt::resolve(true, StudioLegacyPrompt::Choice.Load.i64()) != StudioLegacyPrompt::Choice.Load.i64()
    return 6 if StudioLegacyPrompt::resolve(true, StudioLegacyPrompt::Choice.Cancel.i64()) != StudioLegacyPrompt::Choice.Cancel.i64()
    _ = puts("legacy session prompt policy: safe default and explicit choice pass")
    return 0
