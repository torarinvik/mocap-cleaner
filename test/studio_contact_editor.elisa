# Select-first contact actions accept exact frames and distinguish clicks from
# deliberate endpoint drags.
include "../src/studio/contact_editor.elisa"
include "../src/studio/state/stack_state.elisa"
include "../src/studio/state/history_state.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioContactEditor::selection_valid(0, 0, 1)
    return 2 if not StudioContactEditor::selection_valid(3, 999999, 1000000)
    return 3 if StudioContactEditor::selection_valid(-1, 0, 10)
    return 4 if StudioContactEditor::selection_valid(4, 0, 10)
    return 5 if StudioContactEditor::selection_valid(0, -1, 10)
    return 6 if StudioContactEditor::selection_valid(0, 10, 10)
    return 7 if StudioContactEditor::selection_valid(0, 0, 1000001)
    return 8 if not StudioContactEditor::action_valid(StudioContactEditor::PLANT)
    return 9 if not StudioContactEditor::action_valid(StudioContactEditor::LIFT)
    return 10 if StudioContactEditor::action_valid(-1)
    return 11 if not StudioContactEditor::plants(StudioContactEditor::PLANT)
    return 12 if StudioContactEditor::plants(StudioContactEditor::LIFT)
    return 13 if not StudioContactEditor::action_valid(StudioContactEditor::RESET)
    return 14 if StudioContactEditor::is_drag(-2) or StudioContactEditor::is_drag(0) or StudioContactEditor::is_drag(2)
    return 15 if not StudioContactEditor::is_drag(-3) or not StudioContactEditor::is_drag(3)
    at_start: StudioContactEditor::ResetPlan = StudioContactEditor::reset_interval(10, 20, 10)
    at_end: StudioContactEditor::ResetPlan = StudioContactEditor::reset_interval(10, 20, 20)
    inside: StudioContactEditor::ResetPlan = StudioContactEditor::reset_interval(10, 20, 15)
    outside: StudioContactEditor::ResetPlan = StudioContactEditor::reset_interval(10, 20, 21)
    single: StudioContactEditor::ResetPlan = StudioContactEditor::reset_interval(10, 10, 10)
    return 16 if at_start.count != 1 or at_start.left_first != 11 or at_start.left_end != 21
    return 17 if at_end.count != 1 or at_end.left_first != 10 or at_end.left_end != 20
    return 18 if inside.count != 2 or inside.left_end != 15 or inside.right_first != 16 or inside.right_end != 21
    return 19 if outside.count != 1 or outside.left_first != 10 or outside.left_end != 21
    return 20 if single.count != 0
    mutable edits: StackState::Stack = StackState::empty()
    _ = StackState::add_edit(&edits, StackState::LEFT, 10, 20, true)
    _ = StackState::add_edit(&edits, StackState::LEFT, 14, 16, false)
    _ = StackState::add_edit(&edits, StackState::RIGHT, 8, 22, false)
    return 21 if not StackState::reset_edit_at(&edits, StackState::LEFT, 15)
    return 22 if StackState::has_edit_at(edits, StackState::LEFT, 15)
    return 23 if edits.edit_count != 5
    return 24 if edits.edits[0].first != 10 or edits.edits[0].last != 14 or not edits.edits[0].planted
    return 25 if edits.edits[1].first != 16 or edits.edits[1].last != 20 or not edits.edits[1].planted
    return 26 if edits.edits[2].first != 14 or edits.edits[2].last != 14 or edits.edits[2].planted
    return 27 if edits.edits[3].first != 16 or edits.edits[3].last != 16 or edits.edits[3].planted
    return 28 if edits.edits[4].side != StackState::RIGHT or edits.edits[4].first != 8 or edits.edits[4].last != 22
    return 29 if StackState::reset_edit_at(&edits, StackState::LEFT, 15)
    mutable full: StackState::Stack = StackState::empty()
    for i in 0..<StackState::MAX_EDITS |i, full|:
        _ = StackState::add_edit(&full, StackState::LEFT, 10, 20, i % 2 == 0)
    return 30 if StackState::reset_edit_at(&full, StackState::LEFT, 15)
    return 31 if full.edit_count != StackState::MAX_EDITS or not StackState::has_edit_at(full, StackState::LEFT, 15)
    return 32 if not StudioContactEditor::action_valid(StudioContactEditor::DELETE)
    mutable deleted: StackState::Stack = StackState::empty()
    _ = StackState::add_edit(&deleted, StackState::LEFT, 10, 20, true)
    _ = StackState::add_edit(&deleted, StackState::LEFT, 14, 16, false)
    _ = StackState::add_edit(&deleted, StackState::RIGHT, 30, 32, false)
    return 33 if StackState::edit_index_at(deleted, StackState::LEFT, 15) != 1
    return 34 if not StackState::delete_edit_at(&deleted, StackState::LEFT, 15)
    return 35 if deleted.edit_count != 2 or not deleted.edits[0].planted or deleted.edits[0].first != 10 or deleted.edits[0].last != 20
    return 36 if StackState::edit_index_at(deleted, StackState::LEFT, 15) != 0
    # Deleting an earlier list entry compacts later edits without changing them.
    return 37 if not StackState::delete_edit_at(&deleted, StackState::LEFT, 15)
    return 38 if deleted.edit_count != 1 or deleted.edits[0].side != StackState::RIGHT or deleted.edits[0].first != 30 or deleted.edits[0].last != 32
    return 39 if StackState::has_edit_at(deleted, StackState::LEFT, 15)
    return 40 if StackState::delete_edit_at(&deleted, StackState::LEFT, 15) or StackState::delete_edit_at(&deleted, -1, 15)
    return 41 if not StudioContactEditor::action_valid(StudioContactEditor::MERGE)
    forward: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(StackState::LEFT, 10, 14, true, StackState::LEFT, 15, 19, true)
    return 42 if not forward.valid or forward.first != 10 or forward.last != 19
    reverse: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(StackState::LEFT, 20, 24, true, StackState::LEFT, 15, 19, true)
    return 43 if not reverse.valid or reverse.first != 15 or reverse.last != 24
    different_state: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(StackState::LEFT, 10, 14, true, StackState::LEFT, 15, 19, false)
    different_side: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(StackState::LEFT, 10, 14, true, StackState::RIGHT, 15, 19, true)
    gap: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(StackState::LEFT, 10, 14, true, StackState::LEFT, 16, 19, true)
    overlap: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(StackState::LEFT, 10, 15, true, StackState::LEFT, 15, 19, true)
    return 44 if different_state.valid or different_side.valid or gap.valid or overlap.valid
    mutable merged: StackState::Stack = StackState::empty()
    _ = StackState::add_edit(&merged, StackState::LEFT, 10, 14, true)
    _ = StackState::add_edit(&merged, StackState::LEFT, 15, 19, true)
    _ = StackState::add_edit(&merged, StackState::LEFT, 20, 21, false)
    _ = StackState::add_edit(&merged, StackState::RIGHT, 15, 19, true)
    return 45 if not StackState::can_merge_edit_at(merged, StackState::LEFT, 12)
    return 46 if not StackState::merge_edit_at(&merged, StackState::LEFT, 12)
    return 47 if merged.edit_count != 3 or merged.edits[0].first != 10 or merged.edits[0].last != 19 or not merged.edits[0].planted
    return 48 if merged.edits[1].side != StackState::LEFT or merged.edits[1].first != 20 or merged.edits[1].planted
    return 49 if merged.edits[2].side != StackState::RIGHT or merged.edits[2].first != 15
    return 50 if StackState::can_merge_edit_at(merged, StackState::LEFT, 20) or StackState::merge_edit_at(&merged, StackState::LEFT, 20)
    mutable reverse_stack: StackState::Stack = StackState::empty()
    _ = StackState::add_edit(&reverse_stack, StackState::LEFT, 30, 34, true)
    _ = StackState::add_edit(&reverse_stack, StackState::LEFT, 25, 29, true)
    mutable merge_history: HistoryState::History = zeroed
    HistoryState::reset(&merge_history, reverse_stack)
    return 51 if not StackState::merge_edit_at(&reverse_stack, StackState::LEFT, 31)
    return 52 if reverse_stack.edit_count != 1 or reverse_stack.edits[0].first != 25 or reverse_stack.edits[0].last != 34
    return 53 if not HistoryState::record(&merge_history, reverse_stack) or not HistoryState::undo(&merge_history)
    merged_back: StackState::Stack = HistoryState::current(&merge_history)
    return 54 if merged_back.edit_count != 2 or merged_back.edits[0].first != 30 or merged_back.edits[1].first != 25
    return 55 if not HistoryState::redo(&merge_history)
    merged_again: StackState::Stack = HistoryState::current(&merge_history)
    return 56 if merged_again.edit_count != 1 or merged_again.edits[0].first != 25 or merged_again.edits[0].last != 34
    return 57 if not StudioContactEditor::action_valid(StudioContactEditor::SPLIT)
    at_first: StudioContactEditor::SplitPlan = StudioContactEditor::split_plan(10, 20, 10)
    at_last: StudioContactEditor::SplitPlan = StudioContactEditor::split_plan(10, 20, 20)
    middle: StudioContactEditor::SplitPlan = StudioContactEditor::split_plan(10, 20, 15)
    return 58 if at_first.valid or not at_last.valid or not middle.valid
    return 59 if middle.left_last != 14 or middle.right_first != 15
    mutable split: StackState::Stack = StackState::empty()
    _ = StackState::add_edit(&split, StackState::LEFT, 10, 20, true)
    _ = StackState::add_edit(&split, StackState::LEFT, 15, 17, false)
    _ = StackState::add_edit(&split, StackState::RIGHT, 5, 25, false)
    mutable split_history: HistoryState::History = zeroed
    HistoryState::reset(&split_history, split)
    return 60 if not StackState::can_split_edit_at(split, StackState::LEFT, 12)
    return 61 if not StackState::split_edit_at(&split, StackState::LEFT, 12)
    return 62 if split.edit_count != 4 or split.edits[0].first != 10 or split.edits[0].last != 11 or not split.edits[0].planted
    return 63 if split.edits[1].first != 12 or split.edits[1].last != 20 or not split.edits[1].planted
    return 64 if split.edits[2].first != 15 or split.edits[2].last != 17 or split.edits[2].planted
    return 65 if split.edits[3].side != StackState::RIGHT
    return 66 if StackState::edit_index_at(split, StackState::LEFT, 12) != 1 or StackState::edit_index_at(split, StackState::LEFT, 16) != 2
    return 67 if StackState::can_split_edit_at(split, StackState::LEFT, 10)
    return 68 if not HistoryState::record(&split_history, split) or not HistoryState::undo(&split_history)
    split_back: StackState::Stack = HistoryState::current(&split_history)
    return 69 if split_back.edit_count != 3 or split_back.edits[0].first != 10 or split_back.edits[0].last != 20
    return 70 if not HistoryState::redo(&split_history)
    split_again: StackState::Stack = HistoryState::current(&split_history)
    return 71 if split_again.edit_count != 4 or split_again.edits[0].last != 11 or split_again.edits[1].first != 12
    mutable full_split: StackState::Stack = StackState::empty()
    for i in 0..<StackState::MAX_EDITS |i, full_split|:
        _ = StackState::add_edit(&full_split, StackState::LEFT, 10, 20, i % 2 == 0)
    return 72 if StackState::can_split_edit_at(full_split, StackState::LEFT, 15) or StackState::split_edit_at(&full_split, StackState::LEFT, 15)
    return 73 if full_split.edit_count != StackState::MAX_EDITS or full_split.edits[0].last != 20
    _ = puts("studio_contact_editor: selection, plant/lift/reset/delete/merge/split and interval policies pass")
    return 0
