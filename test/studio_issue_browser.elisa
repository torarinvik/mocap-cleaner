# Issue browser route and semantic identity contract shared by pointer and
# native accessibility actions.
include "../../elisa-ui/src/core/ui_core.elisa"
include "../src/studio/accessibility.elisa"
include "../src/studio/issue_browser_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::GROUP_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioAccessibility::SIDEBAR
    return 2 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::GROUP_ID
    return 3 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_DETECTOR_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID
    return 4 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FINDING_INTENT_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID
    return 5 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::GROUP_ID
    return 6 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::NEXT_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::GROUP_ID
    return 7 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::WORST_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::GROUP_ID
    return 32 if StudioIssueBrowserPolicy::row_id(0) >= UiCore::MAX_ACCESSIBILITY_NODES or StudioIssueBrowserPolicy::row_id(StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS - 1) >= UiCore::MAX_ACCESSIBILITY_NODES
    return 33 if not StudioAccessibility::is_workspace_node(StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID)
    return 34 if not StudioAccessibility::is_workspace_node(StudioIssueBrowserPolicy::Accessibility::FINDING_INTENT_ID)
    return 8 if StudioIssueBrowserPolicy::node_first_child() != StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID
    return 9 if StudioIssueBrowserPolicy::filter_first_child() != StudioIssueBrowserPolicy::Accessibility::FILTER_DETECTOR_ID
    return 10 if StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_STATUS_ID, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::FILTER_RESET_ID
    return 11 if StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_RESET_ID, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::FINDING_INTENT_ID
    return 12 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID
    return 13 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::NEXT_ID
    return 14 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::NEXT_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::Accessibility::WORST_ID
    return 15 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::WORST_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::row_id(0)
    return 16 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(0), 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::row_id(1)
    return 17 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(1), 2, StudioAccessibility::NO_NODE) != StudioAccessibility::NO_NODE
    return 18 if StudioIssueBrowserPolicy::navigation_target(0, 4, StudioIssueBrowserPolicy::Action.Previous.i64()) != 3
    return 19 if StudioIssueBrowserPolicy::navigation_target(2, 4, StudioIssueBrowserPolicy::Action.Previous.i64()) != 1
    return 20 if StudioIssueBrowserPolicy::navigation_target(2, 4, StudioIssueBrowserPolicy::Action.Next.i64()) != 3
    return 21 if StudioIssueBrowserPolicy::navigation_target(3, 4, StudioIssueBrowserPolicy::Action.Next.i64()) != 0
    return 22 if StudioIssueBrowserPolicy::navigation_target(3, 4, StudioIssueBrowserPolicy::Action.Worst.i64()) != 0
    return 23 if StudioIssueBrowserPolicy::row_route_enabled(0, 2, false)
    return 24 if StudioIssueBrowserPolicy::row_route_enabled(2, 2, true)
    return 25 if not StudioIssueBrowserPolicy::row_route_enabled(1, 2, true)
    return 26 if StudioIssueBrowserPolicy::window_start(0, 4) != 0
    return 27 if StudioIssueBrowserPolicy::window_start(1, 4) != 0
    return 28 if StudioIssueBrowserPolicy::window_start(2, 4) != 1
    return 29 if StudioIssueBrowserPolicy::window_start(3, 4) != 2
    return 30 if StudioIssueBrowserPolicy::window_start(9, 0) != 0
    return 31 if StudioIssueBrowserPolicy::window_start(StudioIssueBrowserPolicy::navigation_target(1, 4, StudioIssueBrowserPolicy::Action.Next.i64()), 4) + 1 != StudioIssueBrowserPolicy::navigation_target(1, 4, StudioIssueBrowserPolicy::Action.Next.i64())
    _ = puts("studio issue browser: semantic routes, visible windows and stale navigation pass")
    return 0
