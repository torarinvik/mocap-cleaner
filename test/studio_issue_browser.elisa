# Issue browser route and semantic identity contract shared by pointer and
# native accessibility actions.
include "../../elisa-ui/src/core/ui_core.elisa"
include "../src/studio/accessibility.elisa"
include "../src/studio/issue_browser_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::GROUP_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioAccessibility::SIDEBAR
    return 2 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::PREVIOUS_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::GROUP_ID
    return 3 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::NEXT_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::GROUP_ID
    return 4 if StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::WORST_ID, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::GROUP_ID
    return 5 if StudioIssueBrowserPolicy::row_id(0) >= UiCore::MAX_ACCESSIBILITY_NODES or StudioIssueBrowserPolicy::row_id(StudioIssueBrowserPolicy::ROWS - 1) >= UiCore::MAX_ACCESSIBILITY_NODES
    return 6 if StudioIssueBrowserPolicy::node_first_child() != StudioIssueBrowserPolicy::PREVIOUS_ID
    return 7 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::PREVIOUS_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::NEXT_ID
    return 8 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::NEXT_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::WORST_ID
    return 9 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::WORST_ID, 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::row_id(0)
    return 10 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(0), 2, StudioAccessibility::NO_NODE) != StudioIssueBrowserPolicy::row_id(1)
    return 11 if StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(1), 2, StudioAccessibility::NO_NODE) != StudioAccessibility::NO_NODE
    return 12 if StudioIssueBrowserPolicy::navigation_target(2, 4, StudioIssueBrowserPolicy::PREVIOUS) != 1
    return 13 if StudioIssueBrowserPolicy::navigation_target(2, 4, StudioIssueBrowserPolicy::NEXT) != 3
    return 14 if StudioIssueBrowserPolicy::navigation_target(3, 4, StudioIssueBrowserPolicy::NEXT) != 0
    return 15 if StudioIssueBrowserPolicy::navigation_target(3, 4, StudioIssueBrowserPolicy::WORST) != 0
    return 16 if StudioIssueBrowserPolicy::row_route_enabled(0, 2, false)
    return 17 if StudioIssueBrowserPolicy::row_route_enabled(2, 2, true)
    return 18 if not StudioIssueBrowserPolicy::row_route_enabled(1, 2, true)
    return 19 if StudioIssueBrowserPolicy::window_start(0, 4) != 0
    return 20 if StudioIssueBrowserPolicy::window_start(1, 4) != 0
    return 21 if StudioIssueBrowserPolicy::window_start(2, 4) != 1
    return 22 if StudioIssueBrowserPolicy::window_start(3, 4) != 2
    return 23 if StudioIssueBrowserPolicy::window_start(9, 0) != 0
    return 24 if StudioIssueBrowserPolicy::window_start(StudioIssueBrowserPolicy::navigation_target(1, 4, StudioIssueBrowserPolicy::NEXT), 4) + 1 != StudioIssueBrowserPolicy::navigation_target(1, 4, StudioIssueBrowserPolicy::NEXT)
    _ = puts("studio issue browser: semantic routes, visible windows and stale navigation pass")
    return 0
