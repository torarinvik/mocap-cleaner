include "../src/studio/export_review.elisa"

def main() -> i64:
    return 1 if StudioExportReview::initial_focus(4) != StudioExportReview::Control.ACKNOWLEDGE.i64()
    return 2 if StudioExportReview::initial_focus(0) != StudioExportReview::Control.EXPORT.i64()
    return 3 if StudioExportReview::move_focus(StudioExportReview::Control.ACKNOWLEDGE.i64(), 1, 3) != StudioExportReview::Control.DESTINATION.i64()
    return 4 if StudioExportReview::move_focus(StudioExportReview::Control.DESTINATION.i64(), 1, 3) != StudioExportReview::Control.INSPECT_WARNINGS.i64()
    return 5 if StudioExportReview::move_focus(StudioExportReview::Control.INSPECT_WARNINGS.i64(), 1, 3) != StudioExportReview::Control.CANCEL.i64()
    return 6 if StudioExportReview::move_focus(StudioExportReview::Control.CANCEL.i64(), 1, 3) != StudioExportReview::Control.EXPORT.i64()
    return 7 if StudioExportReview::move_focus(StudioExportReview::Control.EXPORT.i64(), 1, 3) != StudioExportReview::Control.ACKNOWLEDGE.i64()
    return 8 if StudioExportReview::move_focus(StudioExportReview::Control.ACKNOWLEDGE.i64(), -1, 3) != StudioExportReview::Control.EXPORT.i64()
    return 9 if StudioExportReview::move_focus(StudioExportReview::Control.CANCEL.i64(), 1, 0) != StudioExportReview::Control.EXPORT.i64()
    return 10 if StudioExportReview::move_focus(StudioExportReview::Control.EXPORT.i64(), -1, 0) != StudioExportReview::Control.CANCEL.i64()
    return 11 if StudioExportReview::move_focus(StudioExportReview::Control.DESTINATION.i64(), -1, 0) != StudioExportReview::Control.EXPORT.i64()
    return 12 if StudioExportReview::export_enabled(3, false)
    return 13 if not StudioExportReview::export_enabled(3, true)
    return 14 if not StudioExportReview::export_enabled(0, false)
    0
