include "../src/studio/export_review.elisa"

def main() -> i64:
    return 1 if StudioExportReview::initial_focus(4) != StudioExportReview::ACKNOWLEDGE
    return 2 if StudioExportReview::initial_focus(0) != StudioExportReview::EXPORT
    return 3 if StudioExportReview::move_focus(StudioExportReview::ACKNOWLEDGE, 1, 3) != StudioExportReview::CANCEL
    return 4 if StudioExportReview::move_focus(StudioExportReview::CANCEL, 1, 3) != StudioExportReview::EXPORT
    return 5 if StudioExportReview::move_focus(StudioExportReview::EXPORT, 1, 3) != StudioExportReview::ACKNOWLEDGE
    return 6 if StudioExportReview::move_focus(StudioExportReview::ACKNOWLEDGE, -1, 3) != StudioExportReview::EXPORT
    return 7 if StudioExportReview::move_focus(StudioExportReview::CANCEL, 1, 0) != StudioExportReview::EXPORT
    return 8 if StudioExportReview::move_focus(StudioExportReview::EXPORT, -1, 0) != StudioExportReview::CANCEL
    return 9 if StudioExportReview::export_enabled(3, false)
    return 10 if not StudioExportReview::export_enabled(3, true)
    return 11 if not StudioExportReview::export_enabled(0, false)
    0
