# Intent annotations are bounded, idempotent and revision-specific.
include "../src/studio/issue_annotation.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    mutable store: StudioIssueAnnotation::Store = zeroed
    issue: StudioIssues::Issue = StudioIssues::Issue{selectable: true, first_frame: 2, last_frame: 4, peak_frame: 3, issue_type: 5, subject_id: 1, source_revision: 7, severity: 600, peak_value: 130, threshold: 100}
    return 1 if not StudioIssueAnnotation::valid_issue(issue)
    return 2 if StudioIssueAnnotation::disposition(store, issue) != StudioIssueAnnotation::UNRESOLVED
    return 3 if not StudioIssueAnnotation::ignore(&store, issue)
    return 4 if StudioIssueAnnotation::disposition(store, issue) != StudioIssueAnnotation::IGNORED
    return 5 if not StudioIssueAnnotation::ignore(&store, issue)
    revised: StudioIssues::Issue = issue
    revised.source_revision <- 8
    return 6 if StudioIssueAnnotation::disposition(store, revised) != StudioIssueAnnotation::UNRESOLVED
    return 7 if not StudioIssueAnnotation::restore(&store, issue)
    return 8 if StudioIssueAnnotation::disposition(store, issue) != StudioIssueAnnotation::UNRESOLVED
    return 9 if store.count != 1
    return 10 if not StudioIssueAnnotation::ignore(&store, issue)
    return 11 if StudioIssueAnnotation::prune_revisions(&store, 8) != 1
    return 12 if StudioIssueAnnotation::disposition(store, issue) != StudioIssueAnnotation::UNRESOLVED
    return 13 if StudioIssueAnnotation::available_slot(store) < 0
    _ = puts("studio_issue_annotation: ignore, restore and stale revision cleanup pass")
    return 0
