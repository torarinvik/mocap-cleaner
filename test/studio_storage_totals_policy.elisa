include "../src/studio/storage_totals_policy.elisa"
include "../src/studio/io/storage_manifest.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 13 if StudioStorageTotalsPolicy::MAX_ITEMS != StudioStorageManifest::MAX_ENTRIES
    return 14 if StudioStorageTotalsPolicy::MAX_ITEM_BYTES != StudioStorageReceiptPolicy::MAX_ITEM_BYTES
    mutable totals: StudioStorageTotalsPolicy::Totals = StudioStorageTotalsPolicy::Totals{item_count: 0, bytes: 0}
    return 1 if not StudioStorageTotalsPolicy::add(&totals, 0)
    return 2 if not StudioStorageTotalsPolicy::add(&totals, StudioStorageTotalsPolicy::MAX_ITEM_BYTES)
    return 3 if totals.item_count != 2 or totals.bytes != StudioStorageTotalsPolicy::MAX_ITEM_BYTES

    maximum: i64 = StudioStorageTotalsPolicy::MAX_ITEM_BYTES * StudioStorageTotalsPolicy::MAX_ITEMS
    mutable full: StudioStorageTotalsPolicy::Totals = StudioStorageTotalsPolicy::Totals{item_count: 0, bytes: 0}
    mutable index: i64 = 0
    while index < StudioStorageTotalsPolicy::MAX_ITEMS:
        return 4 if not StudioStorageTotalsPolicy::add(&full, StudioStorageTotalsPolicy::MAX_ITEM_BYTES)
        index <- index + 1
    return 5 if full.bytes != maximum or full.item_count != StudioStorageTotalsPolicy::MAX_ITEMS
    return 6 if StudioStorageTotalsPolicy::add(&full, 0)

    mutable bad_size: StudioStorageTotalsPolicy::Totals = StudioStorageTotalsPolicy::Totals{item_count: 0, bytes: 0}
    return 7 if StudioStorageTotalsPolicy::add(&bad_size, -1)
    return 8 if bad_size.item_count != 0 or bad_size.bytes != 0
    mutable inconsistent: StudioStorageTotalsPolicy::Totals = StudioStorageTotalsPolicy::Totals{item_count: 0, bytes: maximum}
    return 11 if StudioStorageTotalsPolicy::add(&inconsistent, 1)
    return 12 if inconsistent.item_count != 0 or inconsistent.bytes != maximum
    amount: StudioStorageTotalsPolicy::DisplayAmount = StudioStorageTotalsPolicy::display_amount(1536)
    return 9 if amount.unit != StudioStorageTotalsPolicy::UNIT_KIB or amount.tenths != 15
    top: StudioStorageTotalsPolicy::DisplayAmount = StudioStorageTotalsPolicy::display_amount(maximum)
    return 10 if top.unit != StudioStorageTotalsPolicy::UNIT_TIB
    _ = puts("studio storage totals: bounded accumulation and IEC display pass")
    return 0
