include "../src/studio/storage_totals_kernel.elisa"
include "../src/studio/io/storage_manifest.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioStorageTotalsKernel::MAX_ITEMS != StudioStorageManifest::MAX_ENTRIES
    return 2 if StudioStorageTotalsKernel::MAX_ITEM_BYTES != StudioStorageReceiptPolicy::MAX_ITEM_BYTES
    mutable total: i64 = 0
    mutable count: i64 = 0
    while count < StudioStorageTotalsKernel::MAX_ITEMS:
        return 3 if not StudioStorageTotalsKernel::add_allowed(count, total, StudioStorageTotalsKernel::MAX_ITEM_BYTES)
        total <- StudioStorageTotalsKernel::next_total(total, StudioStorageTotalsKernel::MAX_ITEM_BYTES)
        count <- StudioStorageTotalsKernel::next_count(count)
    return 4 if total != StudioStorageTotalsKernel::MAX_TOTAL_BYTES
    return 5 if StudioStorageTotalsKernel::add_allowed(count, total, 0)
    return 6 if StudioStorageTotalsKernel::add_allowed(0, 0, -9223372036854775807 - 1)
    return 7 if StudioStorageTotalsKernel::add_allowed(0, 0, StudioStorageTotalsKernel::MAX_ITEM_BYTES + 1)
    return 8 if StudioStorageTotalsKernel::add_allowed(0, total, 1)
    unit: i64 = StudioStorageTotalsKernel::display_unit(1536)
    return 9 if unit != StudioStorageTotalsKernel::UNIT_KIB
    return 10 if StudioStorageTotalsKernel::display_magnitude(1536, unit) != 1
    return 11 if StudioStorageTotalsKernel::display_unit(total) != StudioStorageTotalsKernel::UNIT_TIB
    _ = puts("PASS exact bounded Storage totals")
    0
