include "../src/studio/app/text.elisa"
include "../src/studio/app/status_text.elisa"

def main() -> i32 can Unsafe.PointerCast:
    StudioText::begin()
    StudioText::put("Import failed; choose another take.")
    retained: sview = StudioStatusText::capture(StudioText::view())
    for redraw in 0..<300:
        StudioText::begin()
        StudioText::put("Frame metadata replaces rotating scratch slots")
    expected: sview = "Import failed; choose another take."
    return 1 if retained.len != expected.len
    for index in 0..<expected.len.usize():
        return 2 if retained.data[index] != expected.data[index]
    return 3 if StudioStatusTextExtentPolicy::admitted(129, true)
    return 4 if StudioStatusTextExtentPolicy::admitted(1, false)
    return 5 if StudioStatusTextExtentPolicy::admitted(-1, true)
    return 0
