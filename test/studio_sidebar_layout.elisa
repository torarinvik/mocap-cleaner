# Regression checks for the vertically separated Studio sidebar sections.
include "../src/studio/sidebar_layout.elisa"

extern puts(text: cstr) -> i64

def main() -> i64:
    return 1 if not StudioSidebarLayout::sections_do_not_overlap()
    return 2 if StudioSidebarLayout::METRIC_FIRST_BASELINE != 96
    return 3 if StudioSidebarLayout::METRIC_FIRST_BASELINE + (StudioSidebarLayout::METRIC_LINE_COUNT - 1) * StudioSidebarLayout::METRIC_LINE_STEP != 166
    return 4 if StudioSidebarLayout::ISSUE_ROW_TOP != 261
    return 5 if StudioSidebarLayout::ISSUE_ROW_LAST_BOTTOM != 292
    return 6 if StudioSidebarLayout::OPERATION_ROW_TOP != 410
    _ = puts("studio sidebar layout: metric, finding and cleanup sections do not overlap")
    0
