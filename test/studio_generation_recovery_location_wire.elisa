# Wire refusal controls only; no native observation or reveal authority.
include "../src/studio/io/build_generation_recovery_location_wire.elisa"

def main() -> i32 can Memory.Allocate:
    mutable wire: u8[StudioBuildGenerationRecoveryLocationWire::Limit::BYTES] = zeroed
    empty: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, 0)
    return 1 if empty.valid
    negative: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, -1)
    return 2 if negative.valid
    oversized: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, StudioBuildGenerationRecoveryLocationWire::Limit::BYTES)
    return 3 if oversized.valid
    # Empty objects lack the identity, schema and both side observations.
    wire[0] <- 123
    wire[1] <- 125
    incomplete: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, 2)
    return 4 if incomplete.valid
    # The output contract requires an exact terminator and cleared tail.
    wire[2] <- 1
    unterminated: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, 2)
    return 5 if unterminated.valid
    wire[2] <- 0
    wire[3] <- 1
    dirty_tail: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, 2)
    return 6 if dirty_tail.valid
    # Embedded NUL must not truncate a declared response into another record.
    wire[1] <- 0
    wire[3] <- 0
    embedded_zero: StudioBuildGenerationRecoveryLocationWire::DecodeResult = StudioBuildGenerationRecoveryLocationWire::decode(wire, 2)
    return 7 if embedded_zero.valid
    return 0
