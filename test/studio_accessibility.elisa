# Stable landmark identities and relationships used by the AppKit semantic
# tree. The canvas publishes its own roles and screen-space frames.
include "../../elisa-ui/src/core/ui_core.elisa"
include "../src/studio/accessibility.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioAccessibility::is_workspace_node(StudioAccessibility::WORKSPACE)
    return 2 if not StudioAccessibility::is_workspace_node(StudioAccessibility::SIDEBAR)
    return 3 if StudioAccessibility::is_workspace_node(239)
    return 4 if StudioAccessibility::parent(StudioAccessibility::WORKSPACE) != StudioAccessibility::NO_NODE
    return 5 if StudioAccessibility::first_child(StudioAccessibility::WORKSPACE) != StudioAccessibility::TOOLBAR
    return 6 if StudioAccessibility::parent(StudioAccessibility::STATUS) != StudioAccessibility::WORKSPACE
    return 7 if StudioAccessibility::next_sibling(StudioAccessibility::SIDEBAR) != StudioAccessibility::STATUS
    return 8 if StudioAccessibility::next_sibling(StudioAccessibility::STATUS) != StudioAccessibility::NO_NODE
    first: usize = StudioAccessibility::toolbar_control_id(0)
    last: usize = StudioAccessibility::toolbar_control_id(StudioAccessibility::TOOLBAR_ACTION_COUNT - 1)
    return 9 if first != StudioAccessibility::TOOLBAR_CONTROL_FIRST or last != StudioAccessibility::TOOLBAR_CONTROL_END - 1
    return 10 if StudioAccessibility::parent(first) != StudioAccessibility::TOOLBAR or StudioAccessibility::first_child(StudioAccessibility::TOOLBAR) != first
    return 11 if StudioAccessibility::toolbar_action_for_control(first) != 0 or StudioAccessibility::toolbar_action_for_control(last) != StudioAccessibility::TOOLBAR_ACTION_COUNT - 1
    return 12 if StudioAccessibility::next_sibling(first) != first + 1 or StudioAccessibility::next_sibling(last) != StudioAccessibility::NO_NODE
    return 13 if StudioAccessibility::toolbar_control_id(-1) != StudioAccessibility::NO_NODE or StudioAccessibility::toolbar_control_id(StudioAccessibility::TOOLBAR_ACTION_COUNT) != StudioAccessibility::NO_NODE
    return 14 if StudioAccessibility::toolbar_action_for_widget(0) != 0 or StudioAccessibility::toolbar_action_for_widget(StudioAccessibility::TOOLBAR_ACTION_COUNT.usize() - 1) != StudioAccessibility::TOOLBAR_ACTION_COUNT - 1
    return 15 if StudioAccessibility::toolbar_action_for_widget(StudioAccessibility::TOOLBAR_ACTION_COUNT.usize()) != -1
    return 16 if StudioAccessibility::EXPORT_REVIEW >= StudioAccessibility::NO_NODE or StudioAccessibility::REVIEW_ACKNOWLEDGEMENT >= StudioAccessibility::NO_NODE or StudioAccessibility::REVIEW_CANCEL >= StudioAccessibility::NO_NODE or StudioAccessibility::REVIEW_EXPORT >= StudioAccessibility::NO_NODE or StudioAccessibility::REVIEW_DESTINATION >= StudioAccessibility::NO_NODE or StudioAccessibility::export_review_warning_id(StudioAccessibility::REVIEW_WARNING_COUNT - 1) >= StudioAccessibility::NO_NODE
    return 17 if not StudioAccessibility::is_export_review_node(StudioAccessibility::EXPORT_REVIEW) or not StudioAccessibility::is_export_review_node(StudioAccessibility::REVIEW_ACKNOWLEDGEMENT) or not StudioAccessibility::is_export_review_node(StudioAccessibility::REVIEW_DESTINATION) or not StudioAccessibility::is_export_review_node(StudioAccessibility::export_review_warning_id(0))
    return 18 if StudioAccessibility::export_review_parent(StudioAccessibility::REVIEW_EXPORT) != StudioAccessibility::EXPORT_REVIEW
    return 19 if StudioAccessibility::export_review_first_child(0) != StudioAccessibility::REVIEW_DESTINATION or StudioAccessibility::export_review_first_child(2) != StudioAccessibility::REVIEW_ACKNOWLEDGEMENT
    return 20 if StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_ACKNOWLEDGEMENT, 0) != StudioAccessibility::REVIEW_DESTINATION or StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_ACKNOWLEDGEMENT, 2) != StudioAccessibility::REVIEW_WARNING_FIRST or StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_WARNING_FIRST, 2) != StudioAccessibility::REVIEW_WARNING_FIRST + 1 or StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_WARNING_FIRST + 1, 2) != StudioAccessibility::REVIEW_DESTINATION or StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_DESTINATION, 2) != StudioAccessibility::REVIEW_CANCEL or StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_CANCEL, 2) != StudioAccessibility::REVIEW_EXPORT or StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_EXPORT, 2) != StudioAccessibility::NO_NODE
    return 21 if StudioAccessibility::EXPORT_RESULT >= StudioAccessibility::NO_NODE or StudioAccessibility::RESULT_OPEN >= StudioAccessibility::NO_NODE or StudioAccessibility::RESULT_SHOW_IN_FOLDER >= StudioAccessibility::NO_NODE or StudioAccessibility::RESULT_DONE >= StudioAccessibility::NO_NODE
    return 22 if not StudioAccessibility::is_export_result_node(StudioAccessibility::EXPORT_RESULT) or not StudioAccessibility::is_export_result_node(StudioAccessibility::RESULT_DONE)
    return 23 if StudioAccessibility::export_result_parent(StudioAccessibility::RESULT_OPEN) != StudioAccessibility::EXPORT_RESULT
    return 24 if StudioAccessibility::export_result_first_child() != StudioAccessibility::RESULT_OPEN or StudioAccessibility::export_result_next_sibling(StudioAccessibility::RESULT_OPEN) != StudioAccessibility::RESULT_SHOW_IN_FOLDER or StudioAccessibility::export_result_next_sibling(StudioAccessibility::RESULT_SHOW_IN_FOLDER) != StudioAccessibility::RESULT_DONE or StudioAccessibility::export_result_next_sibling(StudioAccessibility::RESULT_DONE) != StudioAccessibility::NO_NODE
    return 25 if not StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::EXPORT_REVIEW) or not StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::PATH_LINE_FIRST) or StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::NO_NODE)
    return 26 if StudioAccessibility::export_path_inspector_parent(StudioAccessibility::PATH_LINE_FIRST) != StudioAccessibility::EXPORT_REVIEW or StudioAccessibility::export_path_inspector_parent(StudioAccessibility::PATH_DONE) != StudioAccessibility::EXPORT_REVIEW
    return 27 if StudioAccessibility::export_path_inspector_first_child() != StudioAccessibility::PATH_LINE_FIRST or StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_LINE_FIRST + 4, 5) != StudioAccessibility::PATH_PREVIOUS
    return 28 if StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_PREVIOUS, 5) != StudioAccessibility::PATH_NEXT or StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_NEXT, 5) != StudioAccessibility::PATH_DONE or StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_DONE, 5) != StudioAccessibility::NO_NODE
    return 29 if StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_LINE_FIRST + 1, 2) != StudioAccessibility::PATH_PREVIOUS
    return 30 if StudioAccessibility::WARNING_DETAIL >= StudioAccessibility::NO_NODE or StudioAccessibility::WARNING_DETAIL_PREVIOUS >= StudioAccessibility::NO_NODE or StudioAccessibility::WARNING_DETAIL_NEXT >= StudioAccessibility::NO_NODE or StudioAccessibility::WARNING_DETAIL_DONE >= StudioAccessibility::NO_NODE
    return 31 if not StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::WARNING_DETAIL) or not StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::WARNING_DETAIL_PREVIOUS) or not StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::WARNING_DETAIL_NEXT) or StudioAccessibility::warning_detail_parent(StudioAccessibility::WARNING_DETAIL) != StudioAccessibility::NO_NODE or StudioAccessibility::warning_detail_parent(StudioAccessibility::WARNING_DETAIL_DONE) != StudioAccessibility::WARNING_DETAIL
    return 32 if StudioAccessibility::warning_detail_first_child() != StudioAccessibility::WARNING_DETAIL_METRIC or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_METRIC) != StudioAccessibility::WARNING_DETAIL_EVIDENCE or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_EVIDENCE) != StudioAccessibility::WARNING_DETAIL_PREVIOUS or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_PREVIOUS) != StudioAccessibility::WARNING_DETAIL_NEXT or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_NEXT) != StudioAccessibility::WARNING_DETAIL_DONE or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_DONE) != StudioAccessibility::NO_NODE
    return 33 if StudioAccessibility::CONTACT_EDITOR_PLANT >= StudioAccessibility::NO_NODE or StudioAccessibility::CONTACT_EDITOR_LIFT >= StudioAccessibility::NO_NODE or StudioAccessibility::CONTACT_EDITOR_RESET >= StudioAccessibility::NO_NODE
    return 34 if not StudioAccessibility::is_contact_editor_node(StudioAccessibility::CONTACT_EDITOR_PLANT) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::CONTACT_EDITOR_LIFT) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::CONTACT_EDITOR_RESET) or StudioAccessibility::parent(StudioAccessibility::CONTACT_EDITOR_PLANT) != StudioAccessibility::TIMELINE or StudioAccessibility::parent(StudioAccessibility::CONTACT_EDITOR_LIFT) != StudioAccessibility::TIMELINE or StudioAccessibility::parent(StudioAccessibility::CONTACT_EDITOR_RESET) != StudioAccessibility::TIMELINE
    return 35 if StudioAccessibility::first_child(StudioAccessibility::TIMELINE) != StudioAccessibility::CONTACT_EDITOR_PLANT or StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_PLANT) != StudioAccessibility::CONTACT_EDITOR_LIFT or StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_LIFT) != StudioAccessibility::CONTACT_EDITOR_RESET or StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_RESET) != StudioAccessibility::NO_NODE
    _ = puts("studio accessibility: workspace, export review and contact action identities pass")
    return 0
