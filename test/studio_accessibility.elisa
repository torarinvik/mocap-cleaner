# Stable landmark identities and relationships used by the AppKit semantic
# tree. The canvas publishes its own roles and screen-space frames.
include "../../elisa-ui/src/core/ui_core.elisa"
include "../src/studio/accessibility.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::WORKSPACE)
    return 2 if not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::SIDEBAR)
    return 3 if StudioAccessibility::is_workspace_node(239)
    return 4 if StudioAccessibility::parent(StudioAccessibility::SemanticId::WORKSPACE) != StudioAccessibility::SemanticId::NO_NODE
    return 5 if StudioAccessibility::first_child(StudioAccessibility::SemanticId::WORKSPACE) != StudioAccessibility::SemanticId::TOOLBAR
    return 6 if StudioAccessibility::parent(StudioAccessibility::SemanticId::STATUS) != StudioAccessibility::SemanticId::WORKSPACE
    return 7 if StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::SIDEBAR) != StudioAccessibility::SemanticId::STATUS
    return 8 if StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::STATUS) != StudioAccessibility::SemanticId::NO_NODE
    first: usize = StudioAccessibility::toolbar_control_id(0)
    last: usize = StudioAccessibility::toolbar_control_id(StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT - 1)
    return 9 if first != StudioAccessibility::Range::TOOLBAR_CONTROL_FIRST or last != StudioAccessibility::Range::TOOLBAR_CONTROL_END - 1
    return 10 if StudioAccessibility::parent(first) != StudioAccessibility::SemanticId::TOOLBAR or StudioAccessibility::first_child(StudioAccessibility::SemanticId::TOOLBAR) != first
    return 11 if StudioAccessibility::toolbar_action_for_control(first) != 0 or StudioAccessibility::toolbar_action_for_control(last) != StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT - 1
    return 12 if StudioAccessibility::next_sibling(first) != first + 1 or StudioAccessibility::next_sibling(last) != StudioAccessibility::SemanticId::NO_NODE
    return 13 if StudioAccessibility::toolbar_control_id(-1) != StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::toolbar_control_id(StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT) != StudioAccessibility::SemanticId::NO_NODE
    return 14 if StudioAccessibility::toolbar_action_for_widget(0) != 0 or StudioAccessibility::toolbar_action_for_widget(StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT.usize() - 1) != StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT - 1
    return 15 if StudioAccessibility::toolbar_action_for_widget(StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT.usize()) != -1
    return 16 if StudioAccessibility::SemanticId::EXPORT_REVIEW >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::REVIEW_CANCEL >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::REVIEW_EXPORT >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::REVIEW_DESTINATION >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::export_review_warning_id(StudioAccessibility::Capacity::REVIEW_WARNING_COUNT - 1) >= StudioAccessibility::SemanticId::NO_NODE
    return 17 if not StudioAccessibility::is_export_review_node(StudioAccessibility::SemanticId::EXPORT_REVIEW) or not StudioAccessibility::is_export_review_node(StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT) or not StudioAccessibility::is_export_review_node(StudioAccessibility::SemanticId::REVIEW_DESTINATION) or not StudioAccessibility::is_export_review_node(StudioAccessibility::export_review_warning_id(0))
    return 18 if StudioAccessibility::export_review_parent(StudioAccessibility::SemanticId::REVIEW_EXPORT) != StudioAccessibility::SemanticId::EXPORT_REVIEW
    return 19 if StudioAccessibility::export_review_first_child(0) != StudioAccessibility::SemanticId::REVIEW_DESTINATION or StudioAccessibility::export_review_first_child(2) != StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT
    return 20 if StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT, 0) != StudioAccessibility::SemanticId::REVIEW_DESTINATION or StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT, 2) != StudioAccessibility::Range::REVIEW_WARNING_FIRST or StudioAccessibility::export_review_next_sibling(StudioAccessibility::Range::REVIEW_WARNING_FIRST, 2) != StudioAccessibility::Range::REVIEW_WARNING_FIRST + 1 or StudioAccessibility::export_review_next_sibling(StudioAccessibility::Range::REVIEW_WARNING_FIRST + 1, 2) != StudioAccessibility::SemanticId::REVIEW_DESTINATION or StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_DESTINATION, 2) != StudioAccessibility::SemanticId::REVIEW_CANCEL or StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_CANCEL, 2) != StudioAccessibility::SemanticId::REVIEW_EXPORT or StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_EXPORT, 2) != StudioAccessibility::SemanticId::NO_NODE
    return 21 if StudioAccessibility::SemanticId::EXPORT_RESULT >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::RESULT_OPEN >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::RESULT_DONE >= StudioAccessibility::SemanticId::NO_NODE
    return 22 if not StudioAccessibility::is_export_result_node(StudioAccessibility::SemanticId::EXPORT_RESULT) or not StudioAccessibility::is_export_result_node(StudioAccessibility::SemanticId::RESULT_DONE)
    return 23 if StudioAccessibility::export_result_parent(StudioAccessibility::SemanticId::RESULT_OPEN) != StudioAccessibility::SemanticId::EXPORT_RESULT
    return 24 if StudioAccessibility::export_result_first_child() != StudioAccessibility::SemanticId::RESULT_OPEN or StudioAccessibility::export_result_next_sibling(StudioAccessibility::SemanticId::RESULT_OPEN) != StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER or StudioAccessibility::export_result_next_sibling(StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER) != StudioAccessibility::SemanticId::RESULT_DONE or StudioAccessibility::export_result_next_sibling(StudioAccessibility::SemanticId::RESULT_DONE) != StudioAccessibility::SemanticId::NO_NODE
    return 25 if not StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::SemanticId::EXPORT_REVIEW) or not StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::Range::PATH_LINE_FIRST) or StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::SemanticId::NO_NODE)
    return 26 if StudioAccessibility::export_path_inspector_parent(StudioAccessibility::Range::PATH_LINE_FIRST) != StudioAccessibility::SemanticId::EXPORT_REVIEW or StudioAccessibility::export_path_inspector_parent(StudioAccessibility::SemanticId::PATH_DONE) != StudioAccessibility::SemanticId::EXPORT_REVIEW
    return 27 if StudioAccessibility::export_path_inspector_first_child() != StudioAccessibility::Range::PATH_LINE_FIRST or StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::Range::PATH_LINE_FIRST + 4, 5) != StudioAccessibility::SemanticId::PATH_PREVIOUS
    return 28 if StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::SemanticId::PATH_PREVIOUS, 5) != StudioAccessibility::SemanticId::PATH_NEXT or StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::SemanticId::PATH_NEXT, 5) != StudioAccessibility::SemanticId::PATH_DONE or StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::SemanticId::PATH_DONE, 5) != StudioAccessibility::SemanticId::NO_NODE
    return 29 if StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::Range::PATH_LINE_FIRST + 1, 2) != StudioAccessibility::SemanticId::PATH_PREVIOUS
    return 30 if StudioAccessibility::SemanticId::WARNING_DETAIL >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::WARNING_DETAIL_DONE >= StudioAccessibility::SemanticId::NO_NODE
    return 31 if not StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::SemanticId::WARNING_DETAIL) or not StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS) or not StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT) or StudioAccessibility::warning_detail_parent(StudioAccessibility::SemanticId::WARNING_DETAIL) != StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::warning_detail_parent(StudioAccessibility::SemanticId::WARNING_DETAIL_DONE) != StudioAccessibility::SemanticId::WARNING_DETAIL
    return 32 if StudioAccessibility::warning_detail_first_child() != StudioAccessibility::SemanticId::WARNING_DETAIL_METRIC or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_METRIC) != StudioAccessibility::SemanticId::WARNING_DETAIL_EVIDENCE or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_EVIDENCE) != StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS) != StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT) != StudioAccessibility::SemanticId::WARNING_DETAIL_DONE or StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_DONE) != StudioAccessibility::SemanticId::NO_NODE
    return 33 if StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE >= StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT >= StudioAccessibility::SemanticId::NO_NODE
    return 34 if not StudioAccessibility::is_contact_editor_node(StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE) or not StudioAccessibility::is_contact_editor_node(StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT) or StudioAccessibility::parent(StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT) != StudioAccessibility::SemanticId::TIMELINE or StudioAccessibility::parent(StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT) != StudioAccessibility::SemanticId::TIMELINE or StudioAccessibility::parent(StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET) != StudioAccessibility::SemanticId::TIMELINE or StudioAccessibility::parent(StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE) != StudioAccessibility::SemanticId::TIMELINE or StudioAccessibility::parent(StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE) != StudioAccessibility::SemanticId::TIMELINE or StudioAccessibility::parent(StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT) != StudioAccessibility::SemanticId::TIMELINE
    return 35 if StudioAccessibility::first_child(StudioAccessibility::SemanticId::TIMELINE) != StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT) != StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT) != StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET) != StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE) != StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE) != StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT) != StudioAccessibility::ContactEndpoint::FIRST
    return 36 if not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_GROUP) or not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_TRIGGER) or not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS) or not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS) or not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_SOURCE_RESULT)
    return 37 if StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_GROUP) != StudioAccessibility::SemanticId::SIDEBAR or StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_TRIGGER) != StudioAccessibility::SemanticId::RESET_GROUP or StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS) != StudioAccessibility::SemanticId::RESET_GROUP or StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS) != StudioAccessibility::SemanticId::RESET_GROUP or StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_SOURCE_RESULT) != StudioAccessibility::SemanticId::RESET_GROUP
    return 38 if StudioAccessibility::first_child(StudioAccessibility::SemanticId::RESET_GROUP) != StudioAccessibility::SemanticId::RESET_TRIGGER or StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_TRIGGER, false) != StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_TRIGGER, true) != StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS or StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS, true) != StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS or StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS, true) != StudioAccessibility::SemanticId::RESET_SOURCE_RESULT or StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_SOURCE_RESULT, true) != StudioAccessibility::SemanticId::NO_NODE
    return 39 if StudioAccessibility::first_child(StudioAccessibility::SemanticId::SIDEBAR) != StudioIssueBrowserPolicy::Accessibility::GROUP_ID or StudioAccessibility::parent(StudioIssueBrowserPolicy::Accessibility::GROUP_ID) != StudioAccessibility::SemanticId::SIDEBAR or StudioAccessibility::next_sibling(StudioIssueBrowserPolicy::Accessibility::GROUP_ID) != StudioAccessibility::SemanticId::RESET_GROUP or StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_GROUP) != StudioAccessibility::SemanticId::SIDEBAR or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::RESET_GROUP) != StudioAccessibility::SemanticId::STACK_GROUP or StudioAccessibility::parent(StudioAccessibility::SemanticId::STACK_GROUP) != StudioAccessibility::SemanticId::SIDEBAR or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::STACK_GROUP) != StudioAccessibility::SemanticId::NO_NODE or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::SIDEBAR) != StudioAccessibility::SemanticId::STATUS
    return 40 if not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::STACK_GROUP) or not StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::STACK_DUPLICATE) or StudioAccessibility::parent(StudioAccessibility::SemanticId::STACK_DUPLICATE) != StudioAccessibility::SemanticId::STACK_GROUP or StudioAccessibility::first_child(StudioAccessibility::SemanticId::STACK_GROUP) != StudioAccessibility::SemanticId::STACK_DUPLICATE or StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::STACK_DUPLICATE) != StudioAccessibility::SemanticId::NO_NODE
    _ = puts("studio accessibility: workspace, export review, contact, reset and duplicate actions pass")
    return 0
