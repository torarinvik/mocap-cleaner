# Stable landmark identities and relationships used by the AppKit semantic
# tree. The canvas publishes its own roles and screen-space frames.
include "../../elisa-ui/src/core/ui_core.elisa"
include "../src/studio/accessibility.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioAccessibility::is_workspace_node(StudioAccessibility::WORKSPACE)
    return 2 if not StudioAccessibility::is_workspace_node(StudioAccessibility::SIDEBAR)
    return 3 if StudioAccessibility::is_workspace_node(239)
    return 4 if StudioAccessibility::parent(StudioAccessibility::WORKSPACE) != StudioAccessibility::NO_NODE
    return 5 if StudioAccessibility::first_child(StudioAccessibility::WORKSPACE) != StudioAccessibility::TOOLBAR
    return 6 if StudioAccessibility::parent(StudioAccessibility::STATUS) != StudioAccessibility::WORKSPACE
    return 7 if StudioAccessibility::next_sibling(StudioAccessibility::SIDEBAR) != StudioAccessibility::STATUS
    return 8 if StudioAccessibility::next_sibling(StudioAccessibility::STATUS) != StudioAccessibility::NO_NODE
    _ = puts("studio accessibility: stable workspace landmarks pass")
    return 0
