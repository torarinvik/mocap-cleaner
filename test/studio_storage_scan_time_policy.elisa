# Runtime calendar boundaries for the UTC scan timestamp adapter.
include "../src/studio/storage_scan_time_policy.elisa"

extern puts(text: cstr) -> i64

def matches(timestamp: i64, year: i64, month: i64, day: i64,
            hour: i64, minute: i64, second: i64) -> bool:
    parts: StudioStorageScanTimePolicy::UtcParts = StudioStorageScanTimePolicy::utc_parts(timestamp)
    parts.year == year and parts.month == month and parts.day == day and parts.hour == hour and parts.minute == minute and parts.second == second

def main() -> i32:
    return 1 if not matches(0, 1970, 1, 1, 0, 0, 0)
    return 2 if not matches(86400, 1970, 1, 2, 0, 0, 0)
    return 3 if not matches(951782400, 2000, 2, 29, 0, 0, 0)
    return 4 if not matches(1711843200, 2024, 3, 31, 0, 0, 0)
    return 5 if not matches(253402300799, 9999, 12, 31, 23, 59, 59)
    return 6 if StudioStorageScanTimePolicy::supported(0 - 1)
    return 7 if StudioStorageScanTimePolicy::supported(253402300800)
    _ = puts("studio storage scan time: UTC calendar boundaries pass")
    return 0
