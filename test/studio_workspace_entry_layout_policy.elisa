include "../src/studio/workspace_entry_layout_policy.elisa"

def main() -> i32:
    return 1 if StudioWorkspaceEntryLayoutPolicy::trigger_label(false, false) != "Choose Workspace"
    return 2 if StudioWorkspaceEntryLayoutPolicy::trigger_label(false, true) != "Finish Setup"
    return 3 if StudioWorkspaceEntryLayoutPolicy::trigger_label(true, false) != "Workspace / File"
    0
