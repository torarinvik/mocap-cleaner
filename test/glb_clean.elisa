include "../src/io/glb_tracks.elisa"

def load_or_empty(path: cstr) -> GlbDocument::Document:
    doc: GlbDocument::Document = catch GlbDocument::load(path):
        value: value
        error failure: GlbDocument::Document()
    return move doc

def main() -> i32:
    path: cstr = "../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"
    present: i32 = catch GlbDocument::load(path):
        value: 1
        GlbDocument::GlbError.OpenFailed: 0
        error failure: 2
    return 0 if present == 0
    return 9 if present != 1
    mutable doc: GlbDocument::Document = load_or_empty(path)
    anim: i64 = GlbDocument::find_animation(&doc, "jab")
    return 1 if anim < 0
    mutable ops: darray[Ops::Operation] = []
    ops.push(Ops::despike(0, 1000000, -1, 1))
    result: (tracks: i64, changed: i64, before: i64, after: i64) = GlbTracks::clean_animation(&doc, anim.usize(), ops, 20000)
    return 2 if result.tracks == 0
    return 3 if result.after > result.before
    saved: i32 = catch GlbDocument::save(&doc, "build/jab-clean.glb"):
        value: 0
        error failure: 4
    return saved
