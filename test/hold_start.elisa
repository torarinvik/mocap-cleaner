# Hold start gives the leading frames the first real pose and leaves every
# later frame, the frame count and sessions intact.
include "../src/ops/stack.elisa"
include "../src/studio/state/session_state.elisa"

def main() -> i32:
    mutable track: darray[i64] = [900000, 10, 12, 15, 19, 24]
    op: Ops::Operation = Ops::hold_start(1)
    out: darray[i64] = Ops::apply(op, 0, track, false)
    return 1 if out.count != track.count
    return 2 if out[0] != 10
    for f in 1..<track.count |out, track|:
        return 3 if out[f] != track[f]
    two: darray[i64] = Ops::apply(Ops::hold_start(2), 0, track, false)
    return 4 if two[0] != 12 or two[1] != 12 or two[2] != 12 or two[5] != 24
    whole: darray[i64] = Ops::apply(Ops::hold_start(6), 0, track, false)
    return 5 if whole[0] != 900000
    return 6 if SessionState::kind_from(SessionState::kind_code(Ops::Kind.HoldStart)) != Ops::Kind.HoldStart
    return 7 if SessionState::kind_from(SessionState::kind_code(Ops::Kind.Median)) != Ops::Kind.Median
    0
