# Reset actions have narrow scopes and each accepted reset is one undo step.
include "../src/studio/reset_scope.elisa"
include "../src/studio/state/history_state.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioResetScope::enabled(StudioResetScope::REMOVE_OPERATION, true, 0, 0, true)
    return 2 if StudioResetScope::enabled(StudioResetScope::REMOVE_OPERATION, false, 0, 0, true)
    return 3 if StudioResetScope::enabled(StudioResetScope::CLEAR_CONTACTS, false, 0, 0, false)
    return 4 if not StudioResetScope::enabled(StudioResetScope::CLEAR_CONTACTS, false, 1, 0, false)
    return 5 if StudioResetScope::enabled(StudioResetScope::CLEAR_CORRECTIONS, false, 0, 0, false)
    return 6 if not StudioResetScope::enabled(StudioResetScope::CLEAR_CORRECTIONS, false, 0, 1, false)
    return 7 if StudioResetScope::enabled(99, true, 1, 1, true)

    mutable one_op: StackState::Stack = StackState::empty()
    _ = StackState::add(&one_op, Ops::despike(0, 59, -1, 1))
    _ = StackState::add_edit(&one_op, StackState::LEFT, 4, 5, true)
    mutable op_history: HistoryState::History = zeroed
    HistoryState::reset(&op_history, one_op)
    return 24 if not StackState::remove(&one_op, one_op.selected)
    _ = HistoryState::record(&op_history, one_op)
    return 25 if op_history.count != 2 or not HistoryState::undo(&op_history)
    return 26 if HistoryState::current(&op_history).count != 1 or HistoryState::current(&op_history).edit_count != 1

    mutable contacts: StackState::Stack = StackState::empty()
    _ = StackState::add_edit(&contacts, StackState::LEFT, 10, 12, true)
    mutable history: HistoryState::History = zeroed
    HistoryState::reset(&history, contacts)
    return 8 if not StackState::clear_edits(&contacts)
    return 9 if contacts.edit_count != 0
    _ = HistoryState::record(&history, contacts)
    return 10 if history.count != 2 or not HistoryState::undo(&history)
    return 11 if HistoryState::current(&history).edit_count != 1

    mutable fixes: StackState::Stack = StackState::empty()
    fixes.fix_count <- 2
    HistoryState::reset(&history, fixes)
    return 12 if not StackState::clear_fixes(&fixes)
    return 13 if fixes.fix_count != 0
    _ = HistoryState::record(&history, fixes)
    return 14 if history.count != 2 or not HistoryState::undo(&history)
    return 15 if HistoryState::current(&history).fix_count != 2

    mutable cleanup: StackState::Stack = StackState::empty()
    _ = StackState::add(&cleanup, Ops::despike(0, 59, -1, 1))
    cleanup.fix_count <- 1
    cleanup.feet <- true
    cleanup.hands <- true
    _ = StackState::add_edit(&cleanup, StackState::RIGHT, 5, 9, false)
    _ = StackState::add_band(&cleanup, 15, 20, 1500, 60)
    mutable all_history: HistoryState::History = zeroed
    HistoryState::reset(&all_history, cleanup)
    return 16 if not StackState::reset_to_source(&cleanup)
    return 17 if cleanup.count != 0 or cleanup.selected != -1 or cleanup.fix_count != 0
    return 18 if cleanup.feet or cleanup.hands or cleanup.edit_count != 0 or cleanup.band_count != 0
    return 19 if cleanup.blend != StudioFoot::DEFAULT_BLEND
    return 27 if StackState::has_cleanup(cleanup)
    _ = HistoryState::record(&all_history, cleanup)
    return 20 if all_history.count != 2 or not HistoryState::undo(&all_history)
    restored: StackState::Stack = HistoryState::current(&all_history)
    return 21 if restored.count != 1 or restored.fix_count != 1 or not restored.feet or not restored.hands
    return 22 if restored.edit_count != 1 or restored.band_count != 1
    return 23 if StackState::reset_to_source(&cleanup)
    _ = puts("studio_reset_scope: scoped resets and atomic undo snapshots pass")
    return 0
