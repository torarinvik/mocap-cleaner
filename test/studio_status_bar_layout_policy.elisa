include "../proof/studio_status_bar_layout_policy_laws.elisa"

def main() -> i32:
    for width in -16384..<16385 |width|:
        start: i64 = StudioStatusBarLayoutPolicy::message_start(width)
        space: i64 = StudioStatusBarLayoutPolicy::message_width(width)
        summary: i64 = StudioStatusBarLayoutPolicy::summary_width(width)
        return 1 if start < 0 or start > 560 or space < 0 or summary < 0
        return 2 if not StudioStatusBarLayoutPolicyLaws::regions_do_not_overlap(width)
        if width > 24:
            return 3 if not StudioStatusBarLayoutPolicyLaws::message_fits(width)
        else:
            return 4 if not StudioStatusBarLayoutPolicyLaws::tiny_bar_draws_no_text(width)
    return 5 if StudioStatusBarLayoutPolicy::message_width(800) < 500
    return 0
