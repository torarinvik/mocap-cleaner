include "../proof/studio_status_text_extent_policy_laws.elisa"


def main() -> i32:
    for count in -2..<131:
        return 1 if not StudioStatusTextExtentPolicyLaws::admitted_is_bounded(count, true)
        return 2 if not StudioStatusTextExtentPolicyLaws::admitted_is_bounded(count, false)
        return 3 if not StudioStatusTextExtentPolicyLaws::nonempty_admission_requires_storage(count)
        if count < 0 or count > 128:
            return 4 if not StudioStatusTextExtentPolicyLaws::invalid_count_is_refused(count, true)
    return 5 if StudioStatusTextExtentPolicy::admitted(9223372036854775807, true)
    return 0
