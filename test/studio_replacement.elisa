# The replacement confirmation starts on Save, wraps across its three
# buttons, and ignores choices after dismissal.
include "../src/studio/replacement.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioReplacement::needs_prompt(false, false)
    return 2 if StudioReplacement::needs_prompt(false, true)
    return 3 if StudioReplacement::needs_prompt(true, false)
    return 4 if not StudioReplacement::needs_prompt(true, true)
    mutable focus: i64 = StudioReplacement::initial_focus()
    return 5 if focus != StudioReplacement::FOCUS_SAVE
    focus <- StudioReplacement::move_focus(focus, -1)
    return 6 if focus != StudioReplacement::FOCUS_CANCEL
    focus <- StudioReplacement::move_focus(focus, 1)
    return 7 if focus != StudioReplacement::FOCUS_SAVE
    return 8 if StudioReplacement::resolve(true, StudioReplacement::DISCARD) != StudioReplacement::DISCARD
    return 9 if StudioReplacement::resolve(false, StudioReplacement::SAVE) != StudioReplacement::NONE
    _ = puts("studio_replacement: dialog focus, wrap and resolution pass")
    return 0
