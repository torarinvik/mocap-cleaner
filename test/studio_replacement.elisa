# The replacement confirmation starts on Save, wraps across its three
# buttons, and ignores choices after dismissal.
include "../src/studio/replacement.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    mutable focus: i64 = StudioReplacement::initial_focus()
    return 1 if focus != StudioReplacement::FOCUS_SAVE
    focus <- StudioReplacement::move_focus(focus, -1)
    return 2 if focus != StudioReplacement::FOCUS_CANCEL
    focus <- StudioReplacement::move_focus(focus, 1)
    return 3 if focus != StudioReplacement::FOCUS_SAVE
    return 4 if StudioReplacement::resolve(true, StudioReplacement::DISCARD) != StudioReplacement::DISCARD
    return 5 if StudioReplacement::resolve(false, StudioReplacement::SAVE) != StudioReplacement::NONE
    _ = puts("studio_replacement: dialog focus, wrap and resolution pass")
    return 0
