# File menu actions remain labelled by stable row order, disable take-only
# commands before a take is loaded, and wrap keyboard navigation.
include "../src/studio/file_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioFilePolicy::action(0) != StudioFilePolicy::Command.OPEN_TAKE.i64()
    return 2 if StudioFilePolicy::action(1) != StudioFilePolicy::Command.OPEN_SESSION.i64()
    return 3 if StudioFilePolicy::action(2) != StudioFilePolicy::Command.SAVE.i64()
    return 4 if StudioFilePolicy::action(3) != StudioFilePolicy::Command.SAVE_AS.i64()
    return 5 if StudioFilePolicy::action(4) != StudioFilePolicy::Command.EXPORT_CURRENT.i64()
    return 6 if StudioFilePolicy::action(5) != StudioFilePolicy::Command.EXPORT_AS.i64()
    return 7 if StudioFilePolicy::action(6) != StudioFilePolicy::Command.OPEN_STORAGE.i64()
    return 8 if StudioFilePolicy::action(7) != StudioFilePolicy::Command.LOAD_CHARACTER.i64()
    return 8 if StudioFilePolicy::action(8) != StudioFilePolicy::Command.WORKSPACE.i64()
    return 7 if StudioFilePolicy::activate(-1, true) != StudioFilePolicy::Command.NONE.i64()
    return 8 if StudioFilePolicy::activate(0, false) != StudioFilePolicy::Command.OPEN_TAKE.i64()
    return 9 if StudioFilePolicy::activate(6, false) != StudioFilePolicy::Command.OPEN_STORAGE.i64()
    return 10 if not StudioFilePolicy::enabled(StudioFilePolicy::Command.OPEN_STORAGE.i64(), false)
    return 10 if StudioFilePolicy::activate(7, false) != StudioFilePolicy::Command.LOAD_CHARACTER.i64()
    return 10 if StudioFilePolicy::activate(8, false) != StudioFilePolicy::Command.WORKSPACE.i64()
    return 10 if not StudioFilePolicy::enabled(StudioFilePolicy::Command.WORKSPACE.i64(), false)
    for row in 1..<6 |row|:
        return 9 if StudioFilePolicy::activate(row, false) != StudioFilePolicy::Command.NONE.i64()
        return 10 if StudioFilePolicy::activate(row, true) != StudioFilePolicy::action(row)
    return 11 if StudioFilePolicy::next_enabled(0, -1, false, true, false) != 8
    return 12 if StudioFilePolicy::next_enabled(0, 1, false, true, false) != 6
    return 13 if StudioFilePolicy::next_enabled(2, 1, false, true, false) != 6
    return 14 if StudioFilePolicy::next_enabled(2, -1, false, true, false) != 0
    return 15 if StudioFilePolicy::next_enabled(6, 1, false, true, false) != 7
    return 16 if StudioFilePolicy::next_enabled(7, 1, false, true, false) != 8
    return 17 if StudioFilePolicy::next_enabled(0, 1, true, true, false) != 1
    return 18 if StudioFilePolicy::next_enabled(5, 1, true, true, false) != 6
    return 19 if StudioFilePolicy::next_enabled(6, 1, true, true, false) != 7
    return 20 if StudioFilePolicy::next_enabled(6, -1, true, true, false) != 5
    _ = puts("studio_file_policy: availability, activation and keyboard navigation pass")
    return 0
