# File menu actions remain labelled by stable row order, disable take-only
# commands before a take is loaded, and wrap keyboard navigation.
include "../src/studio/file_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioFilePolicy::action(0) != StudioFilePolicy::OPEN_TAKE
    return 2 if StudioFilePolicy::action(1) != StudioFilePolicy::OPEN_SESSION
    return 3 if StudioFilePolicy::action(2) != StudioFilePolicy::SAVE
    return 4 if StudioFilePolicy::action(3) != StudioFilePolicy::SAVE_AS
    return 5 if StudioFilePolicy::action(4) != StudioFilePolicy::EXPORT_CURRENT
    return 6 if StudioFilePolicy::action(5) != StudioFilePolicy::EXPORT_AS
    return 7 if StudioFilePolicy::action(6) != StudioFilePolicy::OPEN_STORAGE
    return 8 if StudioFilePolicy::action(7) != StudioFilePolicy::WORKSPACE
    return 7 if StudioFilePolicy::activate(-1, true) != StudioFilePolicy::NONE
    return 8 if StudioFilePolicy::activate(0, false) != StudioFilePolicy::OPEN_TAKE
    return 9 if StudioFilePolicy::activate(6, false) != StudioFilePolicy::OPEN_STORAGE
    return 10 if not StudioFilePolicy::enabled(StudioFilePolicy::OPEN_STORAGE, false)
    return 10 if StudioFilePolicy::activate(7, false) != StudioFilePolicy::WORKSPACE
    return 10 if not StudioFilePolicy::enabled(StudioFilePolicy::WORKSPACE, false)
    for row in 1..<6 |row|:
        return 9 if StudioFilePolicy::activate(row, false) != StudioFilePolicy::NONE
        return 10 if StudioFilePolicy::activate(row, true) != StudioFilePolicy::action(row)
    return 11 if StudioFilePolicy::next_enabled(0, -1, false) != 7
    return 12 if StudioFilePolicy::next_enabled(0, 1, false) != 6
    return 13 if StudioFilePolicy::next_enabled(2, 1, false) != 6
    return 14 if StudioFilePolicy::next_enabled(2, -1, false) != 0
    return 15 if StudioFilePolicy::next_enabled(6, 1, false) != 7
    return 16 if StudioFilePolicy::next_enabled(7, 1, false) != 0
    return 17 if StudioFilePolicy::next_enabled(0, 1, true) != 1
    return 18 if StudioFilePolicy::next_enabled(5, 1, true) != 6
    return 19 if StudioFilePolicy::next_enabled(6, 1, true) != 0
    return 20 if StudioFilePolicy::next_enabled(6, -1, true) != 5
    _ = puts("studio_file_policy: availability, activation and keyboard navigation pass")
    return 0
