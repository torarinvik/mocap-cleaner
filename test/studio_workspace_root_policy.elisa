# Workspace admission and root-commit boundaries fail closed.
include "../src/studio/workspace_root_policy.elisa"

def main() -> i32:
    return 1 if StudioWorkspaceRootPolicy::decision(8, true, true, true, true, true, false, false, false) != StudioWorkspaceRootPolicy::Decision.READY
    return 2 if StudioWorkspaceRootPolicy::decision(8, true, true, false, false, false, false, false, false) != StudioWorkspaceRootPolicy::Decision.NEEDS_BUILD
    return 3 if StudioWorkspaceRootPolicy::decision(8, true, true, false, false, false, false, true, false) != StudioWorkspaceRootPolicy::Decision.CREATE_BUILD
    return 4 if StudioWorkspaceRootPolicy::decision(8, false, true, true, true, true, false, false, false) != StudioWorkspaceRootPolicy::Decision.INVALID
    return 5 if StudioWorkspaceRootPolicy::decision(4096, true, true, true, true, true, false, false, false) != StudioWorkspaceRootPolicy::Decision.INVALID
    return 6 if StudioWorkspaceRootPolicy::decision(8, true, true, true, true, false, false, false, false) != StudioWorkspaceRootPolicy::Decision.UNWRITABLE
    return 7 if StudioWorkspaceRootPolicy::decision(8, true, true, true, true, true, true, false, false) != StudioWorkspaceRootPolicy::Decision.INVALID
    return 8 if StudioWorkspaceRootPolicy::decision(0, false, false, false, false, false, false, false, true) != StudioWorkspaceRootPolicy::Decision.CANCELLED
    return 9 if not StudioWorkspaceRootPolicy::commit_admitted(StudioWorkspaceRootPolicy::Decision.READY, true, true, false)
    return 10 if StudioWorkspaceRootPolicy::commit_admitted(StudioWorkspaceRootPolicy::Decision.READY, false, true, false)
    return 11 if StudioWorkspaceRootPolicy::commit_admitted(StudioWorkspaceRootPolicy::Decision.READY, true, false, false)
    return 12 if StudioWorkspaceRootPolicy::commit_admitted(StudioWorkspaceRootPolicy::Decision.READY, true, true, true)
    return 13 if StudioWorkspaceRootPolicy::commit_admitted(StudioWorkspaceRootPolicy::Decision.NEEDS_BUILD, true, true, false)
    0
