include "../proof/studio_fbx_failure_feedback_policy_laws.elisa"

def main() -> i64:
    for bytes in -1..<513:
        return 6 if StudioFbxFailureFeedbackPolicy::use_retained_status(bytes) != (bytes > 0)
        return 7 if bytes > 0 and not StudioFbxFailureFeedbackPolicyLaws::loaded_take_failure_keeps_explanation(bytes)
        return 8 if bytes <= 0 and not StudioFbxFailureFeedbackPolicyLaws::cleared_status_uses_live_message(bytes)
        return 5 if StudioFbxFailureFeedbackPolicy::use_retained_guide(true, bytes) != (bytes > 0)
        StudioFbxFailureFeedbackPolicyLaws::cleared_failure_uses_current_guidance(bytes)
        StudioFbxFailureFeedbackPolicyLaws::absent_explanation_uses_current_guidance(bytes) if bytes <= 0
        StudioFbxFailureFeedbackPolicyLaws::failure_explanation_is_retained(bytes) if bytes > 0
    for loaded_code in 0..<2:
        for cancelled_code in 0..<2:
            for closing_code in 0..<2:
                for ticket in -1..<4:
                    for current in -1..<4:
                        loaded: bool = loaded_code == 1
                        cancelled: bool = cancelled_code == 1
                        closing: bool = closing_code == 1
                        expected: bool = not loaded and not cancelled and not closing and ticket > 0 and ticket == current
                        actual: bool = StudioFbxFailureFeedbackPolicy::show_failure(loaded, cancelled, closing, ticket, current)
                        return 1 if actual != expected
                        StudioFbxFailureFeedbackPolicyLaws::empty_guide_requires_current_feedback(loaded, cancelled, closing, ticket, current)
                        feedback_expected: bool = not cancelled and not closing and ticket > 0 and ticket == current
                        return 4 if StudioFbxFailureFeedbackPolicy::may_replace_feedback(cancelled, closing, ticket, current) != feedback_expected
                        StudioFbxFailureFeedbackPolicyLaws::cancelled_or_closing_cannot_replace_feedback(ticket, current)
                        StudioFbxFailureFeedbackPolicyLaws::obsolete_request_cannot_replace_feedback(ticket, current) if ticket != current
                        StudioFbxFailureFeedbackPolicyLaws::invalid_request_cannot_replace_feedback(ticket, current) if ticket <= 0
                        StudioFbxFailureFeedbackPolicyLaws::active_take_is_preserved(ticket, current)
                        StudioFbxFailureFeedbackPolicyLaws::cancelled_and_closing_are_not_failures(ticket, current)
                        StudioFbxFailureFeedbackPolicyLaws::obsolete_result_is_not_failure(ticket, current) if ticket != current
                        StudioFbxFailureFeedbackPolicyLaws::invalid_ticket_is_not_failure(ticket, current) if ticket <= 0
    StudioFbxFailureFeedbackPolicyLaws::current_empty_failure_is_visible(1)
    StudioFbxFailureFeedbackPolicyLaws::current_request_can_report_failure(1)
    return 11 if not StudioFbxFailureFeedbackPolicyLaws::terminal_setup_refusal_replaces_progress()
    return 12 if not StudioFbxFailureFeedbackPolicyLaws::pending_progress_is_not_failure()
    return 13 if not StudioFbxFailureFeedbackPolicyLaws::cancelled_or_closing_setup_does_not_replace_feedback()
    return 9 if not StudioFbxFailureFeedbackPolicyLaws::loaded_failure_is_retained_without_replacing_take(1)
    return 10 if not StudioFbxFailureFeedbackPolicyLaws::loaded_failure_is_retained_without_replacing_take(9223372036854775807)
    StudioFbxFailureFeedbackPolicyLaws::current_request_can_report_failure(9223372036854775807)
    StudioFbxFailureFeedbackPolicyLaws::current_empty_failure_is_visible(9223372036854775807)
    StudioFbxFailureFeedbackPolicyLaws::obsolete_result_is_not_failure(9223372036854775807, 1)
    StudioFbxFailureFeedbackPolicyLaws::invalid_ticket_is_not_failure(-9223372036854775807 - 1, 1)
    0
