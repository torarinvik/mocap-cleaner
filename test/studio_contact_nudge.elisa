# Exact signed-frame contact range nudges and atomic boundary rejection.
include "../src/studio/contact_editor.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    first: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.First.i64(), 1)
    return 1 if not first.valid or first.first != 11 or first.last != 20
    last: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Last.i64(), -1)
    return 2 if not last.valid or last.first != 10 or last.last != 19
    interval: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Interval.i64(), -5)
    return 3 if not interval.valid or interval.first != 5 or interval.last != 15
    return 4 if StudioContactEditor::nudge_plan(0, 20, 100, StudioContactEditor::NudgeTarget.First.i64(), -1).valid
    return 5 if StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.First.i64(), 11).valid
    return 6 if StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Last.i64(), -11).valid
    return 7 if StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Last.i64(), 80).valid
    return 8 if StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Interval.i64(), -11).valid
    return 9 if StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Interval.i64(), 80).valid
    no_op: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(10, 20, 100, StudioContactEditor::NudgeTarget.Interval.i64(), 0)
    return 10 if no_op.valid or no_op.first != 10 or no_op.last != 20
    edge_start: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(0, 0, 1, StudioContactEditor::NudgeTarget.First.i64(), 1)
    return 11 if edge_start.valid
    edge_end: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(999999, 999999, 1000000, StudioContactEditor::NudgeTarget.Interval.i64(), 1)
    return 12 if edge_end.valid or edge_end.first != 999999 or edge_end.last != 999999
    past_old_limit: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(1000000, 1000002, 10000000, StudioContactEditor::NudgeTarget.Interval.i64(), 1)
    return 13 if not past_old_limit.valid or past_old_limit.first != 1000001 or past_old_limit.last != 1000003
    new_limit: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(9999998, 9999999, 10000000, StudioContactEditor::NudgeTarget.Last.i64(), 1)
    return 14 if new_limit.valid or new_limit.first != 9999998 or new_limit.last != 9999999
    invalid_target: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(10, 20, 100, -1, 1)
    return 15 if invalid_target.valid or invalid_target.first != 10 or invalid_target.last != 20
    _ = puts("studio_contact_nudge: exact endpoint/range moves and atomic bounds pass")
    return 0
