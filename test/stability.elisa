include "../src/ops/stack.elisa"

def main() -> i32:
    return 1 if Stability::limit_wring(1200, 1000, 300) != 1200        # inside
    return 2 if Stability::limit_wring(1500, 1000, 300) != 1400        # 300 + 200/2
    return 3 if Stability::limit_wring(500, 1000, 300) != 600          # -300 - 200/2
    return 4 if Stability::soften(0, 0) != 0
    return 5 if Stability::soften(10, 0) != 5
    # A knee track with a wring excursion around a guard of 0.
    knee: mutable darray[i64] = []
    for i in 0..<40 |knee|:
        knee.push(2000 if i == 20 else 0)
    ops: mutable darray[Ops::Operation] = []
    ops.push(Ops::limit_wring(0, 39, -1, 500))
    out: darray[i64] = Ops::evaluate(ops, 0, knee, false)
    return 6 if out[20] >= 2000 or out[20] < 500             # compressed, not past limit
    return 7 if out[0] != knee[0] or out[39] != knee[39]     # clip edges exact
    return 0
