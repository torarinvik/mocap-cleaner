# Unreal mannequin bone names map onto the common roles, so balance, leg
# and hinge tools work on UE4/UE5 takes; twist bones never take a main role.
include "../src/io/rig_map.elisa"

def role(name: sview) -> i64:
    mutable bytes: darray[u8] = []
    bytes.extend(name)
    RigMap::role_of_name(bytes)

def main() -> i32:
    return 1 if role("pelvis") != Roles::Joint.Hips.i64()
    return 2 if role("thigh_l") != Roles::Joint.LeftUpleg.i64()
    return 3 if role("calf_l") != Roles::Joint.LeftLeg.i64()
    return 4 if role("foot_l") != Roles::Joint.LeftFoot.i64()
    return 5 if role("ball_r") != Roles::Joint.RightToe.i64()
    return 6 if role("upperarm_r") != Roles::Joint.RightArm.i64()
    return 7 if role("Armature|lowerarm_l") != Roles::Joint.LeftForearm.i64()
    return 8 if role("thigh_twist_01_l") != Roles::Joint.None.i64()
    return 9 if role("calf_twist_01_l") != Roles::Joint.LeftLegRoll.i64()
    return 10 if role("mixamorig:LeftUpLeg") != Roles::Joint.LeftUpleg.i64()
    0
