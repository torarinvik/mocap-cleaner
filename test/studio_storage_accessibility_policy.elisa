# Focused semantic names and state mapping for Storage & Recovery.
include "../src/studio/storage_accessibility_policy.elisa"
include "../src/studio/file_policy.elisa"
include "../src/studio/app/storage_accessibility_copy.elisa"

def main() -> i32:
    return 1 if StudioStorageAccessibilityPolicy::Node::DIALOG != 160
    return 2 if StudioStorageAccessibilityPolicy::row_id(0) != 162
    return 3 if StudioStorageAccessibilityPolicy::row_id(5) != 167
    return 4 if StudioStorageAccessibilityPolicy::row_index(167) != 5
    return 5 if StudioStorageAccessibilityPolicy::parent(162) != StudioStorageAccessibilityPolicy::Node::INVENTORY
    return 6 if StudioStorageAccessibilityPolicy::next_sibling(161, 0) != StudioStorageAccessibilityPolicy::Node::PROTECTED
    row_sibling: usize = StudioStorageAccessibilityPolicy::next_sibling(162, 2)
    return 7 if row_sibling != 163
    return 8 if StudioStorageAccessibilityPolicy::parent(row_sibling) != StudioStorageAccessibilityPolicy::parent(162)
    return 9 if StudioStorageAccessibilityPolicy::next_sibling(163, 2) != StudioStorageAccessibilityPolicy::Node::NO_NODE
    return 10 if StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::next_sibling(161, 0)) != StudioStorageAccessibilityPolicy::parent(161)
    return 11 if StudioStorageAccessibilityPolicy::file_first_child(174) != 175
    return 12 if StudioStorageAccessibilityPolicy::file_first_child(175) != 176
    return 13 if StudioStorageAccessibilityPolicy::parent(176) != 175
    return 14 if StudioStorageAccessibilityPolicy::file_next_sibling(183) != StudioStorageAccessibilityPolicy::Node::NO_NODE
    return 15 if StudioStorageAccessibilityPolicy::file_command(176) != StudioFilePolicy::action(0)
    return 16 if StudioStorageAccessibilityPolicy::file_command(182) != StudioFilePolicy::action(6)
    return 17 if not StudioStorageAccessibilityPolicy::file_command_enabled(182, false)
    return 18 if StudioStorageAccessibilityPolicy::file_command_enabled(178, false)
    return 18 if StudioStorageAccessibilityPolicy::file_command(183) != StudioFilePolicy::WORKSPACE
    return 18 if not StudioStorageAccessibilityPolicy::file_command_enabled(183, false)
    return 19 if StudioStorageAccessibilityPolicy::action_enabled(StudioStorageAccessibilityPolicy::Action::ACTION_RESTORE, false)
    return 20 if not StudioStorageAccessibilityPolicy::action_enabled(StudioStorageAccessibilityPolicy::Action::ACTION_RESTORE, true)
    return 36 if StudioStorageAccessibilityPolicy::Action::ACTION_COUNT != 10
    return 37 if StudioStorageAccessibilityPolicy::Node::TRASH <= 182 or StudioStorageAccessibilityPolicy::Node::RETENTION <= 182
    return 38 if StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::Action::ACTION_TRASH) != StudioStorageAccessibilityPolicy::Node::TRASH
    return 39 if StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::Action::ACTION_RETENTION) != StudioStorageAccessibilityPolicy::Node::RETENTION
    return 40 if StudioStorageAccessibilityPolicy::action_id(99) != StudioStorageAccessibilityPolicy::Node::NO_NODE
    return 41 if StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::Node::TRASH) != StudioStorageAccessibilityPolicy::Action::ACTION_TRASH
    return 42 if StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::Node::RETENTION) != StudioStorageAccessibilityPolicy::Action::ACTION_RETENTION
    return 43 if not StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::Node::TRASH)
    return 44 if not StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::Node::RETENTION)
    return 45 if StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::RESTORE, 0) != StudioStorageAccessibilityPolicy::Node::TRASH
    return 46 if StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::TRASH, 0) != StudioStorageAccessibilityPolicy::Node::RETENTION
    return 47 if StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::RETENTION, 0) != StudioStorageAccessibilityPolicy::Node::SELECT_ELIGIBLE
    return 48 if StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::TRASH) != StudioStorageAccessibilityPolicy::Node::DIALOG
    return 49 if StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::RETENTION) != StudioStorageAccessibilityPolicy::Node::DIALOG
    return 50 if StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::Action::ACTION_TRASH, true, false)
    return 51 if not StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::Action::ACTION_TRASH, false, true)
    return 52 if not StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::Action::ACTION_RETENTION, false, false)
    return 21 if not StudioStorageAccessibilityPolicy::row_selected(9, 9)
    return 22 if StudioStorageAccessibilityPolicy::row_selected(8, 9)
    return 23 if not StudioStorageAccessibilityPolicy::status_protected(StudioStorageAccessibilityCopy::Status.Changed.i64())
    return 24 if StudioStorageAccessibilityPolicy::status_protected(StudioStorageAccessibilityCopy::Status.InTrash.i64())
    return 25 if StudioStorageAccessibilityCopy::dialog_name(false) != "Storage & Recovery"
    return 26 if StudioStorageAccessibilityCopy::dialog_name(true) != "Confirm restore"
    return 27 if StudioStorageAccessibilityCopy::kind_name(StudioStorageAccessibilityCopy::Kind.Report.i64()) != "Quality report"
    return 28 if StudioStorageAccessibilityCopy::status_name(StudioStorageAccessibilityCopy::Status.Unverified.i64()) != "Could not verify"
    row: StudioStorageAccessibilityCopy::RowCopy = StudioStorageAccessibilityCopy::row_copy(0, 2, true)
    return 29 if row.kind != "Recovery" or row.status != "Changed identity" or row.selection != "Selected"
    return 30 if row.help != "Protected: the file identity changed since registration. Restore is unavailable."
    return 31 if StudioStorageAccessibilityCopy::action_name(2, true) != "Confirm restore"
    return 53 if StudioStorageAccessibilityCopy::action_name(3, false) != "Move to Trash"
    return 54 if StudioStorageAccessibilityCopy::action_name_with_reviews(3, false, true) != "Confirm move to Trash"
    return 55 if StudioStorageAccessibilityCopy::action_name(4, false) != "Retention"
    return 56 if StudioStorageAccessibilityCopy::retention_value(7) != "Retain 7 days"
    return 57 if StudioStorageAccessibilityCopy::retention_value(30) != "Retain 30 days"
    return 58 if StudioStorageAccessibilityCopy::retention_value(90) != "Retain 90 days"
    return 59 if StudioStorageAccessibilityCopy::retention_value(365) != "Retain 365 days"
    return 60 if StudioStorageAccessibilityCopy::action_help_with_cleanup(4, false, false, false, false) != "Choose how long generated files are retained before cleanup eligibility. Changing this setting does not move files."
    return 61 if StudioStorageAccessibilityCopy::action_help_with_cleanup(3, false, false, true, true) != "Confirm only after the selected eligible files remain verified. Trash may continue to use disk space."
    return 32 if StudioStorageAccessibilityCopy::file_command_name(6) != "Storage & Recovery"
    return 32 if StudioStorageAccessibilityCopy::file_command_name(7) != "Locate or create workspace"
    return 33 if StudioStorageAccessibilityCopy::file_command_help(6, false) != "Open Storage & Recovery to review Studio-managed files. Available without a loaded take."
    return 34 if StudioStorageAccessibilityCopy::result_announcement(6) != "File restored to its original location. The inventory is updated."
    return 35 if StudioStorageAccessibilityCopy::result_announcement(9) != "The reviewed inventory changed. Review the refreshed inventory before taking action."
    return 62 if not StudioStorageAccessibilityPolicy::result_is_alert(11)
    return 63 if not StudioStorageAccessibilityPolicy::result_is_alert(12)
    return 64 if not StudioStorageAccessibilityPolicy::result_is_alert(13)
    return 65 if not StudioStorageAccessibilityPolicy::result_is_alert(15)
    return 66 if StudioStorageAccessibilityPolicy::result_is_alert(10)
    return 67 if StudioStorageAccessibilityCopy::result_announcement(10) != "Selected files were moved to Finder Trash and recorded for recovery. Trash may still use disk space."
    return 68 if StudioStorageAccessibilityCopy::result_announcement(11) != "Move to Trash failed. A fresh identity check confirmed the original file remains in build/."
    return 69 if StudioStorageAccessibilityCopy::result_announcement(12) != "The Trash receipt could not be saved. A fresh identity check confirmed the file was restored to build/."
    return 70 if StudioStorageAccessibilityCopy::result_announcement(13) != "The Trash receipt could not be saved and rollback failed. The verified recovery receipt is retained for retry or manual recovery."
    return 71 if StudioStorageAccessibilityCopy::result_announcement(15) != "The move result is uncertain. Refresh to verify the item's location; check Finder Trash manually if it is not in build/."
    return 0
