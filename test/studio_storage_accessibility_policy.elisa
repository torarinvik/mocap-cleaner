# Focused semantic names and state mapping for Storage & Recovery.
include "../src/studio/storage_accessibility_policy.elisa"
include "../src/studio/app/storage_accessibility_copy.elisa"

def main() -> i32:
    return 1 if StudioStorageAccessibilityPolicy::DIALOG != 160
    return 2 if StudioStorageAccessibilityPolicy::row_id(0) != 162
    return 3 if StudioStorageAccessibilityPolicy::row_id(5) != 167
    return 4 if StudioStorageAccessibilityPolicy::row_index(167) != 5
    return 5 if StudioStorageAccessibilityPolicy::parent(162) != StudioStorageAccessibilityPolicy::INVENTORY
    return 6 if StudioStorageAccessibilityPolicy::next_sibling(161, 0) != StudioStorageAccessibilityPolicy::PROTECTED
    return 7 if StudioStorageAccessibilityPolicy::next_sibling(162, 2) != 163
    return 8 if StudioStorageAccessibilityPolicy::action_enabled(StudioStorageAccessibilityPolicy::ACTION_RESTORE, false)
    return 9 if not StudioStorageAccessibilityPolicy::action_enabled(StudioStorageAccessibilityPolicy::ACTION_RESTORE, true)
    return 10 if not StudioStorageAccessibilityPolicy::row_selected(9, 9)
    return 11 if StudioStorageAccessibilityPolicy::row_selected(8, 9)
    return 12 if not StudioStorageAccessibilityPolicy::status_protected(StudioStorageAccessibilityCopy::STATUS_CHANGED)
    return 13 if StudioStorageAccessibilityPolicy::status_protected(StudioStorageAccessibilityCopy::STATUS_IN_TRASH)
    return 14 if StudioStorageAccessibilityCopy::dialog_name(false) != "Storage & Recovery"
    return 15 if StudioStorageAccessibilityCopy::dialog_name(true) != "Confirm restore"
    return 16 if StudioStorageAccessibilityCopy::kind_name(StudioStorageAccessibilityCopy::KIND_REPORT) != "Quality report"
    return 17 if StudioStorageAccessibilityCopy::status_name(StudioStorageAccessibilityCopy::STATUS_UNVERIFIED) != "Could not verify"
    row: StudioStorageAccessibilityCopy::RowCopy = StudioStorageAccessibilityCopy::row_copy(0, 2, true)
    return 18 if row.kind != "Recovery" or row.status != "Changed identity" or row.selection != "Selected"
    return 19 if row.help != "Protected: the file identity changed since registration. Restore is unavailable."
    return 20 if StudioStorageAccessibilityCopy::action_name(2, true) != "Confirm restore"
    return 21 if StudioStorageAccessibilityCopy::result_announcement(6) != "File restored to its original location. The inventory is updated."
    return 22 if StudioStorageAccessibilityCopy::result_announcement(9) != "The recovery item changed. Review the refreshed inventory before restoring."
    return 0
