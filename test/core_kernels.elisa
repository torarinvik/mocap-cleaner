include "../src/core/fade.elisa"
include "../src/core/order.elisa"
include "../src/core/span.elisa"
include "../src/core/gate.elisa"
include "../src/core/seam.elisa"
include "../src/detect/contact.elisa"
include "../src/detect/spike.elisa"

def main() -> i32:
    return 1 if Fade::weight(0, 19, 8, false) != 0
    return 2 if Fade::weight(19, 19, 8, false) != 0
    return 3 if Fade::weight(10, 19, 8, false) != 1000
    return 4 if Fade::weight(4, 19, 8, false) != 500
    return 5 if Fade::weight(0, 19, 8, true) != 1000
    return 10 if Order::median3(5, 1, 9) != 5
    return 11 if Order::median3(9, 9, 1) != 9
    return 12 if Order::median3(-3, 7, 2) != 2
    return 13 if Order::clamp(12, 0, 10) != 10
    return 20 if Span::wrap(-1, 10) != 9
    return 21 if Span::wrap(23, 10) != 3
    return 22 if Span::clamp(-4, 10) != 0
    return 23 if not Span::contains(2, 5, 5)
    return 30 if Gate::weight(false, true, true, 700) != 0
    return 31 if Gate::weight(true, true, true, 700) != 700
    return 32 if Gate::apply(100, 300, 0) != 100
    return 33 if Gate::apply(100, 300, 500) != 200
    return 34 if not Gate::bone_selected(5, 2)
    return 35 if Gate::bone_selected(5, 1)
    return 40 if Seam::pull(99, 99, 10) != 1000
    return 41 if Seam::pull(80, 99, 10) != 0
    return 42 if Seam::pull(94, 99, 10) != 500
    return 43 if Seam::jump(3, -4) != 7
    return 50 if not Contact::step(false, 5, 0, 10, 20, 100)
    return 51 if not Contact::step(true, 15, 0, 10, 20, 100)
    return 52 if Contact::step(false, 15, 0, 10, 20, 100)
    return 53 if Contact::step(true, 5, 500, 10, 20, 100)
    return 54 if Contact::pinned_height(true, 37, 0) != 0
    return 60 if not Spike::is_spike(0, 100, 0, 50)
    return 61 if Spike::is_spike(0, 100, 200, 50)
    return 62 if Spike::accel(1, 1, 1) != 0
    return 0
