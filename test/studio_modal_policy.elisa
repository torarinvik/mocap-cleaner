# Modal overlays hide hosted viewports; closing all overlays restores them.
include "../src/studio/modal_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i64:
    return 1 if StudioModalPolicy::hides_viewports(false, false, false, false, false, false, false)
    return 2 if not StudioModalPolicy::hides_viewports(true, false, false, false, false, false, false)
    return 3 if not StudioModalPolicy::hides_viewports(false, true, false, false, false, false, false)
    return 4 if not StudioModalPolicy::hides_viewports(false, false, true, false, false, false, false)
    return 5 if not StudioModalPolicy::hides_viewports(false, false, false, true, false, false, false)
    return 6 if not StudioModalPolicy::hides_viewports(false, false, false, false, true, false, false)
    return 7 if not StudioModalPolicy::hides_viewports(false, false, false, false, false, true, false)
    return 8 if not StudioModalPolicy::hides_viewports(false, false, false, false, false, false, true)
    _ = puts("studio modal policy: all custom overlays hide hosted viewport layers")
    0
