include "../proof/studio_failure_guide_layout_policy_laws.elisa"

def main() -> i64:
    for extent in -16384..=16384:
        StudioFailureGuideLayoutPolicyLaws::dimensions_are_bounded(extent, extent)
        StudioFailureGuideLayoutPolicyLaws::rows_reserve_retry_space(extent) if extent >= 100
        StudioFailureGuideLayoutPolicyLaws::insufficient_space_has_no_rows(extent) if extent <= 100
        expected_width: i64 = 0 if extent <= 80 else extent - 80
        return 2 if StudioFailureGuideLayoutPolicy::content_width(extent) != expected_width
        expected_rows: i64 = 0 if extent <= 100 else 6 if extent >= 220 else (extent - 100) / 20
        return 3 if StudioFailureGuideLayoutPolicy::rows(extent) != expected_rows
    0
