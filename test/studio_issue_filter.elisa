# Pure issue-filter behavior, including unknown aggregate subject handling.
include "../src/studio/issue_filter_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    issue: StudioIssues::Issue = StudioIssues::Issue{selectable: true, first_frame: 2, last_frame: 4, peak_frame: 3, issue_type: 5, subject_id: -1, source_revision: 7, severity: 600, peak_value: 130, threshold: 100}
    all: StudioIssueFilterPolicy::Filter = StudioIssueFilterPolicy::Filter{detector: StudioIssueFilterPolicy::Wildcard::DETECTOR, subject: StudioIssueFilterPolicy::Wildcard::SUBJECT, minimum_severity: 0, status: StudioIssueFilterPolicy::Disposition::ANY}
    return 1 if not StudioIssueFilterPolicy::matches(issue, all, StudioIssueFilterPolicy::Disposition::UNRESOLVED)
    return 2 if not StudioIssueFilterPolicy::matches(issue, all, StudioIssueFilterPolicy::Disposition::IGNORED)
    exact_subject: StudioIssueFilterPolicy::Filter = StudioIssueFilterPolicy::Filter{detector: 5, subject: 4, minimum_severity: 0, status: StudioIssueFilterPolicy::Disposition::ANY}
    return 3 if StudioIssueFilterPolicy::matches(issue, exact_subject, StudioIssueFilterPolicy::Disposition::UNRESOLVED)
    detector_severity: StudioIssueFilterPolicy::Filter = StudioIssueFilterPolicy::Filter{detector: 5, subject: StudioIssueFilterPolicy::Wildcard::SUBJECT, minimum_severity: 600, status: StudioIssueFilterPolicy::Disposition::UNRESOLVED}
    return 4 if not StudioIssueFilterPolicy::matches(issue, detector_severity, StudioIssueFilterPolicy::Disposition::UNRESOLVED)
    detector_severity.minimum_severity <- 601
    return 5 if StudioIssueFilterPolicy::matches(issue, detector_severity, StudioIssueFilterPolicy::Disposition::UNRESOLVED)
    detector_severity.minimum_severity <- 0
    detector_severity.status <- StudioIssueFilterPolicy::Disposition::IGNORED
    return 6 if StudioIssueFilterPolicy::matches(issue, detector_severity, StudioIssueFilterPolicy::Disposition::UNRESOLVED)
    return 7 if not StudioIssueFilterPolicy::matches(issue, detector_severity, StudioIssueFilterPolicy::Disposition::IGNORED)
    issue.severity <- StudioIssueFilterPolicy::Severity::MAX
    detector_severity.minimum_severity <- StudioIssueFilterPolicy::Severity::MAX
    return 8 if not StudioIssueFilterPolicy::matches(issue, detector_severity, StudioIssueFilterPolicy::Disposition::IGNORED)
    issue.selectable <- false
    detector_severity.status <- StudioIssueFilterPolicy::Disposition::ANY
    return 9 if StudioIssueFilterPolicy::matches(issue, detector_severity, StudioIssueFilterPolicy::Disposition::UNRESOLVED)
    _ = puts("studio_issue_filter: detector, subject, severity and disposition filters pass")
    return 0
