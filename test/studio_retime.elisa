# Headless tests of studio retiming (no window): the Shift-drag selection,
# speed presets and typed speeds, bands in the stack (overlap refused, edge
# moves, removal), select -> set speed -> undo -> redo through history, and
# the model build on the boxing clip (length grows at 0.5x, ghost maps to
# source frames, back to the source length on undo).
include "../src/studio/app/model.elisa"

const PATH: cstr = "../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"

def selection_and_speeds() -> i32:
    s0: RetimeState::Selection = RetimeState::begin(40)
    s1: RetimeState::Selection = RetimeState::drag(s0, 12)
    return 1 if RetimeState::lo(&s1) != 12 or RetimeState::hi(&s1) != 40 or not RetimeState::ready(&s1)
    return 2 if RetimeState::ready(&s0)
    n: RetimeState::Selection = RetimeState::none()
    return 3 if RetimeState::ready(&n) or RetimeState::drag(n, 5).active
    return 4 if RetimeState::preset(0) != 500 or RetimeState::preset(1) != 680 or RetimeState::preset(6) != 2000
    return 5 if RetimeState::parse_speed("0.68") != 680 or RetimeState::parse_speed("1.5x") != 1500 or RetimeState::parse_speed("2") != 2000
    return 6 if RetimeState::parse_speed("5") != -1 or RetimeState::parse_speed("0.05") != -1 or RetimeState::parse_speed("abc") != -1 or RetimeState::parse_speed("") != -1
    return 0

def bands() -> i32:
    mutable s: StackState::Stack = StackState::empty()
    return 10 if not StackState::add_band(&s, 10, 30, 500, 100)
    return 11 if StackState::add_band(&s, 25, 50, 500, 100)
    return 12 if StackState::add_band(&s, 60, 120, 500, 100) or StackState::add_band(&s, 40, 40, 500, 100)
    return 13 if not StackState::add_band(&s, 31, 50, 9000, 100) or s.bands[1].speed != Retime::MAX_RATE
    return 14 if StackState::band_at(&s, 20) != 0 or StackState::band_at(&s, 31) != 1 or StackState::band_at(&s, 70) != -1
    # Edges: no overlap with the neighbour, no empty band.
    return 15 if StackState::move_band_edge(&s, 0, true, 35, 100)
    return 16 if not StackState::move_band_edge(&s, 0, false, 5, 100) or s.bands[0].first != 5
    return 17 if StackState::move_band_edge(&s, 0, false, 30, 100)
    e: RetimeState::EdgeDrag = RetimeState::edge_near(&s, 51, 2)
    return 18 if e.band != 1 or not e.last_edge
    return 19 if not StackState::remove_band(&s, 0) or s.band_count != 1 or s.bands[0].first != 31
    return 0

# Select, set speed, undo, redo; the model follows.
def history_and_model() -> i32:
    initial: StackState::Stack = StudioModel::initial_stack()
    mutable h: HistoryState::History = zeroed
    HistoryState::reset(&h, initial)
    base: StudioModel::Clip? = StudioModel::build(PATH, "jab", initial)
    if base is b:
        frames: i64 = b.frames
        return 20 if b.retimed or b.source_frames != frames
        sel: RetimeState::Selection = RetimeState::drag(RetimeState::begin(frames * 3 / 4), frames / 4)
        mutable s: StackState::Stack = HistoryState::current(&h)
        first: i64 = StudioModel::source_frame(b, RetimeState::lo(&sel))
        last: i64 = StudioModel::source_frame(b, RetimeState::hi(&sel))
        return 21 if not RetimeState::apply_speed(&s, first, last, RetimeState::preset(0), frames)
        return 22 if not HistoryState::record(&h, s)
        slow: StudioModel::Clip? = StudioModel::build(PATH, "jab", HistoryState::current(&h))
        if slow is c:
            span: i64 = last - first + 1
            return 23 if not c.retimed or c.frames < frames + span - 8 or c.frames > frames + span + 1
            return 24 if c.left_contact.count.i64() != c.frames or c.source_problems.count.i64() != c.frames
            # Ghost (source) frames: identity before the band, last on last.
            return 25 if StudioModel::source_frame(c, 3) != 3 or StudioModel::source_frame(c, c.frames - 1) != frames - 1
            return 26 if StudioModel::output_frame(c, frames - 1) != c.frames - 1
        else:
            return 27
        # Same selection again sets the band's speed instead of adding one.
        mutable t: StackState::Stack = HistoryState::current(&h)
        return 28 if not RetimeState::apply_speed(&t, first, last, 1500, frames) or t.band_count != 1 or t.bands[0].speed != 1500
        return 29 if not HistoryState::record(&h, t)
        return 30 if not HistoryState::undo(&h)
        u: StackState::Stack = HistoryState::current(&h)
        return 31 if u.band_count != 1 or u.bands[0].speed != 500
        return 32 if not HistoryState::undo(&h)
        v: StackState::Stack = HistoryState::current(&h)
        return 33 if v.band_count != 0
        back: StudioModel::Clip? = StudioModel::build(PATH, "jab", v)
        if back is c:
            return 34 if c.retimed or c.frames != frames
        return 35 if not HistoryState::redo(&h)
        w: StackState::Stack = HistoryState::current(&h)
        return 36 if w.band_count != 1 or w.bands[0].speed != 500
        # 1x band: no change in length.
        mutable one: StackState::Stack = initial
        _ = StackState::add_band(&one, first, last, 1000, frames)
        same: StudioModel::Clip? = StudioModel::build(PATH, "jab", one)
        if same is c:
            return 37 if c.retimed or c.frames != frames
        return 0
    return 0

def main() -> i32:
    rc: i32 = selection_and_speeds()
    return rc if rc != 0
    rc2: i32 = bands()
    return rc2 if rc2 != 0
    return history_and_model()
