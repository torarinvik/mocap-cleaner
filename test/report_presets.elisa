# Report HTML and preset tables.
include "../src/io/report.elisa"
include "../src/ops/presets.elisa"

def contains(out: darray[u8]&, text: cstr) -> bool:
    mutable n: usize = 0
    while text[n] != 0:
        n <- n + 1
    return false if out.count < n
    for s in 0..<(out.count - n + 1):
        mutable k: usize = 0
        while k < n and out[s + k] == text[k]:
            k <- k + 1
        return true if k == n
    return false

def main() -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    mutable html: darray[u8] = []
    Report::begin(&html)
    Report::row(&html, "a<b&c.glb".cast[cstr], Report::Row{ok: true, tracks: 156, changed: -42, before: 3, after: 0})
    Report::row(&html, "bad.glb".cast[cstr], Report::Row{ok: false, tracks: 0, changed: 0, before: 0, after: 0})
    Report::finish(&html)
    return 1 if not contains(&html, "a&lt;b&amp;c.glb".cast[cstr])
    return 2 if not contains(&html, "<td>156</td><td>-42</td><td>3</td><td>0</td>".cast[cstr])
    return 3 if not contains(&html, "class=bad>failed".cast[cstr])
    return 4 if not contains(&html, "</table>".cast[cstr])
    return 5 if Presets::spike_threshold(Presets::Preset.Raw) != 10000
    return 6 if Presets::spike_threshold(Presets::Preset.Boxing) != 20000
    return 7 if Presets::operations(Presets::Preset.Raw).count != 1
    return 8 if Presets::parse("raw") != Presets::Preset.Raw
    return 9 if Presets::parse("x") != Presets::Preset.Unknown
    return 0
