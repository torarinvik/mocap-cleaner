# Async results are accepted only for the current document revision and job.
include "../src/studio/job_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioJobPolicy::decision(8, 12, 8, 12) != StudioJobPolicy::APPLY
    return 2 if StudioJobPolicy::decision(9, 12, 8, 12) != StudioJobPolicy::REJECT
    return 3 if StudioJobPolicy::decision(8, 13, 8, 12) != StudioJobPolicy::REJECT
    return 4 if StudioJobPolicy::decision(8, 0, 8, 12) != StudioJobPolicy::REJECT
    return 5 if StudioJobPolicy::decision(8, 12, 8, 0) != StudioJobPolicy::REJECT
    _ = puts("studio_job_policy: revision and active job gating pass")
    return 0
