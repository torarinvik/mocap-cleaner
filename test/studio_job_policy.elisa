# Async results are accepted only for the current document revision and job.
include "../src/studio/job_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioJobPolicy::decision(8, 12, 8, 12) != StudioJobPolicy::Decision::APPLY
    return 2 if StudioJobPolicy::decision(9, 12, 8, 12) != StudioJobPolicy::Decision::REJECT
    return 3 if StudioJobPolicy::decision(8, 13, 8, 12) != StudioJobPolicy::Decision::REJECT
    return 4 if StudioJobPolicy::decision(8, 0, 8, 12) != StudioJobPolicy::Decision::REJECT
    return 5 if StudioJobPolicy::decision(8, 12, 8, 0) != StudioJobPolicy::Decision::REJECT
    return 6 if StudioJobPolicy::lifecycle_decision(8, 12, 8, 12, true) != StudioJobPolicy::Decision::REJECT
    return 7 if StudioJobPolicy::publish_value(41, 99, StudioJobPolicy::Decision::REJECT) != 41
    return 8 if StudioJobPolicy::publish_value(41, 99, StudioJobPolicy::Decision::APPLY) != 99
    return 9 if StudioJobPolicy::lifecycle_decision(8, 13, 8, 12, false) != StudioJobPolicy::Decision::REJECT
    return 10 if StudioJobPolicy::lifecycle_decision(9, 12, 8, 12, false) != StudioJobPolicy::Decision::REJECT
    _ = puts("studio_job_policy: revision, supersession, cancellation, and last-valid preservation pass")
    return 0
