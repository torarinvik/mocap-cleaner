# Regression for review and status rows that need more than the former
# 48-byte text slot. The final byte must survive the view construction.
include "../../elisa-ui/src/core/ui_text.elisa"
include "../src/studio/app/text.elisa"

extern puts(text: cstr) -> i64

def main() -> i32 can[Unsafe.PointerCast, Global{Read, Write}]:
    can Global{Read, Write}:
        StudioText::begin()
        StudioText::put("Selected animation: jab #10 (cleaned)  ·  28 animations included; other clips unchanged")
        rendered: sview = StudioText::view()
        return 1 if rendered.len <= 48
        return 2 if rendered.data[rendered.len.usize() - 1] != 100
        _ = puts("studio text: long review labels are not truncated")
        return 0
