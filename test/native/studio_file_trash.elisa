# Exercises the Elisa adapter across the native checked-move ABI. The runner
# supplies a disposable derived file under build/; success restores it.
include "../../src/studio/io/file_trash.elisa"

extern puts(text: cstr) -> i64

def main(argc: i64, argv: mutable void&) -> i64 can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
    return 1 if argc != 3
    args: mutable cstr&& = argv.cast[mutable cstr&&]
    root: cstr = args[1]
    candidate: cstr = args[2]
    mutable expected: StudioStorageManifest::Entry = zeroed
    mutable receipt: StudioStorageManifest::Entry = zeroed
    mutable message: darray[u8] = []
    return 2 if not StudioFileTrash::snapshot(root, candidate,
        StudioStorageReceiptPolicy::Kind.GeneratedReport.i64(), &expected, &message)
    changed: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
        state: expected.state, kind: expected.kind,
        device: expected.device, inode: expected.inode,
        size_bytes: expected.size_bytes + 1,
        modified_seconds: expected.modified_seconds,
        modified_nanoseconds: expected.modified_nanoseconds,
        original_path: expected.original_path, trashed_path: []}
    if StudioFileTrash::move_checked(root, candidate, changed, &receipt, &message):
        _ = StudioFileTrash::restore(root, receipt, &message)
        return 3
    mutable unchanged: StudioStorageManifest::Entry = zeroed
    return 4 if not StudioFileTrash::snapshot(root, candidate,
        expected.kind, &unchanged, &message)
    return 5 if unchanged.device != expected.device or unchanged.inode != expected.inode or unchanged.size_bytes != expected.size_bytes
    return 6 if not StudioFileTrash::move_entry(root, expected, &receipt, &message)
    return 7 if not StudioFileTrash::restore(root, receipt, &message)
    _ = puts("PASS Studio checked Trash adapter")
    0
