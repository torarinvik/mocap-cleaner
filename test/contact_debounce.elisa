# Contact debounce: short lifts between plants are filled, short plants are
# dropped, runs at the clip ends are never filled, long runs are untouched
# and the frame count never changes.
include "../src/tools/track.elisa"

def bits(text: sview) -> darray[bool]:
    mutable out: darray[bool] = []
    for ch in text |out|:
        out.push(ch == '1')
    return out

def same(a: darray[bool]&, text: sview) -> bool:
    b: darray[bool] = bits(text)
    return false if a.count != b.count
    for k in 0..<a.count |k, a, b|:
        return false if a[k] != b[k]
    return true

def main() -> i32:
    # The Unreal take's left foot, frames 104-131, at 30 fps (gap 2, blip 1).
    chatter: darray[bool] = bits("0000110011111110010011111111111100")
    return 1 if not same(Track::debounce(&chatter, 2, 1), "0000111111111111111111111111111100")
    # A lone one-frame plant in flight is dropped; a two-frame one stays.
    lone: darray[bool] = bits("000100011000")
    return 2 if not same(Track::debounce(&lone, 2, 1), "000000011000")
    # A three-frame lift is a real step and stays.
    step: darray[bool] = bits("1110001111")
    return 3 if not same(Track::debounce(&step, 2, 1), "1110001111")
    # Lifts touching either end are never filled.
    edges: darray[bool] = bits("0011100")
    return 4 if not same(Track::debounce(&edges, 2, 1), "0011100")
    # Zero limits change nothing.
    return 5 if not same(Track::debounce(&chatter, 0, 0), "0000110011111110010011111111111100")
    empty: darray[bool] = []
    return 6 if Track::debounce(&empty, 2, 1).count != 0
    # Frame counts from milliseconds follow the rate.
    return 7 if Contact::frames_of(Contact::Debounce::GAP_MS, 30) != 2 or Contact::frames_of(Contact::Debounce::BLIP_MS, 30) != 1
    return 8 if Contact::frames_of(Contact::Debounce::GAP_MS, 120) != 8 or Contact::frames_of(Contact::Debounce::BLIP_MS, 120) != 6
    return 9 if Contact::frames_of(70, 0) != 0
    0
