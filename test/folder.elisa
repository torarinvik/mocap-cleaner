# Folder listing: sorted .glb files, hidden and other files skipped.
include "../src/io/folder.elisa"

def equals(path: darray[u8]&, text: cstr) -> bool:
    mutable i: usize = 0
    while text[i] != 0:
        return false if i >= path.count or path[i] != text[i]
        i <- i + 1
    return i + 1 == path.count and path[i] == 0

def main() -> i32:
    raw: darray[darray[u8]] = [[98, 46, 103, 108, 98], [97], [97, 98]]
    names: darray[darray[u8]] = Folder::sorted(&raw)
    return 1 if names[0].count != 1 or names[1].count != 2 or names[2][0] != 98
    return 2 if Folder::is_glb(&names[0])
    return 3 if not Folder::is_glb(&names[2])
    return 4 if Folder::is_dir("build/no-such-folder".cast[cstr])
    # Fixture made by scripts/check.sh: C.GLB a.glb b.glb .hidden.glb c.txt
    # and a sub.glb folder (listed by name; batch skips what fails to load).
    return 0 if not Folder::is_dir("build/folder-test".cast[cstr])
    files: darray[darray[u8]] = Folder::glb_files("build/folder-test/".cast[cstr])
    return 5 if files.count != 4
    return 6 if not equals(&files[0], "build/folder-test/C.GLB".cast[cstr])
    return 7 if not equals(&files[1], "build/folder-test/a.glb".cast[cstr])
    return 8 if not equals(&files[2], "build/folder-test/b.glb".cast[cstr])
    return 9 if not equals(&files[3], "build/folder-test/sub.glb".cast[cstr])
    return 0
