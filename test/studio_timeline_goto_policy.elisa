# Focused examples for the 1-based Go to frame boundary.
include "../src/studio/timeline_goto_policy.elisa"

def main() -> i32:
    first: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("1", 24)
    return 1 if first.status != StudioTimelineGotoPolicy::EXACT or first.frame != 0
    last: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("24", 24)
    return 2 if last.status != StudioTimelineGotoPolicy::EXACT or last.frame != 23
    high: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("25", 24)
    return 3 if high.status != StudioTimelineGotoPolicy::CLAMPED or high.frame != 23
    huge: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("999999999999999999999999999", 24)
    return 4 if huge.status != StudioTimelineGotoPolicy::CLAMPED or huge.frame != 23
    zero: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("0", 24)
    return 5 if zero.status != StudioTimelineGotoPolicy::INVALID
    empty: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("", 24)
    return 6 if empty.status != StudioTimelineGotoPolicy::EMPTY
    bad: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("12x", 24)
    return 7 if bad.status != StudioTimelineGotoPolicy::INVALID
    leading: StudioTimelineGotoPolicy::Result = StudioTimelineGotoPolicy::parse("0003", 24)
    return 8 if leading.status != StudioTimelineGotoPolicy::EXACT or leading.frame != 2
    return 0
