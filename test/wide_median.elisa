# Wide median and odd-reflection smoothing: bursts removed, ramps and clip
# ends kept exactly.
include "../src/tools/track.elisa"

def main() -> i32:
    burst: mutable darray[i64] = []
    for i in 0..<60 |burst|:
        burst.push(0)
    for i in 28..<33 |burst|:
        burst[i] <- 700
    cleared: darray[i64] = Track::median(burst, 10, 1)
    for i in 0..<60 |cleared|:
        return 1 if cleared[i] != 0
    ramp: mutable darray[i64] = []
    for i in 0..<60 |ramp|:
        ramp.push(i.i64() * 25 - 300)
    kept: darray[i64] = Track::median(ramp, 10, 1)
    smoothed: darray[i64] = Track::smooth(ramp, 32, 1, false)
    for i in 0..<60 |kept, smoothed, ramp|:
        return 2 if kept[i] != ramp[i]
        return 3 if smoothed[i] != ramp[i]
    curve: mutable darray[i64] = []
    for i in 0..<60 |curve|:
        curve.push(i.i64() * i.i64())
    ends: darray[i64] = Track::smooth(curve, 32, 1, false)
    return 4 if ends[0] != curve[0] or ends[59] != curve[59]
    return 5 if Track::odd_sample(ramp, -3) != ramp[0] - 75
    return 6 if Track::odd_sample(ramp, 62) != ramp[59] + 75
    return 0
