# The native key fallback and committed text use the same strict character
# policy for custom Studio numeric drafts.
include "../src/studio/text_entry_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if StudioTextEntryPolicy::route(false, 50, true) != StudioTextEntryPolicy::REJECT
    return 2 if StudioTextEntryPolicy::route(true, 50, true) != 50
    return 3 if StudioTextEntryPolicy::route(true, 48, true) != 48
    return 4 if StudioTextEntryPolicy::route(true, 46, true) != StudioTextEntryPolicy::REJECT
    return 5 if StudioTextEntryPolicy::route(true, 120, true) != StudioTextEntryPolicy::REJECT
    return 6 if StudioTextEntryPolicy::route(true, 46, false) != 46
    return 7 if StudioTextEntryPolicy::route(true, 120, false) != 120
    return 8 if StudioTextEntryPolicy::route(true, 88, false) != 88
    return 9 if StudioTextEntryPolicy::route(true, 65, false) != StudioTextEntryPolicy::REJECT
    return 10 if StudioTextEntryPolicy::route(true, 61, false) != StudioTextEntryPolicy::REJECT
    return 11 if StudioTextEntryPolicy::route(true, 88, true) != StudioTextEntryPolicy::REJECT
    return 12 if StudioTextEntryPolicy::route(true, 32, true) != StudioTextEntryPolicy::REJECT
    return 13 if StudioTextEntryPolicy::route(true, 32, false) != 32
    return 14 if StudioTextEntryPolicy::route(true, 65, false) != StudioTextEntryPolicy::REJECT
    return 15 if StudioTextEntryPolicy::route(true, 61, false) != StudioTextEntryPolicy::REJECT
    _ = puts("studio text entry: contact and retime character filtering passes")
    return 0
