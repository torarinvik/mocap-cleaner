# Finding explanations retain detector peak data and use readable labels.
include "../src/studio/issue_explanation.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    issue: StudioIssues::Issue = StudioIssues::Issue{selectable: true, first_frame: 10, last_frame: 11, peak_frame: 10, issue_type: 0, subject_id: -1, source_revision: 4, severity: 300, peak_value: 120, threshold: 120}
    x: StudioIssueExplanation::Explanation = StudioIssueExplanation::explain(issue)
    return 1 if x.excess != 0 or x.peak_frame != 10
    return 2 if x.category != StudioIssueExplanationPolicy::Category.MotionSpike
    return 3 if x.level != StudioIssueExplanationPolicy::Level.Mild
    _ = puts("studio issue explanation: category, strength and peak metadata pass")
    return 0
