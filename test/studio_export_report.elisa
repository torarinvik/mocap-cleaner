include "../src/studio/export_report.elisa"

@link_name("fopen")
extern report_fopen(path: u8&, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("fwrite")
extern report_fwrite(bytes: u8&, size: usize, count: usize, file: mutable heap void&) -> usize can[Blocking.IO]
@link_name("fclose")
extern report_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]
extern puts(text: cstr) -> i64

# Test output byte slices without relying on NUL termination of a darray.
def contains(text: darray[u8]&, needle: sview) -> bool:
    mutable needle_length: usize = 0
    for byte in needle:
        needle_length <- needle_length + 1
    return false if needle_length == 0 or needle_length > text.count
    for start in 0..<(text.count - needle_length + 1) |text, needle, needle_length|:
        mutable same: bool = true
        for offset in 0..<needle_length |text, needle, start, same|:
            same <- false if text[start + offset] != needle[offset]
        return true if same
    false

def equal_bytes(a: darray[u8]&, b: darray[u8]&) -> bool:
    return false if a.count != b.count
    for index in 0..<a.count |a, b|:
        return false if a[index] != b[index]
    true

def write_json_fixture(text: darray[u8]&) -> bool:
    file: mutable heap void&? = report_fopen("build/studio_export_report_test.json".cast[u8&], "wb".cast[u8&])
    if file is stream:
        wrote: usize = report_fwrite(&text[0], 1, text.count, stream)
        closed: i32 = report_fclose(stream)
        return wrote == text.count and closed == 0
    false

# Structural JSON scan: quote and escape handling plus balanced object/array
# delimiters. Field/value assertions below check the emitted schema content.
def structurally_json(text: darray[u8]&) -> bool:
    mutable quoted: bool = false
    mutable escaped: bool = false
    mutable braces: i64 = 0
    mutable brackets: i64 = 0
    for byte in text |quoted, escaped, braces, brackets|:
        if quoted:
            if escaped:
                escaped <- false
            elif byte == 92:
                escaped <- true
            elif byte == 34:
                quoted <- false
        elif byte == 34:
            quoted <- true
        elif byte == 123:
            braces <- braces + 1
        elif byte == 125:
            braces <- braces - 1
            return false if braces < 0
        elif byte == 91:
            brackets <- brackets + 1
        elif byte == 93:
            brackets <- brackets - 1
            return false if brackets < 0
    not quoted and not escaped and braces == 0 and brackets == 0

def main() -> i64:
    settings: darray[StudioExportReport::Setting] = [
        StudioExportReport::Setting{name: "feet", value: "enabled"},
        StudioExportReport::Setting{name: "operation_0", value: "despike;enabled=true;frames=2..80;bones=7;strength=3;edge_frames=8"},
        StudioExportReport::Setting{name: "retime_band_0", value: "enabled=true;source_frames=30..59;speed_permille=800;blend_frames=4"},
        StudioExportReport::Setting{name: "label\"\\", value: "left\nright"}
    ]
    assumptions: darray[sview] = ["Existing hierarchy retained"]
    warnings: darray[StudioExportReport::Warning] = [
        StudioExportReport::Warning{category: "motion\nquality", severity: StudioExportReport::Severity.WARNING, message: "inspect \"frame 2\" \\before export"}
    ]
    m: StudioExportReport::Metrics = StudioExportReport::Metrics{
        changed_channels: 4, spikes_before: 8, spikes_after: 2,
        foot_slide_before_um: 12000, foot_slide_after_um: 3500,
        foot_sink_before_um: 800, foot_sink_after_um: 200,
        hand_slide_before_um: 600, hand_slide_after_um: 100,
        balance_impossible_frames: 3
    }
    data: StudioExportReport::Data = StudioExportReport::Data{
        source_name: "take\"one.glb", source_fingerprint_first: 123,
        source_fingerprint_second: 456, output_fingerprint_first: 789,
        output_fingerprint_second: 987, animation_name: "walk\\run",
        animation_index: 2, input_frames: 120, input_fps: 30,
        output_frames: 90, output_fps: 30, settings: settings,
        assumptions: assumptions, metrics: m, warnings: warnings
    }
    return 1 if not StudioExportReport::valid(data)
    json: darray[u8] = StudioExportReport::json(data)
    return 2 if not structurally_json(json)
    return 16 if not write_json_fixture(json)
    required: darray[sview] = [
        "schema", "schema_version", "source", "fingerprint", "output_fingerprint",
        "animation", "timing", "input_frames", "input_fps_estimate",
        "input_duration_ms_floor", "output_frames", "output_fps_estimate",
        "output_duration_ms_floor", "settings", "assumptions", "metrics",
        "changed_channels", "spike_frames_before", "spike_frames_after",
        "foot_slide_before_um", "foot_slide_after_um", "foot_sink_before_um",
        "foot_sink_after_um", "hand_slide_before_um", "hand_slide_after_um",
        "balance_impossible_frames", "warnings", "category", "severity", "message",
        "unavailable", "tool_versions", "dependency_versions", "detector_thresholds",
        "rig_settings", "retime_provenance", "reason"
    ]
    for field in required |field, json|:
        return 17 if not contains(json, field)
    return 3 if not contains(json, "\"name\": \"take\\\"one.glb\"")
    return 4 if not contains(json, "\"output_fingerprint\": {\"algorithm\": \"studio-residue-v1\", \"first\": 789, \"second\": 987}")
    return 5 if not contains(json, "\"output_duration_ms_floor\": 3000")
    return 6 if not contains(json, "\"foot_slide_after_um\": 3500")
    return 7 if not contains(json, "\"category\": \"motion\\nquality\"")
    return 18 if not contains(json, "\"schema_version\": 2")
    return 19 if not contains(json, "\"field\": \"tool_versions\", \"reason\": \"The Studio export snapshot does not record application or tool versions.\"")
    return 20 if not contains(json, "\"field\": \"retime_provenance\"")
    unavailable_fields: darray[sview] = [
        "\"field\": \"tool_versions\"", "\"field\": \"dependency_versions\"",
        "\"field\": \"detector_thresholds\"", "\"field\": \"rig_settings\"",
        "\"field\": \"retime_provenance\""
    ]
    for field in unavailable_fields |field, json|:
        return 23 if not contains(json, field)
    json_again: darray[u8] = StudioExportReport::json(data)
    return 8 if not equal_bytes(json, json_again)
    text: darray[u8] = StudioExportReport::summary(data)
    return 9 if not contains(text, "Mocap Studio export quality report v2")
    return 21 if not contains(text, "Unavailable provenance (reason):")
    return 22 if not contains(text, "- rig_settings:")
    return 24 if not contains(text, "Active export settings:")
    return 25 if not contains(text, "\"operation_0\" =")
    return 26 if not contains(text, "\"retime_band_0\" =")
    return 10 if not contains(text, "non-cryptographic studio-residue-v1")
    return 11 if not contains(text, "12000 → 3500 µm")
    return 12 if not contains(text, "[\"motion\\nquality\"/warning]")

    invalid: StudioExportReport::Data = data
    invalid.output_fps <- 0
    return 13 if StudioExportReport::valid(invalid)
    return 14 if StudioExportReport::json(invalid).count != 0
    invalid.output_fps <- 30
    invalid.output_fingerprint_first <- StudioSourceFingerprint::Residue::FIRST_MODULUS
    return 15 if StudioExportReport::valid(invalid)
    _ = puts("studio export report: deterministic JSON structure, escaping, units, and summary pass")
    0
