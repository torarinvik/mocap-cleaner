include "../src/studio/storage_restore_policy.elisa"
include "../src/studio/io/storage_manifest.elisa"

extern puts(text: cstr) -> i64

def bytes(text: sview) -> darray[u8]:
    mutable out: darray[u8] = []
    for byte in text:
        out.push(byte)
    out

def main() -> i32:
    receipt: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
        state: 1,
        kind: 2,
        device: 17, inode: 987654321, size_bytes: 12345,
        modified_seconds: 1800000000, modified_nanoseconds: 765432100,
        original_path: bytes("build/reports/summary.json"),
        trashed_path: bytes("/Users/example/.Trash/summary.json")
    }
    return 1 if not StudioStorageRestorePolicy::eligible(receipt.state, StudioStorageManifest::valid(receipt), true, true, true, false)
    return 2 if StudioStorageRestorePolicy::eligible(receipt.state, StudioStorageManifest::valid(receipt), false, true, true, false)
    return 3 if StudioStorageRestorePolicy::eligible(receipt.state, StudioStorageManifest::valid(receipt), true, false, true, false)
    return 4 if StudioStorageRestorePolicy::eligible(receipt.state, StudioStorageManifest::valid(receipt), true, true, false, false)
    return 5 if StudioStorageRestorePolicy::eligible(receipt.state, StudioStorageManifest::valid(receipt), true, true, true, true)

    registered: StudioStorageManifest::Entry = receipt
    registered.state <- 0
    registered.trashed_path.clear()
    return 6 if StudioStorageRestorePolicy::eligible(registered.state, StudioStorageManifest::valid(registered), true, true, true, false)

    mutable invalid: StudioStorageManifest::Entry = receipt
    invalid.device <- -1
    return 7 if StudioStorageRestorePolicy::eligible(invalid.state, StudioStorageManifest::valid(invalid), true, true, true, false)
    invalid <- receipt
    invalid.trashed_path <- []
    return 8 if StudioStorageRestorePolicy::eligible(invalid.state, StudioStorageManifest::valid(invalid), true, true, true, false)
    _ = puts("studio storage restore policy: fail-closed gates pass")
    return 0
