include "../src/tools/track.elisa"

def main() -> i32:
    # A foot drifts 3 units per frame while planted on frames 5..24.
    values: mutable darray[i64] = []
    flags: mutable darray[bool] = []
    for i in 0..<30 |values, flags|:
        values.push(i.i64() * 3)
        flags.push(i >= 5 and i < 25)
    out: darray[i64] = Track::lock(values, flags, 4)
    return 1 if out.count != values.count
    for i in 0..<5 |out, values|:
        return 2 if out[i] != values[i]
    for i in 25..<30 |out, values|:
        return 3 if out[i] != values[i]
    return 4 if out[5] != values[5] or out[24] != values[24]
    for i in 9..<21 |out|:
        return 5 if out[i] != 15
    # Slide inside the plant is cut from 57 units to the two ramps.
    return 6 if out[20] - out[9] != 0
    # A foot already still is unchanged.
    still: mutable darray[i64] = []
    for i in 0..<30 |still|:
        still.push(42)
    kept: darray[i64] = Track::lock(still, flags, 4)
    for i in 0..<30 |kept|:
        return 7 if kept[i] != 42
    return 0
