include "../src/physics/balance.elisa"

def main() -> i32:
    return 1 if not Balance::supported(0, 0, 100, 0, 0, 100, 20, 20)
    return 2 if Balance::supported(0, 0, 100, 0, 0, 100, 80, 80)
    return 3 if not Balance::supported(0, 0, 100, 0, 0, 100, 50, 0)
    return 4 if Balance::ballistic_residual(100, 90, 78, 2) != 0
    return 5 if Balance::ballistic_residual(100, 90, 80, 2) != 2
    return 6 if Balance::limit_step(0, 50, 10) != 10
    return 7 if Balance::limit_step(0, -50, 10) != -10
    return 8 if Balance::limit_step(0, 5, 10) != 5
    return 0
