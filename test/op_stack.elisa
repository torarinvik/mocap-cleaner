include "../src/ops/stack.elisa"

def main() -> i32:
    raw: mutable darray[i64] = []
    for i in 0..<60 |raw|:
        raw.push(0)
    raw[10] <- 800
    raw[40] <- 800
    ops: mutable darray[Ops::Operation] = []
    ops.push(Ops::despike(30, 59, 1, 1))
    out: darray[i64] = Ops::evaluate(ops, 0, raw, false)
    return 1 if out[10] != 800          # outside the span: untouched
    return 2 if out[40] != 0            # inside: fixed
    other: darray[i64] = Ops::evaluate(ops, 1, raw, false)
    return 3 if other[40] != 800        # bone not selected
    off: mutable Ops::Operation = Ops::despike(0, 59, 1, 1)
    off.enabled <- false
    disabled: mutable darray[Ops::Operation] = []
    disabled.push(off)
    same: darray[i64] = Ops::evaluate(disabled, 0, raw, false)
    for i in 0..<60 |same, raw|:
        return 4 if same[i] != raw[i]
    return 5 if raw[40] != 800          # source never modified
    # Pelvis landing: a height step snaps; path smoothing spreads it out.
    landing: mutable darray[i64] = []
    for i in 0..<60 |landing|:
        landing.push(0 if i < 30 else 1000)
    path: mutable darray[Ops::Operation] = []
    path.push(Ops::smooth_path(0, 59, -1, 4))
    soft: darray[i64] = Ops::evaluate(path, 0, landing, false)
    return 6 if soft[0] != 0 or soft[59] != 1000          # clip edges exact
    mutable peak_before: i64 = 0
    mutable peak_after: i64 = 0
    for i in 1..<59 |landing, soft, peak_before, peak_after|:
        a: i64 = landing[i - 1] - 2 * landing[i] + landing[i + 1]
        b: i64 = soft[i - 1] - 2 * soft[i] + soft[i + 1]
        peak_before <- a if a > peak_before else peak_before
        peak_before <- -a if -a > peak_before else peak_before
        peak_after <- b if b > peak_after else peak_after
        peak_after <- -b if -b > peak_after else peak_after
    return 7 if peak_after * 3 > peak_before              # at least 3x softer
    return 8 if soft[5] != 0 or soft[54] != 1000          # far frames untouched
    return 0
