include "../src/ops/stack.elisa"

def main() -> i32:
    raw: mutable darray[i64] = []
    for i in 0..<60 |raw|:
        raw.push(0)
    raw[10] <- 800
    raw[40] <- 800
    ops: mutable darray[Ops::Operation] = []
    ops.push(Ops::despike(30, 59, 1, 1))
    out: darray[i64] = Ops::evaluate(ops, 0, raw, false)
    return 1 if out[10] != 800          # outside the span: untouched
    return 2 if out[40] != 0            # inside: fixed
    other: darray[i64] = Ops::evaluate(ops, 1, raw, false)
    return 3 if other[40] != 800        # bone not selected
    off: mutable Ops::Operation = Ops::despike(0, 59, 1, 1)
    off.enabled <- false
    disabled: mutable darray[Ops::Operation] = []
    disabled.push(off)
    same: darray[i64] = Ops::evaluate(disabled, 0, raw, false)
    for i in 0..<60 |same, raw|:
        return 4 if same[i] != raw[i]
    return 5 if raw[40] != 800          # source never modified
    return 0
