# Admission kernel used before retained take path/digest publication.
include "../src/core/bounded_path_policy.elisa"

def main() -> i32:
    return 1 if BoundedPathPolicy::nonempty_admitted(-1, 4096)
    return 2 if BoundedPathPolicy::nonempty_admitted(0, 4096)
    return 3 if not BoundedPathPolicy::nonempty_admitted(1, 4096)
    return 4 if not BoundedPathPolicy::nonempty_admitted(4095, 4096)
    return 5 if BoundedPathPolicy::nonempty_admitted(4096, 4096)
    return 6 if BoundedPathPolicy::nonempty_admitted(4097, 4096)
    return 7 if BoundedPathPolicy::nonempty_admitted(1, 0)
    return 8 if BoundedPathPolicy::nonempty_admitted(1, -1)
    return 9 if BoundedPathPolicy::nonempty_admitted(1, 1)
    return 10 if not BoundedPathPolicy::nonempty_admitted(9223372036854775806, 9223372036854775807)
    return 11 if BoundedPathPolicy::nonempty_admitted(9223372036854775807, 9223372036854775807)
    return 0
