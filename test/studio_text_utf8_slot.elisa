include "../../elisa-ui/src/core/ui_text.elisa"
include "../src/studio/app/text.elisa"

def main() -> i32 can[Unsafe.PointerCast, Global{Read, Write}]:
    can Global{Read, Write}:
        StudioText::begin()
        for index in 0..<127:
            StudioText::put("a")
        StudioText::put("é")
        return 1 if StudioText::view().len != 127
        StudioText::begin()
        for index in 0..<126:
            StudioText::put("a")
        StudioText::put("é")
        complete: sview = StudioText::view()
        return 2 if complete.len != 128
        return 3 if complete.data[126] != 195 or complete.data[127] != 169
        StudioText::begin()
        for index in 0..<125:
            StudioText::put("a")
        StudioText::put("😀")
        return 4 if StudioText::view().len != 125
        # Viewing an unfinished scalar does not discard a later continuation.
        StudioText::begin()
        StudioText::byte(195)
        return 5 if StudioText::view().len != 0
        StudioText::byte(169)
        return 6 if StudioText::view().len != 2
        return 0
