# Headless test of the studio session file and chrome decisions: a stack
# with operations, foot/hand fixes and contact edits saves and loads back the
# same; a session saved on a longer take is clamped into this take; damaged
# or unknown lines are skipped; a file without the header is refused. Then
# gizmo corrections round-trip within a millionth; version 1 files still
# load; corrections on missing nodes are dropped; future versions refused.
# Then the Escape chain, the help sheet toggle and the first-run screen.
include "../src/studio/state/session_state.elisa"

extern puts(text: cstr) -> i64

def text_of(body: sview, out: mutable darray[u8]&) -> void:
    Report::push_text(out, body)

def near(a: f32, b: f32) -> bool:
    d: f32 = a - b
    return d < 0.000002 and d > 0.0 - 0.000002

def fix_near(a: Corrections::Correction, b: Corrections::Correction) -> bool:
    return false if a.enabled != b.enabled or a.node != b.node or a.key != b.key or a.first != b.first or a.last != b.last
    return false if not near(a.rotation.x, b.rotation.x) or not near(a.rotation.y, b.rotation.y) or not near(a.rotation.z, b.rotation.z) or not near(a.rotation.w, b.rotation.w)
    return near(a.translation.x, b.translation.x) and near(a.translation.y, b.translation.y) and near(a.translation.z, b.translation.z)

def main() -> i32:
    mutable s: StackState::Stack = StackState::empty()
    _ = StackState::add(&s, Ops::despike(0, 99, -1, 3))
    _ = StackState::add(&s, Ops::median(10, 50, 2, 4))
    _ = StackState::toggle(&s, 1)
    _ = StackState::set_feet(&s, true)
    _ = StackState::set_hands(&s, true)
    _ = StackState::nudge_blend(&s, true)
    _ = StackState::add_edit(&s, StackState::LEFT, 20, 30, true)
    _ = StackState::add_edit(&s, StackState::RIGHT, 40, 41, false)
    _ = StackState::add_edit(&s, StackState::LEFT_HAND, 52, 60, true)
    fix: Corrections::Correction = Corrections::Correction{enabled: true, node: 17, key: 60, first: 50, last: 70, rotation: Geometry::Quat{x: 0.0, y: 0.0, z: 0.130526, w: 0.991445}, translation: Geometry::Vec3{x: 0.0125, y: -0.5, z: 0.0}}
    _ = StackState::add_fix(&s, fix)
    mutable text: darray[u8] = []
    SessionState::encode_session(&s, &text)
    if SessionState::decode_session(&text, 100, 30) is withfix:
        return 30 if withfix.fix_count != 1 or not fix_near(fix, withfix.fixes[0])
        # The take has only 10 nodes: the correction on node 17 is dropped.
        if SessionState::decode_session(&text, 100, 10) is fewer:
            return 31 if fewer.fix_count != 0 or fewer.count != 2
        else:
            return 32
    else:
        return 33
    _ = StackState::drop_fix(&s)
    SessionState::encode_session(&s, &text)
    # A version 1 file (no corrections or hand toggle) still loads; version 4 is refused.
    mutable old: darray[u8] = []
    text_of("mocap-studio session 1\n1 1 6\n2 0 1 0 39 -1 2 8\n3 0 4 9 1\n", &old)
    if SessionState::decode_session(&old, 40, 30) is v1:
        return 34 if v1.count != 1 or not v1.feet or v1.edit_count != 1 or v1.fix_count != 0
    else:
        return 35
    mutable future: darray[u8] = []
    text_of("mocap-studio session 4\n1 1 6\n", &future)
    return 36 if SessionState::decode_session(&future, 40, 30) != null
    # A huge saved rotation is clamped and re-normalised to a unit quaternion.
    mutable wild: darray[u8] = []
    text_of("mocap-studio session 2\n4 1 3 5 0 9 0 0 9000000000 9000000000 1500000000 0 0\n", &wild)
    if SessionState::decode_session(&wild, 40, 30) is w:
        return 37 if w.fix_count != 1
        r: Geometry::Quat = w.fixes[0].rotation
        return 38 if not near(r.z, 0.707107) or not near(r.w, 0.707107) or w.fixes[0].translation.x < 999.99 or w.fixes[0].translation.x > 1000.01
    else:
        return 39
    back: StackState::Stack? = SessionState::decode_session(&text, 100, 30)
    if back is b:
        return 2 if not StackState::same(&s, &b)
    else:
        return 1
    # Saved on a 100-frame take, loaded on a 40-frame one: scopes clamp.
    if SessionState::decode_session(&text, 40, 30) is short:
        return 3 if short.count != 2
        return 4 if short.ops[0].last != 39 or short.ops[1].last != 39
        return 5 if short.edits[0].last != 30 or short.edits[1].first != 39
    else:
        return 6
    # Damaged lines are skipped, values brought into range.
    mutable bad: darray[u8] = []
    text_of("mocap-studio session 1\n1 1 999\n2 9 1 0 5 -1 2 8\n2 0 1 7 3 77 500 -4\nnot numbers\n3 5 1 2 1\n", &bad)
    if SessionState::decode_session(&bad, 50, 30) is d:
        return 7 if d.count != 1 or not d.feet
        return 8 if d.blend != StudioFoot::DEFAULT_BLEND
        op: Ops::Operation = d.ops[0]
        return 9 if op.first != 3 or op.last != 7 or op.bones != -1
        return 10 if op.strength != StudioChrome::CHROME_STRENGTH or op.edge != 0
        return 11 if d.edit_count != 0
    else:
        return 12
    # No header: refused.
    mutable nohead: darray[u8] = []
    text_of("2 0 1 0 5 -1 2 8\n", &nohead)
    return 13 if SessionState::decode_session(&nohead, 50, 30) != null
    # Save to disk and load back.
    path: cstr = "build/test/studio_session.txt"
    return 14 if not SessionState::save_session(&s, path)
    if SessionState::load_session(path, 100, 30) is disk:
        return 15 if not StackState::same(&s, &disk)
    else:
        return 16
    # Escape peels one layer per press: help, drag, gizmo, selection, none.
    mutable help: bool = true
    mutable drag: bool = true
    mutable gizmo: bool = true
    mutable selected: bool = true
    mutable presses: i64 = 0
    while StudioChrome::escape_layer(help, drag, false, gizmo, selected) != StudioChrome::ESC_NONE:
        layer: i64 = StudioChrome::escape_layer(help, drag, false, gizmo, selected)
        help <- false if layer == StudioChrome::ESC_HELP else help
        drag <- false if layer == StudioChrome::ESC_DRAG else drag
        gizmo <- false if layer == StudioChrome::ESC_GIZMO else gizmo
        selected <- false if layer == StudioChrome::ESC_SELECT else selected
        presses <- presses + 1
        return 17 if presses > 4
    return 18 if presses != 4
    # "?" toggles the help sheet, Escape closes it.
    return 19 if not StudioChrome::help_after(false, true, false)
    return 20 if StudioChrome::help_after(true, false, true)
    # First run vs failed load vs editing.
    return 21 if StudioChrome::chrome_screen(false, false) != StudioChrome::SCREEN_EMPTY
    return 22 if StudioChrome::chrome_screen(false, true) != StudioChrome::SCREEN_FAILED
    # Status clock and gain.
    return 23 if StudioChrome::clip_millis(60, 120) != 500
    return 24 if StudioChrome::clean_gain(4000, 1000) != 750
    _ = puts("studio session: ok")
    return 0
