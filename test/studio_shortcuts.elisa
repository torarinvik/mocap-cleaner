# Headless test of the studio's Cmd-Z / Cmd-Shift-Z chords: a key event
# stream (modifier downs/ups and Z presses) is decoded through the proved
# StudioShortcuts kernels and drives HistoryState the way the app's
# key_down/modifier handlers do.
include "../src/studio/shortcuts.elisa"
include "../src/studio/state/history_state.elisa"

extern puts(text: cstr) -> i64

const module KeyEvent:
    CMD_DOWN: i64 = 1
    CMD_UP: i64 = 2
    SHIFT_DOWN: i64 = 3
    SHIFT_UP: i64 = 4
    Z: i64 = 5
    OTHER: i64 = 6

# Feed one event; returns the action taken (StudioShortcuts code) or -1 for
# a modifier event.
def feed(mask: mutable i64&, h: mutable HistoryState::History&, event: i64) -> i64:
    if event == KeyEvent::CMD_DOWN:
        mask <- StudioShortcuts::command_down(mask)
        return -1
    if event == KeyEvent::CMD_UP:
        mask <- StudioShortcuts::command_up(mask)
        return -1
    if event == KeyEvent::SHIFT_DOWN:
        mask <- StudioShortcuts::shift_down(mask)
        return -1
    if event == KeyEvent::SHIFT_UP:
        mask <- StudioShortcuts::shift_up(mask)
        return -1
    action: i64 = StudioShortcuts::z_chord(mask) if event == KeyEvent::Z else StudioShortcuts::other_chord(mask)
    if action == StudioShortcuts::KeyAction.Undo.i64():
        _ = HistoryState::undo(h)
    if action == StudioShortcuts::KeyAction.Redo.i64():
        _ = HistoryState::redo(h)
    return action

def main() -> i32:
    base: StackState::Stack = StackState::empty()
    mutable h: HistoryState::History = zeroed
    HistoryState::reset(&h, base)
    mutable one: StackState::Stack = base
    _ = StackState::add(&one, Ops::despike(0, 10, -1, 2))
    _ = HistoryState::record(&h, one)
    mutable two: StackState::Stack = one
    _ = StackState::add(&two, Ops::median(0, 10, -1, 2))
    _ = HistoryState::record(&h, two)
    mutable mask: i64 = 0
    # Plain Z is not undo.
    return 1 if feed(&mask, &h, KeyEvent::Z) != StudioShortcuts::KeyAction.Plain.i64()
    return 2 if HistoryState::current(h).count != 2
    # Cmd-Z twice undoes both edits.
    _ = feed(&mask, &h, KeyEvent::CMD_DOWN)
    return 3 if feed(&mask, &h, KeyEvent::Z) != StudioShortcuts::KeyAction.Undo.i64()
    _ = feed(&mask, &h, KeyEvent::Z)
    return 4 if HistoryState::current(h).count != 0
    # Cmd-Shift-Z redoes one.
    _ = feed(&mask, &h, KeyEvent::SHIFT_DOWN)
    return 5 if feed(&mask, &h, KeyEvent::Z) != StudioShortcuts::KeyAction.Redo.i64()
    return 6 if HistoryState::current(h).count != 1
    # Another chord key is swallowed.
    return 7 if feed(&mask, &h, KeyEvent::OTHER) != StudioShortcuts::KeyAction.Swallow.i64()
    # Releasing Cmd (Shift still held) returns KeyEvent::Z to its plain binding.
    _ = feed(&mask, &h, KeyEvent::CMD_UP)
    return 8 if feed(&mask, &h, KeyEvent::Z) != StudioShortcuts::KeyAction.Plain.i64()
    _ = feed(&mask, &h, KeyEvent::SHIFT_UP)
    return 9 if mask != 0
    return 10 if HistoryState::current(h).count != 1
    # A focused numeric draft must swallow every global route, including
    # command/file actions decoded before the plain-key map.
    return 11 if StudioShortcuts::text_key_route(true, StudioShortcuts::KeyAction.Plain.i64()) != StudioShortcuts::KeyAction.Swallow.i64()
    return 12 if StudioShortcuts::text_key_route(true, StudioShortcuts::KeyAction.Undo.i64()) != StudioShortcuts::KeyAction.Swallow.i64()
    return 13 if StudioShortcuts::text_key_route(true, StudioShortcuts::KeyAction.Redo.i64()) != StudioShortcuts::KeyAction.Swallow.i64()
    return 14 if StudioShortcuts::text_key_route(false, StudioShortcuts::KeyAction.Plain.i64()) != StudioShortcuts::KeyAction.Plain.i64()
    # Exercise every decoded file action: open, save and export chords are
    # decoded before the plain/edit route and must all be suppressed in text.
    return 15 if StudioShortcuts::text_file_route(true, StudioShortcuts::FileAction.OpenTake.i64()) != StudioShortcuts::FileAction.None.i64()
    return 16 if StudioShortcuts::text_file_route(true, StudioShortcuts::FileAction.OpenSession.i64()) != StudioShortcuts::FileAction.None.i64()
    return 17 if StudioShortcuts::text_file_route(true, StudioShortcuts::FileAction.Save.i64()) != StudioShortcuts::FileAction.None.i64()
    return 18 if StudioShortcuts::text_file_route(true, StudioShortcuts::FileAction.SaveAs.i64()) != StudioShortcuts::FileAction.None.i64()
    return 19 if StudioShortcuts::text_file_route(true, StudioShortcuts::FileAction.ExportAs.i64()) != StudioShortcuts::FileAction.None.i64()
    return 20 if StudioShortcuts::text_file_route(false, StudioShortcuts::FileAction.OpenTake.i64()) != StudioShortcuts::FileAction.OpenTake.i64()
    return 21 if StudioShortcuts::text_file_route(false, StudioShortcuts::FileAction.OpenSession.i64()) != StudioShortcuts::FileAction.OpenSession.i64()
    return 22 if StudioShortcuts::text_file_route(false, StudioShortcuts::FileAction.Save.i64()) != StudioShortcuts::FileAction.Save.i64()
    return 23 if StudioShortcuts::text_file_route(false, StudioShortcuts::FileAction.SaveAs.i64()) != StudioShortcuts::FileAction.SaveAs.i64()
    return 24 if StudioShortcuts::text_file_route(false, StudioShortcuts::FileAction.ExportAs.i64()) != StudioShortcuts::FileAction.ExportAs.i64()
    # Cleanup and view bindings arrive as PLAIN, while Cmd-Z chords arrive as
    # UNDO/REDO; all three classes are swallowed during numeric entry.
    return 25 if StudioShortcuts::text_key_route(true, StudioShortcuts::KeyAction.Plain.i64()) != StudioShortcuts::KeyAction.Swallow.i64()
    return 26 if StudioShortcuts::text_key_route(true, StudioShortcuts::KeyAction.Undo.i64()) != StudioShortcuts::KeyAction.Swallow.i64()
    return 27 if StudioShortcuts::text_key_route(true, StudioShortcuts::KeyAction.Redo.i64()) != StudioShortcuts::KeyAction.Swallow.i64()
    # Repeated modifier events (including duplicate releases) must not leave a
    # stuck command bit that would turn the next plain key into a chord.
    _ = feed(&mask, &h, KeyEvent::CMD_DOWN)
    _ = feed(&mask, &h, KeyEvent::CMD_DOWN)
    return 28 if mask != StudioShortcuts::Modifiers::COMMAND
    _ = feed(&mask, &h, KeyEvent::SHIFT_DOWN)
    _ = feed(&mask, &h, KeyEvent::SHIFT_DOWN)
    return 29 if mask != StudioShortcuts::Modifiers::ALL
    _ = feed(&mask, &h, KeyEvent::CMD_UP)
    _ = feed(&mask, &h, KeyEvent::CMD_UP)
    return 30 if mask != StudioShortcuts::Modifiers::SHIFT
    _ = feed(&mask, &h, KeyEvent::SHIFT_UP)
    _ = feed(&mask, &h, KeyEvent::SHIFT_UP)
    return 31 if mask != 0
    return 32 if feed(&mask, &h, KeyEvent::OTHER) != StudioShortcuts::KeyAction.Plain.i64()
    _ = puts("studio_shortcuts: command chords, plain bindings and text-entry guards pass")
    return 0
