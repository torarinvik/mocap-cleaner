# Phase 6 kernels against the implementations they replaced: the sorted-window
# median and the two-buffer smooth / despike must give exactly the same values
# as the per-frame re-sort and the per-pass arrays, on random, spiky, flat and
# short tracks, for every radius, pass count, edge and looping mode tried.
include "../src/tools/track.elisa"

module OldTrack:
    public:
        # Reference median of five: the window sample with at least three
        # samples at or below it and three at or above it.
        def median5_of(values: darray[i64]&, f: i64, looping: bool) -> i64:
            mutable w: darray[i64] = []
            for d in 0..<5 |d, w, values, f, looping|:
                # The centre is the frame itself, like the median-of-3 reference.
                w.push(values[f.usize()] if d == 2 else Track::sample(values, f - 2 + d.i64(), looping))
            for k in 0..<5 |k, w|:
                mutable below: i64 = 0
                mutable above: i64 = 0
                for j in 0..<5 |j, k, w, below, above|:
                    if w[j] <= w[k]:
                        below <- below + 1
                    if w[j] >= w[k]:
                        above <- above + 1
                return w[k] if below >= 3 and above >= 3
            w[2]

        def despike(values: darray[i64]&, passes: i64, edge: i64, looping: bool) -> darray[i64]:
            count: i64 = values.count.i64()
            current: mutable darray[i64] = []
            for v in values |current|:
                current.push(v)
            return current if count < 3
            round: mutable i64 = 0
            while round < passes |round, current, count, looping|:
                next: mutable darray[i64] = []
                for i in 0..<current.count |i, current, next, count, looping, round|:
                    f: i64 = i.i64()
                    if round == 0:
                        next.push(Order::median3(Track::sample(current, f - 1, looping), current[i], Track::sample(current, f + 1, looping)))
                    else:
                        next.push(OldTrack::median5_of(&current, f, looping))
                current <- next
                round <- round + 1
            out: mutable darray[i64] = []
            for i in 0..<values.count |i, values, current, out, count, edge, looping|:
                w: i64 = Fade::weight(i.i64(), count - 1, edge, looping)
                out.push(Gate::apply(values[i], current[i], w))
            return out

        def median(values: darray[i64]&, radius: i64, edge: i64) -> darray[i64]:
            count: i64 = values.count.i64()
            out: mutable darray[i64] = []
            for v in values |out|:
                out.push(v)
            return out if count < 3 or radius < 1 or radius > Window::Domain::MAX_RADIUS or count >= Window::Domain::MAX_FRAMES
            window: mutable darray[i64] = []
            for i in 0..<values.count |i, values, out, window, count, radius, edge|:
                f: i64 = i.i64()
                window.clear()
                for d in 0..<(2 * radius + 1).usize() |d, values, window, f, radius|:
                    v: i64 = Track::odd_sample(values, f - radius + d.i64())
                    window.push(v)
                    j: mutable usize = window.count - 1
                    while j > 0 and window[j - 1] > v |j, window, v|:
                        window[j] <- window[j - 1]
                        j <- j - 1
                    window[j] <- v
                m: i64 = Window::middle(window.count.i64())
                w: i64 = Fade::eased_weight(f, count - 1, edge, false)
                out[i] <- Gate::apply(values[i], window[m.usize()], w)
            return out

        def smooth(values: darray[i64]&, passes: i64, edge: i64, looping: bool) -> darray[i64]:
            count: i64 = values.count.i64()
            current: mutable darray[i64] = []
            for v in values |current|:
                current.push(Order::clamp(v, -Smooth::LIMIT, Smooth::LIMIT))
            return current if count < 3
            round: mutable i64 = 0
            while round < passes |round, current, looping|:
                next: mutable darray[i64] = []
                for i in 0..<current.count |i, current, next, looping|:
                    f: i64 = i.i64()
                    before: i64 = Track::sample(current, f - 1, true) if looping else Track::odd_sample(current, f - 1)
                    after: i64 = Track::sample(current, f + 1, true) if looping else Track::odd_sample(current, f + 1)
                    next.push(Smooth::binomial(before, current[i], after))
                current <- next
                round <- round + 1
            out: mutable darray[i64] = []
            for i in 0..<values.count |i, values, current, out, count, edge, looping|:
                w: i64 = Fade::eased_weight(i.i64(), count - 1, edge, looping)
                out.push(Gate::apply(values[i], current[i], w))
            return out

def same(a: darray[i64]&, b: darray[i64]&) -> bool:
    return false if a.count != b.count
    for i in 0..<a.count |a, b|:
        return false if a[i] != b[i]
    return true

# Deterministic pseudo-random track: `kind` 0 = noise, 1 = noise on a ramp
# with spikes, 2 = few distinct values (many ties), 3 = constant.
def track(n: i64, seed: i64, kind: i64) -> darray[i64]:
    out: mutable darray[i64] = []
    x: mutable i64 = seed * 2654435761 % 2147483647 + 1
    for i in 0..<n.usize() |out, x, kind|:
        x <- x * 48271 % 2147483647
        v: mutable i64 = x % 2001 - 1000
        if kind == 1:
            v <- i.i64() * 37 + v / 8
            v <- v + 90000 if x % 13 == 0
        if kind == 2:
            v <- x % 4
        if kind == 3:
            v <- 5
        out.push(v)
    return out

def main() -> i32:
    sizes: darray[i64] = [0, 1, 2, 3, 4, 7, 40, 41, 42, 97, 300]
    radii: darray[i64] = [1, 2, 5, 20, 60]
    checked: mutable i64 = 0
    for s in sizes |sizes, radii, checked|:
        for kind in 0..<4 |s, radii, checked|:
            values: darray[i64] = track(s, s + kind.i64() * 7, kind.i64())
            for r in radii |values, checked|:
                for edge in 0..<3 |r, values, checked|:
                    a: darray[i64] = Track::median(values, r, edge.i64() * 4 + 1)
                    b: darray[i64] = OldTrack::median(values, r, edge.i64() * 4 + 1)
                    return 1 if not same(a, b)
                    checked <- checked + 1
            for passes in 0..<5 |values, checked|:
                p: i64 = passes.i64() * passes.i64() * 2
                for loop in 0..<2 |values, p, checked|:
                    looping: bool = loop == 1
                    a: darray[i64] = Track::smooth(values, p, 3, looping)
                    b: darray[i64] = OldTrack::smooth(values, p, 3, looping)
                    return 2 if not same(a, b)
                    c: darray[i64] = Track::despike(values, passes.i64(), 3, looping)
                    d: darray[i64] = OldTrack::despike(values, passes.i64(), 3, looping)
                    return 3 if not same(c, d)
                    checked <- checked + 2
    return 4 if checked < 1000
    # A two-frame burst on a ramp: one pass (median of 3) keeps it, two
    # passes (median of 3, then of 5) remove it: every frame lands back
    # among the ramp's own values (a median picks a neighbour, it does not
    # interpolate).
    mutable ramp: darray[i64] = []
    for i in 0..<20 |ramp|:
        ramp.push(i.i64() * 100)
    mutable burst: darray[i64] = []
    burst.extend(ramp)
    burst[9] <- 90000
    burst[10] <- 90000
    once: darray[i64] = Track::despike(burst, 1, 1, false)
    return 5 if once[9] != 90000
    twice: darray[i64] = Track::despike(burst, 2, 1, false)
    for i in 2..<18 |twice, ramp|:
        return 6 if twice[i] > 1900 or twice[i] < 0
    return 0
