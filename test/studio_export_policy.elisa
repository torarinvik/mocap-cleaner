# Export is denied when filesystem facts show an unresolved, out-of-build,
# source-aliasing, linked, non-file or unconfirmed replacement destination.
include "../src/studio/export_policy.elisa"

def main() -> i64:
    mutable root: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100]
    mutable child: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100, 47, 110, 101, 115, 116, 101, 100, 47, 111, 117, 116, 46, 103, 108, 98]
    mutable sibling: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100, 45, 111, 108, 100, 47, 111, 117, 116, 46, 103, 108, 98]
    return 1 if not StudioExportPolicy::inside_build(root, child)
    return 2 if StudioExportPolicy::inside_build(root, sibling)
    return 3 if StudioExportPolicy::decision(false, true, false, false, false, false, false) != StudioExportPolicy::PATH_UNRESOLVED
    return 4 if StudioExportPolicy::decision(true, false, false, false, false, false, false) != StudioExportPolicy::OUTSIDE_BUILD
    return 5 if StudioExportPolicy::decision(true, true, true, true, false, true, true) != StudioExportPolicy::SOURCE_COLLISION
    return 6 if StudioExportPolicy::decision(true, true, false, true, true, true, true) != StudioExportPolicy::SYMBOLIC_LINK
    return 7 if StudioExportPolicy::decision(true, true, false, true, false, false, true) != StudioExportPolicy::NOT_REGULAR_FILE
    return 8 if StudioExportPolicy::decision(true, true, false, true, false, true, false) != StudioExportPolicy::OVERWRITE_UNCONFIRMED
    return 9 if StudioExportPolicy::decision(true, true, false, false, false, false, false) != StudioExportPolicy::ALLOW
    return 10 if StudioExportPolicy::decision(true, true, false, true, false, true, true) != StudioExportPolicy::ALLOW
    0
