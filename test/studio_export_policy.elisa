# Export is denied when filesystem facts show an unresolved, out-of-build,
# source-aliasing, linked, non-file or unconfirmed replacement destination.
include "../src/studio/export_policy.elisa"

def main() -> i64:
    mutable root: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100]
    mutable child: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100, 47, 110, 101, 115, 116, 101, 100, 47, 111, 117, 116, 46, 103, 108, 98]
    mutable sibling: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100, 45, 111, 108, 100, 47, 111, 117, 116, 46, 103, 108, 98]
    return 1 if not StudioExportPolicy::inside_build(root, child)
    return 2 if StudioExportPolicy::inside_build(root, sibling)
    return 3 if StudioExportPolicy::decision(false, true, false, false, false, false, false) != StudioExportPolicy::Reason.PATH_UNRESOLVED.i64()
    return 4 if StudioExportPolicy::decision(true, false, false, false, false, false, false) != StudioExportPolicy::Reason.OUTSIDE_BUILD.i64()
    return 5 if StudioExportPolicy::decision(true, true, true, true, false, true, true) != StudioExportPolicy::Reason.SOURCE_COLLISION.i64()
    return 6 if StudioExportPolicy::decision(true, true, false, true, true, true, true) != StudioExportPolicy::Reason.SYMBOLIC_LINK.i64()
    return 7 if StudioExportPolicy::decision(true, true, false, true, false, false, true) != StudioExportPolicy::Reason.NOT_REGULAR_FILE.i64()
    return 8 if StudioExportPolicy::decision(true, true, false, true, false, true, false) != StudioExportPolicy::Reason.OVERWRITE_UNCONFIRMED.i64()
    return 9 if StudioExportPolicy::decision(true, true, false, false, false, false, false) != StudioExportPolicy::Reason.ALLOW.i64()
    return 10 if StudioExportPolicy::decision(true, true, false, true, false, true, true) != StudioExportPolicy::Reason.ALLOW.i64()
    return 11 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 0, true, 5, 3, 6, 4, 3, 2, 8, 7) != 0
    return 12 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 2, true, 5, 3, 6, 4, 3, 2, 8, 7) != 1
    return 13 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 0, true, 5, 6, 6, 4, 3, 2, 8, 7) != 1
    return 14 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 0, true, 5, 3, 6, 7, 3, 2, 8, 7) != 1
    return 15 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 0, true, 5, 3, 6, 4, 3, 4, 8, 7) != 1
    return 16 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 0, true, 5, 3, 6, 4, 3, 2, 8, 9) != 1
    return 17 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, 1, true, 5, 6, 6, 7, 3, 4, 8, 9) != 5
    return 18 if StudioExportPolicy::warning_count(StudioBalanceStatusPolicy::Availability.Unavailable, StudioBalanceStatusPolicy::Availability.Available, 0, true, 5, 3, 6, 4, 3, 2, 8, 7) != 1
    0
