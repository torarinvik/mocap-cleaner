# Focus loss must cancel unfinished input without discarding completed tools.
include "../src/studio/focus.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    active: StudioFocus::Interaction = StudioFocus::Interaction{
        modifiers: 3,
        drag_view: 1,
        drag_button: 0,
        scrubbing: true,
        selecting: true,
        slider_drag: true,
        retime_speed: 1500,
        slider_start_speed: 1000,
        edge_drag_band: 2,
        contact_press: true,
        gizmo_view: 0,
        typing: true,
        selection_active: true,
        gizmo_mode: 1
    }
    mutable after: StudioFocus::Interaction = StudioFocus::after_focus_lost(active)
    return 1 if after.modifiers != 0 or after.drag_view != -1 or after.drag_button != -1
    return 2 if after.scrubbing or after.selecting or after.slider_drag or after.contact_press or after.typing
    return 3 if after.edge_drag_band != -1 or after.gizmo_view != -1 or after.selection_active
    return 4 if after.retime_speed != 1000 or after.gizmo_mode != 1
    # Losing focus after a completed range selection does not discard it.
    active.selecting <- false
    active.selection_active <- true
    active.slider_drag <- false
    active.retime_speed <- 750
    after <- StudioFocus::after_focus_lost(active)
    return 5 if not after.selection_active or after.retime_speed != 750
    _ = puts("studio focus loss: transient gestures cancelled")
    return 0
