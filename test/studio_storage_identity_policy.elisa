# Identity comparison binds all filesystem metadata and the exact path result.
include "../src/studio/storage_identity_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    receipt: StudioStorageIdentityPolicy::Identity = StudioStorageIdentityPolicy::Identity{
        device: 17, inode: 812, size_bytes: 4096,
        modified_seconds: 1720000000, modified_nanoseconds: 123456789
    }
    return 1 if not StudioStorageIdentityPolicy::matches(receipt, receipt, true)
    return 2 if StudioStorageIdentityPolicy::matches(receipt, receipt, false)

    changed: mutable StudioStorageIdentityPolicy::Identity = receipt
    changed.device <- changed.device + 1
    return 3 if StudioStorageIdentityPolicy::matches(receipt, changed, true)
    changed <- receipt
    changed.inode <- changed.inode + 1
    return 4 if StudioStorageIdentityPolicy::matches(receipt, changed, true)
    changed <- receipt
    changed.size_bytes <- changed.size_bytes + 1
    return 5 if StudioStorageIdentityPolicy::matches(receipt, changed, true)
    changed <- receipt
    changed.modified_seconds <- changed.modified_seconds + 1
    return 6 if StudioStorageIdentityPolicy::matches(receipt, changed, true)
    changed <- receipt
    changed.modified_nanoseconds <- changed.modified_nanoseconds + 1
    return 7 if StudioStorageIdentityPolicy::matches(receipt, changed, true)
    _ = puts("studio storage identity policy: strict identity match passes")
    return 0
