# Identity comparison binds all filesystem metadata and the exact path result.
include "../src/studio/storage_identity_policy.elisa"

extern puts(text: cstr) -> i64

def main() -> i32:
    return 1 if not StudioStorageIdentityPolicy::matches(
        17, 17, 812, 812, 4096, 4096, 1720000000, 1720000000,
        123456789, 123456789, true)
    return 2 if StudioStorageIdentityPolicy::matches(
        17, 17, 812, 812, 4096, 4096, 1720000000, 1720000000,
        123456789, 123456789, false)
    return 3 if StudioStorageIdentityPolicy::matches(
        17, 18, 812, 812, 4096, 4096, 1720000000, 1720000000,
        123456789, 123456789, true)
    return 4 if StudioStorageIdentityPolicy::matches(
        17, 17, 812, 813, 4096, 4096, 1720000000, 1720000000,
        123456789, 123456789, true)
    return 5 if StudioStorageIdentityPolicy::matches(
        17, 17, 812, 812, 4096, 4097, 1720000000, 1720000000,
        123456789, 123456789, true)
    return 6 if StudioStorageIdentityPolicy::matches(
        17, 17, 812, 812, 4096, 4096, 1720000000, 1720000001,
        123456789, 123456789, true)
    return 7 if StudioStorageIdentityPolicy::matches(
        17, 17, 812, 812, 4096, 4096, 1720000000, 1720000000,
        123456789, 123456790, true)
    _ = puts("studio storage identity policy: strict identity match passes")
    return 0
