include "../src/studio/state/generation_review_status_policy.elisa"

module StudioGenerationReviewStatusLaws:
    public:
        def closing_overrides_every_status(facts: StudioGenerationReviewStatusPolicy::Facts) -> bool:
            requires facts.closing
            ensure result
            StudioGenerationReviewStatusPolicy::classify(facts) == StudioGenerationReviewStatusPolicy::Source.Closing

        def active_restore_is_visible(facts: StudioGenerationReviewStatusPolicy::Facts) -> bool:
            requires not facts.closing and facts.restore_worker
            ensure result
            StudioGenerationReviewStatusPolicy::classify(facts) == StudioGenerationReviewStatusPolicy::Source.Restore

        def active_move_is_visible(facts: StudioGenerationReviewStatusPolicy::Facts) -> bool:
            requires not facts.closing and not facts.restore_worker and facts.move_worker
            ensure result
            StudioGenerationReviewStatusPolicy::classify(facts) == StudioGenerationReviewStatusPolicy::Source.Move

        def confirmation_is_visible(facts: StudioGenerationReviewStatusPolicy::Facts) -> bool:
            requires not facts.closing and not facts.restore_worker and not facts.move_worker and facts.restore_review
            ensure result
            StudioGenerationReviewStatusPolicy::classify(facts) == StudioGenerationReviewStatusPolicy::Source.Restore

        def settled_summary_does_not_hide_recovery(facts: StudioGenerationReviewStatusPolicy::Facts) -> bool:
            requires not facts.closing and not facts.restore_worker and not facts.move_worker and not facts.restore_review and facts.recovery_mode
            ensure result
            StudioGenerationReviewStatusPolicy::classify(facts) == StudioGenerationReviewStatusPolicy::Source.Recovery

        def no_operation_shows_inventory(facts: StudioGenerationReviewStatusPolicy::Facts) -> bool:
            requires not facts.closing and not facts.restore_worker and not facts.move_worker and not facts.restore_review
            requires not facts.recovery_mode and not facts.restore_summary and not facts.move_summary
            ensure result
            StudioGenerationReviewStatusPolicy::classify(facts) == StudioGenerationReviewStatusPolicy::Source.Inventory

        def review_state_is_recognized(key: StudioGenerationRestoreConfirmationPolicy::SourceKey) -> bool:
            ensure result
            StudioGenerationReviewStatusPolicy::reviewing(StudioGenerationRestoreConfirmationPolicy::State.Reviewing(key: key))

        def pending_recovery_is_not_new_confirmation(ticket: i64) -> bool:
            ensure not result
            StudioGenerationReviewStatusPolicy::reviewing(StudioGenerationRestoreConfirmationPolicy::State.RecoveryPending(job_ticket: ticket))
