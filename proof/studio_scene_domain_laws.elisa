include "../src/studio/app/scene.elisa"

module StudioSceneDomainLaws:
    public:
        def default_overlays_retained() -> bool:
            ensure result
            StudioScene::Flags::DEFAULT_FLAGS == 179

        def overlay_bits_retained() -> bool:
            ensure result
            StudioScene::Flags::TRAILS == 1 and StudioScene::Flags::CONTACTS == 2 and StudioScene::Flags::HEAT == 4 and StudioScene::Flags::ONION == 8 and StudioScene::Flags::GHOST == 16 and StudioScene::Flags::XRAY == 32 and StudioScene::Flags::MESH == 64 and StudioScene::Flags::BALANCE == 128

        def trail_extent_retained() -> bool:
            ensure result
            StudioScene::Sampling::TRAIL_BEFORE == 60 and StudioScene::Sampling::TRAIL_AFTER == 60

        def onion_sampling_retained() -> bool:
            ensure result
            StudioScene::Sampling::ONION_COUNT == 3 and StudioScene::Sampling::ONION_STEP == 8
