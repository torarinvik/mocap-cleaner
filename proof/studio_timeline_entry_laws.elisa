include "../src/studio/timeline_entry_policy.elisa"

module StudioTimelineEntryLaws:
    public:
        def frame_capacity() -> bool:
            ensure result
            StudioTimelineEntryPolicy::capacity(StudioTimelineEntryPolicy::Mode.Frame) == 8

        def seconds_capacity() -> bool:
            ensure result
            StudioTimelineEntryPolicy::capacity(StudioTimelineEntryPolicy::Mode.Seconds) == 15

        def decimal_is_time_only() -> bool:
            ensure result
            StudioTimelineEntryPolicy::byte_allowed(StudioTimelineEntryPolicy::Mode.Seconds, 46) and not StudioTimelineEntryPolicy::byte_allowed(StudioTimelineEntryPolicy::Mode.Frame, 46)

        def sign_is_refused() -> bool:
            ensure result
            not StudioTimelineEntryPolicy::byte_allowed(StudioTimelineEntryPolicy::Mode.Seconds, 45)

        def missing_storage_refused() -> bool:
            ensure result
            not StudioTimelineEntryPolicy::extent_valid(StudioTimelineEntryPolicy::Mode.Seconds, 1, false)

        def oversized_time_refused() -> bool:
            ensure result
            not StudioTimelineEntryPolicy::extent_valid(StudioTimelineEntryPolicy::Mode.Seconds, 13, true)
