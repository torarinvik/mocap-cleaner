include "../src/studio/edit_transaction_policy.elisa"

module StudioEditTransactionLaws:
    public:
        def invalid_observed_base_cannot_stage(existing: bool, captured: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires not StudioEditTransactionPolicy::valid(observed)
            ensure result
            not StudioEditTransactionPolicy::stage_admitted(existing, captured, observed)

        def stale_draft_cannot_compose(captured: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires not StudioEditTransactionPolicy::current(captured, observed)
            ensure result
            not StudioEditTransactionPolicy::stage_admitted(true, captured, observed)

        def first_draft_uses_valid_observed_base(captured: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires StudioEditTransactionPolicy::valid(observed)
            ensure result
            StudioEditTransactionPolicy::stage_admitted(false, captured, observed)

        def current_draft_can_compose(base: StudioEditTransactionPolicy::Base) -> bool:
            requires StudioEditTransactionPolicy::valid(base)
            ensure result
            StudioEditTransactionPolicy::stage_admitted(true, base, base)

        def history_intents_are_distinct() -> bool:
            ensure result
            StudioEditTransactionPolicy::Intent.Record != StudioEditTransactionPolicy::Intent.Undo and StudioEditTransactionPolicy::Intent.Record != StudioEditTransactionPolicy::Intent.Redo and StudioEditTransactionPolicy::Intent.Undo != StudioEditTransactionPolicy::Intent.Redo

        def valid_base_is_current(base: StudioEditTransactionPolicy::Base) -> bool:
            requires StudioEditTransactionPolicy::valid(base)
            ensure result
            StudioEditTransactionPolicy::current(base, base)

        def invalid_base_refused(base: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires not StudioEditTransactionPolicy::valid(base)
            ensure result
            not StudioEditTransactionPolicy::current(base, observed)

        def changed_take_refused(base: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires base.take != observed.take
            ensure result
            not StudioEditTransactionPolicy::current(base, observed)

        def changed_result_refused(base: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires base.result_generation != observed.result_generation
            ensure result
            not StudioEditTransactionPolicy::current(base, observed)

        def changed_stack_refused(base: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires base.stack_generation != observed.stack_generation
            ensure result
            not StudioEditTransactionPolicy::current(base, observed)

        def changed_cursor_refused(base: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires base.cursor != observed.cursor
            ensure result
            not StudioEditTransactionPolicy::current(base, observed)

        def changed_history_count_refused(base: StudioEditTransactionPolicy::Base, observed: StudioEditTransactionPolicy::Base) -> bool:
            requires base.count != observed.count
            ensure result
            not StudioEditTransactionPolicy::current(base, observed)
