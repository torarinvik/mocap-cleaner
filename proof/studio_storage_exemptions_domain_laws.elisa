include "../src/studio/io/storage_exemptions_file.elisa"

module StudioStorageExemptionsDomainLaws:
    public:
        def header_extent_matches_wire_policy() -> bool:
            ensure result
            StudioStorageExemptionsCodec::Wire::HEADER_BYTES == StudioStorageExemptionsWirePolicy::Wire::HEADER_BYTES

        def file_extent_retains_manifest_budget() -> bool:
            ensure result
            StudioStorageExemptionsCodec::Wire::MAX_FILE_BYTES == StudioStorageManifest::Capacity::MAX_ENTRIES.usize() * StudioStorageManifest::Capacity::MAX_LINE_BYTES + 64 + StudioStorageExemptionsWirePolicy::Wire::PREFIX_BYTES

        def success_code_retained() -> bool:
            ensure result
            StudioStorageExemptionsFile::LoadStatus.Ok.i64() == 0

        def failure_codes_retained() -> bool:
            ensure result
            StudioStorageExemptionsFile::LoadStatus.OpenFailed.i64() == 1 and StudioStorageExemptionsFile::LoadStatus.ReadFailed.i64() == 2 and StudioStorageExemptionsFile::LoadStatus.TooLarge.i64() == 3 and StudioStorageExemptionsFile::LoadStatus.CloseFailed.i64() == 4 and StudioStorageExemptionsFile::LoadStatus.InvalidFormat.i64() == 5
