include "../src/studio/shortcuts.elisa"

module StudioShortcutDomainLaws:
    public:
        def modifier_bits_retained() -> bool:
            ensure result
            StudioShortcuts::Modifiers::COMMAND == 1 and StudioShortcuts::Modifiers::SHIFT == 2 and StudioShortcuts::Modifiers::ALL == 3

        def key_action_values_retained() -> bool:
            ensure result
            StudioShortcuts::KeyAction.Plain.i64() == 0 and StudioShortcuts::KeyAction.Undo.i64() == 1 and StudioShortcuts::KeyAction.Redo.i64() == 2 and StudioShortcuts::KeyAction.Swallow.i64() == 3

        def file_action_values_retained() -> bool:
            ensure result
            StudioShortcuts::FileAction.None.i64() == 0 and StudioShortcuts::FileAction.OpenTake.i64() == 1 and StudioShortcuts::FileAction.OpenSession.i64() == 2 and StudioShortcuts::FileAction.Save.i64() == 3 and StudioShortcuts::FileAction.SaveAs.i64() == 4 and StudioShortcuts::FileAction.ExportAs.i64() == 5
