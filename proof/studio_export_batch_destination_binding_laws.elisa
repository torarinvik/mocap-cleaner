include "../src/studio/export_batch_destination_binding.elisa"

module StudioExportBatchDestinationBindingLaws:
    public:
        def negative_selection_is_refused(queue: StudioExportBatchReviewBinding::BoundQueue&, index: i64) -> bool:
            requires index < 0
            ensure result
            StudioExportBatchReviewBinding::destination_projection(queue, index) == null

        def selection_past_queue_is_refused(queue: StudioExportBatchReviewBinding::BoundQueue&, index: i64) -> bool:
            requires StudioExportBatchReviewBinding::valid(queue)
            requires index >= StudioExportBatchReviewBinding::item_count(queue).i64()
            ensure result
            StudioExportBatchReviewBinding::destination_projection(queue, index) == null

        def invalid_queue_has_no_location_snapshot(queue: StudioExportBatchReviewBinding::BoundQueue&, index: i64) -> bool:
            requires not StudioExportBatchReviewBinding::valid(queue)
            ensure result
            StudioExportBatchReviewBinding::destination_projection(queue, index) == null
