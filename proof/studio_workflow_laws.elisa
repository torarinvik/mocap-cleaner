# Beginner workflow band laws: one current step, done steps before it,
# nothing past an unloaded take is reachable, regressions send the user back
# to Fix, and the hint agrees with the current step.
include "../src/studio/workflow_policy.elisa"

module StudioWorkflowLaws:
    public:
        def nothing_loaded_means_import(findings: i64, changed: bool, regressed: bool, exported: bool) -> i64:
            ensure result == StudioWorkflow::Step.Import.i64()
            StudioWorkflow::current(false, findings, changed, regressed, exported)

        def a_regression_always_returns_to_fix(findings: i64, exported: bool) -> i64:
            ensure result == StudioWorkflow::Step.Fix.i64()
            StudioWorkflow::current(true, findings, true, true, exported)

        def a_clean_change_asks_for_validation(findings: i64) -> i64:
            ensure result == StudioWorkflow::Step.Validate.i64()
            StudioWorkflow::current(true, findings, true, false, false)

        def a_take_without_findings_can_export_directly(findings: i64) -> i64:
            requires findings <= 0
            ensure result == StudioWorkflow::Step.Export.i64()
            StudioWorkflow::current(true, findings, false, false, false)

        def the_current_step_is_the_only_current_one(step: i64, now: i64, loaded: bool) -> bool:
            requires step >= 0 and step < StudioWorkflow::Count::STEPS
            requires now >= 0 and now < StudioWorkflow::Count::STEPS
            ensure result == (step == now)
            StudioWorkflow::state(step, now, loaded) == StudioWorkflow::State.Current.i64()

        def an_unloaded_take_blocks_every_later_step(step: i64) -> i64:
            requires step > 0 and step < StudioWorkflow::Count::STEPS
            ensure result == StudioWorkflow::State.Blocked.i64()
            StudioWorkflow::state(step, StudioWorkflow::Step.Import.i64(), false)

        def importing_wins_over_every_other_hint(loaded: bool, findings: i64, changed: bool, regressed: bool, exported: bool) -> i64:
            ensure result == StudioWorkflow::Hint.Importing.i64()
            StudioWorkflow::hint(loaded, true, findings, changed, regressed, exported)

        def remaining_findings_are_never_hidden_behind_export(findings: i64) -> i64:
            requires findings > 0
            ensure result == StudioWorkflow::Hint.RemainingFindings.i64()
            StudioWorkflow::hint(true, false, findings, true, false, false)

        def a_regression_hint_matches_the_fix_step(findings: i64, exported: bool) -> bool:
            ensure result
            StudioWorkflow::hint(true, false, findings, true, true, exported) == StudioWorkflow::Hint.Regressed.i64() and StudioWorkflow::current(true, findings, true, true, exported) == StudioWorkflow::Step.Fix.i64()
