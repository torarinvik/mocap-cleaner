# Laws for the File menu's row mapping, availability and navigation.
include "../src/studio/file_policy.elisa"

module StudioFilePolicyLaws:
    public:
        def first_row_is_open_take() -> i64:
            ensure result == StudioFilePolicy::Command.OPEN_TAKE.i64()
            StudioFilePolicy::action(0)

        def second_row_is_open_session() -> i64:
            ensure result == StudioFilePolicy::Command.OPEN_SESSION.i64()
            StudioFilePolicy::action(1)

        def third_row_is_save() -> i64:
            ensure result == StudioFilePolicy::Command.SAVE.i64()
            StudioFilePolicy::action(2)

        def fourth_row_is_save_as() -> i64:
            ensure result == StudioFilePolicy::Command.SAVE_AS.i64()
            StudioFilePolicy::action(3)

        def fifth_row_is_export_current() -> i64:
            ensure result == StudioFilePolicy::Command.EXPORT_CURRENT.i64()
            StudioFilePolicy::action(4)

        def sixth_row_is_export_as() -> i64:
            ensure result == StudioFilePolicy::Command.EXPORT_AS.i64()
            StudioFilePolicy::action(5)

        def seventh_row_is_storage_recovery() -> i64:
            ensure result == StudioFilePolicy::Command.OPEN_STORAGE.i64()
            StudioFilePolicy::action(6)

        def eighth_row_loads_character() -> i64:
            ensure result == StudioFilePolicy::Command.LOAD_CHARACTER.i64()
            StudioFilePolicy::action(7)

        def ninth_row_is_workspace() -> i64:
            ensure result == StudioFilePolicy::Command.WORKSPACE.i64()
            StudioFilePolicy::action(8)

        def base_rows_always_keep_locate_workspace() -> i64:
            ensure result == StudioFilePolicy::Command.WORKSPACE.i64()
            StudioFilePolicy::action_for(8, false)

        def pending_rows_append_create_and_cancel() -> bool:
            ensure result
            (StudioFilePolicy::row_count(true) == StudioFilePolicy::Count::MAX_ROWS and
                StudioFilePolicy::action_for(9, true) == StudioFilePolicy::Command.CREATE_BUILD.i64() and
                StudioFilePolicy::action_for(10, true) == StudioFilePolicy::Command.CANCEL_WORKSPACE_SETUP.i64())

        def menu_header_is_not_a_command() -> i64:
            ensure result == -1
            StudioFilePolicy::row_at_offset(8, 28, true)

        def first_row_begins_below_header() -> i64:
            ensure result == 0
            StudioFilePolicy::row_at_offset(28, 28, false)

        def last_pending_row_ends_at_menu_capacity() -> i64:
            ensure result == 10
            StudioFilePolicy::row_at_offset(28 + 10 * 28, 28, true)

        def menu_bottom_does_not_hit_a_row() -> i64:
            ensure result == -1
            StudioFilePolicy::row_at_offset(28 + 11 * 28, 28, true)

        def pending_workspace_actions_are_available_without_take() -> bool:
            ensure result
            (StudioFilePolicy::available(StudioFilePolicy::Command.WORKSPACE.i64(), false, false) and
                StudioFilePolicy::available(StudioFilePolicy::Command.CREATE_BUILD.i64(), false, false) and
                StudioFilePolicy::available(StudioFilePolicy::Command.CANCEL_WORKSPACE_SETUP.i64(), false, false))

        def workspace_files_remain_unavailable_until_ready() -> bool:
            ensure not result
            StudioFilePolicy::available(StudioFilePolicy::Command.OPEN_SESSION.i64(), true, false)

        def workspace_less_storage_remains_unavailable() -> bool:
            ensure not result
            StudioFilePolicy::available(StudioFilePolicy::Command.OPEN_STORAGE.i64(), true, false)

        def workspace_available_without_take() -> bool:
            ensure result
            StudioFilePolicy::enabled(StudioFilePolicy::Command.WORKSPACE.i64(), false)

        def character_load_is_available_without_take_or_workspace() -> bool:
            ensure result
            StudioFilePolicy::available(StudioFilePolicy::Command.LOAD_CHARACTER.i64(), false, false)

        def storage_activation_without_take(row: i64) -> i64:
            requires row == 6
            ensure result == StudioFilePolicy::Command.OPEN_STORAGE.i64()
            StudioFilePolicy::activate(row, false)

        def workspace_activation_without_take(row: i64) -> i64:
            requires row == 8
            ensure result == StudioFilePolicy::Command.WORKSPACE.i64()
            StudioFilePolicy::activate(row, false)

        def locate_action_remains_available_during_pending_setup() -> i64:
            ensure result == StudioFilePolicy::Command.WORKSPACE.i64()
            StudioFilePolicy::activate_for(8, false, false, true)

        def explicit_create_and_cancel_are_distinct_actions() -> bool:
            ensure result
            (StudioFilePolicy::activate_for(9, false, false, true) == StudioFilePolicy::Command.CREATE_BUILD.i64() and
                StudioFilePolicy::activate_for(10, false, false, true) == StudioFilePolicy::Command.CANCEL_WORKSPACE_SETUP.i64())
