include "../src/core/report_index_kernel.elisa"

module ReportIndexKernelLaws:
    public:
        def singleton_midpoint(first: i64) -> i64:
            requires first >= 0 and first < ReportBudget::Capacity::BYTES
            ensure result == first
            ReportIndexKernel::midpoint(first, first + 1)

        def midpoint_stays_in_window(first: i64, stop: i64) -> i64:
            requires first >= 0 and first < stop
            requires stop <= ReportBudget::Capacity::BYTES
            ensure result >= first and result < stop
            ReportIndexKernel::midpoint(first, stop)

        def sort_width_progresses(width: i64) -> i64:
            requires width >= 1 and width <= ReportBudget::Capacity::BYTES
            ensure result > width
            ReportIndexKernel::next_width(width)
