# Edge-fade laws: clip boundaries equal the source exactly, weights stay in
# permille, and looping clips are never faded. Composed from Fade's summaries.
include "../src/core/fade.elisa"

module FadeLaws:
    public:
        # fade(0) == 0 on a non-looping clip.
        def first_frame_unfaded(last: i64, edge: i64) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            ensure result == 0
            return Fade::weight(0, last, edge, false)

        # fade(n-1) == 0 on a non-looping clip.
        def last_frame_unfaded(last: i64, edge: i64) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            ensure result == 0
            return Fade::weight(last, last, edge, false)

        # A looping clip gets the full fix on every frame, seam included.
        def loop_is_full(frame: i64, last: i64, edge: i64) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            requires frame >= 0
            requires frame <= last
            ensure result == Fade::Domain::FULL_PERMILLE
            return Fade::weight(frame, last, edge, true)

        # Every weight is a permille fraction.
        def weight_in_permille(frame: i64, last: i64, edge: i64, looping: bool) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= Fade::Domain::FULL_PERMILLE
            return Fade::weight(frame, last, edge, looping)

        # Past the edge the ramp saturates: interior frames get the full fix.
        def saturates(distance: i64, edge: i64) -> i64:
            requires distance >= edge
            requires distance <= Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            ensure result == Fade::Domain::FULL_PERMILLE
            return Fade::scale(distance, edge)

        # The edge distance is symmetric in which end is nearer.
        def distance_bounded(frame: i64, last: i64) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= frame
            ensure result <= last - frame
            return Fade::edge_distance(frame, last)
