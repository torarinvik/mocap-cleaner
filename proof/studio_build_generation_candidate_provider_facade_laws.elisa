# Laws for the native scan boundary and truthful candidate evidence.
include "../src/studio/io/build_generation_candidate_provider.elisa"

module StudioBuildGenerationCandidateProviderFacadeLaws:
    public:
        def unknown_outcome_is_not_admitted(raw: i32) -> bool:
            requires raw < 0 or raw > 2
            ensure StudioBuildGenerationCandidateProviderBindingPolicy::decode_outcome(raw).kind == StudioBuildGenerationCandidateProviderBindingPolicy::DecodeKind.Unknown
            StudioBuildGenerationCandidateProviderBindingPolicy::decode_outcome(raw).kind == StudioBuildGenerationCandidateProviderBindingPolicy::DecodeKind.Unknown

        def legacy_absent_evidence_is_valid(evidence: StudioBuildGenerationCandidateProvider::CreationEvidence) -> bool:
            requires StudioBuildGenerationCandidateProvider::creation_evidence_legacy(evidence)
            ensure result
            StudioBuildGenerationCandidateProvider::creation_evidence_valid(evidence)

        def legacy_rows_cannot_be_eligible(row: StudioBuildGenerationCandidateProvider::Row) -> bool:
            requires StudioBuildGenerationCandidateProvider::creation_evidence_legacy(row.creation_evidence)
            ensure not result
            row.protection == StudioBuildGenerationCandidateProvider::Protection.Eligible and StudioBuildGenerationCandidateProvider::row_valid(row)

        def package_input_record_is_required_for_present_identity(
            digests: StudioBuildGenerationCandidateProvider::SealedDigests) -> bool:
            requires digests.input_record == StudioBuildGenerationCandidateProvider::DigestEvidence.Unknown or digests.input_record == StudioBuildGenerationCandidateProvider::DigestEvidence.NotApplicable
            ensure not result
            StudioBuildGenerationCandidateProvider::product_identity_valid_for(StudioBuildGenerationCandidateProvider::ProductIdentity.Present(digests), StudioBuildGenerationCandidateProvider::Artifact.Package)

        def unknown_age_cannot_be_eligible(row: StudioBuildGenerationCandidateProvider::Row) -> bool:
            requires StudioBuildGenerationCandidateProvider::age_unknown(row.age)
            ensure not result
            row.protection == StudioBuildGenerationCandidateProvider::Protection.Eligible and StudioBuildGenerationCandidateProvider::row_valid(row)
