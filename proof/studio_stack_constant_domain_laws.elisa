include "../src/studio/state/stack_state.elisa"

module StudioStackConstantDomainLaws:
    public:
        def contact_wire_values_unchanged() -> bool:
            ensure result
            StackState::ContactSide.LeftFoot.i64() == 0 and StackState::ContactSide.RightFoot.i64() == 1 and StackState::ContactSide.LeftHand.i64() == 2 and StackState::ContactSide.RightHand.i64() == 3

        def bounded_storage_unchanged() -> bool:
            ensure result
            StackState::Capacity::MAX_EDITS == 32 and StackState::Capacity::MAX_BANDS == 8

        def operation_limits_unchanged() -> bool:
            ensure result
            StackState::Limit::MAX_STRENGTH == 64 and StackState::Limit::MAX_EDGE == 120
