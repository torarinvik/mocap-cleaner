include "../src/studio/storage_footer_layout_policy.elisa"

module StudioStorageFooterLayoutPolicyLaws:
    public:
        def wide_dialog_uses_one_row() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::columns(792) == 5 and
                StudioStorageFooterLayoutPolicy::extra_height(792) == 0)

        def standard_dialog_keeps_all_five_actions() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::columns(760) == 5 and
                StudioStorageFooterLayoutPolicy::rows(760) == 1)

        def narrow_dialog_reflows_to_two_rows() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::columns(600) == 4 and
                StudioStorageFooterLayoutPolicy::extra_height(600) == 42)

        def very_narrow_dialog_uses_multiple_rows() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::columns(400) == 2 and
                StudioStorageFooterLayoutPolicy::rows(400) == 3)

        def invalid_width_cannot_divide_by_zero() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::columns(-1) == 1 and
                StudioStorageFooterLayoutPolicy::rows(-1) == 5)

        def narrow_header_and_selection_rows_reserve_space() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::header_height(600) == 42 and
                StudioStorageFooterLayoutPolicy::content_height(600) == 84 and
                StudioStorageFooterLayoutPolicy::content_height(760) == 0)

        def filename_space_stops_before_status_columns() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::filename_width(716) == 407 and
                34 + StudioStorageFooterLayoutPolicy::filename_width(716) + 10 == 716 - 265)

        def tiny_rows_cannot_have_negative_filename_width() -> bool:
            ensure result
            (StudioStorageFooterLayoutPolicy::filename_width(309) == 0 and
                StudioStorageFooterLayoutPolicy::filename_width(-1) == 0)
