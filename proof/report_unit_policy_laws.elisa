include "../src/core/report_unit_policy.elisa"

module ReportUnitPolicyLaws:
    public:
        def counts_are_admitted() -> bool:
            ensure result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Count, ReportUnitPolicy::Dimension.Count)

        def counts_are_not_distances() -> bool:
            ensure not result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Count, ReportUnitPolicy::Dimension.Distance)

        def unknown_dimensions_are_not_admitted(declared: ReportUnitPolicy::Dimension) -> bool:
            ensure not result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Unknown, declared)

        def matching_frames_are_admitted() -> bool:
            ensure result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Frames, ReportUnitPolicy::Dimension.Frames)

        def negative_quality_is_unavailable(dimension: ReportUnitPolicy::Dimension, exponent: i64) -> bool:
            ensure not result
            ReportUnitPolicy::number_admitted(dimension, -1, exponent)

        def fractional_counts_are_unavailable() -> bool:
            ensure not result
            ReportUnitPolicy::number_admitted(ReportUnitPolicy::Dimension.Count, 1, -1)

        def fractional_frames_are_unavailable() -> bool:
            ensure not result
            ReportUnitPolicy::number_admitted(ReportUnitPolicy::Dimension.Frames, 1, -1)

        def fractional_distances_are_available() -> bool:
            ensure result
            ReportUnitPolicy::number_admitted(ReportUnitPolicy::Dimension.Distance, 1, -1)

        def unknown_numeric_dimensions_are_unavailable(coefficient: i64, exponent: i64) -> bool:
            ensure not result
            ReportUnitPolicy::number_admitted(ReportUnitPolicy::Dimension.Unknown, coefficient, exponent)
