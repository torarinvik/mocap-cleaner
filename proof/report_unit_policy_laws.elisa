include "../src/core/report_unit_policy.elisa"

module ReportUnitPolicyLaws:
    public:
        def counts_are_admitted() -> bool:
            ensure result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Count, ReportUnitPolicy::Dimension.Count)

        def counts_are_not_distances() -> bool:
            ensure not result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Count, ReportUnitPolicy::Dimension.Distance)

        def unknown_dimensions_are_not_admitted(declared: ReportUnitPolicy::Dimension) -> bool:
            ensure not result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Unknown, declared)

        def matching_frames_are_admitted() -> bool:
            ensure result
            ReportUnitPolicy::admitted(ReportUnitPolicy::Dimension.Frames, ReportUnitPolicy::Dimension.Frames)
