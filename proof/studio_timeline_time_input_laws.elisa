include "../src/studio/timeline_time_input_kernel.elisa"

module StudioTimelineTimeInputLaws:
    public:
        def zero_selects_first(rate: i64, count: i64) -> bool:
            requires rate >= 1 and rate <= StudioTimelineTimeInputKernel::Domain::MAX_RATE
            requires count >= 1 and count <= StudioTimelineTimeInputKernel::Domain::MAX_FRAMES
            ensure result
            StudioTimelineTimeInputKernel::frame(0, rate, count) == 0

        def whole_second_at_24fps() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::frame(1000, 24, 100) == 24

        def whole_second_at_120fps() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::frame(1000, 120, 200) == 120

        def fractional_time_floors() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::frame(41, 24, 100) == 0 and StudioTimelineTimeInputKernel::frame(42, 24, 100) == 1

        def decimal_fraction_units() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::fraction_millis(5, 10) == 500 and StudioTimelineTimeInputKernel::fraction_millis(25, 100) == 250 and StudioTimelineTimeInputKernel::fraction_millis(125, 1000) == 125

        def combine_fraction() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::milliseconds(2, 125) == 2125

        def domain_overflow_saturates() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::seconds_digit(StudioTimelineTimeInputKernel::Domain::MAX_SECONDS + 1, 0) == StudioTimelineTimeInputKernel::Domain::MAX_SECONDS + 1

        def past_clip_clamps() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::frame(1000, 24, 10) == 9 and StudioTimelineTimeInputKernel::clamped(1000, 24, 10)

        def within_clip_is_not_clamped() -> bool:
            ensure result
            not StudioTimelineTimeInputKernel::clamped(1000, 24, 25)

        def one_frame_clip() -> bool:
            ensure result
            StudioTimelineTimeInputKernel::frame(1000, 24, 1) == 0
