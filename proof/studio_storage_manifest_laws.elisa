include "../src/studio/io/storage_manifest.elisa"

module StudioStorageManifestLaws:
    public:
        def empty_manifest_path_is_refused() -> bool:
            ensure result
            path: darray[u8] = []
            not StudioStorageManifest::path_valid(path)

        def oversized_manifest_path_is_refused(path: darray[u8]&) -> bool:
            requires path.count > StudioStorageManifest::Capacity::MAX_PATH_BYTES
            ensure result
            not StudioStorageManifest::path_valid(path)

        def embedded_nul_path_is_refused(path: darray[u8]&, index: usize) -> bool:
            requires index < path.count
            requires path[index] == 0
            ensure result
            not StudioStorageManifest::path_valid(path)

        def admitted_path_has_bounded_extent(path: darray[u8]&) -> bool:
            requires StudioStorageManifest::path_valid(path)
            ensure result
            path.count > 0 and path.count <= StudioStorageManifest::Capacity::MAX_PATH_BYTES

        def admitted_path_is_utf8(path: darray[u8]&) -> bool:
            requires StudioStorageManifest::path_valid(path)
            ensure result
            StudioStorageManifest::utf8_valid(path)

        def admitted_path_has_no_nul_at_index(path: darray[u8]&, index: usize) -> bool:
            requires StudioStorageManifest::path_valid(path)
            requires index < path.count
            ensure result
            path[index] != 0

        def different_path_extents_cannot_match(a: darray[u8]&, b: darray[u8]&) -> bool:
            requires a.count != b.count
            ensure result
            not StudioStorageManifest::same_path(a, b)

        def different_path_bytes_cannot_match(a: darray[u8]&, b: darray[u8]&, index: usize) -> bool:
            requires index < a.count and index < b.count
            requires a[index] != b[index]
            ensure result
            not StudioStorageManifest::same_path(a, b)

        def path_matches_itself(path: darray[u8]&) -> bool:
            ensure result
            StudioStorageManifest::same_path(path, path)

        def different_entry_states_have_distinct_keys(a: StudioStorageManifest::Entry, b: StudioStorageManifest::Entry) -> bool:
            requires a.state != b.state
            ensure result
            not StudioStorageManifest::same_entry_key(a, b)

        def different_original_paths_have_distinct_keys(a: StudioStorageManifest::Entry, b: StudioStorageManifest::Entry) -> bool:
            requires not StudioStorageManifest::same_path(a.original_path, b.original_path)
            ensure result
            not StudioStorageManifest::same_entry_key(a, b)

        def unknown_entry_state_is_refused(entry: StudioStorageManifest::Entry) -> bool:
            requires entry.state != StudioStorageManifest::State.Registered.i64() and entry.state != StudioStorageManifest::State.InTrash.i64()
            ensure result
            not StudioStorageManifest::valid(entry)

        def registered_entry_cannot_have_trash_path(entry: StudioStorageManifest::Entry) -> bool:
            requires entry.state == StudioStorageManifest::State.Registered.i64()
            requires entry.trashed_path.count > 0
            ensure result
            not StudioStorageManifest::valid(entry)

        def trash_entry_requires_a_location(entry: StudioStorageManifest::Entry) -> bool:
            requires entry.state == StudioStorageManifest::State.InTrash.i64()
            requires entry.trashed_path.count == 0
            ensure result
            not StudioStorageManifest::valid(entry)
