include "../src/io/report_diff.elisa"

extend ReportDiff:
    public:
        def negative_detector_threshold_is_rejected() -> bool:
            ensure not result
            threshold_admitted(-1, 0)

        def fractional_detector_threshold_is_rejected() -> bool:
            ensure not result
            threshold_admitted(5, -1)

        def oversized_detector_exponent_is_rejected() -> bool:
            ensure not result
            threshold_admitted(1, ReportDecimal::Capacity::DIGITS + 1)

        def admitted_detector_threshold_has_integer_scale(coefficient: i64, exponent: i64) -> bool:
            ensure not result or exponent >= 0 and exponent <= ReportDecimal::Capacity::DIGITS
            ensure not result or coefficient >= 0 and coefficient <= Regress::Domain::MAGNITUDE
            threshold_admitted(coefficient, exponent)
