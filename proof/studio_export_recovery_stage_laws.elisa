include "../src/studio/export_recovery_stage_policy.elisa"

module StudioExportRecoveryStageLaws:
    public:
        def json_without_glb_is_invalid() -> bool:
            ensure not result
            StudioExportRecoveryStagePolicy::wire_admitted(2)

        def text_without_glb_is_invalid() -> bool:
            ensure not result
            StudioExportRecoveryStagePolicy::wire_admitted(4)

        def reports_without_glb_are_invalid() -> bool:
            ensure not result
            StudioExportRecoveryStagePolicy::wire_admitted(6)

        def prepared_can_observe_glb() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::transition_admitted(0, 1)

        def json_stage_can_complete() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::transition_admitted(3, 7)

        def text_stage_can_complete() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::transition_admitted(5, 7)

        def json_stage_cannot_forget_json() -> bool:
            ensure not result
            StudioExportRecoveryStagePolicy::transition_admitted(3, 5)

        def complete_cannot_regress() -> bool:
            ensure not result
            StudioExportRecoveryStagePolicy::transition_admitted(7, 1)

        def unknown_stage_cannot_transition(next: i64) -> bool:
            ensure not result
            StudioExportRecoveryStagePolicy::transition_admitted(8, next)
