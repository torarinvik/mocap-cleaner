# Focused laws for routing global shortcuts while a numeric/text draft owns
# keyboard input.
include "../src/studio/shortcuts.elisa"

module StudioShortcutTextLaws:
    public:
        def typing_blocks_plain(action: i64) -> i64:
            requires action == StudioShortcuts::KeyAction.Plain.i64()
            ensure result == StudioShortcuts::KeyAction.Swallow.i64()
            return StudioShortcuts::text_key_route(true, action)

        def typing_blocks_undo(action: i64) -> i64:
            requires action == StudioShortcuts::KeyAction.Undo.i64()
            ensure result == StudioShortcuts::KeyAction.Swallow.i64()
            return StudioShortcuts::text_key_route(true, action)

        def typing_blocks_redo(action: i64) -> i64:
            requires action == StudioShortcuts::KeyAction.Redo.i64()
            ensure result == StudioShortcuts::KeyAction.Swallow.i64()
            return StudioShortcuts::text_key_route(true, action)

        def typing_blocks_file_action(action: i64) -> i64:
            requires action >= StudioShortcuts::FileAction.OpenTake.i64()
            requires action <= StudioShortcuts::FileAction.ExportAs.i64()
            ensure result == StudioShortcuts::FileAction.None.i64()
            return StudioShortcuts::text_file_route(true, action)

        def ordinary_plain_route(action: i64) -> i64:
            requires action >= StudioShortcuts::KeyAction.Plain.i64()
            requires action <= StudioShortcuts::KeyAction.Swallow.i64()
            ensure result == action
            return StudioShortcuts::text_key_route(false, action)

        def ordinary_file_route(action: i64) -> i64:
            requires action >= StudioShortcuts::FileAction.None.i64()
            requires action <= StudioShortcuts::FileAction.ExportAs.i64()
            ensure result == action
            return StudioShortcuts::text_file_route(false, action)
