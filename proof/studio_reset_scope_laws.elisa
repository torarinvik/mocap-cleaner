# Reset buttons expose precise scopes and each operation is one undo entry.
include "../src/studio/reset_scope.elisa"

module StudioResetScopeLaws:
    public:
        def each_known_scope_is_one_history_entry(action: i64) -> bool:
            requires action >= StudioResetScope::Action.REMOVE_OPERATION.i64() and action <= StudioResetScope::Action.RESTORE_SOURCE.i64()
            ensure result
            StudioResetScope::history_entries(action) == 1

        def unknown_scopes_are_disabled(action: i64) -> bool:
            requires action < StudioResetScope::Action.REMOVE_OPERATION.i64() or action > StudioResetScope::Action.RESTORE_SOURCE.i64()
            ensure result
            not StudioResetScope::enabled(action, true, 5, 5, true)

        def remove_one_requires_a_selection() -> bool:
            ensure result
            not StudioResetScope::enabled(StudioResetScope::Action.REMOVE_OPERATION.i64(), false, 3, 2, true)

        def remove_one_changes_only_operations() -> bool:
            ensure result
            StudioResetScope::affects_operations(StudioResetScope::Action.REMOVE_OPERATION.i64()) and not StudioResetScope::affects_contacts(StudioResetScope::Action.REMOVE_OPERATION.i64()) and not StudioResetScope::affects_corrections(StudioResetScope::Action.REMOVE_OPERATION.i64())

        def contact_reset_requires_contacts(count: i64) -> bool:
            requires count >= 0
            ensure result
            StudioResetScope::enabled(StudioResetScope::Action.CLEAR_CONTACTS.i64(), false, count, 0, false) == (count > 0)

        def contact_reset_preserves_other_scopes() -> bool:
            ensure result
            StudioResetScope::affects_contacts(StudioResetScope::Action.CLEAR_CONTACTS.i64()) and not StudioResetScope::affects_operations(StudioResetScope::Action.CLEAR_CONTACTS.i64()) and not StudioResetScope::affects_corrections(StudioResetScope::Action.CLEAR_CONTACTS.i64())

        def correction_reset_requires_corrections(count: i64) -> bool:
            requires count >= 0
            ensure result
            StudioResetScope::enabled(StudioResetScope::Action.CLEAR_CORRECTIONS.i64(), false, 0, count, false) == (count > 0)

        def correction_reset_preserves_other_scopes() -> bool:
            ensure result
            StudioResetScope::affects_corrections(StudioResetScope::Action.CLEAR_CORRECTIONS.i64()) and not StudioResetScope::affects_operations(StudioResetScope::Action.CLEAR_CORRECTIONS.i64()) and not StudioResetScope::affects_contacts(StudioResetScope::Action.CLEAR_CORRECTIONS.i64())

        def restore_source_covers_every_cleanup() -> bool:
            ensure result
            StudioResetScope::affects_all_cleanup(StudioResetScope::Action.RESTORE_SOURCE.i64()) and StudioResetScope::affects_operations(StudioResetScope::Action.RESTORE_SOURCE.i64()) and StudioResetScope::affects_contacts(StudioResetScope::Action.RESTORE_SOURCE.i64()) and StudioResetScope::affects_corrections(StudioResetScope::Action.RESTORE_SOURCE.i64())

        def restore_source_enabled_only_when_dirty(has_cleanup: bool) -> bool:
            ensure result
            StudioResetScope::enabled(StudioResetScope::Action.RESTORE_SOURCE.i64(), false, 0, 0, has_cleanup) == has_cleanup
