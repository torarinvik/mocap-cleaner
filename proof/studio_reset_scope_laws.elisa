# Reset buttons expose precise scopes and each operation is one undo entry.
include "../src/studio/reset_scope.elisa"

module StudioResetScopeLaws:
    public:
        def each_known_scope_is_one_history_entry(action: i64) -> bool:
            requires action >= StudioResetScope::REMOVE_OPERATION and action <= StudioResetScope::RESTORE_SOURCE
            StudioResetScope::history_entries(action) == 1

        def unknown_scopes_are_disabled(action: i64) -> bool:
            requires action < StudioResetScope::REMOVE_OPERATION or action > StudioResetScope::RESTORE_SOURCE
            not StudioResetScope::enabled(action, true, 5, 5, true)

        def remove_one_requires_a_selection() -> bool:
            not StudioResetScope::enabled(StudioResetScope::REMOVE_OPERATION, false, 3, 2, true)

        def remove_one_changes_only_operations() -> bool:
            StudioResetScope::affects_operations(StudioResetScope::REMOVE_OPERATION) and not StudioResetScope::affects_contacts(StudioResetScope::REMOVE_OPERATION) and not StudioResetScope::affects_corrections(StudioResetScope::REMOVE_OPERATION)

        def contact_reset_requires_contacts(count: i64) -> bool:
            requires count >= 0
            StudioResetScope::enabled(StudioResetScope::CLEAR_CONTACTS, false, count, 0, false) == (count > 0)

        def contact_reset_preserves_other_scopes() -> bool:
            StudioResetScope::affects_contacts(StudioResetScope::CLEAR_CONTACTS) and not StudioResetScope::affects_operations(StudioResetScope::CLEAR_CONTACTS) and not StudioResetScope::affects_corrections(StudioResetScope::CLEAR_CONTACTS)

        def correction_reset_requires_corrections(count: i64) -> bool:
            requires count >= 0
            StudioResetScope::enabled(StudioResetScope::CLEAR_CORRECTIONS, false, 0, count, false) == (count > 0)

        def correction_reset_preserves_other_scopes() -> bool:
            StudioResetScope::affects_corrections(StudioResetScope::CLEAR_CORRECTIONS) and not StudioResetScope::affects_operations(StudioResetScope::CLEAR_CORRECTIONS) and not StudioResetScope::affects_contacts(StudioResetScope::CLEAR_CORRECTIONS)

        def restore_source_covers_every_cleanup() -> bool:
            StudioResetScope::affects_all_cleanup(StudioResetScope::RESTORE_SOURCE) and StudioResetScope::affects_operations(StudioResetScope::RESTORE_SOURCE) and StudioResetScope::affects_contacts(StudioResetScope::RESTORE_SOURCE) and StudioResetScope::affects_corrections(StudioResetScope::RESTORE_SOURCE)

        def restore_source_enabled_only_when_dirty(has_cleanup: bool) -> bool:
            StudioResetScope::enabled(StudioResetScope::RESTORE_SOURCE, false, 0, 0, has_cleanup) == has_cleanup
