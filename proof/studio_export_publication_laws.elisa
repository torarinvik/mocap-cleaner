include "../src/studio/export_publication_policy.elisa"

module StudioExportPublicationLaws:
    public:
        def both_sidecars_complete() -> StudioExportPublicationPolicy::Outcome:
            ensure result == StudioExportPublicationPolicy::Outcome.Complete
            StudioExportPublicationPolicy::sidecar_outcome(true, true)

        def json_only_is_partial() -> StudioExportPublicationPolicy::Outcome:
            ensure result == StudioExportPublicationPolicy::Outcome.GlbAndJson
            StudioExportPublicationPolicy::sidecar_outcome(true, false)

        def text_only_is_partial() -> StudioExportPublicationPolicy::Outcome:
            ensure result == StudioExportPublicationPolicy::Outcome.GlbAndText
            StudioExportPublicationPolicy::sidecar_outcome(false, true)

        def no_sidecars_is_partial() -> StudioExportPublicationPolicy::Outcome:
            ensure result == StudioExportPublicationPolicy::Outcome.GlbOnly
            StudioExportPublicationPolicy::sidecar_outcome(false, false)

        def json_only_is_incomplete() -> bool:
            ensure not result
            StudioExportPublicationPolicy::reports_complete(StudioExportPublicationPolicy::Outcome.GlbAndJson)

        def text_only_is_incomplete() -> bool:
            ensure not result
            StudioExportPublicationPolicy::reports_complete(StudioExportPublicationPolicy::Outcome.GlbAndText)

        def glb_only_is_incomplete() -> bool:
            ensure not result
            StudioExportPublicationPolicy::reports_complete(StudioExportPublicationPolicy::Outcome.GlbOnly)
