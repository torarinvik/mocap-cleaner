include "../src/physics/length_boundary.elisa"

module PhysicsLengthBoundaryLaws:
    public:
        def positive_coordinate_boundary() -> bool:
            ensure result
            PhysicsLengthBoundary::from_micrometres(PhysicsLengthBoundary::Domain::MAX_INPUT_MICROMETRES) == PhysicsLengthBoundary::Domain::MAX_COORDINATE

        def negative_coordinate_boundary() -> bool:
            ensure result
            PhysicsLengthBoundary::from_micrometres(-PhysicsLengthBoundary::Domain::MAX_INPUT_MICROMETRES) == -PhysicsLengthBoundary::Domain::MAX_COORDINATE

        def outside_coordinate_domain_refused(value: i64) -> bool:
            requires value < -PhysicsLengthBoundary::Domain::MAX_INPUT_MICROMETRES or value > PhysicsLengthBoundary::Domain::MAX_INPUT_MICROMETRES
            ensure result
            not PhysicsLengthBoundary::input_admitted(value)

        def rounded_error_bounded(value: i64) -> bool:
            requires PhysicsLengthBoundary::input_admitted(value)
            ensure result
            units: i64 = PhysicsLengthBoundary::from_micrometres(value)
            restored: i64 = PhysicsLengthBoundary::report_micrometres(units)
            restored - value >= -LengthUnits::Scale::HALF_UNIT and restored - value <= LengthUnits::Scale::HALF_UNIT

        def gravity_bound_keeps_physical_scale() -> bool:
            ensure result
            PhysicsLengthBoundary::report_micrometres(PhysicsLengthBoundary::Domain::MAX_GRAVITY_STEP) == 1000000

        def unrepresentable_report_refused(value: i64) -> bool:
            requires value < LengthUnits::Scale::MIN_EXPORT_UNITS or value > LengthUnits::Scale::MAX_EXPORT_UNITS
            ensure result
            not PhysicsLengthBoundary::report_admitted(value)
