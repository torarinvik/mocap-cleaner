include "../src/physics/length_boundary.elisa"

module PhysicsLengthBoundaryLaws:
    public:
        def world_positive_half_unit_rounds_outward() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(0.00005) == 1

        def world_negative_half_unit_rounds_outward() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(-0.00005) == -1

        def world_sub_half_unit_rounds_to_zero(value: f64) -> bool:
            requires value > -0.00005
            requires value < 0.00005
            requires PhysicsLengthBoundary::world_admitted(value)
            ensure result
            PhysicsLengthBoundary::from_metres(value) == 0

        def world_inverse_recovers_supported_coordinate(value: i64) -> bool:
            requires value >= -PhysicsLengthBoundary::Domain::MAX_COORDINATE
            requires value <= PhysicsLengthBoundary::Domain::MAX_COORDINATE
            ensure result
            PhysicsLengthBoundary::from_metres(PhysicsLengthBoundary::metres(value)) == value

        def positive_coordinate_boundary() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(PhysicsLengthBoundary::Domain::MAX_METRES) == PhysicsLengthBoundary::Domain::MAX_COORDINATE

        def negative_coordinate_boundary() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(-PhysicsLengthBoundary::Domain::MAX_METRES) == -PhysicsLengthBoundary::Domain::MAX_COORDINATE

        def nonfinite_world_refused(value: f64) -> bool:
            requires value - value != 0.0
            ensure result
            not PhysicsLengthBoundary::world_admitted(value)

        def outside_world_domain_refused(value: f64) -> bool:
            requires value < -PhysicsLengthBoundary::Domain::MAX_METRES or value > PhysicsLengthBoundary::Domain::MAX_METRES
            ensure result
            not PhysicsLengthBoundary::world_admitted(value)

        def speed_keeps_per_second_scale(value: f64) -> bool:
            requires PhysicsLengthBoundary::world_admitted(value)
            ensure result
            PhysicsLengthBoundary::speed_from_metres_per_second(value) == PhysicsLengthBoundary::from_metres(value)

        def gravity_keeps_per_frame_squared_scale(value: f64) -> bool:
            requires PhysicsLengthBoundary::world_admitted(value)
            ensure result
            PhysicsLengthBoundary::gravity_from_metres_per_frame_squared(value) == PhysicsLengthBoundary::from_metres(value)

        def report_preserves_physical_units(value: i64) -> bool:
            requires PhysicsLengthBoundary::report_admitted(value)
            ensure result
            PhysicsLengthBoundary::report_micrometres(value) / LengthUnits::Scale::MICROMETRES_PER_UNIT == value

        def gravity_bound_keeps_physical_scale() -> bool:
            ensure result
            PhysicsLengthBoundary::report_micrometres(PhysicsLengthBoundary::Domain::MAX_GRAVITY_STEP) == 1000000

        def unrepresentable_report_refused(value: i64) -> bool:
            requires value < LengthUnits::Scale::MIN_EXPORT_UNITS or value > LengthUnits::Scale::MAX_EXPORT_UNITS
            ensure result
            not PhysicsLengthBoundary::report_admitted(value)

        def report_sum_bound_is_checked(current: i64, addition: i64) -> bool:
            requires current >= 0
            requires addition >= 0
            requires PhysicsLengthBoundary::report_admitted(current)
            requires PhysicsLengthBoundary::report_admitted(addition)
            ensure result
            PhysicsLengthBoundary::report_sum_admitted(current, addition) == (current <= LengthUnits::Scale::MAX_EXPORT_UNITS - addition)

        def report_sum_overflow_is_refused(current: i64, addition: i64) -> bool:
            requires current >= 0
            requires addition >= 0
            requires PhysicsLengthBoundary::report_admitted(current)
            requires PhysicsLengthBoundary::report_admitted(addition)
            requires current > LengthUnits::Scale::MAX_EXPORT_UNITS - addition
            ensure result
            not PhysicsLengthBoundary::report_sum_admitted(current, addition)
