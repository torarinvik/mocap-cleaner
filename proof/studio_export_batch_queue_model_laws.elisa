include "../src/studio/export_batch_queue.elisa"

module StudioExportBatchQueueModelLaws:
    public:
        def created_queue_is_empty() -> bool:
            ensure result
            queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::valid(queue) and StudioExportBatchQueue::counts(queue) == StudioExportBatchQueuePolicy::Aggregate.NotStarted

        def invalid_preflight_preserves_empty_queue() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            admitted: bool = StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.SourceUnavailable)
            not admitted and StudioExportBatchQueue::item_count(queue) == 0 and StudioExportBatchQueue::valid(queue)

        def one_worker_limits_launches() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            first: i64 = StudioExportBatchQueue::launch_next(&queue)
            second: i64 = StudioExportBatchQueue::launch_next(&queue)
            first == 0 and second == -1 and StudioExportBatchQueue::worker_count(queue) == 1 and StudioExportBatchQueue::valid(queue)

        def cancellation_preserves_running_work() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::launch_next(&queue)
            cancelled: i64 = StudioExportBatchQueue::cancel(&queue)
            resumed: bool = StudioExportBatchQueue::resume(&queue)
            cancelled == 1 and not resumed and StudioExportBatchQueue::cancelled(queue) and StudioExportBatchQueue::worker_count(queue) == 1 and StudioExportBatchQueue::item(queue, 0).state == StudioExportBatchQueuePolicy::ItemState.Running and StudioExportBatchQueue::item(queue, 1).state == StudioExportBatchQueuePolicy::ItemState.Cancelled

        def cancelled_input_retries_then_resumes() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::cancel(&queue)
            retried: bool = StudioExportBatchQueue::retry(&queue, 0, StudioExportBatchPreflightPolicy::Outcome.Ready)
            paused_launch: i64 = StudioExportBatchQueue::launch_next(&queue)
            resumed: bool = StudioExportBatchQueue::resume(&queue)
            launched: i64 = StudioExportBatchQueue::launch_next(&queue)
            retried and paused_launch == -1 and resumed and launched == 0 and StudioExportBatchQueue::valid(queue)

        def pause_retains_queued_work_until_resume() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            paused: bool = StudioExportBatchQueue::pause(&queue)
            held: i64 = StudioExportBatchQueue::launch_next(&queue)
            retained: bool = StudioExportBatchQueue::item(queue, 0).state == StudioExportBatchQueuePolicy::ItemState.Queued
            resumed: bool = StudioExportBatchQueue::resume(&queue)
            launched: i64 = StudioExportBatchQueue::launch_next(&queue)
            paused and held == -1 and retained and resumed and launched == 0 and StudioExportBatchQueue::valid(queue)

        def pause_drains_active_work_before_resume() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::launch_next(&queue)
            paused: bool = StudioExportBatchQueue::pause(&queue)
            held: i64 = StudioExportBatchQueue::launch_next(&queue)
            early_resume: bool = StudioExportBatchQueue::resume(&queue)
            StudioExportBatchQueue::complete(&queue, 0, true, true, 0)
            drained_resume: bool = StudioExportBatchQueue::resume(&queue)
            launched: i64 = StudioExportBatchQueue::launch_next(&queue)
            paused and held == -1 and not early_resume and drained_resume and launched == 1 and StudioExportBatchQueue::valid(queue)

        def reviewed_warning_does_not_need_second_approval() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::launch_next(&queue)
            StudioExportBatchQueue::complete(&queue, 0, true, true, 1)
            published: bool = StudioExportBatchQueue::publish(&queue, 0, true, true, true)
            published and StudioExportBatchQueue::item(queue, 0).approved and StudioExportBatchQueue::counts(queue) == StudioExportBatchQueuePolicy::Aggregate.CompleteWithWarnings

        def successful_output_cannot_be_retried() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::launch_next(&queue)
            StudioExportBatchQueue::complete(&queue, 0, true, true, 0)
            StudioExportBatchQueue::publish(&queue, 0, false, true, true)
            retried: bool = StudioExportBatchQueue::retry(&queue, 0, StudioExportBatchPreflightPolicy::Outcome.Ready)
            not retried and StudioExportBatchQueue::item(queue, 0).state == StudioExportBatchQueuePolicy::ItemState.Passed

        def journal_failure_releases_running_slot_as_recoverable() -> bool:
            ensure result
            mutable queue: StudioExportBatchQueue::Queue = StudioExportBatchQueue::create(1)
            StudioExportBatchQueue::enqueue(&queue, StudioExportBatchPreflightPolicy::Outcome.Ready)
            StudioExportBatchQueue::launch_next(&queue)
            recovered: bool = StudioExportBatchQueue::mark_recoverable(&queue, 0, 0)
            recovered and StudioExportBatchQueue::worker_count(queue) == 0 and StudioExportBatchQueue::item(queue, 0).state == StudioExportBatchQueuePolicy::ItemState.Recoverable and StudioExportBatchQueue::valid(queue)
