include "../src/io/json_string.elisa"

module JsonStringLaws:
    public:
        def short_hex_is_unavailable(text: darray[u8]&, start: usize, stop: usize) -> i64:
            requires stop <= text.count
            requires start <= stop
            requires stop - start < 4
            ensure result == -1
            JsonString::hex4(text, start, stop)

        def empty_content_is_valid(text: darray[u8]&, at: usize, out: mutable darray[u8]&) -> bool:
            requires at <= text.count
            ensure result
            JsonString::decode(text, at, at, out)
