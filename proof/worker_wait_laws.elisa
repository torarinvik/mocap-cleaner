include "../src/io/worker_wait_policy.elisa"

module WorkerWaitPolicyLaws:
    public:
        def interrupted_wait_retries() -> bool:
            ensure result
            WorkerWaitPolicy::action(-1, WorkerWaitPolicy::Posix::EINTR) == WorkerWaitPolicy::Action.Retry

        def non_interrupted_error_fails(error_number: i64) -> bool:
            requires error_number != WorkerWaitPolicy::Posix::EINTR
            ensure result
            WorkerWaitPolicy::action(-1, error_number) == WorkerWaitPolicy::Action.Failed

        def positive_pid_reaps(pid: i64, error_number: i64) -> bool:
            requires pid > 0
            ensure result
            WorkerWaitPolicy::action(pid, error_number) == WorkerWaitPolicy::Action.Reaped

        def zero_result_fails(error_number: i64) -> bool:
            ensure result
            WorkerWaitPolicy::action(0, error_number) == WorkerWaitPolicy::Action.Failed

        def failed_wait_does_not_consume_slot(running: i64) -> bool:
            requires running >= 0
            ensure result
            WorkerWaitPolicy::remaining(running, false) == running

        def reaped_child_consumes_one(running: i64) -> bool:
            requires running > 0
            ensure result
            WorkerWaitPolicy::remaining(running, true) == running - 1

        def successful_completion_requires_reaped(status: i64) -> bool:
            ensure result
            not WorkerWaitPolicy::completion_ok(false, status)

        def successful_completion_requires_zero_status(reaped: bool) -> bool:
            ensure result
            not WorkerWaitPolicy::completion_ok(reaped, 1)
