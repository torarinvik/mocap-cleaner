include "../src/studio/export_batch_recipe_codec.elisa"

module StudioExportBatchRecipeCodecLaws:
    public:
        def empty_stack_has_valid_canonical_recipe() -> bool can Memory.Allocate:
            ensure result
            mutable recipe: StackState::Stack = StackState::empty()
            mutable bytes: darray[u8] = []
            encoded: bool = StudioExportBatchRecipeCodec::encode(recipe, 1, 1, &bytes)
            encoded and StudioExportBatchRecipeCodec::valid_bytes(bytes)

        def recipe_rejects_zero_frame_or_node_domains() -> bool:
            ensure result
            recipe: StackState::Stack = StackState::empty()
            not StudioExportBatchRecipeCodec::valid_stack(recipe, 0, 1) and not StudioExportBatchRecipeCodec::valid_stack(recipe, 1, 0)

        def correction_binary32_negative_zero_bits_are_preserved() -> bool can[Memory.Allocate, Unsafe.PointerCast]:
            ensure result
            mutable recipe: StackState::Stack = StackState::empty()
            recipe.fixes[0] <- Corrections::Correction{enabled: true, node: 0, key: 0, first: 0, last: 0,
                rotation: Geometry::Quat{x: 0.0, y: 0.0, z: 0.0, w: 1.0},
                translation: Geometry::Vec3{x: -0.0, y: 0.0, z: 0.0}}
            recipe.fix_count <- 1
            mutable bytes: darray[u8] = []
            encoded: bool = StudioExportBatchRecipeCodec::encode(recipe, 1, 1, &bytes)
            preserved: i64 = StudioExportBatchRecipeCodec::correction_component_bits(bytes, 0, 4)
            encoded and preserved == StudioExportBatchRecipeCodec::binary32_bits(-0.0).i64()
