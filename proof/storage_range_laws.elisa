include "../src/core/storage_range_policy.elisa"

module StorageRangeLaws:
    public:
        def zero_components_refused(bytes: usize, start: usize, count: usize) -> bool:
            ensure result
            if StorageRangePolicy::float_span_length(bytes, start, count, 0) is length:
                return false
            true

        def start_past_end_refused(bytes: usize, start: usize, count: usize, components: usize) -> bool:
            requires start > bytes
            ensure result
            if StorageRangePolicy::float_span_length(bytes, start, count, components) is length:
                return false
            true

        def oversized_span_refused(bytes: usize, start: usize, count: usize, components: usize) -> bool:
            requires start <= bytes and components > 0
            requires count > ((bytes - start) / StorageRangePolicy::FloatLayout::COMPONENT_BYTES) / components
            ensure result
            if StorageRangePolicy::float_span_length(bytes, start, count, components) is length:
                return false
            true

        def admitted_span_fits(bytes: usize, start: usize, count: usize, components: usize) -> bool:
            requires start <= bytes and components > 0
            requires count <= ((bytes - start) / StorageRangePolicy::FloatLayout::COMPONENT_BYTES) / components
            ensure result
            if StorageRangePolicy::float_span_length(bytes, start, count, components) is length:
                return length == count * components * StorageRangePolicy::FloatLayout::COMPONENT_BYTES and length <= bytes - start
            false

        def empty_left_does_not_overlap(a: usize, b: usize, length: usize) -> bool:
            ensure result
            not StorageRangePolicy::overlaps(a, 0, b, length)

        def empty_right_does_not_overlap(a: usize, length: usize, b: usize) -> bool:
            ensure result
            not StorageRangePolicy::overlaps(a, length, b, 0)

        def same_nonempty_start_overlaps(a: usize, left: usize, right: usize) -> bool:
            requires left > 0 and right > 0
            ensure result
            StorageRangePolicy::overlaps(a, left, a, right)

        def separated_right_does_not_overlap(a: usize, length: usize, b: usize, right: usize) -> bool:
            requires a <= b
            requires b - a >= length
            ensure result
            not StorageRangePolicy::overlaps(a, length, b, right)

        def separated_left_does_not_overlap(a: usize, left: usize, b: usize, length: usize) -> bool:
            requires b < a
            requires a - b >= length
            ensure result
            not StorageRangePolicy::overlaps(a, left, b, length)

        def interior_right_overlaps(a: usize, length: usize, b: usize, right: usize) -> bool:
            requires a <= b and length > 0 and right > 0
            requires b - a < length
            ensure result
            StorageRangePolicy::overlaps(a, length, b, right)
