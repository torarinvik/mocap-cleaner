# Range-retime laws: the output-to-source time map is strictly monotone, its
# endpoints are exact, it is identity plus a shift outside every range, a
# speed of 1x is the identity, speeds compose and the per-frame inverse is
# consistent with the forward map, and the blend joins the outside step
# continuously at both range edges. Composed from Retime's summaries.
include "../src/core/retime.elisa"

module RetimeLaws:
    public:
        # Monotone: every output frame moves source time strictly forward,
        # by at least the minimum speed.
        def monotone(time: i64, speed: i64, amount: i64) -> i64:
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            requires amount >= 0
            requires amount <= Retime::TimeScale::UNIT
            ensure result > time
            ensure result >= time + Retime::Rate::MIN_RATE
            ensure result <= time + Retime::Rate::MAX_RATE
            delta: i64 = Retime::step(speed, amount)
            return Retime::advance(time, delta)

        # Monotone through a whole range step, whatever the blend.
        def range_monotone(time: i64, start: i64, stop: i64, speed: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result > time
            delta: i64 = Retime::range_step(time, start, stop, speed, blend)
            return Retime::advance(time, delta)

        # Exact end: a time at or past the source end lands on it.
        def end_exact(time: i64, end: i64) -> i64:
            requires time >= end
            requires end >= 0
            ensure result == end
            return Retime::land(time, end)

        # Before the end, landing leaves the time alone.
        def before_end_untouched(time: i64, end: i64) -> i64:
            requires time >= 0
            requires time < end
            ensure result == time
            return Retime::land(time, end)

        # Exact start: the first output frame is source frame 0.
        def start_exact() -> i64:
            ensure result == 0
            return Retime::frame_of(0)

        # The first sample has no fraction.
        def start_whole() -> i64:
            ensure result >= 0
            ensure result < Retime::TimeScale::UNIT
            return Retime::fraction_of(0)

        # Outside a range (before it) the step is a whole frame.
        def identity_before(time: i64, start: i64, stop: i64, speed: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time >= 0
            requires time < start
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == Retime::TimeScale::UNIT
            return Retime::range_step(time, start, stop, speed, blend)

        # Outside a range (after it) the step is a whole frame.
        def identity_after(time: i64, start: i64, stop: i64, speed: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time > stop
            requires time <= Retime::Domain::MAX_TIME
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == Retime::TimeScale::UNIT
            return Retime::range_step(time, start, stop, speed, blend)

        # Outside a range the next output frame is the shifted source frame.
        def identity_plus_shift(time: i64, start: i64, stop: i64, speed: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time > stop
            requires time <= Retime::Domain::MAX_TIME
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == time + Retime::TimeScale::UNIT
            delta: i64 = Retime::range_step(time, start, stop, speed, blend)
            return Retime::advance(time, delta)

        # A shift by zero frames is the identity.
        def shift_zero(time: i64) -> i64:
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            ensure result == time
            return Retime::shifted(time, 0)

        # A shift moves by whole frames.
        def shift_whole(time: i64, frames: i64) -> i64:
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            requires frames >= 0
            requires frames <= Retime::Domain::MAX_FRAMES
            ensure result == time + frames * Retime::TimeScale::UNIT
            ensure result >= time
            return Retime::shifted(time, frames)

        # 1x is the identity: the step is a whole frame at any weight.
        def unit_speed_identity(amount: i64) -> i64:
            requires amount >= 0
            requires amount <= Retime::TimeScale::UNIT
            ensure result == Retime::TimeScale::UNIT
            return Retime::step(Retime::TimeScale::UNIT, amount)

        # 1x is the identity over a whole range, edges and blend included.
        def unit_range_identity(time: i64, start: i64, stop: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            ensure result == time + Retime::TimeScale::UNIT
            delta: i64 = Retime::range_step(time, start, stop, Retime::TimeScale::UNIT, blend)
            return Retime::advance(time, delta)

        # 1x keeps a span's length.
        def unit_span_identity(frames: i64) -> i64:
            requires frames >= 0
            requires frames <= Retime::Domain::MAX_FRAMES
            ensure result == frames
            return Retime::span_frames(frames, Retime::TimeScale::UNIT)

        # An empty span stays empty at any speed.
        def empty_span(speed: i64) -> i64:
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == 0
            return Retime::span_frames(0, speed)

        # Composition: 1x is a left unit.
        def compose_left_unit(speed: i64) -> i64:
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == speed
            return Retime::compose(Retime::TimeScale::UNIT, speed)

        # Composition: 1x is a right unit.
        def compose_right_unit(speed: i64) -> i64:
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == speed
            return Retime::compose(speed, Retime::TimeScale::UNIT)

        # Composition stays a valid speed.
        def compose_valid(outer: i64, inner: i64) -> i64:
            requires outer >= Retime::Rate::MIN_RATE
            requires outer <= Retime::Rate::MAX_RATE
            requires inner >= Retime::Rate::MIN_RATE
            requires inner <= Retime::Rate::MAX_RATE
            ensure result >= Retime::Rate::MIN_RATE
            ensure result <= Retime::Rate::MAX_RATE
            return Retime::compose(outer, inner)

        # Inversion at the left sample: forward(invert(before)) == before.
        def invert_left(before: i64, after: i64) -> i64:
            requires before >= 0
            requires after > before
            requires after <= Retime::Domain::MAX_TIME
            ensure result == before
            part: i64 = Retime::invert_between(before, after, before)
            return Retime::forward_between(before, after, part)

        # Inversion at the right sample: forward(invert(after)) == after.
        def invert_right(before: i64, after: i64) -> i64:
            requires before >= 0
            requires after > before
            requires after <= Retime::Domain::MAX_TIME
            ensure result == after
            part: i64 = Retime::invert_between(before, after, after)
            return Retime::forward_between(before, after, part)

        # Inversion inside a frame lands back between the two samples.
        def invert_between_bounded(before: i64, after: i64, time: i64) -> i64:
            requires before >= 0
            requires after > before
            requires after <= Retime::Domain::MAX_TIME
            requires time >= before
            requires time <= after
            ensure result >= before
            ensure result <= after
            part: i64 = Retime::invert_between(before, after, time)
            return Retime::forward_between(before, after, part)

        # Blend continuity at the range start: the step equals the outside
        # step (a whole frame) exactly on the edge.
        def blend_continuous_start(start: i64, stop: i64, speed: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires blend >= 1
            requires blend <= Retime::Domain::MAX_BLEND
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == Retime::TimeScale::UNIT
            return Retime::range_step(start, start, stop, speed, blend)

        # Blend continuity at the range end.
        def blend_continuous_stop(start: i64, stop: i64, speed: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires blend >= 1
            requires blend <= Retime::Domain::MAX_BLEND
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == Retime::TimeScale::UNIT
            return Retime::range_step(stop, start, stop, speed, blend)

        # The blended step never leaves the interval between 1x and the speed
        # (slowing down).
        def blend_between_slow(speed: i64, amount: i64) -> i64:
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::TimeScale::UNIT
            requires amount >= 0
            requires amount <= Retime::TimeScale::UNIT
            ensure result >= speed
            ensure result <= Retime::TimeScale::UNIT
            return Retime::step(speed, amount)

        # The blended step never leaves the interval between 1x and the speed
        # (speeding up).
        def blend_between_fast(speed: i64, amount: i64) -> i64:
            requires speed >= Retime::TimeScale::UNIT
            requires speed <= Retime::Rate::MAX_RATE
            requires amount >= 0
            requires amount <= Retime::TimeScale::UNIT
            ensure result >= Retime::TimeScale::UNIT
            ensure result <= speed
            return Retime::step(speed, amount)

        # A full weight reaches the requested speed.
        def blend_reaches_speed(speed: i64) -> i64:
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == speed
            return Retime::step(speed, Retime::TimeScale::UNIT)

        # The weight is a permille fraction everywhere.
        def weight_in_permille(time: i64, start: i64, stop: i64, blend: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            ensure result >= 0
            ensure result <= Retime::TimeScale::UNIT
            return Retime::range_weight(time, start, stop, blend)

        # Without a blend the whole range runs at the speed.
        def unblended_full(time: i64, start: i64, stop: i64, speed: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            requires time >= start
            requires time <= stop
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == speed
            return Retime::range_step(time, start, stop, speed, 0)

        # Ranges that overlap are rejected; disjoint ones are accepted.
        def overlap_rejected(first: i64, last: i64) -> bool:
            requires first >= 0
            requires first < last
            ensure not result
            return Retime::disjoint(first, last, first, last)

        def apart_accepted(first: i64, last: i64, other: i64) -> bool:
            requires first >= 0
            requires first < last
            requires other > last
            ensure result
            return Retime::disjoint(first, last, other, other + 1)

        # Speeds are clamped into the supported 0.1x .. 4x.
        def clamped_speed_ok(speed: i64) -> bool:
            ensure result
            value: i64 = Retime::clamp_speed(speed)
            return Retime::speed_ok(value)

        # A range edge distance is zero on both edges.
        def edges_have_no_distance(start: i64, stop: i64) -> i64:
            requires start >= 0
            requires start < stop
            requires stop <= Retime::Domain::MAX_TIME
            ensure result == 0
            return Retime::range_distance(start, start, stop)

        # Milli-frame times of frames stay within the time bound.
        def frame_time_bounded(frame: i64) -> i64:
            requires frame >= 0
            requires frame <= Retime::Domain::MAX_FRAMES
            ensure result >= 0
            ensure result <= Retime::Domain::MAX_TIME
            return Retime::time_of(frame)

        # Range close-out: the samples taken inside a range are squeezed back
        # onto it. The range's start stays put, its last sample lands
        # exactly on the range end, and nothing leaves [start, stop].
        def rescale_start_fixed(start: i64, reached: i64, stop: i64) -> i64:
            requires start >= 0
            requires stop > start
            requires reached >= stop
            requires reached <= Retime::Domain::MAX_TIME
            ensure result == start
            return Retime::rescale(start, start, reached, stop)

        def rescale_end_exact(start: i64, reached: i64, stop: i64) -> i64:
            requires start >= 0
            requires stop > start
            requires reached >= stop
            requires reached <= Retime::Domain::MAX_TIME
            ensure result == stop
            return Retime::rescale(reached, start, reached, stop)

        def rescale_inside(time: i64, start: i64, reached: i64, stop: i64) -> i64:
            requires start >= 0
            requires stop > start
            requires reached >= stop
            requires reached <= Retime::Domain::MAX_TIME
            requires time >= start
            requires time <= reached
            ensure result >= start
            ensure result <= stop
            return Retime::rescale(time, start, reached, stop)

        # Landing never passes the source end and leaves earlier times alone.
        def land_bounded(time: i64, end: i64) -> i64:
            requires time >= 0
            requires end >= 0
            ensure result <= end
            ensure time > end or result == time
            return Retime::land(time, end)

        # Advance then land: still forward unless already at the end.
        def advance_land_forward(time: i64, delta: i64, end: i64) -> i64:
            requires time >= 0
            requires time < end
            requires end <= Retime::Domain::MAX_TIME
            requires delta >= Retime::Rate::MIN_RATE
            requires delta <= Retime::Rate::MAX_RATE
            ensure result > time
            ensure result <= end
            return Retime::land(Retime::advance(time, delta), end)

        # Inversion endpoints round-trip through the forward map.
        def round_trip_left(before: i64, after: i64) -> i64:
            requires before >= 0
            requires after > before
            requires after <= Retime::Domain::MAX_TIME
            ensure result == before
            part: i64 = Retime::invert_between(before, after, before)
            return Retime::forward_between(before, after, part)

        def round_trip_right(before: i64, after: i64) -> i64:
            requires before >= 0
            requires after > before
            requires after <= Retime::Domain::MAX_TIME
            ensure result == after
            part: i64 = Retime::invert_between(before, after, after)
            return Retime::forward_between(before, after, part)

        # A clamped speed is a valid speed and keeps valid speeds.
        def clamp_keeps_valid(speed: i64) -> i64:
            requires speed >= Retime::Rate::MIN_RATE
            requires speed <= Retime::Rate::MAX_RATE
            ensure result == speed
            return Retime::clamp_speed(speed)

        def clamp_blend_keeps_valid(blend: i64) -> i64:
            requires blend >= 0
            requires blend <= Retime::Domain::MAX_BLEND
            ensure result == blend
            return Retime::clamp_blend(blend)

        # Frame and fraction split a time: the frame is never past it.
        def frame_not_past(time: i64) -> i64:
            requires time >= 0
            requires time <= Retime::Domain::MAX_TIME
            ensure result <= time
            ensure result >= 0
            return Retime::frame_of(time)
