include "../src/studio/timeline_goto_focus.elisa"

module StudioTimelineGotoFocusLaws:
    public:
        def forward_field() -> bool:
            ensure result
            StudioTimelineGotoFocus::next(StudioTimelineGotoFocus::Control.Field, false) == StudioTimelineGotoFocus::Control.Apply

        def forward_apply() -> bool:
            ensure result
            StudioTimelineGotoFocus::next(StudioTimelineGotoFocus::Control.Apply, false) == StudioTimelineGotoFocus::Control.Cancel

        def forward_cancel_wraps() -> bool:
            ensure result
            StudioTimelineGotoFocus::next(StudioTimelineGotoFocus::Control.Cancel, false) == StudioTimelineGotoFocus::Control.Field

        def reverse_field_wraps() -> bool:
            ensure result
            StudioTimelineGotoFocus::next(StudioTimelineGotoFocus::Control.Field, true) == StudioTimelineGotoFocus::Control.Cancel

        def reverse_apply() -> bool:
            ensure result
            StudioTimelineGotoFocus::next(StudioTimelineGotoFocus::Control.Apply, true) == StudioTimelineGotoFocus::Control.Field

        def reverse_cancel() -> bool:
            ensure result
            StudioTimelineGotoFocus::next(StudioTimelineGotoFocus::Control.Cancel, true) == StudioTimelineGotoFocus::Control.Apply
