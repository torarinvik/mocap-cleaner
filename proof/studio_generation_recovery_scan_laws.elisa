include "../src/studio/state/generation_recovery_scan_policy.elisa"

module StudioGenerationRecoveryScanLaws:
    public:
        def stale_scan_ticket_refuses_restore(index: i64, newer_ticket: i64) -> bool:
            requires index >= 0 and newer_ticket > 1
            ensure not StudioGenerationRecoveryScanPolicy::restore_admitted(newer_ticket - 1, newer_ticket, index, index, true, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)
            StudioGenerationRecoveryScanPolicy::restore_admitted(newer_ticket - 1, newer_ticket, index, index, true, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)

        def changed_selection_refuses_restore(ticket: i64, index: i64) -> bool:
            requires ticket > 0 and index >= 0
            ensure not StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index + 1, true, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)
            StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index + 1, true, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)

        def same_index_replaced_identity_refuses_restore(ticket: i64, index: i64) -> bool:
            requires ticket > 0 and index >= 0
            ensure not StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, false, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)
            StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, false, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)

        def changed_build_root_refuses_restore(ticket: i64, index: i64) -> bool:
            requires ticket > 0 and index >= 0
            ensure not StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, true, false, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)
            StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, true, false, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true)

        def unresolved_recovery_outcomes_refuse_restore(ticket: i64, index: i64,
            outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome) -> bool:
            requires ticket > 0 and index >= 0
            requires outcome != StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined
            ensure not StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, true, true, outcome, true)
            StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, true, true, outcome, true)

        def missing_native_details_refuse_restore(ticket: i64, index: i64) -> bool:
            requires ticket > 0 and index >= 0
            ensure not StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, true, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, false)
            StudioGenerationRecoveryScanPolicy::restore_admitted(ticket, ticket, index, index, true, true, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, false)
