include "../src/studio/storage_filter_selection_policy.elisa"

module StudioStorageFilterSelectionLaws:
    public:
        def all_selected_are_visible(complete: i64, visible: i64, selected: i64) -> i64:
            requires complete >= 0 and complete <= StudioStorageTotalsKernel::Capacity::MAX_ITEMS
            requires visible >= 0 and visible <= complete
            requires selected >= 0 and selected <= visible
            ensure result == 0
            StudioStorageFilterSelectionPolicy::hidden_selected(complete, visible, selected, selected)

        def all_rows_hidden(complete: i64, selected: i64) -> i64:
            requires complete >= 0 and complete <= StudioStorageTotalsKernel::Capacity::MAX_ITEMS
            requires selected >= 0 and selected <= complete
            ensure result == selected
            StudioStorageFilterSelectionPolicy::hidden_selected(complete, 0, selected, 0)

        def impossible_hidden_selection_is_invalid() -> bool:
            ensure not result
            StudioStorageFilterSelectionPolicy::valid_counts(5, 4, 3, 1)

        def excess_visible_selection_is_invalid() -> bool:
            ensure not result
            StudioStorageFilterSelectionPolicy::valid_counts(5, 2, 4, 3)

        def empty_inventory_is_valid() -> bool:
            ensure result
            StudioStorageFilterSelectionPolicy::valid_counts(0, 0, 0, 0)
