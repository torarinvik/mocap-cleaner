# Footing laws: detection never sees a rolling foot as faster than its
# slower point, and a settled anchor stays inside the run it holds.
include "../src/core/footing.elisa"

module FootingLaws:
    public:
        # A still heel keeps the foot planted whatever the ball does.
        def still_heel_is_still(ball: i64) -> i64:
            requires ball >= 0
            requires ball <= Footing::LIMIT
            ensure result == 0
            return Footing::contact_speed(0, ball)

        # A still ball keeps the foot planted whatever the heel does.
        def still_ball_is_still(heel: i64) -> i64:
            requires heel >= 0
            requires heel <= Footing::LIMIT
            ensure result == 0
            return Footing::contact_speed(heel, 0)

        # Both points moving equally: that is the speed.
        def equal_points(speed: i64) -> i64:
            requires speed >= 0
            requires speed <= Footing::LIMIT
            ensure result == speed
            return Footing::contact_speed(speed, speed)

        # Symmetric in heel and ball.
        def symmetric(heel: i64, ball: i64) -> bool:
            requires heel >= 0
            requires heel <= Footing::LIMIT
            requires ball >= 0
            requires ball <= Footing::LIMIT
            ensure result
            return Footing::contact_speed(heel, ball) == Footing::contact_speed(ball, heel)

        # A run that never moved holds exactly where it stood.
        def still_run_anchor(value: i64) -> i64:
            requires value >= -Footing::LIMIT
            requires value <= Footing::LIMIT
            ensure result == value
            return Footing::settled(value, value, value)

        # The anchor never leaves the run's range.
        def anchor_in_range(middle: i64, low: i64, high: i64) -> i64:
            requires low <= high
            requires low >= -Footing::LIMIT
            requires high <= Footing::LIMIT
            ensure result >= low
            ensure result <= high
            return Footing::settled(middle, low, high)

        # Settling is idempotent.
        def settle_twice(middle: i64, low: i64, high: i64) -> bool:
            requires low <= high
            requires low >= -Footing::LIMIT
            requires high <= Footing::LIMIT
            ensure result
            once: i64 = Footing::settled(middle, low, high)
            return Footing::settled(once, low, high) == once

        # A hold is full on its planted run.
        def carry_full_at_plant(offset: i64, blend: i64) -> i64:
            requires offset >= -Footing::LIMIT
            requires offset <= Footing::LIMIT
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == offset
            return Footing::carry(offset, 0, blend)

        # A hold is gone once the swing is `blend` frames away.
        def carry_gone_after_blend(offset: i64, distance: i64, blend: i64) -> i64:
            requires offset >= -Footing::LIMIT
            requires offset <= Footing::LIMIT
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            requires distance >= blend
            requires distance <= Fade::Domain::MAX_FRAMES
            ensure result == 0
            return Footing::carry(offset, distance, blend)

        # Nothing to carry carries nothing.
        def carry_of_nothing(distance: i64, blend: i64) -> i64:
            requires distance >= 0
            requires distance <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == 0
            return Footing::carry(0, distance, blend)

        # Carry weight is full at the plant and zero past the blend.
        def weight_full_at_plant(blend: i64) -> i64:
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == Fade::Domain::FULL_PERMILLE
            return Footing::carry_weight(0, blend)

        def weight_gone_after_blend(distance: i64, blend: i64) -> i64:
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            requires distance >= blend
            requires distance <= Fade::Domain::MAX_FRAMES
            ensure result == 0
            return Footing::carry_weight(distance, blend)

        # A swing frame far from both holds is left alone.
        def between_far_is_source(before: i64, after: i64, blend: i64) -> i64:
            requires before >= -Footing::LIMIT
            requires before <= Footing::LIMIT
            requires after >= -Footing::LIMIT
            requires after <= Footing::LIMIT
            requires blend >= 1
            requires blend <= 1000
            ensure result == 0
            return Footing::between(before, blend, after, blend, blend)
