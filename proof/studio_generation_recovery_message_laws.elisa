include "../src/studio/state/generation_recovery_message_policy.elisa"

module StudioGenerationRecoveryMessageLaws:
    public:
        def invalid_metadata_is_protected(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires not StudioGenerationRecoveryMessagePolicy::valid(facts)
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Invalid

        def closing_has_priority(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts) and facts.closing
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Closing

        def unfinished_discovery_is_not_complete(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts) and not facts.closing and not facts.discovery_ready
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Discovering

        def overflow_is_not_selected_success(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts) and not facts.closing and facts.discovery_ready and facts.overflow
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Overflow

        def current_selection_survives_pending_warning(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts)
            requires not facts.closing and facts.discovery_ready and not facts.overflow
            requires facts.selected and facts.observation_current
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Selected

        def active_scan_shows_progress(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts)
            requires not facts.closing and facts.discovery_ready and not facts.overflow
            requires facts.selected and not facts.observation_current and facts.scan_active
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Reconciling

        def inactive_stale_scan_does_not_claim_progress(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts)
            requires not facts.closing and facts.discovery_ready and not facts.overflow
            requires facts.selected and not facts.observation_current and not facts.scan_active and not facts.scan_queued
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Stale

        def pending_files_are_not_empty_success(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts)
            requires not facts.closing and facts.discovery_ready and not facts.overflow
            requires not facts.selected and not facts.discovery_refused and facts.pending_records > 0
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Pending

        def selected_status_requires_current_evidence(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Selected
            ensure result
            facts.selected and facts.observation_current

        def queued_scan_is_distinct_from_active_scan(facts: StudioGenerationRecoveryMessagePolicy::Facts) -> bool:
            requires StudioGenerationRecoveryMessagePolicy::valid(facts)
            requires not facts.closing and facts.discovery_ready and not facts.overflow
            requires facts.selected and not facts.observation_current and not facts.scan_active and facts.scan_queued
            ensure result
            StudioGenerationRecoveryMessagePolicy::classify(facts) == StudioGenerationRecoveryMessagePolicy::Status.Waiting
