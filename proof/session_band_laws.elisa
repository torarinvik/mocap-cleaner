# Session retime extension contracts: accepted band fields are valid for the
# clip and malformed timing/speed/blend/enable values are rejected.
include "../src/studio/state/session_band_policy.elisa"

module SessionBandLaws:
    public:
        def valid_band_round_trips_fields(first: i64, last: i64, speed: i64, blend: i64, enabled: i64, frames: i64) -> bool:
            requires frames >= 1
            requires frames <= Retime::MAX_FRAMES
            requires first >= 0
            requires last >= first
            requires last < frames
            requires Retime::speed_ok(speed)
            requires blend >= 0
            requires blend <= Retime::MAX_BLEND
            requires enabled == 0 or enabled == 1
            ensure result == true
            SessionBandPolicy::band_record_valid(first, last, speed, blend, enabled, frames)

        def negative_blend_is_rejected(first: i64, last: i64, speed: i64, blend: i64, enabled: i64, frames: i64) -> bool:
            requires frames >= 1
            requires frames <= Retime::MAX_FRAMES
            requires first >= 0
            requires last >= first
            requires last < frames
            requires Retime::speed_ok(speed)
            requires blend < 0
            requires enabled == 0 or enabled == 1
            ensure result == false
            SessionBandPolicy::band_record_valid(first, last, speed, blend, enabled, frames)

        def invalid_enabled_is_rejected(first: i64, last: i64, speed: i64, blend: i64, enabled: i64, frames: i64) -> bool:
            requires frames >= 1
            requires frames <= Retime::MAX_FRAMES
            requires first >= 0
            requires last >= first
            requires last < frames
            requires Retime::speed_ok(speed)
            requires blend >= 0
            requires blend <= Retime::MAX_BLEND
            requires enabled != 0
            requires enabled != 1
            ensure result == false
            SessionBandPolicy::band_record_valid(first, last, speed, blend, enabled, frames)
