include "../src/io/report_diff.elisa"

# Keep direct access to implementation-private span order inside its module.
extend ReportDiff:
    public:
        def empty_identity_spans_compare_equal(a: darray[u8]&, b: darray[u8]&) -> i64:
            ensure result == 0
            compare_span(a, 0, 0, b, 0, 0)

        def identity_span_order_is_three_way(a: darray[u8]&, a_at: i64, a_len: i64,
                                             b: darray[u8]&, b_at: i64, b_len: i64) -> i64:
            requires a_at >= 0 and a_len >= 0 and a_at <= a.count.i64()
            requires b_at >= 0 and b_len >= 0 and b_at <= b.count.i64()
            requires a_len <= a.count.i64() - a_at
            requires b_len <= b.count.i64() - b_at
            ensure result >= -1 and result <= 1
            compare_span(a, a_at, a_len, b, b_at, b_len)
