include "../src/studio/state/generation_review_binding_policy.elisa"

module StudioGenerationReviewBindingLaws:
    public:
        def matching_review_and_identity_admitted(review: StudioGenerationReviewBindingPolicy::Review,
                                                  begin: StudioBuildGenerationTrashBindingPolicy::BeginEvidence) -> bool:
            requires StudioGenerationReviewBindingPolicy::review_current(review)
            requires StudioBuildGenerationTrashBindingPolicy::begin_evidence_admitted(begin)
            ensure result
            StudioGenerationReviewBindingPolicy::may_prepare_intent(review, begin, StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32()))

        def unselected_review_refuses(review: StudioGenerationReviewBindingPolicy::Review) -> bool:
            requires not review.selected
            ensure not result
            StudioGenerationReviewBindingPolicy::review_current(review)

        def unconfirmed_review_refuses(review: StudioGenerationReviewBindingPolicy::Review) -> bool:
            requires not review.confirmed
            ensure not result
            StudioGenerationReviewBindingPolicy::review_current(review)

        def changed_inventory_refuses(review: StudioGenerationReviewBindingPolicy::Review) -> bool:
            requires review.confirmed_revision != review.inventory_revision
            ensure not result
            StudioGenerationReviewBindingPolicy::review_current(review)

        def changed_retention_refuses(review: StudioGenerationReviewBindingPolicy::Review) -> bool:
            requires review.current_retention_days != review.reviewed_retention_days
            ensure not result
            StudioGenerationReviewBindingPolicy::review_current(review)

        def negative_retention_refuses(review: StudioGenerationReviewBindingPolicy::Review) -> bool:
            requires review.reviewed_retention_days < 0
            ensure not result
            StudioGenerationReviewBindingPolicy::review_current(review)

        def unknown_identity_refuses(review: StudioGenerationReviewBindingPolicy::Review,
                                     begin: StudioBuildGenerationTrashBindingPolicy::BeginEvidence) -> bool:
            ensure not result
            StudioGenerationReviewBindingPolicy::may_prepare_intent(review, begin, StudioBuildGenerationTrashBindingPolicy::decode_status(-1))

        def changed_identity_refuses(review: StudioGenerationReviewBindingPolicy::Review,
                                     begin: StudioBuildGenerationTrashBindingPolicy::BeginEvidence) -> bool:
            ensure not result
            StudioGenerationReviewBindingPolicy::may_prepare_intent(review, begin, StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Changed.i32()))

        def unavailable_begin_refuses(review: StudioGenerationReviewBindingPolicy::Review,
                                      begin: StudioBuildGenerationTrashBindingPolicy::BeginEvidence,
                                      identity: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            requires not StudioBuildGenerationTrashBindingPolicy::begin_evidence_admitted(begin)
            ensure not result
            StudioGenerationReviewBindingPolicy::may_prepare_intent(review, begin, identity)
