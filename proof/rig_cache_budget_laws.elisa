include "../src/core/rig_cache_budget_policy.elisa"

module RigCacheBudgetLaws:
    public:
        def empty_cache_is_admitted() -> bool:
            ensure result
            RigCacheBudgetPolicy::admits(0, 0)

        def snapshot_copies_count_against_capacity() -> bool:
            ensure result
            not RigCacheBudgetPolicy::admits(RigCacheBudgetPolicy::Limit::MAX_LOGICAL_BYTES, 0)

        def invalid_count_cannot_reduce_total() -> bool:
            ensure result
            RigCacheBudgetPolicy::add_array(100, -1, 8) == -1

        def overflow_cannot_admit_cache() -> bool:
            ensure result
            not RigCacheBudgetPolicy::admits(9223372036854775807, 1)

        def rejected_total_stays_rejected() -> bool:
            ensure result
            RigCacheBudgetPolicy::add_array(-1, 1, 8) == -1
