include "../src/io/output_completion_policy.elisa"

module OutputCompletionLaws:
    public:
        def exact_completion(operation_succeeded: bool, close_succeeded: bool) -> bool:
            ensure result
            OutputCompletionPolicy::success(operation_succeeded, close_succeeded) == (operation_succeeded and close_succeeded)

        def failed_operation_cannot_succeed(close_succeeded: bool) -> bool:
            ensure result
            not OutputCompletionPolicy::success(false, close_succeeded)

        def failed_close_cannot_succeed(operation_succeeded: bool) -> bool:
            ensure result
            not OutputCompletionPolicy::success(operation_succeeded, false)
