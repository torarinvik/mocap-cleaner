include "../src/studio/fbx_import_reference.elisa"

module StudioFbxImportReferenceIdentityLaws:
    def exact_importer_and_options_identity_is_required() -> void can Memory.Allocate:
        mutable source_digest: darray[u8] = []
        mutable runtime_digest: darray[u8] = []
        mutable options: darray[u8] = []
        for index in 0..<64 |index, source_digest, runtime_digest, options|:
            byte: u8 = (48 + index % 10).u8()
            source_digest.push(byte)
            runtime_digest.push(byte)
            options.push(byte)
        reference: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefPolicy::TakeSourceRef{
            format: StudioTakeSourceRefPolicy::SourceFormat.FbxDerived,
            original_path: [47, 116, 46, 102, 98, 120], original_sha256: source_digest,
            runtime_glb_path: [47, 98, 47, 116, 46, 103, 108, 98], runtime_glb_sha256: runtime_digest,
            importer_revision: [114, 101, 118, 45, 49], options_sha256: options}
        assert StudioFbxImportReference::processing_identity_matches(reference, "rev-1", options)
        assert not StudioFbxImportReference::processing_identity_matches(reference, "rev-2", options)
        mutable changed_options: darray[u8] = []
        for index in 0..<64 |index, options, changed_options|:
            changed_options.push(49 if index == 0 else options[index])
        assert not StudioFbxImportReference::processing_identity_matches(reference, "rev-1", changed_options)
