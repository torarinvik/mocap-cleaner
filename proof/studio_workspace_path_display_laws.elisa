# File-menu path previews visibly distinguish complete and abbreviated roots.
include "../src/studio/workspace_path_display_policy.elisa"

module StudioWorkspacePathDisplayLaws:
    public:
        def first_hidden_byte_requires_ellipsis() -> bool:
            ensure result
            StudioWorkspacePathDisplayPolicy::needs_ellipsis(StudioWorkspacePathDisplayPolicy::Limit::ROOT_PREVIEW_BYTES + 1)
