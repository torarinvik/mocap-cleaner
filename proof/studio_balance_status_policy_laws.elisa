include "../src/studio/balance_status_policy.elisa"

module StudioBalanceStatusPolicyLaws:
    public:
        def statuses_have_distinct_labels() -> bool:
            ensure result
            StudioBalanceStatusPolicy::label(StudioBalanceStatusPolicy::Availability.Available) != StudioBalanceStatusPolicy::label(StudioBalanceStatusPolicy::Availability.Inapplicable) and StudioBalanceStatusPolicy::label(StudioBalanceStatusPolicy::Availability.Inapplicable) != StudioBalanceStatusPolicy::label(StudioBalanceStatusPolicy::Availability.Unavailable) and StudioBalanceStatusPolicy::label(StudioBalanceStatusPolicy::Availability.Available) != StudioBalanceStatusPolicy::label(StudioBalanceStatusPolicy::Availability.Unavailable)

        def available_never_claims_a_pass() -> bool:
            ensure result
            StudioBalanceStatusPolicy::detail(StudioBalanceStatusPolicy::Availability.Available) == "Computed; not a pass score" and StudioBalanceStatusPolicy::help(StudioBalanceStatusPolicy::Availability.Available) == "Balance was evaluated from valid clip data. This status is not a pass/fail judgment."

        def inapplicable_explains_short_take() -> bool:
            ensure result
            StudioBalanceStatusPolicy::detail(StudioBalanceStatusPolicy::Availability.Inapplicable) == "Take has fewer than 3 frames" and StudioBalanceStatusPolicy::help(StudioBalanceStatusPolicy::Availability.Inapplicable) == "Balance is inapplicable because a velocity-based capture point needs at least three frames."

        def unavailable_explains_missing_evidence() -> bool:
            ensure result
            StudioBalanceStatusPolicy::detail(StudioBalanceStatusPolicy::Availability.Unavailable) == "Missing or invalid evidence" and StudioBalanceStatusPolicy::help(StudioBalanceStatusPolicy::Availability.Unavailable) == "Balance could not be evaluated because required shape, frame, or length evidence was missing or invalid."

        def balance_comparison_requires_two_measurements() -> bool:
            ensure result
            StudioBalanceStatusPolicy::pair_measured(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available) and not StudioBalanceStatusPolicy::pair_measured(StudioBalanceStatusPolicy::Availability.Unavailable, StudioBalanceStatusPolicy::Availability.Available) and not StudioBalanceStatusPolicy::pair_measured(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Inapplicable) and not StudioBalanceStatusPolicy::pair_measured(StudioBalanceStatusPolicy::Availability.Inapplicable, StudioBalanceStatusPolicy::Availability.Unavailable)

        def nonavailable_balance_count_is_only_an_empty_sentinel(frames: i64) -> bool:
            requires frames == -1 or frames == 0 or frames == 1
            ensure result == (frames == 0)
            StudioBalanceStatusPolicy::count_admitted(StudioBalanceStatusPolicy::Availability.Unavailable, frames)

        def negative_available_count_is_rejected(frames: i64) -> bool:
            requires frames == -1
            ensure not result
            not StudioBalanceStatusPolicy::count_admitted(StudioBalanceStatusPolicy::Availability.Available, frames)

        def comparison_requires_matching_sample_domain() -> bool:
            ensure result
            StudioBalanceStatusPolicy::comparison_admitted(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, true) and not StudioBalanceStatusPolicy::comparison_admitted(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, false) and not StudioBalanceStatusPolicy::comparison_admitted(StudioBalanceStatusPolicy::Availability.Unavailable, StudioBalanceStatusPolicy::Availability.Available, true)

        def retimed_comparison_has_explicit_reason() -> bool:
            ensure result
            StudioBalanceStatusPolicy::comparison_reason(StudioBalanceStatusPolicy::Availability.Available, StudioBalanceStatusPolicy::Availability.Available, false) == "The two balance measurements use different frame/time domains."
