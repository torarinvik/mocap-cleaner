# A stored identity matches only when all five scalar metadata values and the
# exact path comparison agree with the fresh filesystem receipt.
include "../src/studio/storage_identity_policy.elisa"

module StudioStorageIdentityPolicyLaws:
    public:
        def identical_receipt_matches(device: i64, inode: i64, size: i64,
                                      seconds: i64, nanoseconds: i64) -> bool:
            ensure result
            StudioStorageIdentityPolicy::matches(device, device, inode, inode,
                size, size, seconds, seconds, nanoseconds, nanoseconds, true)

        def device_change_rejects(expected_device: i64, current_device: i64,
                                  inode: i64, size: i64, seconds: i64,
                                  nanoseconds: i64, same_path: bool) -> bool:
            requires expected_device != current_device
            ensure result
            not StudioStorageIdentityPolicy::matches(expected_device, current_device,
                inode, inode, size, size, seconds, seconds, nanoseconds, nanoseconds, same_path)

        def inode_change_rejects(expected_inode: i64, current_inode: i64,
                                 device: i64, size: i64, seconds: i64,
                                 nanoseconds: i64, same_path: bool) -> bool:
            requires expected_inode != current_inode
            ensure result
            not StudioStorageIdentityPolicy::matches(device, device, expected_inode, current_inode,
                size, size, seconds, seconds, nanoseconds, nanoseconds, same_path)

        def size_change_rejects(expected_size: i64, current_size: i64,
                                device: i64, inode: i64, seconds: i64,
                                nanoseconds: i64, same_path: bool) -> bool:
            requires expected_size != current_size
            ensure result
            not StudioStorageIdentityPolicy::matches(device, device, inode, inode,
                expected_size, current_size, seconds, seconds, nanoseconds, nanoseconds, same_path)

        def modification_seconds_change_rejects(expected_seconds: i64, current_seconds: i64,
                                                device: i64, inode: i64, size: i64,
                                                nanoseconds: i64, same_path: bool) -> bool:
            requires expected_seconds != current_seconds
            ensure result
            not StudioStorageIdentityPolicy::matches(device, device, inode, inode,
                size, size, expected_seconds, current_seconds, nanoseconds, nanoseconds, same_path)

        def modification_nanoseconds_change_rejects(expected_nanoseconds: i64, current_nanoseconds: i64,
                                                   device: i64, inode: i64, size: i64,
                                                   seconds: i64, same_path: bool) -> bool:
            requires expected_nanoseconds != current_nanoseconds
            ensure result
            not StudioStorageIdentityPolicy::matches(device, device, inode, inode,
                size, size, seconds, seconds, expected_nanoseconds, current_nanoseconds, same_path)

        def path_change_rejects(device: i64, inode: i64, size: i64,
                                seconds: i64, nanoseconds: i64) -> bool:
            ensure result
            not StudioStorageIdentityPolicy::matches(device, device, inode, inode,
                size, size, seconds, seconds, nanoseconds, nanoseconds, false)
