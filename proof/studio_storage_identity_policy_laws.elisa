# A stored identity matches only when every scalar field and the exact path
# comparison agree with the fresh filesystem receipt.
include "../src/studio/storage_identity_policy.elisa"

module StudioStorageIdentityPolicyLaws:
    public:
        def identical_receipt_matches(item: StudioStorageIdentityPolicy::Identity, same_path: bool) -> bool:
            requires same_path
            ensure result
            StudioStorageIdentityPolicy::matches(item, item, same_path)

        def device_change_rejects(expected: StudioStorageIdentityPolicy::Identity,
                                  current: StudioStorageIdentityPolicy::Identity,
                                  same_path: bool) -> bool:
            requires expected.device != current.device
            ensure result
            not StudioStorageIdentityPolicy::matches(expected, current, same_path)

        def inode_change_rejects(expected: StudioStorageIdentityPolicy::Identity,
                                 current: StudioStorageIdentityPolicy::Identity,
                                 same_path: bool) -> bool:
            requires expected.inode != current.inode
            ensure result
            not StudioStorageIdentityPolicy::matches(expected, current, same_path)

        def size_change_rejects(expected: StudioStorageIdentityPolicy::Identity,
                                current: StudioStorageIdentityPolicy::Identity,
                                same_path: bool) -> bool:
            requires expected.size_bytes != current.size_bytes
            ensure result
            not StudioStorageIdentityPolicy::matches(expected, current, same_path)

        def modification_seconds_change_rejects(expected: StudioStorageIdentityPolicy::Identity,
                                                current: StudioStorageIdentityPolicy::Identity,
                                                same_path: bool) -> bool:
            requires expected.modified_seconds != current.modified_seconds
            ensure result
            not StudioStorageIdentityPolicy::matches(expected, current, same_path)

        def modification_nanoseconds_change_rejects(expected: StudioStorageIdentityPolicy::Identity,
                                                    current: StudioStorageIdentityPolicy::Identity,
                                                    same_path: bool) -> bool:
            requires expected.modified_nanoseconds != current.modified_nanoseconds
            ensure result
            not StudioStorageIdentityPolicy::matches(expected, current, same_path)

        def path_change_rejects(item: StudioStorageIdentityPolicy::Identity) -> bool:
            ensure result
            not StudioStorageIdentityPolicy::matches(item, item, false)
