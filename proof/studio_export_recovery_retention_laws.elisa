# Retained recovery payloads are bounded by record count and aggregate bytes.
include "../src/studio/export_recovery_retention_policy.elisa"

module StudioExportRecoveryRetentionLaws:
    public:
        def capacity_keeps_transient_headroom() -> bool:
            ensure result
            StudioExportRecoveryRetentionPolicy::Capacity::MAX_RECORDS == 16 and StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES == 100000000 and StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES < 1073741824

        def admitted_budget_accepts(current_records: i64,
                                    current_bytes: i64,
                                    incoming_bytes: i64) -> bool:
            requires current_records >= 0 and current_records < StudioExportRecoveryRetentionPolicy::Capacity::MAX_RECORDS
            requires current_bytes >= 0 and current_bytes <= StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES
            requires incoming_bytes > 0
            requires incoming_bytes <= StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES - current_bytes
            ensure result
            StudioExportRecoveryRetentionPolicy::retain_admitted(current_records, current_bytes, incoming_bytes)

        def full_record_set_rejects_retention(current_bytes: i64,
                                              incoming_bytes: i64) -> bool:
            requires current_bytes >= 0 and current_bytes <= StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES
            requires incoming_bytes > 0
            ensure not result
            StudioExportRecoveryRetentionPolicy::retain_admitted(StudioExportRecoveryRetentionPolicy::Capacity::MAX_RECORDS, current_bytes, incoming_bytes)

        def byte_limit_rejects_overflow(current_records: i64,
                                        current_bytes: i64,
                                        incoming_bytes: i64) -> bool:
            requires current_records >= 0 and current_records < StudioExportRecoveryRetentionPolicy::Capacity::MAX_RECORDS
            requires current_bytes >= 0 and current_bytes <= StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES
            requires incoming_bytes > StudioExportRecoveryRetentionPolicy::Capacity::MAX_PAYLOAD_BYTES - current_bytes
            ensure not result
            StudioExportRecoveryRetentionPolicy::retain_admitted(current_records, current_bytes, incoming_bytes)
