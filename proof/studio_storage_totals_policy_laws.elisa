include "../src/studio/storage_totals_policy.elisa"

module StudioStorageTotalsPolicyLaws:
    public:
        def supported_total_fits_in_i64() -> bool:
            ensure StudioStorageTotalsPolicy::MAX_TOTAL_BYTES == 256000000000000000
            ensure StudioStorageTotalsPolicy::MAX_TOTAL_BYTES < 9223372036854775807
            true

        def accepted_add_preserves_bounds(totals: StudioStorageTotalsPolicy::Totals,
                                          size_bytes: i64) -> bool:
            requires StudioStorageTotalsPolicy::valid(totals)
            requires totals.item_count < StudioStorageTotalsPolicy::MAX_ITEMS
            requires size_bytes >= 0 and size_bytes <= StudioStorageTotalsPolicy::MAX_ITEM_BYTES
            mutable next: StudioStorageTotalsPolicy::Totals = totals
            ensure result
            ensure next.item_count == totals.item_count + 1
            ensure next.bytes == totals.bytes + size_bytes
            ensure StudioStorageTotalsPolicy::valid(next)
            StudioStorageTotalsPolicy::add(&next, size_bytes)

        def full_inventory_rejects_another_item(bytes: i64) -> bool:
            requires bytes >= 0 and bytes <= StudioStorageTotalsPolicy::MAX_TOTAL_BYTES
            mutable full: StudioStorageTotalsPolicy::Totals = StudioStorageTotalsPolicy::Totals{
                item_count: StudioStorageTotalsPolicy::MAX_ITEMS,
                bytes: bytes
            }
            ensure not result
            ensure full.item_count == StudioStorageTotalsPolicy::MAX_ITEMS
            ensure full.bytes == bytes
            StudioStorageTotalsPolicy::add(&full, 0)
