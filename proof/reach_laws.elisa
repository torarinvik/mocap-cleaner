# Limb reach laws: reachable targets are untouched and every result lies on
# the annulus the two bones can reach.
include "../src/core/reach.elisa"

module ReachLaws:
    public:
        # A reachable distance is kept exactly.
        def reachable_kept(distance: i64, upper: i64, lower: i64) -> i64:
            requires upper >= lower
            requires lower >= 0
            requires upper <= 1000000000
            requires lower <= 1000000000
            requires distance >= 0
            requires distance <= 1000000000
            requires distance >= upper - lower
            requires distance <= upper + lower
            ensure result == distance
            return Reach::limb_reach(distance, upper, lower)

        # Too far is pulled in to full extension.
        def overreach_extends(distance: i64, upper: i64, lower: i64) -> i64:
            requires upper >= 0
            requires upper <= 1000000000
            requires lower >= 0
            requires lower <= 1000000000
            requires distance > upper + lower
            requires distance <= 1000000000
            ensure result == upper + lower
            return Reach::limb_reach(distance, upper, lower)

        # Equal bones can fold onto the root.
        def equal_bones_fold(distance: i64, length: i64) -> i64:
            requires length >= 0
            requires length <= 1000000000
            requires distance >= 0
            requires distance <= 1000000000
            ensure result >= 0
            ensure result <= length + length
            return Reach::limb_reach(distance, length, length)
