# Hand-edited contact laws: an edit owns exactly its frame range, later edits
# win, and an edit that agrees with detection changes nothing.
include "../src/detect/contact.elisa"

module EditLaws:
    public:
        # Inside its range an edit decides the contact.
        def edit_forces_range(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            requires frame >= first
            requires frame <= last
            ensure result == planted
            return Contact::edited(detected, frame, first, last, planted)

        # Before its range an edit leaves detection alone.
        def edit_before_range(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            requires frame < first
            ensure result == detected
            return Contact::edited(detected, frame, first, last, planted)

        # After its range an edit leaves detection alone.
        def edit_after_range(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            requires frame > last
            ensure result == detected
            return Contact::edited(detected, frame, first, last, planted)

        # An edit that agrees with detection changes nothing.
        def agreeing_edit_identity(detected: bool, frame: i64, first: i64, last: i64) -> bool:
            ensure result == detected
            return Contact::edited(detected, frame, first, last, detected)

        # An empty range (first after last) is no edit.
        def empty_edit_identity(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            requires first > last
            ensure result == detected
            return Contact::edited(detected, frame, first, last, planted)

        # A later edit overrides an earlier one where they overlap.
        def later_edit_wins(detected: bool, frame: i64, a: i64, b: i64, p: bool, c: i64, d: i64, q: bool) -> bool:
            requires frame >= c
            requires frame <= d
            ensure result == q
            once: bool = Contact::edited(detected, frame, a, b, p)
            return Contact::edited(once, frame, c, d, q)

        # Outside a later edit the earlier one still holds.
        def earlier_edit_kept(detected: bool, frame: i64, a: i64, b: i64, p: bool, c: i64, d: i64, q: bool) -> bool:
            requires frame >= a
            requires frame <= b
            requires frame < c
            ensure result == p
            once: bool = Contact::edited(detected, frame, a, b, p)
            return Contact::edited(once, frame, c, d, q)

        # Applying the same edit twice is the same as once: outside the
        # range detection survives both passes.
        def edit_twice_outside(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            requires frame < first
            ensure result == detected
            once: bool = Contact::edited(detected, frame, first, last, planted)
            return Contact::edited(once, frame, first, last, planted)

        # ...and inside it the edit holds after both passes.
        def edit_twice_inside(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            requires frame >= first
            requires frame <= last
            ensure result == planted
            once: bool = Contact::edited(detected, frame, first, last, planted)
            return Contact::edited(once, frame, first, last, planted)
