# The foot-row editor accepts the same frame-count ceiling as the timeline
# and typed contact editor, independently of the performance-cache capacity.
include "../src/studio/foot_policy.elisa"

module StudioFootRangeLaws:
    public:
        def edit_frame_limits_agree() -> bool:
            ensure result
            StudioFoot::FrameRange::MAX_FRAMES == 10000000

        def last_foot_frame_remains_editable(frames: i64) -> i64:
            requires frames == 10000000
            requires frames <= StudioFoot::FrameRange::MAX_FRAMES
            ensure result == frames - 1
            StudioFoot::drag_last(frames, frames - 1, frames)

        def new_contact_span_ends_at_edit_limit(frames: i64) -> i64:
            requires frames == 10000000
            requires frames >= 1 and frames <= StudioFoot::FrameRange::MAX_FRAMES
            requires frames - 1 >= 0 and frames - 1 < frames
            ensure result == frames - 1
            StudioFoot::new_last(frames - 1, frames)
