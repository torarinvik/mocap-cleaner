include "../src/studio/export_result_readiness_policy.elisa"

module StudioExportResultReadinessLaws:
    public:
        def missing_clip_refused(provenance: bool, same: bool, failed: bool, pending: bool) -> bool:
            ensure result
            not StudioExportResultReadinessPolicy::ready(false, provenance, same, failed, pending)

        def missing_provenance_refused(clip: bool, same: bool, failed: bool, pending: bool) -> bool:
            ensure result
            not StudioExportResultReadinessPolicy::ready(clip, false, same, failed, pending)

        def stale_stack_refused(clip: bool, provenance: bool, failed: bool, pending: bool) -> bool:
            ensure result
            not StudioExportResultReadinessPolicy::ready(clip, provenance, false, failed, pending)

        def failed_result_refused(clip: bool, provenance: bool, same: bool, pending: bool) -> bool:
            ensure result
            not StudioExportResultReadinessPolicy::ready(clip, provenance, same, true, pending)

        def pending_result_refused(clip: bool, provenance: bool, same: bool, failed: bool) -> bool:
            ensure result
            not StudioExportResultReadinessPolicy::ready(clip, provenance, same, failed, true)

        def current_result_admitted() -> bool:
            ensure result
            StudioExportResultReadinessPolicy::ready(true, true, true, false, false)
