include "../src/studio/publication_durability_policy.elisa"

module StudioPublicationDurabilityLaws:
    public:
        def failed_rename_is_not_published(directory_synced: bool) -> StudioPublicationDurabilityPolicy::Result:
            ensure result == StudioPublicationDurabilityPolicy::Result.NotPublished
            StudioPublicationDurabilityPolicy::outcome(false, directory_synced)

        def renamed_without_sync_remains_published() -> StudioPublicationDurabilityPolicy::Result:
            ensure result == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown
            StudioPublicationDurabilityPolicy::outcome(true, false)

        def renamed_and_synced_is_distinct() -> StudioPublicationDurabilityPolicy::Result:
            ensure result == StudioPublicationDurabilityPolicy::Result.PublishedDirectorySynced
            StudioPublicationDurabilityPolicy::outcome(true, true)

        def unknown_durability_is_not_a_rollback() -> bool:
            ensure result
            StudioPublicationDurabilityPolicy::published(StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown)
