# Review focus is bounded; material warnings require an explicit acknowledgement.
include "../src/studio/export_review.elisa"

module StudioExportReviewLaws:
    public:
        def unknown_control_cannot_publish(control: i64) -> bool:
            requires control < 0 or control >= StudioExportReview::Limit::FOCUS_COUNT
            ensure result
            not StudioExportReview::publication_requested(control)

        def cancel_does_not_request_publication() -> bool:
            ensure result
            not StudioExportReview::publication_requested(StudioExportReview::Control.CANCEL.i64())

        def warning_focuses_acknowledgement() -> bool:
            ensure result
            StudioExportReview::initial_focus(3) == StudioExportReview::Control.ACKNOWLEDGE.i64()

        def clean_export_focuses_export_action() -> bool:
            ensure result
            StudioExportReview::initial_focus(0) == StudioExportReview::Control.EXPORT.i64()

        def forward_focus_wraps() -> bool:
            ensure result
            StudioExportReview::move_focus(StudioExportReview::Control.EXPORT.i64(), 1, 3) == StudioExportReview::Control.ACKNOWLEDGE.i64()

        def backward_focus_wraps() -> bool:
            ensure result
            StudioExportReview::move_focus(StudioExportReview::Control.ACKNOWLEDGE.i64(), -1, 3) == StudioExportReview::Control.EXPORT.i64()

        def warning_inspector_is_keyboard_reachable() -> bool:
            ensure result
            StudioExportReview::move_focus(StudioExportReview::Control.ACKNOWLEDGE.i64(), 1, 3) == StudioExportReview::Control.DESTINATION.i64() and StudioExportReview::move_focus(StudioExportReview::Control.DESTINATION.i64(), 1, 3) == StudioExportReview::Control.INSPECT_WARNINGS.i64()

        def warning_inspector_is_between_destination_and_cancel() -> bool:
            ensure result
            StudioExportReview::move_focus(StudioExportReview::Control.INSPECT_WARNINGS.i64(), -1, 3) == StudioExportReview::Control.DESTINATION.i64() and StudioExportReview::move_focus(StudioExportReview::Control.INSPECT_WARNINGS.i64(), 1, 3) == StudioExportReview::Control.CANCEL.i64()

        def clean_export_skips_hidden_controls_forward() -> bool:
            ensure result
            StudioExportReview::move_focus(StudioExportReview::Control.DESTINATION.i64(), 1, 0) == StudioExportReview::Control.CANCEL.i64() and StudioExportReview::move_focus(StudioExportReview::Control.CANCEL.i64(), 1, 0) == StudioExportReview::Control.EXPORT.i64()

        def clean_export_skips_hidden_controls_backward() -> bool:
            ensure result
            StudioExportReview::move_focus(StudioExportReview::Control.EXPORT.i64(), -1, 0) == StudioExportReview::Control.CANCEL.i64() and StudioExportReview::move_focus(StudioExportReview::Control.DESTINATION.i64(), -1, 0) == StudioExportReview::Control.EXPORT.i64()

        def warning_blocks_export_until_acknowledged() -> bool:
            ensure result
            not StudioExportReview::export_enabled(2, false) and StudioExportReview::export_enabled(2, true)

        def clean_export_needs_no_acknowledgement() -> bool:
            ensure result
            StudioExportReview::export_enabled(0, false)
