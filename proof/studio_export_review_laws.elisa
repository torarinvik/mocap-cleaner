# Review focus is bounded; material warnings require an explicit acknowledgement.
include "../src/studio/export_review.elisa"

module StudioExportReviewLaws:
    public:
        def warning_focuses_acknowledgement() -> bool:
            StudioExportReview::initial_focus(3) == StudioExportReview::ACKNOWLEDGE

        def clean_export_focuses_export_action() -> bool:
            StudioExportReview::initial_focus(0) == StudioExportReview::EXPORT

        def forward_focus_wraps() -> bool:
            StudioExportReview::move_focus(StudioExportReview::EXPORT, 1) == StudioExportReview::ACKNOWLEDGE

        def backward_focus_wraps() -> bool:
            StudioExportReview::move_focus(StudioExportReview::ACKNOWLEDGE, -1) == StudioExportReview::EXPORT

        def warning_blocks_export_until_acknowledged() -> bool:
            not StudioExportReview::export_enabled(2, false) and StudioExportReview::export_enabled(2, true)

        def clean_export_needs_no_acknowledgement() -> bool:
            StudioExportReview::export_enabled(0, false)
