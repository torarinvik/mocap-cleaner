# Physics and detector laws: a still or linear track has no spike, free fall
# has zero ballistic residual, rate limiting is idempotent within the cap, and
# the support test accepts its own corners.
include "../src/physics/balance.elisa"
include "../src/detect/spike.elisa"

module PhysicsLaws:
    public:
        const L: i64 = 1000000000
        const LENGTH_LIMIT: i64 = Balance::Domain::LENGTH_LIMIT

        # A constant track has zero acceleration.
        def still_has_no_accel(v: i64) -> i64:
            requires v >= -L
            requires v <= L
            ensure result == 0
            return Spike::accel(v, v, v)

        # A still track is never a spike.
        def still_is_not_spike(v: i64, threshold: i64) -> bool:
            requires v >= -L
            requires v <= L
            requires threshold >= 0
            ensure not result
            return Spike::is_spike(v, v, v, threshold)

        # A linear ramp has zero acceleration.
        def ramp_has_no_accel(v: i64, d: i64) -> i64:
            requires v >= -L
            requires v <= L
            requires d >= -L
            requires d <= L
            ensure result == 0
            return Spike::accel(v - d, v, v + d)

        # Magnitude is idempotent on non-negative values.
        def magnitude_of_positive(v: i64) -> i64:
            requires v >= 0
            requires v <= L
            ensure result == v
            return Spike::magnitude(v)

        # Free fall at exactly g has zero residual.
        def free_fall_is_ballistic(now: i64, velocity: i64, g: i64) -> i64:
            requires now >= -LENGTH_LIMIT
            requires now <= LENGTH_LIMIT
            requires velocity >= -LENGTH_LIMIT
            requires velocity <= LENGTH_LIMIT
            requires g >= 0
            requires g <= Balance::Domain::MAX_GRAVITY
            requires now - velocity >= -LENGTH_LIMIT
            requires now - velocity <= LENGTH_LIMIT
            requires now + velocity - g >= -LENGTH_LIMIT
            requires now + velocity - g <= LENGTH_LIMIT
            ensure result == 0
            return Balance::ballistic_residual(now - velocity, now, now + velocity - g, g)

        # Resting on the floor with no gravity step is ballistic.
        def rest_without_gravity(h: i64) -> i64:
            requires h >= -LENGTH_LIMIT
            requires h <= LENGTH_LIMIT
            ensure result == 0
            return Balance::ballistic_residual(h, h, h, 0)

        # A change within the cap passes unchanged.
        def small_step_passes(origin: i64, goal: i64, cap: i64) -> i64:
            requires origin >= -L
            requires origin <= L
            requires goal >= -L
            requires goal <= L
            requires cap >= 0
            requires cap <= L
            requires goal - origin <= cap
            requires origin - goal <= cap
            ensure result == goal
            return Balance::limit_step(origin, goal, cap)

        # A zero cap freezes the value.
        def zero_cap_freezes(origin: i64, goal: i64) -> i64:
            requires origin >= -L
            requires origin <= L
            requires goal >= -L
            requires goal <= L
            ensure result == origin
            return Balance::limit_step(origin, goal, 0)

        # Limiting twice equals limiting once.
        def limit_idempotent(origin: i64, goal: i64, cap: i64) -> i64:
            requires origin >= -L
            requires origin <= L
            requires goal >= -L
            requires goal <= L
            requires cap >= 0
            requires cap <= L
            ensure result - origin <= cap
            ensure origin - result <= cap
            once: i64 = Balance::limit_step(origin, goal, cap)
            return Balance::limit_step(origin, once, cap)

        # A degenerate edge has zero side.
        def degenerate_edge(ax: i64, ay: i64, px: i64, py: i64) -> i64:
            requires ax >= -LENGTH_LIMIT
            requires ax <= LENGTH_LIMIT
            requires ay >= -LENGTH_LIMIT
            requires ay <= LENGTH_LIMIT
            requires px >= -LENGTH_LIMIT
            requires px <= LENGTH_LIMIT
            requires py >= -LENGTH_LIMIT
            requires py <= LENGTH_LIMIT
            ensure result == 0
            return Balance::side(ax, ay, ax, ay, px, py)

        # The edge's own start point lies on it.
        def start_on_edge(ax: i64, ay: i64, bx: i64, by: i64) -> i64:
            requires ax >= -LENGTH_LIMIT
            requires ax <= LENGTH_LIMIT
            requires ay >= -LENGTH_LIMIT
            requires ay <= LENGTH_LIMIT
            requires bx >= -LENGTH_LIMIT
            requires bx <= LENGTH_LIMIT
            requires by >= -LENGTH_LIMIT
            requires by <= LENGTH_LIMIT
            ensure result == 0
            return Balance::side(ax, ay, bx, by, ax, ay)
