include "../src/studio/text_truncation_policy.elisa"

module StudioTextTruncationPolicyLaws:
    public:
        def storage_slot_reserves_the_complete_ellipsis() -> bool:
            ensure result
            StudioTextTruncationPolicy::prefix_capacity(128) == 125 and
                StudioTextTruncationPolicy::prefix_capacity(128) + StudioTextTruncationPolicy::Limit::ELLIPSIS_BYTES == 128

        def tiny_slot_never_underflows() -> bool:
            ensure result
            StudioTextTruncationPolicy::prefix_capacity(0) == 0 and
                StudioTextTruncationPolicy::prefix_capacity(2) == 0 and
                StudioTextTruncationPolicy::prefix_capacity(3) == 0

        def long_names_copy_only_the_display_slot() -> bool:
            ensure result
            StudioTextTruncationPolicy::copy_count(4096, 128) == 128 and
                StudioTextTruncationPolicy::copy_count(40, 128) == 40

        def empty_input_or_slot_does_not_copy() -> bool:
            ensure result
            StudioTextTruncationPolicy::copy_count(0, 128) == 0 and
                StudioTextTruncationPolicy::copy_count(4096, 0) == 0
