include "../src/studio/state/generation_recovery_ledger_policy.elisa"

module StudioGenerationRecoveryLedgerLaws:
    public:
        def empty_ledger_can_reserve() -> bool:
            ensure result
            StudioGenerationRecoveryLedgerPolicy::may_reserve(0, 0)

        def final_slot_can_reserve() -> bool:
            ensure result
            StudioGenerationRecoveryLedgerPolicy::may_reserve(StudioGenerationRecoveryLedgerPolicy::Limit::OPERATIONS - 1, 0)

        def full_ledger_refuses_reservation(reserved: i64) -> bool:
            ensure not result
            StudioGenerationRecoveryLedgerPolicy::may_reserve(StudioGenerationRecoveryLedgerPolicy::Limit::OPERATIONS, reserved)

        def reservations_consume_capacity(count: i64) -> bool:
            requires count >= 0 and count <= StudioGenerationRecoveryLedgerPolicy::Limit::OPERATIONS
            ensure not result
            StudioGenerationRecoveryLedgerPolicy::may_reserve(count, StudioGenerationRecoveryLedgerPolicy::Limit::OPERATIONS - count)

        def negative_counts_refused(count: i64, reserved: i64) -> bool:
            requires count < 0 or reserved < 0
            ensure not result
            StudioGenerationRecoveryLedgerPolicy::may_reserve(count, reserved)

        def empty_identity_refused(root: darray[u8]&, operation: darray[u8]&) -> bool:
            requires operation.count == 0
            ensure result
            StudioGenerationRecoveryLedgerPolicy::admission(0, root, operation, false) == StudioGenerationRecoveryLedgerPolicy::Admission.Invalid

        def valid_duplicate_is_retained(root: darray[u8]&, operation: darray[u8]&) -> bool:
            requires StudioGenerationRecoveryLedgerPolicy::valid_bytes(root, StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES) and StudioGenerationRecoveryLedgerPolicy::valid_bytes(operation, StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES)
            ensure result
            StudioGenerationRecoveryLedgerPolicy::admission(StudioGenerationRecoveryLedgerPolicy::Limit::OPERATIONS, root, operation, true) == StudioGenerationRecoveryLedgerPolicy::Admission.Duplicate
