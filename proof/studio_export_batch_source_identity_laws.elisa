include "../src/studio/io/export_batch_source_identity.elisa"

module StudioExportBatchSourceIdentityLaws:
    public:
        def native_failure_never_admits(outcome: StudioExportBatchSourceIdentity::Outcome) -> bool:
            requires outcome != StudioExportBatchSourceIdentity::Outcome.Ready
            ensure result
            not StudioExportBatchSourceIdentity::admitted(outcome)

        def changed_device_rejects_snapshot(facts: StudioExportBatchSourceIdentity::Facts,
                                            path: darray[u8], device: i64,
                                            inode: i64, size_bytes: i64,
                                            modified_seconds: i64,
                                            modified_nanoseconds: i64) -> bool:
            requires facts.device != device
            ensure result
            not StudioExportBatchSourceIdentity::matches(facts, path, device, inode, size_bytes, modified_seconds, modified_nanoseconds)

        def changed_inode_rejects_snapshot(facts: StudioExportBatchSourceIdentity::Facts,
                                           path: darray[u8], device: i64,
                                           inode: i64, size_bytes: i64,
                                           modified_seconds: i64,
                                           modified_nanoseconds: i64) -> bool:
            requires facts.inode != inode
            ensure result
            not StudioExportBatchSourceIdentity::matches(facts, path, device, inode, size_bytes, modified_seconds, modified_nanoseconds)

        def changed_size_rejects_snapshot(facts: StudioExportBatchSourceIdentity::Facts,
                                          path: darray[u8], device: i64,
                                          inode: i64, size_bytes: i64,
                                          modified_seconds: i64,
                                          modified_nanoseconds: i64) -> bool:
            requires facts.size_bytes != size_bytes
            ensure result
            not StudioExportBatchSourceIdentity::matches(facts, path, device, inode, size_bytes, modified_seconds, modified_nanoseconds)

        def changed_modification_time_rejects_snapshot(facts: StudioExportBatchSourceIdentity::Facts,
                                                       path: darray[u8], device: i64,
                                                       inode: i64, size_bytes: i64,
                                                       modified_seconds: i64,
                                                       modified_nanoseconds: i64) -> bool:
            requires facts.modified_seconds != modified_seconds or facts.modified_nanoseconds != modified_nanoseconds
            ensure result
            not StudioExportBatchSourceIdentity::matches(facts, path, device, inode, size_bytes, modified_seconds, modified_nanoseconds)
