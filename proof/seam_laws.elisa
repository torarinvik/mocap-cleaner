# Loop-seam laws: frames before the window are untouched, the last frame is
# fully pulled to the continuation, and jumps are non-negative distances.
include "../src/core/seam.elisa"

module SeamLaws:
    public:
        def last_frame_closes(last: i64, window: i64) -> i64:
            requires last >= 1
            requires last < Seam::MAX_FRAMES
            requires window >= 1
            requires window <= last
            ensure result == Fade::Domain::FULL_PERMILLE
            return Seam::pull(last, last, window)

        def first_frame_untouched(last: i64, window: i64) -> i64:
            requires last >= 1
            requires last < Seam::MAX_FRAMES
            requires window >= 1
            requires window < last
            ensure result == 0
            return Seam::pull(0, last, window)

        def before_window_untouched(frame: i64, last: i64, window: i64) -> i64:
            requires last >= 1
            requires last < Seam::MAX_FRAMES
            requires window >= 1
            requires window <= last
            requires frame >= 0
            requires frame <= last - window
            ensure result == 0
            return Seam::pull(frame, last, window)

        def pull_in_permille(frame: i64, last: i64, window: i64) -> i64:
            requires last >= 1
            requires last < Seam::MAX_FRAMES
            requires window >= 1
            requires window <= last
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= Fade::Domain::FULL_PERMILLE
            return Seam::pull(frame, last, window)

        # A closed loop (first == last sample) has no jump.
        def closed_has_no_jump(v: i64) -> i64:
            requires v >= -1000000000
            requires v <= 1000000000
            ensure result == 0
            return Seam::jump(v, v)

        # Jump is symmetric.
        def jump_symmetric(a: i64, b: i64) -> bool:
            requires a >= -1000000000
            requires a <= 1000000000
            requires b >= -1000000000
            requires b <= 1000000000
            ensure result
            return Seam::jump(a, b) == Seam::jump(b, a)
