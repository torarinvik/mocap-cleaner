# Hinge laws: the unwrap step never jumps half a turn or more, a zero step
# stays zero, and the twist kept / moved never exceeds what was there.
include "../src/core/hinge.elisa"

module HingeLaws:
    public:
        # Equal raw angles give no step.
        def same_angle_no_step(angle: i64) -> i64:
            requires angle >= -3141593
            requires angle <= 3141593
            ensure result == 0
            return Hinge::unwrap_step(angle, angle)

        # A small change is passed through unchanged.
        def small_step_kept(previous: i64, angle: i64) -> i64:
            requires previous >= -3141593
            requires previous <= 3141593
            requires angle >= -3141593
            requires angle <= 3141593
            requires angle - previous > -3141593
            requires angle - previous <= 3141593
            ensure result == angle - previous
            return Hinge::unwrap_step(previous, angle)

        # Wrapping an angle already in (-PI, PI] leaves it alone.
        def wrap_identity(angle: i64) -> i64:
            requires angle > -3141593
            requires angle <= 3141593
            ensure result == angle
            return Hinge::wrap_angle(angle)

        # Zero tolerance rebuilds the joint from the hinge plane alone.
        def zero_tolerance_removes_all(off: i64) -> i64:
            requires off >= 0
            requires off <= 1000000000
            ensure result == 0
            return Hinge::kept_off_axis(off, 0)

        # Within tolerance nothing changes.
        def within_tolerance_kept(off: i64, tolerance: i64) -> i64:
            requires off >= 0
            requires tolerance >= off
            requires tolerance <= 1000000000
            ensure result == off
            return Hinge::kept_off_axis(off, tolerance)

        # The roll bone never takes more twist than was removed.
        def roll_share_bounded(removed: i64, share: i64) -> i64:
            requires removed >= 0
            requires removed <= 1000000000
            requires share >= 0
            requires share <= 1000
            ensure result >= 0
            ensure result <= removed
            return Hinge::roll_share(removed, share)

        # No share keeps all twist on the hinge.
        def no_share_nothing_moves(removed: i64) -> i64:
            requires removed >= -1000000000
            requires removed <= 1000000000
            ensure result == 0
            return Hinge::roll_share(removed, 0)
