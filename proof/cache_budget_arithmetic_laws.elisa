include "../src/core/cache_budget_arithmetic.elisa"

module CacheBudgetArithmeticLaws:
    public:
        def checked_sum_accepts_exact_limit() -> bool:
            ensure result
            CacheBudgetArithmetic::bounded_sum(8, 12, 20) == 20

        def checked_sum_rejects_one_over_limit() -> bool:
            ensure result
            CacheBudgetArithmetic::bounded_sum(19, 2, 20) == -1

        def checked_sum_cannot_overflow_at_integer_limit() -> bool:
            ensure result
            CacheBudgetArithmetic::bounded_sum(9223372036854775807, 1, 9223372036854775807) == -1

        def checked_product_accepts_bounded_bytes() -> bool:
            ensure result
            CacheBudgetArithmetic::bounded_product(12, 8, 96) == 96

        def checked_product_rejects_overflow_before_multiplication() -> bool:
            ensure result
            CacheBudgetArithmetic::bounded_product(9223372036854775807, 2, 9223372036854775807) == -1

        def zero_sized_entries_cost_zero_bytes() -> bool:
            ensure result
            CacheBudgetArithmetic::bounded_product(9223372036854775807, 0, 0) == 0

