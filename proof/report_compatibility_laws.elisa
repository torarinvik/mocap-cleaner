include "../src/core/report_compatibility.elisa"

module ReportCompatibilityLaws:
    public:
        def missing_schemas_are_unknown() -> ReportCompatibility::Status:
            ensure result == ReportCompatibility::Status.Unknown
            ReportCompatibility::schema_status(false, false, true, false, false)

        def matching_known_schemas_are_compatible() -> ReportCompatibility::Status:
            ensure result == ReportCompatibility::Status.Compatible
            ReportCompatibility::schema_status(true, true, true, true, true)

        def differing_schemas_are_incompatible() -> ReportCompatibility::Status:
            ensure result == ReportCompatibility::Status.Incompatible
            ReportCompatibility::schema_status(true, true, true, true, false)

        def one_missing_schema_is_incompatible() -> ReportCompatibility::Status:
            ensure result == ReportCompatibility::Status.Incompatible
            ReportCompatibility::schema_status(true, false, true, true, false)

        def malformed_schema_is_invalid() -> ReportCompatibility::Status:
            ensure result == ReportCompatibility::Status.Invalid
            ReportCompatibility::schema_status(true, true, false, true, true)

        def unknown_version_is_unknown() -> ReportCompatibility::Status:
            ensure result == ReportCompatibility::Status.Unknown
            ReportCompatibility::schema_status(true, true, true, false, true)
