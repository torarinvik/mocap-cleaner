include "../src/studio/fbx_failure_feedback_policy.elisa"

module StudioFbxFailureFeedbackPolicyLaws:
    public:
        def current_empty_failure_is_visible(ticket: i64) -> void:
            requires ticket > 0
            assert StudioFbxFailureFeedbackPolicy::show_failure(false, false, false, ticket, ticket)

        def active_take_is_preserved(ticket: i64, current: i64) -> void:
            assert not StudioFbxFailureFeedbackPolicy::show_failure(true, false, false, ticket, current)

        def cancelled_and_closing_are_not_failures(ticket: i64, current: i64) -> void:
            assert not StudioFbxFailureFeedbackPolicy::show_failure(false, true, false, ticket, current)
            assert not StudioFbxFailureFeedbackPolicy::show_failure(false, false, true, ticket, current)

        def obsolete_result_is_not_failure(ticket: i64, current: i64) -> void:
            requires ticket != current
            assert not StudioFbxFailureFeedbackPolicy::show_failure(false, false, false, ticket, current)

        def invalid_ticket_is_not_failure(ticket: i64, current: i64) -> void:
            requires ticket <= 0
            assert not StudioFbxFailureFeedbackPolicy::show_failure(false, false, false, ticket, current)
