include "../src/studio/fbx_failure_feedback_policy.elisa"

module StudioFbxFailureFeedbackPolicyLaws:
    public:
        def loaded_take_failure_keeps_explanation(bytes: i64) -> bool:
            requires bytes > 0
            ensure result == true
            StudioFbxFailureFeedbackPolicy::use_retained_status(bytes)

        def cleared_status_uses_live_message(bytes: i64) -> bool:
            requires bytes <= 0
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::use_retained_status(bytes)

        def failure_explanation_is_retained(bytes: i64) -> bool:
            requires bytes > 0
            ensure result == true
            StudioFbxFailureFeedbackPolicy::use_retained_guide(true, bytes)

        def cleared_failure_uses_current_guidance(bytes: i64) -> bool:
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::use_retained_guide(false, bytes)

        def absent_explanation_uses_current_guidance(bytes: i64) -> bool:
            requires bytes <= 0
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::use_retained_guide(true, bytes)

        def empty_guide_requires_current_feedback(loaded: bool, cancelled: bool,
                closing: bool, ticket: i64, current: i64) -> bool:
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::show_failure(loaded, cancelled, closing, ticket, current) or StudioFbxFailureFeedbackPolicy::may_replace_feedback(cancelled, closing, ticket, current)

        def current_request_can_report_failure(ticket: i64) -> bool:
            requires ticket > 0
            ensure result == true
            StudioFbxFailureFeedbackPolicy::may_replace_feedback(false, false, ticket, ticket)

        def obsolete_request_cannot_replace_feedback(ticket: i64, current: i64) -> bool:
            requires ticket != current
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::may_replace_feedback(false, false, ticket, current)

        def cancelled_or_closing_cannot_replace_feedback(ticket: i64, current: i64) -> bool:
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::may_replace_feedback(true, false, ticket, current) and not StudioFbxFailureFeedbackPolicy::may_replace_feedback(false, true, ticket, current)

        def invalid_request_cannot_replace_feedback(ticket: i64, current: i64) -> bool:
            requires ticket <= 0
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::may_replace_feedback(false, false, ticket, current)

        def current_empty_failure_is_visible(ticket: i64) -> bool:
            requires ticket > 0
            ensure result == true
            StudioFbxFailureFeedbackPolicy::show_failure(false, false, false, ticket, ticket)

        def active_take_is_preserved(ticket: i64, current: i64) -> bool:
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::show_failure(true, false, false, ticket, current)

        def cancelled_and_closing_are_not_failures(ticket: i64, current: i64) -> bool:
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::show_failure(false, true, false, ticket, current) and not StudioFbxFailureFeedbackPolicy::show_failure(false, false, true, ticket, current)

        def obsolete_result_is_not_failure(ticket: i64, current: i64) -> bool:
            requires ticket != current
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::show_failure(false, false, false, ticket, current)

        def invalid_ticket_is_not_failure(ticket: i64, current: i64) -> bool:
            requires ticket <= 0
            ensure result == true
            not StudioFbxFailureFeedbackPolicy::show_failure(false, false, false, ticket, current)
