include "../src/studio/session_save_completion_policy.elisa"

module StudioSessionSaveCompletionPolicyLaws:
    def failed_atomic_write_never_reports_saved() -> void:
        assert StudioSessionSaveCompletionPolicy::classify(false, false, false, false) == StudioSessionSaveCompletionPolicy::Outcome.Refused
        assert StudioSessionSaveCompletionPolicy::classify(false, true, false, true) == StudioSessionSaveCompletionPolicy::Outcome.Refused

    def saved_file_is_distinct_from_target_adoption_and_registration() -> void:
        assert StudioSessionSaveCompletionPolicy::classify(true, false, false, true) == StudioSessionSaveCompletionPolicy::Outcome.Saved
        assert StudioSessionSaveCompletionPolicy::classify(true, false, false, false) == StudioSessionSaveCompletionPolicy::Outcome.SavedUntracked
        assert StudioSessionSaveCompletionPolicy::classify(true, true, true, true) == StudioSessionSaveCompletionPolicy::Outcome.Saved
        assert StudioSessionSaveCompletionPolicy::classify(true, true, false, true) == StudioSessionSaveCompletionPolicy::Outcome.SavedTargetUnchanged

    def save_without_registration_remains_reported_as_saved() -> void:
        assert StudioSessionSaveCompletionPolicy::classify(true, true, true, false) == StudioSessionSaveCompletionPolicy::Outcome.SavedUntracked
        assert StudioSessionSaveCompletionPolicy::classify(true, true, false, false) == StudioSessionSaveCompletionPolicy::Outcome.SavedUntrackedTargetUnchanged
