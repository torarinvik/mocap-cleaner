# Cache accounting rejects over-budget requests before unsafe arithmetic and
# selects full evaluation whenever cache admission fails.
include "../src/core/cache_budget_policy.elisa"

module CacheBudgetLaws:
    public:
        def exact_cache_budget_is_admitted() -> bool:
            ensure result
            CacheBudgetPolicy::decide(CacheBudgetPolicy::Limit::MAX_LOGICAL_ENTRIES,
                CacheBudgetPolicy::Limit::MAX_LOGICAL_BYTES) == CacheBudgetPolicy::Decision.ADMIT

        def capacity_refusal_runs_full_evaluation() -> bool:
            ensure result
            CacheBudgetPolicy::execution(CacheBudgetPolicy::Decision.FALLBACK_CAPACITY) == CacheBudgetPolicy::Execution.EVALUATE_FULL

        def invalid_accounting_runs_full_evaluation() -> bool:
            ensure result
            CacheBudgetPolicy::execution(CacheBudgetPolicy::Decision.FALLBACK_INVALID) == CacheBudgetPolicy::Execution.EVALUATE_FULL

        def channel_request_accounts_results_source_keys_and_operations() -> bool:
            ensure result
            request: CacheBudgetPolicy::ChannelRequest = CacheBudgetPolicy::channel_request(10, 2)
            return request.decision == CacheBudgetPolicy::Decision.ADMIT and request.logical_entries == 34 and request.logical_bytes == 368

        def channel_request_rejects_product_above_entry_cap() -> bool:
            ensure result
            request: CacheBudgetPolicy::ChannelRequest = CacheBudgetPolicy::channel_request(2000001, 2)
            return request.decision == CacheBudgetPolicy::Decision.FALLBACK_CAPACITY and request.logical_entries > CacheBudgetPolicy::Limit::MAX_LOGICAL_ENTRIES

        def channel_request_rejects_byte_cap_before_entry_cap() -> bool:
            ensure result
            request: CacheBudgetPolicy::ChannelRequest = CacheBudgetPolicy::channel_request(0, 1000000)
            return request.decision == CacheBudgetPolicy::Decision.FALLBACK_CAPACITY and request.logical_entries <= CacheBudgetPolicy::Limit::MAX_LOGICAL_ENTRIES and request.logical_bytes > CacheBudgetPolicy::Limit::MAX_LOGICAL_BYTES

        def negative_cache_accounting_is_not_capacity_failure() -> bool:
            ensure result
            CacheBudgetPolicy::decide(-1, 2) == CacheBudgetPolicy::Decision.FALLBACK_INVALID

        def huge_channel_product_falls_back_without_wrapping() -> bool:
            ensure result
            request: CacheBudgetPolicy::ChannelRequest = CacheBudgetPolicy::channel_request(9223372036854775807, 2)
            return request.decision == CacheBudgetPolicy::Decision.FALLBACK_CAPACITY and request.logical_entries > CacheBudgetPolicy::Limit::MAX_LOGICAL_ENTRIES
