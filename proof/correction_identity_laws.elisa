include "../src/ops/corrections.elisa"

module CorrectionIdentityLaws:
    public:
        def exact_identity(c: Corrections::Correction&) -> bool:
            requires c.rotation.x == 0.0 and c.rotation.y == 0.0 and c.rotation.z == 0.0 and c.rotation.w == 1.0
            requires c.translation.x == 0.0 and c.translation.y == 0.0 and c.translation.z == 0.0
            ensure result
            Corrections::identity(c)

        def translation_is_retained(c: Corrections::Correction&) -> bool:
            requires c.translation.x != 0.0 or c.translation.y != 0.0 or c.translation.z != 0.0
            ensure result
            not Corrections::identity(c)

        def rotation_is_retained(c: Corrections::Correction&) -> bool:
            requires c.rotation.x != 0.0 or c.rotation.y != 0.0 or c.rotation.z != 0.0 or c.rotation.w != 1.0
            ensure result
            not Corrections::identity(c)
