include "../src/studio/export_batch_sheet_accessibility_policy.elisa"

module StudioExportBatchSheetAccessibilityLaws:
    public:
        def namespace_is_disjoint_and_bounded() -> bool:
            ensure result
            StudioExportBatchSheetAccessibilityPolicy::ids_fit_reserved_range()

        def inspect_action_uses_node_318_below_no_node() -> bool:
            ensure result
            node: usize = StudioExportBatchSheetAccessibilityPolicy::action_id(StudioExportBatchPanelPolicy::Focus.Inspect)
            last: usize = StudioExportBatchSheetAccessibilityPolicy::Node::LAST
            limit: usize = StudioAccessibility::NO_NODE
            node == 318 and last == 318 and last < limit

        def queue_index_round_trip(first: i64, visible: i64, offset: i64) -> bool:
            requires first >= 0 and first <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            requires visible >= 0 and visible <= StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT
            requires offset >= 0 and offset < visible
            ensure result
            id: usize = StudioExportBatchSheetAccessibilityPolicy::row_id(offset)
            StudioExportBatchSheetAccessibilityPolicy::row_index(id, first, visible) == first + offset

        def row_nodes_are_unique(offset_a: i64, offset_b: i64) -> bool:
            requires offset_a >= 0 and offset_a < StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT
            requires offset_b >= 0 and offset_b < StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT
            ensure result == (offset_a != offset_b)
            StudioExportBatchSheetAccessibilityPolicy::row_id(offset_a) != StudioExportBatchSheetAccessibilityPolicy::row_id(offset_b)

        def typed_action_round_trip(code: i64) -> bool:
            requires code >= 0 and code < StudioExportBatchSheetAccessibilityPolicy::Node::ACTION_COUNT
            ensure result
            if StudioExportBatchPanelPolicy::focus_from_code(code) is focus:
                StudioExportBatchSheetAccessibilityPolicy::focus_for_id(
                    StudioExportBatchSheetAccessibilityPolicy::action_id(focus)) is focus
            else:
                false

        def empty_and_full_sibling_counts(visible: i64) -> bool:
            requires visible >= 0 and visible <= StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT
            ensure result
            empty_tail: usize = StudioExportBatchSheetAccessibilityPolicy::next_sibling_id(
                StudioExportBatchSheetAccessibilityPolicy::Node::STATUS, 0)
            first_item: usize = StudioExportBatchSheetAccessibilityPolicy::next_sibling_id(
                StudioExportBatchSheetAccessibilityPolicy::Node::STATUS, visible)
            tail_ok: bool = empty_tail == StudioExportBatchSheetAccessibilityPolicy::Node::ACTION_FIRST
            first_ok: bool = visible == 0 or first_item == StudioExportBatchSheetAccessibilityPolicy::Node::ROW_FIRST
            count_ok: bool = StudioExportBatchSheetAccessibilityPolicy::node_sibling_count(visible) == visible + StudioExportBatchPanelPolicy::FocusDomain::COUNT + 1
            tail_ok and first_ok and count_ok

        def only_owned_nodes_have_dialog_parent(id: usize) -> bool:
            ensure result == (StudioExportBatchSheetAccessibilityPolicy::parent_id(id) == StudioExportBatchSheetAccessibilityPolicy::Node::DIALOG implies StudioExportBatchSheetAccessibilityPolicy::is_node(id))
            StudioExportBatchSheetAccessibilityPolicy::parent_id(id) != StudioExportBatchSheetAccessibilityPolicy::Node::DIALOG or StudioExportBatchSheetAccessibilityPolicy::is_node(id)
