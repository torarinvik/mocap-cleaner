include "../src/ops/corrections.elisa"

module CorrectionOutputLaws:
    public:
        def zero_is_storable() -> bool:
            ensure result
            Corrections::scalar_storable(0.0)

        def positive_store_boundary_admitted() -> bool:
            ensure result
            Corrections::scalar_storable(Corrections::StoreDomain::MAX_COMPONENT)

        def negative_store_boundary_admitted() -> bool:
            ensure result
            Corrections::scalar_storable(-Corrections::StoreDomain::MAX_COMPONENT)

        def nonfinite_value_refused(value: f32) -> bool:
            requires value - value != 0.0
            ensure result
            not Corrections::scalar_storable(value)

        def outside_store_domain_refused(value: f32) -> bool:
            requires value < -Corrections::StoreDomain::MAX_COMPONENT or value > Corrections::StoreDomain::MAX_COMPONENT
            ensure result
            not Corrections::scalar_storable(value)
