# Pin and offset layer laws: a layer is invisible outside its range and at
# its ends, full in its interior, and an offset never overshoots its delta.
include "../src/core/pin.elisa"
include "../src/core/offset.elisa"

module PinLaws:
    public:
        # Before the range the layer has no weight.
        def before_range_zero(frame: i64, first: i64, last: i64, blend: i64) -> i64:
            requires frame >= 0
            requires frame < first
            requires first <= last
            requires last <= 10000000
            requires blend >= 1
            requires blend <= 100000
            ensure result == 0
            return Pin::pin_weight(frame, first, last, blend)

        # After the range the layer has no weight.
        def after_range_zero(frame: i64, first: i64, last: i64, blend: i64) -> i64:
            requires first >= 0
            requires first <= last
            requires frame > last
            requires frame <= 10000000
            requires blend >= 1
            requires blend <= 100000
            ensure result == 0
            return Pin::pin_weight(frame, first, last, blend)

        # Deep inside the range the layer is at full weight.
        def interior_full(frame: i64, first: i64, last: i64, blend: i64) -> i64:
            requires first >= 0
            requires frame >= 0
            requires frame <= 10000000
            requires first <= last
            requires frame >= first + blend
            requires last >= frame + blend
            requires last <= 10000000
            requires blend >= 1
            requires blend <= 100000
            ensure result == Fade::FULL
            return Pin::pin_weight(frame, first, last, blend)

        # A zero-weight offset changes nothing.
        def offset_zero_weight(delta: i64) -> i64:
            requires delta >= -1000000000
            requires delta <= 1000000000
            ensure result == 0
            return Offset::offset_amount(delta, 0)

        # A full-weight offset is the whole delta.
        def offset_full_weight(delta: i64) -> i64:
            requires delta >= -1000000000
            requires delta <= 1000000000
            ensure result == delta
            return Offset::offset_amount(delta, 1000)

        # A positive offset is never overshot.
        def offset_bounded(delta: i64, w: i64) -> i64:
            requires delta >= 0
            requires delta <= 1000000000
            requires w >= 0
            requires w <= 1000
            ensure result >= 0
            ensure result <= delta
            return Offset::offset_amount(delta, w)
