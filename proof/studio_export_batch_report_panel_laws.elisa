include "../src/studio/export_batch_report_panel_policy.elisa"

module StudioExportBatchReportPanelLaws:
    public:
        def negative_row_offset_never_hits(offset: i64, visible_count: i64) -> bool:
            requires offset < 0
            requires visible_count >= 0 and visible_count <= StudioExportBatchReportPanelPolicy::Layout::PAGE_ROWS
            ensure result
            StudioExportBatchReportPanelPolicy::line_at_offset(offset, visible_count) == -1

        def past_page_row_never_hits(offset: i64, visible_count: i64) -> bool:
            requires offset >= visible_count
            requires visible_count >= 0 and visible_count <= StudioExportBatchReportPanelPolicy::Layout::PAGE_ROWS
            ensure result
            StudioExportBatchReportPanelPolicy::line_at_offset(offset, visible_count) == -1

        def visible_report_row_keeps_its_offset(offset: i64, visible_count: i64) -> bool:
            requires offset >= 0 and offset < visible_count
            requires visible_count > 0 and visible_count <= StudioExportBatchReportPanelPolicy::Layout::PAGE_ROWS
            ensure result
            StudioExportBatchReportPanelPolicy::line_at_offset(offset, visible_count) == offset
