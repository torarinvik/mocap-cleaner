include "../src/studio/character_view_policy.elisa"

module StudioCharacterViewPolicyLaws:
    public:
        def skeleton_mode(triangles: i64) -> bool:
            requires triangles >= 0
            ensure result
            StudioCharacterViewPolicy::draw_skeleton(false, triangles)

        def missing_surface_falls_back(requested: bool) -> bool:
            ensure result
            StudioCharacterViewPolicy::draw_skeleton(requested, 0)

        def character_mode_hides_skeleton(triangles: i64) -> bool:
            requires triangles > 0
            ensure result
            not StudioCharacterViewPolicy::draw_skeleton(true, triangles)
