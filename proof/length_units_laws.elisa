include "../src/core/length_units.elisa"

module LengthUnitsLaws:
    public:
        def positive_half_rounds_away() -> bool:
            ensure result
            LengthUnits::from_micrometres(50) == 1

        def negative_half_rounds_away() -> bool:
            ensure result
            LengthUnits::from_micrometres(-50) == -1

        def sub_half_rounds_to_zero() -> bool:
            ensure result
            LengthUnits::from_micrometres(49) == 0 and LengthUnits::from_micrometres(-49) == 0

        def exact_unit_retained() -> bool:
            ensure result
            LengthUnits::from_micrometres(100) == 1 and LengthUnits::from_micrometres(-100) == -1

        def minimum_integer_admitted() -> bool:
            ensure result
            LengthUnits::from_micrometres(LengthUnits::Scale::MIN_MICROMETRES) == LengthUnits::Scale::MIN_EXPORT_UNITS

        def maximum_integer_admitted() -> bool:
            ensure result
            LengthUnits::from_micrometres(LengthUnits::Scale::MAX_MICROMETRES) == LengthUnits::Scale::MAX_EXPORT_UNITS

        def rounded_value_can_export(value: i64) -> bool:
            ensure result
            LengthUnits::can_export_micrometres(LengthUnits::from_micrometres(value))

        def export_boundary_refuses_overflow() -> bool:
            ensure result
            not LengthUnits::can_export_micrometres(LengthUnits::Scale::MIN_EXPORT_UNITS - 1) and not LengthUnits::can_export_micrometres(LengthUnits::Scale::MAX_EXPORT_UNITS + 1)

        def exact_export(units: i64) -> bool:
            requires units >= LengthUnits::Scale::MIN_EXPORT_UNITS
            requires units <= LengthUnits::Scale::MAX_EXPORT_UNITS
            ensure result
            LengthUnits::to_micrometres(units) == units * 100

        def round_trip_error(value: i64) -> bool:
            ensure result
            return LengthUnits::to_micrometres(LengthUnits::from_micrometres(value)) - value >= -50 and LengthUnits::to_micrometres(LengthUnits::from_micrometres(value)) - value <= 50
