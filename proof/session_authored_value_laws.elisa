include "../src/studio/state/session_authored_value_policy.elisa"

module SessionAuthoredValueLaws:
    public:
        def nonboolean_enable_refused(value: i64) -> bool:
            requires value != 0 and value != 1
            ensure result
            not SessionAuthoredValuePolicy::enabled_valid(value)

        def inverted_interval_refused(first: i64, last: i64, frames: i64) -> bool:
            requires first > last
            ensure result
            not SessionAuthoredValuePolicy::interval_valid(first, last, frames)

        def outside_clip_refused(first: i64, last: i64, frames: i64) -> bool:
            requires first < 0 or last >= frames
            ensure result
            not SessionAuthoredValuePolicy::interval_valid(first, last, frames)

        def outside_key_refused(first: i64, key: i64, last: i64, frames: i64) -> bool:
            requires key < first or key > last
            ensure result
            not SessionAuthoredValuePolicy::key_valid(first, key, last, frames)

        def valid_single_frame_admitted(frame: i64, frames: i64) -> bool:
            requires frames >= 1 and frames <= StudioChrome::Frame::MAX_FRAMES
            requires frame >= 0 and frame < frames
            ensure result
            SessionAuthoredValuePolicy::key_valid(frame, frame, frame, frames)
