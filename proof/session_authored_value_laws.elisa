include "../src/studio/state/session_authored_value_policy.elisa"

module SessionAuthoredValueLaws:
    public:
        def nonboolean_enable_refused(value: i64) -> bool:
            requires value != 0 and value != 1
            ensure result
            not SessionAuthoredValuePolicy::enabled_valid(value)

        def inverted_interval_refused(first: i64, last: i64, frames: i64) -> bool:
            requires first > last
            ensure result
            not SessionAuthoredValuePolicy::interval_valid(first, last, frames)

        def outside_clip_refused(first: i64, last: i64, frames: i64) -> bool:
            requires first < 0 or last >= frames
            ensure result
            not SessionAuthoredValuePolicy::interval_valid(first, last, frames)

        def outside_key_refused(first: i64, key: i64, last: i64, frames: i64) -> bool:
            requires key < first or key > last
            ensure result
            not SessionAuthoredValuePolicy::key_valid(first, key, last, frames)

        def valid_single_frame_admitted(frame: i64, frames: i64) -> bool:
            requires frames >= 1 and frames <= StudioChrome::Frame::MAX_FRAMES
            requires frame >= 0 and frame < frames
            ensure result
            SessionAuthoredValuePolicy::key_valid(frame, frame, frame, frames)

        def zero_rotation_refused() -> bool:
            ensure result
            not SessionAuthoredValuePolicy::rotation_valid(0, 0, 0, 0)

        def identity_rotation_admitted() -> bool:
            ensure result
            SessionAuthoredValuePolicy::rotation_valid(0, 0, 0, StudioChrome::Correction::MICRO)

        def outside_component_refused(value: i64, bound: i64) -> bool:
            requires bound >= 0
            requires value < -bound or value > bound
            ensure result
            not SessionAuthoredValuePolicy::component_valid(value, bound)

        def outside_translation_refused(x: i64, y: i64, z: i64) -> bool:
            requires x < -StudioChrome::Correction::MAX_REACH or x > StudioChrome::Correction::MAX_REACH
            ensure result
            not SessionAuthoredValuePolicy::translation_valid(x, y, z)

        def unknown_bone_mask_refused(bones: i64, strength: i64, edge: i64) -> bool:
            requires bones != -1 and bones != 1 and bones != 2
            ensure result
            not SessionAuthoredValuePolicy::operation_values_valid(bones, strength, edge)

        def outside_strength_refused(bones: i64, strength: i64, edge: i64) -> bool:
            requires strength < 1 or strength > StudioChrome::Session::MAX_STRENGTH
            ensure result
            not SessionAuthoredValuePolicy::operation_values_valid(bones, strength, edge)
