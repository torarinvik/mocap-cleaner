# The studio's canvas landmarks form one bounded, stable workspace tree.
include "../../elisa-ui/src/core/ui_core.elisa"
include "../src/studio/accessibility.elisa"

module StudioAccessibilityLaws:
    public:
        def workspace_nodes_are_bounded() -> bool:
            ensure result
            return StudioAccessibility::SemanticId::WORKSPACE < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::TOOLBAR < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::VIEWPORTS < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CURVES < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::TIMELINE < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::SIDEBAR < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::STATUS < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::BALANCE_STATUS < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::toolbar_control_id(0) < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::toolbar_control_id(StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT - 1) < StudioAccessibility::SemanticId::NO_NODE

        def contact_editor_actions_belong_to_timeline(id: usize) -> bool:
            requires id == StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT or id == StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT or id == StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET or id == StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE or id == StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE or id == StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT
            ensure result
            return StudioAccessibility::is_contact_editor_node(id) and StudioAccessibility::is_workspace_node(id) and StudioAccessibility::parent(id) == StudioAccessibility::SemanticId::TIMELINE

        def contact_editor_actions_are_ordered() -> bool:
            ensure result
            StudioAccessibility::first_child(StudioAccessibility::SemanticId::TIMELINE) == StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_PLANT) == StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_LIFT) == StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_RESET) == StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_DELETE) == StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_MERGE) == StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CONTACT_EDITOR_SPLIT) == StudioAccessibility::ContactEndpoint::FIRST

        def export_review_nodes_are_bounded() -> bool:
            ensure result
            return StudioAccessibility::SemanticId::EXPORT_REVIEW < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::REVIEW_CANCEL < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::REVIEW_EXPORT < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::REVIEW_DESTINATION < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::export_review_warning_id(0) < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::export_review_warning_id(StudioAccessibility::Capacity::REVIEW_WARNING_COUNT - 1) < StudioAccessibility::SemanticId::NO_NODE

        def clean_review_hides_acknowledgement() -> bool:
            ensure result
            StudioAccessibility::export_review_first_child(0) == StudioAccessibility::SemanticId::REVIEW_DESTINATION

        def warned_review_starts_with_acknowledgement() -> bool:
            ensure result
            StudioAccessibility::export_review_first_child(2) == StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT

        def export_review_controls_belong_to_dialog(id: usize) -> bool:
            requires id == StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT or id == StudioAccessibility::SemanticId::REVIEW_DESTINATION or id == StudioAccessibility::SemanticId::REVIEW_CANCEL or id == StudioAccessibility::SemanticId::REVIEW_EXPORT
            ensure result
            StudioAccessibility::is_export_review_node(id) and StudioAccessibility::export_review_parent(id) == StudioAccessibility::SemanticId::EXPORT_REVIEW

        def export_review_controls_are_ordered() -> bool:
            ensure result
            StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT, 0) == StudioAccessibility::SemanticId::REVIEW_DESTINATION and StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT, 2) == StudioAccessibility::Range::REVIEW_WARNING_FIRST and StudioAccessibility::export_review_next_sibling(StudioAccessibility::Range::REVIEW_WARNING_FIRST, 2) == StudioAccessibility::Range::REVIEW_WARNING_FIRST + 1 and StudioAccessibility::export_review_next_sibling(StudioAccessibility::Range::REVIEW_WARNING_FIRST + 1, 2) == StudioAccessibility::SemanticId::REVIEW_DESTINATION and StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_DESTINATION, 2) == StudioAccessibility::SemanticId::REVIEW_CANCEL and StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_CANCEL, 2) == StudioAccessibility::SemanticId::REVIEW_EXPORT and StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_EXPORT, 2) == StudioAccessibility::SemanticId::NO_NODE

        def warning_details_belong_to_their_dialog() -> bool:
            ensure result
            return StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::SemanticId::WARNING_DETAIL) and StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS) and StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT) and StudioAccessibility::warning_detail_parent(StudioAccessibility::SemanticId::WARNING_DETAIL) == StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::warning_detail_first_child() == StudioAccessibility::SemanticId::WARNING_DETAIL_METRIC and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_METRIC) == StudioAccessibility::SemanticId::WARNING_DETAIL_EVIDENCE and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_EVIDENCE) == StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS) == StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT) == StudioAccessibility::SemanticId::WARNING_DETAIL_DONE and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::SemanticId::WARNING_DETAIL_DONE) == StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::warning_detail_parent(StudioAccessibility::SemanticId::WARNING_DETAIL_DONE) == StudioAccessibility::SemanticId::WARNING_DETAIL

        def destination_path_pages_belong_to_inspector() -> bool:
            ensure result
            StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::SemanticId::EXPORT_REVIEW) and StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::Range::PATH_LINE_FIRST) and StudioAccessibility::export_path_inspector_parent(StudioAccessibility::Range::PATH_LINE_FIRST) == StudioAccessibility::SemanticId::EXPORT_REVIEW

        def destination_path_inspector_tree_is_ordered() -> bool:
            ensure result
            StudioAccessibility::export_path_inspector_first_child() == StudioAccessibility::Range::PATH_LINE_FIRST and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::Range::PATH_LINE_FIRST + 4, 5) == StudioAccessibility::SemanticId::PATH_PREVIOUS and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::SemanticId::PATH_PREVIOUS, 5) == StudioAccessibility::SemanticId::PATH_NEXT and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::SemanticId::PATH_NEXT, 5) == StudioAccessibility::SemanticId::PATH_DONE and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::SemanticId::PATH_DONE, 5) == StudioAccessibility::SemanticId::NO_NODE

        def short_final_path_page_skips_blank_lines() -> bool:
            ensure result
            StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::Range::PATH_LINE_FIRST, 2) == StudioAccessibility::Range::PATH_LINE_FIRST + 1 and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::Range::PATH_LINE_FIRST + 1, 2) == StudioAccessibility::SemanticId::PATH_PREVIOUS

        def export_result_nodes_are_bounded() -> bool:
            ensure result
            StudioAccessibility::SemanticId::EXPORT_RESULT < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::RESULT_OPEN < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER < StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::SemanticId::RESULT_DONE < StudioAccessibility::SemanticId::NO_NODE

        def export_result_controls_belong_to_dialog(id: usize) -> bool:
            requires id == StudioAccessibility::SemanticId::RESULT_OPEN or id == StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER or id == StudioAccessibility::SemanticId::RESULT_DONE
            ensure result
            StudioAccessibility::is_export_result_node(id) and StudioAccessibility::export_result_parent(id) == StudioAccessibility::SemanticId::EXPORT_RESULT

        def export_result_controls_are_ordered() -> bool:
            ensure result
            StudioAccessibility::export_result_first_child() == StudioAccessibility::SemanticId::RESULT_OPEN and StudioAccessibility::export_result_next_sibling(StudioAccessibility::SemanticId::RESULT_OPEN) == StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER and StudioAccessibility::export_result_next_sibling(StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER) == StudioAccessibility::SemanticId::RESULT_DONE and StudioAccessibility::export_result_next_sibling(StudioAccessibility::SemanticId::RESULT_DONE) == StudioAccessibility::SemanticId::NO_NODE

        def workspace_root_has_no_parent_or_sibling() -> bool:
            ensure result
            return StudioAccessibility::parent(StudioAccessibility::SemanticId::WORKSPACE) == StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::WORKSPACE) == StudioAccessibility::SemanticId::NO_NODE

        def every_landmark_belongs_to_workspace(id: usize) -> bool:
            requires id == StudioAccessibility::SemanticId::TOOLBAR or id == StudioAccessibility::SemanticId::VIEWPORTS or id == StudioAccessibility::SemanticId::CURVES or id == StudioAccessibility::SemanticId::TIMELINE or id == StudioAccessibility::SemanticId::SIDEBAR or id == StudioAccessibility::SemanticId::STATUS or id == StudioAccessibility::SemanticId::BALANCE_STATUS
            ensure result
            return StudioAccessibility::parent(id) == StudioAccessibility::SemanticId::WORKSPACE

        def every_toolbar_control_belongs_to_toolbar(id: usize) -> bool:
            requires StudioAccessibility::is_toolbar_control(id)
            ensure result
            return StudioAccessibility::is_workspace_node(id) and StudioAccessibility::parent(id) == StudioAccessibility::SemanticId::TOOLBAR

        def toolbar_actions_round_trip(action: i64) -> bool:
            requires action >= 0 and action < StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT
            ensure result
            id: usize = StudioAccessibility::toolbar_control_id(action)
            return StudioAccessibility::is_toolbar_control(id) and StudioAccessibility::toolbar_action_for_control(id) == action

        def toolbar_widget_indices_map_to_actions(widget: usize) -> bool:
            requires widget < StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT.usize()
            ensure result
            action: i64 = StudioAccessibility::toolbar_action_for_widget(widget)
            return action >= 0 and action < StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT and StudioAccessibility::toolbar_control_id(action) == StudioAccessibility::Range::TOOLBAR_CONTROL_FIRST + widget

        def unknown_widget_has_no_toolbar_action(widget: usize) -> bool:
            requires widget >= StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT.usize()
            ensure result
            return StudioAccessibility::toolbar_action_for_widget(widget) == -1

        def toolbar_controls_are_ordered(action: i64) -> bool:
            requires action >= 0 and action < StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT
            ensure result
            id: usize = StudioAccessibility::toolbar_control_id(action)
            expected: usize = StudioAccessibility::SemanticId::NO_NODE if action + 1 == StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT else StudioAccessibility::toolbar_control_id(action + 1)
            return StudioAccessibility::first_child(StudioAccessibility::SemanticId::TOOLBAR) == StudioAccessibility::toolbar_control_id(0) and StudioAccessibility::next_sibling(id) == expected

        def workspace_landmarks_are_ordered() -> bool:
            ensure result
            return StudioAccessibility::first_child(StudioAccessibility::SemanticId::WORKSPACE) == StudioAccessibility::SemanticId::TOOLBAR and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::TOOLBAR) == StudioAccessibility::SemanticId::VIEWPORTS and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::VIEWPORTS) == StudioAccessibility::SemanticId::CURVES and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::CURVES) == StudioAccessibility::SemanticId::TIMELINE and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::TIMELINE) == StudioAccessibility::SemanticId::SIDEBAR and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::SIDEBAR) == StudioAccessibility::SemanticId::STATUS and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::STATUS) == StudioAccessibility::SemanticId::BALANCE_STATUS and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::BALANCE_STATUS) == StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER

        def balance_status_precedes_optional_queue() -> bool:
            ensure result
            StudioAccessibility::parent(StudioAccessibility::SemanticId::BALANCE_STATUS) == StudioAccessibility::SemanticId::WORKSPACE and StudioAccessibility::workspace_next_sibling_with_queue(StudioAccessibility::SemanticId::STATUS, true) == StudioAccessibility::SemanticId::BALANCE_STATUS and StudioAccessibility::workspace_next_sibling_with_queue(StudioAccessibility::SemanticId::BALANCE_STATUS, true) == StudioAccessibility::SemanticId::QUEUE_ENTRY and StudioAccessibility::workspace_next_sibling_with_queue(StudioAccessibility::SemanticId::QUEUE_ENTRY, true) == StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER

        def unknown_identity_is_not_attached(id: usize) -> bool:
            requires id != StudioAccessibility::SemanticId::WORKSPACE and id != StudioAccessibility::SemanticId::TOOLBAR and id != StudioAccessibility::SemanticId::VIEWPORTS and id != StudioAccessibility::SemanticId::CURVES and id != StudioAccessibility::SemanticId::TIMELINE and id != StudioAccessibility::SemanticId::SIDEBAR and id != StudioAccessibility::SemanticId::STATUS and id != StudioAccessibility::SemanticId::BALANCE_STATUS and not StudioAccessibility::is_toolbar_control(id) and not StudioAccessibility::is_reset_node(id) and not StudioAccessibility::is_stack_node(id)
            requires not StudioAccessibility::is_contact_editor_node(id)
            requires not StudioIssueBrowserPolicy::is_issue_node(id)
            ensure result
            return not StudioAccessibility::is_workspace_node(id) and StudioAccessibility::parent(id) == StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::next_sibling(id) == StudioAccessibility::SemanticId::NO_NODE

        def reset_controls_are_stable_workspace_nodes() -> bool:
            ensure result
            StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_GROUP) and StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_TRIGGER) and StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS) and StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS) and StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::RESET_SOURCE_RESULT) and StudioAccessibility::SemanticId::RESET_SOURCE_RESULT < StudioAccessibility::SemanticId::NO_NODE

        def reset_controls_have_a_stable_parent_and_order() -> bool:
            ensure result
            StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_GROUP) == StudioAccessibility::SemanticId::SIDEBAR and StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_TRIGGER) == StudioAccessibility::SemanticId::RESET_GROUP and StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS) == StudioAccessibility::SemanticId::RESET_GROUP and StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS) == StudioAccessibility::SemanticId::RESET_GROUP and StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_SOURCE_RESULT) == StudioAccessibility::SemanticId::RESET_GROUP and StudioAccessibility::first_child(StudioAccessibility::SemanticId::RESET_GROUP) == StudioAccessibility::SemanticId::RESET_TRIGGER

        def sidebar_orders_findings_reset_and_stack() -> bool:
            ensure result
            StudioAccessibility::first_child(StudioAccessibility::SemanticId::SIDEBAR) == StudioIssueBrowserPolicy::Accessibility::GROUP_ID and StudioAccessibility::parent(StudioIssueBrowserPolicy::Accessibility::GROUP_ID) == StudioAccessibility::SemanticId::SIDEBAR and StudioAccessibility::next_sibling(StudioIssueBrowserPolicy::Accessibility::GROUP_ID) == StudioAccessibility::SemanticId::RESET_GROUP and StudioAccessibility::parent(StudioAccessibility::SemanticId::RESET_GROUP) == StudioAccessibility::SemanticId::SIDEBAR and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::RESET_GROUP) == StudioAccessibility::SemanticId::STACK_GROUP and StudioAccessibility::parent(StudioAccessibility::SemanticId::STACK_GROUP) == StudioAccessibility::SemanticId::SIDEBAR and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::STACK_GROUP) == StudioAccessibility::SemanticId::NO_NODE and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::SIDEBAR) == StudioAccessibility::SemanticId::STATUS

        def duplicate_action_is_nested_under_stack_group() -> bool:
            ensure result
            StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::STACK_GROUP) and StudioAccessibility::is_workspace_node(StudioAccessibility::SemanticId::STACK_DUPLICATE) and StudioAccessibility::parent(StudioAccessibility::SemanticId::STACK_GROUP) == StudioAccessibility::SemanticId::SIDEBAR and StudioAccessibility::parent(StudioAccessibility::SemanticId::STACK_DUPLICATE) == StudioAccessibility::SemanticId::STACK_GROUP and StudioAccessibility::first_child(StudioAccessibility::SemanticId::STACK_GROUP) == StudioAccessibility::SemanticId::STACK_DUPLICATE and StudioAccessibility::next_sibling(StudioAccessibility::SemanticId::STACK_DUPLICATE) == StudioAccessibility::SemanticId::NO_NODE

        def reset_menu_children_follow_visibility(open: bool) -> bool:
            ensure result
            StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_TRIGGER, open) == (StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS if open else StudioAccessibility::SemanticId::NO_NODE) and StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_CLEAR_CONTACTS, open) == (StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS if open else StudioAccessibility::SemanticId::NO_NODE) and StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_CLEAR_CORRECTIONS, open) == (StudioAccessibility::SemanticId::RESET_SOURCE_RESULT if open else StudioAccessibility::SemanticId::NO_NODE) and StudioAccessibility::reset_next_sibling(StudioAccessibility::SemanticId::RESET_SOURCE_RESULT, open) == StudioAccessibility::SemanticId::NO_NODE

        def contact_endpoint_parent_is_timeline() -> bool:
            ensure result
            StudioAccessibility::parent(StudioAccessibility::ContactEndpoint::FIRST) == StudioAccessibility::SemanticId::TIMELINE and StudioAccessibility::parent(StudioAccessibility::ContactEndpoint::LAST) == StudioAccessibility::SemanticId::TIMELINE

        def contact_endpoint_chain_terminates() -> bool:
            ensure result
            StudioAccessibility::next_sibling(StudioAccessibility::ContactEndpoint::FIRST) == StudioAccessibility::ContactEndpoint::LAST and StudioAccessibility::next_sibling(StudioAccessibility::ContactEndpoint::LAST) == StudioAccessibility::SemanticId::NO_NODE
