# The studio's canvas landmarks form one bounded, stable workspace tree.
include "../src/studio/accessibility.elisa"

module StudioAccessibilityLaws:
    public:
        def workspace_nodes_are_bounded() -> bool:
            return StudioAccessibility::WORKSPACE < StudioAccessibility::NO_NODE and StudioAccessibility::TOOLBAR < StudioAccessibility::NO_NODE and StudioAccessibility::VIEWPORTS < StudioAccessibility::NO_NODE and StudioAccessibility::CURVES < StudioAccessibility::NO_NODE and StudioAccessibility::TIMELINE < StudioAccessibility::NO_NODE and StudioAccessibility::SIDEBAR < StudioAccessibility::NO_NODE and StudioAccessibility::STATUS < StudioAccessibility::NO_NODE and StudioAccessibility::CONTACT_EDITOR_PLANT < StudioAccessibility::NO_NODE and StudioAccessibility::CONTACT_EDITOR_LIFT < StudioAccessibility::NO_NODE and StudioAccessibility::CONTACT_EDITOR_RESET < StudioAccessibility::NO_NODE and StudioAccessibility::CONTACT_EDITOR_DELETE < StudioAccessibility::NO_NODE and StudioAccessibility::CONTACT_EDITOR_MERGE < StudioAccessibility::NO_NODE and StudioAccessibility::CONTACT_EDITOR_SPLIT < StudioAccessibility::NO_NODE and StudioAccessibility::toolbar_control_id(0) < StudioAccessibility::NO_NODE and StudioAccessibility::toolbar_control_id(StudioAccessibility::TOOLBAR_ACTION_COUNT - 1) < StudioAccessibility::NO_NODE

        def contact_editor_actions_belong_to_timeline(id: usize) -> bool:
            requires id == StudioAccessibility::CONTACT_EDITOR_PLANT or id == StudioAccessibility::CONTACT_EDITOR_LIFT or id == StudioAccessibility::CONTACT_EDITOR_RESET or id == StudioAccessibility::CONTACT_EDITOR_DELETE or id == StudioAccessibility::CONTACT_EDITOR_MERGE or id == StudioAccessibility::CONTACT_EDITOR_SPLIT
            return StudioAccessibility::is_contact_editor_node(id) and StudioAccessibility::is_workspace_node(id) and StudioAccessibility::parent(id) == StudioAccessibility::TIMELINE

        def contact_editor_actions_are_ordered() -> bool:
            StudioAccessibility::first_child(StudioAccessibility::TIMELINE) == StudioAccessibility::CONTACT_EDITOR_PLANT and StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_PLANT) == StudioAccessibility::CONTACT_EDITOR_LIFT and StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_LIFT) == StudioAccessibility::CONTACT_EDITOR_RESET and StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_RESET) == StudioAccessibility::CONTACT_EDITOR_DELETE and StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_DELETE) == StudioAccessibility::CONTACT_EDITOR_MERGE and StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_MERGE) == StudioAccessibility::CONTACT_EDITOR_SPLIT and StudioAccessibility::next_sibling(StudioAccessibility::CONTACT_EDITOR_SPLIT) == StudioAccessibility::NO_NODE

        def export_review_nodes_are_bounded() -> bool:
            return StudioAccessibility::EXPORT_REVIEW < StudioAccessibility::NO_NODE and StudioAccessibility::REVIEW_ACKNOWLEDGEMENT < StudioAccessibility::NO_NODE and StudioAccessibility::REVIEW_CANCEL < StudioAccessibility::NO_NODE and StudioAccessibility::REVIEW_EXPORT < StudioAccessibility::NO_NODE and StudioAccessibility::REVIEW_DESTINATION < StudioAccessibility::NO_NODE and StudioAccessibility::export_review_warning_id(0) < StudioAccessibility::NO_NODE and StudioAccessibility::export_review_warning_id(StudioAccessibility::REVIEW_WARNING_COUNT - 1) < StudioAccessibility::NO_NODE

        def clean_review_hides_acknowledgement() -> bool:
            StudioAccessibility::export_review_first_child(0) == StudioAccessibility::REVIEW_DESTINATION

        def warned_review_starts_with_acknowledgement() -> bool:
            StudioAccessibility::export_review_first_child(2) == StudioAccessibility::REVIEW_ACKNOWLEDGEMENT

        def export_review_controls_belong_to_dialog(id: usize) -> bool:
            requires id == StudioAccessibility::REVIEW_ACKNOWLEDGEMENT or id == StudioAccessibility::REVIEW_DESTINATION or id == StudioAccessibility::REVIEW_CANCEL or id == StudioAccessibility::REVIEW_EXPORT
            StudioAccessibility::is_export_review_node(id) and StudioAccessibility::export_review_parent(id) == StudioAccessibility::EXPORT_REVIEW

        def export_review_controls_are_ordered() -> bool:
            StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_ACKNOWLEDGEMENT, 0) == StudioAccessibility::REVIEW_DESTINATION and StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_ACKNOWLEDGEMENT, 2) == StudioAccessibility::REVIEW_WARNING_FIRST and StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_WARNING_FIRST, 2) == StudioAccessibility::REVIEW_WARNING_FIRST + 1 and StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_WARNING_FIRST + 1, 2) == StudioAccessibility::REVIEW_DESTINATION and StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_DESTINATION, 2) == StudioAccessibility::REVIEW_CANCEL and StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_CANCEL, 2) == StudioAccessibility::REVIEW_EXPORT and StudioAccessibility::export_review_next_sibling(StudioAccessibility::REVIEW_EXPORT, 2) == StudioAccessibility::NO_NODE

        def warning_details_belong_to_their_dialog() -> bool:
            return StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::WARNING_DETAIL) and StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::WARNING_DETAIL_PREVIOUS) and StudioAccessibility::is_export_warning_detail_node(StudioAccessibility::WARNING_DETAIL_NEXT) and StudioAccessibility::warning_detail_parent(StudioAccessibility::WARNING_DETAIL) == StudioAccessibility::NO_NODE and StudioAccessibility::warning_detail_first_child() == StudioAccessibility::WARNING_DETAIL_METRIC and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_METRIC) == StudioAccessibility::WARNING_DETAIL_EVIDENCE and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_EVIDENCE) == StudioAccessibility::WARNING_DETAIL_PREVIOUS and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_PREVIOUS) == StudioAccessibility::WARNING_DETAIL_NEXT and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_NEXT) == StudioAccessibility::WARNING_DETAIL_DONE and StudioAccessibility::warning_detail_next_sibling(StudioAccessibility::WARNING_DETAIL_DONE) == StudioAccessibility::NO_NODE and StudioAccessibility::warning_detail_parent(StudioAccessibility::WARNING_DETAIL_DONE) == StudioAccessibility::WARNING_DETAIL

        def destination_path_pages_belong_to_inspector() -> bool:
            StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::EXPORT_REVIEW) and StudioAccessibility::is_export_path_inspector_node(StudioAccessibility::PATH_LINE_FIRST) and StudioAccessibility::export_path_inspector_parent(StudioAccessibility::PATH_LINE_FIRST) == StudioAccessibility::EXPORT_REVIEW

        def destination_path_inspector_tree_is_ordered() -> bool:
            StudioAccessibility::export_path_inspector_first_child() == StudioAccessibility::PATH_LINE_FIRST and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_LINE_FIRST + 4, 5) == StudioAccessibility::PATH_PREVIOUS and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_PREVIOUS, 5) == StudioAccessibility::PATH_NEXT and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_NEXT, 5) == StudioAccessibility::PATH_DONE and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_DONE, 5) == StudioAccessibility::NO_NODE

        def short_final_path_page_skips_blank_lines() -> bool:
            StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_LINE_FIRST, 2) == StudioAccessibility::PATH_LINE_FIRST + 1 and StudioAccessibility::export_path_inspector_next_sibling(StudioAccessibility::PATH_LINE_FIRST + 1, 2) == StudioAccessibility::PATH_PREVIOUS

        def export_result_nodes_are_bounded() -> bool:
            StudioAccessibility::EXPORT_RESULT < StudioAccessibility::NO_NODE and StudioAccessibility::RESULT_OPEN < StudioAccessibility::NO_NODE and StudioAccessibility::RESULT_SHOW_IN_FOLDER < StudioAccessibility::NO_NODE and StudioAccessibility::RESULT_DONE < StudioAccessibility::NO_NODE

        def export_result_controls_belong_to_dialog(id: usize) -> bool:
            requires id == StudioAccessibility::RESULT_OPEN or id == StudioAccessibility::RESULT_SHOW_IN_FOLDER or id == StudioAccessibility::RESULT_DONE
            StudioAccessibility::is_export_result_node(id) and StudioAccessibility::export_result_parent(id) == StudioAccessibility::EXPORT_RESULT

        def export_result_controls_are_ordered() -> bool:
            StudioAccessibility::export_result_first_child() == StudioAccessibility::RESULT_OPEN and StudioAccessibility::export_result_next_sibling(StudioAccessibility::RESULT_OPEN) == StudioAccessibility::RESULT_SHOW_IN_FOLDER and StudioAccessibility::export_result_next_sibling(StudioAccessibility::RESULT_SHOW_IN_FOLDER) == StudioAccessibility::RESULT_DONE and StudioAccessibility::export_result_next_sibling(StudioAccessibility::RESULT_DONE) == StudioAccessibility::NO_NODE

        def workspace_root_has_no_parent_or_sibling() -> bool:
            return StudioAccessibility::parent(StudioAccessibility::WORKSPACE) == StudioAccessibility::NO_NODE and StudioAccessibility::next_sibling(StudioAccessibility::WORKSPACE) == StudioAccessibility::NO_NODE

        def every_landmark_belongs_to_workspace(id: usize) -> bool:
            requires id == StudioAccessibility::TOOLBAR or id == StudioAccessibility::VIEWPORTS or id == StudioAccessibility::CURVES or id == StudioAccessibility::TIMELINE or id == StudioAccessibility::SIDEBAR or id == StudioAccessibility::STATUS
            return StudioAccessibility::parent(id) == StudioAccessibility::WORKSPACE

        def every_toolbar_control_belongs_to_toolbar(id: usize) -> bool:
            requires StudioAccessibility::is_toolbar_control(id)
            return StudioAccessibility::is_workspace_node(id) and StudioAccessibility::parent(id) == StudioAccessibility::TOOLBAR

        def toolbar_actions_round_trip(action: i64) -> bool:
            requires action >= 0 and action < StudioAccessibility::TOOLBAR_ACTION_COUNT
            id: usize = StudioAccessibility::toolbar_control_id(action)
            return StudioAccessibility::is_toolbar_control(id) and StudioAccessibility::toolbar_action_for_control(id) == action

        def toolbar_widget_indices_map_to_actions(widget: usize) -> bool:
            requires widget < StudioAccessibility::TOOLBAR_ACTION_COUNT.usize()
            action: i64 = StudioAccessibility::toolbar_action_for_widget(widget)
            return action >= 0 and action < StudioAccessibility::TOOLBAR_ACTION_COUNT and StudioAccessibility::toolbar_control_id(action) == StudioAccessibility::TOOLBAR_CONTROL_FIRST + widget

        def unknown_widget_has_no_toolbar_action(widget: usize) -> bool:
            requires widget >= StudioAccessibility::TOOLBAR_ACTION_COUNT.usize()
            return StudioAccessibility::toolbar_action_for_widget(widget) == -1

        def toolbar_controls_are_ordered(action: i64) -> bool:
            requires action >= 0 and action < StudioAccessibility::TOOLBAR_ACTION_COUNT
            id: usize = StudioAccessibility::toolbar_control_id(action)
            expected: usize = StudioAccessibility::NO_NODE if action + 1 == StudioAccessibility::TOOLBAR_ACTION_COUNT else StudioAccessibility::toolbar_control_id(action + 1)
            return StudioAccessibility::first_child(StudioAccessibility::TOOLBAR) == StudioAccessibility::toolbar_control_id(0) and StudioAccessibility::next_sibling(id) == expected

        def workspace_landmarks_are_ordered() -> bool:
            return StudioAccessibility::first_child(StudioAccessibility::WORKSPACE) == StudioAccessibility::TOOLBAR and StudioAccessibility::next_sibling(StudioAccessibility::TOOLBAR) == StudioAccessibility::VIEWPORTS and StudioAccessibility::next_sibling(StudioAccessibility::VIEWPORTS) == StudioAccessibility::CURVES and StudioAccessibility::next_sibling(StudioAccessibility::CURVES) == StudioAccessibility::TIMELINE and StudioAccessibility::next_sibling(StudioAccessibility::TIMELINE) == StudioAccessibility::SIDEBAR and StudioAccessibility::next_sibling(StudioAccessibility::SIDEBAR) == StudioAccessibility::STATUS and StudioAccessibility::next_sibling(StudioAccessibility::STATUS) == StudioAccessibility::NO_NODE

        def unknown_identity_is_not_attached(id: usize) -> bool:
            requires id != StudioAccessibility::WORKSPACE and id != StudioAccessibility::TOOLBAR and id != StudioAccessibility::VIEWPORTS and id != StudioAccessibility::CURVES and id != StudioAccessibility::TIMELINE and id != StudioAccessibility::SIDEBAR and id != StudioAccessibility::STATUS and not StudioAccessibility::is_toolbar_control(id)
            return not StudioAccessibility::is_workspace_node(id) and StudioAccessibility::parent(id) == StudioAccessibility::NO_NODE and StudioAccessibility::next_sibling(id) == StudioAccessibility::NO_NODE
