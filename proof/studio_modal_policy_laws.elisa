# Laws for suppressing viewport layers under every modal canvas overlay.
include "../src/studio/modal_policy.elisa"

module StudioModalPolicyLaws:
    public:
        def no_overlay_keeps_viewports() -> bool:
            ensure not result
            StudioModalPolicy::hides_viewports(false, false, false, false, false, false, false)

        def help_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(true, false, false, false, false, false, false)

        def replacement_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(false, true, false, false, false, false, false)

        def legacy_warning_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(false, false, true, false, false, false, false)

        def export_review_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(false, false, false, true, false, false, false)

        def warning_detail_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(false, false, false, false, true, false, false)

        def path_inspector_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(false, false, false, false, false, true, false)

        def export_result_hides_viewports() -> bool:
            ensure result
            StudioModalPolicy::hides_viewports(false, false, false, false, false, false, true)
