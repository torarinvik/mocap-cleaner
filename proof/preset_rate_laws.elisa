# Laws of retuning the 120 Hz presets to a take's frame rate.
include "../src/ops/presets.elisa"

module PresetRateLaws:
    public:
        # At the tuned rate nothing changes.
        def tuned_rate_keeps_radius(radius: i64) -> i64:
            requires radius >= 1 and radius <= 1000
            ensure result == radius
            Presets::scaled_radius(radius, Presets::Timing::TUNED_RATE)

        def tuned_rate_keeps_passes(passes: i64) -> i64:
            requires passes >= 1 and passes <= 1000
            ensure result == passes
            Presets::scaled_passes(passes, Presets::Timing::TUNED_RATE)

        # A retuned window is never empty.
        def scaled_radius_is_positive(radius: i64, rate: i64) -> i64:
            requires radius >= 1 and radius <= 1000
            requires rate >= 1 and rate <= 1000
            ensure result >= 1
            Presets::scaled_radius(radius, rate)
