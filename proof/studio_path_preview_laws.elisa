include "../src/studio/path_preview_policy.elisa"

module StudioPathPreviewLaws:
    public:
        def ascii_is_a_character_boundary(byte: u8) -> bool:
            requires byte.i64() < 128
            ensure result
            not StudioPathPreviewPolicy::continuation(byte)

        def continuation_edges_are_inside() -> bool:
            ensure result
            StudioPathPreviewPolicy::continuation(128.u8()) and StudioPathPreviewPolicy::continuation(191.u8())

        def leading_bytes_are_boundaries(byte: u8) -> bool:
            requires byte.i64() >= 192
            ensure result
            not StudioPathPreviewPolicy::continuation(byte)
