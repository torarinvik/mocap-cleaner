# Scalar clamp laws used by transient endpoint drag preview.
include "../src/studio/contact_drag_policy.elisa"

module StudioContactDragLaws:
    public:
        def first_target_stays_before_last(target: i64, last: i64) -> bool:
            requires last >= 0 and last < StudioContactDragPolicy::FrameRange::MAX
            ensure result
            p: i64 = StudioContactDragPolicy::clamp_first(target, last)
            p >= 0 and p <= last

        def first_target_clamps_at_clip_start(target: i64, last: i64) -> bool:
            requires last >= 0 and last < StudioContactDragPolicy::FrameRange::MAX
            ensure result
            p: i64 = StudioContactDragPolicy::clamp_first(target, last)
            target >= 0 or p == 0

        def last_target_stays_after_first(target: i64, first: i64, frames: i64) -> bool:
            requires frames >= 1 and frames <= StudioContactDragPolicy::FrameRange::MAX
            requires first >= 0 and first < frames
            ensure result
            p: i64 = StudioContactDragPolicy::clamp_last(target, first, frames)
            p >= first and p < frames

        def last_target_clamps_at_clip_end(target: i64, first: i64, frames: i64) -> bool:
            requires frames >= 1 and frames <= StudioContactDragPolicy::FrameRange::MAX
            requires first >= 0 and first < frames
            ensure result
            p: i64 = StudioContactDragPolicy::clamp_last(target, first, frames)
            target < frames or p == frames - 1
