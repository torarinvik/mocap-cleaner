include "../src/studio/chrome.elisa"

module StudioDirtyBadgeLaws:
    public:
        def empty_document_has_no_unsaved_badge(history_dirty: bool, pending_edit: bool):
            assert not StudioChrome::dirty_badge(false, history_dirty, pending_edit)

        def loaded_unsaved_history_is_visible():
            assert StudioChrome::dirty_badge(true, true, false)

        def pending_loaded_edit_is_visible():
            assert StudioChrome::dirty_badge(true, false, true)

        def saved_document_has_no_unsaved_badge():
            assert not StudioChrome::dirty_badge(true, false, false)
