# Laws for understandable category identity and bounded strength labels.
include "../src/studio/issue_explanation_policy.elisa"

module StudioIssueExplanationLaws:
    public:
        def largest_frame_keeps_zero_based_display() -> bool:
            ensure result
            not StudioIssueExplanationPolicy::can_display_one_based(StudioIssueExplanationPolicy::FrameDisplay::MAX_ZERO_BASED)

        def first_frame_displays_as_one() -> bool:
            ensure result
            StudioIssueExplanationPolicy::one_based_frame(0) == 1

        def one_based_display_preserves_exact_offset(frame: i64) -> bool:
            requires StudioIssueExplanationPolicy::can_display_one_based(frame)
            ensure result
            StudioIssueExplanationPolicy::one_based_frame(frame) - 1 == frame

        def known_spike_has_motion_spike_category() -> bool:
            ensure result
            return StudioIssueExplanationPolicy::category(StudioIssueExplanationPolicy::Detector::MOTION_SPIKE) == StudioIssueExplanationPolicy::Category.MotionSpike

        def unknown_detector_has_generic_category(issue_type: i64) -> bool:
            requires issue_type >= 0
            requires issue_type != StudioIssueExplanationPolicy::Detector::MOTION_SPIKE
            ensure result
            return StudioIssueExplanationPolicy::category(issue_type) == StudioIssueExplanationPolicy::Category.OtherMotion

        def equal_display_values_do_not_exceed(value: i64) -> bool:
            ensure result
            not StudioIssueExplanationPolicy::displayed_peak_exceeds(value, value)

        def lower_display_peak_does_not_exceed(value: i64, threshold: i64) -> bool:
            requires value <= threshold
            ensure result
            not StudioIssueExplanationPolicy::displayed_peak_exceeds(value, threshold)

        def strong_detector_strength(severity: i64) -> bool:
            requires severity >= 1000
            ensure result
            StudioIssueExplanationPolicy::level(severity) == StudioIssueExplanationPolicy::Level.Strong

        def mild_detector_strength(severity: i64) -> bool:
            requires severity < 500
            ensure result
            StudioIssueExplanationPolicy::level(severity) == StudioIssueExplanationPolicy::Level.Mild
