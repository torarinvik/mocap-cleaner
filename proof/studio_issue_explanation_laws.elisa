# Laws for understandable category identity and bounded strength labels.
include "../src/studio/issue_explanation_policy.elisa"

module StudioIssueExplanationLaws:
    public:
        def known_spike_has_motion_spike_category() -> bool:
            ensure result
            return StudioIssueExplanationPolicy::category(StudioIssueExplanationPolicy::MOTION_SPIKE) == StudioIssueExplanationPolicy::CATEGORY_MOTION_SPIKE

        def unknown_detector_has_generic_category(issue_type: i64) -> bool:
            requires issue_type >= 0
            requires issue_type != StudioIssueExplanationPolicy::MOTION_SPIKE
            ensure result
            return StudioIssueExplanationPolicy::category(issue_type) == StudioIssueExplanationPolicy::CATEGORY_OTHER_MOTION
