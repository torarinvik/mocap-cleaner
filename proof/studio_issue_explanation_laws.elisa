# Laws for understandable category identity and monotone strength labels.
include "../src/studio/issue_explanation.elisa"

module StudioIssueExplanationLaws:
    public:
        def known_spike_has_motion_spike_category() -> bool:
            ensure result
            return StudioIssueExplanation::category(StudioIssueExplanation::MOTION_SPIKE) == StudioIssueExplanation::CATEGORY_MOTION_SPIKE

        def unknown_detector_has_generic_category(issue_type: i64) -> bool:
            requires issue_type >= 0
            requires issue_type != StudioIssueExplanation::MOTION_SPIKE
            ensure result
            return StudioIssueExplanation::category(issue_type) == StudioIssueExplanation::CATEGORY_OTHER_MOTION

        def below_clear_is_mild() -> bool:
            ensure result
            return StudioIssueExplanation::level(499) == StudioIssueExplanation::LEVEL_MILD

        def clear_boundary_is_inclusive() -> bool:
            ensure result
            return StudioIssueExplanation::level(500) == StudioIssueExplanation::LEVEL_CLEAR

        def strong_boundary_is_inclusive() -> bool:
            ensure result
            return StudioIssueExplanation::level(1000) == StudioIssueExplanation::LEVEL_STRONG

        def maximum_severity_is_strong() -> bool:
            ensure result
            return StudioIssueExplanation::level(StudioIssues::MAX_SEVERITY) == StudioIssueExplanation::LEVEL_STRONG
