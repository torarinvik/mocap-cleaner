include "../src/studio/app/timeline_goto_input.elisa"

module StudioTimelineGotoStatusLaws:
    public:
        def status_encodings_are_preserved() -> bool:
            ensure result
            StudioTimelineGotoPolicy::Status.Empty.i64() == -2 and StudioTimelineGotoPolicy::Status.Invalid.i64() == -1 and StudioTimelineGotoPolicy::Status.Exact.i64() == 0 and StudioTimelineGotoPolicy::Status.Clamped.i64() == 1
