include "../src/studio/issue_explanation.elisa"

module StudioIssueExplanationRecordLaws:
    public:
        def invalid_revision_cannot_be_explained(issue: StudioIssues::Issue) -> bool:
            requires issue.source_revision < 0
            ensure result
            not StudioIssueExplanation::valid_issue(issue)

        def valid_record_has_analysis_revision(issue: StudioIssues::Issue) -> bool:
            requires StudioIssueExplanation::valid_issue(issue)
            ensure result
            issue.source_revision >= 0
