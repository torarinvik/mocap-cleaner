include "../../elisa-ui/src/core/ui_core.elisa"
include "../../elisa-ui/src/core/ui_text.elisa"
include "../src/studio/app/panels_geometry.elisa"

module StudioPanelConstantDomainLaws:
    public:
        def toolbar_endpoints_preserved() -> bool:
            ensure result
            StudioPanels::ToolbarAction.Play.i64() == 0 and StudioPanels::ToolbarAction.Balance.i64() == 17 and StudioPanels::PanelLimit::BUTTONS == 19

        def stack_hit_partition_preserved() -> bool:
            ensure result
            StudioPanels::StackHit.Select.i64() == 1 and StudioPanels::StackHit.Toggle.i64() == 2 and StudioPanels::StackHit.Up.i64() == 3 and StudioPanels::StackHit.Down.i64() == 4 and StudioPanels::StackHit.Remove.i64() == 5 and StudioPanels::StackHit.Add.i64() == 6 and StudioPanels::StackHit.Duplicate.i64() == 7

        def filter_and_endpoint_codes_preserved() -> bool:
            ensure result
            StudioPanels::IssueFilter.Detector.i64() == 0 and StudioPanels::IssueFilter.Subject.i64() == 1 and StudioPanels::IssueFilter.Severity.i64() == 2 and StudioPanels::IssueFilter.Status.i64() == 3 and StudioPanels::IssueFilter.Reset.i64() == 4 and StudioPanels::ContactEndpointHit.First.i64() == -2 and StudioPanels::ContactEndpointHit.Last.i64() == -3
