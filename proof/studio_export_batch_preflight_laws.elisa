include "../src/studio/export_batch_preflight_policy.elisa"

module StudioExportBatchPreflightLaws:
    public:
        def complete_validation_admits_item() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::admitted(StudioExportBatchPreflightPolicy::evaluate(true, true, true, true, true, true, true, true, true))

        def unavailable_source_has_first_priority() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(false, false, false, false, false, false, false, false, false) == StudioExportBatchPreflightPolicy::Outcome.SourceUnavailable

        def missing_animation_is_reported() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, false, true, true, true, true, true, true, true) == StudioExportBatchPreflightPolicy::Outcome.AnimationUnavailable

        def destination_outside_build_is_refused() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, false, true, true, true, true, true, true) == StudioExportBatchPreflightPolicy::Outcome.DestinationOutsideBuild

        def source_collision_is_refused() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, true, false, true, true, true, true, true) == StudioExportBatchPreflightPolicy::Outcome.SourceCollision

        def duplicate_destination_is_refused() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, true, true, false, true, true, true, true) == StudioExportBatchPreflightPolicy::Outcome.DuplicateDestination

        def existing_output_is_preserved() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, true, true, true, false, true, true, true) == StudioExportBatchPreflightPolicy::Outcome.OutputOccupied

        def existing_report_is_preserved() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, true, true, true, true, false, true, true) == StudioExportBatchPreflightPolicy::Outcome.ReportOccupied

        def unsupported_recipe_is_refused() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, true, true, true, true, true, false, true) == StudioExportBatchPreflightPolicy::Outcome.UnsupportedRecipe

        def incompatible_rig_is_refused() -> bool:
            ensure result
            StudioExportBatchPreflightPolicy::evaluate(true, true, true, true, true, true, true, true, false) == StudioExportBatchPreflightPolicy::Outcome.IncompatibleRig

        def failure_never_admits_item(outcome: StudioExportBatchPreflightPolicy::Outcome) -> bool:
            requires outcome != StudioExportBatchPreflightPolicy::Outcome.Ready
            ensure result
            not StudioExportBatchPreflightPolicy::admitted(outcome)
