# Bounded-residue laws for the studio's source-byte fingerprint.
include "../src/studio/source_fingerprint.elisa"

module StudioSourceFingerprintLaws:
    public:
        def first_step_is_canonical(value: i64, byte: i64) -> i64:
            requires value >= 0
            requires value < StudioSourceFingerprint::FIRST_MODULUS
            requires byte >= 0
            requires byte <= 255
            ensure result >= 0
            ensure result < StudioSourceFingerprint::FIRST_MODULUS
            StudioSourceFingerprint::first_step(value, byte)

        def second_step_is_canonical(value: i64, byte: i64) -> i64:
            requires value >= 0
            requires value < StudioSourceFingerprint::SECOND_MODULUS
            requires byte >= 0
            requires byte <= 255
            ensure result >= 0
            ensure result < StudioSourceFingerprint::SECOND_MODULUS
            StudioSourceFingerprint::second_step(value, byte)

        def first_step_accepts_seed(byte: i64) -> i64:
            requires byte >= 0
            requires byte <= 255
            ensure result >= 0
            ensure result < StudioSourceFingerprint::FIRST_MODULUS
            StudioSourceFingerprint::first_step(1, byte)

        def second_step_accepts_seed(byte: i64) -> i64:
            requires byte >= 0
            requires byte <= 255
            ensure result >= 0
            ensure result < StudioSourceFingerprint::SECOND_MODULUS
            StudioSourceFingerprint::second_step(7, byte)
