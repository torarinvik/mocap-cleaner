include "../src/studio/storage_move_policy.elisa"

module StudioStorageMovePolicyLaws:
    public:
        def move_and_write_facts_use_four_states() -> bool:
            ensure StudioStorageMovePolicy::MOVE_UNKNOWN_AFTER_FAILURE == 3
            ensure StudioStorageMovePolicy::WRITE_UNKNOWN == 3
            ensure StudioStorageMovePolicy::ROLLBACK_UNKNOWN == 3
            true

        def outcomes_have_distinct_retry_states() -> bool:
            ensure StudioStorageMovePolicy::OUTCOME_ROLLBACK_REQUIRED < StudioStorageMovePolicy::OUTCOME_ORIGINAL_RESTORED
            ensure StudioStorageMovePolicy::OUTCOME_ORIGINAL_RESTORED < StudioStorageMovePolicy::OUTCOME_RECOVERY_RECEIPT_RETAINED
            ensure StudioStorageMovePolicy::OUTCOME_RECOVERY_RECEIPT_RETAINED < StudioStorageMovePolicy::OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED
            ensure StudioStorageMovePolicy::OUTCOME_COUNT == 11
            true

        def retained_receipt_blocks_move(move_outcome: i64) -> bool:
            requires move_outcome >= 0
            requires move_outcome < StudioStorageMovePolicy::OUTCOME_COUNT
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(true, move_outcome)

        def unknown_native_move_blocks_retry() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_MOVE_UNKNOWN)

        def unknown_rollback_blocks_retry() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED)

        def invalid_states_block_new_move(move_outcome: i64) -> bool:
            requires move_outcome <= StudioStorageMovePolicy::OUTCOME_INVALID or move_outcome >= StudioStorageMovePolicy::OUTCOME_COUNT
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, move_outcome)

        def completed_outcome_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_RECORDED)

        def not_started_outcome_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_NOT_STARTED)

        def known_original_failure_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_MOVE_FAILED_ORIGINAL)

        def receipt_pending_blocks_next_move() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_RECEIPT_PENDING)

        def durability_unknown_blocks_retry() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_DURABILITY_UNKNOWN)

        def rollback_required_blocks_next_move() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_ROLLBACK_REQUIRED)

        def restored_original_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_ORIGINAL_RESTORED)

        def recovery_receipt_blocks_without_flag_too() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::OUTCOME_RECOVERY_RECEIPT_RETAINED)

        def every_declared_outcome_matches_resolution_whitelist(move_outcome: i64) -> bool:
            requires move_outcome >= StudioStorageMovePolicy::OUTCOME_INVALID
            requires move_outcome < StudioStorageMovePolicy::OUTCOME_COUNT
            ensure result == (move_outcome == StudioStorageMovePolicy::OUTCOME_NOT_STARTED or move_outcome == StudioStorageMovePolicy::OUTCOME_MOVE_FAILED_ORIGINAL or move_outcome == StudioStorageMovePolicy::OUTCOME_RECORDED or move_outcome == StudioStorageMovePolicy::OUTCOME_ORIGINAL_RESTORED)
            StudioStorageMovePolicy::may_start_new_move(false, move_outcome)

        def retained_receipt_blocks_even_resolved_outcome(move_outcome: i64) -> bool:
            requires move_outcome == StudioStorageMovePolicy::OUTCOME_NOT_STARTED or move_outcome == StudioStorageMovePolicy::OUTCOME_MOVE_FAILED_ORIGINAL or move_outcome == StudioStorageMovePolicy::OUTCOME_RECORDED or move_outcome == StudioStorageMovePolicy::OUTCOME_ORIGINAL_RESTORED
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(true, move_outcome)
