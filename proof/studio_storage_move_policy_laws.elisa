include "../src/studio/storage_move_policy.elisa"

module StudioStorageMovePolicyLaws:
    public:
        def move_and_write_facts_use_four_states() -> bool:
            ensure StudioStorageMovePolicy::MoveState.UnknownAfterFailure.i64() == 3
            ensure StudioStorageMovePolicy::WriteState.Unknown.i64() == 3
            ensure StudioStorageMovePolicy::RollbackState.Unknown.i64() == 3
            true

        def outcomes_have_distinct_retry_states() -> bool:
            ensure StudioStorageMovePolicy::Outcome.RollbackRequired.i64() < StudioStorageMovePolicy::Outcome.OriginalRestored.i64()
            ensure StudioStorageMovePolicy::Outcome.OriginalRestored.i64() < StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64()
            ensure StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64() < StudioStorageMovePolicy::Outcome.RollbackUnknownReceiptRetained.i64()
            ensure StudioStorageMovePolicy::Capacity::OUTCOME_COUNT == 11
            true

        def retained_receipt_blocks_move(move_outcome: i64) -> bool:
            requires move_outcome >= 0
            requires move_outcome < StudioStorageMovePolicy::Capacity::OUTCOME_COUNT
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(true, move_outcome)

        def unknown_native_move_blocks_retry() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.MoveUnknown.i64())

        def unknown_rollback_blocks_retry() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.RollbackUnknownReceiptRetained.i64())

        def invalid_states_block_new_move(move_outcome: i64) -> bool:
            requires move_outcome <= StudioStorageMovePolicy::Outcome.Invalid.i64() or move_outcome >= StudioStorageMovePolicy::Capacity::OUTCOME_COUNT
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, move_outcome)

        def completed_outcome_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.Recorded.i64())

        def not_started_outcome_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.NotStarted.i64())

        def known_original_failure_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.MoveFailedOriginal.i64())

        def receipt_pending_blocks_next_move() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.ReceiptPending.i64())

        def durability_unknown_blocks_retry() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.DurabilityUnknown.i64())

        def rollback_required_blocks_next_move() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.RollbackRequired.i64())

        def restored_original_allows_next_move() -> bool:
            ensure result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.OriginalRestored.i64())

        def recovery_receipt_blocks_without_flag_too() -> bool:
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(false, StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64())

        def every_declared_outcome_matches_resolution_whitelist(move_outcome: i64) -> bool:
            requires move_outcome >= StudioStorageMovePolicy::Outcome.Invalid.i64()
            requires move_outcome < StudioStorageMovePolicy::Capacity::OUTCOME_COUNT
            ensure result == (move_outcome == StudioStorageMovePolicy::Outcome.NotStarted.i64() or move_outcome == StudioStorageMovePolicy::Outcome.MoveFailedOriginal.i64() or move_outcome == StudioStorageMovePolicy::Outcome.Recorded.i64() or move_outcome == StudioStorageMovePolicy::Outcome.OriginalRestored.i64())
            StudioStorageMovePolicy::may_start_new_move(false, move_outcome)

        def retained_receipt_blocks_even_resolved_outcome(move_outcome: i64) -> bool:
            requires move_outcome == StudioStorageMovePolicy::Outcome.NotStarted.i64() or move_outcome == StudioStorageMovePolicy::Outcome.MoveFailedOriginal.i64() or move_outcome == StudioStorageMovePolicy::Outcome.Recorded.i64() or move_outcome == StudioStorageMovePolicy::Outcome.OriginalRestored.i64()
            ensure not result
            StudioStorageMovePolicy::may_start_new_move(true, move_outcome)
