# Ops-file codec laws: single digits are written as themselves, signs are exact, the
# writer's loop terminates, and only the eight operation kinds are accepted.
include "../src/core/codec.elisa"

module CodecLaws:
    public:
        # The writer loop makes progress: dropping a digit of a positive
        # magnitude makes it strictly smaller.
        def drop_shrinks(value: i64) -> i64:
            requires value >= 1
            ensure result < value
            return Codec::drop_digit(value)

        # A single digit is written as itself.
        def single_digit_is_itself(d: i64) -> i64:
            requires d >= 0
            requires d <= 9
            ensure result == d
            return Codec::last_digit(d)

        # A positive field keeps its value; a negative one its magnitude.
        def unsigned_field(magnitude: i64) -> i64:
            requires magnitude >= 0
            requires magnitude <= 1000000000000
            ensure result == magnitude
            return Codec::signed(false, magnitude)

        def negative_field(magnitude: i64) -> i64:
            requires magnitude >= 0
            requires magnitude <= 1000000000000
            ensure result + magnitude == 0
            return Codec::signed(true, magnitude)

        # Minus zero reads as zero.
        def minus_zero(negative: bool) -> i64:
            ensure result == 0
            return Codec::signed(negative, 0)

        # Every kind code the writer emits is accepted.
        def written_kinds_accepted(code: i64) -> bool:
            requires code >= 0
            requires code <= 7
            ensure result
            return Codec::kind_ok(code)

        # Codes outside the eight kinds are refused.
        def unknown_kind_refused(code: i64) -> bool:
            requires code >= 8
            ensure not result
            return Codec::kind_ok(code)

        def negative_kind_refused(code: i64) -> bool:
            requires code < 0
            ensure not result
            return Codec::kind_ok(code)
