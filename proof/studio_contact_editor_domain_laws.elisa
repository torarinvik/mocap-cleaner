include "../src/studio/contact_editor.elisa"

module StudioContactEditorDomainLaws:
    public:
        def action_codes_preserved() -> bool:
            ensure result
            StudioContactEditor::Action.Plant.i64() == 0 and StudioContactEditor::Action.Lift.i64() == 1 and StudioContactEditor::Action.Reset.i64() == 2 and StudioContactEditor::Action.Delete.i64() == 3 and StudioContactEditor::Action.Merge.i64() == 4 and StudioContactEditor::Action.Split.i64() == 5

        def nudge_codes_preserved() -> bool:
            ensure result
            StudioContactEditor::NudgeTarget.First.i64() == 0 and StudioContactEditor::NudgeTarget.Last.i64() == 1 and StudioContactEditor::NudgeTarget.Interval.i64() == 2

        def limits_preserved() -> bool:
            ensure result
            StudioContactEditor::Selection::NO_SIDE == -1 and StudioContactEditor::Capacity::SIDE_COUNT == 4 and StudioContactEditor::Capacity::ACTION_COUNT == 6 and StudioContactEditor::Capacity::MAX_EDITS == 32 and StudioContactEditor::Limit::MAX_FRAMES == 10000000 and StudioContactEditor::Limit::DRAG_SLOP == 3
