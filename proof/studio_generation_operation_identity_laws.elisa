include "../src/studio/state/generation_operation_identity_policy.elisa"

module StudioGenerationOperationIdentityLaws:
    public:
        def wrong_length_refused(operation: darray[u8]&) -> bool:
            requires operation.count.i64() != StudioGenerationOperationIdentityPolicy::Limit::BYTES
            ensure not result
            StudioGenerationOperationIdentityPolicy::valid(operation)

        def wrong_prefix_refused(operation: darray[u8]&) -> bool:
            requires operation.count.i64() == StudioGenerationOperationIdentityPolicy::Limit::BYTES and operation[0] != 116
            ensure not result
            StudioGenerationOperationIdentityPolicy::valid(operation)

        def slash_suffix_refused(operation: darray[u8]&) -> bool:
            requires operation.count.i64() == StudioGenerationOperationIdentityPolicy::Limit::BYTES and operation[6] == 47
            ensure not result
            StudioGenerationOperationIdentityPolicy::valid(operation)

        def uppercase_suffix_refused(operation: darray[u8]&) -> bool:
            requires operation.count.i64() == StudioGenerationOperationIdentityPolicy::Limit::BYTES and operation[6] == 65
            ensure not result
            StudioGenerationOperationIdentityPolicy::valid(operation)
