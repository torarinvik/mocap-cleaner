include "../src/ops/corrections.elisa"

module CorrectionTransformLaws:
    public:
        def transform_matches_quaternion_admission(c: Corrections::Correction&) -> bool:
            ensure result
            Corrections::transform_admitted(c) == (Corrections::quaternion_admitted(c.rotation) and Geometry::vec3_is_finite(c.translation))

        def zero_quaternion_refused() -> bool:
            ensure result
            not Corrections::quaternion_admitted(Geometry::Quat{x: 0.0, y: 0.0, z: 0.0, w: 0.0})

        def nonfinite_quaternion_refused(q: Geometry::Quat) -> bool:
            requires not Geometry::quat_is_finite(q)
            ensure result
            not Corrections::quaternion_admitted(q)

        def unusable_quaternion_norm_refused(q: Geometry::Quat) -> bool:
            requires Geometry::quat_length(q) - Geometry::quat_length(q) != 0.0 or Geometry::quat_length(q) <= 0.0
            ensure result
            not Corrections::quaternion_admitted(q)

        def usable_quaternion_admitted(q: Geometry::Quat) -> bool:
            requires Geometry::quat_is_finite(q)
            requires Geometry::quat_length(q) - Geometry::quat_length(q) == 0.0 and Geometry::quat_length(q) > 0.0
            ensure result
            Corrections::quaternion_admitted(q)

        def invalid_rotation_refused(c: Corrections::Correction&) -> bool:
            requires not Geometry::quat_is_finite(c.rotation)
            ensure result
            not Corrections::transform_admitted(c)

        def invalid_translation_refused(c: Corrections::Correction&) -> bool:
            requires not Geometry::vec3_is_finite(c.translation)
            ensure result
            not Corrections::transform_admitted(c)

        def zero_norm_refused(c: Corrections::Correction&) -> bool:
            requires Geometry::quat_length(c.rotation) == 0.0
            ensure result
            not Corrections::transform_admitted(c)

        def unusable_norm_refused(c: Corrections::Correction&) -> bool:
            requires Geometry::quat_length(c.rotation) - Geometry::quat_length(c.rotation) != 0.0
            ensure result
            not Corrections::transform_admitted(c)

        def usable_transform_admitted(c: Corrections::Correction&) -> bool:
            requires Geometry::quat_is_finite(c.rotation) and Geometry::vec3_is_finite(c.translation)
            requires Geometry::quat_length(c.rotation) - Geometry::quat_length(c.rotation) == 0.0
            requires Geometry::quat_length(c.rotation) > 0.0
            ensure result
            Corrections::transform_admitted(c)
