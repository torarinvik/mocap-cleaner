# ASCII folding matches case variants and does not treat a length mismatch as
# a reserved-path match. Unicode namespace equivalence is delegated to the
# documented native-filesystem requirement in the policy module.
include "../src/studio/storage_reserved_path_policy.elisa"

module StudioStorageReservedPathPolicyLaws:
    public:
        def ascii_uppercase_matches_lowercase(value: u8) -> bool:
            requires value >= 65
            requires value <= 90
            ensure result
            StudioStorageReservedPathPolicy::ascii_bytes_equal(value, value + 32)

        def ascii_lowercase_is_stable(value: u8) -> bool:
            requires value >= 97
            requires value <= 122
            ensure result
            StudioStorageReservedPathPolicy::fold_ascii_byte(value) == value

        def non_ascii_bytes_are_preserved(value: u8) -> bool:
            requires value >= 128
            ensure result
            StudioStorageReservedPathPolicy::fold_ascii_byte(value) == value
