include "../src/studio/session_source_policy.elisa"

module StudioSessionSourcePolicyLaws:
    public:
        def exact_association_matches(first: i64, second: i64, animation: i64, frames: i64, nodes: i64) -> bool:
            ensure result
            StudioSessionSourcePolicy::compare(first, second, animation, frames, nodes, first, second, animation, frames, nodes) == StudioSessionSourcePolicy::Comparison.Matching

        def changed_bytes_never_restore(first: i64, second: i64, current_first: i64, current_second: i64) -> bool:
            requires first != current_first or second != current_second
            ensure result
            StudioSessionSourcePolicy::compare(first, second, 0, 10, 26, current_first, current_second, 0, 10, 26) == StudioSessionSourcePolicy::Comparison.ChangedBytes

        def changed_animation_never_restore(animation: i64, current_animation: i64) -> bool:
            requires animation != current_animation
            ensure result
            StudioSessionSourcePolicy::compare(1, 2, animation, 10, 26, 1, 2, current_animation, 10, 26) == StudioSessionSourcePolicy::Comparison.ChangedAnimation

        def changed_shape_never_restore(frames: i64, nodes: i64, current_frames: i64, current_nodes: i64) -> bool:
            requires frames != current_frames or nodes != current_nodes
            ensure result
            StudioSessionSourcePolicy::compare(1, 2, 0, frames, nodes, 1, 2, 0, current_frames, current_nodes) == StudioSessionSourcePolicy::Comparison.ChangedShape

        def byte_mismatch_precedes_other_differences(saved_first: i64, current_first: i64, saved_animation: i64, current_animation: i64, saved_frames: i64, current_frames: i64) -> bool:
            requires saved_first != current_first
            ensure result
            StudioSessionSourcePolicy::compare(saved_first, 2, saved_animation, saved_frames, 26, current_first, 2, current_animation, current_frames, 27) == StudioSessionSourcePolicy::Comparison.ChangedBytes

        def animation_mismatch_precedes_shape(saved_animation: i64, current_animation: i64, saved_frames: i64, current_frames: i64) -> bool:
            requires saved_animation != current_animation
            ensure result
            StudioSessionSourcePolicy::compare(1, 2, saved_animation, saved_frames, 26, 1, 2, current_animation, current_frames, 27) == StudioSessionSourcePolicy::Comparison.ChangedAnimation

        def no_arithmetic_at_signed_extremes() -> bool:
            ensure result
            StudioSessionSourcePolicy::compare(-9223372036854775807 - 1, 9223372036854775807, 0, 1, 1, -9223372036854775807 - 1, 9223372036854775807, 0, 1, 1) == StudioSessionSourcePolicy::Comparison.Matching

        def decode_context_accepts_exact_shape(frames: i64, nodes: i64) -> bool:
            ensure result
            StudioSessionSourcePolicy::decode_context_matches(frames, nodes, frames, nodes)

        def inconsistent_decode_context_refused(frames: i64, nodes: i64, identity_frames: i64, identity_nodes: i64) -> bool:
            requires frames != identity_frames or nodes != identity_nodes
            ensure result
            not StudioSessionSourcePolicy::decode_context_matches(frames, nodes, identity_frames, identity_nodes)
