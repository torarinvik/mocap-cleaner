# Workspace selection fails closed: only a canonical root with a writable
# build/ can be adopted; creating build/ requires an explicit user choice.
include "../src/studio/workspace_root_policy.elisa"

module StudioWorkspaceRootLaws:
    public:
        def writable_workspace_is_ready() -> bool:
            ensure result == true
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootPolicy::decision(32, true, true, true, true, true, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.READY

        def missing_build_requires_choice() -> bool:
            ensure result == true
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootPolicy::decision(32, true, true, false, false, false, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.NEEDS_BUILD

        def explicit_missing_build_choice_is_separate() -> bool:
            ensure result == true
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootPolicy::decision(32, true, true, false, false, false, false, true, false)
            return decision == StudioWorkspaceRootPolicy::Decision.CREATE_BUILD

        def cancellation_preserves_active_document() -> bool:
            ensure result == true
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootPolicy::decision(32, false, false, false, false, false, false, false, true)
            return decision == StudioWorkspaceRootPolicy::Decision.CANCELLED and not StudioWorkspaceRootPolicy::may_adopt(decision)

        def relative_root_is_rejected() -> bool:
            ensure result == true
            decision: i64 = StudioWorkspaceRootPolicy::decision(12, false, true, true, true, true, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.INVALID

        def empty_root_is_rejected() -> bool:
            ensure result == true
            decision: i64 = StudioWorkspaceRootPolicy::decision(0, true, true, true, true, true, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.INVALID

        def oversize_root_is_rejected() -> bool:
            ensure result == true
            decision: i64 = StudioWorkspaceRootPolicy::decision(4096, true, true, true, true, true, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.INVALID

        def build_symlink_is_rejected() -> bool:
            ensure result == true
            decision: i64 = StudioWorkspaceRootPolicy::decision(32, true, true, true, true, true, true, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.INVALID

        def unwritable_build_is_rejected() -> bool:
            ensure result == true
            decision: i64 = StudioWorkspaceRootPolicy::decision(32, true, true, true, true, false, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.UNWRITABLE

        def rejected_root_preserves_active_document() -> bool:
            ensure result == true
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootPolicy::decision(32, false, true, true, true, true, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.INVALID and not StudioWorkspaceRootPolicy::may_adopt(decision)

        def create_offer_preserves_active_document() -> bool:
            ensure result == true
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootPolicy::decision(32, true, true, false, false, false, false, false, false)
            return decision == StudioWorkspaceRootPolicy::Decision.NEEDS_BUILD and not StudioWorkspaceRootPolicy::may_adopt(decision)
