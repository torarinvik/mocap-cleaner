include "../src/studio/state/suggestion_angle_policy.elisa"

module StudioSuggestionAngleLaws:
    public:
        def nonfinite_length_refuses(value: f32) -> bool:
            requires value - value != 0.0
            ensure not result
            StudioSuggestionAnglePolicy::length_admitted(value)

        def collapsed_length_refuses(value: f32) -> bool:
            requires value <= StudioSuggestionAnglePolicy::Domain::MIN_LENGTH
            ensure not result
            StudioSuggestionAnglePolicy::length_admitted(value)

        def nonfinite_cosine_refuses(value: f32) -> bool:
            requires value - value != 0.0
            ensure not result
            StudioSuggestionAnglePolicy::cosine_admitted(value)

        def nonfinite_denominator_refuses(value: f32) -> bool:
            requires value - value != 0.0
            ensure not result
            StudioSuggestionAnglePolicy::denominator_admitted(value)

        def zero_denominator_refuses() -> bool:
            ensure not result
            StudioSuggestionAnglePolicy::denominator_admitted(0.0)

        def nonfinite_angle_refuses(value: f64) -> bool:
            requires value - value != 0.0
            ensure not result
            StudioSuggestionAnglePolicy::angle_admitted(value)

        def negative_angle_refuses(value: f64) -> bool:
            requires value < 0.0
            ensure not result
            StudioSuggestionAnglePolicy::angle_admitted(value)

        def oversized_angle_refuses(value: f64) -> bool:
            requires value > StudioSuggestionAnglePolicy::Domain::MAX_MILLI_DEGREES.f64()
            ensure not result
            StudioSuggestionAnglePolicy::angle_admitted(value)

        def straight_angle_admitted() -> bool:
            ensure result
            StudioSuggestionAnglePolicy::angle_admitted(180000.0)

        def rounded_angle_bounded(value: f64) -> i64:
            requires StudioSuggestionAnglePolicy::angle_admitted(value)
            ensure result >= 0 and result <= StudioSuggestionAnglePolicy::Domain::MAX_MILLI_DEGREES
            StudioSuggestionAnglePolicy::rounded_angle(value)
