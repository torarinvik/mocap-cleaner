# Character model binding laws: names win over roles, every joint gets
# exactly one pose mode, coverage stays in permille and gates drawing.
include "../src/studio/character_bind_policy.elisa"

module StudioCharacterBindLaws:
    public:
        def a_name_match_beats_a_role_match(by_name: i64, by_role: i64) -> i64:
            requires by_name >= 0
            ensure result == by_name
            StudioCharacterBind::match_slot(by_name, by_role)

        def a_joint_with_no_match_is_unbound(by_name: i64, by_role: i64) -> i64:
            requires by_name < 0 and by_role < 0
            ensure result == -1
            StudioCharacterBind::match_slot(by_name, by_role)

        def role_match_is_used_when_name_is_absent(by_role: i64) -> i64:
            requires by_role >= 0
            ensure result == by_role
            StudioCharacterBind::match_slot(-1, by_role)

        def an_in_range_slot_is_usable(slot: i64, count: i64) -> bool:
            requires slot >= 0 and slot < count
            ensure result
            StudioCharacterBind::slot_ok(slot, count)

        def an_out_of_range_slot_is_rejected(slot: i64, count: i64) -> bool:
            requires slot >= count
            ensure not result
            StudioCharacterBind::slot_ok(slot, count)

        def a_bound_joint_is_posed_directly(own: i64, ancestor: i64) -> i64:
            requires own >= 0
            ensure result == StudioCharacterBind::DIRECT
            StudioCharacterBind::mode(own, ancestor)

        def an_unbound_joint_follows_a_bound_ancestor(own: i64, ancestor: i64) -> i64:
            requires own < 0 and ancestor >= 0
            ensure result == StudioCharacterBind::INHERITED
            StudioCharacterBind::mode(own, ancestor)

        def an_orphan_joint_keeps_its_bind_pose(own: i64, ancestor: i64) -> i64:
            requires own < 0 and ancestor < 0
            ensure result == StudioCharacterBind::REST
            StudioCharacterBind::mode(own, ancestor)

        def full_binding_is_drawn(total: i64) -> bool:
            requires total > 0 and total <= 65535
            ensure result
            StudioCharacterBind::drawable(StudioCharacterBind::coverage(total, total))

        def no_binding_is_not_drawn(total: i64) -> bool:
            requires total >= 0 and total <= 65535
            ensure not result
            StudioCharacterBind::drawable(StudioCharacterBind::coverage(0, total))

        def coverage_is_monotone(bound: i64, total: i64) -> bool:
            requires bound >= 0 and bound < total and total <= 65535
            ensure result
            StudioCharacterBind::coverage(bound, total) <= StudioCharacterBind::coverage(bound + 1, total)
