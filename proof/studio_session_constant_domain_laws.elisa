include "../src/studio/state/session_state.elisa"

module StudioSessionConstantDomainLaws:
    public:
        def wire_tags_preserved() -> bool:
            ensure result
            SessionState::WireTag::FEET == 1 and SessionState::WireTag::OP == 2 and SessionState::WireTag::EDIT == 3 and SessionState::WireTag::FIX == 4 and SessionState::WireTag::HANDS == 5 and SessionState::WireTag::IDENTITY == 6 and SessionState::WireTag::BAND == 7 and SessionState::WireTag::ANNOTATION == 8 and SessionState::WireTag::IMPACT == 9

        def save_codes_preserved() -> bool:
            ensure result
            SessionState::SaveError.None.i64() == 0 and SessionState::SaveError.Path.i64() == 1 and SessionState::SaveError.Create.i64() == 2 and SessionState::SaveError.Write.i64() == 3 and SessionState::SaveError.Commit.i64() == 4 and SessionState::SaveError.Annotations.i64() == 5 and SessionState::SaveError.Impact.i64() == 6

        def load_codes_preserved() -> bool:
            ensure result
            SessionState::LoadError.None.i64() == 0 and SessionState::LoadError.Read.i64() == 1 and SessionState::LoadError.Format.i64() == 2 and SessionState::LoadError.Legacy.i64() == 3 and SessionState::LoadError.Source.i64() == 4 and SessionState::LoadError.Annotations.i64() == 5 and SessionState::LoadError.Impact.i64() == 6
