# Keyed offset laws: the curve passes through its keys, never overshoots
# them, is flat between equal keys, and adjacent segments meet at the key
# they share, so a keyed layer has no jumps.
include "../src/core/offset.elisa"

module KeyedLaws:
    public:
        # The curve starts on its first key.
        def starts_on_key(f0: i64, a0: i64, f1: i64, a1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires a0 >= -1000000000
            requires a0 <= 1000000000
            requires a1 >= -1000000000
            requires a1 <= 1000000000
            ensure result == a0
            return Offset::keyed(f0, f0, a0, f1, a1)

        # The curve ends on its last key.
        def ends_on_key(f0: i64, a0: i64, f1: i64, a1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires a0 >= -1000000000
            requires a0 <= 1000000000
            requires a1 >= -1000000000
            requires a1 <= 1000000000
            ensure result == a1
            return Offset::keyed(f1, f0, a0, f1, a1)

        # Equal keys hold a flat offset.
        def equal_keys_flat(frame: i64, f0: i64, f1: i64, a: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires frame >= f0
            requires frame <= f1
            requires a >= -1000000000
            requires a <= 1000000000
            ensure result == a
            return Offset::keyed(frame, f0, a, f1, a)

        # Zero keys leave the bone exactly as it was.
        def zero_keys_identity(frame: i64, f0: i64, f1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires frame >= f0
            requires frame <= f1
            ensure result == 0
            return Offset::keyed(frame, f0, 0, f1, 0)

        # A rising segment stays between its keys.
        def rising_bounded(frame: i64, f0: i64, a0: i64, f1: i64, a1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires frame >= f0
            requires frame <= f1
            requires a0 >= -1000000000
            requires a0 <= a1
            requires a1 <= 1000000000
            ensure result >= a0
            ensure result <= a1
            return Offset::keyed(frame, f0, a0, f1, a1)

        # A falling segment stays between its keys.
        def falling_bounded(frame: i64, f0: i64, a0: i64, f1: i64, a1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires frame >= f0
            requires frame <= f1
            requires a1 >= -1000000000
            requires a1 <= a0
            requires a0 <= 1000000000
            ensure result <= a0
            ensure result >= a1
            return Offset::keyed(frame, f0, a0, f1, a1)

        # A positive-keyed segment never turns the bone the other way.
        def positive_keys_positive(frame: i64, f0: i64, a0: i64, f1: i64, a1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires frame >= f0
            requires frame <= f1
            requires a0 >= 0
            requires a0 <= 1000000000
            requires a1 >= 0
            requires a1 <= 1000000000
            ensure result >= 0
            return Offset::keyed(frame, f0, a0, f1, a1)

        # Adjacent segments meet at their shared key: no jump in the curve.
        def segments_meet(f0: i64, a0: i64, f1: i64, a1: i64, f2: i64, a2: i64) -> bool:
            requires f0 >= 0
            requires f0 < f1
            requires f1 < f2
            requires f2 <= 10000000
            requires a0 >= -1000000000
            requires a0 <= 1000000000
            requires a1 >= -1000000000
            requires a1 <= 1000000000
            requires a2 >= -1000000000
            requires a2 <= 1000000000
            ensure result
            left: i64 = Offset::keyed(f1, f0, a0, f1, a1)
            right: i64 = Offset::keyed(f1, f1, a1, f2, a2)
            return left == right

        # The segment share starts at zero.
        def share_starts_zero(span: i64, length: i64) -> i64:
            requires span >= 0
            requires span <= 2000000000
            requires length >= 1
            requires length <= 10000000
            ensure result == 0
            return Offset::segment_share(span, 0, length)

        # The segment share ends at its span.
        def share_ends_full(span: i64, length: i64) -> i64:
            requires span >= 0
            requires span <= 2000000000
            requires length >= 1
            requires length <= 10000000
            ensure result == span
            return Offset::segment_share(span, length, length)

        # A flat segment share stays flat.
        def share_flat(into: i64, length: i64) -> i64:
            requires into >= 0
            requires into <= length
            requires length >= 1
            requires length <= 10000000
            ensure result == 0
            return Offset::segment_share(0, into, length)
