include "../src/core/bounded_path_policy.elisa"

module BoundedPathPolicyLaws:
    public:
        def missing_terminator(capacity: i64) -> bool:
            ensure result == false
            BoundedPathPolicy::admitted(-1, capacity)

        def full_payload(capacity: i64) -> bool:
            requires capacity > 0
            ensure result == false
            BoundedPathPolicy::admitted(capacity, capacity)

        def last_terminator(capacity: i64) -> bool:
            requires capacity > 0
            ensure result == true
            BoundedPathPolicy::admitted(capacity - 1, capacity)

        def empty_path(capacity: i64) -> bool:
            requires capacity > 0
            ensure result == true
            BoundedPathPolicy::admitted(0, capacity)

        def no_capacity(length: i64, capacity: i64) -> bool:
            requires capacity <= 0
            ensure result == false
            BoundedPathPolicy::admitted(length, capacity)

        # Runtime take replacement admits only a nonempty terminated payload.
        def retained_take_copy_bounds(length: i64, capacity: i64) -> bool:
            requires BoundedPathPolicy::nonempty_admitted(length, capacity)
            ensure result
            length >= 1 and length < capacity

        def empty_take_refused(capacity: i64) -> bool:
            ensure result == false
            BoundedPathPolicy::nonempty_admitted(0, capacity)
