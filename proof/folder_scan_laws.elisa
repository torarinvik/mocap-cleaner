include "../src/io/folder_scan_policy.elisa"

module FolderScanLaws:
    public:
        def empty_limit_is_rejected() -> bool:
            ensure not result
            FolderScanPolicy::limit_admitted(0)

        def oversize_limit_is_rejected() -> bool:
            ensure not result
            FolderScanPolicy::limit_admitted(4097)

        def minimum_record_is_admitted() -> bool:
            ensure result
            FolderScanPolicy::record_admitted(24, 1)

        def missing_terminator_space_is_rejected() -> bool:
            ensure not result
            FolderScanPolicy::record_admitted(24, 3)

        def oversize_record_is_rejected() -> bool:
            ensure not result
            FolderScanPolicy::record_admitted(1049, 1)

        def full_output_is_rejected() -> bool:
            ensure not result
            FolderScanPolicy::append_admitted(1, 1)

        def empty_output_can_append() -> bool:
            ensure result
            FolderScanPolicy::append_admitted(0, 1)
