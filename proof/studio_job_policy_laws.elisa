# A result can be applied only for the current revision and active generation.
include "../src/studio/job_policy.elisa"

module StudioJobPolicyLaws:
    public:
        def exact_active_result_is_allowed() -> bool:
            StudioJobPolicy::decision(8, 12, 8, 12) == StudioJobPolicy::APPLY

        def changed_document_revision_is_rejected() -> bool:
            StudioJobPolicy::decision(9, 12, 8, 12) == StudioJobPolicy::REJECT

        def superseded_job_generation_is_rejected() -> bool:
            StudioJobPolicy::decision(8, 13, 8, 12) == StudioJobPolicy::REJECT

        def inactive_job_is_rejected() -> bool:
            StudioJobPolicy::decision(8, 0, 8, 12) == StudioJobPolicy::REJECT

        def zero_result_generation_is_rejected() -> bool:
            StudioJobPolicy::decision(8, 12, 8, 0) == StudioJobPolicy::REJECT
