# A result can be applied only for the current revision and active generation.
include "../src/studio/job_policy.elisa"

module StudioJobPolicyLaws:
    public:
        def exact_active_result_is_allowed() -> bool:
            StudioJobPolicy::decision(8, 12, 8, 12) == StudioJobPolicy::Decision::APPLY

        def changed_document_revision_is_rejected() -> bool:
            StudioJobPolicy::decision(9, 12, 8, 12) == StudioJobPolicy::Decision::REJECT

        def superseded_job_generation_is_rejected() -> bool:
            StudioJobPolicy::decision(8, 13, 8, 12) == StudioJobPolicy::Decision::REJECT

        def inactive_job_is_rejected() -> bool:
            StudioJobPolicy::decision(8, 0, 8, 12) == StudioJobPolicy::Decision::REJECT

        def zero_result_generation_is_rejected() -> bool:
            StudioJobPolicy::decision(8, 12, 8, 0) == StudioJobPolicy::Decision::REJECT

        def cancelled_matching_result_is_rejected() -> bool:
            StudioJobPolicy::lifecycle_decision(8, 12, 8, 12, true) == StudioJobPolicy::Decision::REJECT

        def cancelled_result_preserves_last_valid(last_valid: i64, result_value: i64) -> bool:
            decision: i64 = StudioJobPolicy::lifecycle_decision(8, 12, 8, 12, true)
            StudioJobPolicy::publish_value(last_valid, result_value, decision) == last_valid

        def superseded_queued_result_preserves_last_valid(last_valid: i64, result_value: i64,
                                                         old_generation: i64, new_generation: i64) -> bool:
            requires old_generation > 0 and new_generation > old_generation
            decision: i64 = StudioJobPolicy::lifecycle_decision(8, new_generation, 8, old_generation, false)
            decision == StudioJobPolicy::Decision::REJECT and StudioJobPolicy::publish_value(last_valid, result_value, decision) == last_valid

        def stale_revision_preserves_last_valid(last_valid: i64, result_value: i64,
                                                displayed_revision: i64, result_revision: i64,
                                                generation: i64) -> bool:
            requires displayed_revision >= 0 and result_revision >= 0
            requires displayed_revision != result_revision and generation > 0
            decision: i64 = StudioJobPolicy::lifecycle_decision(displayed_revision, generation, result_revision, generation, false)
            decision == StudioJobPolicy::Decision::REJECT and StudioJobPolicy::publish_value(last_valid, result_value, decision) == last_valid

        def only_accepted_result_replaces_last_valid(last_valid: i64, result_value: i64) -> bool:
            decision: i64 = StudioJobPolicy::lifecycle_decision(8, 12, 8, 12, false)
            decision == StudioJobPolicy::Decision::APPLY and StudioJobPolicy::publish_value(last_valid, result_value, decision) == result_value
