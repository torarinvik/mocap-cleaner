# Exact frame nudges preserve inclusive contact range invariants.
include "../src/studio/contact_editor.elisa"

module StudioContactNudgeLaws:
    public:
        def accepted_nudge_preserves_clip_bounds(first: i64, last: i64, frame_count: i64, target: i64, delta: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactEditor::Limit::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(first, last, frame_count, target, delta)
            p.first >= 0 and p.first <= p.last and p.last < frame_count

        def rejected_nudge_is_atomic(first: i64, last: i64, frame_count: i64, target: i64, delta: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactEditor::Limit::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(first, last, frame_count, target, delta)
            p.valid or (p.first == first and p.last == last)

        def accepted_nudge_moves_exactly(first: i64, last: i64, frame_count: i64, target: i64, delta: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactEditor::Limit::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactEditor::NudgePlan = StudioContactEditor::nudge_plan(first, last, frame_count, target, delta)
            not p.valid or (target == StudioContactEditor::NudgeTarget.First.i64() and p.first == first + delta and p.last == last) or (target == StudioContactEditor::NudgeTarget.Last.i64() and p.first == first and p.last == last + delta) or (target == StudioContactEditor::NudgeTarget.Interval.i64() and p.first == first + delta and p.last == last + delta)
