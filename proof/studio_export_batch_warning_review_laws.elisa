include "../src/studio/export_batch_warning_review_policy.elisa"

module StudioExportBatchWarningReviewLaws:
    public:
        def refresh_changes_review_epoch(epoch: i64) -> bool:
            requires epoch >= 0 and epoch < StudioExportBatchWarningReviewPolicy::Domain::MAX_EPOCH
            ensure result
            StudioExportBatchWarningReviewPolicy::next_epoch(epoch) > epoch

        def exhausted_epoch_does_not_wrap() -> bool:
            ensure result
            StudioExportBatchWarningReviewPolicy::next_epoch(StudioExportBatchWarningReviewPolicy::Domain::MAX_EPOCH) == -1

        def exhausted_epoch_stays_unavailable() -> bool:
            ensure result
            StudioExportBatchWarningReviewPolicy::next_epoch(-1) == -1

        def changed_attempt_refuses_ack(captured: StudioExportBatchWarningReviewPolicy::Ticket,
                observed: StudioExportBatchWarningReviewPolicy::Ticket) -> bool:
            requires captured.attempt != observed.attempt
            ensure result
            not StudioExportBatchWarningReviewPolicy::acknowledge_admitted(captured, observed, true, true, 1, true)

        def changed_row_refuses_ack(captured: StudioExportBatchWarningReviewPolicy::Ticket,
                observed: StudioExportBatchWarningReviewPolicy::Ticket) -> bool:
            requires captured.index != observed.index
            ensure result
            not StudioExportBatchWarningReviewPolicy::acknowledge_admitted(captured, observed, true, true, 1, true)

        def refreshed_queue_refuses_ack(captured: StudioExportBatchWarningReviewPolicy::Ticket,
                observed: StudioExportBatchWarningReviewPolicy::Ticket) -> bool:
            requires captured.epoch != observed.epoch
            ensure result
            not StudioExportBatchWarningReviewPolicy::acknowledge_admitted(captured, observed, true, true, 1, true)

        def incomplete_report_refuses_ack(captured: StudioExportBatchWarningReviewPolicy::Ticket,
                observed: StudioExportBatchWarningReviewPolicy::Ticket) -> bool:
            ensure result
            not StudioExportBatchWarningReviewPolicy::acknowledge_admitted(captured, observed, true, false, 1, true)

        def explicit_review_is_required(captured: StudioExportBatchWarningReviewPolicy::Ticket,
                observed: StudioExportBatchWarningReviewPolicy::Ticket) -> bool:
            ensure result
            not StudioExportBatchWarningReviewPolicy::acknowledge_admitted(captured, observed, true, true, 1, false)
