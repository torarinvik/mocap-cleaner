# Laws for issue grouping boundaries, source identity and deterministic peaks.
include "../src/studio/issues.elisa"

module StudioIssueLaws:
    public:
        def adjacent_frame_merges(last_frame: i64) -> bool:
            requires last_frame >= 0
            ensure result
            return StudioIssues::adjacent(last_frame, last_frame + 1)

        def skipped_frame_splits(last_frame: i64) -> bool:
            requires last_frame >= 0
            requires last_frame <= 10000000
            ensure not result
            return StudioIssues::adjacent(last_frame, last_frame + 2)

        def revision_change_splits(issue_type: i64, subject: i64, revision: i64) -> bool:
            requires issue_type >= 0
            requires subject >= -1
            requires revision >= 0
            requires revision <= 10000000
            ensure not result
            return StudioIssues::same_identity(issue_type, subject, revision, issue_type, subject, revision + 1)

        def subject_change_splits(issue_type: i64, subject: i64, revision: i64) -> bool:
            requires issue_type >= 0
            requires subject >= -1
            requires subject <= 10000000
            requires revision >= 0
            ensure not result
            return StudioIssues::same_identity(issue_type, subject, revision, issue_type, subject + 1, revision)

        def greater_severity_wins() -> bool:
            ensure result
            return StudioIssues::peak_wins(500, 101, 100, 3, 400, 900, 100, 2)

        def equal_peak_keeps_earlier() -> bool:
            ensure not result
            return StudioIssues::peak_wins(400, 120, 100, 3, 400, 120, 100, 2)
