include "../src/io/report_diff.elisa"

# Exercise the reader's private declaration states without exposing them in
# its runtime public API.
extend ReportDiff:
    public:
        def missing_unit_is_not_present() -> bool:
            ensure not result
            unit_present(MetadataDeclaration.Missing)

        def invalid_unit_is_not_present() -> bool:
            ensure not result
            unit_present(MetadataDeclaration.Invalid)

        def invalid_unit_is_invalid() -> bool:
            ensure result
            unit_invalid(MetadataDeclaration.Invalid)

        def present_unit_is_present(index: usize) -> bool:
            ensure result
            unit_present(MetadataDeclaration.Present(index))

        def present_unit_is_not_invalid(index: usize) -> bool:
            ensure not result
            unit_invalid(MetadataDeclaration.Present(index))
