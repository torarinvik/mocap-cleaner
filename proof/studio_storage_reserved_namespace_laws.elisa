include "../src/studio/io/storage_reserved_namespace.elisa"

module StudioStorageReservedNamespaceLaws:
    public:
        def unexpected_native_result_is_unknown(raw: i32) -> bool:
            requires raw != 0 and raw != 1
            ensure result
            StudioStorageReservedNamespace::normalize(raw) == StudioStorageReservedNamespace::Outcome.Unknown.i64()

        def different_requires_exact_native_zero(raw: i32) -> bool:
            requires raw != 0
            ensure result
            StudioStorageReservedNamespace::normalize(raw) != StudioStorageReservedNamespace::Outcome.Different.i64()

        def match_requires_exact_native_one(raw: i32) -> bool:
            requires raw != 1
            ensure result
            StudioStorageReservedNamespace::normalize(raw) != StudioStorageReservedNamespace::Outcome.Match.i64()
