include "../src/studio/status_text_extent_policy.elisa"

module StudioStatusTextExtentPolicyLaws:
    public:
        def admitted_is_bounded(count: i64, has_data: bool) -> bool:
            ensure result == true
            not StudioStatusTextExtentPolicy::admitted(count, has_data) or count >= 0 and count <= 128

        def nonempty_admission_requires_storage(count: i64) -> bool:
            ensure result == true
            count <= 0 or not StudioStatusTextExtentPolicy::admitted(count, false)

        def invalid_count_is_refused(count: i64, has_data: bool) -> bool:
            requires count < 0 or count > 128
            ensure result == true
            not StudioStatusTextExtentPolicy::admitted(count, has_data)
