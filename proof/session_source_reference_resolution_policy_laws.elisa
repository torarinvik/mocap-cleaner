include "../src/studio/session_source_reference_resolution_policy.elisa"

module StudioSessionSourceReferenceResolutionPolicyLaws:
    def verified_legacy_glb_restores_without_fabricated_digest() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.LegacyGlb,
            StudioSessionSourceReferenceResolutionPolicy::Match.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::Cache.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Unavailable) == StudioSessionSourceReferenceResolutionPolicy::Resolution.RestoreLegacyGlb

    def legacy_glb_refuses_any_claimed_unverified_source() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.LegacyGlb,
            StudioSessionSourceReferenceResolutionPolicy::Match.Unknown,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::Cache.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Unavailable) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected

    def direct_glb_requires_verified_original_runtime_and_tag6() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.DirectGlb,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Unavailable) == StudioSessionSourceReferenceResolutionPolicy::Resolution.LoadDirectGlb
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.DirectGlb,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.NotApplicable,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Unavailable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected

    def changed_or_unknown_fbx_importer_never_reuses_or_regenerates() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Changed,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Unknown,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Unavailable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected

    def verified_fbx_cache_is_reused_only_after_all_bindings_match() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Unavailable) == StudioSessionSourceReferenceResolutionPolicy::Resolution.ReuseFbxCache
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Changed,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected

    def cache_miss_requires_verified_workspace_for_regeneration() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Unavailable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.RegenerateFbx
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Unavailable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Unavailable) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected
        # Conversion planning does not claim that saved edits or animation
        # binding are valid. Those facts are checked against the regenerated
        # memo before applying session edits.
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Unknown,
            StudioSessionSourceReferenceResolutionPolicy::Match.Unknown,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Unavailable,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.RegenerateFbx
        assert not StudioSessionSourceReferenceResolutionPolicy::regeneration_verified(
            StudioSessionSourceReferenceResolutionPolicy::Resolution.RegenerateFbx,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Unknown,
            StudioSessionSourceReferenceResolutionPolicy::Match.Unknown)

    def regeneration_requires_matching_runtime_digest_and_bindings() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::regeneration_verified(
            StudioSessionSourceReferenceResolutionPolicy::Resolution.RegenerateFbx,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified)
        assert not StudioSessionSourceReferenceResolutionPolicy::regeneration_verified(
            StudioSessionSourceReferenceResolutionPolicy::Resolution.RegenerateFbx,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::Match.Changed,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified)
        assert not StudioSessionSourceReferenceResolutionPolicy::regeneration_verified(
            StudioSessionSourceReferenceResolutionPolicy::Resolution.ReuseFbxCache,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified)

    def uncertain_animation_or_identity_is_protected() -> void:
        assert StudioSessionSourceReferenceResolutionPolicy::decide(
            StudioSessionSourceReferenceResolutionPolicy::Format.FbxDerived,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Match.Unknown,
            StudioSessionSourceReferenceResolutionPolicy::ProcessingIdentity.Current,
            StudioSessionSourceReferenceResolutionPolicy::DigestRecord.Valid,
            StudioSessionSourceReferenceResolutionPolicy::Cache.Verified,
            StudioSessionSourceReferenceResolutionPolicy::Workspace.Ready) == StudioSessionSourceReferenceResolutionPolicy::Resolution.Protected
