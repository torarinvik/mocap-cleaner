# Window laws: every window contains its frame, stays inside the clip, and is
# no wider than 2r+1; radius 0 is the identity window.
include "../src/core/window.elisa"
include "../src/core/fade.elisa"

module WindowLaws:
    public:
        def starts_at_or_before(frame: i64, radius: i64) -> i64:
            requires frame >= 0
            requires frame < Window::MAX_FRAMES
            requires radius >= 0
            requires radius <= Window::MAX_RADIUS
            ensure result >= 0
            ensure result <= radius
            return frame - Window::low(frame, radius)

        def ends_at_or_after(frame: i64, radius: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Window::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            requires radius >= 0
            requires radius <= Window::MAX_RADIUS
            ensure result >= 0
            ensure result <= radius
            return Window::high(frame, radius, count) - frame

        def bounded_width(frame: i64, radius: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Window::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            requires radius >= 0
            requires radius <= Window::MAX_RADIUS
            ensure result >= 1
            ensure result <= 2 * radius + 1
            a: i64 = Window::low(frame, radius)
            b: i64 = Window::high(frame, radius, count)
            return b - a + 1

        def zero_radius_low(frame: i64) -> i64:
            requires frame >= 0
            requires frame < Window::MAX_FRAMES
            ensure result == frame
            return Window::low(frame, 0)

        def zero_radius_high(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Window::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            ensure result == frame
            return Window::high(frame, 0, count)

        def middle_splits_evenly(size: i64) -> i64:
            requires size >= 1
            requires size <= 2 * Window::MAX_RADIUS + 1
            ensure result >= 0
            ensure result <= 1
            m: i64 = Window::middle(size)
            return (size - 1 - m) - m

        def mirror_indexes(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Window::MAX_FRAMES
            requires frame > -count
            requires frame < 2 * count - 1
            requires frame > -Window::MAX_FRAMES
            requires frame < 2 * Window::MAX_FRAMES
            ensure result >= 0
            ensure result < count
            return Window::mirror(frame, count)

        def mirror_keeps_inside(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Window::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            ensure result == frame
            return Window::mirror(frame, count)

        def mirror_before_start(back: i64, count: i64) -> i64:
            requires count >= 2
            requires count <= Window::MAX_FRAMES
            requires back >= 1
            requires back < count
            ensure result == back
            frame: i64 = 0 - back
            return Window::mirror(frame, count)

        def reflect_end_is_end(end: i64) -> i64:
            requires end >= -1000000000
            requires end <= 1000000000
            ensure result == end
            return Window::reflect(end, end, 1000000000)

        def reflect_bounded(end: i64, mirrored: i64) -> i64:
            requires end >= -1000000000
            requires end <= 1000000000
            requires mirrored >= -1000000000
            requires mirrored <= 1000000000
            ensure result >= -1000000000
            ensure result <= 1000000000
            return Window::reflect(end, mirrored, 1000000000)

        def eased_fade_in_range(linear: i64) -> i64:
            requires linear >= 0
            requires linear <= Fade::FULL
            ensure result >= 0
            ensure result <= Fade::FULL
            return Fade::ease(linear)
