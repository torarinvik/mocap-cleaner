include "../src/studio/state/package_publication_rollback_policy.elisa"

module StudioPackagePublicationRollbackLaws:
    public:
        def verified_first_move_can_restore_previous() -> bool:
            ensure result
            StudioPackagePublicationRollbackPolicy::may_restore_previous(true, true, true, true, true, true)

        def published_new_bundle_refuses_rollback() -> bool:
            ensure not result
            StudioPackagePublicationRollbackPolicy::may_restore_previous(true, false, true, true, true, true)

        def occupied_current_refuses_rollback() -> bool:
            ensure not result
            StudioPackagePublicationRollbackPolicy::may_restore_previous(true, true, false, true, true, true)

        def changed_identity_refuses_rollback() -> bool:
            ensure not result
            StudioPackagePublicationRollbackPolicy::may_restore_previous(true, true, true, false, true, true)

        def changed_seal_refuses_rollback() -> bool:
            ensure not result
            StudioPackagePublicationRollbackPolicy::may_restore_previous(true, true, true, true, false, true)

        def missing_locks_refuses_rollback() -> bool:
            ensure not result
            StudioPackagePublicationRollbackPolicy::may_restore_previous(true, true, true, true, true, false)
