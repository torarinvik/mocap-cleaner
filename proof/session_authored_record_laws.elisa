include "../src/studio/state/session_state.elisa"

module SessionAuthoredRecordLaws:
    public:
        def feet_shape_refused(count: usize) -> bool:
            requires count != 3
            ensure result
            not SessionState::authored_record_shape_valid(SessionState::WireTag::FEET, count)

        def hands_shape_refused(count: usize) -> bool:
            requires count != 2
            ensure result
            not SessionState::authored_record_shape_valid(SessionState::WireTag::HANDS, count)

        def operation_shape_refused(count: usize) -> bool:
            requires count != 8
            ensure result
            not SessionState::authored_record_shape_valid(SessionState::WireTag::OP, count)

        def contact_shape_refused(count: usize) -> bool:
            requires count != 5
            ensure result
            not SessionState::authored_record_shape_valid(SessionState::WireTag::EDIT, count)

        def correction_shape_refused(count: usize) -> bool:
            requires count != 13
            ensure result
            not SessionState::authored_record_shape_valid(SessionState::WireTag::FIX, count)

        def band_shape_refused(count: usize) -> bool:
            requires count != 6
            ensure result
            not SessionState::authored_record_shape_valid(SessionState::WireTag::BAND, count)

        def correction_shape_admitted() -> bool:
            ensure result
            SessionState::authored_record_shape_valid(SessionState::WireTag::FIX, 13)
