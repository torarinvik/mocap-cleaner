include "../src/ops/rig_stack.elisa"
include "../src/physics/balance_inputs.elisa"

module PhysicsBalanceInputLaws:
    public:
        def stationary_supported_com_is_admitted() -> bool:
            ensure result
            coms: darray[MotionQuat::V] = [Rig::v(0.0, 1.0, 0.0), Rig::v(0.0, 1.0, 0.0), Rig::v(0.0, 1.0, 0.0)]
            PhysicsBalanceInputs::capture_admitted(&coms, 0, 30.0, 9.81)

        def out_of_domain_capture_is_unavailable() -> bool:
            ensure result
            coms: darray[MotionQuat::V] = [Rig::v(-1000.0, 1.0, 0.0), Rig::v(0.0, 1.0, 0.0), Rig::v(1000.0, 1.0, 0.0)]
            not PhysicsBalanceInputs::capture_admitted(&coms, 0, 30.0, 9.81)

        def nonfinite_com_is_unavailable() -> bool:
            ensure result
            nan: f64 = 0.0 / 0.0
            coms: darray[MotionQuat::V] = [Rig::v(0.0, 1.0, 0.0), Rig::v(nan, 1.0, 0.0), Rig::v(0.0, 1.0, 0.0)]
            not PhysicsBalanceInputs::capture_admitted(&coms, 0, 30.0, 9.81)
