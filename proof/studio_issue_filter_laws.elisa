# Laws for inclusive fixed-point issue filters and unknown aggregate subjects.
include "../src/studio/issue_filter_policy.elisa"

module StudioIssueFilterLaws:
    public:
        def disposition_codes_preserve_filter_encoding() -> bool:
            ensure result
            StudioIssueFilterPolicy::Disposition.Unresolved.i64() == 0 and StudioIssueFilterPolicy::Disposition.Ignored.i64() == 1 and StudioIssueFilterPolicy::Disposition.Any.i64() == 2

        def exact_detector_is_selected(detector: i64) -> bool:
            requires detector >= 0
            ensure result
            StudioIssueFilterPolicy::detector_matches(detector, detector)

        def detector_wildcard_keeps_any_type(detector: i64) -> bool:
            requires detector >= 0
            ensure result
            StudioIssueFilterPolicy::detector_matches(detector, StudioIssueFilterPolicy::Wildcard::DETECTOR)

        def exact_subject_excludes_unknown(subject: i64) -> bool:
            requires subject >= 0
            ensure result == (not StudioIssueFilterPolicy::subject_matches(-1, subject))
            not StudioIssueFilterPolicy::subject_matches(-1, subject)

        def any_subject_keeps_unknown() -> bool:
            ensure result
            StudioIssueFilterPolicy::subject_matches(-1, StudioIssueFilterPolicy::Wildcard::SUBJECT)

        def severity_boundary_is_inclusive(level: i64) -> bool:
            requires level >= 0
            requires level <= StudioIssueFilterPolicy::Severity::MAX
            ensure result
            StudioIssueFilterPolicy::severity_matches(level, level)

        def ignored_and_unresolved_are_distinct() -> bool:
            ensure not result
            StudioIssueFilterPolicy::status_matches(StudioIssueFilterPolicy::Disposition.Ignored.i64(), StudioIssueFilterPolicy::Disposition.Unresolved.i64())
