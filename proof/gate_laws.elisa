# Laws of the operation stack, stated as composed obligations over the
# verified summaries of Gate and Fade. Each law is reusable by callers.
include "../src/core/gate.elisa"

module GateLaws:
    public:
        const BOUND: i64 = 1000000000

        # A disabled operation is the identity on every frame.
        def disabled_is_identity(source: i64, fixed: i64, in_range: bool, selected: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::Domain::FULL_PERMILLE
            requires source >= -BOUND
            requires source <= BOUND
            requires fixed >= -BOUND
            requires fixed <= BOUND
            ensure result == source
            w: i64 = Gate::weight(false, in_range, selected, fade)
            return Gate::apply(source, fixed, w)

        # Frames outside an operation's span are unchanged.
        def outside_is_identity(source: i64, fixed: i64, enabled: bool, selected: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::Domain::FULL_PERMILLE
            requires source >= -BOUND
            requires source <= BOUND
            requires fixed >= -BOUND
            requires fixed <= BOUND
            ensure result == source
            w: i64 = Gate::weight(enabled, false, selected, fade)
            return Gate::apply(source, fixed, w)

        # Unselected bones are unchanged.
        def unselected_is_identity(source: i64, fixed: i64, enabled: bool, in_range: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::Domain::FULL_PERMILLE
            requires source >= -BOUND
            requires source <= BOUND
            requires fixed >= -BOUND
            requires fixed <= BOUND
            ensure result == source
            w: i64 = Gate::weight(enabled, in_range, false, fade)
            return Gate::apply(source, fixed, w)

        # A fully weighted, enabled, in-range, selected operation yields its fix.
        def full_weight_is_fix(source: i64, fixed: i64) -> i64:
            requires source >= -BOUND
            requires source <= BOUND
            requires fixed >= -BOUND
            requires fixed <= BOUND
            ensure result == fixed
            w: i64 = Gate::weight(true, true, true, Fade::Domain::FULL_PERMILLE)
            return Gate::apply(source, fixed, w)

        # Clip boundaries equal the source exactly (edge fade is zero there).
        def first_frame_is_source(source: i64, fixed: i64, last: i64, edge: i64) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            requires source >= -BOUND
            requires source <= BOUND
            requires fixed >= -BOUND
            requires fixed <= BOUND
            ensure result == source
            w: i64 = Fade::weight(0, last, edge, false)
            return Gate::apply(source, fixed, w)

        def last_frame_is_source(source: i64, fixed: i64, last: i64, edge: i64) -> i64:
            requires last >= 0
            requires last < Fade::Domain::MAX_FRAMES
            requires edge >= 1
            requires edge <= Fade::Domain::MAX_EDGE
            requires source >= -BOUND
            requires source <= BOUND
            requires fixed >= -BOUND
            requires fixed <= BOUND
            ensure result == source
            w: i64 = Fade::weight(last, last, edge, false)
            return Gate::apply(source, fixed, w)
