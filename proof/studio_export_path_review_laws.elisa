# Inspector page and focus behavior stays within the visible, enabled actions.
include "../src/studio/export_path_review.elisa"

module StudioExportPathReviewLaws:
    public:
        def opens_on_next_for_long_path() -> bool:
            ensure result
            StudioExportPathReview::initial_focus(0, 3) == StudioExportPathReview::Control.Next.i64()

        def opens_on_done_for_short_path() -> bool:
            ensure result
            StudioExportPathReview::initial_focus(0, 1) == StudioExportPathReview::Control.Done.i64()

        def first_page_skips_disabled_previous() -> bool:
            ensure result
            StudioExportPathReview::move_focus(StudioExportPathReview::Control.Next.i64(), -1, 0, 3) == StudioExportPathReview::Control.Done.i64()

        def middle_page_visits_all_actions() -> bool:
            ensure result
            StudioExportPathReview::move_focus(StudioExportPathReview::Control.Next.i64(), 1, 1, 3) == StudioExportPathReview::Control.Done.i64() and StudioExportPathReview::move_focus(StudioExportPathReview::Control.Done.i64(), 1, 1, 3) == StudioExportPathReview::Control.Previous.i64()

        def last_page_skips_disabled_next() -> bool:
            ensure result
            StudioExportPathReview::move_focus(StudioExportPathReview::Control.Previous.i64(), 1, 2, 3) == StudioExportPathReview::Control.Done.i64()

        def page_navigation_clamps_at_ends() -> bool:
            ensure result
            StudioExportPathReview::move_page(0, -1, 3) == 0 and StudioExportPathReview::move_page(2, 1, 3) == 2

        def page_navigation_moves_one_step() -> bool:
            ensure result
            StudioExportPathReview::move_page(1, 1, 3) == 2 and StudioExportPathReview::move_page(1, -1, 3) == 0
