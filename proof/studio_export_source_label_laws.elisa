include "../src/studio/export_source_label_policy.elisa"

module StudioExportSourceLabelLaws:
    public:
        def slash_separates() -> bool:
            ensure result
            StudioExportSourceLabelPolicy::separator(47)

        def backslash_is_preserved() -> bool:
            ensure not result
            StudioExportSourceLabelPolicy::separator(92)

        def filename_bytes_are_preserved(value: u8) -> bool:
            requires value != 47
            ensure not result
            StudioExportSourceLabelPolicy::separator(value)
