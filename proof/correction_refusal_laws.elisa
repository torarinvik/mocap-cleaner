include "../src/ops/corrections.elisa"

# Exercise the public mutation boundary, including document bytes and edit count.
# These obligations still require replay by the current authenticated prover.
module CorrectionRefusalLaws:
    public:
        def disabled_keeps_document(doc: mutable GlbDocument::Document&, anim: usize, c: Corrections::Correction&) -> bool:
            requires not c.enabled
            ensure result
            before: GlbDocument::Document = GlbDocument::copy(doc)
            edits: usize = GlbDocument::edit_count(doc)
            changed: i64 = Corrections::apply(doc, anim, c)
            changed == 0 and GlbDocument::first_difference(doc, &before) == -1 and GlbDocument::edit_count(doc) == edits

        def invalid_scope_keeps_document(doc: mutable GlbDocument::Document&, anim: usize, c: Corrections::Correction&) -> bool:
            requires c.enabled
            requires not CorrectionScopePolicy::valid(c.node, c.first, c.key, c.last)
            ensure result
            before: GlbDocument::Document = GlbDocument::copy(doc)
            edits: usize = GlbDocument::edit_count(doc)
            changed: i64 = Corrections::apply(doc, anim, c)
            changed == -1 and GlbDocument::first_difference(doc, &before) == -1 and GlbDocument::edit_count(doc) == edits

        def invalid_transform_keeps_document(doc: mutable GlbDocument::Document&, anim: usize, c: Corrections::Correction&) -> bool:
            requires c.enabled
            requires not Corrections::transform_admitted(c)
            ensure result
            before: GlbDocument::Document = GlbDocument::copy(doc)
            edits: usize = GlbDocument::edit_count(doc)
            changed: i64 = Corrections::apply(doc, anim, c)
            changed == -1 and GlbDocument::first_difference(doc, &before) == -1 and GlbDocument::edit_count(doc) == edits

        def invalid_outputs_keep_document(doc: mutable GlbDocument::Document&, anim: usize, c: Corrections::Correction&) -> bool:
            requires c.enabled
            requires not Corrections::outputs_admitted(doc, anim, c)
            ensure result
            before: GlbDocument::Document = GlbDocument::copy(doc)
            edits: usize = GlbDocument::edit_count(doc)
            changed: i64 = Corrections::apply(doc, anim, c)
            changed == -1 and GlbDocument::first_difference(doc, &before) == -1 and GlbDocument::edit_count(doc) == edits
