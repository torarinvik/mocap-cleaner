include "../src/physics/contact_inputs.elisa"

module PhysicsContactUnitLaws:
    public:
        def one_metre_contact_thresholds_keep_hysteresis() -> bool:
            ensure result
            enter: i64 = PhysicsLengthBoundary::from_metres(1.0 * 0.05)
            leave: i64 = PhysicsLengthBoundary::from_metres(1.0 * 0.08)
            speed: i64 = PhysicsLengthBoundary::speed_from_metres_per_second(1.0 * 0.5)
            enter == 500 and leave == 800 and speed == 5000 and PhysicsContactInputs::thresholds_admitted(1.0)

        def subprecision_contact_thresholds_are_unavailable() -> bool:
            ensure result
            not PhysicsContactInputs::thresholds_admitted(0.00002)

        def ordinary_leg_scale_remains_admitted() -> bool:
            ensure result
            PhysicsContactInputs::thresholds_admitted(0.9)
