include "../src/studio/state/generation_restore_worker_policy.elisa"

module StudioGenerationRestoreWorkerLaws:
    public:
        def owned_handle_cannot_be_discarded(handle: i64) -> bool:
            requires handle != 0
            ensure not result
            StudioGenerationRestoreWorkerPolicy::may_discard_reply(handle)

        def closed_reply_can_be_discarded() -> bool:
            ensure result
            StudioGenerationRestoreWorkerPolicy::may_discard_reply(0)

        def cancelled_result_not_published(ticket: i64) -> bool:
            ensure not result
            StudioGenerationRestoreWorkerPolicy::accept_result(ticket, ticket, true)

        def stale_result_not_published(ticket: i64, current: i64) -> bool:
            requires ticket != current
            ensure not result
            StudioGenerationRestoreWorkerPolicy::accept_result(ticket, current, false)

        def current_result_admitted(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            StudioGenerationRestoreWorkerPolicy::accept_result(ticket, ticket, false)

        def retained_handle_refuses_success(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                                           release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                                           recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome,
                                           details: bool, handle: i64) -> bool:
            requires handle != 0
            ensure not result
            StudioGenerationRestoreWorkerPolicy::restored(commit, release, recovery, details, handle)

        def missing_details_refuses_success(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                                           release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                                           recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome) -> bool:
            ensure not result
            StudioGenerationRestoreWorkerPolicy::restored(commit, release, recovery, false, 0)

        def unconfirmed_release_refuses_success(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                                               release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                                               recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome) -> bool:
            requires not StudioGenerationHandlePolicy::release_certain(release)
            ensure not result
            StudioGenerationRestoreWorkerPolicy::restored(commit, release, recovery, true, 0)
