include "../src/studio/session_save_source_job_policy.elisa"

module StudioSessionSaveSourceJobLaws:
    def reply_requires_current_request_and_document() -> void:
        assert StudioSessionSaveSourceJobPolicy::reply(7, 7, false, true, true, true, true, true, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Publish
        assert StudioSessionSaveSourceJobPolicy::reply(6, 7, false, true, true, true, true, true, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse
        assert StudioSessionSaveSourceJobPolicy::reply(7, 7, false, false, true, true, true, true, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse
        assert StudioSessionSaveSourceJobPolicy::reply(7, 7, false, true, false, true, true, true, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse

    def cancellation_pending_edit_and_failed_worker_refuse_publish() -> void:
        assert StudioSessionSaveSourceJobPolicy::reply(1, 1, true, true, true, true, true, true, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse
        assert StudioSessionSaveSourceJobPolicy::reply(1, 1, false, true, true, true, true, true, false, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse
        assert StudioSessionSaveSourceJobPolicy::reply(1, 1, false, true, true, true, true, true, true, false) == StudioSessionSaveSourceJobPolicy::Reply.Refuse

    def changed_runtime_binding_refuses_source_reply() -> void:
        assert StudioSessionSaveSourceJobPolicy::reply(4, 4, false, true, true, true, true, false, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse

    def changed_document_generation_refuses_reply() -> void:
        assert StudioSessionSaveSourceJobPolicy::reply(5, 5, false, true, true, false, true, true, true, true) == StudioSessionSaveSourceJobPolicy::Reply.Refuse
