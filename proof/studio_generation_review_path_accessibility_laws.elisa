include "../src/studio/state/generation_review_path_policy.elisa"
include "../src/studio/state/generation_review_accessibility_policy.elisa"

module StudioGenerationReviewPathAccessibilityLaws:
    public:
        def inspect_button_identity_matches_action() -> bool:
            ensure StudioGenerationReviewPathPolicy::Node::INSPECT == StudioGenerationReviewAccessibilityPolicy::Node::INSPECT_PATH
            StudioGenerationReviewPathPolicy::Node::INSPECT == StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.InspectPath)

        def path_line_range_precedes_controls() -> bool:
            ensure StudioGenerationReviewPathPolicy::Node::LINE_FIRST + StudioGenerationReviewPathPolicy::Node::LINE_COUNT.usize() == StudioGenerationReviewPathPolicy::Node::PREVIOUS
            StudioGenerationReviewPathPolicy::Node::PREVIOUS < StudioGenerationReviewPathPolicy::Node::NEXT and StudioGenerationReviewPathPolicy::Node::NEXT < StudioGenerationReviewPathPolicy::Node::DONE

        def path_controls_avoid_no_node_sentinel() -> bool:
            ensure StudioGenerationReviewPathPolicy::Node::DIALOG != StudioAccessibility::SemanticId::NO_NODE
            StudioGenerationReviewPathPolicy::Node::PREVIOUS != StudioAccessibility::SemanticId::NO_NODE and StudioGenerationReviewPathPolicy::Node::NEXT != StudioAccessibility::SemanticId::NO_NODE and StudioGenerationReviewPathPolicy::Node::DONE != StudioAccessibility::SemanticId::NO_NODE
