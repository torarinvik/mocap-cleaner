include "../src/studio/storage_overview_policy.elisa"

module StudioStorageOverviewPolicyLaws:
    public:
        def category_mapping_is_complete(verified_present: bool, verified_trash: bool, recovery: bool, eligible: bool) -> bool:
            ensure result
            StudioStorageOverviewPolicy::category(verified_present, verified_trash, recovery, eligible) == (StudioStorageOverviewPolicy::Category::TRASH if verified_trash else StudioStorageOverviewPolicy::Category::UNKNOWN if not verified_present else StudioStorageOverviewPolicy::Category::RECOVERY if recovery else StudioStorageOverviewPolicy::Category::ELIGIBLE if eligible else StudioStorageOverviewPolicy::Category::PROTECTED)

        def recovery_stays_protected_and_separate() -> bool:
            ensure result
            StudioStorageOverviewPolicy::is_present(StudioStorageOverviewPolicy::Category::RECOVERY) and StudioStorageOverviewPolicy::is_protected(StudioStorageOverviewPolicy::Category::RECOVERY) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::RECOVERY) and StudioStorageOverviewPolicy::known_bytes(StudioStorageOverviewPolicy::Category::RECOVERY)

        def unknown_category_has_no_numeric_bytes() -> bool:
            ensure result
            StudioStorageOverviewPolicy::unknown_bytes(StudioStorageOverviewPolicy::Category::UNKNOWN) and not StudioStorageOverviewPolicy::known_bytes(StudioStorageOverviewPolicy::Category::UNKNOWN) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::UNKNOWN)

        def trash_is_separate_from_present_and_recovery() -> bool:
            ensure result
            not StudioStorageOverviewPolicy::is_present(StudioStorageOverviewPolicy::Category::TRASH) and not StudioStorageOverviewPolicy::is_protected(StudioStorageOverviewPolicy::Category::TRASH) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::TRASH) and StudioStorageOverviewPolicy::known_bytes(StudioStorageOverviewPolicy::Category::TRASH)

        def only_eligible_category_can_cleanup() -> bool:
            ensure result
            StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::ELIGIBLE) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::PROTECTED) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::RECOVERY) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::TRASH) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::Category::UNKNOWN)
