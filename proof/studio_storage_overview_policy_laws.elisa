include "../src/studio/storage_overview_policy.elisa"

module StudioStorageOverviewPolicyLaws:
    public:
        def category_mapping_is_complete(verified_present: bool, verified_trash: bool, recovery: bool, eligible: bool) -> bool:
            ensure result
            StudioStorageOverviewPolicy::category(verified_present, verified_trash, recovery, eligible) == (StudioStorageOverviewPolicy::CATEGORY_TRASH if verified_trash else StudioStorageOverviewPolicy::CATEGORY_UNKNOWN if not verified_present else StudioStorageOverviewPolicy::CATEGORY_RECOVERY if recovery else StudioStorageOverviewPolicy::CATEGORY_ELIGIBLE if eligible else StudioStorageOverviewPolicy::CATEGORY_PROTECTED)

        def recovery_stays_protected_and_separate() -> bool:
            ensure result
            StudioStorageOverviewPolicy::is_present(StudioStorageOverviewPolicy::CATEGORY_RECOVERY) and StudioStorageOverviewPolicy::is_protected(StudioStorageOverviewPolicy::CATEGORY_RECOVERY) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_RECOVERY) and StudioStorageOverviewPolicy::known_bytes(StudioStorageOverviewPolicy::CATEGORY_RECOVERY)

        def unknown_category_has_no_numeric_bytes() -> bool:
            ensure result
            StudioStorageOverviewPolicy::unknown_bytes(StudioStorageOverviewPolicy::CATEGORY_UNKNOWN) and not StudioStorageOverviewPolicy::known_bytes(StudioStorageOverviewPolicy::CATEGORY_UNKNOWN) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_UNKNOWN)

        def trash_is_separate_from_present_and_recovery() -> bool:
            ensure result
            not StudioStorageOverviewPolicy::is_present(StudioStorageOverviewPolicy::CATEGORY_TRASH) and not StudioStorageOverviewPolicy::is_protected(StudioStorageOverviewPolicy::CATEGORY_TRASH) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_TRASH) and StudioStorageOverviewPolicy::known_bytes(StudioStorageOverviewPolicy::CATEGORY_TRASH)

        def only_eligible_category_can_cleanup() -> bool:
            ensure result
            StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_ELIGIBLE) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_PROTECTED) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_RECOVERY) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_TRASH) and not StudioStorageOverviewPolicy::may_cleanup(StudioStorageOverviewPolicy::CATEGORY_UNKNOWN)
