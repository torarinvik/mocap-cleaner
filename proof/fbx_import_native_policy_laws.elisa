include "../src/studio/fbx_import_native_policy.elisa"

module StudioFbxImportNativePolicyLaws:
    public:
        def admitted_outputs_are_terminated(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)
            ensure result
            (StudioFbxImportPolicy::terminated(snapshot, StudioFbxImportPolicy::Limit::PATH_BYTES) and
                StudioFbxImportPolicy::terminated(destination, StudioFbxImportPolicy::Limit::PATH_BYTES))

        def admitted_outputs_have_bounded_paths(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)
            ensure result
            (snapshot.count > 1 and snapshot.count.i64() <= StudioFbxImportPolicy::Limit::PATH_BYTES and
                destination.count > 1 and destination.count.i64() <= StudioFbxImportPolicy::Limit::PATH_BYTES)

        def malformed_digest_is_refused(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires not StudioTakeSourceRefPolicy::sha256_valid(digest)
            ensure result
            not StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)

        def original_destination_is_refused(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires StudioFbxImportPolicy::same_path(source, destination)
            ensure result
            not StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)

        def original_snapshot_is_refused(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires StudioFbxImportPolicy::same_path(source, snapshot)
            ensure result
            not StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)

        def snapshot_destination_is_refused(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires StudioFbxImportPolicy::same_path(snapshot, destination)
            ensure result
            not StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)

        def oversized_destination_is_refused(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            requires destination.count.i64() > StudioFbxImportPolicy::Limit::PATH_BYTES
            ensure result
            not StudioFbxImportNativePolicy::staging_output_valid(source, snapshot, destination, digest)

        def empty_snapshot_is_refused(source: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            ensure result
            mutable snapshot: darray[u8] = []
            not StudioFbxImportNativePolicy::staging_output_valid(source, &snapshot, destination, digest)
