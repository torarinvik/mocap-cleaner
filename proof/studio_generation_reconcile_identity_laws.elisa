include "../src/studio/state/generation_reconcile_identity_policy.elisa"

module StudioGenerationReconcileIdentityLaws:
    public:
        def unavailable_flag_clears_native_identity(root_device: u64,
            root_inode: u64, receipt_device: u64, receipt_inode: u64,
            receipt_bytes: i64, digest: darray[u8]&) -> bool can[Memory.Allocate]:
            facts: StudioGenerationReconcileIdentityPolicy::Facts =
                StudioGenerationReconcileIdentityPolicy::decode(0, root_device,
                    root_inode, receipt_device, receipt_inode, receipt_bytes, digest)
            ensure result
            facts.state == StudioGenerationReconcileIdentityPolicy::State.Unavailable and facts.root_device == 0 and facts.root_inode == 0 and facts.receipt_device == 0 and facts.receipt_inode == 0 and facts.receipt_bytes == 0 and facts.receipt_sha256.count == 0

        def malformed_validity_flag_refuses_without_leaking_identity(
            root_device: u64, root_inode: u64, receipt_device: u64,
            receipt_inode: u64, receipt_bytes: i64,
            digest: darray[u8]&) -> bool can[Memory.Allocate]:
            requires StudioGenerationReconcileIdentityPolicy::verified(root_inode,
                receipt_inode, receipt_bytes, digest)
            facts: StudioGenerationReconcileIdentityPolicy::Facts =
                StudioGenerationReconcileIdentityPolicy::decode(2, root_device,
                    root_inode, receipt_device, receipt_inode, receipt_bytes, digest)
            ensure result
            facts.state == StudioGenerationReconcileIdentityPolicy::State.Refused and facts.root_inode == 0 and facts.receipt_inode == 0 and facts.receipt_bytes == 0 and facts.receipt_sha256.count == 0

        def invalid_receipt_facts_refuse_without_leaking_identity(
            root_device: u64, root_inode: u64, receipt_device: u64,
            receipt_inode: u64, receipt_bytes: i64,
            digest: darray[u8]&) -> bool can[Memory.Allocate]:
            requires not StudioGenerationReconcileIdentityPolicy::verified(root_inode,
                receipt_inode, receipt_bytes, digest)
            facts: StudioGenerationReconcileIdentityPolicy::Facts =
                StudioGenerationReconcileIdentityPolicy::decode(1, root_device,
                    root_inode, receipt_device, receipt_inode, receipt_bytes, digest)
            ensure result
            facts.state == StudioGenerationReconcileIdentityPolicy::State.Refused and facts.root_device == 0 and facts.root_inode == 0 and facts.receipt_device == 0 and facts.receipt_inode == 0 and facts.receipt_bytes == 0 and facts.receipt_sha256.count == 0

        def verified_facts_preserve_exact_descriptor_and_receipt(
            root_device: u64, root_inode: u64, receipt_device: u64,
            receipt_inode: u64, receipt_bytes: i64,
            digest: darray[u8]&) -> bool can[Memory.Allocate]:
            requires StudioGenerationReconcileIdentityPolicy::verified(root_inode,
                receipt_inode, receipt_bytes, digest)
            facts: StudioGenerationReconcileIdentityPolicy::Facts =
                StudioGenerationReconcileIdentityPolicy::decode(1, root_device,
                    root_inode, receipt_device, receipt_inode, receipt_bytes, digest)
            ensure result
            facts.state == StudioGenerationReconcileIdentityPolicy::State.Verified and facts.root_device == root_device and facts.root_inode == root_inode and facts.receipt_device == receipt_device and facts.receipt_inode == receipt_inode and facts.receipt_bytes == receipt_bytes and bytes_equal(facts.receipt_sha256, digest)
