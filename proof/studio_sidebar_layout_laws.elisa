# Geometric laws for non-overlapping Studio sidebar sections.
include "../src/studio/sidebar_layout.elisa"

module StudioSidebarLayoutLaws:
    public:
        def balance_badge_fits_sidebar() -> bool:
            ensure result
            StudioSidebarLayout::Geometry::BALANCE_BADGE_LEFT >= 0 and StudioSidebarLayout::Geometry::BALANCE_BADGE_TOP >= 0 and StudioSidebarLayout::Geometry::BALANCE_BADGE_WIDTH > 0 and StudioSidebarLayout::Geometry::BALANCE_BADGE_HEIGHT > 0 and StudioSidebarLayout::Geometry::BALANCE_BADGE_LEFT + StudioSidebarLayout::Geometry::BALANCE_BADGE_WIDTH <= StudioSidebarLayout::Geometry::SIDEBAR_WIDTH and StudioSidebarLayout::Geometry::BALANCE_BADGE_TOP + StudioSidebarLayout::Geometry::BALANCE_BADGE_HEIGHT <= 38

        def sidebar_regions_are_disjoint() -> bool:
            ensure result
            StudioSidebarLayout::sections_do_not_overlap()

        def cleanup_rows_follow_add_buttons() -> bool:
            ensure result
            StudioSidebarLayout::Geometry::ADD_LAST_BOTTOM <= StudioSidebarLayout::Geometry::OPERATION_ROW_TOP

        def authored_issue_offsets_are_preserved() -> bool:
            ensure result
            StudioSidebarLayout::Geometry::ISSUE_HEADING_TOP == StudioSidebarLayout::Geometry::ISSUE_TOP + 5 and StudioSidebarLayout::Geometry::ISSUE_FILTER_TOP == StudioSidebarLayout::Geometry::ISSUE_TOP + 37 and StudioSidebarLayout::Geometry::ISSUE_NAV_TOP == StudioSidebarLayout::Geometry::ISSUE_FILTER_TOP + 21 and StudioSidebarLayout::Geometry::ISSUE_ROW_TOP == StudioSidebarLayout::Geometry::ISSUE_NAV_TOP + 25 and StudioSidebarLayout::Geometry::ISSUE_ROW_LAST_TOP == StudioSidebarLayout::Geometry::ISSUE_ROW_TOP and StudioSidebarLayout::Geometry::ISSUE_ROW_FIRST_BOTTOM == StudioSidebarLayout::Geometry::ISSUE_ROW_TOP + StudioSidebarLayout::Geometry::ISSUE_ROW_HEIGHT and StudioSidebarLayout::Geometry::ISSUE_ROW_LAST_BOTTOM == StudioSidebarLayout::Geometry::ISSUE_ROW_TOP + StudioSidebarLayout::Geometry::ISSUE_ROW_HEIGHT
