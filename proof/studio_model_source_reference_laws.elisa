include "../src/studio/app/model_source_reference.elisa"

module StudioModelSourceReferenceLaws:
    public:
        def invalid_reference_refused(memo: mutable StudioModel::Memo&, reference: StudioTakeSourceRefPolicy::TakeSourceRef) -> bool:
            requires not StudioTakeSourceRefPolicy::valid(reference)
            ensure result
            not StudioModel::attach_source_reference(memo, reference)

        def valid_reference_admitted(memo: mutable StudioModel::Memo&, reference: StudioTakeSourceRefPolicy::TakeSourceRef) -> bool:
            requires StudioTakeSourceRefPolicy::valid(reference)
            ensure result
            StudioModel::attach_source_reference(memo, reference)
