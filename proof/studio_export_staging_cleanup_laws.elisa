include "../src/studio/export_staging_cleanup_policy.elisa"

module StudioExportStagingCleanupLaws:
    public:
        def linked_output_survives_cleanup_failure() -> bool:
            ensure result
            StudioExportStagingCleanupPolicy::pending(true, false)

        def removed_staging_is_not_pending() -> bool:
            ensure not result
            StudioExportStagingCleanupPolicy::pending(true, true)

        def unpublished_staging_is_not_a_published_cleanup_case() -> bool:
            ensure not result
            StudioExportStagingCleanupPolicy::pending(false, false)
