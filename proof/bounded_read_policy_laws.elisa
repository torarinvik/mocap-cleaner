include "../src/core/bounded_read_policy.elisa"

module BoundedReadPolicyLaws:
    public:
        def invalid_limits_refused(limit: i64) -> bool:
            requires limit <= 0 or limit > BoundedReadPolicy::Capacity::MAX_BYTES
            ensure result
            not BoundedReadPolicy::valid_limit(limit)

        def exact_capacity_refuses_another_byte(limit: i64) -> bool:
            requires limit > 0 and limit <= BoundedReadPolicy::Capacity::MAX_BYTES
            ensure result
            not BoundedReadPolicy::append_admitted(limit, limit)

        def failure_precedence_preserved(read_failed: bool, close_failed: bool) -> bool:
            ensure result
            BoundedReadPolicy::finish(true, read_failed, close_failed) == BoundedReadPolicy::Status.TooLarge

        def read_failure_cannot_be_success(close_failed: bool) -> bool:
            ensure result
            BoundedReadPolicy::finish(false, true, close_failed) == BoundedReadPolicy::Status.ReadFailed

        def close_failure_cannot_be_success() -> bool:
            ensure result
            BoundedReadPolicy::finish(false, false, true) == BoundedReadPolicy::Status.CloseFailed

        def complete_read_can_publish() -> bool:
            ensure result
            BoundedReadPolicy::finish(false, false, false) == BoundedReadPolicy::Status.Ok
