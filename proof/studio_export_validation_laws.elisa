# Export validation status laws keep file-write and round-trip failures distinct.
include "../src/studio/export_validation.elisa"

module StudioExportValidationLaws:
    public:
        def ready_is_success(code: StudioExportValidation::Result) -> bool:
            requires code == StudioExportValidation::Result.READY
            ensure result
            StudioExportValidation::is_ready(code)

        def write_failure_is_not_success(code: StudioExportValidation::Result) -> bool:
            requires code == StudioExportValidation::Result.WRITE_FAILED
            ensure result
            not StudioExportValidation::is_ready(code)

        def reload_failure_is_not_success(code: StudioExportValidation::Result) -> bool:
            requires code == StudioExportValidation::Result.RELOAD_FAILED
            ensure result
            not StudioExportValidation::is_ready(code)

        def mismatch_is_not_success(code: StudioExportValidation::Result) -> bool:
            requires code == StudioExportValidation::Result.CONTENT_MISMATCH
            ensure result
            not StudioExportValidation::is_ready(code)
