# Export validation status laws keep file-write and round-trip failures distinct.
include "../src/studio/export_validation.elisa"

module StudioExportValidationLaws:
    public:
        def ready_is_success(code: i64) -> bool:
            StudioExportValidation::is_ready(code)

        def write_failure_is_not_success(code: i64) -> bool:
            not StudioExportValidation::is_ready(code)

        def reload_failure_is_not_success(code: i64) -> bool:
            not StudioExportValidation::is_ready(code)

        def mismatch_is_not_success(code: i64) -> bool:
            not StudioExportValidation::is_ready(code)
