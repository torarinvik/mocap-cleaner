include "../src/physics/rig_physics.elisa"

module PhysicsFloorBoundaryLaws:
    public:
        def zero_floor_is_zero_metres() -> bool:
            ensure result
            Physics::floor_metres(0) == 0.0

        def positive_metre_floor_is_exact() -> bool:
            ensure result
            Physics::floor_metres(10000) == 1.0

        def negative_metre_floor_is_exact() -> bool:
            ensure result
            Physics::floor_metres(-10000) == -1.0
