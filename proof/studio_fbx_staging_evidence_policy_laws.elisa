include "../src/studio/fbx_staging_evidence_policy.elisa"

module StudioFbxStagingEvidencePolicyLaws:
    public:
        def digest[@r]() -> darray[u8] @r:
            [97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97]

        def good[@r]() -> StudioFbxStagingEvidencePolicy::Evidence @r:
            StudioFbxStagingEvidencePolicy::Evidence{
                paths: StudioFbxStagingEvidencePolicy::PathBinding{
                    source_expected: [47, 116, 97, 107, 101, 46, 102, 98, 120],
                    source_observed: [47, 116, 97, 107, 101, 46, 102, 98, 120],
                    snapshot_expected: [47, 98, 117, 105, 108, 100, 47, 105, 109, 112, 111, 114, 116, 47, 120, 47, 115, 111, 117, 114, 99, 101, 46, 102, 98, 120],
                    snapshot_observed: [47, 98, 117, 105, 108, 100, 47, 105, 109, 112, 111, 114, 116, 47, 120, 47, 115, 111, 117, 114, 99, 101, 46, 102, 98, 120],
                    runtime_expected: [47, 98, 117, 105, 108, 100, 47, 105, 109, 112, 111, 114, 116, 47, 120, 47, 116, 97, 107, 101, 46, 103, 108, 98],
                    runtime_observed: [47, 98, 117, 105, 108, 100, 47, 105, 109, 112, 111, 114, 116, 47, 120, 47, 116, 97, 107, 101, 46, 103, 108, 98]
                },
                source_file: StudioFbxStagingEvidencePolicy::FileIdentity{
                    descriptor_device: 4u64, descriptor_inode: 10u64, named_device: 4u64, named_inode: 10u64
                },
                snapshot_file: StudioFbxStagingEvidencePolicy::FileIdentity{
                    descriptor_device: 4u64, descriptor_inode: 11u64, named_device: 4u64, named_inode: 11u64
                },
                copy: StudioFbxStagingEvidencePolicy::CopyIntegrity{
                    source_sha256: digest(), snapshot_sha256: digest(),
                    source_size: 128u64, copied_bytes: 128u64,
                    source_version_unchanged: true, source_read_complete: true
                },
                staging: StudioFbxStagingEvidencePolicy::StagingDurability{
                    exclusive_snapshot_create: true, private_directory_owned: true,
                    snapshot_readonly: true, snapshot_file_synced: true,
                    staging_directories_synced: true, all_descriptors_closed: true,
                    original_write_absent: true
                }
            }

        def complete_staging_evidence_admits() -> bool:
            ensure result
            StudioFbxStagingEvidencePolicy::stage_admitted(good())

        def source_path_must_bind() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.paths.source_observed <- [47, 120, 97, 107, 101, 46, 102, 98, 120]
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def snapshot_path_must_bind() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.paths.snapshot_observed <- [47, 116, 97, 107, 101, 46, 102, 98, 120]
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def runtime_path_must_bind() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.paths.runtime_observed <- [47, 116, 97, 107, 101, 46, 102, 98, 120]
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def source_and_snapshot_paths_must_be_distinct() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.paths.snapshot_observed <- evidence.paths.source_observed
            evidence.paths.snapshot_expected <- evidence.paths.source_expected
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def source_and_runtime_paths_must_be_distinct() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.paths.runtime_observed <- evidence.paths.source_observed
            evidence.paths.runtime_expected <- evidence.paths.source_expected
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def source_descriptor_must_match_named_identity() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.source_file.named_inode <- 12u64
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def snapshot_descriptor_must_match_named_identity() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.snapshot_file.named_device <- 5u64
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def source_size_must_be_bounded() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.copy.source_size <- StudioFbxStagingEvidencePolicy::Limit::MAX_SOURCE_BYTES + 1u64
            evidence.copy.copied_bytes <- evidence.copy.source_size
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def hard_linked_snapshot_is_refused() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.snapshot_file <- evidence.source_file
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def admitted_files_have_distinct_identities(evidence: StudioFbxStagingEvidencePolicy::Evidence&) -> bool:
            requires StudioFbxStagingEvidencePolicy::stage_admitted(evidence)
            ensure result
            StudioFbxStagingEvidencePolicy::files_distinct(evidence.source_file, evidence.snapshot_file)

        def incomplete_copy_is_refused() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.copy.copied_bytes <- 127u64
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def incomplete_source_read_is_refused() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.copy.source_read_complete <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def source_mutation_during_copy_is_refused() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.copy.source_version_unchanged <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def snapshot_digest_must_match_source_digest() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.copy.snapshot_sha256 <- [98, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97, 97]
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def exclusive_snapshot_creation_is_required() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.exclusive_snapshot_create <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def private_owned_directory_is_required() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.private_directory_owned <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def readonly_snapshot_is_required() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.snapshot_readonly <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def file_sync_is_required() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.snapshot_file_synced <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def directory_sync_is_required() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.staging_directories_synced <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def all_descriptors_must_close_before_success() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.all_descriptors_closed <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)

        def source_is_never_written() -> bool:
            ensure result
            mutable evidence: StudioFbxStagingEvidencePolicy::Evidence = good()
            evidence.staging.original_write_absent <- false
            not StudioFbxStagingEvidencePolicy::stage_admitted(evidence)
