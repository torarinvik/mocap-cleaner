# Exact domain and append bounds for per-output-frame source-time reports.
include "../src/studio/export_time_map_policy.elisa"

module StudioExportTimeMapLaws:
    public:
        def source_time_ceiling_matches_frame_cap() -> bool:
            ensure result
            (StudioExportTimeMapPolicy::Capacity::MAX_SOURCE_FRAMES - 1) * StudioExportTimeMapPolicy::Unit::MILLI_SOURCE_FRAMES == StudioExportTimeMapPolicy::Capacity::MAX_SOURCE_TIME

        def ordered_samples_have_positive_integer_gap(previous: i64, current: i64) -> bool:
            requires previous >= 0 and current > previous
            ensure result
            current - previous >= 1

        def in_range_source_time_is_below_global_ceiling(value: i64, source_frames: i64) -> bool:
            requires source_frames >= 1 and source_frames <= StudioExportTimeMapPolicy::Capacity::MAX_SOURCE_FRAMES
            requires value >= 0 and value <= (source_frames - 1) * StudioExportTimeMapPolicy::Unit::MILLI_SOURCE_FRAMES
            ensure result
            value <= StudioExportTimeMapPolicy::Capacity::MAX_SOURCE_TIME
