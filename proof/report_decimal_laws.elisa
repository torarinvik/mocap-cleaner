include "../src/core/report_decimal.elisa"

module ReportDecimalLaws:
    public:
        def whole_unit_factor() -> i64:
            ensure result == 1
            ReportDecimal::factor(0)

        def permille_factor() -> i64:
            ensure result == 1000
            ReportDecimal::factor(3)

        def supported_factor_is_positive(digits: i64) -> i64:
            requires digits >= 0 and digits <= ReportDecimal::Capacity::DIGITS
            ensure result >= 1 and result <= ReportDecimal::Capacity::FACTOR
            ReportDecimal::factor(digits)

        def maximum_precision_factor() -> i64:
            ensure result == ReportDecimal::Capacity::FACTOR
            ReportDecimal::factor(ReportDecimal::Capacity::DIGITS)

        def next_decimal_place_is_tenfold(digits: i64) -> bool:
            requires digits >= 0 and digits < ReportDecimal::Capacity::DIGITS
            ensure result
            ReportDecimal::factor(digits + 1) == ReportDecimal::factor(digits) * 10

        def identity_scale(value: i64) -> i64:
            requires value >= 0 - Regress::Domain::MAGNITUDE and value <= Regress::Domain::MAGNITUDE
            ensure result == value
            ReportDecimal::scale(value, 1)

        def zero_is_exact(factor: i64) -> i64:
            requires factor >= 1 and factor <= ReportDecimal::Capacity::FACTOR
            ensure result == 0
            ReportDecimal::scale(0, factor)

        def oversized_positive_is_unavailable(value: i64, factor: i64) -> bool:
            requires factor >= 1 and factor <= ReportDecimal::Capacity::FACTOR
            requires value > Regress::Domain::MAGNITUDE / factor
            ensure not result
            ReportDecimal::can_scale(value, factor)

        def oversized_negative_is_unavailable(value: i64, factor: i64) -> bool:
            requires factor >= 1 and factor <= ReportDecimal::Capacity::FACTOR
            requires value < 0 - Regress::Domain::MAGNITUDE / factor
            ensure not result
            ReportDecimal::can_scale(value, factor)

        def first_digit_is_exact(digit: i64) -> i64:
            requires digit >= 0 and digit <= 9
            ensure result == digit
            ReportDecimal::append_digit(0, digit)

        def largest_coefficient_is_exact() -> i64:
            ensure result == Regress::Domain::MAGNITUDE
            ReportDecimal::append_digit(100000000, 0)

        def overflow_digit_is_unavailable() -> bool:
            ensure not result
            ReportDecimal::can_append_digit(100000000, 1)

        def admitted_digit_preserves_domain(value: i64, digit: i64) -> i64:
            requires value >= 0
            requires digit >= 0 and digit <= 9
            requires value <= (Regress::Domain::MAGNITUDE - digit) / 10
            ensure result >= 0 and result <= Regress::Domain::MAGNITUDE
            ReportDecimal::append_digit(value, digit)

        def whole_alignment_is_exact() -> bool:
            ensure result
            match ReportDecimal::align(12, 0, 13, 0, 1):
                ReportDecimal::Alignment.Exact(before, after, floor, exponent):
                    return before == 12 and after == 13 and floor == 1 and exponent == 0
                _: return false

        def fractional_alignment_is_exact() -> bool:
            ensure result
            match ReportDecimal::align(12, -1, 125, -2, 1):
                ReportDecimal::Alignment.Exact(before, after, floor, exponent):
                    return before == 120 and after == 125 and floor == 100 and exponent == -2
                _: return false

        def oversized_alignment_is_unavailable() -> bool:
            ensure result
            match ReportDecimal::align(Regress::Domain::MAGNITUDE, 1, 1, 0, 0):
                ReportDecimal::Alignment.Unavailable: return true
                _: return false
