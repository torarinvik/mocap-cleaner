include "../src/core/report_decimal.elisa"

module ReportDecimalLaws:
    public:
        def whole_unit_factor() -> i64:
            ensure result == 1
            ReportDecimal::factor(0)

        def permille_factor() -> i64:
            ensure result == 1000
            ReportDecimal::factor(3)

        def supported_factor_is_positive(digits: i64) -> i64:
            requires digits >= 0 and digits <= ReportDecimal::Capacity::DIGITS
            ensure result >= 1 and result <= ReportDecimal::Capacity::FACTOR
            ReportDecimal::factor(digits)

        def maximum_precision_factor() -> i64:
            ensure result == ReportDecimal::Capacity::FACTOR
            ReportDecimal::factor(ReportDecimal::Capacity::DIGITS)

        def next_decimal_place_is_tenfold(digits: i64) -> bool:
            requires digits >= 0 and digits < ReportDecimal::Capacity::DIGITS
            ensure result
            ReportDecimal::factor(digits + 1) == ReportDecimal::factor(digits) * 10

        def identity_scale(value: i64) -> i64:
            requires value >= 0 - Regress::Domain::MAGNITUDE and value <= Regress::Domain::MAGNITUDE
            ensure result == value
            ReportDecimal::scale(value, 1)

        def zero_is_exact(factor: i64) -> i64:
            requires factor >= 1 and factor <= ReportDecimal::Capacity::FACTOR
            ensure result == 0
            ReportDecimal::scale(0, factor)

        def oversized_positive_is_unavailable(value: i64, factor: i64) -> bool:
            requires factor >= 1 and factor <= ReportDecimal::Capacity::FACTOR
            requires value > Regress::Domain::MAGNITUDE / factor
            ensure not result
            ReportDecimal::can_scale(value, factor)

        def oversized_negative_is_unavailable(value: i64, factor: i64) -> bool:
            requires factor >= 1 and factor <= ReportDecimal::Capacity::FACTOR
            requires value < 0 - Regress::Domain::MAGNITUDE / factor
            ensure not result
            ReportDecimal::can_scale(value, factor)
