include "../src/studio/io/build_generation_move_wire.elisa"

module StudioGenerationMoveWireLaws:
    public:
        def protected_row_refused(row: StudioBuildGenerationCandidateProvider::Row, root: darray[u8]&) -> bool:
            requires row.protection != StudioBuildGenerationCandidateProvider::Protection.Eligible
            ensure not result
            wire: StudioBuildGenerationMoveWire::Wire = StudioBuildGenerationMoveWire::capture(row, root)
            wire.valid

        def invalid_row_refused(row: StudioBuildGenerationCandidateProvider::Row, root: darray[u8]&) -> bool:
            requires not StudioBuildGenerationCandidateProvider::row_valid(row)
            ensure not result
            wire: StudioBuildGenerationMoveWire::Wire = StudioBuildGenerationMoveWire::capture(row, root)
            wire.valid

        def empty_root_refused(row: StudioBuildGenerationCandidateProvider::Row, root: darray[u8]&) -> bool:
            requires root.count == 0
            ensure not result
            wire: StudioBuildGenerationMoveWire::Wire = StudioBuildGenerationMoveWire::capture(row, root)
            wire.valid

        def oversized_root_refused(row: StudioBuildGenerationCandidateProvider::Row, root: darray[u8]&) -> bool:
            requires root.count >= StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize()
            ensure not result
            wire: StudioBuildGenerationMoveWire::Wire = StudioBuildGenerationMoveWire::capture(row, root)
            wire.valid

        def unknown_age_refused(retention: i64) -> bool:
            ensure not result
            StudioBuildGenerationMoveWire::age_admitted(StudioBuildGenerationCandidateProvider::AgeEvidence.Unknown, retention)

        def younger_age_refused(days: i64, retention: i64) -> bool:
            requires days < retention
            ensure not result
            StudioBuildGenerationMoveWire::age_admitted(StudioBuildGenerationCandidateProvider::AgeEvidence.Verified(days: days, origin: StudioBuildGenerationCandidateProvider::AgeOrigin.FilesystemBirthtime), retention)

        def negative_retention_refused(age: StudioBuildGenerationCandidateProvider::AgeEvidence, retention: i64) -> bool:
            requires retention < 0
            ensure not result
            StudioBuildGenerationMoveWire::age_admitted(age, retention)

        def boundary_age_admitted(days: i64) -> bool:
            requires days >= 0
            ensure result
            StudioBuildGenerationMoveWire::age_admitted(StudioBuildGenerationCandidateProvider::AgeEvidence.Verified(days: days, origin: StudioBuildGenerationCandidateProvider::AgeOrigin.FilesystemBirthtime), days)
