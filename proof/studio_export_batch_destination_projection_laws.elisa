include "../src/studio/export_batch_destination_projection.elisa"

module StudioExportBatchDestinationProjectionLaws:
    public:
        def empty_location_is_refused() -> bool:
            ensure result
            empty: darray[u8] = []
            not StudioExportBatchDestinationProjection::path_admitted(empty)

        def oversized_location_is_refused(path: darray[u8]&) -> bool:
            requires path.count > StudioExportBatchIdentity::Limit::MAX_PATH_BYTES
            ensure result
            not StudioExportBatchDestinationProjection::path_admitted(path)

        def admitted_location_is_bounded(path: darray[u8]&) -> bool:
            requires StudioExportBatchDestinationProjection::path_admitted(path)
            ensure result
            path.count > 0 and path.count <= StudioExportBatchIdentity::Limit::MAX_PATH_BYTES

        def all_destinations_survive_projection(source: darray[u8]&, glb: darray[u8]&, json_report: darray[u8]&, text_report: darray[u8]&) -> bool:
            requires StudioExportBatchDestinationProjection::path_admitted(source) and StudioExportBatchDestinationProjection::path_admitted(glb) and StudioExportBatchDestinationProjection::path_admitted(json_report) and StudioExportBatchDestinationProjection::path_admitted(text_report)
            ensure result
            snapshot: StudioExportBatchDestinationProjection::Snapshot = StudioExportBatchDestinationProjection::project(source, glb, json_report, text_report)
            (StudioExportBatchDestinationProjection::valid(snapshot) and
                StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDestinationProjection::path(snapshot, StudioExportBatchDestinationProjection::Location.Source), source) and
                StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDestinationProjection::path(snapshot, StudioExportBatchDestinationProjection::Location.Glb), glb) and
                StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDestinationProjection::path(snapshot, StudioExportBatchDestinationProjection::Location.JsonReport), json_report) and
                StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDestinationProjection::path(snapshot, StudioExportBatchDestinationProjection::Location.TextReport), text_report))

        def json_destination_is_admitted(snapshot: StudioExportBatchDestinationProjection::Snapshot&) -> bool:
            requires StudioExportBatchDestinationProjection::valid(snapshot)
            ensure result
            StudioExportBatchDestinationProjection::path_admitted(StudioExportBatchDestinationProjection::path(snapshot, StudioExportBatchDestinationProjection::Location.JsonReport))

        def text_destination_is_admitted(snapshot: StudioExportBatchDestinationProjection::Snapshot&) -> bool:
            requires StudioExportBatchDestinationProjection::valid(snapshot)
            ensure result
            StudioExportBatchDestinationProjection::path_admitted(StudioExportBatchDestinationProjection::path(snapshot, StudioExportBatchDestinationProjection::Location.TextReport))
