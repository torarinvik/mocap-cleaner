include "../src/core/json_scalar.elisa"

module JsonScalarLaws:
    public:
        def surrogate_is_not_scalar(value: i64) -> bool:
            requires value >= JsonScalar::Domain::SURROGATE_FIRST
            requires value <= JsonScalar::Domain::SURROGATE_LAST
            ensure not result
            JsonScalar::valid(value)

        def ascii_is_scalar(value: i64) -> bool:
            requires value >= 0 and value <= 127
            ensure result
            JsonScalar::valid(value)

        def oversized_is_not_scalar(value: i64) -> bool:
            requires value > JsonScalar::Domain::MAXIMUM
            ensure not result
            JsonScalar::valid(value)

        def decimal_hex(byte: i64) -> i64:
            requires byte >= 48 and byte <= 57
            ensure result == byte - 48
            JsonScalar::hex(byte)

        def uppercase_hex(byte: i64) -> i64:
            requires byte >= 65 and byte <= 70
            ensure result == byte - 65 + 10
            JsonScalar::hex(byte)

        def lowercase_hex(byte: i64) -> i64:
            requires byte >= 97 and byte <= 102
            ensure result == byte - 97 + 10
            JsonScalar::hex(byte)
