include "../src/studio/metric_evidence_policy.elisa"

module StudioMetricEvidenceLaws:
    public:
        def empty_measurement_is_unknown() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(true, true, 0, 0) == StudioMetricEvidencePolicy::State::UNKNOWN

        def missing_measurement_is_unknown() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(true, false, 10, 0) == StudioMetricEvidencePolicy::State::UNKNOWN

        def valid_passing_measurement() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(true, true, 10, 0) == StudioMetricEvidencePolicy::State::PASS

        def measured_failure_is_failure() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(true, true, 10, 1) == StudioMetricEvidencePolicy::State::FAIL

        def invalid_failure_count_is_unknown() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(true, true, 10, 11) == StudioMetricEvidencePolicy::State::UNKNOWN

        def negative_failure_count_is_unknown() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(true, true, 10, -1) == StudioMetricEvidencePolicy::State::UNKNOWN

        def inapplicable_is_explicit() -> bool:
            ensure result
            StudioMetricEvidencePolicy::classify(false, false, 0, 0) == StudioMetricEvidencePolicy::State::INAPPLICABLE

        def unknown_and_failed_are_not_admitted() -> bool:
            ensure result
            not StudioMetricEvidencePolicy::admits(StudioMetricEvidencePolicy::State::UNKNOWN) and not StudioMetricEvidencePolicy::admits(StudioMetricEvidencePolicy::State::FAIL)
