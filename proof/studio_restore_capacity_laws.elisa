include "../src/studio/state/stack_state.elisa"

# These laws exercise the actual insertion paths used by session decoding.
# Decoder atomicity additionally requires native candidate-install qualification.
module StudioRestoreCapacityLaws:
    public:
        def full_operations_refuse(s: mutable StackState::Stack&, op: Ops::Operation) -> bool:
            requires s.count == StackPolicy::Limit::MAX_OPS
            ensure result
            before: i64 = s.count
            accepted: bool = StackState::add(s, op)
            not accepted and s.count == before

        def full_contacts_refuse(s: mutable StackState::Stack&) -> bool:
            requires s.edit_count == StackState::Capacity::MAX_EDITS
            ensure result
            before: i64 = s.edit_count
            accepted: bool = StackState::add_edit(s, StackState::ContactSide.LeftFoot.i64(), 0, 0, true)
            not accepted and s.edit_count == before

        def full_corrections_refuse(s: mutable StackState::Stack&, fix: Corrections::Correction) -> bool:
            requires s.fix_count == Corrections::MAX
            ensure result
            before: i64 = s.fix_count
            accepted: bool = StackState::add_fix(s, fix)
            not accepted and s.fix_count == before

        def full_bands_refuse(s: mutable StackState::Stack&) -> bool:
            requires s.band_count == StackState::Capacity::MAX_BANDS
            ensure result
            before: i64 = s.band_count
            accepted: bool = StackState::add_band(s, 0, 0, Retime::Rate::MIN_RATE, 1)
            not accepted and s.band_count == before
