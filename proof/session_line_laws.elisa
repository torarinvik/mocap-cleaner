include "../src/studio/state/session_line_policy.elisa"

module SessionLineLaws:
    public:
        def space_is_whitespace() -> bool:
            ensure result
            SessionLinePolicy::whitespace(SessionLinePolicy::Byte.Space.u8())

        def tab_is_whitespace() -> bool:
            ensure result
            SessionLinePolicy::whitespace(SessionLinePolicy::Byte.Tab.u8())

        def carriage_return_is_whitespace() -> bool:
            ensure result
            SessionLinePolicy::whitespace(SessionLinePolicy::Byte.CarriageReturn.u8())

        def comment_marker_is_content() -> bool:
            ensure result
            not SessionLinePolicy::whitespace(SessionLinePolicy::Byte.Comment.u8())

        def empty_line_is_ignored() -> bool:
            ensure result
            line: darray[u8] = []
            SessionLinePolicy::ignored(&line)

        def indented_comment_is_ignored() -> bool:
            ensure result
            line: darray[u8] = [32, 9, 35, 120]
            SessionLinePolicy::ignored(&line)

        def embedded_comment_does_not_hide_record() -> bool:
            ensure result
            line: darray[u8] = [32, 52, 32, 35]
            not SessionLinePolicy::ignored(&line)
