include "../src/studio/io/storage_exemptions_wire_policy.elisa"

module StudioStorageExemptionsWirePolicyLaws:
    public:
        def versioned_prefix_has_exact_newline_offset() -> bool:
            ensure result
            StudioStorageExemptionsWirePolicy::HEADER_BYTES == 27 and StudioStorageExemptionsWirePolicy::PREFIX_BYTES == 28 and StudioStorageExemptionsWirePolicy::PREFIX_BYTES == StudioStorageExemptionsWirePolicy::HEADER_BYTES + 1
