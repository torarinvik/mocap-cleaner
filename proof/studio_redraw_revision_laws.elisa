include "../src/studio/redraw_revision_policy.elisa"

module StudioRedrawRevisionLaws:
    public:
        def ordinary_advance_is_monotone(value: i64) -> bool:
            requires value >= 0
            requires value < StudioRedrawRevisionPolicy::Domain::MAX
            ensure result
            step: StudioRedrawRevisionPolicy::Step = StudioRedrawRevisionPolicy::next(value)
            not step.wrapped and step.value == value + 1 and step.value > value

        def exhausted_revision_wraps_and_invalidates(value: i64) -> bool:
            requires value == StudioRedrawRevisionPolicy::Domain::MAX
            ensure result
            step: StudioRedrawRevisionPolicy::Step = StudioRedrawRevisionPolicy::next(value)
            step.wrapped and step.value == 0

        def every_step_stays_in_domain(value: i64) -> bool:
            requires value >= 0
            requires value <= StudioRedrawRevisionPolicy::Domain::MAX
            ensure result
            StudioRedrawRevisionPolicy::valid(StudioRedrawRevisionPolicy::next(value).value)
