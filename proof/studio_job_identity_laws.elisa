# Result publication requires an exact copied identity and a live request.
include "../src/studio/job_identity.elisa"

module StudioJobIdentityLaws:
    private:
        def request(generation: i64) -> StudioJobIdentity::Identity:
            StudioJobIdentity::Identity{
                kind: StudioJobIdentity::Kind.Rebuild,
                document_revision: 4,
                generation: generation,
                take_serial: 2,
                stack_generation: 9,
                first_frame: 10,
                last_frame: 20,
                playhead_frame: 4,
            }

    public:
        def exact_uncancelled_result_publishes() -> bool:
            ensure result
            StudioJobIdentity::may_publish(request(7), request(7), false)

        def superseded_preview_can_restore_only_same_source_memo() -> bool:
            ensure result
            active: StudioJobIdentity::Identity = request(7)
            completed: mutable StudioJobIdentity::Identity = request(7)
            completed.last_frame <- 21
            (StudioJobIdentity::same_source(active, completed) and
                not StudioJobIdentity::may_publish(active, completed, false))

        def cancelled_result_never_publishes() -> bool:
            ensure not result
            StudioJobIdentity::may_publish(request(7), request(7), true)

        def stale_generation_is_rejected() -> bool:
            ensure not result
            StudioJobIdentity::may_publish(request(8), request(7), false)

        def changed_source_is_rejected() -> bool:
            ensure not result
            active: StudioJobIdentity::Identity = request(7)
            completed: mutable StudioJobIdentity::Identity = request(7)
            completed.take_serial <- 3
            StudioJobIdentity::may_publish(active, completed, false)

        def changed_stack_is_rejected() -> bool:
            ensure not result
            active: StudioJobIdentity::Identity = request(7)
            completed: mutable StudioJobIdentity::Identity = request(7)
            completed.stack_generation <- 10
            StudioJobIdentity::may_publish(active, completed, false)

        def changed_range_is_rejected() -> bool:
            ensure not result
            active: StudioJobIdentity::Identity = request(7)
            completed: mutable StudioJobIdentity::Identity = request(7)
            completed.last_frame <- 21
            StudioJobIdentity::may_publish(active, completed, false)

        def changed_playhead_is_rejected() -> bool:
            ensure not result
            active: StudioJobIdentity::Identity = request(7)
            completed: mutable StudioJobIdentity::Identity = request(7)
            completed.playhead_frame <- 5
            StudioJobIdentity::may_publish(active, completed, false)

        def invalid_empty_generation_is_rejected() -> bool:
            ensure not result
            invalid: mutable StudioJobIdentity::Identity = request(0)
            StudioJobIdentity::valid(invalid)
