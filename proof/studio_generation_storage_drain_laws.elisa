include "../src/studio/state/generation_storage_drain_policy.elisa"

module StudioGenerationStorageDrainLaws:
    public:
        def idle_storage_can_leave() -> bool:
            ensure result
            StudioGenerationStorageDrainPolicy::may_leave(false, false, false, false)

        def move_requires_drain(restore: bool, discovery: bool, reconcile: bool) -> bool:
            ensure not result
            StudioGenerationStorageDrainPolicy::may_leave(true, restore, discovery, reconcile)

        def restore_requires_drain(move_active: bool, discovery: bool, reconcile: bool) -> bool:
            ensure not result
            StudioGenerationStorageDrainPolicy::may_leave(move_active, true, discovery, reconcile)

        def discovery_requires_drain(move_active: bool, restore: bool, reconcile: bool) -> bool:
            ensure not result
            StudioGenerationStorageDrainPolicy::may_leave(move_active, restore, true, reconcile)

        def reconcile_requires_drain(move_active: bool, restore: bool, discovery: bool) -> bool:
            ensure not result
            StudioGenerationStorageDrainPolicy::may_leave(move_active, restore, discovery, true)
