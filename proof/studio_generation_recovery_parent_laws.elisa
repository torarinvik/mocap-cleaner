include "../src/studio/state/generation_recovery_parent_policy.elisa"

module StudioGenerationRecoveryParentLaws:
    public:
        def distinct_quarantine_parent_is_valid() -> bool:
            ensure result
            StudioGenerationRecoveryParentPolicy::parents_verified(StudioGenerationRecoveryParentPolicy::SourceLocation.Quarantine, false, true, true)

        def changed_quarantine_parent_refused(original_matches: bool) -> bool:
            ensure not result
            StudioGenerationRecoveryParentPolicy::parents_verified(StudioGenerationRecoveryParentPolicy::SourceLocation.Quarantine, original_matches, false, true)

        def changed_original_source_refused(items_match: bool) -> bool:
            ensure not result
            StudioGenerationRecoveryParentPolicy::parents_verified(StudioGenerationRecoveryParentPolicy::SourceLocation.Original, false, items_match, true)

        def missing_original_rebinding_refused(location: StudioGenerationRecoveryParentPolicy::SourceLocation, original: bool, items: bool) -> bool:
            ensure not result
            StudioGenerationRecoveryParentPolicy::parents_verified(location, original, items, false)

        def verified_original_parent_is_valid() -> bool:
            ensure result
            StudioGenerationRecoveryParentPolicy::parents_verified(StudioGenerationRecoveryParentPolicy::SourceLocation.Original, true, false, true)
