# Modifier event delivery may repeat or duplicate transitions. Reapplying a
# down/up transition must leave the held-modifier mask stable.
include "../src/studio/shortcuts.elisa"

module StudioShortcutModifierLaws:
    public:
        def repeated_command_down_is_stable(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::Modifiers::ALL
            ensure result
            once: i64 = StudioShortcuts::command_down(mask)
            twice: i64 = StudioShortcuts::command_down(once)
            return once == twice

        def repeated_shift_down_is_stable(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::Modifiers::ALL
            ensure result
            once: i64 = StudioShortcuts::shift_down(mask)
            twice: i64 = StudioShortcuts::shift_down(once)
            return once == twice

        def repeated_command_up_is_stable(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::Modifiers::ALL
            ensure result
            once: i64 = StudioShortcuts::command_up(mask)
            twice: i64 = StudioShortcuts::command_up(once)
            return once == twice

        def repeated_shift_up_is_stable(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::Modifiers::ALL
            ensure result
            once: i64 = StudioShortcuts::shift_up(mask)
            twice: i64 = StudioShortcuts::shift_up(once)
            return once == twice
