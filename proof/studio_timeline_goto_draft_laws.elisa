include "../src/studio/timeline_goto_draft_policy.elisa"

module StudioTimelineGotoDraftLaws:
    public:
        def matching_target_is_current(take: i64, document: i64, generation: i64, frames: i64) -> bool:
            requires take >= 0 and document >= 0 and generation >= 0
            requires frames >= 1 and frames <= StudioTimelineGotoKernel::MAX_FRAMES
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: take, document: document, generation: generation, frames: frames}
            StudioTimelineGotoDraftPolicy::current(target, take, document, generation, frames)

        def replacement_take_refuses_target() -> bool:
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: 1, document: 2, generation: 3, frames: 24}
            not StudioTimelineGotoDraftPolicy::current(target, 2, 2, 3, 24)

        def changed_result_refuses_target() -> bool:
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: 1, document: 2, generation: 3, frames: 24}
            not StudioTimelineGotoDraftPolicy::current(target, 1, 3, 3, 24)

        def changed_history_refuses_target() -> bool:
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: 1, document: 2, generation: 3, frames: 24}
            not StudioTimelineGotoDraftPolicy::current(target, 1, 2, 4, 24)

        def changed_duration_refuses_target() -> bool:
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: 1, document: 2, generation: 3, frames: 24}
            not StudioTimelineGotoDraftPolicy::current(target, 1, 2, 3, 48)

        def empty_clip_refuses_target() -> bool:
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: 1, document: 2, generation: 3, frames: 0}
            not StudioTimelineGotoDraftPolicy::current(target, 1, 2, 3, 0)

        def unavailable_identity_refuses_target() -> bool:
            ensure result
            target: StudioTimelineGotoDraftPolicy::Target = StudioTimelineGotoDraftPolicy::Target{take: -1, document: 2, generation: 3, frames: 24}
            not StudioTimelineGotoDraftPolicy::current(target, -1, 2, 3, 24)
