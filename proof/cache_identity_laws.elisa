include "../src/core/cache_identity_policy.elisa"

module CacheIdentityLaws:
    public:
        def collision_cannot_reuse(operation_equal: bool, storage_valid: bool) -> bool:
            ensure result
            not CacheIdentityPolicy::reuse_admitted(true, false, operation_equal, storage_valid)

        def changed_operation_cannot_reuse(input_equal: bool, storage_valid: bool) -> bool:
            ensure result
            not CacheIdentityPolicy::reuse_admitted(true, input_equal, false, storage_valid)

        def incomplete_storage_cannot_reuse(input_equal: bool, operation_equal: bool) -> bool:
            ensure result
            not CacheIdentityPolicy::reuse_admitted(true, input_equal, operation_equal, false)

        def exact_match_reuses() -> bool:
            ensure result
            CacheIdentityPolicy::reuse_admitted(true, true, true, true)

        def rejected_hash_cannot_reuse(input_equal: bool, operation_equal: bool, storage_valid: bool) -> bool:
            ensure result
            not CacheIdentityPolicy::reuse_admitted(false, input_equal, operation_equal, storage_valid)
