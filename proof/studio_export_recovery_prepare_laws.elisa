include "../src/studio/export_recovery_prepare_policy.elisa"

module StudioExportRecoveryPrepareLaws:
    public:
        def durable_owned_record_is_admitted() -> bool:
            ensure result
            StudioExportRecoveryPreparePolicy::publication_admitted(true, true, true, true, true, true, true)

        def unowned_directory_is_rejected(capacity: bool, output: bool, json: bool,
                                          text: bool, journal: bool, directory: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(false, capacity, output, json, text, journal, directory)

        def missing_reservation_is_rejected(owned: bool, output: bool, json: bool,
                                            text: bool, journal: bool, directory: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(owned, false, output, json, text, journal, directory)

        def unsynced_output_is_rejected(owned: bool, capacity: bool, json: bool,
                                       text: bool, journal: bool, directory: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(owned, capacity, false, json, text, journal, directory)

        def unsynced_json_is_rejected(owned: bool, capacity: bool, output: bool,
                                     text: bool, journal: bool, directory: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(owned, capacity, output, false, text, journal, directory)

        def unsynced_text_is_rejected(owned: bool, capacity: bool, output: bool,
                                     json: bool, journal: bool, directory: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(owned, capacity, output, json, false, journal, directory)

        def unsynced_journal_is_rejected(owned: bool, capacity: bool, output: bool,
                                        json: bool, text: bool, directory: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(owned, capacity, output, json, text, false, directory)

        def unsynced_directory_is_rejected(owned: bool, capacity: bool, output: bool,
                                          json: bool, text: bool, journal: bool) -> bool:
            ensure not result
            StudioExportRecoveryPreparePolicy::publication_admitted(owned, capacity, output, json, text, journal, false)
