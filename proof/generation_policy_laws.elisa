include "../src/core/generation_policy.elisa"

module GenerationPolicyLaws:
    public:
        def exhausted_generation_refused() -> bool:
            ensure result
            not GenerationPolicy::can_advance(GenerationPolicy::Domain::MAX)

        def invalid_generation_refused(value: i64) -> bool:
            requires value < 0
            ensure result
            not GenerationPolicy::can_advance(value)

        def final_advance_is_exact() -> bool:
            ensure result
            GenerationPolicy::advance(GenerationPolicy::Domain::MAX - 1) == GenerationPolicy::Domain::MAX

        def admitted_advance_is_strict(value: i64) -> bool:
            requires GenerationPolicy::can_advance(value)
            ensure result
            GenerationPolicy::advance(value) > value

        def two_advances_leave_room_for_publication(value: i64) -> bool:
            requires GenerationPolicy::can_advance_twice(value)
            ensure result
            GenerationPolicy::can_advance(value) and GenerationPolicy::can_advance(GenerationPolicy::advance(value))

        def one_remaining_generation_cannot_replace() -> bool:
            ensure result
            not GenerationPolicy::can_advance_twice(GenerationPolicy::Domain::MAX - 1)

        def final_two_advances_are_exact() -> bool:
            ensure result
            GenerationPolicy::advance(GenerationPolicy::advance(GenerationPolicy::Domain::MAX - 2)) == GenerationPolicy::Domain::MAX
