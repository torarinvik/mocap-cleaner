include "../src/core/generation_policy.elisa"

module GenerationPolicyLaws:
    public:
        def exhausted_generation_refused() -> bool:
            ensure result
            not GenerationPolicy::can_advance(GenerationPolicy::Domain::MAX)

        def invalid_generation_refused(value: i64) -> bool:
            requires value < 0
            ensure result
            not GenerationPolicy::can_advance(value)

        def final_advance_is_exact() -> bool:
            ensure result
            GenerationPolicy::advance(GenerationPolicy::Domain::MAX - 1) == GenerationPolicy::Domain::MAX

        def admitted_advance_is_strict(value: i64) -> bool:
            requires GenerationPolicy::can_advance(value)
            ensure result
            GenerationPolicy::advance(value) > value
