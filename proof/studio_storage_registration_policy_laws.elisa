include "../src/studio/storage_registration_policy.elisa"
include "../src/studio/storage_receipt_policy.elisa"

module StudioStorageRegistrationPolicyLaws:
    public:
        def kind_mapping_is_exact(artifact: i64) -> bool:
            ensure result
            StudioStorageRegistrationPolicy::receipt_kind(artifact) == (StudioStorageRegistrationPolicy::KIND_RECOVERY if artifact == StudioStorageRegistrationPolicy::ARTIFACT_SESSION else StudioStorageRegistrationPolicy::KIND_GENERATED_REPORT if artifact == StudioStorageRegistrationPolicy::ARTIFACT_EXPORT_REPORT else StudioStorageRegistrationPolicy::KIND_INVALID)

        def receipt_kinds_match_manifest_schema() -> bool:
            ensure result
            StudioStorageRegistrationPolicy::KIND_RECOVERY == StudioStorageReceiptPolicy::Kind.Recovery.i64() and StudioStorageRegistrationPolicy::KIND_GENERATED_REPORT == StudioStorageReceiptPolicy::Kind.GeneratedReport.i64()

        def only_completed_in_build_regular_files_can_register(artifact: i64) -> bool:
            ensure result
            StudioStorageRegistrationPolicy::may_register(artifact, true, true, true, true, true, false) == (artifact == StudioStorageRegistrationPolicy::ARTIFACT_SESSION or artifact == StudioStorageRegistrationPolicy::ARTIFACT_EXPORT_REPORT)

        def failed_or_incomplete_publication_never_registers(artifact: i64) -> bool:
            ensure result
            not StudioStorageRegistrationPolicy::may_register(artifact, false, true, true, true, true, false) and not StudioStorageRegistrationPolicy::may_register(artifact, true, false, true, true, true, false)

        def unverifiable_identity_never_registers(artifact: i64) -> bool:
            ensure result
            not StudioStorageRegistrationPolicy::may_register(artifact, true, true, true, false, true, false)

        def non_regular_file_never_registers(artifact: i64) -> bool:
            ensure result
            not StudioStorageRegistrationPolicy::may_register(artifact, true, true, true, true, false, false)

        def symlink_session_is_rejected() -> bool:
            ensure result
            if StudioStorageRegistrationPolicy::may_register(StudioStorageRegistrationPolicy::ARTIFACT_SESSION, true, true, true, true, true, true):
                return false
            true

        def path_outside_build_never_registers(artifact: i64) -> bool:
            ensure result
            not StudioStorageRegistrationPolicy::may_register(artifact, true, true, false, true, true, false)

        def invalid_artifact_never_registers(artifact: i64) -> bool:
            ensure result
            StudioStorageRegistrationPolicy::artifact_valid(artifact) or not StudioStorageRegistrationPolicy::may_register(artifact, true, true, true, true, true, false)
