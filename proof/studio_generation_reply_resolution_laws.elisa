include "../src/studio/state/generation_reply_resolution_policy.elisa"

module StudioGenerationReplyResolutionLaws:
    public:
        def retained_handle_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires evidence.remaining_handle != 0
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def uncertain_old_release_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not StudioGenerationHandlePolicy::release_certain(evidence.release)
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def active_job_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not evidence.jobs_idle
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def different_identity_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not evidence.identity_matches
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def different_artifact_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not evidence.details_match
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def unrecorded_identity_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not evidence.identity_recorded
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def stale_observation_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not evidence.observation_current
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def uncertain_reconciliation_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not StudioGenerationHandlePolicy::release_certain(evidence.observation_status)
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def unresolved_location_refuses(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires not StudioGenerationReplyResolutionPolicy::terminal(evidence.outcome)
            ensure not result
            StudioGenerationReplyResolutionPolicy::may_resolve(evidence)

        def admitted_resolution_has_no_handle(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires StudioGenerationReplyResolutionPolicy::may_resolve(evidence)
            ensure result
            evidence.remaining_handle == 0

        def admitted_resolution_preserves_identity(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires StudioGenerationReplyResolutionPolicy::may_resolve(evidence)
            ensure result
            evidence.identity_matches and evidence.identity_recorded

        def admitted_resolution_is_terminal(evidence: StudioGenerationReplyResolutionPolicy::Evidence) -> bool:
            requires StudioGenerationReplyResolutionPolicy::may_resolve(evidence)
            ensure result
            StudioGenerationReplyResolutionPolicy::terminal(evidence.outcome)
