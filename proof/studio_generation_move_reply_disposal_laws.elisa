include "../src/studio/state/generation_move_reply_disposal_policy.elisa"

module StudioGenerationMoveReplyDisposalLaws:
    public:
        def completed_recorded_reply_can_be_discarded() -> bool:
            ensure result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32())
            StudioGenerationMoveReplyDisposalPolicy::may_discard(true, true, 0, release)

        def cancelled_success_is_retained() -> bool:
            ensure not result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32())
            StudioGenerationMoveReplyDisposalPolicy::may_discard(false, true, 0, release)

        def ledger_failure_is_retained() -> bool:
            ensure not result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32())
            StudioGenerationMoveReplyDisposalPolicy::may_discard(true, false, 0, release)

        def live_handle_is_retained(handle: i64) -> bool:
            requires handle != 0
            ensure not result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32())
            StudioGenerationMoveReplyDisposalPolicy::may_discard(true, true, handle, release)

        def uncertain_release_is_retained() -> bool:
            ensure not result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.ReleaseUncertain.i32())
            StudioGenerationMoveReplyDisposalPolicy::may_discard(true, true, 0, release)
