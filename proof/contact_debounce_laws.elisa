# Contact debounce laws: a lift touching a clip end is never filled, real
# steps and plants (longer than the limits) are never changed, zero limits
# change only empty runs (there are none), and frame limits stay bounded.
include "../src/detect/contact.elisa"

module ContactDebounceLaws:
    public:
        # A lift at either end of the clip is never filled.
        def edge_lift_kept(length: i64, max_gap: i64) -> bool:
            ensure not result
            Contact::fills_gap(length, false, max_gap)

        # A lift longer than the gap limit is a real step and stays.
        def long_lift_kept(length: i64, bounded: bool, max_gap: i64) -> bool:
            requires length > max_gap
            ensure not result
            Contact::fills_gap(length, bounded, max_gap)

        # A plant longer than the blip limit stays.
        def long_plant_kept(length: i64, max_blip: i64) -> bool:
            requires length > max_blip
            ensure not result
            Contact::drops_blip(length, max_blip)

        # With zero limits no run of at least one frame is changed.
        def zero_limits_change_nothing(length: i64, bounded: bool) -> bool:
            requires length >= 1
            ensure not result
            Contact::fills_gap(length, bounded, 0) or Contact::drops_blip(length, 0)

        # The frame limits stay within the debounce bound at any rate.
        def frame_limit_bounded(ms: i64, fps: i64) -> i64:
            requires ms >= 0 and ms <= 1000
            ensure result >= 0 and result <= Contact::Debounce::MAX_FRAMES
            Contact::frames_of(ms, fps)
