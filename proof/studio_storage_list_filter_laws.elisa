include "../src/studio/storage_list_filter_policy.elisa"

module StudioStorageListFilterLaws:
    public:
        def all_admits_every_row(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::ALL, kind, in_trash, eligible)

        def eligible_filter_uses_only_eligibility(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result == eligible
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::ELIGIBLE, kind, in_trash, eligible)

        def protected_filter_excludes_eligible_and_trash(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result == (not eligible and not in_trash)
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::PROTECTED, kind, in_trash, eligible)

        def recovery_filter_uses_cleanup_kind(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result == (kind == StudioStorageCleanupPolicy::RECOVERY)
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::RECOVERY, kind, in_trash, eligible)

        def temp_export_filter_uses_cleanup_kind(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result == (kind == StudioStorageCleanupPolicy::TEMP_EXPORT)
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::TEMP_EXPORT, kind, in_trash, eligible)

        def report_filter_uses_cleanup_kind(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result == (kind == StudioStorageCleanupPolicy::GENERATED_REPORT)
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::REPORT, kind, in_trash, eligible)

        def in_trash_filter_uses_only_validated_status(kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure result == in_trash
            StudioStorageListFilterPolicy::matches(StudioStorageListFilterPolicy::Filter::IN_TRASH, kind, in_trash, eligible)

        def cleanup_kind_ids_are_distinct() -> bool:
            ensure result
            StudioStorageCleanupPolicy::RECOVERY != StudioStorageCleanupPolicy::TEMP_EXPORT and StudioStorageCleanupPolicy::RECOVERY != StudioStorageCleanupPolicy::GENERATED_REPORT and StudioStorageCleanupPolicy::TEMP_EXPORT != StudioStorageCleanupPolicy::GENERATED_REPORT
