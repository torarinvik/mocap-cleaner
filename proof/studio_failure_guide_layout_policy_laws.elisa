include "../src/studio/failure_guide_layout_policy.elisa"

module StudioFailureGuideLayoutPolicyLaws:
    public:
        def dimensions_are_bounded(width: i64, height: i64) -> bool:
            requires width >= -16384 and width <= 16384
            requires height >= -16384 and height <= 16384
            ensure result == true
            StudioFailureGuideLayoutPolicy::content_width(width) >= 0 and StudioFailureGuideLayoutPolicy::rows(height) >= 0 and StudioFailureGuideLayoutPolicy::rows(height) <= 6

        def rows_reserve_retry_space(height: i64) -> bool:
            requires height >= 100 and height <= 16384
            ensure result == true
            StudioFailureGuideLayoutPolicy::rows(height) * 20 + 100 <= height

        def insufficient_space_has_no_rows(height: i64) -> bool:
            requires height >= -16384 and height <= 100
            ensure result == true
            StudioFailureGuideLayoutPolicy::rows(height) == 0
