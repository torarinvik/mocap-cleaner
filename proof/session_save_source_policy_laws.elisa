include "../src/studio/session_save_source_policy.elisa"

module StudioSessionSaveSourcePolicyLaws:
    def direct_source_save_requires_both_current_digests() -> void:
        assert StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, true, true, false, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, false, true, false, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, true, false, false, true)

    def fbx_source_save_requires_current_processing_identity() -> void:
        assert StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.FbxDerived, true, true, true, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.FbxDerived, true, true, true, true, true, false, true)

    def any_unverified_reference_fact_refuses_v5_save() -> void:
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, false, true, true, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, false, true, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, false, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, true, true, true, false)
