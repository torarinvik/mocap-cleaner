include "../src/studio/session_save_source_policy.elisa"

module StudioSessionSaveSourcePolicyLaws:
    def counted_animation_name_boundary() -> void:
        assert not StudioSessionSaveSourcePolicy::animation_count_admitted(0)
        assert StudioSessionSaveSourcePolicy::animation_count_admitted(1)
        assert StudioSessionSaveSourcePolicy::animation_count_admitted(1024)
        assert not StudioSessionSaveSourcePolicy::animation_count_admitted(1025)

    def admitted_animation_copy_index(count: i64, index: i64) -> bool:
        requires StudioSessionSaveSourcePolicy::animation_count_admitted(count)
        requires index >= 0 and index < count
        ensure result
        index >= 0 and index < SessionSourceReferenceCodec::Limit::ANIMATION_BYTES.i64()

    def source_save_admission_matches_all_captured_facts(kind: StudioSessionSaveSourcePolicy::Kind,
                                                       reference_valid: bool, source_path_matches: bool,
                                                       runtime_path_matches: bool, source_digest_matches: bool,
                                                       runtime_digest_matches: bool, processing_identity_matches: bool,
                                                       animation_name_valid: bool) -> bool:
        ensure result
        admitted: bool = StudioSessionSaveSourcePolicy::admit(kind, reference_valid,
            source_path_matches, runtime_path_matches, source_digest_matches,
            runtime_digest_matches, processing_identity_matches, animation_name_valid)
        expected: bool = (kind == StudioSessionSaveSourcePolicy::Kind.DirectGlb or kind == StudioSessionSaveSourcePolicy::Kind.FbxDerived) and reference_valid and source_path_matches and runtime_path_matches and source_digest_matches and runtime_digest_matches and animation_name_valid and (kind == StudioSessionSaveSourcePolicy::Kind.DirectGlb or processing_identity_matches)
        admitted == expected

    def direct_source_save_requires_both_current_digests() -> void:
        assert StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, true, true, false, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, false, true, false, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, true, false, false, true)

    def fbx_source_save_requires_current_processing_identity() -> void:
        assert StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.FbxDerived, true, true, true, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.FbxDerived, true, true, true, true, true, false, true)

    def any_unverified_reference_fact_refuses_v5_save() -> void:
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, false, true, true, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, false, true, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, false, true, true, true, true)
        assert not StudioSessionSaveSourcePolicy::admit(StudioSessionSaveSourcePolicy::Kind.DirectGlb, true, true, true, true, true, true, false)
