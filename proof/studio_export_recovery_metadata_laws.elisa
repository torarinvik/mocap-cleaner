include "../src/studio/io/export_recovery_metadata.elisa"

module StudioExportRecoveryMetadataLaws:
    public:
        def captures_revision[@r](build_root: cstr, destination: cstr,
                generation: i64, animation: i64, output_bytes: i64,
                json_bytes: i64, text_bytes: i64,
                record: mutable StudioExportRecoveryJournal::Record& @r) -> bool:
            ensure result implies record.source_generation == generation
            ensure result implies record.animation_index == animation
            StudioExportRecoveryMetadata::draft(build_root, destination,
                generation, animation, output_bytes, json_bytes, text_bytes, record)

        def captures_sizes[@r](build_root: cstr, destination: cstr,
                generation: i64, animation: i64, output_bytes: i64,
                json_bytes: i64, text_bytes: i64,
                record: mutable StudioExportRecoveryJournal::Record& @r) -> bool:
            ensure result implies record.output_bytes == output_bytes
            ensure result implies record.json_bytes == json_bytes
            ensure result implies record.text_bytes == text_bytes
            StudioExportRecoveryMetadata::draft(build_root, destination,
                generation, animation, output_bytes, json_bytes, text_bytes, record)

        def rejects_negative_revision[@r](build_root: cstr, destination: cstr,
                animation: i64, record: mutable StudioExportRecoveryJournal::Record& @r) -> bool:
            ensure not result
            StudioExportRecoveryMetadata::draft(build_root, destination,
                -1, animation, 1, 1, 1, record)
