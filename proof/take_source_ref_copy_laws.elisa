include "../src/studio/take_source_ref_copy.elisa"

module StudioTakeSourceRefCopyLaws:
    public:
        def format_is_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            copied.format == source.format

        def original_identity_extents_are_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            copied.original_path.count == source.original_path.count and copied.original_sha256.count == source.original_sha256.count

        def runtime_identity_extents_are_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            copied.runtime_glb_path.count == source.runtime_glb_path.count and copied.runtime_glb_sha256.count == source.runtime_glb_sha256.count

        def processing_identity_extents_are_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            copied.importer_revision.count == source.importer_revision.count and copied.options_sha256.count == source.options_sha256.count

        def original_identity_bytes_are_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            StudioTakeSourceRefPolicy::bytes_equal(copied.original_path, source.original_path) and StudioTakeSourceRefPolicy::bytes_equal(copied.original_sha256, source.original_sha256)

        def runtime_identity_bytes_are_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            StudioTakeSourceRefPolicy::bytes_equal(copied.runtime_glb_path, source.runtime_glb_path) and StudioTakeSourceRefPolicy::bytes_equal(copied.runtime_glb_sha256, source.runtime_glb_sha256)

        def processing_identity_bytes_are_preserved(source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> bool:
            ensure result
            copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(source)
            StudioTakeSourceRefPolicy::bytes_equal(copied.importer_revision, source.importer_revision) and StudioTakeSourceRefPolicy::bytes_equal(copied.options_sha256, source.options_sha256)
