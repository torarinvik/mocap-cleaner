# Span and smoothing laws: clamped frames index the clip, lengths are positive,
# and smoothing leaves a constant signal unchanged.
include "../src/core/span.elisa"
include "../src/core/smooth.elisa"

module SpanLaws:
    public:
        def clamp_indexes(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Span::MAX_FRAMES
            ensure result >= 0
            ensure result < count
            return Span::clamp(frame, count)

        def clamp_keeps_inside(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Span::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            ensure result == frame
            return Span::clamp(frame, count)

        def single_frame_length(frame: i64) -> i64:
            requires frame >= 0
            requires frame < Span::MAX_FRAMES
            ensure result >= 1
            return Span::length(frame, frame)

        def own_frame_contained(frame: i64) -> bool:
            ensure result
            return Span::contains(frame, frame, frame)

        def before_not_contained(first: i64, last: i64, frame: i64) -> bool:
            requires frame < first
            ensure not result
            return Span::contains(first, last, frame)

        def after_not_contained(first: i64, last: i64, frame: i64) -> bool:
            requires frame > last
            ensure not result
            return Span::contains(first, last, frame)

        # Binomial smoothing of a constant signal is exact.
        def smooth_constant(v: i64) -> i64:
            requires v >= -Smooth::LIMIT
            requires v <= Smooth::LIMIT
            ensure result == v
            return Smooth::binomial(v, v, v)

        # Two passes of smoothing on a constant are still exact.
        def smooth_constant_twice(v: i64) -> i64:
            requires v >= -Smooth::LIMIT
            requires v <= Smooth::LIMIT
            ensure result == v
            once: i64 = Smooth::binomial(v, v, v)
            return Smooth::binomial(once, once, once)
