include "../src/studio/export_report_path_policy.elisa"

module StudioExportReportPathLaws:
    public:
        def last_fitting_destination() -> bool:
            ensure result
            StudioExportReportPathPolicy::admitted(4083)

        def json_suffix_overflow_is_rejected() -> bool:
            ensure not result
            StudioExportReportPathPolicy::admitted(4084)

        def empty_destination_is_rejected() -> bool:
            ensure not result
            StudioExportReportPathPolicy::admitted(0)

        def negative_destination_is_rejected() -> bool:
            ensure not result
            StudioExportReportPathPolicy::admitted(-1)

        def admitted_destination_has_room(length: i64) -> bool:
            requires StudioExportReportPathPolicy::admitted(length)
            ensure result
            length > 0 and length <= 4083 and length <= 4084
