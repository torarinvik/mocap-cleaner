include "../src/studio/tooltip_layout_policy.elisa"

module StudioTooltipLayoutPolicyLaws:
    public:
        def extent_fits(available: i64, requested: i64) -> bool:
            requires available >= 0 and available <= 16384
            requires requested >= 0 and requested <= 16384
            ensure result == true
            size: i64 = StudioTooltipLayoutPolicy::extent(available, requested)
            size >= 0 and size <= available and size <= requested

        def placement_fits(available: i64, requested: i64, preferred: i64) -> bool:
            requires available >= 0 and available <= 16384
            requires requested >= 0 and requested <= 16384
            requires preferred >= -16384 and preferred <= 16384
            ensure result == true
            size: i64 = StudioTooltipLayoutPolicy::extent(available, requested)
            start: i64 = StudioTooltipLayoutPolicy::origin(available, size, preferred)
            start >= 0 and start + size <= available

        def fitting_position_is_preserved(available: i64, size: i64, preferred: i64) -> bool:
            requires available >= 0 and available <= 16384
            requires size >= 0 and size <= available
            requires preferred >= 0 and preferred <= available - size
            ensure result == true
            StudioTooltipLayoutPolicy::origin(available, size, preferred) == preferred
