include "../src/studio/workspace_entry_layout_policy.elisa"

module StudioWorkspaceEntryLayoutPolicyLaws:
    def visible_trigger_clears_existing_badge() -> void:
        assert StudioWorkspaceEntryLayoutPolicy::trigger_below_badge(
            StudioWorkspaceEntryLayoutPolicy::Geometry::TOP,
            StudioWorkspaceEntryLayoutPolicy::Geometry::HEIGHT,
            37.0)

    def popup_opens_under_trigger() -> void:
        assert StudioWorkspaceEntryLayoutPolicy::Geometry::POPUP_TOP ==
            StudioWorkspaceEntryLayoutPolicy::Geometry::TOP + StudioWorkspaceEntryLayoutPolicy::Geometry::HEIGHT + 4.0
        assert StudioWorkspaceEntryLayoutPolicy::popup_aligned_with_trigger(8.0, 8.0)

    def empty_state_names_workspace_action() -> void:
        assert StudioWorkspaceEntryLayoutPolicy::trigger_label(false, false) == "Choose Workspace"

    def pending_state_names_next_setup_action() -> void:
        assert StudioWorkspaceEntryLayoutPolicy::trigger_label(false, true) == "Finish Setup"

    def ready_state_keeps_file_menu_label() -> void:
        assert StudioWorkspaceEntryLayoutPolicy::trigger_label(true, false) == "Workspace / File"
