# Contracts for the Go to frame input boundary and its frame-base conversion.
include "../src/studio/timeline_goto_policy.elisa"

module StudioTimelineGotoPolicyLaws:
    public:
        def exact_first_frame() -> i64:
            ensure result == 0
            StudioTimelineGotoPolicy::bounded_frame(1, 24)

        def exact_last_frame() -> i64:
            ensure result == 23
            StudioTimelineGotoPolicy::bounded_frame(24, 24)

        def oversized_frame_clamps() -> i64:
            ensure result == 23
            StudioTimelineGotoPolicy::bounded_frame(25, 24)

        def single_frame_clip() -> i64:
            ensure result == 0
            StudioTimelineGotoPolicy::bounded_frame(1, 1)
