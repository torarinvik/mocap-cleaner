include "../src/studio/export_recovery_ui_policy.elisa"

module StudioExportRecoveryUiLaws:
    public:
        def retry_request_requires_all_guards(open: bool, selected: bool, admitted: bool) -> bool:
            requires open and selected and admitted
            ensure result
            StudioExportRecoveryUiPolicy::retry_requested(open, selected, admitted)

        def failed_gates_cannot_request_retry(open: bool, selected: bool, admitted: bool) -> bool:
            requires not open or not selected or not admitted
            ensure result
            not StudioExportRecoveryUiPolicy::retry_requested(open, selected, admitted)

        def selected_rows_remain_in_bounds(index: i64, count: i64, forward: bool) -> bool:
            requires count > 0 and index >= 0 and index < count
            ensure result
            selected: i64 = StudioExportRecoveryUiPolicy::selection_after(index, count, forward)
            selected >= 0 and selected < count

        def refresh_is_reachable(open: bool, selected: bool, admitted: bool) -> bool:
            requires open
            ensure result
            StudioExportRecoveryUiPolicy::activate(open, StudioExportRecoveryUiPolicy::Focus.Refresh, selected, admitted) == StudioExportRecoveryUiPolicy::Intent.Refresh

        def no_hit_never_activates(open: bool, selected: bool, admitted: bool) -> bool:
            ensure result
            StudioExportRecoveryUiPolicy::activate(open, StudioExportRecoveryUiPolicy::Focus.NoHit, selected, admitted) == StudioExportRecoveryUiPolicy::Intent.Ignore

        def focus_cycle_covers_all_actions(focus: StudioExportRecoveryUiPolicy::Focus) -> bool:
            requires focus != StudioExportRecoveryUiPolicy::Focus.NoHit
            ensure result
            forward: StudioExportRecoveryUiPolicy::Focus = StudioExportRecoveryUiPolicy::focus_forward(focus)
            StudioExportRecoveryUiPolicy::focus_backward(forward) == focus

        def recovery_tree_keeps_actions_under_dialog(id: usize) -> bool:
            requires id >= StudioExportRecoveryUiPolicy::Node::ACTION_FIRST
            requires id < StudioExportRecoveryUiPolicy::Node::ACTION_FIRST + StudioExportRecoveryUiPolicy::Node::ACTION_COUNT.usize()
            ensure result
            StudioExportRecoveryUiPolicy::node_parent(id) == StudioExportRecoveryUiPolicy::Node::DIALOG

        def action_nodes_round_trip(focus: StudioExportRecoveryUiPolicy::Focus) -> bool:
            requires focus != StudioExportRecoveryUiPolicy::Focus.NoHit
            ensure result
            StudioExportRecoveryUiPolicy::action_from_node(StudioExportRecoveryUiPolicy::action_node(focus)) == focus

        def prepared_retry_needs_known_matching_paths(glb: StudioExportRecoveryUiPolicy::ReportCheck,
                json: StudioExportRecoveryUiPolicy::ReportCheck, text: StudioExportRecoveryUiPolicy::ReportCheck) -> bool:
            requires glb == StudioExportRecoveryUiPolicy::ReportCheck.Missing or glb == StudioExportRecoveryUiPolicy::ReportCheck.Matches
            requires json == StudioExportRecoveryUiPolicy::ReportCheck.Missing or json == StudioExportRecoveryUiPolicy::ReportCheck.Matches
            requires text == StudioExportRecoveryUiPolicy::ReportCheck.Missing or text == StudioExportRecoveryUiPolicy::ReportCheck.Matches
            ensure result
            StudioExportRecoveryUiPolicy::retry_enabled(StudioExportRecoveryUiPolicy::RecoveryCheck.VerifiedPrepared, glb, json, text)

        def conflicts_disable_recovery_retry(glb: StudioExportRecoveryUiPolicy::ReportCheck,
                json: StudioExportRecoveryUiPolicy::ReportCheck, text: StudioExportRecoveryUiPolicy::ReportCheck) -> bool:
            requires glb == StudioExportRecoveryUiPolicy::ReportCheck.Conflicts or json == StudioExportRecoveryUiPolicy::ReportCheck.Conflicts or text == StudioExportRecoveryUiPolicy::ReportCheck.Conflicts
            ensure result
            not StudioExportRecoveryUiPolicy::retry_enabled(StudioExportRecoveryUiPolicy::RecoveryCheck.VerifiedPrepared, glb, json, text)

        def single_record_disables_navigation(count: i64, check: StudioExportRecoveryUiPolicy::RecoveryCheck,
                glb: StudioExportRecoveryUiPolicy::ReportCheck, json: StudioExportRecoveryUiPolicy::ReportCheck,
                text: StudioExportRecoveryUiPolicy::ReportCheck) -> bool:
            requires count <= 1
            ensure result
            not StudioExportRecoveryUiPolicy::action_enabled(StudioExportRecoveryUiPolicy::Focus.Previous, count, check, glb, json, text) and not StudioExportRecoveryUiPolicy::action_enabled(StudioExportRecoveryUiPolicy::Focus.Next, count, check, glb, json, text)

        def no_hit_is_disabled(count: i64, check: StudioExportRecoveryUiPolicy::RecoveryCheck,
                glb: StudioExportRecoveryUiPolicy::ReportCheck, json: StudioExportRecoveryUiPolicy::ReportCheck,
                text: StudioExportRecoveryUiPolicy::ReportCheck) -> bool:
            ensure result
            not StudioExportRecoveryUiPolicy::action_enabled(StudioExportRecoveryUiPolicy::Focus.NoHit, count, check, glb, json, text)

        def empty_inventory_disables_retry(count: i64, check: StudioExportRecoveryUiPolicy::RecoveryCheck,
                glb: StudioExportRecoveryUiPolicy::ReportCheck, json: StudioExportRecoveryUiPolicy::ReportCheck,
                text: StudioExportRecoveryUiPolicy::ReportCheck) -> bool:
            requires count <= 0
            ensure result
            not StudioExportRecoveryUiPolicy::action_enabled(StudioExportRecoveryUiPolicy::Focus.Retry, count, check, glb, json, text)
