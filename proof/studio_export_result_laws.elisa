# Keyboard navigation cycles through the post-publication handoff actions.
include "../src/studio/export_result.elisa"

module StudioExportResultLaws:
    public:
        def focus_wraps_forward() -> bool:
            StudioExportResult::move_focus(StudioExportResult::DONE, 1) == StudioExportResult::OPEN

        def focus_wraps_backward() -> bool:
            StudioExportResult::move_focus(StudioExportResult::OPEN, -1) == StudioExportResult::DONE

        def focus_preserves_adjacent_order(current: i64, direction: i64) -> bool:
            requires current > StudioExportResult::OPEN and current < StudioExportResult::DONE
            requires direction == -1 or direction == 1
            StudioExportResult::move_focus(current, direction) == current + direction
