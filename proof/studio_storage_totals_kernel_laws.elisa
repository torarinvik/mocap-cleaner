include "../src/studio/storage_totals_kernel.elisa"

module StudioStorageTotalsKernelLaws:
    public:
        def manifest_total_fits_signed_i64() -> bool:
            ensure StudioStorageTotalsKernel::Capacity::MAX_TOTAL_BYTES == 256000000000000000
            ensure StudioStorageTotalsKernel::Capacity::MAX_TOTAL_BYTES < 9223372036854775807
            true
