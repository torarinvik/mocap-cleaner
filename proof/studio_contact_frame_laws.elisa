# Typed contact frame edits preserve inclusive interval and clip bounds.
include "../src/studio/contact_frame_policy.elisa"

module StudioContactFrameLaws:
    public:
        def accepted_frame_edit_preserves_clip(first: i64, last: i64, frame_count: i64, target: i64, requested: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactFramePolicy::Domain::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(first, last, frame_count, target, requested)
            p.first >= 0 and p.first <= p.last and p.last < frame_count

        def rejected_frame_edit_is_atomic(first: i64, last: i64, frame_count: i64, target: i64, requested: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactFramePolicy::Domain::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(first, last, frame_count, target, requested)
            p.valid or (p.first == first and p.last == last)

        def unchanged_interval_is_noop(first: i64, last: i64) -> bool:
            ensure result
            not StudioContactFramePolicy::changes_interval(first, last,
                StudioContactFramePolicy::FramePlan{valid: true, first: first, last: last})

        def invalid_plan_never_changes_interval(first: i64, last: i64, next_first: i64, next_last: i64) -> bool:
            ensure result
            not StudioContactFramePolicy::changes_interval(first, last,
                StudioContactFramePolicy::FramePlan{valid: false, first: next_first, last: next_last})
