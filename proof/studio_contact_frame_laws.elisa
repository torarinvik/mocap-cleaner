# Typed contact frame edits preserve inclusive interval and clip bounds.
include "../src/studio/contact_editor.elisa"

module StudioContactFrameLaws:
    public:
        def accepted_frame_edit_preserves_clip(first: i64, last: i64, frame_count: i64, target: i64, requested: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactEditor::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactEditor::FramePlan = StudioContactEditor::frame_plan(first, last, frame_count, target, requested)
            p.first >= 0 and p.first <= p.last and p.last < frame_count

        def rejected_frame_edit_is_atomic(first: i64, last: i64, frame_count: i64, target: i64, requested: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactEditor::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactEditor::FramePlan = StudioContactEditor::frame_plan(first, last, frame_count, target, requested)
            p.valid or (p.first == first and p.last == last)

        def accepted_frame_edit_changes_only_selected_endpoint(first: i64, last: i64, frame_count: i64, target: i64, requested: i64) -> bool:
            requires frame_count >= 1 and frame_count <= StudioContactEditor::MAX_FRAMES
            requires first >= 0 and first <= last and last < frame_count
            ensure result
            p: StudioContactEditor::FramePlan = StudioContactEditor::frame_plan(first, last, frame_count, target, requested)
            not p.valid or (target == StudioContactEditor::NUDGE_FIRST and p.first == requested - 1 and p.last == last) or (target == StudioContactEditor::NUDGE_LAST and p.first == first and p.last == requested - 1)
