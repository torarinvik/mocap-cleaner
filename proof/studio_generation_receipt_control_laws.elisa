include "../src/studio/state/generation_receipt_control_policy.elisa"

module StudioGenerationReceiptControlLaws:
    public:
        def legacy_is_not_full_review(manifest: bool, inputs: bool) -> bool:
            ensure not result
            StudioGenerationReceiptControlPolicy::controls_admitted(StudioGenerationReceiptControlPolicy::Evidence.Legacy, manifest, inputs)

        def changed_manifest_refuses(inputs: bool) -> bool:
            ensure not result
            StudioGenerationReceiptControlPolicy::controls_admitted(StudioGenerationReceiptControlPolicy::Evidence.ReviewedControls, false, inputs)

        def changed_inputs_refuse(manifest: bool) -> bool:
            ensure not result
            StudioGenerationReceiptControlPolicy::controls_admitted(StudioGenerationReceiptControlPolicy::Evidence.ReviewedControls, manifest, false)

        def matching_reviewed_controls_admitted() -> bool:
            ensure result
            StudioGenerationReceiptControlPolicy::controls_admitted(StudioGenerationReceiptControlPolicy::Evidence.ReviewedControls, true, true)

        def package_requires_input_digest() -> bool:
            ensure not result
            StudioGenerationReceiptControlPolicy::package_input_admitted(true, false, true)

        def build_input_is_not_applicable() -> bool:
            ensure result
            StudioGenerationReceiptControlPolicy::package_input_admitted(false, false, true)
