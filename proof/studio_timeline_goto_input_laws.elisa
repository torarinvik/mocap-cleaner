include "../src/studio/timeline_goto_kernel.elisa"

module StudioTimelineGotoInputLaws:
    public:
        def empty_needs_no_storage() -> bool:
            ensure result
            StudioTimelineGotoKernel::draft_extent_valid(0, false)

        def complete_draft_fits() -> bool:
            ensure result
            StudioTimelineGotoKernel::draft_extent_valid(StudioTimelineGotoKernel::Input::MAX_DIGITS, true)

        def oversized_draft_refused() -> bool:
            ensure result
            not StudioTimelineGotoKernel::draft_extent_valid(StudioTimelineGotoKernel::Input::MAX_DIGITS + 1, true)

        def negative_extent_refused() -> bool:
            ensure result
            not StudioTimelineGotoKernel::draft_extent_valid(-1, true)

        def missing_storage_refused(length: i64) -> bool:
            requires length > 0
            ensure result
            not StudioTimelineGotoKernel::draft_extent_valid(length, false)

        def decimal_bytes_admitted(byte: u8) -> bool:
            requires byte >= 48 and byte <= 57
            ensure result
            StudioTimelineGotoKernel::digit_byte(byte)

        def non_decimal_bytes_refused(byte: u8) -> bool:
            requires byte < 48 or byte > 57
            ensure result
            not StudioTimelineGotoKernel::digit_byte(byte)
