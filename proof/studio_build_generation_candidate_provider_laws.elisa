# Provider bounds and fail-closed row admission laws.
include "../src/studio/io/build_generation_candidate_provider.elisa"

module StudioBuildGenerationCandidateProviderLaws:
    public:
        def oldest_supported_age_valid() -> bool:
            ensure result
            StudioBuildGenerationCandidateProvider::age_valid(StudioBuildGenerationCandidateProvider::AgeEvidence.Verified(days: StudioBuildGenerationCandidateProvider::Limit::MAX_AGE_DAYS, origin: StudioBuildGenerationCandidateProvider::AgeOrigin.FilesystemBirthtime))

        def oversized_age_refused(days: i64) -> bool:
            requires days > StudioBuildGenerationCandidateProvider::Limit::MAX_AGE_DAYS
            ensure not result
            StudioBuildGenerationCandidateProvider::age_valid(StudioBuildGenerationCandidateProvider::AgeEvidence.Verified(days: days, origin: StudioBuildGenerationCandidateProvider::AgeOrigin.FilesystemBirthtime))

        def largest_supported_size_valid() -> bool:
            ensure result
            StudioBuildGenerationCandidateProvider::size_valid(StudioBuildGenerationCandidateProvider::SizeEvidence.Verified(bytes: StudioBuildGenerationCandidateProvider::Limit::MAX_SIZE_BYTES))

        def oversized_size_refused(bytes: i64) -> bool:
            requires bytes > StudioBuildGenerationCandidateProvider::Limit::MAX_SIZE_BYTES
            ensure not result
            StudioBuildGenerationCandidateProvider::size_valid(StudioBuildGenerationCandidateProvider::SizeEvidence.Verified(bytes: bytes))

        def overflow_never_returns_partial_rows() -> bool:
            ensure result
            StudioBuildGenerationCandidateProvider::snapshot_valid(
                StudioBuildGenerationCandidateProvider::Snapshot{
                    outcome: StudioBuildGenerationCandidateProvider::Outcome.Overflow,
                    rows: [], refusal_code: 1, retention_days: 30})

        def unsealed_artifact_cannot_be_eligible(row: StudioBuildGenerationCandidateProvider::Row) -> bool:
            requires row.phase == StudioBuildGenerationCandidateProvider::CreationPhase.Created or row.phase == StudioBuildGenerationCandidateProvider::CreationPhase.Building or row.phase == StudioBuildGenerationCandidateProvider::CreationPhase.Failed
            ensure not result
            row.protection == StudioBuildGenerationCandidateProvider::Protection.Eligible and StudioBuildGenerationCandidateProvider::row_valid(row)

        def absent_product_identity_is_explicit(identity: StudioBuildGenerationCandidateProvider::ProductIdentity) -> bool:
            requires StudioBuildGenerationCandidateProvider::product_identity_absent(identity)
            ensure result
            StudioBuildGenerationCandidateProvider::product_identity_valid(identity)

        def malformed_snapshot_refuses(snapshot: StudioBuildGenerationCandidateProvider::Snapshot) -> bool:
            requires snapshot.rows.count > StudioBuildGenerationCandidateProvider::Limit::MAX_ROWS
            ensure not result
            StudioBuildGenerationCandidateProvider::snapshot_valid(snapshot)
