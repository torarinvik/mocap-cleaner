# Suggestion previews are explicit, revision-bound, and fail closed on missing
# preservation evidence or unvalidated contact locks.
include "../src/studio/suggestion_policy.elisa"

module StudioSuggestionPolicyLaws:
    public:
        def contact_lock_needs_validation_and_opt_in() -> bool:
            ensure result
            StudioSuggestionPolicy::may_enable_contact_lock(true, true) and not StudioSuggestionPolicy::may_enable_contact_lock(false, true) and not StudioSuggestionPolicy::may_enable_contact_lock(true, false) and not StudioSuggestionPolicy::may_enable_contact_lock(false, false)

        def unmeasured_candidate_never_passes() -> bool:
            ensure result
            not StudioSuggestionPolicy::metrics_pass(false, true, true, true, true, true)

        def every_preservation_dimension_is_required() -> bool:
            ensure result
            not StudioSuggestionPolicy::metrics_pass(true, false, true, true, true, true) and not StudioSuggestionPolicy::metrics_pass(true, true, false, true, true, true) and not StudioSuggestionPolicy::metrics_pass(true, true, true, false, true, true) and not StudioSuggestionPolicy::metrics_pass(true, true, true, true, false, true) and not StudioSuggestionPolicy::metrics_pass(true, true, true, true, true, false)

        def ready_candidate_opens_once() -> bool:
            ensure result
            StudioSuggestionPolicy::open_decision(StudioSuggestionPolicy::State.Closed, true, true, 4, 9) == StudioSuggestionPolicy::Decision.Opened and StudioSuggestionPolicy::open_decision(StudioSuggestionPolicy::State.Open, true, true, 4, 9) == StudioSuggestionPolicy::Decision.NoChange

        def unchanged_candidate_does_not_open() -> bool:
            ensure result
            StudioSuggestionPolicy::open_decision(StudioSuggestionPolicy::State.Closed, true, false, 4, 9) == StudioSuggestionPolicy::Decision.NoChange

        def unavailable_candidate_does_not_open() -> bool:
            ensure result
            StudioSuggestionPolicy::open_decision(StudioSuggestionPolicy::State.Closed, false, true, 4, 9) == StudioSuggestionPolicy::Decision.NoChange

        def negative_revision_does_not_open() -> bool:
            ensure result
            StudioSuggestionPolicy::open_decision(StudioSuggestionPolicy::State.Closed, true, true, -1, 9) == StudioSuggestionPolicy::Decision.NoChange

        def matching_measured_safe_preview_applies() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Open, 4, 9, 4, 9, true, true, true, true, true, true) == StudioSuggestionPolicy::Decision.Applied

        def changed_document_revision_is_stale() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Open, 4, 9, 5, 9, true, true, true, true, true, true) == StudioSuggestionPolicy::Decision.Stale

        def changed_stack_revision_is_stale() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Open, 4, 9, 4, 10, true, true, true, true, true, true) == StudioSuggestionPolicy::Decision.Stale

        def invalid_revision_is_stale() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Open, -1, 9, -1, 9, true, true, true, true, true, true) == StudioSuggestionPolicy::Decision.Stale

        def unmeasured_preview_cannot_apply() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Open, 4, 9, 4, 9, false, true, true, true, true, true) == StudioSuggestionPolicy::Decision.Unmeasured

        def regressed_preview_cannot_apply() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Open, 4, 9, 4, 9, true, true, true, true, false, true) == StudioSuggestionPolicy::Decision.Regression

        def closed_preview_cannot_apply() -> bool:
            ensure result
            StudioSuggestionPolicy::apply_decision(StudioSuggestionPolicy::State.Closed, 4, 9, 4, 9, true, true, true, true, true, true) == StudioSuggestionPolicy::Decision.Invalid

        def cancellation_only_closes_open_preview() -> bool:
            ensure result
            StudioSuggestionPolicy::cancel_decision(StudioSuggestionPolicy::State.Open) == StudioSuggestionPolicy::Decision.Cancelled and StudioSuggestionPolicy::cancel_decision(StudioSuggestionPolicy::State.Closed) == StudioSuggestionPolicy::Decision.NoChange

        def event_range_is_closed() -> bool:
            ensure result
            StudioSuggestionPolicy::event_valid(StudioSuggestionPolicy::Event.Open) and StudioSuggestionPolicy::event_valid(StudioSuggestionPolicy::Event.Apply) and StudioSuggestionPolicy::event_valid(StudioSuggestionPolicy::Event.Cancel)

        def no_op_never_creates_history() -> bool:
            ensure result
            not StudioSuggestionPolicy::may_commit_candidate(false, StudioSuggestionPolicy::Decision.Applied)

        def non_applied_decision_never_commits(candidate_changed: bool, decision: StudioSuggestionPolicy::Decision) -> bool:
            requires decision != StudioSuggestionPolicy::Decision.Applied
            ensure result
            not StudioSuggestionPolicy::may_commit_candidate(candidate_changed, decision)

        def stale_candidate_cannot_be_previewed(state: StudioSuggestionPolicy::State, exists: bool, requested: bool) -> bool:
            ensure result
            not StudioSuggestionPolicy::may_preview_candidate(state, exists, false, requested)

        def absent_candidate_cannot_be_previewed(state: StudioSuggestionPolicy::State, fresh: bool, requested: bool) -> bool:
            ensure result
            not StudioSuggestionPolicy::may_preview_candidate(state, false, fresh, requested)
