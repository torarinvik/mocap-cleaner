include "../src/studio/state/generation_review_path_policy.elisa"

module StudioGenerationReviewPathInspectorLaws:
    public:
        def path_bound_is_enforced(path: darray[u8]&) -> bool:
            requires path.count.i64() > StudioGenerationReviewPathPolicy::Limit::MAX_PATH_BYTES
            ensure not StudioGenerationReviewPathPolicy::path_valid(path)
            StudioGenerationReviewPathPolicy::path_valid(path)

        def path_page_count_is_bounded(path: darray[u8]&) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            ensure StudioGenerationReviewPathPolicy::page_count(path) > 0
            ensure StudioGenerationReviewPathPolicy::page_count(path) <= StudioGenerationReviewPathPolicy::Limit::MAX_PAGES
            StudioGenerationReviewPathPolicy::page_count(path) <= StudioGenerationReviewPathPolicy::Limit::MAX_PAGES

        def invalid_utf8_uses_bounded_escape_lines(path: darray[u8]&) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires StudioGenerationReviewPathPolicy::escaped_display(path)
            ensure StudioGenerationReviewPathPolicy::line_end(path, 0) <= StudioGenerationReviewPathPolicy::Limit::ESCAPED_BYTES_PER_LINE
            StudioGenerationReviewPathPolicy::line_end(path, 0) <= StudioGenerationReviewPathPolicy::Limit::ESCAPED_BYTES_PER_LINE

        def line_segment_advances_bounded_path(path: darray[u8]&, start: usize) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires start < path.count
            ensure StudioGenerationReviewPathPolicy::line_end(path, start) > start
            ensure StudioGenerationReviewPathPolicy::line_end(path, start) <= start + StudioGenerationReviewPathPolicy::Limit::MAX_LINE_BYTES
            StudioGenerationReviewPathPolicy::line_end(path, start) <= path.count

        def responsive_panel_stays_in_view(view_w: f32, view_h: f32) -> bool:
            requires view_w >= 0.0 and view_h >= 0.0
            ensure StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).x >= 0.0 and StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).y >= 0.0
            ensure StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).x + StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).w <= view_w and StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).y + StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).h <= view_h
            panel: StudioGenerationReviewPathPolicy::Geometry = StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h)
            panel.x + panel.w <= view_w and panel.y + panel.h <= view_h

        def responsive_controls_stay_in_panel(view_w: f32, view_h: f32) -> bool:
            requires view_w >= 0.0 and view_h >= 0.0
            ensure StudioGenerationReviewPathPolicy::panel_button_box(StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h), 2).x >= StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).x
            ensure StudioGenerationReviewPathPolicy::panel_button_box(StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h), 2).y >= StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).y
            ensure StudioGenerationReviewPathPolicy::panel_button_box(StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h), 2).x + StudioGenerationReviewPathPolicy::panel_button_box(StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h), 2).w <= StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).x + StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).w
            ensure StudioGenerationReviewPathPolicy::panel_button_box(StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h), 2).y + StudioGenerationReviewPathPolicy::panel_button_box(StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h), 2).h <= StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).y + StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h).h
            panel: StudioGenerationReviewPathPolicy::Geometry = StudioGenerationReviewPathPolicy::panel_geometry(view_w, view_h)
            control: StudioGenerationReviewPathPolicy::Geometry = StudioGenerationReviewPathPolicy::panel_button_box(panel, 2)
            control.x + control.w <= panel.x + panel.w and control.y + control.h <= panel.y + panel.h

        def inspect_button_uses_review_panel(view_w: f32, view_h: f32) -> bool:
            requires view_w >= 0.0 and view_h >= 0.0
            ensure StudioGenerationReviewPathPolicy::review_inspect_box(StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)).x >= StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h).x
            ensure StudioGenerationReviewPathPolicy::review_inspect_box(StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)).y >= StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h).y
            ensure StudioGenerationReviewPathPolicy::review_inspect_box(StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)).x + StudioGenerationReviewPathPolicy::review_inspect_box(StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)).w <= StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h).x + StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h).w
            ensure StudioGenerationReviewPathPolicy::review_inspect_box(StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)).y + StudioGenerationReviewPathPolicy::review_inspect_box(StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)).h <= StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h).y + StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h).h
            review: StudioGenerationReviewPathPolicy::Geometry = StudioGenerationReviewPathPolicy::review_geometry(view_w, view_h)
            control: StudioGenerationReviewPathPolicy::Geometry = StudioGenerationReviewPathPolicy::review_inspect_box(review)
            control.x + control.w <= review.x + review.w and control.y + control.h <= review.y + review.h

        def consecutive_lines_are_contiguous(path: darray[u8]&, line: usize) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires StudioGenerationReviewPathPolicy::line_start(path, line) < path.count
            ensure StudioGenerationReviewPathPolicy::line_start(path, line + 1) == StudioGenerationReviewPathPolicy::line_end(path, StudioGenerationReviewPathPolicy::line_start(path, line))
            StudioGenerationReviewPathPolicy::line_start(path, line + 1) == StudioGenerationReviewPathPolicy::line_end(path, StudioGenerationReviewPathPolicy::line_start(path, line))

        def valid_utf8_lines_keep_scalar_boundaries(path: darray[u8]&, line: usize) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires not StudioGenerationReviewPathPolicy::escaped_display(path)
            requires StudioGenerationReviewPathPolicy::line_start(path, line) < path.count
            ensure StudioGenerationReviewPathPolicy::utf8_boundary(path, StudioGenerationReviewPathPolicy::line_start(path, line))
            ensure StudioGenerationReviewPathPolicy::utf8_boundary(path, StudioGenerationReviewPathPolicy::line_end(path, StudioGenerationReviewPathPolicy::line_start(path, line)))
            StudioGenerationReviewPathPolicy::utf8_boundary(path, StudioGenerationReviewPathPolicy::line_end(path, StudioGenerationReviewPathPolicy::line_start(path, line)))

        def visible_path_rows_stay_bounded(path: darray[u8]&, page: i64) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires page >= 0 and page < StudioGenerationReviewPathPolicy::page_count(path)
            ensure StudioGenerationReviewPathPolicy::visible_lines(path, page) > 0
            StudioGenerationReviewPathPolicy::visible_lines(path, page) <= StudioGenerationReviewPathPolicy::Limit::LINES_PER_PAGE
