include "../src/studio/state/generation_review_path_policy.elisa"

module StudioGenerationReviewPathInspectorLaws:
    public:
        def path_bound_is_enforced(path: darray[u8]&) -> bool:
            requires path.count.i64() > StudioGenerationReviewPathPolicy::Limit::MAX_PATH_BYTES
            ensure not StudioGenerationReviewPathPolicy::path_valid(path)
            StudioGenerationReviewPathPolicy::path_valid(path)

        def path_page_count_is_bounded(path: darray[u8]&) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            ensure StudioGenerationReviewPathPolicy::page_count(path) > 0
            ensure StudioGenerationReviewPathPolicy::page_count(path) <= StudioGenerationReviewPathPolicy::Limit::MAX_PAGES
            StudioGenerationReviewPathPolicy::page_count(path) <= StudioGenerationReviewPathPolicy::Limit::MAX_PAGES

        def line_segment_advances_bounded_path(path: darray[u8]&, start: usize) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires start < path.count
            ensure StudioGenerationReviewPathPolicy::line_end(path, start) > start
            ensure StudioGenerationReviewPathPolicy::line_end(path, start) <= start + StudioGenerationReviewPathPolicy::Limit::LINE_BYTES
            StudioGenerationReviewPathPolicy::line_end(path, start) <= path.count

        def consecutive_lines_are_contiguous(path: darray[u8]&, line: usize) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires StudioGenerationReviewPathPolicy::line_start(path, line) < path.count
            ensure StudioGenerationReviewPathPolicy::line_start(path, line + 1) == StudioGenerationReviewPathPolicy::line_end(path, StudioGenerationReviewPathPolicy::line_start(path, line))
            StudioGenerationReviewPathPolicy::line_start(path, line + 1) == StudioGenerationReviewPathPolicy::line_end(path, StudioGenerationReviewPathPolicy::line_start(path, line))

        def visible_path_rows_stay_bounded(path: darray[u8]&, page: i64) -> bool:
            requires StudioGenerationReviewPathPolicy::path_valid(path)
            requires page >= 0 and page < StudioGenerationReviewPathPolicy::page_count(path)
            ensure StudioGenerationReviewPathPolicy::visible_lines(path, page) > 0
            StudioGenerationReviewPathPolicy::visible_lines(path, page) <= StudioGenerationReviewPathPolicy::Limit::LINES_PER_PAGE
