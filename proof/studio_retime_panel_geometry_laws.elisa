include "../src/studio/app/retime_panel_geometry.elisa"

module StudioRetimePanelGeometryLaws:
    public:
        def controls_have_positive_hit_dimensions() -> bool:
            ensure result
            StudioRetime::Dimensions::PRESET_W > 0.0 and StudioRetime::Dimensions::ROW_H > 0.0 and StudioRetime::Dimensions::SLIDER_W > 0.0

        def timeline_band_has_positive_extent() -> bool:
            ensure result
            StudioRetime::Dimensions::BAND_Y >= 0.0 and StudioRetime::Dimensions::BAND_H > 0.0
