# Actual UTF-8 helper obligations, separate from display byte-cap arithmetic.
# Source/replay qualification of array/view helpers remains required.
include "../../elisa-ui/src/core/ui_text.elisa"

module StudioTextUtf8PrefixLaws:
    public:
        def complete_two_byte_scalar_is_kept() -> bool can Unsafe.PointerCast:
            ensure result == true
            bytes: u8[2] = [195, 169]
            text: sview = UiText::fixed_bytes_view_range[2](bytes, 0, 2)
            UiText::valid_utf8_prefix(text, 2) == 2

        def partial_two_byte_scalar_is_omitted() -> bool can Unsafe.PointerCast:
            ensure result == true
            bytes: u8[2] = [195, 169]
            text: sview = UiText::fixed_bytes_view_range[2](bytes, 0, 2)
            UiText::valid_utf8_prefix(text, 1) == 0

        def partial_four_byte_scalar_is_omitted() -> bool can Unsafe.PointerCast:
            ensure result == true
            bytes: u8[4] = [240, 159, 152, 128]
            text: sview = UiText::fixed_bytes_view_range[4](bytes, 0, 4)
            UiText::valid_utf8_prefix(text, 3) == 0
