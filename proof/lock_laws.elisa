# Foot-lock laws ("contacts are sacred"): a lock never moves the plant or lift
# frame, holds the anchor exactly once fully blended, and stays a permille.
include "../src/core/lock.elisa"

module LockLaws:
    public:
        # The plant frame keeps its source value.
        def plant_frame_untouched(value: i64, anchor: i64, left: i64, blend: i64) -> i64:
            requires value >= -Lock::LIMIT
            requires value <= Lock::LIMIT
            requires anchor >= -Lock::LIMIT
            requires anchor <= Lock::LIMIT
            requires left >= 0
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == value
            return Lock::locked(value, anchor, 0, left, blend)

        # The lift frame keeps its source value.
        def lift_frame_untouched(value: i64, anchor: i64, into: i64, blend: i64) -> i64:
            requires value >= -Lock::LIMIT
            requires value <= Lock::LIMIT
            requires anchor >= -Lock::LIMIT
            requires anchor <= Lock::LIMIT
            requires into >= 0
            requires into <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == value
            return Lock::locked(value, anchor, into, 0, blend)

        # Deep inside a plant the foot sits exactly on its anchor.
        def deep_plant_holds_anchor(value: i64, anchor: i64, into: i64, left: i64, blend: i64) -> i64:
            requires value >= -Lock::LIMIT
            requires value <= Lock::LIMIT
            requires anchor >= -Lock::LIMIT
            requires anchor <= Lock::LIMIT
            requires into >= blend
            requires into <= Fade::Domain::MAX_FRAMES
            requires left >= blend
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == anchor
            return Lock::locked(value, anchor, into, left, blend)

        # A foot already on its anchor never moves.
        def anchored_is_fixed(anchor: i64, into: i64, left: i64, blend: i64) -> i64:
            requires anchor >= -Lock::LIMIT
            requires anchor <= Lock::LIMIT
            requires into >= 0
            requires into <= Fade::Domain::MAX_FRAMES
            requires left >= 0
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == anchor
            return Lock::locked(anchor, anchor, into, left, blend)

        # The lock hold weight is symmetric in plant and lift distance.
        # The hold weight depends only on the nearer clip end, so swapping
        # the two distances cannot change it.
        def nearer_symmetric(into: i64, left: i64) -> bool:
            requires into >= 0
            requires into <= Fade::Domain::MAX_FRAMES
            requires left >= 0
            requires left <= Fade::Domain::MAX_FRAMES
            ensure result
            a: i64 = Fade::nearer(into, left)
            b: i64 = Fade::nearer(left, into)
            return a == b
