include "../src/studio/status_bar_layout_policy.elisa"

module StudioStatusBarLayoutPolicyLaws:
    public:
        def message_fits(width: i64) -> bool:
            requires width > 24 and width <= 16384
            ensure result == true
            StudioStatusBarLayoutPolicy::message_start(width) + StudioStatusBarLayoutPolicy::message_width(width) + 12 == width

        def regions_do_not_overlap(width: i64) -> bool:
            requires width >= -16384 and width <= 16384
            ensure result == true
            StudioStatusBarLayoutPolicy::summary_width(width) == 0 or StudioStatusBarLayoutPolicy::summary_width(width) + 24 == StudioStatusBarLayoutPolicy::message_start(width)

        def tiny_bar_draws_no_text(width: i64) -> bool:
            requires width >= -16384 and width <= 24
            ensure result == true
            StudioStatusBarLayoutPolicy::message_width(width) == 0 and StudioStatusBarLayoutPolicy::summary_width(width) == 0

        def text_regions_are_bounded(width: i64) -> bool:
            requires width > 24 and width <= 16384
            ensure result == true
            StudioStatusBarLayoutPolicy::message_width(width) >= 0 and StudioStatusBarLayoutPolicy::message_width(width) <= width and StudioStatusBarLayoutPolicy::summary_width(width) >= 0 and StudioStatusBarLayoutPolicy::summary_width(width) <= width
