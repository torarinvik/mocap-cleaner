include "../src/studio/session_save_target_policy.elisa"

module StudioSessionSaveTargetLaws:
    public:
        def failed_save_as_preserves_target() -> bool:
            ensure result
            not StudioSessionSaveTargetPolicy::may_adopt(false, true)

        def successful_save_as_adopts_target() -> bool:
            ensure result
            StudioSessionSaveTargetPolicy::may_adopt(true, true)

        def regular_save_keeps_target(write_succeeded: bool) -> bool:
            ensure result
            not StudioSessionSaveTargetPolicy::may_adopt(write_succeeded, false)
