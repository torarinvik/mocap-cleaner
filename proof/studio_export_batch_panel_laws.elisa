include "../src/studio/export_batch_panel_policy.elisa"

module StudioExportBatchPanelLaws:
    public:
        def visible_row_stays_inside_queue_page(first_row: i64,
                visible_count: i64, offset: i64) -> bool:
            requires visible_count >= 0 and visible_count <= 7
            requires first_row >= 0 and first_row <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and offset >= 0 and offset < visible_count
            ensure result
            hit: i64 = StudioExportBatchPanelPolicy::visible_row(first_row, visible_count, offset)
            hit >= first_row and hit < first_row + visible_count

        def visible_row_rejects_negative_or_offpage_offsets(first_row: i64,
                visible_count: i64, offset: i64) -> bool:
            requires first_row >= 0 and first_row <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and visible_count >= 0 and visible_count <= 7
            requires offset < 0 or offset >= visible_count
            ensure result
            StudioExportBatchPanelPolicy::visible_row(first_row, visible_count, offset) == -1

        def recoverable_status_stays_visible() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::row_state(StudioExportBatchQueuePolicy::ItemState.Recoverable, false) == "Recoverable · facts need inspection"

        def warning_status_requires_review_until_approved() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::row_state(StudioExportBatchQueuePolicy::ItemState.Warning, false) == "Warning · explicit review required" and StudioExportBatchPanelPolicy::row_state(StudioExportBatchQueuePolicy::ItemState.Warning, true) == "Warning · reviewed"

        def previous_page_uses_shared_admission(controls: StudioExportBatchPanelPolicy::Controls) -> bool:
            ensure result
            StudioExportBatchPanelPolicy::action_enabled(StudioExportBatchPanelPolicy::Focus.Previous, controls) == controls.previous

        def next_page_uses_shared_admission(controls: StudioExportBatchPanelPolicy::Controls) -> bool:
            ensure result
            StudioExportBatchPanelPolicy::action_enabled(StudioExportBatchPanelPolicy::Focus.Next, controls) == controls.next

        def close_remains_available(controls: StudioExportBatchPanelPolicy::Controls) -> bool:
            ensure result
            StudioExportBatchPanelPolicy::action_enabled(StudioExportBatchPanelPolicy::Focus.Close, controls)

        def uncertain_publication_is_explicit(receipt: StudioExportBatchPublication::Receipt) -> bool:
            requires StudioExportBatchPanelPolicy::publication_uncertain(receipt)
            ensure result
            StudioExportBatchPanelPolicy::receipt_summary(receipt) == "Publication durability unknown; inspect destinations"

        def empty_queue_has_no_rows() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::visible_count(0, 0) == 0

        def empty_queue_stays_on_first_page() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::page_move(0, 0, StudioExportBatchPanelPolicy::Direction.Next) == 0

        def previous_from_first_page_stays_put() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::page_move(0, 256, StudioExportBatchPanelPolicy::Direction.Previous) == 0

        def last_partial_page_shows_remaining_rows() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::last_page(256) == 252 and StudioExportBatchPanelPolicy::visible_count(252, 256) == 4

        def next_at_last_page_stays_put() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::page_move(252, 256, StudioExportBatchPanelPolicy::Direction.Next) == 252

        def shrinking_queue_clamps_the_page() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::page_move(252, 3, StudioExportBatchPanelPolicy::Direction.Next) == 0

        def keyboard_focus_skips_disabled_controls(current: StudioExportBatchPanelPolicy::Focus,
                reverse: bool, controls: StudioExportBatchPanelPolicy::Controls) -> bool:
            ensure result
            StudioExportBatchPanelPolicy::action_enabled(StudioExportBatchPanelPolicy::move_focus(current, reverse, controls), controls)

        def forward_focus_wraps() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::next_focus(StudioExportBatchPanelPolicy::Focus.Next, false) == StudioExportBatchPanelPolicy::Focus.Enqueue

        def reverse_focus_wraps() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::next_focus(StudioExportBatchPanelPolicy::Focus.Enqueue, true) == StudioExportBatchPanelPolicy::Focus.Next

        def unknown_native_focus_is_rejected(code: i64) -> bool:
            requires code < 0 or code > StudioExportBatchPanelPolicy::FocusDomain::LAST
            ensure result
            StudioExportBatchPanelPolicy::focus_from_code(code) == null

        def close_focus_names_close_action() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::action_for_focus(StudioExportBatchPanelPolicy::Focus.Close) == StudioExportBatchPanelPolicy::Action.Close

        def clean_prepared_result_needs_no_warning_review() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::prepared_publish_admitted(StudioExportBatchQueuePolicy::ItemState.Staged, false, false, false)

        def unreviewed_warning_cannot_publish() -> bool:
            ensure result
            not StudioExportBatchPanelPolicy::prepared_publish_admitted(StudioExportBatchQueuePolicy::ItemState.AwaitingReview, false, false, false)

        def reviewed_prepared_warning_can_publish() -> bool:
            ensure result
            StudioExportBatchPanelPolicy::prepared_publish_admitted(StudioExportBatchQueuePolicy::ItemState.AwaitingReview, true, false, false)

        def paused_queue_cannot_publish() -> bool:
            ensure result
            not StudioExportBatchPanelPolicy::prepared_publish_admitted(StudioExportBatchQueuePolicy::ItemState.Staged, true, false, true)

        def cancelled_queue_cannot_publish() -> bool:
            ensure result
            not StudioExportBatchPanelPolicy::prepared_publish_admitted(StudioExportBatchQueuePolicy::ItemState.Staged, true, true, false)
