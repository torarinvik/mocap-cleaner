# Select-first contact actions apply only to a valid side/frame selection.
include "../src/studio/contact_editor.elisa"

module StudioContactEditorLaws:
    public:
        def valid_selection_is_accepted(side: i64, frame: i64, frames: i64) -> bool:
            requires side >= 0
            requires side < StudioContactEditor::SIDE_COUNT
            requires frames >= 1
            requires frames <= StudioContactEditor::MAX_FRAMES
            requires frame >= 0
            requires frame < frames
            ensure result
            StudioContactEditor::selection_valid(side, frame, frames)

        def invalid_selection_is_rejected(side: i64, frame: i64, frames: i64) -> bool:
            requires side < 0 or side >= StudioContactEditor::SIDE_COUNT or frame < 0 or frame >= frames or frames < 1 or frames > StudioContactEditor::MAX_FRAMES
            ensure not result
            StudioContactEditor::selection_valid(side, frame, frames)

        def plant_action_requests_planted_state() -> bool:
            StudioContactEditor::plants(StudioContactEditor::PLANT)

        def lift_action_requests_lifted_state() -> bool:
            not StudioContactEditor::plants(StudioContactEditor::LIFT)

        def reset_action_is_valid() -> bool:
            StudioContactEditor::action_valid(StudioContactEditor::RESET)

        def delete_action_is_valid() -> bool:
            StudioContactEditor::action_valid(StudioContactEditor::DELETE)

        def deletion_compacts_before_or_after_removed_slot(destination: i64, removed: i64, count: i64) -> bool:
            requires count >= 1
            requires count <= StudioContactEditor::MAX_EDITS
            requires removed >= 0
            requires removed < count
            requires destination >= 0
            requires destination < count - 1
            ensure result
            mapped: i64 = StudioContactEditor::delete_source_index(destination, removed, count)
            (destination < removed and mapped == destination) or (destination >= removed and mapped == destination + 1)

        def click_slop_does_not_start_a_drag(delta_x: i64) -> bool:
            requires delta_x > 0 - StudioContactEditor::DRAG_SLOP
            requires delta_x < StudioContactEditor::DRAG_SLOP
            ensure result == false
            StudioContactEditor::is_drag(delta_x)

        def endpoint_motion_starts_a_drag(delta_x: i64) -> bool:
            requires delta_x <= 0 - StudioContactEditor::DRAG_SLOP or delta_x >= StudioContactEditor::DRAG_SLOP
            ensure result
            StudioContactEditor::is_drag(delta_x)
