# Laws for ranked-finding navigation, visible windows and accessibility IDs.
include "../src/studio/issue_browser_policy.elisa"

module StudioIssueBrowserLaws:
    public:
        def stale_findings_disable_navigation(count: i64, action: i64) -> bool:
            ensure result
            not StudioIssueBrowserPolicy::navigation_enabled(count, false, action)

        def empty_findings_disable_navigation(action: i64) -> bool:
            ensure result
            not StudioIssueBrowserPolicy::navigation_enabled(0, true, action)

        def invalid_action_disables_navigation(count: i64, action: i64) -> bool:
            requires action < StudioIssueBrowserPolicy::Action.Previous.i64() or action > StudioIssueBrowserPolicy::Action.Worst.i64()
            ensure result
            not StudioIssueBrowserPolicy::navigation_enabled(count, true, action)

        def ready_findings_enable_navigation(count: i64, action: i64) -> bool:
            requires count > 0 and count <= StudioIssueBrowserPolicy::Capacity::MAX_FINDINGS
            requires action >= StudioIssueBrowserPolicy::Action.Previous.i64() and action <= StudioIssueBrowserPolicy::Action.Worst.i64()
            ensure result
            StudioIssueBrowserPolicy::navigation_enabled(count, true, action)

        def group_attaches_to_sidebar(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::GROUP_ID, sidebar_id, no_node_id) == sidebar_id

        def filter_group_belongs_to_issue_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::GROUP_ID

        def detector_filter_belongs_to_filter_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_DETECTOR_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID

        def subject_filter_belongs_to_filter_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_SUBJECT_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID

        def severity_filter_belongs_to_filter_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_SEVERITY_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID

        def status_filter_belongs_to_filter_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_STATUS_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID

        def reset_filter_belongs_to_filter_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FILTER_RESET_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID

        def intent_filter_belongs_to_filter_group(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::Accessibility::FINDING_INTENT_ID, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID

        def action_controls_belong_to_group(id: usize, sidebar_id: usize, no_node_id: usize) -> bool:
            requires id == StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID or id == StudioIssueBrowserPolicy::Accessibility::NEXT_ID or id == StudioIssueBrowserPolicy::Accessibility::WORST_ID
            ensure result
            StudioIssueBrowserPolicy::node_parent(id, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::Accessibility::GROUP_ID

        def tree_order_ends_after_visible_rows(no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_first_child() == StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_GROUP_ID, StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS, no_node_id) == StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID and StudioIssueBrowserPolicy::filter_first_child() == StudioIssueBrowserPolicy::Accessibility::FILTER_DETECTOR_ID and StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_DETECTOR_ID, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_SUBJECT_ID and StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_SUBJECT_ID, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_SEVERITY_ID and StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_SEVERITY_ID, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_STATUS_ID and StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_STATUS_ID, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FILTER_RESET_ID and StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FILTER_RESET_ID, no_node_id) == StudioIssueBrowserPolicy::Accessibility::FINDING_INTENT_ID and StudioIssueBrowserPolicy::filter_next_sibling(StudioIssueBrowserPolicy::Accessibility::FINDING_INTENT_ID, no_node_id) == no_node_id and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID, StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS, no_node_id) == StudioIssueBrowserPolicy::Accessibility::NEXT_ID and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::NEXT_ID, StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS, no_node_id) == StudioIssueBrowserPolicy::Accessibility::WORST_ID and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::Accessibility::WORST_ID, StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS, no_node_id) == StudioIssueBrowserPolicy::row_id(0) and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(0), StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS, no_node_id) == StudioIssueBrowserPolicy::row_id(1) and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(1), StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS, no_node_id) == no_node_id

        def stale_rows_cannot_navigate(index: i64, visible_rows: i64) -> bool:
            requires visible_rows >= 0 and visible_rows <= StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS
            ensure not result
            StudioIssueBrowserPolicy::row_route_enabled(index, visible_rows, false)

        def navigation_stays_within_ranked_findings(current: i64, count: i64, action: i64) -> bool:
            requires count > 0 and count <= StudioIssueBrowserPolicy::Capacity::MAX_FINDINGS
            requires current >= 0 and current < count
            requires action >= StudioIssueBrowserPolicy::Action.Previous.i64() and action <= StudioIssueBrowserPolicy::Action.Worst.i64()
            ensure result
            target: i64 = StudioIssueBrowserPolicy::navigation_target(current, count, action)
            target >= 0 and target < count

        def next_wraps_from_last_to_first(count: i64) -> bool:
            requires count > 0 and count <= StudioIssueBrowserPolicy::Capacity::MAX_FINDINGS
            ensure result
            StudioIssueBrowserPolicy::next_target(count - 1, count) == 0

        def selected_finding_is_always_in_visible_window(selected: i64, count: i64) -> bool:
            requires count >= 0 and count <= 100000
            requires selected >= 0
            ensure result
            start: i64 = StudioIssueBrowserPolicy::window_start(selected, count)
            selected >= count or (selected >= start and selected < start + StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS)

        def visible_window_stays_inside_list(selected: i64, count: i64) -> bool:
            requires selected >= 0 and count >= 0 and count <= 100000
            ensure result
            start: i64 = StudioIssueBrowserPolicy::window_start(selected, count)
            start + StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS <= count or count <= StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS

        def a_windowed_row_route_targets_a_visible_rank(start: i64, slot: i64, count: i64) -> bool:
            requires count > StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS and count <= 100000
            requires start >= 0 and start <= 100000
            requires start + StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS <= count
            requires slot >= 0 and slot < StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS
            ensure result
            target: i64 = start + slot
            target >= start and target < start + StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS
