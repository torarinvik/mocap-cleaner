# Laws for ranked-finding navigation, visible windows and accessibility IDs.
include "../src/studio/issue_browser_policy.elisa"

module StudioIssueBrowserLaws:
    public:
        def group_attaches_to_sidebar(sidebar_id: usize, no_node_id: usize) -> bool:
            ensure result
            StudioIssueBrowserPolicy::node_parent(StudioIssueBrowserPolicy::GROUP_ID, sidebar_id, no_node_id) == sidebar_id

        def action_controls_belong_to_group(id: usize, sidebar_id: usize, no_node_id: usize) -> bool:
            requires id == StudioIssueBrowserPolicy::PREVIOUS_ID or id == StudioIssueBrowserPolicy::NEXT_ID or id == StudioIssueBrowserPolicy::WORST_ID
            ensure result
            StudioIssueBrowserPolicy::node_parent(id, sidebar_id, no_node_id) == StudioIssueBrowserPolicy::GROUP_ID

        def row_ids_fit_semantics_capacity(max_nodes: usize) -> bool:
            requires max_nodes > StudioIssueBrowserPolicy::ROW_ID_FIRST + StudioIssueBrowserPolicy::ROWS.usize()
            ensure result
            StudioIssueBrowserPolicy::row_id(0) < max_nodes and StudioIssueBrowserPolicy::row_id(StudioIssueBrowserPolicy::ROWS - 1) < max_nodes

        def tree_order_ends_after_visible_rows(no_node_id: usize) -> bool:
            StudioIssueBrowserPolicy::node_first_child() == StudioIssueBrowserPolicy::PREVIOUS_ID and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::PREVIOUS_ID, StudioIssueBrowserPolicy::ROWS, no_node_id) == StudioIssueBrowserPolicy::NEXT_ID and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::NEXT_ID, StudioIssueBrowserPolicy::ROWS, no_node_id) == StudioIssueBrowserPolicy::WORST_ID and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::WORST_ID, StudioIssueBrowserPolicy::ROWS, no_node_id) == StudioIssueBrowserPolicy::row_id(0) and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(0), StudioIssueBrowserPolicy::ROWS, no_node_id) == StudioIssueBrowserPolicy::row_id(1) and StudioIssueBrowserPolicy::node_next_sibling(StudioIssueBrowserPolicy::row_id(1), StudioIssueBrowserPolicy::ROWS, no_node_id) == no_node_id

        def stale_rows_cannot_navigate(index: i64, visible_rows: i64) -> bool:
            requires visible_rows >= 0 and visible_rows <= StudioIssueBrowserPolicy::ROWS
            ensure not result
            StudioIssueBrowserPolicy::row_route_enabled(index, visible_rows, false)

        def navigation_stays_within_ranked_findings(current: i64, count: i64, action: i64) -> bool:
            requires count > 0 and count <= 100000
            requires current >= 0 and current < count
            requires action >= StudioIssueBrowserPolicy::PREVIOUS and action <= StudioIssueBrowserPolicy::WORST
            ensure result >= 0 and result < count
            StudioIssueBrowserPolicy::navigation_target(current, count, action)

        def previous_then_next_returns_to_same_row(current: i64, count: i64) -> bool:
            requires count > 0 and count <= 100000
            requires current >= 0 and current < count
            ensure result
            previous: i64 = StudioIssueBrowserPolicy::navigation_target(current, count, StudioIssueBrowserPolicy::PREVIOUS)
            StudioIssueBrowserPolicy::navigation_target(previous, count, StudioIssueBrowserPolicy::NEXT) == current

        def selected_finding_is_always_in_visible_window(selected: i64, count: i64) -> bool:
            requires count >= 0 and count <= 100000
            requires selected >= 0
            ensure selected >= count or (selected >= result and selected < result + StudioIssueBrowserPolicy::ROWS)
            StudioIssueBrowserPolicy::window_start(selected, count)

        def visible_window_stays_inside_list(selected: i64, count: i64) -> bool:
            requires selected >= 0 and count >= 0 and count <= 100000
            ensure result + StudioIssueBrowserPolicy::ROWS <= count or count <= StudioIssueBrowserPolicy::ROWS
            StudioIssueBrowserPolicy::window_start(selected, count)

        def a_windowed_row_route_targets_a_visible_rank(start: i64, slot: i64, count: i64) -> bool:
            requires count > StudioIssueBrowserPolicy::ROWS and count <= 100000
            requires start >= 0 and start + StudioIssueBrowserPolicy::ROWS <= count
            requires slot >= 0 and slot < StudioIssueBrowserPolicy::ROWS
            ensure result >= start and result < start + StudioIssueBrowserPolicy::ROWS
            start + slot
