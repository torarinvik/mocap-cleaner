include "../src/studio/export_report_warning_parser.elisa"

module StudioExportReportWarningParserLaws:
    public:
        def empty_matching_reports_have_zero_warnings(json: darray[u8], text: darray[u8]) -> bool:
            requires matching_zero_counts(json, text)
            ensure result
            mutable count: i64 = 0
            StudioExportReportWarningParser::warning_count(json, text, &count) and count == 0

        def matching_reports_return_the_shared_warning_count(json: darray[u8], text: darray[u8]) -> bool:
            requires matching_counts(json, text)
            ensure result
            mutable json_count: i64 = 0
            mutable text_count: i64 = 0
            mutable count: i64 = 0
            StudioExportReportWarningParser::json_warning_count(json, &json_count) and StudioExportReportWarningParser::text_warning_count(text, &text_count) and StudioExportReportWarningParser::warning_count(json, text, &count) and count == json_count and count == text_count

        def mismatched_report_counts_are_unverified(json: darray[u8], text: darray[u8]) -> bool:
            requires counts_differ(json, text)
            ensure result
            mutable count: i64 = 0
            not StudioExportReportWarningParser::warning_count(json, text, &count)

    private:
        def matching_counts(json: darray[u8]&, text: darray[u8]&) -> bool:
            mutable json_count: i64 = 0
            mutable text_count: i64 = 0
            StudioExportReportWarningParser::json_warning_count(json, &json_count) and StudioExportReportWarningParser::text_warning_count(text, &text_count) and json_count == text_count

        def matching_zero_counts(json: darray[u8]&, text: darray[u8]&) -> bool:
            mutable json_count: i64 = 0
            mutable text_count: i64 = 0
            StudioExportReportWarningParser::json_warning_count(json, &json_count) and StudioExportReportWarningParser::text_warning_count(text, &text_count) and json_count == 0 and text_count == 0

        def counts_differ(json: darray[u8]&, text: darray[u8]&) -> bool:
            mutable json_count: i64 = 0
            mutable text_count: i64 = 0
            StudioExportReportWarningParser::json_warning_count(json, &json_count) and StudioExportReportWarningParser::text_warning_count(text, &text_count) and json_count != text_count
