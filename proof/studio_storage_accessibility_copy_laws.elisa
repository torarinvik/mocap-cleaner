include "../src/studio/app/storage_accessibility_copy.elisa"

module StudioStorageAccessibilityCopyLaws:
    public:
        def verified_location_codes_are_preserved() -> bool:
            ensure result
            StudioStorageAccessibilityCopy::Status.Present.i64() == 0 and StudioStorageAccessibilityCopy::Status.InTrash.i64() == 1

        def protected_status_codes_are_preserved() -> bool:
            ensure result
            StudioStorageAccessibilityCopy::Status.Changed.i64() == 2 and StudioStorageAccessibilityCopy::Status.Unverified.i64() == 3

        def artifact_kind_codes_are_preserved() -> bool:
            ensure result
            StudioStorageAccessibilityCopy::Kind.Recovery.i64() == 0 and StudioStorageAccessibilityCopy::Kind.TemporaryExport.i64() == 1 and StudioStorageAccessibilityCopy::Kind.Report.i64() == 2
