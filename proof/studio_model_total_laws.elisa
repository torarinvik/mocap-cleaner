include "../src/studio/app/model.elisa"

module StudioModelTotalLaws:
    public:
        def empty_total_is_zero() -> bool:
            ensure result
            mutable values: darray[i64] = []
            StudioModel::total(&values) == 0

        def single_value_is_preserved(value: i64) -> bool:
            ensure result
            mutable values: darray[i64] = [value]
            StudioModel::total(&values) == value
