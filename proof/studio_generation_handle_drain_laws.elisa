include "../src/studio/state/generation_handle_drain_policy.elisa"

module StudioGenerationHandleDrainLaws:
    public:
        def retained_idle_handle_can_retry(handle: i64) -> bool:
            requires handle > 0
            ensure result
            StudioGenerationHandleDrainPolicy::may_retry(handle, false)

        def no_token_cannot_retry(handle: i64) -> bool:
            requires handle <= 0
            ensure not result
            StudioGenerationHandleDrainPolicy::may_retry(handle, false)

        def active_worker_prevents_duplicate_retry(handle: i64) -> bool:
            ensure not result
            StudioGenerationHandleDrainPolicy::may_retry(handle, true)

        def retained_token_prevents_reconciliation(handle: i64, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            requires handle != 0
            ensure not result
            StudioGenerationHandleDrainPolicy::may_reconcile(handle, release)

        def uncertain_release_prevents_reconciliation(release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            requires not StudioGenerationHandlePolicy::release_certain(release)
            ensure not result
            StudioGenerationHandleDrainPolicy::may_reconcile(0, release)
