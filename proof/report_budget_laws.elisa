include "../src/core/report_budget.elisa"

module ReportBudgetLaws:
    public:
        def empty_is_unavailable() -> bool:
            ensure not result
            ReportBudget::admitted(0)

        def full_report_is_admitted() -> bool:
            ensure result
            ReportBudget::admitted(ReportBudget::Capacity::BYTES)

        def full_report_cannot_grow() -> bool:
            ensure not result
            ReportBudget::can_append(ReportBudget::Capacity::BYTES)

        def oversized_is_unavailable(count: i64) -> bool:
            requires count > ReportBudget::Capacity::BYTES
            ensure not result
            ReportBudget::admitted(count)

        def append_preserves_admission(count: i64) -> bool:
            requires count >= 0
            requires count < ReportBudget::Capacity::BYTES
            ensure result
            ReportBudget::admitted(count + 1)
