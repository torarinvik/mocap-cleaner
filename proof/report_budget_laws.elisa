include "../src/core/report_budget.elisa"

module ReportBudgetLaws:
    public:
        def empty_is_unavailable() -> bool:
            ensure not result
            ReportBudget::admitted(0)

        def full_report_is_admitted() -> bool:
            ensure result
            ReportBudget::admitted(ReportBudget::Capacity::BYTES)

        def full_report_cannot_grow() -> bool:
            ensure not result
            ReportBudget::can_append(ReportBudget::Capacity::BYTES)

        def oversized_is_unavailable(count: i64) -> bool:
            requires count > ReportBudget::Capacity::BYTES
            ensure not result
            ReportBudget::admitted(count)

        def append_preserves_admission(count: i64) -> bool:
            requires count >= 0
            requires count < ReportBudget::Capacity::BYTES
            ensure result
            ReportBudget::admitted(count + 1)

        def one_identity_is_available() -> bool:
            ensure result
            ReportBudget::unique_identity(1)

        def absent_identity_is_unavailable() -> bool:
            ensure not result
            ReportBudget::unique_identity(0)

        def duplicate_identity_is_unavailable(count: i64) -> bool:
            requires count > 1
            ensure not result
            ReportBudget::unique_identity(count)

        def maximum_unit_declarations_are_admitted() -> bool:
            ensure result
            ReportBudget::unit_declarations_admitted(ReportBudget::Capacity::UNIT_DECLARATIONS)

        def excessive_unit_declarations_are_rejected() -> bool:
            ensure not result
            ReportBudget::unit_declarations_admitted(ReportBudget::Capacity::UNIT_DECLARATIONS + 1)
