include "../src/studio/build_generation_trash_binding_policy.elisa"

module StudioBuildGenerationTrashBindingPolicyLaws:
    public:
        def unknown_status_never_acquires(raw: i32) -> bool:
            requires raw < 0 or raw > 13
            ensure result
            not StudioBuildGenerationTrashBindingPolicy::decode_status(raw).known

        def unknown_phase_never_becomes_known(raw: i32) -> bool:
            requires raw < 0 or raw > 5
            ensure result
            not StudioBuildGenerationTrashBindingPolicy::decode_phase(raw).known

        def unknown_location_never_becomes_known(raw: i32) -> bool:
            requires raw < 0 or raw > 4
            ensure result
            not StudioBuildGenerationTrashBindingPolicy::decode_location(raw).known

        def malformed_boolean_is_invalid(raw: i32) -> bool:
            requires raw != 0 and raw != 1
            ensure result
            not StudioBuildGenerationTrashBindingPolicy::decode_boolean(raw).valid

        def only_exact_native_true_is_true(raw: i32) -> bool:
            requires raw != 1
            ensure result
            not StudioBuildGenerationTrashBindingPolicy::decode_boolean(raw).value

        def acquired_handle_requires_verified_facts(
            handle: i64, root_verified: i32, source_verified: i32,
            manifest_verified: i32, product_verified: i32,
            lease_verified: i32, lease_exclusive: i32,
            descendants_verified: i32, is_current: i32,
            lease_protocol: i64, lease_receipt_bytes: i64,
            inventory_receipt_bytes: i64) -> bool:
            ensure result == (handle > 0 and root_verified == 1 and
                source_verified == 1 and manifest_verified == 1 and
                product_verified == 1 and lease_verified == 1 and
                lease_exclusive == 1 and descendants_verified == 1 and
                is_current == 0 and
                lease_protocol == StudioBuildGenerationTrashPolicy::Protocol::LEASE_VERSION and
                lease_receipt_bytes > 0 and
                lease_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and
                inventory_receipt_bytes > 0 and
                inventory_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES)
            StudioBuildGenerationTrashBindingPolicy::begin_evidence_admitted(
                StudioBuildGenerationTrashBindingPolicy::decode_begin_evidence(
                    0, handle, root_verified, source_verified, manifest_verified,
                    product_verified, lease_verified, lease_exclusive,
                    descendants_verified, is_current, lease_protocol,
                    lease_receipt_bytes, inventory_receipt_bytes))

        def current_artifact_is_never_mutable(
            handle: i64, root_verified: i32, source_verified: i32,
            manifest_verified: i32, product_verified: i32,
            lease_verified: i32, lease_exclusive: i32,
            descendants_verified: i32, lease_protocol: i64,
            lease_receipt_bytes: i64, inventory_receipt_bytes: i64) -> bool:
            ensure not result
            StudioBuildGenerationTrashBindingPolicy::begin_evidence_admitted(
                StudioBuildGenerationTrashBindingPolicy::decode_begin_evidence(
                    0, handle, root_verified, source_verified, manifest_verified,
                    product_verified, lease_verified, lease_exclusive,
                    descendants_verified, 1, lease_protocol,
                    lease_receipt_bytes, inventory_receipt_bytes))
