include "../src/studio/timeline_navigation_policy.elisa"

module StudioTimelineNavigationLaws:
    public:
        def clip_endpoints(count: i64) -> bool:
            requires count >= 1 and count <= StudioTimelineNavigationPolicy::Domain::MAX_FRAMES
            ensure result
            StudioTimelineNavigationPolicy::endpoint(false, count) == 0 and StudioTimelineNavigationPolicy::endpoint(true, count) == count - 1

        def one_frame_selection() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::selection_valid(0, 0, 1)

        def reversed_selection_refused() -> bool:
            ensure result
            not StudioTimelineNavigationPolicy::selection_valid(2, 1, 4)

        def invalid_boundary_preserves_best() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 10, 7, 10, StudioTimelineNavigationPolicy::Direction.Next) == 7

        def current_frame_is_not_next() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 5, -1, 10, StudioTimelineNavigationPolicy::Direction.Next) == -1

        def current_frame_is_not_previous() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 5, -1, 10, StudioTimelineNavigationPolicy::Direction.Previous) == -1

        def nearest_next_wins() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 6, 8, 10, StudioTimelineNavigationPolicy::Direction.Next) == 6

        def nearest_previous_wins() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 4, 2, 10, StudioTimelineNavigationPolicy::Direction.Previous) == 4

        def farther_next_preserves_best() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 9, 6, 10, StudioTimelineNavigationPolicy::Direction.Next) == 6

        def farther_previous_preserves_best() -> bool:
            ensure result
            StudioTimelineNavigationPolicy::choose_boundary(5, 0, 4, 10, StudioTimelineNavigationPolicy::Direction.Previous) == 4
