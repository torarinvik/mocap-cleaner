# UTC conversion is bounded. Runtime calendar boundary cases are covered by
# test/studio_storage_scan_time_policy.elisa.
include "../src/studio/storage_scan_time_policy.elisa"

module StudioStorageScanTimePolicyLaws:
    public:
        def utc_hour_is_bounded(timestamp: i64) -> bool:
            requires timestamp >= 0
            requires timestamp <= StudioStorageScanTimePolicy::Time::MAX_UNIX_SECONDS
            ensure result
            hour: i64 = StudioStorageScanTimePolicy::hour_of_day(timestamp)
            hour >= 0 and hour <= 23

        def utc_minute_is_bounded(timestamp: i64) -> bool:
            requires timestamp >= 0
            requires timestamp <= StudioStorageScanTimePolicy::Time::MAX_UNIX_SECONDS
            ensure result
            minute: i64 = StudioStorageScanTimePolicy::minute_of_hour(timestamp)
            minute >= 0 and minute <= 59

        def utc_second_is_bounded(timestamp: i64) -> bool:
            requires timestamp >= 0
            requires timestamp <= StudioStorageScanTimePolicy::Time::MAX_UNIX_SECONDS
            ensure result
            second: i64 = StudioStorageScanTimePolicy::second_of_minute(timestamp)
            second >= 0 and second <= 59

        def timestamp_outside_supported_range_is_unknown(timestamp: i64) -> bool:
            requires timestamp < 0 or timestamp > StudioStorageScanTimePolicy::Time::MAX_UNIX_SECONDS
            ensure result
            not StudioStorageScanTimePolicy::supported(timestamp)
