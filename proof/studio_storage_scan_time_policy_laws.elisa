# UTC conversion is bounded and its epoch/day edge cases have stable calendar
# meaning. Detailed copy formatting pads the scalar fields at the UI boundary.
include "../src/studio/storage_scan_time_policy.elisa"

module StudioStorageScanTimePolicyLaws:
    public:
        def utc_clock_fields_are_bounded(timestamp: i64) -> bool:
            requires timestamp >= 0
            requires timestamp <= StudioStorageScanTimePolicy::MAX_UNIX_SECONDS
            ensure result
            parts: StudioStorageScanTimePolicy::UtcParts = StudioStorageScanTimePolicy::utc_parts(timestamp)
            parts.hour >= 0 and parts.hour <= 23 and parts.minute >= 0 and parts.minute <= 59 and parts.second >= 0 and parts.second <= 59

        def timestamp_outside_supported_range_is_unknown(timestamp: i64) -> bool:
            requires timestamp < 0 or timestamp > StudioStorageScanTimePolicy::MAX_UNIX_SECONDS
            ensure result
            not StudioStorageScanTimePolicy::supported(timestamp)
