include "../src/studio/io/storage_preferences_file.elisa"

module StudioStoragePreferencesLoadDomainLaws:
    public:
        def success_code_retained() -> bool:
            ensure result
            StudioStoragePreferencesFile::LoadStatus.Ok.i64() == 0

        def failure_codes_retained() -> bool:
            ensure result
            StudioStoragePreferencesFile::LoadStatus.OpenFailed.i64() == 1 and StudioStoragePreferencesFile::LoadStatus.ReadFailed.i64() == 2 and StudioStoragePreferencesFile::LoadStatus.TooLarge.i64() == 3 and StudioStoragePreferencesFile::LoadStatus.CloseFailed.i64() == 4 and StudioStoragePreferencesFile::LoadStatus.InvalidFormat.i64() == 5
