include "../src/studio/suggestion_metric_policy.elisa"

module StudioSuggestionMetricLaws:
    public:
        def joint_angle_tolerance_is_fifteen_degrees() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::Tolerance::ANGLE_MILLI_DEGREES == 15000

        def boundary_tolerance_is_ten_millimeters() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::Tolerance::BOUNDARY_MICROMETERS == 10000

        def velocity_tolerance_is_fifty_millimeters_per_second() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::Tolerance::VELOCITY_MICROMETERS_PER_SECOND == 50000

        def negative_measurement_refuses(value: f64) -> bool:
            requires value < 0.0
            ensure not result
            StudioSuggestionMetricPolicy::scaled_admitted(value)

        def oversized_measurement_refuses(value: f64) -> bool:
            requires value > StudioSuggestionMetricPolicy::Conversion::MAX_SCALED
            ensure not result
            StudioSuggestionMetricPolicy::scaled_admitted(value)

        def admitted_measurement_is_finite(value: f64) -> bool:
            requires StudioSuggestionMetricPolicy::scaled_admitted(value)
            ensure result
            value - value == 0.0

        def zero_measurement_admitted() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::scaled_admitted(0.0)

        def nonfinite_measurement_refuses(value: f64) -> bool:
            requires value - value != 0.0
            ensure not result
            StudioSuggestionMetricPolicy::scaled_admitted(value)

        def rounded_measurement_stays_in_domain(value: f64) -> i64:
            requires StudioSuggestionMetricPolicy::scaled_admitted(value)
            ensure result >= 0 and result <= StudioSuggestionMetricPolicy::Conversion::MAX_INTEGER
            StudioSuggestionMetricPolicy::rounded_scaled(value)

        def zero_rounds_to_zero() -> i64:
            ensure result == 0
            StudioSuggestionMetricPolicy::rounded_scaled(0.0)

        def exact_tolerance_is_not_failure(tolerance: i64) -> bool:
            requires tolerance >= 0
            ensure not result
            StudioSuggestionMetricPolicy::exceeds(tolerance, tolerance)

        def above_tolerance_is_failure(difference: i64, tolerance: i64) -> bool:
            requires tolerance >= 0 and difference > tolerance
            ensure result
            StudioSuggestionMetricPolicy::exceeds(difference, tolerance)

        def below_tolerance_is_not_failure(difference: i64, tolerance: i64) -> bool:
            requires difference >= 0 and tolerance >= difference
            ensure not result
            StudioSuggestionMetricPolicy::exceeds(difference, tolerance)
