include "../src/studio/suggestion_metric_policy.elisa"

module StudioSuggestionMetricLaws:
    public:
        def joint_angle_tolerance_is_fifteen_degrees() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::ANGLE_TOLERANCE_MILLI_DEGREES == 15000

        def boundary_tolerance_is_ten_millimeters() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::BOUNDARY_TOLERANCE_MICROMETERS == 10000

        def velocity_tolerance_is_fifty_millimeters_per_second() -> bool:
            ensure result
            StudioSuggestionMetricPolicy::VELOCITY_TOLERANCE_MICROMETERS_PER_SECOND == 50000
