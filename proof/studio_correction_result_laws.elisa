include "../src/studio/correction_result_policy.elisa"

module StudioCorrectionResultLaws:
    public:
        def queued_edit_cannot_report_completion(failed: bool) -> bool:
            ensure result
            not StudioCorrectionResultPolicy::completion_feedback_admitted(true, failed)

        def failed_edit_cannot_report_completion(pending: bool) -> bool:
            ensure result
            not StudioCorrectionResultPolicy::completion_feedback_admitted(pending, true)

        def ready_edit_can_report_completion() -> bool:
            ensure result
            StudioCorrectionResultPolicy::completion_feedback_admitted(false, false)

        def unchanged_generation_is_not_completion(generation: i64, failed: bool) -> bool:
            ensure result
            not StudioCorrectionResultPolicy::completed(generation, generation, failed)

        def failed_build_is_not_completion(previous: i64, current: i64) -> bool:
            ensure result
            not StudioCorrectionResultPolicy::completed(previous, current, true)

        def new_successful_generation_completes(previous: i64, current: i64) -> bool:
            requires current != previous
            ensure result
            StudioCorrectionResultPolicy::completed(previous, current, false)

        def pending_rebuild_is_deferred(failed: bool) -> bool:
            ensure result
            StudioCorrectionResultPolicy::outcome(true, failed) == StudioCorrectionResultPolicy::Outcome.Deferred

        def failed_rebuild_is_refused() -> bool:
            ensure result
            StudioCorrectionResultPolicy::outcome(false, true) == StudioCorrectionResultPolicy::Outcome.Refused

        def successful_rebuild_is_ready() -> bool:
            ensure result
            StudioCorrectionResultPolicy::outcome(false, false) == StudioCorrectionResultPolicy::Outcome.Ready
