# Laws for Save/Discard/Cancel focus and resolution.
include "../src/studio/replacement.elisa"

module StudioReplacementLaws:
    public:
        def clean_take_needs_no_prompt() -> bool:
            ensure not result
            StudioReplacement::needs_prompt(true, false)

        def dirty_take_needs_prompt() -> bool:
            ensure result
            StudioReplacement::needs_prompt(true, true)

        def missing_take_needs_no_prompt(dirty: bool) -> bool:
            ensure not result
            StudioReplacement::needs_prompt(false, dirty)

        def starts_on_save() -> i64:
            ensure result == StudioReplacement::Focus.Save.i64()
            StudioReplacement::initial_focus()

        def focus_wraps_forward() -> i64:
            requires StudioReplacement::Focus.Cancel.i64() == 2
            ensure result == StudioReplacement::Focus.Save.i64()
            StudioReplacement::move_focus(StudioReplacement::Focus.Cancel.i64(), 1)

        def focus_wraps_backward() -> i64:
            requires StudioReplacement::Focus.Save.i64() == 0
            ensure result == StudioReplacement::Focus.Cancel.i64()
            StudioReplacement::move_focus(StudioReplacement::Focus.Save.i64(), -1)

        def closed_prompt_cannot_resolve(choice: i64) -> i64:
            requires choice >= StudioReplacement::Choice.Save.i64()
            requires choice <= StudioReplacement::Choice.Cancel.i64()
            ensure result == StudioReplacement::Choice.None.i64()
            StudioReplacement::resolve(false, choice)

        def open_prompt_resolves_choice(choice: i64) -> i64:
            requires choice >= StudioReplacement::Choice.Save.i64()
            requires choice <= StudioReplacement::Choice.Cancel.i64()
            ensure result == choice
            StudioReplacement::resolve(true, choice)
