include "../src/studio/export_recovery_binding_policy.elisa"

module StudioExportRecoveryBindingLaws:
    public:
        def exact_owned_transaction_is_admitted() -> bool:
            ensure result
            StudioExportRecoveryBindingPolicy::admitted(true, true, true, true, true, true, true, true)

        def incomplete_binding_is_rejected(owned: bool, locked: bool, directory: bool,
                                          journal: bool, snapshot: bool, output: bool,
                                          json: bool, text: bool) -> bool:
            require not (owned and locked and directory and journal and snapshot and output and json and text)
            ensure not result
            StudioExportRecoveryBindingPolicy::admitted(owned, locked, directory, journal, snapshot, output, json, text)

        def admitted_binding_has_every_fact(owned: bool, locked: bool, directory: bool,
                                           journal: bool, snapshot: bool, output: bool,
                                           json: bool, text: bool) -> bool:
            require StudioExportRecoveryBindingPolicy::admitted(owned, locked, directory, journal, snapshot, output, json, text)
            ensure result
            owned and locked and directory and journal and snapshot and output and json and text
