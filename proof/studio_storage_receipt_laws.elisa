# Scalar receipt envelopes are bounded before they can be persisted or used
# to authorize restoration of a Trash item.
include "../src/studio/storage_receipt_policy.elisa"

module StudioStorageReceiptLaws:
    public:
        def valid_metadata_is_accepted(device: i64, inode: i64, size_bytes: i64,
                                       modified_seconds: i64, modified_nanoseconds: i64) -> bool:
            requires device >= 0 and device <= StudioStorageReceiptPolicy::MAX_IDENTITY_VALUE
            requires inode >= 0 and inode <= StudioStorageReceiptPolicy::MAX_IDENTITY_VALUE
            requires size_bytes >= 0 and size_bytes <= StudioStorageReceiptPolicy::MAX_ITEM_BYTES
            requires modified_seconds >= 0 - StudioStorageReceiptPolicy::MAX_IDENTITY_VALUE and modified_seconds <= StudioStorageReceiptPolicy::MAX_IDENTITY_VALUE
            requires modified_nanoseconds >= 0 and modified_nanoseconds <= StudioStorageReceiptPolicy::MAX_MODIFIED_NANOSECONDS
            ensure result
            StudioStorageReceiptPolicy::scalar_valid(StudioStorageReceiptPolicy::GENERATED_REPORT,
                device, inode, size_bytes, modified_seconds, modified_nanoseconds)

        def invalid_kind_is_rejected(kind: i64) -> bool:
            requires kind < StudioStorageReceiptPolicy::RECOVERY or kind >= StudioStorageReceiptPolicy::KIND_COUNT
            ensure not result
            StudioStorageReceiptPolicy::scalar_valid(kind, 0, 0, 0, 0, 0)

        def invalid_size_is_rejected(size_bytes: i64) -> bool:
            requires size_bytes < 0 or size_bytes > StudioStorageReceiptPolicy::MAX_ITEM_BYTES
            ensure not result
            StudioStorageReceiptPolicy::scalar_valid(StudioStorageReceiptPolicy::RECOVERY,
                0, 0, size_bytes, 0, 0)

        def invalid_timestamp_fraction_is_rejected(modified_nanoseconds: i64) -> bool:
            requires modified_nanoseconds < 0 or modified_nanoseconds > StudioStorageReceiptPolicy::MAX_MODIFIED_NANOSECONDS
            ensure not result
            StudioStorageReceiptPolicy::scalar_valid(StudioStorageReceiptPolicy::RECOVERY,
                0, 0, 0, 0, modified_nanoseconds)

        def timestamp_before_epoch_is_allowed(modified_seconds: i64) -> bool:
            requires modified_seconds >= 0 - StudioStorageReceiptPolicy::MAX_IDENTITY_VALUE
            requires modified_seconds < 0
            ensure result
            StudioStorageReceiptPolicy::scalar_valid(StudioStorageReceiptPolicy::RECOVERY,
                0, 0, 0, modified_seconds, 0)
