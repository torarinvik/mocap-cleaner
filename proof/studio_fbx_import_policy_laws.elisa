include "../src/studio/fbx_import_policy.elisa"

module StudioFbxImportPolicyLaws:
    public:
        def cancelled_preserves_take(ticket: i64, current: i64, status: i64, memo: bool) -> bool:
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, current, true, status, memo)

        def stale_preserves_take(ticket: i64, current: i64, status: i64, memo: bool) -> bool:
            requires ticket != current
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, current, false, status, memo)

        def failed_preserves_take(ticket: i64, status: i64) -> bool:
            requires status != 0
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, ticket, false, status, true)

        def unreadable_preserves_take(ticket: i64) -> bool:
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, ticket, false, 0, false)

        def current_success(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            StudioFbxImportPolicy::may_publish(ticket, ticket, false, 0, true)

        def exact_current_result_can_commit(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, true, true, true)

        def replaced_source_preserves_take(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            not StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, false, true, true)

        def invalid_runtime_path_preserves_take(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            not StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, true, false, true)

        def missing_digest_preserves_take(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            not StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, true, true, false)

        def invalid_rate(rate: i64) -> bool:
            requires rate <= 0 or rate > StudioFbxImportPolicy::Limit::MAX_RATE
            ensure result
            not StudioFbxImportPolicy::rate_valid(rate)

        def empty_path() -> bool:
            ensure result
            mutable bytes: darray[u8] = []
            not StudioFbxImportPolicy::terminated(&bytes, StudioFbxImportPolicy::Limit::PATH_BYTES)

        def lowercase_fbx_extension() -> bool:
            ensure result
            StudioFbxImportPolicy::extension_is_fbx(46, 102, 98, 120)

        def mixed_case_fbx_extension() -> bool:
            ensure result
            StudioFbxImportPolicy::extension_is_fbx(46, 70, 98, 88)

        def non_fbx_extension_is_rejected() -> bool:
            ensure not result
            StudioFbxImportPolicy::extension_is_fbx(46, 103, 108, 98)

        def missing_dot_is_rejected() -> bool:
            ensure not result
            StudioFbxImportPolicy::extension_is_fbx(0, 102, 98, 120)

        def converter_rate_ceiling_is_admitted():
            assert StudioFbxImportPolicy::rate_valid(120)

        def rate_above_converter_ceiling_is_refused():
            assert not StudioFbxImportPolicy::rate_valid(121)
