include "../src/studio/fbx_import_policy.elisa"

module StudioFbxImportPolicyLaws:
    public:
        def admitted_request_has_inline_capacity(source: darray[u8]&, root: darray[u8]&, animation: darray[u8]&) -> bool:
            requires StudioFbxImportPolicy::request_buffers_fit(source, root, animation)
            ensure result
            (source.count > 1 and source.count.i64() <= StudioFbxImportPolicy::Limit::PATH_BYTES and
                root.count > 1 and root.count.i64() <= StudioFbxImportPolicy::Limit::PATH_BYTES and
                animation.count > 1 and animation.count.i64() <= StudioFbxImportPolicy::Limit::ANIMATION_BYTES)

        def oversized_source_cannot_be_captured(source: darray[u8]&, root: darray[u8]&, animation: darray[u8]&) -> bool:
            requires source.count.i64() > StudioFbxImportPolicy::Limit::PATH_BYTES
            ensure result
            not StudioFbxImportPolicy::request_buffers_fit(source, root, animation)

        def oversized_root_cannot_be_captured(source: darray[u8]&, root: darray[u8]&, animation: darray[u8]&) -> bool:
            requires root.count.i64() > StudioFbxImportPolicy::Limit::PATH_BYTES
            ensure result
            not StudioFbxImportPolicy::request_buffers_fit(source, root, animation)

        def oversized_animation_cannot_be_captured(source: darray[u8]&, root: darray[u8]&, animation: darray[u8]&) -> bool:
            requires animation.count.i64() > StudioFbxImportPolicy::Limit::ANIMATION_BYTES
            ensure result
            not StudioFbxImportPolicy::request_buffers_fit(source, root, animation)

        def admission_agrees_with_commit(ticket: i64, current: i64, cancelled: bool, status: i64, memo: bool, source: bool, destination: bool, digests: bool) -> bool:
            ensure result
            (StudioFbxImportPolicy::admission(ticket, current, cancelled, status, memo, source, destination, digests) == StudioFbxImportPolicy::Admission.Accepted) == StudioFbxImportPolicy::may_commit(ticket, current, cancelled, status, memo, source, destination, digests)

        def successful_worker_source_refusal_is_named(ticket: i64):
            requires ticket > 0
            assert StudioFbxImportPolicy::admission(ticket, ticket, false, 0, true, false, true, true) == StudioFbxImportPolicy::Admission.SourceMismatch

        def successful_worker_digest_refusal_is_named(ticket: i64):
            requires ticket > 0
            assert StudioFbxImportPolicy::admission(ticket, ticket, false, 0, true, true, true, false) == StudioFbxImportPolicy::Admission.InvalidDigests

        def current_worker_success_is_accepted(ticket: i64):
            requires ticket > 0
            assert StudioFbxImportPolicy::admission(ticket, ticket, false, 0, true, true, true, true) == StudioFbxImportPolicy::Admission.Accepted

        def cancelled_preserves_take(ticket: i64, current: i64, status: i64, memo: bool) -> bool:
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, current, true, status, memo)

        def stale_preserves_take(ticket: i64, current: i64, status: i64, memo: bool) -> bool:
            requires ticket != current
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, current, false, status, memo)

        def failed_preserves_take(ticket: i64, status: i64) -> bool:
            requires status != 0
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, ticket, false, status, true)

        def unreadable_preserves_take(ticket: i64) -> bool:
            ensure result
            not StudioFbxImportPolicy::may_publish(ticket, ticket, false, 0, false)

        def current_success(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            StudioFbxImportPolicy::may_publish(ticket, ticket, false, 0, true)

        def exact_current_result_can_commit(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, true, true, true)

        def replaced_source_preserves_take(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            not StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, false, true, true)

        def invalid_runtime_path_preserves_take(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            not StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, true, false, true)

        def missing_digest_preserves_take(ticket: i64) -> bool:
            requires ticket > 0
            ensure result
            not StudioFbxImportPolicy::may_commit(ticket, ticket, false, 0, true, true, true, false)

        def invalid_rate(rate: i64) -> bool:
            requires rate <= 0 or rate > StudioFbxImportPolicy::Limit::MAX_RATE
            ensure result
            not StudioFbxImportPolicy::rate_valid(rate)

        def empty_path() -> bool:
            ensure result
            mutable bytes: darray[u8] = []
            not StudioFbxImportPolicy::terminated(&bytes, StudioFbxImportPolicy::Limit::PATH_BYTES)

        def lowercase_fbx_extension() -> bool:
            ensure result
            StudioFbxImportPolicy::extension_is_fbx(46, 102, 98, 120)

        def mixed_case_fbx_extension() -> bool:
            ensure result
            StudioFbxImportPolicy::extension_is_fbx(46, 70, 98, 88)

        def non_fbx_extension_is_rejected() -> bool:
            ensure not result
            StudioFbxImportPolicy::extension_is_fbx(46, 103, 108, 98)

        def missing_dot_is_rejected() -> bool:
            ensure not result
            StudioFbxImportPolicy::extension_is_fbx(0, 102, 98, 120)

        def converter_rate_ceiling_is_admitted():
            assert StudioFbxImportPolicy::rate_valid(120)

        def rate_above_converter_ceiling_is_refused():
            assert not StudioFbxImportPolicy::rate_valid(121)
