include "../src/physics/track_shape_policy.elisa"

module PhysicsTrackShapeLaws:
    public:
        def exact_contacts_admitted(frames: i64) -> bool:
            requires frames >= 0
            ensure result
            PhysicsTrackShapePolicy::contacts_admitted(frames, frames, frames)

        def mismatched_contact_refused(frames: i64, left: i64, right: i64) -> bool:
            requires left != frames or right != frames
            ensure result
            not PhysicsTrackShapePolicy::contacts_admitted(frames, left, right)

        def negative_frames_refused(frames: i64, left: i64, right: i64) -> bool:
            requires frames < 0
            ensure result
            not PhysicsTrackShapePolicy::contacts_admitted(frames, left, right)

        def mismatched_com_refused(frames: i64, left: i64, right: i64, coms: i64) -> bool:
            requires coms != frames
            ensure result
            not PhysicsTrackShapePolicy::balance_admitted(frames, left, right, coms)

        def admitted_balance_has_exact_contacts(frames: i64, left: i64, right: i64, coms: i64) -> bool:
            requires PhysicsTrackShapePolicy::balance_admitted(frames, left, right, coms)
            ensure result
            left == frames and right == frames and coms == frames and frames >= 0
