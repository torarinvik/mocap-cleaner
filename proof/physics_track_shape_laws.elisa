include "../src/physics/track_shape_policy.elisa"

module PhysicsTrackShapeLaws:
    public:
        def missing_foot_refused(left: i64, right: i64, length: f64) -> bool:
            requires left < 0 or right < 0
            ensure result
            not PhysicsTrackShapePolicy::contact_source_admitted(left, right, length)

        def invalid_leg_length_refused(left: i64, right: i64, length: f64) -> bool:
            requires length <= PhysicsTrackShapePolicy::Length::MIN_LEG_METRES or length > PhysicsLengthBoundary::Domain::MAX_METRES or length - length != 0.0
            ensure result
            not PhysicsTrackShapePolicy::contact_source_admitted(left, right, length)

        def exact_contacts_admitted(frames: i64) -> bool:
            requires frames >= 0
            ensure result
            PhysicsTrackShapePolicy::contacts_admitted(frames, frames, frames)

        def mismatched_contact_refused(frames: i64, left: i64, right: i64) -> bool:
            requires left != frames or right != frames
            ensure result
            not PhysicsTrackShapePolicy::contacts_admitted(frames, left, right)

        def negative_frames_refused(frames: i64, left: i64, right: i64) -> bool:
            requires frames < 0
            ensure result
            not PhysicsTrackShapePolicy::contacts_admitted(frames, left, right)

        def mismatched_com_refused(frames: i64, left: i64, right: i64, coms: i64) -> bool:
            requires coms != frames
            ensure result
            not PhysicsTrackShapePolicy::balance_admitted(frames, left, right, coms)

        def admitted_balance_has_exact_contacts(frames: i64, left: i64, right: i64, coms: i64) -> bool:
            requires PhysicsTrackShapePolicy::balance_admitted(frames, left, right, coms)
            ensure result
            left == frames and right == frames and coms == frames and frames >= 0

        def short_well_formed_balance_is_inapplicable(frames: i64, length: f64) -> bool:
            requires frames >= 0 and frames < 3
            requires length > PhysicsTrackShapePolicy::Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES
            ensure result
            PhysicsTrackShapePolicy::balance_input(frames, frames, frames, frames, length) == PhysicsTrackShapePolicy::BalanceInput.Inapplicable

        def malformed_balance_is_unavailable(frames: i64, left: i64, right: i64, coms: i64, length: f64) -> bool:
            requires left != frames or right != frames or coms != frames
            ensure result
            PhysicsTrackShapePolicy::balance_input(frames, left, right, coms, length) == PhysicsTrackShapePolicy::BalanceInput.Unavailable

        def invalid_balance_length_is_unavailable(frames: i64, length: f64) -> bool:
            requires frames >= 3
            requires length <= PhysicsTrackShapePolicy::Length::MIN_LEG_METRES or length > PhysicsLengthBoundary::Domain::MAX_METRES or length - length != 0.0
            ensure result
            PhysicsTrackShapePolicy::balance_input(frames, frames, frames, frames, length) == PhysicsTrackShapePolicy::BalanceInput.Unavailable

        def usable_balance_input_is_ready(frames: i64, length: f64) -> bool:
            requires frames >= 3
            requires length > PhysicsTrackShapePolicy::Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES
            ensure result
            PhysicsTrackShapePolicy::balance_input(frames, frames, frames, frames, length) == PhysicsTrackShapePolicy::BalanceInput.Ready

        def balance_length_boundary_admitted(length: f64) -> bool:
            requires length > PhysicsTrackShapePolicy::Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES
            ensure result
            PhysicsTrackShapePolicy::balance_length_admitted(length)

        def balance_length_nonfinite_refused(length: f64) -> bool:
            requires length - length != 0.0
            ensure result
            not PhysicsTrackShapePolicy::balance_length_admitted(length)
