include "../src/studio/app/panels_export_batch_destination_inspector.elisa"

def ui_measure_text_width(text: sview, size: f32, weighted: bool) -> f32:
    0.0

def ui_text_line_height(size: f32) -> f32:
    16.0

module StudioExportBatchDestinationInspectorPanelLaws:
    public:
        def controls_fit_inside_panel(w: f32, h: f32) -> bool:
            requires w >= 920.0 and h >= 600.0
            ensure result
            panel: StudioPanels::Box = StudioPanels::export_batch_destination_inspector_box(w, h)
            first: StudioPanels::Box = StudioPanels::export_batch_destination_control_box(w, h,
                StudioExportBatchDestinationInspectorPolicy::Focus.Previous)
            last: StudioPanels::Box = StudioPanels::export_batch_destination_control_box(w, h,
                StudioExportBatchDestinationInspectorPolicy::Focus.CopyPath)
            first.x >= panel.x and first.x + first.w <= last.x and last.x + last.w <= panel.x + panel.w and first.y == last.y

        def path_rows_are_strictly_ordered(w: f32, h: f32) -> bool:
            requires w >= 920.0 and h >= 600.0
            ensure result
            first: StudioPanels::Box = StudioPanels::export_batch_destination_path_line_box(w, h, 0)
            last: StudioPanels::Box = StudioPanels::export_batch_destination_path_line_box(w, h,
                StudioExportBatchDestinationInspectorPolicy::Limit::LINES_PER_PAGE - 1)
            controls: StudioPanels::Box = StudioPanels::export_batch_destination_control_box(w, h, StudioExportBatchDestinationInspectorPolicy::Focus.Previous)
            first.y < last.y and last.y + last.h < controls.y
