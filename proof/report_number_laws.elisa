include "../src/io/report_number.elisa"

module ReportNumberLaws:
    public:
        def empty_span_is_unavailable(text: darray[u8]&, at: usize) -> bool:
            requires at <= text.count
            ensure result
            match ReportNumber::parse(text, at, at):
                ReportNumber::Result.Unavailable: return true
                _: return false

        def canonical_zero() -> bool:
            ensure result
            mutable text: darray[u8] = [48]
            match ReportNumber::parse(&text, 0, 1):
                ReportNumber::Result.Exact(coefficient, exponent):
                    return coefficient == 0 and exponent == 0
                _: return false

        def trailing_zero_equivalence() -> bool:
            ensure result
            mutable text: darray[u8] = [49, 46, 48]
            match ReportNumber::parse(&text, 0, 3):
                ReportNumber::Result.Exact(coefficient, exponent):
                    return coefficient == 1 and exponent == 0
                _: return false
