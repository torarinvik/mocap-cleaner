# Laws for the bounded manifest lock and publication gates.
include "../src/studio/storage_manifest_lock_policy.elisa"

module StudioStorageManifestLockPolicyLaws:
    public:
        def only_acquired_lock_permits_read_modify_write(outcome: i64) -> bool:
            requires outcome >= StudioStorageManifestLockPolicy::OUTCOME_INVALID
            requires outcome < StudioStorageManifestLockPolicy::OUTCOME_COUNT
            ensure result == (outcome == StudioStorageManifestLockPolicy::OUTCOME_ACQUIRED)
            StudioStorageManifestLockPolicy::may_read_modify_write(outcome)

        def busy_lock_blocks_read_modify_write() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_read_modify_write(StudioStorageManifestLockPolicy::OUTCOME_BUSY)

        def failed_lock_blocks_read_modify_write() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_read_modify_write(StudioStorageManifestLockPolicy::OUTCOME_FAILED)

        def invalid_outcome_blocks_read_modify_write() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_read_modify_write(StudioStorageManifestLockPolicy::OUTCOME_INVALID)

        def busy_lock_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::OUTCOME_BUSY, true, true, true)

        def stale_version_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::OUTCOME_ACQUIRED, true, false, true)

        def invalid_refreshed_version_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::OUTCOME_ACQUIRED, false, true, true)

        def changed_reviewed_identity_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::OUTCOME_ACQUIRED, true, true, false)

        def release_failure_stops_next_move() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_start_next_move(StudioStorageManifestLockPolicy::OUTCOME_ACQUIRED, false)

        def non_acquired_outcome_stops_next_move() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_start_next_move(StudioStorageManifestLockPolicy::OUTCOME_BUSY, true)

        def busy_outcome_never_retries_automatically() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_automatically_retry_or_resume(StudioStorageManifestLockPolicy::OUTCOME_BUSY)

        def failed_outcome_never_retries_automatically() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_automatically_retry_or_resume(StudioStorageManifestLockPolicy::OUTCOME_FAILED)

        def acquired_outcome_never_resumes_automatically() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_automatically_retry_or_resume(StudioStorageManifestLockPolicy::OUTCOME_ACQUIRED)
