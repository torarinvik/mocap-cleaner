# Laws for the bounded manifest lock and publication gates.
include "../src/studio/storage_manifest_lock_policy.elisa"

module StudioStorageManifestLockPolicyLaws:
    public:
        def only_acquired_lock_permits_read_modify_write(outcome: i64) -> bool:
            requires outcome >= StudioStorageManifestLockPolicy::Outcome.Invalid.i64()
            requires outcome < StudioStorageManifestLockPolicy::Count::OUTCOMES
            ensure result == (outcome == StudioStorageManifestLockPolicy::Outcome.Acquired.i64())
            StudioStorageManifestLockPolicy::may_read_modify_write(outcome)

        def busy_lock_blocks_read_modify_write() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_read_modify_write(StudioStorageManifestLockPolicy::Outcome.Busy.i64())

        def failed_lock_blocks_read_modify_write() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_read_modify_write(StudioStorageManifestLockPolicy::Outcome.Failed.i64())

        def invalid_outcome_blocks_read_modify_write() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_read_modify_write(StudioStorageManifestLockPolicy::Outcome.Invalid.i64())

        def busy_lock_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::Outcome.Busy.i64(), true, true, true)

        def stale_version_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::Outcome.Acquired.i64(), true, false, true)

        def invalid_refreshed_version_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::Outcome.Acquired.i64(), false, true, true)

        def changed_reviewed_identity_blocks_publication() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_publish(StudioStorageManifestLockPolicy::Outcome.Acquired.i64(), true, true, false)

        def release_failure_stops_next_move() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_start_next_move(StudioStorageManifestLockPolicy::Outcome.Acquired.i64(), false)

        def non_acquired_outcome_stops_next_move() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_start_next_move(StudioStorageManifestLockPolicy::Outcome.Busy.i64(), true)

        def busy_outcome_never_retries_automatically() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_automatically_retry_or_resume(StudioStorageManifestLockPolicy::Outcome.Busy.i64())

        def failed_outcome_never_retries_automatically() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_automatically_retry_or_resume(StudioStorageManifestLockPolicy::Outcome.Failed.i64())

        def acquired_outcome_never_resumes_automatically() -> bool:
            ensure result
            not StudioStorageManifestLockPolicy::may_automatically_retry_or_resume(StudioStorageManifestLockPolicy::Outcome.Acquired.i64())
