include "../src/studio/export_batch_destination_inspector_entry_policy.elisa"

module StudioExportBatchDestinationInspectorEntryLaws:
    public:
        def selected_item_can_be_inspected(count: i64, selected: i64) -> bool:
            requires count > 0 and count <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            requires selected >= 0 and selected < count
            ensure result
            StudioExportBatchDestinationInspectorEntryPolicy::admitted(true, false, false, true, count, selected)

        def empty_queue_refuses_entry(selected: i64) -> bool:
            ensure not result
            StudioExportBatchDestinationInspectorEntryPolicy::admitted(true, false, false, true, 0, selected)

        def invalid_selection_refuses_entry(count: i64, selected: i64) -> bool:
            requires selected < 0 or selected >= count
            ensure not result
            StudioExportBatchDestinationInspectorEntryPolicy::admitted(true, false, false, true, count, selected)

        def foreground_report_refuses_entry(count: i64, selected: i64) -> bool:
            ensure not result
            StudioExportBatchDestinationInspectorEntryPolicy::admitted(true, true, false, true, count, selected)

        def closed_sheet_refuses_entry(count: i64, selected: i64) -> bool:
            ensure not result
            StudioExportBatchDestinationInspectorEntryPolicy::admitted(false, false, false, true, count, selected)

        def invalid_queue_refuses_entry(count: i64, selected: i64) -> bool:
            ensure not result
            StudioExportBatchDestinationInspectorEntryPolicy::admitted(true, false, false, false, count, selected)
