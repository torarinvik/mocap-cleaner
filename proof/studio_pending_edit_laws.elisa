include "../src/studio/pending_edit_policy.elisa"

module StudioPendingEditLaws:
    public:
        def absent_drafts_match() -> bool:
            ensure result
            StudioPendingEditPolicy::same(null, null)

        def added_draft_invalidates_approval(draft: StackState::Stack) -> bool:
            ensure result
            not StudioPendingEditPolicy::same(null, draft)

        def removed_draft_invalidates_approval(draft: StackState::Stack) -> bool:
            ensure result
            not StudioPendingEditPolicy::same(draft, null)

        def changed_draft_invalidates_approval(first: StackState::Stack, second: StackState::Stack) -> bool:
            requires not StackState::same(first, second)
            ensure result
            not StudioPendingEditPolicy::same(first, second)

        def pending_draft_enables_undo_without_history() -> bool:
            ensure result
            StudioPendingEditPolicy::undo_available(true, false)

        def committed_undo_remains_available() -> bool:
            ensure result
            StudioPendingEditPolicy::undo_available(false, true)

        def undo_unavailable_without_draft_or_history() -> bool:
            ensure not result
            not StudioPendingEditPolicy::undo_available(false, false)

        def pending_draft_enables_redo_cancellation() -> bool:
            ensure result
            StudioPendingEditPolicy::redo_available(true, false)

        def committed_redo_remains_available() -> bool:
            ensure result
            StudioPendingEditPolicy::redo_available(false, true)

        def redo_unavailable_without_draft_or_history() -> bool:
            ensure not result
            not StudioPendingEditPolicy::redo_available(false, false)
