# Laws of the operation-stack cache: which prefix of cached results may be
# reused after an edit, and that disabled operations never invalidate it.
include "../src/core/stack_cache.elisa"

module StackCacheLaws:
    public:
        # Nothing changed and everything cached: the whole stack is reused.
        def unchanged_reuses_all(n: i64) -> i64:
            requires n >= 0
            requires n <= StackCache::Capacity::MAX_OPS
            ensure result == n
            return StackCache::reusable(n, n, n)

        # Editing op k of a fully cached stack reuses exactly ops 0..k-1.
        def edit_reuses_prefix(n: i64, k: i64) -> i64:
            requires n >= 0
            requires n <= StackCache::Capacity::MAX_OPS
            requires k >= 0
            requires k < n
            ensure result == k
            return StackCache::reusable(n, k, n)

        # No result at or after the first change is ever reused (no stale output).
        def never_past_change(cached: i64, k: i64, n: i64) -> i64:
            requires cached >= 0
            requires k >= 0
            requires n >= 0
            requires n <= StackCache::Capacity::MAX_OPS
            ensure result <= k
            ensure result <= cached
            return StackCache::reusable(cached, k, n)

        # An empty cache reuses nothing.
        def cold_cache_reuses_nothing(k: i64, n: i64) -> i64:
            requires k >= 0
            requires n >= 0
            requires n <= StackCache::Capacity::MAX_OPS
            ensure result == 0
            return StackCache::reusable(0, k, n)

        # Removing ops from the end keeps the surviving prefix.
        def shrink_keeps_prefix(cached: i64, n: i64) -> i64:
            requires n >= 0
            requires n <= cached
            requires cached <= StackCache::Capacity::MAX_OPS
            ensure result == n
            return StackCache::reusable(cached, cached, n)

        # The edited op is the first to run, and the op before it is skipped.
        def edited_op_runs(n: i64, k: i64) -> bool:
            requires k >= 0
            requires k < n
            requires n <= StackCache::Capacity::MAX_OPS
            ensure result
            reuse: i64 = StackCache::reusable(n, k, n)
            return StackCache::needs_eval(k, reuse)

        def op_before_edit_skipped(n: i64, k: i64) -> bool:
            requires k >= 1
            requires k < n
            requires n <= StackCache::Capacity::MAX_OPS
            ensure not result
            reuse: i64 = StackCache::reusable(n, k, n)
            return StackCache::needs_eval(k - 1, reuse)

        # A disabled op is the identity, so its key is its input key.
        def disabled_key_passes_through(input: i64, params: i64) -> i64:
            requires input >= 0
            requires input < StackCache::Fingerprint::MODULUS
            requires params >= 0
            requires params < StackCache::Fingerprint::MODULUS
            ensure result == input
            return StackCache::op_key(input, params, false)

        # Two chained keys stay in range (so a whole stack can be keyed).
        def chained_keys_in_range(input: i64, a: i64, b: i64, ea: bool, eb: bool) -> i64:
            requires input >= 0
            requires input < StackCache::Fingerprint::MODULUS
            requires a >= 0
            requires a < StackCache::Fingerprint::MODULUS
            requires b >= 0
            requires b < StackCache::Fingerprint::MODULUS
            ensure result >= 0
            ensure result < StackCache::Fingerprint::MODULUS
            first: i64 = StackCache::op_key(input, a, ea)
            return StackCache::op_key(first, b, eb)

        # Editing a disabled op's parameters is not a change.
        def disabled_edit_is_not_change(a: i64, b: i64) -> bool:
            ensure not result
            return StackCache::changed(false, false, a, b)

        # Toggling an op is always a change, either way.
        def enabling_is_change(a: i64, b: i64) -> bool:
            ensure result
            return StackCache::changed(false, true, a, b)

        def disabling_is_change(a: i64, b: i64) -> bool:
            ensure result
            return StackCache::changed(true, false, a, b)

        # An enabled op with the same parameters is unchanged.
        def same_params_unchanged(a: i64) -> bool:
            ensure not result
            return StackCache::changed(true, true, a, a)

        def new_params_changed(a: i64, b: i64) -> bool:
            requires a != b
            ensure result
            return StackCache::changed(true, true, a, b)

        # The prefix scan: matching keys extend it, a mismatch ends it for good.
        def match_extends(i: i64) -> i64:
            requires i >= 0
            requires i < StackCache::Capacity::MAX_OPS
            ensure result == i + 1
            return StackCache::scan(i, i, true)

        def mismatch_stops(p: i64, i: i64) -> i64:
            requires p >= 0
            requires p <= i
            requires i < StackCache::Capacity::MAX_OPS
            ensure result == p
            return StackCache::scan(p, i, false)

        def mismatch_is_final(i: i64, later: bool) -> i64:
            requires i >= 0
            requires i < StackCache::Capacity::MAX_OPS - 1
            ensure result == i
            stopped: i64 = StackCache::scan(i, i, false)
            return StackCache::scan(stopped, i + 1, later)
