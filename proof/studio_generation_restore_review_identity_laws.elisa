include "../src/studio/state/generation_restore_review_identity_policy.elisa"

module StudioGenerationRestoreReviewIdentityLaws:
    public:
        def exact_captured_identity_matches(root: darray[u8]&, operation: darray[u8]&, artifact_id: darray[u8]&, relative_path: darray[u8]&) -> bool:
            requires StudioGenerationRestoreReviewIdentityPolicy::valid(root, operation, artifact_id, relative_path)
            ensure StudioGenerationRestoreReviewIdentityPolicy::exact_match(root, operation, artifact_id, relative_path, root, operation, artifact_id, relative_path)
            StudioGenerationRestoreReviewIdentityPolicy::exact_match(root, operation, artifact_id, relative_path, root, operation, artifact_id, relative_path)

        def same_length_path_replacement_refused(root: darray[u8]&, operation: darray[u8]&, artifact_id: darray[u8]&, relative_path: darray[u8]&, observed_path: darray[u8]&) -> bool:
            requires StudioGenerationRestoreReviewIdentityPolicy::valid(root, operation, artifact_id, relative_path)
            requires observed_path.count == relative_path.count
            requires not StudioGenerationRestoreReviewIdentityPolicy::same_bytes(relative_path, observed_path)
            ensure not StudioGenerationRestoreReviewIdentityPolicy::exact_match(root, operation, artifact_id, relative_path, root, operation, artifact_id, observed_path)
            StudioGenerationRestoreReviewIdentityPolicy::exact_match(root, operation, artifact_id, relative_path, root, operation, artifact_id, observed_path)

        def same_length_artifact_replacement_refused(root: darray[u8]&, operation: darray[u8]&, artifact_id: darray[u8]&, observed_artifact_id: darray[u8]&, relative_path: darray[u8]&) -> bool:
            requires StudioGenerationRestoreReviewIdentityPolicy::valid(root, operation, artifact_id, relative_path)
            requires observed_artifact_id.count == artifact_id.count
            requires not StudioGenerationRestoreReviewIdentityPolicy::same_bytes(artifact_id, observed_artifact_id)
            ensure not StudioGenerationRestoreReviewIdentityPolicy::exact_match(root, operation, artifact_id, relative_path, root, operation, observed_artifact_id, relative_path)
            StudioGenerationRestoreReviewIdentityPolicy::exact_match(root, operation, artifact_id, relative_path, root, operation, observed_artifact_id, relative_path)

        def absent_path_metadata_refused(root: darray[u8]&, operation: darray[u8]&, artifact_id: darray[u8]&, relative_path: darray[u8]&) -> bool:
            requires relative_path.count == 0
            ensure not StudioGenerationRestoreReviewIdentityPolicy::valid(root, operation, artifact_id, relative_path)
            StudioGenerationRestoreReviewIdentityPolicy::valid(root, operation, artifact_id, relative_path)
