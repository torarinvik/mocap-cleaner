include "../src/core/correction_scope_policy.elisa"

module CorrectionScopePolicyLaws:
    public:
        def missing_channel(supported: bool, has_key: bool) -> bool:
            ensure result == false
            CorrectionScopePolicy::channel_admitted(false, supported, has_key)

        def unsupported_channel(found: bool, has_key: bool) -> bool:
            ensure result == false
            CorrectionScopePolicy::channel_admitted(found, false, has_key)

        def missing_key(found: bool, supported: bool) -> bool:
            ensure result == false
            CorrectionScopePolicy::channel_admitted(found, supported, false)

        def usable_channel() -> bool:
            ensure result == true
            CorrectionScopePolicy::channel_admitted(true, true, true)

        def negative_node(node: i64, first: i64, key: i64, last: i64) -> bool:
            requires node < 0
            ensure result == false
            CorrectionScopePolicy::valid(node, first, key, last)

        def key_before_scope(node: i64, first: i64, key: i64, last: i64) -> bool:
            requires key < first
            ensure result == false
            CorrectionScopePolicy::valid(node, first, key, last)

        def key_after_scope(node: i64, first: i64, key: i64, last: i64) -> bool:
            requires key > last
            ensure result == false
            CorrectionScopePolicy::valid(node, first, key, last)

        def oversized_scope(node: i64, first: i64, key: i64, last: i64) -> bool:
            requires last > KeyWeight::Domain::MAX_FRAMES
            ensure result == false
            CorrectionScopePolicy::valid(node, first, key, last)

        def single_frame(node: i64, frame: i64) -> bool:
            requires node >= 0
            requires frame >= 0
            requires frame <= KeyWeight::Domain::MAX_FRAMES
            ensure result == true
            CorrectionScopePolicy::valid(node, frame, frame, frame)

        def full_refuses(count: i64, capacity: i64, node: i64, first: i64, key: i64, last: i64) -> bool:
            requires capacity > 0
            requires count >= capacity
            ensure result == false
            CorrectionScopePolicy::can_append(count, capacity, node, first, key, last)

        def negative_count(count: i64, capacity: i64, node: i64, first: i64, key: i64, last: i64) -> bool:
            requires capacity > 0
            requires count < 0
            ensure result == false
            CorrectionScopePolicy::can_append(count, capacity, node, first, key, last)

        def valid_append(count: i64, capacity: i64, node: i64, first: i64, key: i64, last: i64) -> bool:
            requires capacity > 0
            requires count >= 0 and count < capacity
            requires node >= 0
            requires first >= 0 and first <= key and key <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            ensure result == true
            CorrectionScopePolicy::can_append(count, capacity, node, first, key, last)
