# Finding intent stays attached to an exact result revision and interval.
include "../src/studio/issue_annotation.elisa"

module StudioIssueAnnotationLaws:
    public:
        def unresolved_preserves_filter_encoding() -> bool:
            ensure result
            StudioIssueAnnotation::Disposition.Unresolved.i64() == 0

        def ignored_preserves_filter_encoding() -> bool:
            ensure result
            StudioIssueAnnotation::Disposition.Ignored.i64() == 1

        def identity_requires_same_revision(issue: StudioIssues::Issue, mark: StudioIssueAnnotation::Annotation, revision: i64) -> bool:
            requires issue.first_frame == mark.first_frame
            requires issue.last_frame == mark.last_frame
            requires issue.issue_type == mark.issue_type
            requires issue.subject_id == mark.subject_id
            requires issue.source_revision == revision
            requires mark.source_revision != revision
            ensure not result
            StudioIssueAnnotation::same_finding(issue, mark)

        def identity_requires_same_interval(issue: StudioIssues::Issue, mark: StudioIssueAnnotation::Annotation, first: i64) -> bool:
            requires issue.first_frame == first
            requires mark.first_frame != first
            requires issue.last_frame == mark.last_frame
            requires issue.issue_type == mark.issue_type
            requires issue.subject_id == mark.subject_id
            requires issue.source_revision == mark.source_revision
            ensure not result
            StudioIssueAnnotation::same_finding(issue, mark)

        def annotation_revision_must_match(issue: StudioIssues::Issue, mark: StudioIssueAnnotation::Annotation) -> bool:
            requires issue.source_revision != mark.source_revision
            ensure not result
            StudioIssueAnnotation::same_finding(issue, mark)
