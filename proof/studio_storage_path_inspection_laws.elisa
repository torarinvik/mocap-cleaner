include "../src/studio/storage_path_inspection_policy.elisa"

module StudioStoragePathInspectionLaws:
    public:
        def protected_rows_remain_inspectable(row_count: i64, index: i64,
                                               path_bytes: i64,
                                               cleanup_eligible: bool,
                                               identity_verified: bool) -> bool:
            requires row_count >= 1 and row_count <= StudioStorageSelectionPolicy::Capacity::MAX_ROWS
            requires index >= 0 and index < row_count
            requires path_bytes >= 1 and path_bytes <= StudioStoragePathInspectionPolicy::PATH_MAX_BYTES
            ensure result == true
            StudioStoragePathInspectionPolicy::allowed(row_count, index, path_bytes, false)

        def empty_path_is_denied(row_count: i64, index: i64) -> bool:
            requires row_count >= 1 and row_count <= StudioStorageSelectionPolicy::Capacity::MAX_ROWS
            requires index >= 0 and index < row_count
            ensure result == false
            StudioStoragePathInspectionPolicy::allowed(row_count, index, 0, false)

        def oversized_path_is_denied(row_count: i64, index: i64) -> bool:
            requires row_count >= 1 and row_count <= StudioStorageSelectionPolicy::Capacity::MAX_ROWS
            requires index >= 0 and index < row_count
            ensure result == false
            StudioStoragePathInspectionPolicy::allowed(row_count, index, StudioStoragePathInspectionPolicy::PATH_MAX_BYTES + 1, false)

        def invalid_row_is_denied(row_count: i64, index: i64) -> bool:
            requires row_count < 1 or row_count > StudioStorageSelectionPolicy::Capacity::MAX_ROWS or index < 0 or index >= row_count
            ensure result == false
            StudioStoragePathInspectionPolicy::allowed(row_count, index, 1, false)

        def inspection_is_denied_while_batch_runs(row_count: i64, index: i64,
                                                  path_bytes: i64) -> bool:
            requires row_count >= 1 and row_count <= StudioStorageSelectionPolicy::Capacity::MAX_ROWS
            requires index >= 0 and index < row_count
            requires path_bytes >= 1 and path_bytes <= StudioStoragePathInspectionPolicy::PATH_MAX_BYTES
            ensure result == false
            StudioStoragePathInspectionPolicy::allowed(row_count, index, path_bytes, true)
