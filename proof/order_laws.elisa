# Laws of the median de-spike kernel.
include "../src/core/order.elisa"

module OrderLaws:
    public:
        # A constant signal is unchanged by the median.
        def constant_is_fixed(v: i64) -> i64:
            ensure result == v
            return Order::median3(v, v, v)

        # A two-sample burst inside five is never chosen: with the outliers
        # at b and c above every other sample, the median is one of a, d, e.
        def two_sample_burst_is_removed(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64:
            requires b > a and b > d and b > e
            requires c > a and c > d and c > e
            ensure result == a or result == d or result == e
            return Order::median5(a, b, c, d, e)

        # A monotone run of five keeps its middle sample.
        def monotone_five_keeps_middle(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64:
            requires a <= b and b <= c and c <= d and d <= e
            ensure result == c
            return Order::median5(a, b, c, d, e)

        # A monotone triple keeps its middle sample (deliberate motion survives).
        def monotone_keeps_middle(a: i64, b: i64, c: i64) -> i64:
            requires a <= b
            requires b <= c
            ensure result == b
            return Order::median3(a, b, c)

        def monotone_down_keeps_middle(a: i64, b: i64, c: i64) -> i64:
            requires a >= b
            requires b >= c
            ensure result == b
            return Order::median3(a, b, c)

        # An isolated spike between equal neighbours is removed.
        def spike_is_removed(n: i64, spike: i64) -> i64:
            ensure result == n
            return Order::median3(n, spike, n)

        # The median never leaves the neighbours' envelope.
        def within_envelope(a: i64, b: i64, c: i64, lo: i64, hi: i64) -> i64:
            requires lo <= a
            requires lo <= b
            requires lo <= c
            requires a <= hi
            requires b <= hi
            requires c <= hi
            ensure result >= lo
            ensure result <= hi
            return Order::median3(a, b, c)

        # Clamp is idempotent.
        def clamp_idempotent(v: i64, lo: i64, hi: i64) -> bool:
            requires lo <= hi
            ensure result
            once: i64 = Order::clamp(v, lo, hi)
            twice: i64 = Order::clamp(once, lo, hi)
            return twice == once
