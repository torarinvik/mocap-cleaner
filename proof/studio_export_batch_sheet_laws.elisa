include "../src/studio/state/export_batch_sheet_state.elisa"

module StudioExportBatchSheetLaws:
    public:
        def reopen_preserves_navigation(s: StudioExportBatchSheetState::State) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            ensure result
            closed: StudioExportBatchSheetState::State = StudioExportBatchSheetState::show(s, false)
            reopened: StudioExportBatchSheetState::State = StudioExportBatchSheetState::show(closed, true)
            reopened.opened and reopened.selected == s.selected and reopened.first == s.first

        def created_sheet_is_valid(total: i64) -> bool:
            requires total >= 0 and total <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            ensure result
            StudioExportBatchSheetState::valid(StudioExportBatchSheetState::create(total))

        def empty_sheet_has_no_selection() -> bool:
            ensure result
            s: StudioExportBatchSheetState::State = StudioExportBatchSheetState::create(0)
            s.selected == -1 and s.first == 0

        def closing_preserves_display_selection(s: StudioExportBatchSheetState::State) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            ensure result
            closed: StudioExportBatchSheetState::State = StudioExportBatchSheetState::show(s, false)
            not closed.opened and closed.selected == s.selected and closed.first == s.first

        def removed_items_cannot_remain_selected(s: StudioExportBatchSheetState::State) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            ensure result
            empty: StudioExportBatchSheetState::State = StudioExportBatchSheetState::reconcile(s, 0)
            StudioExportBatchSheetState::valid(empty) and empty.selected == -1

        def rejected_row_preserves_selection(s: StudioExportBatchSheetState::State, row: i64) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            requires row < 0 or row >= s.total
            ensure result
            StudioExportBatchSheetState::select(s, row).selected == s.selected

        def selected_row_survives_refresh(s: StudioExportBatchSheetState::State, total: i64) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            requires total >= 0 and total <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            requires s.selected >= 0 and s.selected < total
            ensure result
            StudioExportBatchSheetState::reconcile(s, total).selected == s.selected

        def paging_preserves_valid_selection(s: StudioExportBatchSheetState::State,
                direction: StudioExportBatchPanelPolicy::Direction) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            ensure result
            StudioExportBatchSheetState::valid(StudioExportBatchSheetState::page(s, direction))

        def focused_control_is_enabled(s: StudioExportBatchSheetState::State,
                reverse: bool, controls: StudioExportBatchPanelPolicy::Controls) -> bool:
            requires StudioExportBatchSheetState::valid(s)
            ensure result
            focused: StudioExportBatchSheetState::State = StudioExportBatchSheetState::move_focus(s, reverse, controls)
            StudioExportBatchPanelPolicy::action_enabled(focused.focus, controls)

        def inspect_focus_is_valid_sheet_state() -> bool:
            ensure result
            mutable s: StudioExportBatchSheetState::State = StudioExportBatchSheetState::create(1)
            s.focus <- StudioExportBatchPanelPolicy::Focus.Inspect
            StudioExportBatchSheetState::valid(s)
