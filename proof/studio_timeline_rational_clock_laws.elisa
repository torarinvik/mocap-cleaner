include "../src/studio/timeline_rational_clock_policy.elisa"

module StudioTimelineRationalClockLaws:
    public:
        def fractional_rates_admitted() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::rate_valid(30000, 1001) and StudioTimelineRationalClockPolicy::rate_valid(60000, 1001)

        def zero_denominator_refused() -> bool:
            ensure result
            not StudioTimelineRationalClockPolicy::rate_valid(30000, 0)

        def over_budget_rate_refused() -> bool:
            ensure result
            not StudioTimelineRationalClockPolicy::rate_valid(1001, 1)

        def first_fractional_frame_start() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::boundary_us(1, 30000, 1001) == 33367

        def thousand_and_one_second_boundary() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::boundary_us(30000, 30000, 1001) == 1001000000

        def fractional_frame_rounding() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::frame_at_us(33366, 30000, 1001, 100) == 0 and StudioTimelineRationalClockPolicy::frame_at_us(33367, 30000, 1001, 100) == 1

        def fractional_rate_does_not_round_to_thirty() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::frame_at_us(1000000, 30000, 1001, 100) == 29

        def maximum_time_product_is_split() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::frame_at_us(10000000000000, 1000000, 1000, 10000000) == 9999999

        def slow_maximum_clip_end() -> bool:
            ensure result
            StudioTimelineRationalClockPolicy::boundary_us(10000000, 1000000, 1000000) == 10000000000000
