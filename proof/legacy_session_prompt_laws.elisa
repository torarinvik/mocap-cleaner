# Old sessions are never accepted by default: the initial focus is Cancel,
# and Load can be chosen only after moving focus or clicking that action.
include "../src/studio/legacy_session_prompt.elisa"

module StudioLegacyPromptLaws:
    public:
        def prompt_defaults_to_cancel() -> bool:
            ensure result
            return StudioLegacyPrompt::initial_focus() == StudioLegacyPrompt::Focus.Cancel.i64()

        def right_from_cancel_selects_load() -> bool:
            ensure result
            return StudioLegacyPrompt::move_focus(StudioLegacyPrompt::Focus.Cancel.i64(), 1) == StudioLegacyPrompt::Focus.Load.i64()

        def left_from_load_returns_to_cancel() -> bool:
            ensure result
            return StudioLegacyPrompt::move_focus(StudioLegacyPrompt::Focus.Load.i64(), -1) == StudioLegacyPrompt::Focus.Cancel.i64()

        def open_prompt_resolves_only_the_selected_choice(choice: i64) -> bool:
            requires choice == StudioLegacyPrompt::Choice.Load.i64() or choice == StudioLegacyPrompt::Choice.Cancel.i64()
            ensure result
            return StudioLegacyPrompt::resolve(true, choice) == choice

        def closed_prompt_cannot_resolve(choice: i64) -> bool:
            requires choice == StudioLegacyPrompt::Choice.Load.i64() or choice == StudioLegacyPrompt::Choice.Cancel.i64()
            ensure result
            return StudioLegacyPrompt::resolve(false, choice) == StudioLegacyPrompt::Choice.None.i64()
