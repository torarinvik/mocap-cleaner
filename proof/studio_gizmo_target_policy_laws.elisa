include "../src/studio/gizmo_target_policy.elisa"

module StudioGizmoTargetPolicyLaws:
    public:
        def unchanged(target: StudioGizmoTargetPolicy::Target) -> bool:
            requires target.generation >= 0 and target.result_generation >= 0 and target.bone >= 0 and target.frame >= 0 and target.view >= 0 and target.mode >= 0
            ensure result == true
            StudioGizmoTargetPolicy::current(target, target)

        def changed_history(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.generation != b.generation
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)

        def changed_bone(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.bone != b.bone
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)

        def changed_frame(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.frame != b.frame
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)

        def changed_view(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.view != b.view
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)

        def changed_mode(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.mode != b.mode
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)

        def invalid_capture(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.generation < 0 or a.result_generation < 0 or a.bone < 0 or a.frame < 0 or a.view < 0 or a.mode < 0
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)

        def changed_result(a: StudioGizmoTargetPolicy::Target, b: StudioGizmoTargetPolicy::Target) -> bool:
            requires a.result_generation != b.result_generation
            ensure result == false
            StudioGizmoTargetPolicy::current(a, b)
