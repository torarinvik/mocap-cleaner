# Export publication is fail-closed: resolved targets stay below build, do
# not alias the source, and require consent before replacing an existing file.
include "../src/studio/export_policy.elisa"

module StudioExportPolicyLaws:
    public:
        def canonical_child_is_inside_build() -> bool:
            root: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100]
            target: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100, 47, 114, 101, 115, 117, 108, 116, 46, 103, 108, 98]
            StudioExportPolicy::inside_build(root, target)

        def sibling_prefix_is_outside_build() -> bool:
            root: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100]
            target: darray[u8] = [47, 112, 114, 111, 106, 101, 99, 116, 47, 98, 117, 105, 108, 100, 45, 111, 108, 100, 47, 114, 101, 115, 117, 108, 116, 46, 103, 108, 98]
            not StudioExportPolicy::inside_build(root, target)

        def unresolved_paths_are_rejected() -> bool:
            StudioExportPolicy::decision(false, true, false, false, false, false, false) == StudioExportPolicy::PATH_UNRESOLVED

        def outside_paths_are_rejected() -> bool:
            StudioExportPolicy::decision(true, false, false, false, false, false, false) == StudioExportPolicy::OUTSIDE_BUILD

        def source_aliases_are_rejected() -> bool:
            StudioExportPolicy::decision(true, true, true, true, false, true, true) == StudioExportPolicy::SOURCE_COLLISION

        def symbolic_links_are_rejected() -> bool:
            StudioExportPolicy::decision(true, true, false, true, true, true, true) == StudioExportPolicy::SYMBOLIC_LINK

        def non_files_are_rejected() -> bool:
            StudioExportPolicy::decision(true, true, false, true, false, false, true) == StudioExportPolicy::NOT_REGULAR_FILE

        def replacement_requires_confirmation() -> bool:
            StudioExportPolicy::decision(true, true, false, true, false, true, false) == StudioExportPolicy::OVERWRITE_UNCONFIRMED

        def new_child_can_be_published() -> bool:
            StudioExportPolicy::decision(true, true, false, false, false, false, false) == StudioExportPolicy::ALLOW

        def confirmed_regular_replacement_can_be_published() -> bool:
            StudioExportPolicy::decision(true, true, false, true, false, true, true) == StudioExportPolicy::ALLOW

        def review_has_no_warning_when_metrics_hold() -> bool:
            StudioExportPolicy::warning_count(0, 5, 3, 6, 4, 3, 2, 8, 7) == 0

        def review_warns_on_unresolved_balance_frames() -> bool:
            StudioExportPolicy::warning_count(2, 5, 3, 6, 4, 3, 2, 8, 7) == 1

        def review_warns_on_spike_regression() -> bool:
            StudioExportPolicy::warning_count(0, 5, 6, 6, 4, 3, 2, 8, 7) == 1

        def review_warns_on_foot_slide_regression() -> bool:
            StudioExportPolicy::warning_count(0, 5, 3, 6, 7, 3, 2, 8, 7) == 1

        def review_warns_on_sink_regression() -> bool:
            StudioExportPolicy::warning_count(0, 5, 3, 6, 4, 3, 4, 8, 7) == 1

        def review_warns_on_hand_slide_regression() -> bool:
            StudioExportPolicy::warning_count(0, 5, 3, 6, 4, 3, 2, 8, 9) == 1

        def review_counts_distinct_warning_categories() -> bool:
            StudioExportPolicy::warning_count(1, 5, 6, 6, 7, 3, 4, 8, 9) == 5
