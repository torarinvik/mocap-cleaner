include "../src/studio/export_batch_report_accessibility_policy.elisa"

module StudioExportBatchReportAccessibilityLaws:
    public:
        def report_ids_are_in_reserved_noncolliding_range() -> bool:
            ensure result
            StudioExportBatchReportAccessibilityPolicy::ids_fit_and_follow_studio_namespace() and StudioAccessibility::SemanticId::REVIEW_QUEUE < StudioAccessibility::SemanticId::QUEUE_ENTRY and StudioAccessibility::SemanticId::QUEUE_ENTRY < StudioExportBatchReportAccessibilityPolicy::Node::DIALOG

        def review_queue_action_and_entry_are_in_their_trees() -> bool:
            ensure result
            StudioAccessibility::is_export_review_node(StudioAccessibility::SemanticId::REVIEW_QUEUE) and StudioAccessibility::parent(StudioAccessibility::SemanticId::REVIEW_QUEUE) == StudioAccessibility::SemanticId::EXPORT_REVIEW and StudioAccessibility::export_review_next_sibling(StudioAccessibility::SemanticId::REVIEW_EXPORT, 0) == StudioAccessibility::SemanticId::REVIEW_QUEUE and StudioAccessibility::parent(StudioAccessibility::SemanticId::QUEUE_ENTRY) == StudioAccessibility::SemanticId::WORKSPACE and StudioAccessibility::workspace_next_sibling_with_queue(StudioAccessibility::SemanticId::STATUS, true) == StudioAccessibility::SemanticId::QUEUE_ENTRY and StudioAccessibility::workspace_next_sibling_with_queue(StudioAccessibility::SemanticId::QUEUE_ENTRY, true) == StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER

        def report_tree_has_expected_parent_and_order(row: i64) -> bool:
            requires row >= 0 and row < StudioExportBatchReportAccessibilityPolicy::Node::LINE_COUNT
            ensure result
            id: usize = StudioExportBatchReportAccessibilityPolicy::line_id(row)
            StudioExportBatchReportAccessibilityPolicy::parent_id(id) == StudioExportBatchReportAccessibilityPolicy::Node::DIALOG and StudioExportBatchReportAccessibilityPolicy::next_sibling_id(id, StudioExportBatchReportAccessibilityPolicy::Node::LINE_COUNT) == id + 1

        def short_page_links_to_controls(rows: i64) -> bool:
            requires rows > 0 and rows < StudioExportBatchReportAccessibilityPolicy::Node::LINE_COUNT
            ensure result
            last_line: usize = StudioExportBatchReportAccessibilityPolicy::line_id(rows - 1)
            StudioExportBatchReportAccessibilityPolicy::next_sibling_id(last_line, rows) == StudioExportBatchReportAccessibilityPolicy::Node::CONTROL_FIRST

        def empty_page_links_status_to_controls() -> bool:
            ensure result
            StudioExportBatchReportAccessibilityPolicy::next_sibling_id(StudioExportBatchReportAccessibilityPolicy::Node::STATUS, 0) == StudioExportBatchReportAccessibilityPolicy::Node::CONTROL_FIRST

        def control_id_decodes_to_the_same_control(control: StudioExportBatchWarningReviewPolicy::Control) -> bool:
            ensure result
            if StudioExportBatchReportAccessibilityPolicy::control_for_id(StudioExportBatchReportAccessibilityPolicy::control_id(control)) is decoded:
                return decoded == control
            false
