include "../src/studio/sample_time_policy.elisa"

module StudioSampleTimeLaws:
    public:
        def first_timestamp_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::timestamp_valid(0, -1, true)

        def nonuniform_increasing_time_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::timestamp_valid(45000, 10000, false)

        def duplicate_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::timestamp_valid(10000, 10000, false)

        def descending_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::timestamp_valid(9999, 10000, false)

        def negative_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::timestamp_valid(-1, -1, true)

        def maximum_time_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::timestamp_valid(StudioSampleTimePolicy::Domain::MAX_TIME_US, 0, false)

        def origin_is_clip_relative() -> bool:
            ensure result
            StudioSampleTimePolicy::relative_us(120000, 100000) == 20000

        def mismatched_channel_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::aligned(45000, 45001)

        def exact_channel_time_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::aligned(45000, 45000)
