include "../src/studio/sample_time_policy.elisa"

module StudioSampleTimeLaws:
    public:
        def final_sample_is_included() -> bool:
            ensure result
            StudioSampleTimePolicy::end_us(45000) == 45001

        def short_sample_loop_preserves_phase() -> bool:
            ensure result
            StudioSampleTimePolicy::loop_phase(250123, 1000) == 123

        def decimal_time_units() -> bool:
            ensure result
            StudioSampleTimePolicy::microseconds(2125) == 2125000

        def exact_last_time_is_not_clamped() -> bool:
            ensure result
            not StudioSampleTimePolicy::past_end(2125000, 2125000)

        def beyond_last_time_is_clamped() -> bool:
            ensure result
            StudioSampleTimePolicy::past_end(2125001, 2125000)

        def first_timestamp_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::timestamp_valid(0, -1, true)

        def nonuniform_increasing_time_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::timestamp_valid(45000, 10000, false)

        def duplicate_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::timestamp_valid(10000, 10000, false)

        def descending_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::timestamp_valid(9999, 10000, false)

        def negative_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::timestamp_valid(-1, -1, true)

        def maximum_time_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::timestamp_valid(StudioSampleTimePolicy::Domain::MAX_TIME_US, 0, false)

        def origin_is_clip_relative() -> bool:
            ensure result
            StudioSampleTimePolicy::relative_us(120000, 100000) == 20000

        def mismatched_channel_time_refused() -> bool:
            ensure result
            not StudioSampleTimePolicy::aligned(45000, 45001)

        def exact_channel_time_admitted() -> bool:
            ensure result
            StudioSampleTimePolicy::aligned(45000, 45000)

        def stop_remains_available() -> bool:
            ensure result
            StudioSampleTimePolicy::playback_allowed(true, false, false)

        def invalid_clock_cannot_start() -> bool:
            ensure result
            not StudioSampleTimePolicy::playback_allowed(false, false, true)

        def mismatched_count_cannot_start() -> bool:
            ensure result
            not StudioSampleTimePolicy::playback_allowed(false, true, false)

        def valid_clock_can_start() -> bool:
            ensure result
            StudioSampleTimePolicy::playback_allowed(false, true, true)
