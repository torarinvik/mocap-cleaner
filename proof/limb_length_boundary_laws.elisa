include "../src/core/length_units.elisa"
include "../src/core/reach.elisa"

module LimbLengthBoundaryLaws:
    public:
        def metre_has_ten_thousand_units() -> bool:
            ensure result
            LengthUnits::from_micrometres(1000000) == LengthUnits::Scale::UNITS_PER_METRE and LengthUnits::Scale::UNITS_PER_METRE == 10000

        def kilometre_clamp_preserved() -> bool:
            ensure result
            LengthUnits::from_micrometres(1000000000) == 10000000 and LengthUnits::to_micrometres(10000000) == 1000000000

        def two_metre_reach_clamps_three_metre_target() -> bool:
            ensure result
            Reach::limb_reach(30000, 10000, 10000) == 20000

        def unequal_limb_retains_inner_boundary() -> bool:
            ensure result
            Reach::limb_reach(1000, 15000, 10000) == 5000

        def exact_unit_scaling_preserves_reach(distance: i64, upper: i64, lower: i64) -> bool:
            requires distance >= 0 and distance <= 10000000
            requires upper >= 0 and upper <= 10000000
            requires lower >= 0 and lower <= 10000000
            ensure result
            Reach::limb_reach(distance * 100, upper * 100, lower * 100) == Reach::limb_reach(distance, upper, lower) * 100

        def physical_reach_stays_nonnegative(distance: i64, upper: i64, lower: i64) -> bool:
            requires distance >= 0 and distance <= 10000000
            requires upper >= 0 and upper <= 10000000
            requires lower >= 0 and lower <= 10000000
            ensure result
            Reach::limb_reach(distance, upper, lower) >= 0 and Reach::limb_reach(distance, upper, lower) <= 20000000
