include "../src/studio/state/generation_review_accessibility_policy.elisa"

module StudioGenerationReviewRecoveryAccessibilityLaws:
    public:
        def operations_action_has_distinct_identity() -> bool:
            ensure StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Operations) == StudioGenerationReviewAccessibilityPolicy::Node::OPERATIONS
            StudioGenerationReviewAccessibilityPolicy::action_for_id(StudioGenerationReviewAccessibilityPolicy::Node::OPERATIONS) == StudioGenerationReviewAccessibilityPolicy::Action.Operations.i64()

        def restore_precedes_operations_in_navigation() -> bool:
            ensure StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::Node::RESTORE, 0) == StudioGenerationReviewAccessibilityPolicy::Node::OPERATIONS
            StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::Node::RESTORE, 0) == StudioGenerationReviewAccessibilityPolicy::Node::OPERATIONS
