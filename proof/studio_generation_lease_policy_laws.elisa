include "../src/studio/generation_lease_policy.elisa"

module StudioGenerationLeasePolicyLaws:
    def acquired_status_admits_start() -> bool:
        ensure result
        StudioGenerationLeasePolicy::admitted(
            StudioGenerationLeasePolicy::AcquireStatus.Acquired)

    def invalid_metadata_never_admits_start() -> bool:
        ensure not result
        StudioGenerationLeasePolicy::admitted(
            StudioGenerationLeasePolicy::AcquireStatus.MetadataUnavailable)

    def busy_lease_never_admits_start() -> bool:
        ensure not result
        StudioGenerationLeasePolicy::admitted(
            StudioGenerationLeasePolicy::AcquireStatus.LeaseBusy)

    def changed_artifact_never_admits_start() -> bool:
        ensure not result
        StudioGenerationLeasePolicy::admitted(
            StudioGenerationLeasePolicy::AcquireStatus.ArtifactChanged)

    def native_failure_never_admits_start() -> bool:
        ensure not result
        StudioGenerationLeasePolicy::admitted(
            StudioGenerationLeasePolicy::AcquireStatus.NativeFailure)
