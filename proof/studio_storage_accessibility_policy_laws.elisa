# The semantic IDs, hierarchy, command mapping, and action guards carry the
# verified contracts. Runtime hierarchy invariants are covered by the focused
# test, including the list boundary and the persistent File menu.
include "../src/studio/storage_accessibility_policy.elisa"

module StudioStorageAccessibilityPolicyLaws:
    public:
        def bulk_selection_actions_are_available() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::ACTION_SELECT_ELIGIBLE, false, false) and StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::ACTION_CLEAR_SELECTION, false, false)

        def preference_failures_are_announced_as_alerts() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(16) and StudioStorageAccessibilityPolicy::result_is_alert(17)

        def exemption_is_node() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::EXEMPTION)

        def exemption_is_dialog_child() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::EXEMPTION) == StudioStorageAccessibilityPolicy::DIALOG

        def exemption_follows_clear_selection() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::CLEAR_SELECTION, StudioStorageAccessibilityPolicy::ROW_COUNT) == StudioStorageAccessibilityPolicy::EXEMPTION

        def announcement_follows_exemption() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::EXEMPTION, StudioStorageAccessibilityPolicy::ROW_COUNT) == StudioStorageAccessibilityPolicy::ANNOUNCEMENT

        def exemption_node_maps_to_action_seven() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::EXEMPTION) == StudioStorageAccessibilityPolicy::ACTION_EXEMPTION

        def action_seven_maps_to_exemption_node() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::ACTION_EXEMPTION) == StudioStorageAccessibilityPolicy::EXEMPTION

        def exemption_readiness_gates_action(ready: bool) -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_enabled_with_exemption(StudioStorageAccessibilityPolicy::ACTION_EXEMPTION, false, false, ready) == ready

        def exemption_save_failure_is_alert() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::MESSAGE_EXEMPTION_SAVE_FAILED)

        def exemption_save_success_is_status() -> bool:
            ensure result
            not StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::MESSAGE_EXEMPTION_SAVED)

        def exemption_read_failure_remains_alert() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::MESSAGE_EXEMPTIONS_READ_FAILED)

        def storage_lock_outcomes_are_alerts() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::MESSAGE_LOCK_UNAVAILABLE) and StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::MESSAGE_LOCK_RELEASE_UNCERTAIN)

        def recorded_path_is_dialog_child() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::INSPECT_PATH) and StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::INSPECT_PATH) == StudioStorageAccessibilityPolicy::DIALOG

        def recorded_path_action_round_trip() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::ACTION_INSPECT_PATH)) == StudioStorageAccessibilityPolicy::ACTION_INSPECT_PATH

        def recorded_path_follows_announcement() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::ANNOUNCEMENT, 0) == StudioStorageAccessibilityPolicy::INSPECT_PATH
