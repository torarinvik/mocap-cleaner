# The semantic IDs, hierarchy, command mapping, and action guards carry the
# verified contracts. Runtime hierarchy invariants are covered by the focused
# test, including the list boundary and the persistent File menu.
include "../src/studio/storage_accessibility_policy.elisa"
include "../src/studio/accessibility.elisa"

module StudioStorageAccessibilityPolicyLaws:
    public:
        def bulk_selection_actions_are_available() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::Action::ACTION_SELECT_ELIGIBLE, false, false) and StudioStorageAccessibilityPolicy::action_enabled_with_cleanup(StudioStorageAccessibilityPolicy::Action::ACTION_CLEAR_SELECTION, false, false)

        def preference_failures_are_announced_as_alerts() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(16) and StudioStorageAccessibilityPolicy::result_is_alert(17)

        def exemption_is_node() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::Node::EXEMPTION)

        def exemption_is_dialog_child() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::EXEMPTION) == StudioStorageAccessibilityPolicy::Node::DIALOG

        def exemption_follows_clear_selection() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::CLEAR_SELECTION, StudioStorageAccessibilityPolicy::Node::ROW_COUNT) == StudioStorageAccessibilityPolicy::Node::EXEMPTION

        def announcement_follows_exemption() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::EXEMPTION, StudioStorageAccessibilityPolicy::Node::ROW_COUNT) == StudioStorageAccessibilityPolicy::Node::ANNOUNCEMENT

        def exemption_node_maps_to_action_seven() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::Node::EXEMPTION) == StudioStorageAccessibilityPolicy::Action::ACTION_EXEMPTION

        def action_seven_maps_to_exemption_node() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::Action::ACTION_EXEMPTION) == StudioStorageAccessibilityPolicy::Node::EXEMPTION

        def exemption_readiness_gates_action(ready: bool) -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_enabled_with_exemption(StudioStorageAccessibilityPolicy::Action::ACTION_EXEMPTION, false, false, ready) == ready

        def exemption_save_failure_is_alert() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::Message::MESSAGE_EXEMPTION_SAVE_FAILED)

        def exemption_save_success_is_status() -> bool:
            ensure result
            not StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::Message::MESSAGE_EXEMPTION_SAVED)

        def exemption_read_failure_remains_alert() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::Message::MESSAGE_EXEMPTIONS_READ_FAILED)

        def storage_lock_outcomes_are_alerts() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::Message::MESSAGE_LOCK_UNAVAILABLE) and StudioStorageAccessibilityPolicy::result_is_alert(StudioStorageAccessibilityPolicy::Message::MESSAGE_LOCK_RELEASE_UNCERTAIN)

        def recorded_path_is_dialog_child() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::Node::INSPECT_PATH) and StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::INSPECT_PATH) == StudioStorageAccessibilityPolicy::Node::DIALOG

        def recorded_path_action_round_trip() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::Action::ACTION_INSPECT_PATH)) == StudioStorageAccessibilityPolicy::Action::ACTION_INSPECT_PATH

        def recorded_path_follows_announcement() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::ANNOUNCEMENT, 0) == StudioStorageAccessibilityPolicy::Node::INSPECT_PATH

        def filter_node_is_admitted_node() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::is_node(StudioStorageAccessibilityPolicy::Node::FILTER)

        def filter_node_parent_is_dialog() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::FILTER) == StudioStorageAccessibilityPolicy::Node::DIALOG

        def filter_action_round_trips_to_node() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::action_for_node(StudioStorageAccessibilityPolicy::action_id(StudioStorageAccessibilityPolicy::Action::ACTION_FILTER)) == StudioStorageAccessibilityPolicy::Action::ACTION_FILTER

        def filter_follows_inspect_path() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::INSPECT_PATH, StudioStorageAccessibilityPolicy::Node::ROW_COUNT) == StudioStorageAccessibilityPolicy::Node::FILTER

        def filter_is_final_dialog_action() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::FILTER, StudioStorageAccessibilityPolicy::Node::ROW_COUNT) == StudioStorageAccessibilityPolicy::Node::NO_NODE

        def filter_denied_during_batch() -> bool:
            ensure result == (not true and not false)
            StudioStorageAccessibilityPolicy::filter_admitted(true, false)

        def filter_denied_while_reviewing() -> bool:
            ensure result == (not false and not true)
            StudioStorageAccessibilityPolicy::filter_admitted(false, true)

        def filter_admitted_when_idle() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::filter_admitted(false, false)

        def filter_admission_truth_table(running: bool, reviewing: bool) -> bool:
            ensure result == (not running and not reviewing)
            StudioStorageAccessibilityPolicy::filter_admitted(running, reviewing)

        def workspace_menu_ids_do_not_overlap_registered_nodes() -> bool:
            ensure result
            create_id: usize = StudioStorageAccessibilityPolicy::file_command_id(8)
            cancel_id: usize = StudioStorageAccessibilityPolicy::file_command_id(9)
            create_id == StudioStorageAccessibilityPolicy::Node::FILE_CREATE_BUILD and
                cancel_id == StudioStorageAccessibilityPolicy::Node::FILE_CANCEL_SETUP and
                create_id != StudioStorageAccessibilityPolicy::Node::TRASH and
                create_id != StudioStorageAccessibilityPolicy::Node::FILTER and
                create_id != StudioAccessibility::SemanticId::STACK_GROUP and
                cancel_id != StudioStorageAccessibilityPolicy::Node::TRASH and
                cancel_id != StudioStorageAccessibilityPolicy::Node::FILTER and
                cancel_id != StudioAccessibility::SemanticId::STACK_GROUP and
                create_id != StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST and
                create_id != StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST + 1 and
                cancel_id != StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST and
                cancel_id != StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST + 1

        def pending_workspace_path_has_a_unique_registered_node() -> bool:
            ensure result
            id: usize = StudioStorageAccessibilityPolicy::Node::PENDING_WORKSPACE_PATH
            StudioStorageAccessibilityPolicy::is_node(id) and
                StudioStorageAccessibilityPolicy::parent(id) == StudioStorageAccessibilityPolicy::Node::FILE_MENU and
                id != StudioStorageAccessibilityPolicy::Node::FILE_CREATE_BUILD and
                id != StudioStorageAccessibilityPolicy::Node::FILE_CANCEL_SETUP and
                id != StudioAccessibility::SemanticId::BALANCE_STATUS and
                id != StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST and
                id != StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST + 1

        def pending_path_precedes_file_actions_in_tree() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::file_first_child(StudioStorageAccessibilityPolicy::Node::FILE_MENU, true) == StudioStorageAccessibilityPolicy::Node::PENDING_WORKSPACE_PATH and
                StudioStorageAccessibilityPolicy::file_first_child(StudioStorageAccessibilityPolicy::Node::FILE_MENU, false) == StudioStorageAccessibilityPolicy::Node::FILE_COMMAND_FIRST and
                StudioStorageAccessibilityPolicy::file_next_sibling(StudioStorageAccessibilityPolicy::Node::PENDING_WORKSPACE_PATH, true) == StudioStorageAccessibilityPolicy::Node::FILE_COMMAND_FIRST

        def workspace_menu_extra_commands_are_registered() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::is_file_command(StudioStorageAccessibilityPolicy::Node::FILE_CREATE_BUILD) and
                StudioStorageAccessibilityPolicy::is_file_command(StudioStorageAccessibilityPolicy::Node::FILE_CANCEL_SETUP) and
                StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::FILE_CREATE_BUILD) == StudioStorageAccessibilityPolicy::Node::FILE_MENU and
                StudioStorageAccessibilityPolicy::parent(StudioStorageAccessibilityPolicy::Node::FILE_CANCEL_SETUP) == StudioStorageAccessibilityPolicy::Node::FILE_MENU

        def locate_is_last_without_pending_setup() -> usize:
            ensure result == StudioStorageAccessibilityPolicy::Node::NO_NODE
            StudioStorageAccessibilityPolicy::file_next_sibling(StudioStorageAccessibilityPolicy::file_command_id(7), false)

        def create_and_cancel_follow_locate_while_pending() -> bool:
            ensure result
            StudioStorageAccessibilityPolicy::file_next_sibling(StudioStorageAccessibilityPolicy::file_command_id(7), true) == StudioStorageAccessibilityPolicy::Node::FILE_CREATE_BUILD and
                StudioStorageAccessibilityPolicy::file_next_sibling(StudioStorageAccessibilityPolicy::Node::FILE_CREATE_BUILD, true) == StudioStorageAccessibilityPolicy::Node::FILE_CANCEL_SETUP and
                StudioStorageAccessibilityPolicy::file_next_sibling(StudioStorageAccessibilityPolicy::Node::FILE_CANCEL_SETUP, true) == StudioStorageAccessibilityPolicy::Node::NO_NODE
