include "../src/studio/export_batch_resume_policy.elisa"

module StudioExportBatchResumeLaws:
    public:
        def drained_cancelled_queue_can_resume() -> bool:
            ensure result
            StudioExportBatchResumePolicy::admitted(true, 0) and not StudioExportBatchResumePolicy::after_resume(true, 0)

        def draining_queue_stays_cancelled(active_workers: i64) -> bool:
            requires active_workers > 0
            requires active_workers <= StudioExportBatchQueuePolicy::Capacity::MAX_WORKERS
            ensure result
            not StudioExportBatchResumePolicy::admitted(true, active_workers) and StudioExportBatchResumePolicy::after_resume(true, active_workers)

        def live_queue_resume_is_noop(active_workers: i64) -> bool:
            requires active_workers >= 0
            requires active_workers <= StudioExportBatchQueuePolicy::Capacity::MAX_WORKERS
            ensure result
            not StudioExportBatchResumePolicy::admitted(false, active_workers) and not StudioExportBatchResumePolicy::after_resume(false, active_workers)

        def maximal_worker_count_stays_cancelled() -> bool:
            ensure result
            StudioExportBatchResumePolicy::after_resume(true, StudioExportBatchQueuePolicy::Capacity::MAX_WORKERS)
