include "../src/studio/session_locate_policy.elisa"

module StudioSessionLocatePolicyLaws:
    public:
        def matching_metadata_requires_explicit_restore_choice() -> bool:
            ensure result
            identity: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.Matching
            StudioSessionLocatePolicy::restore_admitted(true, true, identity) and StudioSessionLocatePolicy::action_enabled(true, true, identity, StudioSessionLocatePolicy::Choice.RestoreSession) and StudioSessionLocatePolicy::resolve(true, true, true, identity, StudioSessionLocatePolicy::Choice.RestoreSession) == StudioSessionLocatePolicy::Resolution.RestoreReviewedSession and StudioSessionLocatePolicy::resolve(true, true, true, identity, StudioSessionLocatePolicy::Choice.Locate) == StudioSessionLocatePolicy::Resolution.LocateSource

        def changed_source_never_enables_restore_review(comparison: StudioSessionSourcePolicy::Comparison) -> bool:
            requires comparison == StudioSessionSourcePolicy::Comparison.ChangedBytes or comparison == StudioSessionSourcePolicy::Comparison.ChangedAnimation or comparison == StudioSessionSourcePolicy::Comparison.ChangedShape
            ensure result
            not StudioSessionLocatePolicy::restore_admitted(true, true, comparison) and not StudioSessionLocatePolicy::action_enabled(true, true, comparison, StudioSessionLocatePolicy::Choice.RestoreSession)

        def changed_bytes_never_restore_v4_edits() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            not StudioSessionLocatePolicy::restore_admitted(true, true, comparison) and StudioSessionLocatePolicy::action_enabled(true, true, comparison, StudioSessionLocatePolicy::Choice.OpenAsNewTake)

        def changed_animation_never_restores_v4_edits() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedAnimation
            not StudioSessionLocatePolicy::restore_admitted(true, true, comparison) and StudioSessionLocatePolicy::resolve(true, true, true, comparison, StudioSessionLocatePolicy::Choice.OpenAsNewTake) == StudioSessionLocatePolicy::Resolution.OpenTakeWithoutSession

        def changed_shape_never_restores_v4_edits() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedShape
            not StudioSessionLocatePolicy::restore_admitted(true, true, comparison) and StudioSessionLocatePolicy::resolve(true, true, true, comparison, StudioSessionLocatePolicy::Choice.OpenAsNewTake) == StudioSessionLocatePolicy::Resolution.OpenTakeWithoutSession

        def invalid_candidate_never_locates_or_opens() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            not StudioSessionLocatePolicy::action_enabled(false, true, comparison, StudioSessionLocatePolicy::Choice.Locate) and StudioSessionLocatePolicy::resolve(true, false, true, comparison, StudioSessionLocatePolicy::Choice.OpenAsNewTake) == StudioSessionLocatePolicy::Resolution.NoAction

        def invalid_candidate_still_allows_cancel() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            StudioSessionLocatePolicy::action_enabled(false, false, comparison, StudioSessionLocatePolicy::Choice.Cancel) and StudioSessionLocatePolicy::resolve(true, false, false, comparison, StudioSessionLocatePolicy::Choice.Cancel) == StudioSessionLocatePolicy::Resolution.Cancelled

        def focus_skips_disabled_controls_and_reaches_cancel() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            StudioSessionLocatePolicy::move_focus(StudioSessionLocatePolicy::Focus.Locate, 1, false, false, comparison) == StudioSessionLocatePolicy::Focus.Cancel

        def no_source_never_opens_as_take() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            not StudioSessionLocatePolicy::action_enabled(true, false, comparison, StudioSessionLocatePolicy::Choice.OpenAsNewTake) and StudioSessionLocatePolicy::resolve(true, true, false, comparison, StudioSessionLocatePolicy::Choice.OpenAsNewTake) == StudioSessionLocatePolicy::Resolution.NoAction

        def closed_review_has_no_resolution(choice: StudioSessionLocatePolicy::Choice) -> bool:
            requires choice == StudioSessionLocatePolicy::Choice.None or choice == StudioSessionLocatePolicy::Choice.Locate or choice == StudioSessionLocatePolicy::Choice.OpenAsNewTake or choice == StudioSessionLocatePolicy::Choice.RestoreSession or choice == StudioSessionLocatePolicy::Choice.Cancel
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            StudioSessionLocatePolicy::resolve(false, true, true, comparison, choice) == StudioSessionLocatePolicy::Resolution.NoAction

        def cancel_preserves_current_source() -> bool:
            ensure result
            comparison: StudioSessionSourcePolicy::Comparison = StudioSessionSourcePolicy::Comparison.ChangedBytes
            StudioSessionLocatePolicy::resolve(true, true, true, comparison, StudioSessionLocatePolicy::Choice.Cancel) == StudioSessionLocatePolicy::Resolution.Cancelled

        def valid_saved_identity_admitted() -> bool:
            ensure result
            StudioSessionLocatePolicy::identity_valid(1, 7, 0, 1, 1)

        def invalid_residues_rejected(first: i64, second: i64) -> bool:
            requires first < 0 or first >= StudioSourceFingerprint::Residue::FIRST_MODULUS or second < 0 or second >= StudioSourceFingerprint::Residue::SECOND_MODULUS
            ensure result
            not StudioSessionLocatePolicy::identity_valid(first, second, 0, 1, 1)

        def invalid_animation_or_shape_rejected(animation: i64, frames: i64, nodes: i64) -> bool:
            requires animation < 0 or frames < 1 or frames > StudioChrome::Frame::MAX_FRAMES or nodes < 1 or nodes > StudioChrome::Correction::MAX_NODES
            ensure result
            not StudioSessionLocatePolicy::identity_valid(1, 7, animation, frames, nodes)
