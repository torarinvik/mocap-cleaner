# Restore requires every independent trust and interaction gate.
include "../src/studio/storage_restore_policy.elisa"

module StudioStorageRestorePolicyLaws:
    public:
        def eligible_state_is_in_trash(state: i64, receipt_valid: bool,
                                       durable: bool, identity_verified: bool,
                                       selected: bool, operation_active: bool) -> bool:
            requires StudioStorageRestorePolicy::eligible(state, receipt_valid, durable, identity_verified, selected, operation_active)
            ensure state == StudioStorageRestorePolicy::IN_TRASH
            state == StudioStorageRestorePolicy::IN_TRASH

        def invalid_receipt_is_rejected(state: i64, durable: bool,
                                        identity_verified: bool, selected: bool,
                                        operation_active: bool) -> bool:
            ensure not result
            StudioStorageRestorePolicy::eligible(state, false, durable, identity_verified, selected, operation_active)

        def nondurable_receipt_is_rejected(state: i64, receipt_valid: bool,
                                           identity_verified: bool, selected: bool,
                                           operation_active: bool) -> bool:
            ensure not result
            StudioStorageRestorePolicy::eligible(state, receipt_valid, false, identity_verified, selected, operation_active)

        def unverified_identity_is_rejected(state: i64, receipt_valid: bool,
                                            durable: bool, selected: bool,
                                            operation_active: bool) -> bool:
            ensure not result
            StudioStorageRestorePolicy::eligible(state, receipt_valid, durable, false, selected, operation_active)

        def stale_selection_is_rejected(state: i64, receipt_valid: bool,
                                        durable: bool, identity_verified: bool,
                                        operation_active: bool) -> bool:
            ensure not result
            StudioStorageRestorePolicy::eligible(state, receipt_valid, durable, identity_verified, false, operation_active)

        def active_operation_is_rejected(state: i64, receipt_valid: bool,
                                         durable: bool, identity_verified: bool,
                                         selected: bool) -> bool:
            ensure not result
            StudioStorageRestorePolicy::eligible(state, receipt_valid, durable, identity_verified, selected, true)
