include "../src/studio/export_recovery_path_policy.elisa"

module StudioExportRecoveryPathLaws:
    public:

        def maximum_build_path_fits() -> bool:
            ensure result
            StudioExportRecoveryPathPolicy::build_path_admitted(StudioExportRecoveryPathPolicy::Capacity::MAX_BUILD_BYTES)

        def oversized_build_path_is_rejected() -> bool:
            ensure not result
            StudioExportRecoveryPathPolicy::build_path_admitted(StudioExportRecoveryPathPolicy::Capacity::MAX_BUILD_BYTES + 1)

        def empty_build_path_is_rejected() -> bool:
            ensure not result
            StudioExportRecoveryPathPolicy::build_path_admitted(0)

        def largest_child_path_fits() -> bool:
            ensure result
            StudioExportRecoveryPathPolicy::child_path_admitted(StudioExportRecoveryPathPolicy::Capacity::MAX_DIRECTORY_BYTES, StudioExportRecoveryPathPolicy::Capacity::LEAF_BYTES)

        def empty_leaf_is_rejected(directory_bytes: i64) -> bool:
            ensure not result
            StudioExportRecoveryPathPolicy::child_path_admitted(directory_bytes, 0)

        def oversized_leaf_is_rejected(directory_bytes: i64) -> bool:
            ensure not result
            StudioExportRecoveryPathPolicy::child_path_admitted(directory_bytes, StudioExportRecoveryPathPolicy::Capacity::LEAF_BYTES + 1)
