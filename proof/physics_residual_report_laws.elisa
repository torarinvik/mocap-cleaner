include "../src/physics/rig_physics.elisa"

module PhysicsResidualReportLaws:
    public:
        def admitted_sum_preserves_units(current: i64, addition: i64) -> bool:
            requires current >= 0
            requires addition >= 0
            requires PhysicsLengthBoundary::report_sum_admitted(current, addition)
            ensure result
            mutable before: i64 = current
            mutable after: i64 = 0
            mutable available: bool = true
            Physics::accumulate_residual(&before, &after, &available, addition, true)
            available and before == current + addition and after == 0

        def overflowing_sum_becomes_explicitly_unavailable() -> bool:
            ensure result
            mutable before: i64 = 5
            mutable after: i64 = LengthUnits::Scale::MAX_EXPORT_UNITS
            mutable available: bool = true
            Physics::accumulate_residual(&before, &after, &available, 1, false)
            not available and before == 0 and after == 0

        def before_overflow_clears_both_sums_and_stays_cleared() -> bool:
            ensure result
            mutable before: i64 = LengthUnits::Scale::MAX_EXPORT_UNITS
            mutable after: i64 = 5
            mutable available: bool = true
            Physics::accumulate_residual(&before, &after, &available, 1, true)
            Physics::accumulate_residual(&before, &after, &available, 0, false)
            not available and before == 0 and after == 0

        def malformed_available_pair_is_cleared_before_addition() -> bool:
            ensure result
            mutable before: i64 = LengthUnits::Scale::MAX_EXPORT_UNITS + 1
            mutable after: i64 = 0
            mutable available: bool = true
            Physics::accumulate_residual(&before, &after, &available, 0, false)
            not available and before == 0 and after == 0

        def merging_unavailable_source_clears_partial_sum() -> bool:
            ensure result
            mutable before: i64 = 123
            mutable after: i64 = 456
            mutable available: bool = true
            Physics::merge_residual(&before, &after, &available, false, 0, true)
            not available and before == 0 and after == 0
