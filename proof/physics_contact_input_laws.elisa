include "../src/physics/contact_inputs.elisa"

module PhysicsContactInputLaws:
    public:
        def rejected_axis_refuses_point(p: MotionQuat::V) -> bool:
            requires not PhysicsLengthBoundary::world_admitted(p.x) or not PhysicsLengthBoundary::world_admitted(p.y) or not PhysicsLengthBoundary::world_admitted(p.z)
            ensure result
            not PhysicsContactInputs::point_admitted(p)

        def admitted_point_has_all_axes(p: MotionQuat::V) -> bool:
            requires PhysicsContactInputs::point_admitted(p)
            ensure result
            PhysicsLengthBoundary::world_admitted(p.x) and PhysicsLengthBoundary::world_admitted(p.y) and PhysicsLengthBoundary::world_admitted(p.z)

        def origin_admitted() -> bool:
            ensure result
            PhysicsContactInputs::point_admitted(Rig::v(0.0, 0.0, 0.0))

        def invalid_frame_domain_refused(c: Rig::Clip&, length: f64) -> bool:
            requires c.frames < 1 or c.times.count.i64() != c.frames
            ensure result
            not PhysicsContactInputs::admitted(c, length)
