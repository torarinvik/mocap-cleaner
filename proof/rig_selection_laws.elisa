include "../src/ops/rig_schema.elisa"

module RigSelectionLaws:
    public:
        def all_selector_retains_sentinel() -> bool:
            ensure result
            RigOps::Selection::ALL == -1

        def foot_lock_selects_all() -> bool:
            ensure result
            op: RigOps::RigOp = RigOps::foot_lock(4)
            return op.role == RigOps::Selection::ALL

        def foot_pivot_selects_all() -> bool:
            ensure result
            op: RigOps::RigOp = RigOps::foot_pivot(6)
            return op.role == RigOps::Selection::ALL
