include "../src/studio/state/generation_restore_selection_policy.elisa"

module StudioGenerationRestoreSelectionLaws:
    public:
        def active_task_retains_identity(reply: bool) -> bool:
            ensure not result
            StudioGenerationRestoreSelectionPolicy::may_clear(true, reply)

        def retained_reply_retains_identity(active: bool) -> bool:
            ensure not result
            StudioGenerationRestoreSelectionPolicy::may_clear(active, true)

        def unowned_selection_can_clear() -> bool:
            ensure result
            StudioGenerationRestoreSelectionPolicy::may_clear(false, false)
