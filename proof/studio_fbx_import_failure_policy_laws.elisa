include "../src/studio/fbx_import_failure_policy.elisa"

module StudioFbxImportFailurePolicyLaws:
    public:
        def converter_refusals_are_distinct():
            assert StudioFbxImportFailurePolicy::classify(-3) == StudioFbxImportFailurePolicy::Kind.Memory
            assert StudioFbxImportFailurePolicy::classify(-4) == StudioFbxImportFailurePolicy::Kind.CacheWrite
            assert StudioFbxImportFailurePolicy::classify(-5) == StudioFbxImportFailurePolicy::Kind.NonFinite
            assert StudioFbxImportFailurePolicy::classify(-6) == StudioFbxImportFailurePolicy::Kind.UnsupportedSkin

        def shared_stage_load_code_is_general():
            assert StudioFbxImportFailurePolicy::classify(-1) == StudioFbxImportFailurePolicy::Kind.General

        def unknown_is_general(status: i64):
            requires status != -3 and status != -4 and status != -5 and status != -6
            requires status != -100 and status != -101 and status != -102 and status != -103
            assert StudioFbxImportFailurePolicy::classify(status) == StudioFbxImportFailurePolicy::Kind.General

        def invalid_request_is_distinct():
            assert StudioFbxImportFailurePolicy::classify(StudioFbxImportWorker::Status.InvalidJob.i64()) == StudioFbxImportFailurePolicy::Kind.InvalidRequest

        def unreadable_animation_is_distinct():
            assert StudioFbxImportFailurePolicy::classify(StudioFbxImportWorker::Status.UnreadableAnimation.i64()) == StudioFbxImportFailurePolicy::Kind.UnreadableAnimation

        def changed_source_is_distinct():
            assert StudioFbxImportFailurePolicy::classify(StudioFbxImportWorker::Status.SourceChanged.i64()) == StudioFbxImportFailurePolicy::Kind.SourceChanged

        def digest_failure_is_distinct():
            assert StudioFbxImportFailurePolicy::classify(StudioFbxImportWorker::Status.DigestUnavailable.i64()) == StudioFbxImportFailurePolicy::Kind.DigestUnavailable

        def worker_wire_codes_are_preserved():
            assert StudioFbxImportWorker::Status.InvalidJob.i64() == -100
            assert StudioFbxImportWorker::Status.UnreadableAnimation.i64() == -101
            assert StudioFbxImportWorker::Status.SourceChanged.i64() == -102
            assert StudioFbxImportWorker::Status.DigestUnavailable.i64() == -103
