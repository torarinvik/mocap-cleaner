include "../src/studio/export_recovery_capacity_policy.elisa"

module StudioExportRecoveryCapacityLaws:
    public:
        def unknown_inventory_is_rejected(records: i64, retained: i64, held: i64, requested: i64) -> bool:
            ensure not result
            StudioExportRecoveryCapacityPolicy::reservation_admitted(false, records, retained, held, requested)

        def full_record_inventory_is_rejected(retained: i64, held: i64, requested: i64) -> bool:
            ensure not result
            StudioExportRecoveryCapacityPolicy::reservation_admitted(true, 16, retained, held, requested)

        def empty_inventory_can_reserve_one_byte() -> bool:
            ensure result
            StudioExportRecoveryCapacityPolicy::reservation_admitted(true, 0, 0, 0, 1)

        def exact_total_limit_is_admitted() -> bool:
            ensure result
            StudioExportRecoveryCapacityPolicy::reservation_admitted(true, 15, 1073741823, 0, 1)

        def held_reservation_is_counted() -> bool:
            ensure not result
            StudioExportRecoveryCapacityPolicy::reservation_admitted(true, 0, 1073741823, 1, 1)

        def exhausted_byte_inventory_is_rejected() -> bool:
            ensure not result
            StudioExportRecoveryCapacityPolicy::reservation_admitted(true, 0, 1073741824, 0, 1)

        def maximum_payloads_have_bounded_request() -> i64:
            ensure result == 138543104
            StudioExportRecoveryCapacityPolicy::requested_bytes(67108864, 1048576, 1048576, 65536)

        def minimum_payloads_reserve_two_copies() -> i64:
            ensure result == 8
            StudioExportRecoveryCapacityPolicy::requested_bytes(1, 1, 1, 1)
