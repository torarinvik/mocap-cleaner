# Inserting a selected-operation duplicate keeps stack order and bounds exact.
include "../src/studio/operation_duplicate_policy.elisa"

module StudioDuplicateOperationLaws:
    public:
        def duplicate_lands_immediately_after_source(at: i64, count: i64) -> bool:
            requires count >= 1 and count < StudioOperationDuplicatePolicy::MAX_OPS
            requires at >= 0 and at < count
            target: i64 = StudioOperationDuplicatePolicy::target(at, count)
            target == at + 1 and target < count + 1

        def duplicate_slot_reads_selected_source(at: i64, count: i64) -> bool:
            requires count >= 1 and count < StudioOperationDuplicatePolicy::MAX_OPS
            requires at >= 0 and at < count
            inserted: i64 = StudioOperationDuplicatePolicy::target(at, count)
            StudioOperationDuplicatePolicy::source(inserted, at, count) == at

        def prefix_keeps_its_indices(at: i64, count: i64, i: i64) -> bool:
            requires count >= 1 and count < StudioOperationDuplicatePolicy::MAX_OPS
            requires at >= 0 and at < count
            requires i >= 0 and i <= at
            StudioOperationDuplicatePolicy::source(i, at, count) == i

        def suffix_shifts_one_slot(at: i64, count: i64, i: i64) -> bool:
            requires count >= 1 and count < StudioOperationDuplicatePolicy::MAX_OPS
            requires at >= 0 and at < count
            requires i > at + 1 and i <= count
            StudioOperationDuplicatePolicy::source(i, at, count) == i - 1

        def every_new_slot_has_a_valid_source(at: i64, count: i64, i: i64) -> bool:
            requires count >= 1 and count < StudioOperationDuplicatePolicy::MAX_OPS
            requires at >= 0 and at < count
            requires i >= 0 and i <= count
            source: i64 = StudioOperationDuplicatePolicy::source(i, at, count)
            source >= 0 and source < count
