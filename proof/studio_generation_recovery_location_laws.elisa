include "../src/studio/state/generation_recovery_location_policy.elisa"

module StudioGenerationRecoveryLocationLaws:
    public:
        def stale_observation_cannot_reveal(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                            location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires not selection.observation_current
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.Disabled

        def mismatched_root_cannot_reveal(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                          location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires not selection.root_matches_selection
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.Disabled

        def mismatched_operation_cannot_reveal(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                               location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires not selection.operation_matches_selection
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.Disabled

        def exact_artifact_reveals_its_folder(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                               location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::valid_selection(selection)
            requires location.state == StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact
            requires location.entry_identity_verified and location.parent_identity_verified and location.artifact_path_valid
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.ShowArtifactFolder

        def absent_entry_never_reveals(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                        location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::valid_selection(selection)
            requires location.state == StudioGenerationRecoveryLocationPolicy::EntryState.Absent
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.Disabled

        def inconsistent_location_facts_never_reveal(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                                       location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::valid_selection(selection)
            requires not StudioGenerationRecoveryLocationPolicy::location_valid(location)
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.Disabled

        def unsafe_or_unknown_entry_never_reveals(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                                   location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::valid_selection(selection)
            requires location.state == StudioGenerationRecoveryLocationPolicy::EntryState.Unsafe or location.state == StudioGenerationRecoveryLocationPolicy::EntryState.Unknown
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.Disabled

        def other_original_occupant_is_distinct_folder_action(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                                               location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::valid_selection(selection)
            requires location.state == StudioGenerationRecoveryLocationPolicy::EntryState.DifferentOccupant
            requires not location.entry_identity_verified and location.parent_identity_verified and location.parent_path_valid
            ensure result
            StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.ShowConflictFolder

        def conflict_folder_action_does_not_claim_artifact(selection: StudioGenerationRecoveryLocationPolicy::SelectedEvidence,
                                                             location: StudioGenerationRecoveryLocationPolicy::LocationEvidence) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::reveal_action(selection, location) == StudioGenerationRecoveryLocationPolicy::RevealAction.ShowConflictFolder
            ensure result
            location.state == StudioGenerationRecoveryLocationPolicy::EntryState.DifferentOccupant and not location.entry_identity_verified

        def quarantined_summary_requires_absent_original_and_exact_quarantine(original: StudioGenerationRecoveryLocationPolicy::EntryState,
                                                                               quarantine: StudioGenerationRecoveryLocationPolicy::EntryState) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::summary(original, quarantine) == StudioGenerationRecoveryLocationPolicy::Summary.Quarantined
            ensure result
            original == StudioGenerationRecoveryLocationPolicy::EntryState.Absent and quarantine == StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact

        def original_name_collision_is_reported_separately(original: StudioGenerationRecoveryLocationPolicy::EntryState,
                                                             quarantine: StudioGenerationRecoveryLocationPolicy::EntryState) -> bool:
            requires StudioGenerationRecoveryLocationPolicy::summary(original, quarantine) == StudioGenerationRecoveryLocationPolicy::Summary.OriginalNameOccupied
            ensure result
            original == StudioGenerationRecoveryLocationPolicy::EntryState.DifferentOccupant and quarantine == StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact

        def unverified_locations_remain_unresolved(original: StudioGenerationRecoveryLocationPolicy::EntryState,
                                                    quarantine: StudioGenerationRecoveryLocationPolicy::EntryState) -> bool:
            requires original != StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact or quarantine != StudioGenerationRecoveryLocationPolicy::EntryState.Absent
            requires original != StudioGenerationRecoveryLocationPolicy::EntryState.Absent or quarantine != StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact
            requires original != StudioGenerationRecoveryLocationPolicy::EntryState.DifferentOccupant or quarantine != StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact
            requires original != StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact or quarantine != StudioGenerationRecoveryLocationPolicy::EntryState.ExactArtifact
            requires original != StudioGenerationRecoveryLocationPolicy::EntryState.Absent or quarantine != StudioGenerationRecoveryLocationPolicy::EntryState.Absent
            ensure result
            StudioGenerationRecoveryLocationPolicy::summary(original, quarantine) == StudioGenerationRecoveryLocationPolicy::Summary.Unresolved
