include "../src/studio/storage_window_policy.elisa"
module StudioStorageWindowPolicyLaws:
    public:
        def final_window_is_bounded(count: i64, limit: i64) -> i64:
            requires count >= 1 and count <= 256
            requires limit >= 1 and limit <= count
            ensure result >= 0
            ensure result + limit <= count
            StudioStorageWindowPolicy::first_visible(count, limit, count - 1)
