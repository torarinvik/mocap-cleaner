include "../src/studio/storage_window_policy.elisa"
module StudioStorageWindowPolicyLaws:
    public:
        def final_window_is_bounded(count: i64, limit: i64) -> i64:
            requires count >= 1 and count <= 256
            requires limit >= 1 and limit <= count
            ensure result >= 0
            ensure result + limit <= count
            StudioStorageWindowPolicy::first_visible(count, limit, count - 1)

        def invalid_inventory_has_no_inspection(count: i64, selected: i64, forward: bool) -> bool:
            requires count < 1 or count > 256
            ensure result
            StudioStorageWindowPolicy::inspection_target(count, selected, forward) == -1

        def valid_inventory_inspection_stays_inside(count: i64, selected: i64, forward: bool) -> bool:
            requires count >= 1 and count <= 256
            ensure result
            target: i64 = StudioStorageWindowPolicy::inspection_target(count, selected, forward)
            target >= 0 and target < count

        def forward_step_advances_one(count: i64, selected: i64) -> bool:
            requires count >= 2 and count <= 256
            requires selected >= 0 and selected < count - 1
            ensure result
            StudioStorageWindowPolicy::next_inspection(count, selected) == selected + 1

        def backward_step_returns_one(count: i64, selected: i64) -> bool:
            requires count >= 2 and count <= 256
            requires selected > 0 and selected < count
            ensure result
            StudioStorageWindowPolicy::previous_inspection(count, selected) == selected - 1
