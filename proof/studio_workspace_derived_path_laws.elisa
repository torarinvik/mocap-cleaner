include "../src/studio/workspace_derived_path_policy.elisa"

module StudioWorkspaceDerivedPathLaws:
    public:
        def final_terminator_fits_without_root_slash() -> bool:
            ensure result
            StudioWorkspaceDerivedPathPolicy::admitted(3834, 254, false, true)

        def one_byte_over_capacity_refuses() -> bool:
            ensure result
            not StudioWorkspaceDerivedPathPolicy::admitted(3835, 254, false, true)

        def existing_root_slash_recovers_one_byte() -> bool:
            ensure result
            StudioWorkspaceDerivedPathPolicy::admitted(3835, 254, true, true)

        def invalid_leaf_refuses_before_publication() -> bool:
            ensure result
            not StudioWorkspaceDerivedPathPolicy::admitted(32, 4, false, false)

        def empty_and_oversize_inputs_refuse() -> bool:
            ensure result
            not StudioWorkspaceDerivedPathPolicy::admitted(0, 1, false, true) and
                not StudioWorkspaceDerivedPathPolicy::admitted(4096, 1, true, true) and
                not StudioWorkspaceDerivedPathPolicy::admitted(32, 0, false, true) and
                not StudioWorkspaceDerivedPathPolicy::admitted(32, 255, false, true)
