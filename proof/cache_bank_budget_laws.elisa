include "../src/core/cache_bank_budget_policy.elisa"

module CacheBankBudgetLaws:
    public:
        def exact_limit_is_admitted() -> bool:
            ensure result
            CacheBankBudgetPolicy::admits(0, CacheBankBudgetPolicy::Limit::MAX_LOGICAL_BYTES)

        def one_over_limit_is_refused() -> bool:
            ensure result
            not CacheBankBudgetPolicy::admits(CacheBankBudgetPolicy::Limit::MAX_LOGICAL_BYTES, 1)

        def negative_accounting_is_refused() -> bool:
            ensure result
            not CacheBankBudgetPolicy::admits(-1, 0) and not CacheBankBudgetPolicy::admits(0, -1)

        def integer_limit_cannot_wrap_into_admission() -> bool:
            ensure result
            not CacheBankBudgetPolicy::admits(9223372036854775807, 1)

        def refused_accumulation_preserves_sentinel() -> bool:
            ensure result
            CacheBankBudgetPolicy::accumulate(-1, 0) == -1
