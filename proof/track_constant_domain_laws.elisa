include "../src/tools/track.elisa"

module TrackConstantDomainLaws:
    public:
        def public_bound_retains_value() -> bool:
            ensure result
            Track::Domain::LIMIT == 1000000000

        def zero_weight_preserves_source(source: i64, fixed: i64) -> bool:
            ensure result
            Track::blend(source, fixed, 0) == source

        def full_weight_preserves_target(source: i64, fixed: i64) -> bool:
            ensure result
            Track::blend(source, fixed, Fade::Domain::FULL_PERMILLE) == fixed
