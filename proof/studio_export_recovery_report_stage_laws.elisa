include "../src/studio/export_recovery_stage_policy.elisa"

module StudioExportRecoveryReportStageLaws:
    public:
        def json_after_glb() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(1, true) == 3

        def text_after_glb() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(1, false) == 5

        def text_completes_json() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(3, false) == 7

        def json_completes_text() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(5, true) == 7

        def complete_stays_complete(json: bool) -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(7, json) == 7

        def repeat_preserves_json() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(3, true) == 3

        def repeat_preserves_text() -> bool:
            ensure result
            StudioExportRecoveryStagePolicy::with_report(5, false) == 5
