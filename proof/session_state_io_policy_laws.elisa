include "../src/studio/session_state_io_policy.elisa"

module SessionStateIoPolicyLaws:
    def valid_path_lengths_are_bounded() -> void:
        assert not SessionStateIoPolicy::destination_length_valid(0, 4096)
        assert SessionStateIoPolicy::destination_length_valid(1, 4096)
        assert SessionStateIoPolicy::destination_length_valid(4095, 4096)
        assert not SessionStateIoPolicy::destination_length_valid(4096, 4096)
        assert not SessionStateIoPolicy::destination_length_valid(-1, 4096)
