include "../src/studio/export_batch_display_projection.elisa"

module StudioExportBatchDisplayProjectionLaws:
    public:
        def source_and_destination_paths_are_exact(source: darray[u8], output: darray[u8]) -> bool:
            ensure result
            StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDisplayProjection::copy_bytes(source), source) and StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDisplayProjection::copy_bytes(output), output)

        def warning_report_bytes_are_exact(json_bytes: darray[u8], text_bytes: darray[u8]) -> bool:
            ensure result
            StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDisplayProjection::copy_bytes(json_bytes), json_bytes) and StudioExportBatchDisplayProjection::bytes_equal(StudioExportBatchDisplayProjection::copy_bytes(text_bytes), text_bytes)

