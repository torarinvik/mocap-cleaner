# Common-rig role laws: mirroring is an involution that keeps a joint's mask
# group, and a hinge's chain (upper, hinge, end) is consecutive.
include "../src/core/roles.elisa"

module RolesLaws:
    public:
        def group_bit_positions_retained() -> bool:
            ensure result
            Roles::Group.Other.i64() == 0 and Roles::Group.Leg.i64() == 1 and Roles::Group.Arm.i64() == 2

        # Mirroring twice gives the same limb or centre role back. (Roll
        # bones 22..25 swap in pairs too; their goals fold to literals, gap G22.)
        def mirror_involution(role: i64) -> i64:
            requires role >= 0
            requires role < 22
            ensure result == role
            once: i64 = Roles::role_mirror(role)
            if role <= 5:
                return once
            if role <= 9:
                return once - 4
            if role <= 13:
                return once + 4
            if role <= 17:
                return once - 4
            return once + 4

        # Centre joints (hips to head) mirror to themselves.
        def centre_is_fixed(role: i64) -> i64:
            requires role >= 0
            requires role <= 5
            ensure result == role
            return Roles::role_mirror(role)

        # A mirrored joint is still a valid role.
        def mirror_stays_valid(role: i64) -> bool:
            requires role >= 0
            requires role < 26
            ensure result
            return Roles::role_valid(Roles::role_mirror(role))

        # Centre joints are in the "other" mask group.
        def centre_group_other(role: i64) -> i64:
            requires role >= 0
            requires role <= 5
            ensure result == 0
            return Roles::role_group(role)

        # The pin chain of an effector is its hinge's chain: the hinge's end
        # is the effector again.
        def effector_chain_closes(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result == -1 or result == role
            hinge: i64 = Roles::effector_hinge(role)
            if hinge < 0:
                return -1
            return hinge + 1

        def unmapped_joint_preserves_sentinel() -> bool:
            ensure result
            Roles::Joint.None.i64() == -1 and Roles::Capacity::COUNT == 26

        def joint_codes_preserved() -> bool:
            ensure result
            (Roles::Joint.Hips.i64() == 0 and Roles::Joint.Spine.i64() == 1 and Roles::Joint.Spine1.i64() == 2 and Roles::Joint.Spine2.i64() == 3 and Roles::Joint.Neck.i64() == 4 and Roles::Joint.Head.i64() == 5 and Roles::Joint.LeftShoulder.i64() == 6 and Roles::Joint.LeftArm.i64() == 7 and Roles::Joint.LeftForearm.i64() == 8 and Roles::Joint.LeftHand.i64() == 9 and Roles::Joint.RightShoulder.i64() == 10 and Roles::Joint.RightArm.i64() == 11 and Roles::Joint.RightForearm.i64() == 12 and Roles::Joint.RightHand.i64() == 13 and Roles::Joint.LeftUpleg.i64() == 14 and Roles::Joint.LeftLeg.i64() == 15 and Roles::Joint.LeftFoot.i64() == 16 and Roles::Joint.LeftToe.i64() == 17 and Roles::Joint.RightUpleg.i64() == 18 and Roles::Joint.RightLeg.i64() == 19 and Roles::Joint.RightFoot.i64() == 20 and Roles::Joint.RightToe.i64() == 21 and Roles::Joint.LeftForearmRoll.i64() == 22 and Roles::Joint.RightForearmRoll.i64() == 23 and Roles::Joint.LeftLegRoll.i64() == 24 and Roles::Joint.RightLegRoll.i64() == 25)
