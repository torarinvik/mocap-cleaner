include "../src/studio/state/generation_recovery_ledger.elisa"

module StudioGenerationRecoveryLedgerStorageLaws:
    public:
        def negative_index_has_no_identity(index: i64) -> bool can Memory.Allocate:
            requires index < 0
            ensure result
            ledger: StudioGenerationRecoveryLedger::Ledger = StudioGenerationRecoveryLedger::empty()
            StudioGenerationRecoveryLedger::read(ledger, index) == null

        def empty_index_has_no_identity(index: i64) -> bool can Memory.Allocate:
            requires index >= 0
            ensure result
            ledger: StudioGenerationRecoveryLedger::Ledger = StudioGenerationRecoveryLedger::empty()
            StudioGenerationRecoveryLedger::read(ledger, index) == null

        def empty_has_no_records() -> bool:
            ensure result
            ledger: StudioGenerationRecoveryLedger::Ledger = StudioGenerationRecoveryLedger::empty()
            StudioGenerationRecoveryLedger::count(ledger) == 0

        def empty_lookup_is_absent(root: darray[u8]&, operation: darray[u8]&) -> bool:
            ensure result
            ledger: StudioGenerationRecoveryLedger::Ledger = StudioGenerationRecoveryLedger::empty()
            StudioGenerationRecoveryLedger::find(ledger, root, operation) == -1

        def first_valid_identity_is_retained(root: darray[u8]&, operation: darray[u8]&) -> bool can Memory.Allocate:
            requires StudioGenerationRecoveryLedgerPolicy::valid_bytes(root, StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES) and StudioGenerationOperationIdentityPolicy::valid(operation)
            ensure result
            mutable ledger: StudioGenerationRecoveryLedger::Ledger = StudioGenerationRecoveryLedger::empty()
            outcome: StudioGenerationRecoveryLedgerPolicy::Admission = StudioGenerationRecoveryLedger::record(&ledger, root, operation)
            outcome == StudioGenerationRecoveryLedgerPolicy::Admission.Accepted and StudioGenerationRecoveryLedger::count(ledger) == 1 and StudioGenerationRecoveryLedger::find(ledger, root, operation) == 0

        def duplicate_does_not_grow(root: darray[u8]&, operation: darray[u8]&) -> bool can Memory.Allocate:
            requires StudioGenerationRecoveryLedgerPolicy::valid_bytes(root, StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES) and StudioGenerationOperationIdentityPolicy::valid(operation)
            ensure result
            mutable ledger: StudioGenerationRecoveryLedger::Ledger = StudioGenerationRecoveryLedger::empty()
            first: StudioGenerationRecoveryLedgerPolicy::Admission = StudioGenerationRecoveryLedger::record(&ledger, root, operation)
            second: StudioGenerationRecoveryLedgerPolicy::Admission = StudioGenerationRecoveryLedger::record(&ledger, root, operation)
            first == StudioGenerationRecoveryLedgerPolicy::Admission.Accepted and second == StudioGenerationRecoveryLedgerPolicy::Admission.Duplicate and StudioGenerationRecoveryLedger::count(ledger) == 1
