include "../src/studio/export_batch_recovery_capacity_policy.elisa"

module StudioExportBatchRecoveryCapacityLaws:
    public:
        def maximum_item_reservation_is_bounded() -> bool:
            ensure result
            bytes: i64 = StudioExportBatchRecoveryCapacityPolicy::requested_bytes(67108864, 1048576, 1048576, 1048576, 65536)
            bytes == 142737408 and bytes <= 142737408

        def unknown_inventory_blocks_batch_recovery() -> bool:
            ensure result
            not StudioExportBatchRecoveryCapacityPolicy::reservation_admitted(false, 0, 0, 1)

        def exhausted_record_slots_block_enqueue() -> bool:
            ensure result
            not StudioExportBatchRecoveryCapacityPolicy::reservation_admitted(true, StudioExportBatchRecoveryCapacityPolicy::MAX_DURABLE_ITEMS, 0, 1)

        def retained_bytes_bound_batch_reservations() -> bool:
            ensure result
            not StudioExportBatchRecoveryCapacityPolicy::reservation_admitted(true, 0, StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES, 1)
