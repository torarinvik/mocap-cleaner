include "../src/studio/state/generation_move_confirmation_policy.elisa"

module StudioGenerationMoveConfirmationLaws:
    public:
        def stale_completion_cannot_publish(key: StudioGenerationMoveConfirmationPolicy::ReviewKey, active: i64, completed: i64) -> bool:
            requires active != completed
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(StudioGenerationMoveConfirmationPolicy::State.Running(key: key, job_ticket: active), completed, true, true, 0)

        def invalid_review_cannot_publish(key: StudioGenerationMoveConfirmationPolicy::ReviewKey, ticket: i64) -> bool:
            requires not StudioGenerationMoveConfirmationPolicy::key_valid(key)
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(StudioGenerationMoveConfirmationPolicy::State.Running(key: key, job_ticket: ticket), ticket, true, true, 0)

        def nonpositive_completion_cannot_publish(state: StudioGenerationMoveConfirmationPolicy::State, ticket: i64) -> bool:
            requires ticket <= 0
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(state, ticket, true, true, 0)

        def unresolved_completion_cannot_publish(state: StudioGenerationMoveConfirmationPolicy::State, ticket: i64) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(state, ticket, false, true, 0)

        def confirmed_current_review_can_start(key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            requires StudioGenerationMoveConfirmationPolicy::key_valid(key)
            ensure result
            StudioGenerationMoveConfirmationPolicy::may_start(StudioGenerationMoveConfirmationPolicy::State.Confirmed(key: key), key, true, true, false)

        def verified_recorded_completion_can_publish(key: StudioGenerationMoveConfirmationPolicy::ReviewKey, ticket: i64) -> bool:
            requires StudioGenerationMoveConfirmationPolicy::key_valid(key) and ticket > 0
            ensure result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(StudioGenerationMoveConfirmationPolicy::State.Running(key: key, job_ticket: ticket), ticket, true, true, 0)

        def cancellation_drops_undispatched_approval(key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(StudioGenerationMoveConfirmationPolicy::cancel(StudioGenerationMoveConfirmationPolicy::State.Confirmed(key: key)), key, true, true, false)

        def first_review_does_not_start(key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(StudioGenerationMoveConfirmationPolicy::State.Reviewing(key: key), key, true, true, false)

        def unchanged_review_can_confirm(key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            requires StudioGenerationMoveConfirmationPolicy::key_valid(key)
            ensure result
            StudioGenerationMoveConfirmationPolicy::may_confirm(StudioGenerationMoveConfirmationPolicy::State.Reviewing(key: key), key, true, true, false)

        def changed_scan_refuses_confirmation(reviewed: StudioGenerationMoveConfirmationPolicy::ReviewKey, current: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            requires reviewed.scan_ticket != current.scan_ticket
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_confirm(StudioGenerationMoveConfirmationPolicy::State.Reviewing(key: reviewed), current, true, true, false)

        def changed_selection_refuses_start(reviewed: StudioGenerationMoveConfirmationPolicy::ReviewKey, current: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            requires reviewed.row_index != current.row_index
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(StudioGenerationMoveConfirmationPolicy::State.Confirmed(key: reviewed), current, true, true, false)

        def changed_retention_refuses_start(reviewed: StudioGenerationMoveConfirmationPolicy::ReviewKey, current: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            requires reviewed.retention_days != current.retention_days
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(StudioGenerationMoveConfirmationPolicy::State.Confirmed(key: reviewed), current, true, true, false)

        def protected_row_refuses_start(state: StudioGenerationMoveConfirmationPolicy::State, key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(state, key, false, true, false)

        def stale_source_refuses_start(state: StudioGenerationMoveConfirmationPolicy::State, key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(state, key, true, false, false)

        def duplicate_activation_refused(state: StudioGenerationMoveConfirmationPolicy::State, key: StudioGenerationMoveConfirmationPolicy::ReviewKey) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_start(state, key, true, true, true)

        def cancellation_preserves_running_ticket(key: StudioGenerationMoveConfirmationPolicy::ReviewKey, ticket: i64) -> bool:
            ensure result
            StudioGenerationMoveConfirmationPolicy::active_ticket(StudioGenerationMoveConfirmationPolicy::cancel(StudioGenerationMoveConfirmationPolicy::State.Running(key: key, job_ticket: ticket))) == ticket

        def draining_reply_suppresses_publication(key: StudioGenerationMoveConfirmationPolicy::ReviewKey, ticket: i64) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(StudioGenerationMoveConfirmationPolicy::State.Draining(key: key, job_ticket: ticket), ticket, true, true, 0)

        def missing_recovery_record_refuses_success(state: StudioGenerationMoveConfirmationPolicy::State, ticket: i64) -> bool:
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(state, ticket, true, false, 0)

        def retained_handle_refuses_success(state: StudioGenerationMoveConfirmationPolicy::State, ticket: i64, handle: i64) -> bool:
            requires handle != 0
            ensure not result
            StudioGenerationMoveConfirmationPolicy::may_publish_success(state, ticket, true, true, handle)
