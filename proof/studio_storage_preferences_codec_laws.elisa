include "../src/studio/io/storage_preferences_codec.elisa"

module StudioStoragePreferencesCodecLaws:
    public:
        def record_fits_reader_bound() -> bool:
            ensure result
            StudioStoragePreferencesCodec::Wire::FILE_BYTES == 48 and StudioStoragePreferencesCodec::Wire::FILE_BYTES <= StudioStoragePreferencesCodec::Wire::MAX_FILE_BYTES and StudioStoragePreferencesCodec::Wire::MAX_FILE_BYTES == 128

