include "../src/studio/native_path_bytes.elisa"

module StudioNativePathBytesLaws:
    public:
        def unterminated_prefix_is_refused(count: usize) -> bool:
            ensure not result
            StudioNativePathBytes::scanned_extent_admitted(count, false)

        def maximum_complete_path_is_admitted() -> bool:
            ensure result
            StudioNativePathBytes::scanned_extent_admitted(StudioExportBatchIdentity::Limit::MAX_PATH_BYTES, true)

        def oversized_scan_is_refused(count: usize) -> bool:
            requires count > StudioExportBatchIdentity::Limit::MAX_PATH_BYTES
            ensure not result
            StudioNativePathBytes::scanned_extent_admitted(count, true)

        def rejected_path_has_no_native_storage(bytes: darray[u8]&) -> bool:
            requires not StudioNativePathBytes::admitted(bytes)
            ensure result
            StudioNativePathBytes::terminated(bytes).count == 0

        def admitted_path_has_exact_capacity(bytes: darray[u8]&) -> bool:
            requires StudioNativePathBytes::admitted(bytes)
            ensure result
            StudioNativePathBytes::terminated(bytes).count == bytes.count + 1

        def admitted_path_is_terminated(bytes: darray[u8]&) -> bool:
            requires StudioNativePathBytes::admitted(bytes)
            ensure result
            storage: darray[u8] = StudioNativePathBytes::terminated(bytes)
            storage[bytes.count] == 0

        def admitted_path_preserves_byte(bytes: darray[u8]&, index: usize) -> bool:
            requires StudioNativePathBytes::admitted(bytes)
            requires index < bytes.count
            ensure result
            storage: darray[u8] = StudioNativePathBytes::terminated(bytes)
            storage[index] == bytes[index]
