# Boolean selection gate and stale-selection laws.
include "../src/studio/storage_selection_policy.elisa"

module StudioStorageSelectionPolicyLaws:
    public:
        def selection_gate_excludes_recovery(eligible: bool) -> bool:
            ensure not result
            false

        def selection_gate_preserves_eligible(eligible: bool) -> bool:
            ensure result == eligible
            eligible and not false

        def stale_selection_requires_selected_and_unsafe(selected: bool, eligible: bool, recovery_required: bool) -> bool:
            ensure result == (selected and (not eligible or recovery_required))
            selected and (not eligible or recovery_required)
