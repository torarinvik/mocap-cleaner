include "../src/studio/state/generation_handle_policy.elisa"

module StudioGenerationHandleLaws:
    public:
        def successful_close_consumes(handle: i64) -> i64:
            requires handle >= 0
            ensure result == 0
            StudioGenerationHandlePolicy::remaining(handle, StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32()))

        def busy_close_retains(handle: i64) -> i64:
            requires handle >= 0
            ensure result == handle
            StudioGenerationHandlePolicy::remaining(handle, StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Busy.i32()))

        def stale_close_consumes(handle: i64) -> i64:
            requires handle >= 0
            ensure result == 0
            StudioGenerationHandlePolicy::remaining(handle, StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.StaleHandle.i32()))

        def uncertain_close_consumes(handle: i64) -> i64:
            requires handle >= 0
            ensure result == 0
            StudioGenerationHandlePolicy::remaining(handle, StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.ReleaseUncertain.i32()))

        def unknown_close_retains(handle: i64) -> i64:
            requires handle >= 0
            ensure result == handle
            StudioGenerationHandlePolicy::remaining(handle, StudioBuildGenerationTrashBindingPolicy::decode_status(-1))

        def uncertain_release_requires_recovery() -> bool:
            ensure not result
            StudioGenerationHandlePolicy::release_certain(StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.ReleaseUncertain.i32()))

        def unknown_release_requires_recovery() -> bool:
            ensure not result
            StudioGenerationHandlePolicy::release_certain(StudioBuildGenerationTrashBindingPolicy::decode_status(-1))
