include "../src/core/report_qualification.elisa"

module ReportQualificationLaws:
    public:
        def known_metadata_is_available() -> bool:
            ensure result
            ReportQualification::metadata_available(true, true, true)

        def unknown_schema_is_unavailable(units_known: bool, detectors_known: bool) -> bool:
            ensure not result
            ReportQualification::metadata_available(false, units_known, detectors_known)

        def unknown_units_are_unavailable(schema_known: bool, detectors_known: bool) -> bool:
            ensure not result
            ReportQualification::metadata_available(schema_known, false, detectors_known)

        def unknown_detectors_are_unavailable(schema_known: bool, units_known: bool) -> bool:
            ensure not result
            ReportQualification::metadata_available(schema_known, units_known, false)
