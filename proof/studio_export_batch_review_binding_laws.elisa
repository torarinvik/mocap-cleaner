include "../src/studio/export_batch_identity.elisa"
include "../src/studio/export_batch_queue_policy.elisa"
include "../src/studio/export_batch_review_binding.elisa"

module StudioExportBatchReviewBindingLaws:
    public:
        def byte_identity_rejects_length_difference(left: darray[u8], right: darray[u8]) -> bool:
            requires left.count != right.count
            ensure result
            not StudioExportBatchIdentity::bytes_equal(left, right)

        def byte_identity_rejects_changed_byte(left: darray[u8], right: darray[u8], index: usize) -> bool:
            requires left.count == right.count and index < left.count and left[index] != right[index]
            ensure result
            not StudioExportBatchIdentity::bytes_equal(left, right)

        def warnings_cannot_publish_without_explicit_review() -> bool:
            ensure result
            not StudioExportBatchQueuePolicy::may_publish(StudioExportBatchQueuePolicy::ItemState.AwaitingReview, false, true)

        def reviewed_publication_requires_create_only_facts() -> bool:
            ensure result
            not StudioExportBatchQueuePolicy::may_publish(StudioExportBatchQueuePolicy::ItemState.AwaitingReview, true, false)

        def partial_output_publication_is_not_passed() -> bool:
            ensure result
            StudioExportBatchQueuePolicy::publication_result(StudioExportBatchQueuePolicy::ItemState.AwaitingReview, false) == StudioExportBatchQueuePolicy::ItemState.Failed

        def stale_attempt_cannot_complete(claim_issued: bool, claim_attempt: i64,
                                          newer_attempt: i64, identity_matches: bool,
                                          running: bool) -> bool:
            requires claim_attempt != newer_attempt
            ensure result
            not StudioExportBatchReviewBinding::claim_admitted(claim_issued, claim_attempt, newer_attempt, identity_matches, running)

        def changed_claim_identity_cannot_complete(claim_issued: bool, attempt: i64,
                                                  running: bool) -> bool:
            ensure result
            not StudioExportBatchReviewBinding::claim_admitted(claim_issued, attempt, attempt, false, running)

        def nonrunning_item_rejects_worker_result(claim_issued: bool, attempt: i64,
                                                 identity_matches: bool) -> bool:
            ensure result
            not StudioExportBatchReviewBinding::claim_admitted(claim_issued, attempt, attempt, identity_matches, false)

        def staging_residue_does_not_erase_verified_outputs(receipt: StudioExportBatchReviewBinding::PublicationReceipt) -> bool:
            requires receipt.glb_bytes_verified and receipt.json_bytes_verified and receipt.text_bytes_verified
            ensure result
            StudioExportBatchReviewBinding::outputs_verified(receipt)

        def unverified_sidecar_keeps_publication_incomplete(receipt: StudioExportBatchReviewBinding::PublicationReceipt) -> bool:
            requires not receipt.json_bytes_verified or not receipt.text_bytes_verified
            ensure result
            not StudioExportBatchReviewBinding::outputs_verified(receipt)
