include "../src/studio/fbx_workspace_setup_policy.elisa"

module StudioFbxWorkspaceSetupPolicyLaws:
    def ready_workspace_resumes_only_pending_request() -> void:
        assert StudioFbxWorkspaceSetupPolicy::after_choice(true, StudioFbxWorkspaceSetupPolicy::Choice.Ready) == StudioFbxWorkspaceSetupPolicy::Next.StartImport
        assert StudioFbxWorkspaceSetupPolicy::after_choice(false, StudioFbxWorkspaceSetupPolicy::Choice.Ready) == StudioFbxWorkspaceSetupPolicy::Next.KeepPending

    def missing_build_waits_for_explicit_consent() -> void:
        assert StudioFbxWorkspaceSetupPolicy::after_choice(true, StudioFbxWorkspaceSetupPolicy::Choice.NeedsBuild) == StudioFbxWorkspaceSetupPolicy::Next.WaitForBuildConsent
        assert not StudioFbxWorkspaceSetupPolicy::after_build(true, false, true, true)
        assert StudioFbxWorkspaceSetupPolicy::after_build(true, true, true, true)

    def cancelled_choice_cancels_request() -> void:
        assert StudioFbxWorkspaceSetupPolicy::after_choice(true, StudioFbxWorkspaceSetupPolicy::Choice.Cancelled) == StudioFbxWorkspaceSetupPolicy::Next.CancelImport

    def refusal_preserves_request_without_starting() -> void:
        assert StudioFbxWorkspaceSetupPolicy::after_choice(true, StudioFbxWorkspaceSetupPolicy::Choice.Refused) == StudioFbxWorkspaceSetupPolicy::Next.KeepPending
        assert not StudioFbxWorkspaceSetupPolicy::after_build(true, true, false, true)
        assert not StudioFbxWorkspaceSetupPolicy::after_build(true, true, true, false)
