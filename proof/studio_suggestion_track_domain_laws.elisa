include "../src/studio/state/suggestion_tracks.elisa"

module StudioSuggestionTrackDomainLaws:
    public:
        def hinge_layout_retains_four_channels() -> bool:
            ensure result
            StudioSuggestionTracks::Domain::HINGE_COUNT == 4

        def fixed_point_angles_retain_millidegrees() -> bool:
            ensure result
            StudioSuggestionTracks::Domain::ANGLE_SCALE == 1000
