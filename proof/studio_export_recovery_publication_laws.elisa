# Prepared recovery publication preserves native commit facts.
include "../src/studio/export_recovery_publication_policy.elisa"

module StudioExportRecoveryPublicationLaws:
    public:
        def failed_preflight_cannot_be_admitted(owned: bool, locked: bool,
                binding_matches: bool, prepared: bool, staging_matches: bool,
                destination_matches: bool) -> bool:
            requires not owned or not locked or not binding_matches or not prepared or not staging_matches or not destination_matches
            ensure not result
            owned and locked and binding_matches and prepared and staging_matches and destination_matches

        def directory_sync_is_required_for_durable_stage(published: bool,
                                                          directory_synced: bool) -> bool:
            requires not directory_synced
            ensure not result
            StudioExportRecoveryPublicationPolicy::durable_stage_admitted(published, directory_synced)

        def late_journal_failure_keeps_publication(published: bool) -> bool:
            requires published
            ensure result
            StudioExportRecoveryPublicationPolicy::publication_preserved(published, false)
