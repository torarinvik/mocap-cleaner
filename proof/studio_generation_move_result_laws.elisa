include "../src/studio/state/generation_move_result_policy.elisa"

module StudioGenerationMoveResultLaws:
    public:
        def exact_quarantine_is_recoverable(bytes: i64) -> bool:
            requires bytes > 0 and bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES
            ensure result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32())
            StudioGenerationMoveResultPolicy::classify_result(0, true, bytes, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined) == StudioGenerationMoveResultPolicy::Outcome.Recoverable

        def exact_original_is_not_moved(bytes: i64) -> bool:
            requires bytes > 0 and bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES
            ensure result
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = StudioBuildGenerationTrashBindingPolicy::decode_status(StudioBuildGenerationTrashNative::Status.Acquired.i32())
            StudioGenerationMoveResultPolicy::classify_result(0, false, bytes, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.NotMoved) == StudioGenerationMoveResultPolicy::Outcome.NotMoved

        def negative_identity_requires_review(bytes: i64, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            requires bytes < 0
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(0, true, bytes, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined) == StudioGenerationMoveResultPolicy::Outcome.NeedsRecovery

        def owning_handle_has_priority(handle: i64, success: bool, bytes: i64, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome) -> bool:
            requires handle != 0
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(handle, success, bytes, release, recovery) == StudioGenerationMoveResultPolicy::Outcome.RetainedHandle

        def empty_identity_requires_recovery(success: bool, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome) -> bool:
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(0, success, 0, release, recovery) == StudioGenerationMoveResultPolicy::Outcome.NeedsRecovery

        def oversized_identity_requires_recovery(bytes: i64, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            requires bytes > StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(0, true, bytes, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined) == StudioGenerationMoveResultPolicy::Outcome.NeedsRecovery

        def uncertain_release_requires_recovery(release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            requires not StudioGenerationHandlePolicy::release_certain(release)
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(0, true, 1, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined) == StudioGenerationMoveResultPolicy::Outcome.NeedsRecovery

        def conflict_cannot_report_success(release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(0, true, 1, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Conflict) == StudioGenerationMoveResultPolicy::Outcome.NeedsRecovery

        def contradictory_success_cannot_report_not_moved(release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure result
            StudioGenerationMoveResultPolicy::classify_result(0, true, 1, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.NotMoved) == StudioGenerationMoveResultPolicy::Outcome.NeedsRecovery
