include "../src/studio/worker_path_capture.elisa"

module StudioWorkerPathCaptureLaws:
    public:
        def empty_request_is_refused() -> bool:
            ensure result
            mutable bytes: darray[u8] = []
            not StudioWorkerPathCapture::source_valid(&bytes)

        def oversized_request_is_refused(bytes: darray[u8]&) -> bool:
            requires bytes.count > StudioWorkerPathCapture::Limit::MAX_PATH_BYTES
            ensure result
            not StudioWorkerPathCapture::source_valid(bytes)

        def captured_request_is_bounded(bytes: darray[u8]&) -> bool:
            ensure result
            path: StudioWorkerPathCapture::Path = StudioWorkerPathCapture::capture(bytes)
            path.count <= StudioWorkerPathCapture::Limit::MAX_PATH_BYTES

        def captured_count_matches_input(bytes: darray[u8]&) -> bool:
            ensure result
            path: StudioWorkerPathCapture::Path = StudioWorkerPathCapture::capture(bytes)
            path.count == 0 or path.count == bytes.count

        def restored_count_is_bounded(path: StudioWorkerPathCapture::Path&) -> bool:
            ensure result
            bytes: darray[u8] = StudioWorkerPathCapture::restore(path)
            bytes.count <= StudioWorkerPathCapture::Limit::MAX_PATH_BYTES
