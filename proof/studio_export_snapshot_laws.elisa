include "../src/studio/export_snapshot_policy.elisa"

module StudioExportSnapshotLaws:
    public:
        def matching_result_is_current(generation: i64) -> bool:
            requires generation >= 0
            ensure result
            StudioExportSnapshotPolicy::current(generation, generation)

        def changed_result_is_stale(captured: i64, displayed: i64) -> bool:
            requires captured >= 0 and displayed >= 0
            requires captured != displayed
            ensure not result
            StudioExportSnapshotPolicy::current(captured, displayed)

        def invalid_capture_is_stale(displayed: i64) -> bool:
            ensure not result
            StudioExportSnapshotPolicy::current(-1, displayed)

        def invalid_display_is_stale(captured: i64) -> bool:
            ensure not result
            StudioExportSnapshotPolicy::current(captured, -1)
