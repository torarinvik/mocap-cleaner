include "../src/studio/io/build_generation_recovery_discovery.elisa"

module StudioGenerationRecoveryDiscoveryLaws:
    public:
        def pending_metadata_is_explicit() -> bool:
            ensure result
            StudioBuildGenerationRecoveryDiscovery::metadata_valid(0, 1, 1)

        def pending_without_identity_refused(pending: i64) -> bool:
            requires pending > 0
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::metadata_valid(0, 0, pending)

        def failure_cannot_publish_pending(status: i32, pending: i64) -> bool:
            requires status != 0 and pending > 0
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::metadata_valid(status, 0, pending)

        def oversized_pending_refused(pending: i64) -> bool:
            requires pending > StudioBuildGenerationRecoveryDiscovery::Limit::DIRECTORY_ENTRIES
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::metadata_valid(0, 1, pending)

        def invalid_header_publishes_no_rows(status: i32, count: i64, buffer: u8[StudioBuildGenerationRecoveryDiscovery::Limit::BUFFER_BYTES]&) -> bool can Memory.Allocate:
            requires not StudioBuildGenerationRecoveryDiscovery::header_valid(status, count)
            ensure result
            snapshot: StudioBuildGenerationRecoveryDiscovery::Snapshot = StudioBuildGenerationRecoveryDiscovery::decode(status, count, 0, buffer)
            snapshot.outcome == StudioBuildGenerationRecoveryDiscovery::Outcome.Refused and snapshot.operations.count == 0

        def overflow_publishes_no_rows(buffer: u8[StudioBuildGenerationRecoveryDiscovery::Limit::BUFFER_BYTES]&) -> bool can Memory.Allocate:
            ensure result
            snapshot: StudioBuildGenerationRecoveryDiscovery::Snapshot = StudioBuildGenerationRecoveryDiscovery::decode(1, 0, 0, buffer)
            snapshot.outcome == StudioBuildGenerationRecoveryDiscovery::Outcome.Overflow and snapshot.operations.count == 0

        def refusal_publishes_no_rows(buffer: u8[StudioBuildGenerationRecoveryDiscovery::Limit::BUFFER_BYTES]&) -> bool can Memory.Allocate:
            ensure result
            snapshot: StudioBuildGenerationRecoveryDiscovery::Snapshot = StudioBuildGenerationRecoveryDiscovery::decode(2, 0, 0, buffer)
            snapshot.outcome == StudioBuildGenerationRecoveryDiscovery::Outcome.Refused and snapshot.operations.count == 0

        def empty_complete_header_valid() -> bool:
            ensure result
            StudioBuildGenerationRecoveryDiscovery::header_valid(0, 0)

        def largest_complete_header_valid() -> bool:
            ensure result
            StudioBuildGenerationRecoveryDiscovery::header_valid(0, StudioBuildGenerationRecoveryDiscovery::Limit::ROWS)

        def negative_count_refused(status: i32, count: i64) -> bool:
            requires count < 0
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::header_valid(status, count)

        def oversized_count_refused(status: i32, count: i64) -> bool:
            requires count > StudioBuildGenerationRecoveryDiscovery::Limit::ROWS
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::header_valid(status, count)

        def partial_overflow_refused(count: i64) -> bool:
            requires count != 0
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::header_valid(1, count)

        def partial_refusal_refused(count: i64) -> bool:
            requires count != 0
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::header_valid(2, count)

        def unknown_status_refused(status: i32, count: i64) -> bool:
            requires status != 0 and status != 1 and status != 2
            ensure not result
            StudioBuildGenerationRecoveryDiscovery::header_valid(status, count)
