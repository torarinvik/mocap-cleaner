# Proof-oriented arithmetic, range, and schema laws for export reports.
include "../src/studio/export_report_policy.elisa"

module StudioExportReportLaws:
    public:
        def one_minute_at_thirty_fps_is_one_minute_ms(frames: i64) -> bool:
            requires frames == 1800
            ensure result
            StudioExportReportPolicy::duration_ms(frames, 30) == 60000

        def fractional_millisecond_duration_is_floored(frames: i64) -> bool:
            requires frames == 31
            ensure result
            StudioExportReportPolicy::duration_ms(frames, 30) == 1033

        def documented_frame_limit_fits_time_arithmetic(frames: i64) -> bool:
            requires frames == StudioExportReportPolicy::Timing::MAX_FRAMES
            ensure result
            StudioExportReportPolicy::duration_ms(frames, 1000) == 10000000

        def report_frame_limit_matches_timeline_contract(frames: i64) -> bool:
            requires frames == 10000000
            ensure result
            StudioExportReportPolicy::frame_count_ok(frames)

        def invalid_negative_frame_count_is_rejected(frames: i64) -> bool:
            requires frames == -1
            ensure result
            not StudioExportReportPolicy::frame_count_ok(frames)

        def invalid_zero_rate_is_rejected(fps: i64) -> bool:
            requires fps == 0
            ensure result
            not StudioExportReportPolicy::frame_rate_ok(fps)

        def report_schema_is_versioned() -> bool:
            ensure result
            StudioExportReportPolicy::schema_version() == 2

        def report_names_all_unavailable_provenance_fields() -> bool:
            ensure result
            StudioExportReportPolicy::unavailable_field_count() == 6

        def report_has_ten_metric_fields() -> bool:
            ensure result
            StudioExportReportPolicy::metric_field_count() == 10

        def exact_time_map_removes_one_unavailable_field() -> bool:
            ensure result
            StudioExportReportPolicy::unavailable_field_count_for(true) == 5

        def absent_time_map_keeps_its_unavailable_field() -> bool:
            ensure result
            StudioExportReportPolicy::unavailable_field_count_for(false) == 6
