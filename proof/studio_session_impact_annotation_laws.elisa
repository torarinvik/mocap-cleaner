include "../src/studio/state/session_impact_annotation_policy.elisa"

module StudioSessionImpactAnnotationLaws:
    public:
        def explicit_no_event_sentinel_fields_are_valid(count: i64, frame: i64) -> bool:
            requires count == 0 and frame == -1
            ensure result
            SessionImpactAnnotationPolicy::no_event_fields_valid(count, frame)

        def event_count_is_bounded(count: i64) -> bool:
            requires count > 0 and count <= SessionImpactAnnotationPolicy::MAX_RECORDS
            ensure result
            SessionImpactAnnotationPolicy::event_count_valid(count)

        def selected_animation_is_bound(record: SessionImpactAnnotationPolicy::Stored, first: i64, second: i64, animation: i64, frames: i64, nodes: i64) -> bool:
            requires record.source_first == first and record.source_second == second
            requires record.animation == animation and record.source_frames == frames and record.nodes == nodes
            ensure result
            SessionImpactAnnotationPolicy::source_matches(record, first, second, animation, frames, nodes)

        def source_frame_at_end_is_rejected(frame: i64, frames: i64) -> bool:
            requires frames > 0 and frame == frames
            ensure result
            not SessionImpactAnnotationPolicy::source_frame_valid(frame, frames)
