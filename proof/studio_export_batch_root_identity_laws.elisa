include "../src/studio/io/export_batch_root_identity.elisa"

module StudioExportBatchRootIdentityLaws:
    public:
        def unchanged_directory_identity_matches() -> bool can Memory.Allocate:
            ensure result
            mutable path: darray[u8] = [47u8, 98u8, 117u8, 105u8, 108u8, 100u8]
            expected: StudioExportBatchRootIdentity::Facts = StudioExportBatchRootIdentity::Facts{canonical_path: path, device: 8, inode: 42}
            observed: StudioExportBatchRootIdentity::Facts = StudioExportBatchRootIdentity::Facts{canonical_path: path, device: 8, inode: 42}
            StudioExportBatchRootIdentity::matches(expected, observed)

        def replacement_inode_is_rejected() -> bool can Memory.Allocate:
            ensure result
            mutable path: darray[u8] = [47u8, 98u8, 117u8, 105u8, 108u8, 100u8]
            expected: StudioExportBatchRootIdentity::Facts = StudioExportBatchRootIdentity::Facts{canonical_path: path, device: 8, inode: 42}
            replaced: StudioExportBatchRootIdentity::Facts = StudioExportBatchRootIdentity::Facts{canonical_path: path, device: 8, inode: 43}
            not StudioExportBatchRootIdentity::matches(expected, replaced)

        def replacement_path_is_rejected() -> bool can Memory.Allocate:
            ensure result
            mutable original_path: darray[u8] = [47u8, 98u8, 117u8, 105u8, 108u8, 100u8]
            mutable new_path: darray[u8] = [47u8, 98u8, 117u8, 105u8, 108u8, 100u8, 50u8]
            expected: StudioExportBatchRootIdentity::Facts = StudioExportBatchRootIdentity::Facts{canonical_path: original_path, device: 8, inode: 42}
            replaced: StudioExportBatchRootIdentity::Facts = StudioExportBatchRootIdentity::Facts{canonical_path: new_path, device: 8, inode: 42}
            not StudioExportBatchRootIdentity::matches(expected, replaced)
