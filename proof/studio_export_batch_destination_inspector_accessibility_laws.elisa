include "../src/studio/export_batch_destination_inspector_accessibility_policy.elisa"

module StudioExportBatchDestinationInspectorAccessibilityLaws:
    public:
        def destination_ids_fit() -> bool:
            ensure result
            StudioExportBatchDestinationInspectorAccessibilityPolicy::ids_fit_reserved_range()

        def focus_id_round_trip(code: i64) -> bool:
            requires code >= 0 and code < 7
            ensure result
            focus: StudioExportBatchDestinationInspectorPolicy::Focus = StudioExportBatchDestinationInspectorPolicy::focus_for_code(code)
            StudioExportBatchDestinationInspectorAccessibilityPolicy::focus_for_id(
                StudioExportBatchDestinationInspectorAccessibilityPolicy::focus_id(focus)) is focus

        def location_ids_are_contiguous() -> bool:
            ensure result
            StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(StudioExportBatchDestinationInspectorPolicy::Location.Glb) == StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(StudioExportBatchDestinationInspectorPolicy::Location.Source) + 1 and StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(StudioExportBatchDestinationInspectorPolicy::Location.JsonReport) == StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(StudioExportBatchDestinationInspectorPolicy::Location.Glb) + 1 and StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(StudioExportBatchDestinationInspectorPolicy::Location.TextReport) == StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(StudioExportBatchDestinationInspectorPolicy::Location.JsonReport) + 1

        def sibling_chain_has_expected_end() -> bool:
            ensure result
            StudioExportBatchDestinationInspectorAccessibilityPolicy::next_sibling_id(
                StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::STATUS, 2) == StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::LOCATION_FIRST and StudioExportBatchDestinationInspectorAccessibilityPolicy::next_sibling_id(
                StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::LOCATION_FIRST + 3, 2) == StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::LINE_FIRST and StudioExportBatchDestinationInspectorAccessibilityPolicy::next_sibling_id(
                StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::LINE_FIRST + 1, 2) == StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::PREVIOUS and StudioExportBatchDestinationInspectorAccessibilityPolicy::next_sibling_id(
                StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::NEXT, 2) == StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::DONE and StudioExportBatchDestinationInspectorAccessibilityPolicy::next_sibling_id(
                StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::DONE, 2) == StudioStorageAccessibilityPolicy::Node::NO_NODE

        def path_segment_capacity_is_below_core_text_limit() -> bool:
            ensure result
            StudioExportBatchDestinationInspectorPolicy::Limit::SCALARS_PER_LINE * StudioExportBatchDestinationInspectorPolicy::Limit::MAX_UTF8_BYTES <= 128

        def location_node_stays_in_reserved_choices(location: StudioExportBatchDestinationInspectorPolicy::Location) -> bool:
            requires StudioExportBatchDestinationInspectorPolicy::location_valid(location)
            ensure result
            id: usize = StudioExportBatchDestinationInspectorAccessibilityPolicy::location_id(location)
            id >= StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::LOCATION_FIRST and id < StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::LINE_FIRST

        def unknown_node_has_no_parent(id: usize) -> bool:
            requires not StudioExportBatchDestinationInspectorAccessibilityPolicy::is_node(id)
            ensure result
            StudioExportBatchDestinationInspectorAccessibilityPolicy::parent_id(id) == StudioStorageAccessibilityPolicy::Node::NO_NODE
