include "../src/studio/retime_draft_policy.elisa"

module StudioRetimeDraftLaws:
    public:
        def unchanged_target_is_current(target: StudioRetimeDraftPolicy::Target) -> bool:
            requires target.generation >= 0
            ensure result
            StudioRetimeDraftPolicy::current(target, target)

        def changed_history_rejects_draft(captured: StudioRetimeDraftPolicy::Target, now: StudioRetimeDraftPolicy::Target) -> bool:
            requires captured.generation != now.generation
            ensure result
            not StudioRetimeDraftPolicy::current(captured, now)

        def changed_target_rejects_draft(captured: StudioRetimeDraftPolicy::Target, now: StudioRetimeDraftPolicy::Target) -> bool:
            requires captured.range_selected != now.range_selected or captured.first != now.first or captured.last != now.last or captured.band != now.band
            ensure result
            not StudioRetimeDraftPolicy::current(captured, now)
