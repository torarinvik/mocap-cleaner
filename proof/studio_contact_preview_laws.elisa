# Safety and freshness laws for the transient contact pose candidate.
include "../src/studio/contact_preview_policy.elisa"

module StudioContactPreviewLaws:
    public:
        def first_candidate_evaluates(active: bool, request_generation: i64, now_us: i64) -> bool:
            requires active and request_generation > 0 and now_us >= 0
            ensure result
            StudioContactPreviewPolicy::evaluation(active, request_generation, 0, now_us, -1) == StudioContactPreviewPolicy::Evaluation.Evaluate

        def rate_limit_blocks_early_evaluation(request_generation: i64, now_us: i64) -> bool:
            requires request_generation > 0 and now_us >= 0 and now_us < StudioContactPreviewPolicy::Cadence::MIN_EVALUATION_MICROSECONDS
            ensure result
            StudioContactPreviewPolicy::evaluation(true, request_generation, 0, now_us, 0) == StudioContactPreviewPolicy::Evaluation.Throttled

        def rate_limit_allows_due_evaluation(request_generation: i64, now_us: i64) -> bool:
            requires request_generation > 0 and now_us >= StudioContactPreviewPolicy::Cadence::MIN_EVALUATION_MICROSECONDS
            ensure result
            StudioContactPreviewPolicy::evaluation(true, request_generation, 0, now_us, 0) == StudioContactPreviewPolicy::Evaluation.Evaluate

        def completed_request_is_not_repeated(request_generation: i64, now_us: i64, last_evaluation_us: i64) -> bool:
            requires request_generation > 0 and now_us >= 0 and last_evaluation_us >= 0
            ensure result
            StudioContactPreviewPolicy::evaluation(true, request_generation, request_generation, now_us, last_evaluation_us) == StudioContactPreviewPolicy::Evaluation.Unchanged

        def invalid_clock_never_admits_evaluation(request_generation: i64, evaluated_generation: i64, last_evaluation_us: i64) -> bool:
            requires request_generation > evaluated_generation and evaluated_generation >= 0 and last_evaluation_us >= -1
            ensure result
            StudioContactPreviewPolicy::evaluation(true, request_generation, evaluated_generation, -1, last_evaluation_us) == StudioContactPreviewPolicy::Evaluation.ClockInvalid

        def maximal_clock_with_unset_prior_evaluates() -> bool:
            ensure result
            StudioContactPreviewPolicy::evaluation(true, 1, 0, 9223372036854775807, -1) == StudioContactPreviewPolicy::Evaluation.Evaluate

        def request_generation_wraps_without_overflow() -> bool:
            ensure result
            StudioContactPreviewPolicy::next_generation(StudioContactPreviewPolicy::Generation::MAX) == 1

        def request_generation_advances_below_limit(current: i64) -> bool:
            requires current >= 0 and current < StudioContactPreviewPolicy::Generation::MAX
            ensure result
            StudioContactPreviewPolicy::next_generation(current) == current + 1

        def changed_request_invalidates_candidate(first: i64, last: i64) -> bool:
            requires first >= 0 and last > first
            ensure not result
            StudioContactPreviewPolicy::candidate_current(true, first, last, first, last - 1, 1, 1, 2, 2, 3, 3, 4, 4)

        def history_change_invalidates_candidate(first: i64, last: i64, current_stack: i64) -> bool:
            requires first >= 0 and last >= first and current_stack >= 1
            ensure not result
            StudioContactPreviewPolicy::candidate_current(true, first, last, first, last, 1, 1, 2, 2, current_stack - 1, current_stack, 4, 4)

        def take_or_frame_change_invalidates_candidate(first: i64, last: i64, current_take: i64, current_frame: i64) -> bool:
            requires first >= 0 and last >= first and current_take >= 1 and current_frame >= 1
            ensure result
            not StudioContactPreviewPolicy::candidate_current(true, first, last, first, last, current_take - 1, current_take, 2, 2, 3, 3, current_frame - 1, current_frame)
