include "../src/studio/export_recovery_retry_policy.elisa"

module StudioExportRecoveryRetryLaws:
    public:
        def all_fresh_facts_admit() -> bool:
            ensure result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(true, true, true, true, true, true, true)

        def workspace_mismatch_rejects(locked: bool, owned: bool, binding: bool,
                prepared: bool, staging: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(false, locked, owned, binding, prepared, staging, destinations)

        def missing_lock_rejects(workspace: bool, owned: bool, binding: bool,
                prepared: bool, staging: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(workspace, false, owned, binding, prepared, staging, destinations)

        def unowned_directory_rejects(workspace: bool, locked: bool, binding: bool,
                prepared: bool, staging: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(workspace, locked, false, binding, prepared, staging, destinations)

        def changed_binding_rejects(workspace: bool, locked: bool, owned: bool,
                prepared: bool, staging: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(workspace, locked, owned, false, prepared, staging, destinations)

        def nonprepared_record_rejects(workspace: bool, locked: bool, owned: bool,
                binding: bool, staging: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(workspace, locked, owned, binding, false, staging, destinations)

        def changed_staging_rejects(workspace: bool, locked: bool, owned: bool,
                binding: bool, prepared: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(workspace, locked, owned, binding, prepared, false, destinations)

        def conflicting_destination_rejects(workspace: bool, locked: bool, owned: bool,
                binding: bool, prepared: bool, staging: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::prepared_retry_admitted(workspace, locked, owned, binding, prepared, staging, false)

        def existing_output_requires_complete_binding() -> bool:
            ensure result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(true, true, true, true, true, true, true)

        def existing_output_with_wrong_workspace_rejects(locked: bool, owned: bool,
                binding: bool, prepared: bool, output_matches: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(false, locked, owned, binding, prepared, output_matches, destinations)

        def existing_output_without_lock_rejects(workspace: bool, owned: bool,
                binding: bool, prepared: bool, output_matches: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(workspace, false, owned, binding, prepared, output_matches, destinations)

        def existing_output_with_unowned_directory_rejects(workspace: bool, locked: bool,
                binding: bool, prepared: bool, output_matches: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(workspace, locked, false, binding, prepared, output_matches, destinations)

        def existing_output_with_changed_binding_rejects(workspace: bool, locked: bool,
                owned: bool, prepared: bool, output_matches: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(workspace, locked, owned, false, prepared, output_matches, destinations)

        def existing_output_with_unprepared_record_rejects(workspace: bool, locked: bool,
                owned: bool, binding: bool, output_matches: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(workspace, locked, owned, binding, false, output_matches, destinations)

        def different_output_rejects(workspace: bool, locked: bool, owned: bool,
                binding: bool, prepared: bool, destinations: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(workspace, locked, owned, binding, prepared, false, destinations)

        def conflicting_report_rejects(workspace: bool, locked: bool, owned: bool,
                binding: bool, prepared: bool, output_matches: bool) -> bool:
            ensure not result
            StudioExportRecoveryRetryPolicy::existing_publication_admitted(workspace, locked, owned, binding, prepared, output_matches, false)
