# Contracts for custom Studio numeric fields across keyboard and committed
# text input.
include "../src/studio/text_entry_policy.elisa"

module StudioTextEntryPolicyLaws:
    public:
        def inactive_draft_ignores(character: i64, contact_frame: bool) -> i64:
            requires character >= 0 and character <= 255
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(false, character, contact_frame)

        def frame_field_keeps_digits(character: i64) -> i64:
            requires character >= StudioTextEntryPolicy::Character::ASCII_ZERO
            requires character <= StudioTextEntryPolicy::Character::ASCII_NINE
            ensure result == character
            StudioTextEntryPolicy::route(true, character, true)

        def frame_field_rejects_other_bytes(character: i64) -> i64:
            requires character >= 0 and character <= 255
            requires character < StudioTextEntryPolicy::Character::ASCII_ZERO or character > StudioTextEntryPolicy::Character::ASCII_NINE
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(true, character, true)

        def speed_field_keeps_decimal_and_suffix(character: i64) -> i64:
            requires character == StudioTextEntryPolicy::Character::ASCII_DOT or character == StudioTextEntryPolicy::Character::ASCII_LOWER_X or character == StudioTextEntryPolicy::Character::ASCII_UPPER_X or character == StudioTextEntryPolicy::Character::ASCII_SPACE
            ensure result == character
            StudioTextEntryPolicy::route(true, character, false)

        def speed_field_rejects_unrecognized_bytes(character: i64) -> i64:
            requires character >= 0 and character <= 255
            requires character < StudioTextEntryPolicy::Character::ASCII_ZERO or character > StudioTextEntryPolicy::Character::ASCII_NINE
            requires character != StudioTextEntryPolicy::Character::ASCII_DOT
            requires character != StudioTextEntryPolicy::Character::ASCII_LOWER_X
            requires character != StudioTextEntryPolicy::Character::ASCII_UPPER_X
            requires character != StudioTextEntryPolicy::Character::ASCII_SPACE
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(true, character, false)

        def speed_field_keeps_punctuation(character: i64) -> i64:
            requires character == StudioTextEntryPolicy::Character::ASCII_DOT or character == StudioTextEntryPolicy::Character::ASCII_LOWER_X or character == StudioTextEntryPolicy::Character::ASCII_UPPER_X or character == StudioTextEntryPolicy::Character::ASCII_SPACE
            ensure result == character
            StudioTextEntryPolicy::route(true, character, false)

        def frame_field_rejects_punctuation(character: i64) -> i64:
            requires character == StudioTextEntryPolicy::Character::ASCII_DOT or character == StudioTextEntryPolicy::Character::ASCII_LOWER_X or character == StudioTextEntryPolicy::Character::ASCII_UPPER_X or character == StudioTextEntryPolicy::Character::ASCII_SPACE
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(true, character, true)

        def full_draft_rejects_append(length: i64) -> bool:
            requires length >= StudioTextEntryPolicy::Capacity::MAX_CHARACTERS
            ensure result
            not StudioTextEntryPolicy::can_append(length)

        def available_draft_accepts_append(length: i64) -> bool:
            requires length >= 0 and length < StudioTextEntryPolicy::Capacity::MAX_CHARACTERS
            ensure result
            StudioTextEntryPolicy::can_append(length)

        def negative_length_rejects_append(length: i64) -> bool:
            requires length < 0
            ensure result
            not StudioTextEntryPolicy::can_append(length)
