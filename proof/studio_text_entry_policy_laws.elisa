# Contracts for custom Studio numeric fields across keyboard and committed
# text input.
include "../src/studio/text_entry_policy.elisa"

module StudioTextEntryPolicyLaws:
    public:
        def inactive_draft_ignores(character: i64, contact_frame: bool) -> i64:
            requires character >= 0 and character <= 255
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(false, character, contact_frame)

        def frame_field_keeps_digits(character: i64) -> i64:
            requires character >= StudioTextEntryPolicy::ASCII_ZERO
            requires character <= StudioTextEntryPolicy::ASCII_NINE
            ensure result == character
            StudioTextEntryPolicy::route(true, character, true)

        def frame_field_rejects_other_bytes(character: i64) -> i64:
            requires character >= 0 and character <= 255
            requires character < StudioTextEntryPolicy::ASCII_ZERO or character > StudioTextEntryPolicy::ASCII_NINE
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(true, character, true)

        def speed_field_keeps_decimal_and_suffix(character: i64) -> i64:
            requires character == StudioTextEntryPolicy::ASCII_DOT or character == StudioTextEntryPolicy::ASCII_LOWER_X or character == StudioTextEntryPolicy::ASCII_UPPER_X or character == StudioTextEntryPolicy::ASCII_SPACE
            ensure result == character
            StudioTextEntryPolicy::route(true, character, false)

        def speed_field_rejects_unrecognized_bytes(character: i64) -> i64:
            requires character >= 0 and character <= 255
            requires character < StudioTextEntryPolicy::ASCII_ZERO or character > StudioTextEntryPolicy::ASCII_NINE
            requires character != StudioTextEntryPolicy::ASCII_DOT
            requires character != StudioTextEntryPolicy::ASCII_LOWER_X
            requires character != StudioTextEntryPolicy::ASCII_UPPER_X
            requires character != StudioTextEntryPolicy::ASCII_SPACE
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(true, character, false)

        def speed_field_keeps_punctuation(character: i64) -> i64:
            requires character == StudioTextEntryPolicy::ASCII_DOT or character == StudioTextEntryPolicy::ASCII_LOWER_X or character == StudioTextEntryPolicy::ASCII_UPPER_X or character == StudioTextEntryPolicy::ASCII_SPACE
            ensure result == character
            StudioTextEntryPolicy::route(true, character, false)

        def frame_field_rejects_punctuation(character: i64) -> i64:
            requires character == StudioTextEntryPolicy::ASCII_DOT or character == StudioTextEntryPolicy::ASCII_LOWER_X or character == StudioTextEntryPolicy::ASCII_UPPER_X or character == StudioTextEntryPolicy::ASCII_SPACE
            ensure result == StudioTextEntryPolicy::REJECT
            StudioTextEntryPolicy::route(true, character, true)
