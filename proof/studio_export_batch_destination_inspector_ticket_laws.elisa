include "../src/studio/export_batch_destination_inspector_ticket_policy.elisa"

module StudioExportBatchDestinationInspectorTicketLaws:
    public:
        def exact_context_stays_current(ticket: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(ticket, max_revision, max_attempt)
            ensure result
            StudioExportBatchDestinationInspectorTicketPolicy::current(ticket, ticket, true, true, max_revision, max_attempt)

        def changed_revision_refuses(captured: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                observed: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(captured, max_revision, max_attempt)
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(observed, max_revision, max_attempt)
            requires captured.revision != observed.revision
            ensure result
            not StudioExportBatchDestinationInspectorTicketPolicy::current(captured, observed, true, true, max_revision, max_attempt)

        def changed_selection_refuses(captured: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                observed: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(captured, max_revision, max_attempt)
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(observed, max_revision, max_attempt)
            requires captured.index != observed.index
            ensure result
            not StudioExportBatchDestinationInspectorTicketPolicy::current(captured, observed, true, true, max_revision, max_attempt)

        def changed_attempt_refuses(captured: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                observed: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(captured, max_revision, max_attempt)
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(observed, max_revision, max_attempt)
            requires captured.attempt != observed.attempt
            ensure result
            not StudioExportBatchDestinationInspectorTicketPolicy::current(captured, observed, true, true, max_revision, max_attempt)

        def changed_item_facts_refuse(captured: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                observed: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(captured, max_revision, max_attempt)
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(observed, max_revision, max_attempt)
            requires captured.state != observed.state or captured.warning_count != observed.warning_count or captured.approved != observed.approved
            ensure result
            not StudioExportBatchDestinationInspectorTicketPolicy::current(captured, observed, true, true, max_revision, max_attempt)

        def closed_context_refuses(ticket: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                inspector_open: bool, sheet_open: bool,
                max_revision: i64, max_attempt: i64) -> bool:
            requires StudioExportBatchDestinationInspectorTicketPolicy::valid(ticket, max_revision, max_attempt)
            requires not inspector_open or not sheet_open
            ensure result
            not StudioExportBatchDestinationInspectorTicketPolicy::current(ticket, ticket, inspector_open, sheet_open, max_revision, max_attempt)

        def out_of_domain_revision_refuses(ticket: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires max_revision >= 0 and max_attempt >= 0
            requires ticket.revision > max_revision
            ensure not StudioExportBatchDestinationInspectorTicketPolicy::valid(ticket, max_revision, max_attempt)
            not StudioExportBatchDestinationInspectorTicketPolicy::valid(ticket, max_revision, max_attempt)

        def out_of_domain_attempt_refuses(ticket: StudioExportBatchDestinationInspectorTicketPolicy::Ticket,
                max_revision: i64, max_attempt: i64) -> bool:
            requires max_revision >= 0 and max_attempt >= 0
            requires ticket.attempt > max_attempt
            ensure not StudioExportBatchDestinationInspectorTicketPolicy::valid(ticket, max_revision, max_attempt)
            not StudioExportBatchDestinationInspectorTicketPolicy::valid(ticket, max_revision, max_attempt)
