include "../src/studio/export_recovery_budget_policy.elisa"

module StudioExportRecoveryBudgetLaws:
    public:
        def empty_chunk_fits() -> bool:
            ensure result
            StudioExportRecoveryBudgetPolicy::append_admitted(0, 0, 1)

        def exact_limit_fits() -> bool:
            ensure result
            StudioExportRecoveryBudgetPolicy::append_admitted(1, 1, 2)

        def excess_chunk_is_rejected() -> bool:
            ensure not result
            StudioExportRecoveryBudgetPolicy::append_admitted(1, 2, 2)

        def negative_current_is_rejected(incoming: i64, limit: i64) -> bool:
            ensure not result
            StudioExportRecoveryBudgetPolicy::append_admitted(-1, incoming, limit)

        def negative_incoming_is_rejected(current: i64, limit: i64) -> bool:
            ensure not result
            StudioExportRecoveryBudgetPolicy::append_admitted(current, -1, limit)

        def zero_limit_is_rejected(current: i64, incoming: i64) -> bool:
            ensure not result
            StudioExportRecoveryBudgetPolicy::append_admitted(current, incoming, 0)

        def admitted_chunk_is_bounded(current: i64, incoming: i64, limit: i64) -> bool:
            requires StudioExportRecoveryBudgetPolicy::append_admitted(current, incoming, limit)
            ensure result
            current + incoming <= limit
