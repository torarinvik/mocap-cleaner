# Heel/ball pivot laws ("contacts are sacred"): the planted foot turns about
# the lower of heel and ball, a fully locked pivot sits on its anchor and on
# the floor (no sink, no float), and an unlocked or plant frame is untouched.
include "../src/core/pivot.elisa"
include "../src/core/lock.elisa"

module PivotLaws:
    public:
        # A ball clearly below the heel is the pivot.
        def ball_lower_is_pivot(previous: i64, heel: i64, ball: i64, margin: i64) -> i64:
            requires previous >= 0
            requires previous <= 1
            requires heel >= -1000000000
            requires heel <= 1000000000
            requires ball >= -1000000000
            requires ball <= 1000000000
            requires margin >= 0
            requires margin <= 1000000000
            requires ball + margin < heel
            ensure result == Pivot::Point.Ball.i64()
            return Pivot::choose(previous, heel, ball, margin)

        # A heel clearly below the ball is the pivot.
        def heel_lower_is_pivot(previous: i64, heel: i64, ball: i64, margin: i64) -> i64:
            requires previous >= 0
            requires previous <= 1
            requires heel >= -1000000000
            requires heel <= 1000000000
            requires ball >= -1000000000
            requires ball <= 1000000000
            requires margin >= 0
            requires margin <= 1000000000
            requires heel + margin < ball
            ensure result == Pivot::Point.Heel.i64()
            return Pivot::choose(previous, heel, ball, margin)

        # Within the margin the pivot does not flicker.
        def level_keeps_pivot(previous: i64, heel: i64, ball: i64, margin: i64) -> i64:
            requires previous >= 0
            requires previous <= 1
            requires heel >= -1000000000
            requires heel <= 1000000000
            requires ball >= -1000000000
            requires ball <= 1000000000
            requires margin >= 0
            requires margin <= 1000000000
            requires heel - ball <= margin
            requires ball - heel <= margin
            ensure result == previous
            return Pivot::choose(previous, heel, ball, margin)

        # Level heel and ball keep the previous pivot whatever the margin.
        def flat_foot_keeps_pivot(previous: i64, height: i64, margin: i64) -> i64:
            requires previous >= 0
            requires previous <= 1
            requires height >= -1000000000
            requires height <= 1000000000
            requires margin >= 0
            requires margin <= 1000000000
            ensure result == previous
            return Pivot::choose(previous, height, height, margin)

        # The choice is always heel or ball.
        def pivot_is_heel_or_ball(previous: i64, heel: i64, ball: i64, margin: i64) -> bool:
            requires previous >= 0
            requires previous <= 1
            requires heel >= -1000000000
            requires heel <= 1000000000
            requires ball >= -1000000000
            requires ball <= 1000000000
            requires margin >= 0
            requires margin <= 1000000000
            ensure result
            p: i64 = Pivot::choose(previous, heel, ball, margin)
            return p == Pivot::Point.Heel.i64() or p == Pivot::Point.Ball.i64()

        # An unlocked foot is not moved.
        def unlocked_not_shifted(point: i64, held: i64) -> i64:
            requires point >= -1000000000
            requires point <= 1000000000
            requires held >= -1000000000
            requires held <= 1000000000
            ensure result == 0
            return Pivot::shift(point, held, 0)

        # A fully locked pivot lands exactly on its anchor.
        def full_lock_hits_anchor(point: i64, held: i64) -> i64:
            requires point >= -1000000000
            requires point <= 1000000000
            requires held >= -1000000000
            requires held <= 1000000000
            ensure result == held - point
            return Pivot::shift(point, held, 1000)

        # A pivot already on its anchor is never moved.
        def anchored_pivot_still(held: i64, w: i64) -> i64:
            requires held >= -1000000000
            requires held <= 1000000000
            requires w >= 0
            requires w <= 1000
            ensure result == 0
            return Pivot::shift(held, held, w)

        # No sink or float: a fully locked pivot sits on the floor.
        def planted_pivot_on_floor(height: i64, floor: i64) -> i64:
            requires height >= -1000000000
            requires height <= 1000000000
            requires floor >= -1000000000
            requires floor <= 1000000000
            ensure result == floor
            return Pivot::settle(height, floor, 1000)

        # A free foot keeps its height.
        def free_pivot_keeps_height(height: i64, floor: i64) -> i64:
            requires height >= -1000000000
            requires height <= 1000000000
            requires floor >= -1000000000
            requires floor <= 1000000000
            ensure result == height
            return Pivot::settle(height, floor, 0)

        # A pivot on the floor stays there at any weight.
        def grounded_pivot_stays(floor: i64, w: i64) -> i64:
            requires floor >= -1000000000
            requires floor <= 1000000000
            requires w >= 0
            requires w <= 1000
            ensure result == floor
            return Pivot::settle(floor, floor, w)

        # The plant frame is never shifted (the lock ramps in from it).
        def plant_frame_not_shifted(point: i64, held: i64, left: i64, blend: i64) -> i64:
            requires point >= -1000000000
            requires point <= 1000000000
            requires held >= -1000000000
            requires held <= 1000000000
            requires left >= 0
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == 0
            return Pivot::shift(point, held, Lock::hold(0, left, blend))

        # The lift frame is never shifted (the lock ramps out to it).
        def lift_frame_not_shifted(point: i64, held: i64, into: i64, blend: i64) -> i64:
            requires point >= -1000000000
            requires point <= 1000000000
            requires held >= -1000000000
            requires held <= 1000000000
            requires into >= 0
            requires into <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == 0
            return Pivot::shift(point, held, Lock::hold(into, 0, blend))

        # Deep inside a plant the pivot is on the floor.
        def deep_plant_on_floor(height: i64, floor: i64, into: i64, left: i64, blend: i64) -> i64:
            requires height >= -1000000000
            requires height <= 1000000000
            requires floor >= -1000000000
            requires floor <= 1000000000
            requires into >= blend
            requires into <= Fade::Domain::MAX_FRAMES
            requires left >= blend
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result == floor
            return Pivot::settle(height, floor, Lock::hold(into, left, blend))

        def typed_choice_preserves_kernel(previous: Pivot::Point, heel: i64, ball: i64, margin: i64) -> bool:
            requires heel >= -Pivot::Domain::LIMIT and heel <= Pivot::Domain::LIMIT
            requires ball >= -Pivot::Domain::LIMIT and ball <= Pivot::Domain::LIMIT
            requires margin >= 0 and margin <= Pivot::Domain::LIMIT
            ensure result
            Pivot::choose_point(previous, heel, ball, margin).i64() == Pivot::choose(previous.i64(), heel, ball, margin)
