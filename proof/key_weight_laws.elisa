# Keyed-correction weight laws: full at the key, nothing outside the scope.
include "../src/core/key_weight.elisa"

module KeyWeightLaws:
    public:
        def index_outside_domain(index: usize, first: i64, last: i64) -> bool:
            requires first >= 0
            requires first <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            requires index > KeyWeight::Domain::MAX_FRAMES.usize()
            ensure result == false
            KeyWeight::admits_index(index, first, last)

        def index_at_first(first: i64, last: i64) -> bool:
            requires first >= 0
            requires first <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            ensure result == true
            KeyWeight::admits_index(first.usize(), first, last)

        def index_at_last(first: i64, last: i64) -> bool:
            requires first >= 0
            requires first <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            ensure result == true
            KeyWeight::admits_index(last.usize(), first, last)

        def index_after_scope(index: usize, first: i64, last: i64) -> bool:
            requires first >= 0
            requires first <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            requires index > last.usize()
            ensure result == false
            KeyWeight::admits_index(index, first, last)

        # The key frame gets the whole correction.
        def full_at_key(first: i64, key: i64, last: i64) -> i64:
            requires first >= 0
            requires first <= key
            requires key <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            ensure result == KeyWeight::Domain::FULL_PERMILLE
            w: i64 = KeyWeight::weight(key, first, key, last)
            return w

        # Frames before the scope are untouched.
        def zero_before(frame: i64, first: i64, key: i64, last: i64) -> i64:
            requires first >= 0
            requires first <= key
            requires key <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            requires frame >= -KeyWeight::Domain::MAX_FRAMES
            requires frame < first
            ensure result == 0
            w: i64 = KeyWeight::weight(frame, first, key, last)
            return w

        # Frames after the scope are untouched.
        def zero_after(frame: i64, first: i64, key: i64, last: i64) -> i64:
            requires first >= 0
            requires first <= key
            requires key <= last
            requires last <= KeyWeight::Domain::MAX_FRAMES
            requires frame > last
            requires frame <= 2 * KeyWeight::Domain::MAX_FRAMES
            ensure result == 0
            w: i64 = KeyWeight::weight(frame, first, key, last)
            return w
