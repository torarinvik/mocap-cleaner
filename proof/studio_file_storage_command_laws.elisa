# Storage & Recovery stays available without a loaded take and is reachable
# from the File menu when take-dependent commands are disabled.
include "../src/studio/file_policy.elisa"

module StudioFileStorageCommandLaws:
    public:
        def storage_action_from_empty_workspace() -> i64:
            ensure result == StudioFilePolicy::Command.OPEN_STORAGE.i64()
            StudioFilePolicy::activate(6, false)

        def first_row_moves_down_to_load_character() -> i64:
            ensure result == StudioFilePolicy::Count::BASE_ROWS - 2
            StudioFilePolicy::next_enabled(0, 1, false, false, false)

        def first_row_moves_up_to_locate_workspace() -> i64:
            ensure result == 8
            StudioFilePolicy::next_enabled(0, -1, false, false, false)

        def disabled_row_forward_moves_to_load_character() -> i64:
            ensure result == 7
            StudioFilePolicy::next_enabled(2, 1, false, false, false)

        def disabled_row_backward_moves_to_open() -> i64:
            ensure result == 0
            StudioFilePolicy::next_enabled(2, -1, false, false, false)

        def pending_next_reaches_workspace_action() -> i64:
            ensure result == 8
            StudioFilePolicy::next_enabled(7, 1, false, false, true)

        def pending_next_reaches_explicit_create_action() -> i64:
            ensure result == 9
            StudioFilePolicy::next_enabled(8, 1, false, false, true)

        def pending_previous_skips_disabled_file_actions() -> i64:
            ensure result == 0
            StudioFilePolicy::next_enabled(7, -1, false, false, true)
