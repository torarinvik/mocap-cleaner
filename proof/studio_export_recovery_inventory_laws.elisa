include "../src/studio/export_recovery_inventory_policy.elisa"

module StudioExportRecoveryInventoryLaws:
    public:
        def negative_file_size_is_rejected(total: i64) -> bool:
            ensure not result
            StudioExportRecoveryInventoryPolicy::add_admitted(total, -1)

        def negative_total_is_rejected(bytes: i64) -> bool:
            ensure not result
            StudioExportRecoveryInventoryPolicy::add_admitted(-1, bytes)

        def empty_file_does_not_increase_total(total: i64) -> i64:
            requires total >= 0 and total <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES
            ensure result == total
            StudioExportRecoveryInventoryPolicy::next_total(total, 0)

        def observed_bytes_are_counted() -> i64:
            ensure result == 3
            StudioExportRecoveryInventoryPolicy::next_total(1, 2)

        def overflow_of_retention_limit_is_rejected() -> bool:
            ensure not result
            StudioExportRecoveryInventoryPolicy::add_admitted(1073741824, 1)

        def exact_retention_limit_is_admitted() -> bool:
            ensure result
            StudioExportRecoveryInventoryPolicy::add_admitted(1073741823, 1)
