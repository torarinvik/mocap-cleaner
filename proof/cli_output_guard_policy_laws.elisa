include "../src/cli/output_guard_policy.elisa"

module CliOutputGuardPolicyLaws:
    public:
        def descendant_is_under_build(root: darray[u8]&, name: darray[u8]&) -> bool:
            requires root.count > 1
            requires root[root.count - 1] != 47
            requires name.count > 0
            requires name[0] != 47
            ensure result
            mutable target: darray[u8] = []
            target.extend(root)
            target.push(47)
            target.extend(name)
            CliOutputGuardPolicy::file_is_under_build(root, target)

        def sibling_prefix_is_not_under_build(root: darray[u8]&, name: darray[u8]&) -> bool:
            requires root.count > 1
            requires root[root.count - 1] != 47
            requires name.count > 0
            requires name[0] != 47
            ensure not result
            mutable target: darray[u8] = []
            target.extend(root)
            target.extend(name)
            CliOutputGuardPolicy::file_is_under_build(root, target)

        def existing_outputs_are_rejected(target_exists: bool,
                                          target_is_symlink: bool,
                                          target_is_regular: bool) -> bool:
            requires target_exists
            ensure result
            CliOutputGuardPolicy::file_decision(true, true, false,
                target_exists, target_is_symlink, target_is_regular, false) != CliOutputGuardPolicy::Decision.Allow

        def source_aliases_are_rejected(target_exists: bool,
                                       target_is_symlink: bool,
                                       target_is_regular: bool) -> bool:
            requires target_exists
            ensure result
            CliOutputGuardPolicy::file_decision(true, true, true,
                target_exists, target_is_symlink, target_is_regular, false) == CliOutputGuardPolicy::Decision.SourceCollision

        def unresolved_paths_fail_closed() -> bool:
            ensure result
            CliOutputGuardPolicy::file_decision(false, true, false,
                false, false, false, false) == CliOutputGuardPolicy::Decision.PathUnresolved

        def studio_manifest_name_is_reserved(root: darray[u8]&) -> bool:
            requires root.count > 1
            ensure result
            mutable path: darray[u8] = []
            path.extend(root)
            path.push(47)
            path.extend("studio_storage_manifest.txt")
            CliOutputGuardPolicy::reserved_metadata_path(root, path)

        def reserved_metadata_destinations_are_rejected() -> bool:
            ensure result
            CliOutputGuardPolicy::file_decision(true, true, false,
                false, false, false, true) == CliOutputGuardPolicy::Decision.ReservedMetadata
