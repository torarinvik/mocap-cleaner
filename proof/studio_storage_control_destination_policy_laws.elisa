include "../src/studio/storage_control_destination_policy.elisa"

module StudioStorageControlDestinationPolicyLaws:
    public:
        def each_storage_control_can_write_verified_target(control: i64) -> bool:
            ensure result
            StudioStorageControlDestinationPolicy::may_write(control, true, false, false, true) == (control >= 0 and control < StudioStorageControlDestinationPolicy::CONTROL_COUNT)

        def canonical_destination_must_be_verified(control: i64) -> bool:
            ensure result
            not StudioStorageControlDestinationPolicy::may_write(control, false, false, false, true)

        def cross_metadata_path_conflict_blocks_write(control: i64) -> bool:
            ensure result
            not StudioStorageControlDestinationPolicy::may_write(control, true, true, false, true)

        def identity_alias_blocks_write(control: i64) -> bool:
            ensure result
            not StudioStorageControlDestinationPolicy::may_write(control, true, false, true, true)

        def unknown_filesystem_facts_block_write(control: i64) -> bool:
            ensure result
            not StudioStorageControlDestinationPolicy::may_write(control, true, false, false, false)

        def invalid_control_blocks_write(control: i64) -> bool:
            ensure result
            StudioStorageControlDestinationPolicy::valid_control(control) or not StudioStorageControlDestinationPolicy::may_write(control, true, false, false, true)

        def four_controls_are_distinct() -> bool:
            ensure result
            StudioStorageControlDestinationPolicy::CONTROL_MANIFEST == 0 and StudioStorageControlDestinationPolicy::CONTROL_PREFERENCES == 1 and StudioStorageControlDestinationPolicy::CONTROL_EXEMPTIONS == 2 and StudioStorageControlDestinationPolicy::CONTROL_PERSISTENT_LOCK == 3 and StudioStorageControlDestinationPolicy::CONTROL_COUNT == 4
