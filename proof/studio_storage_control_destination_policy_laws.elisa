include "../src/studio/storage_control_destination_policy.elisa"

module StudioStorageControlDestinationPolicyLaws:
    public:
        def exact_artifact_write_condition(canonical_verified: bool,
                                           any_reserved_path_match: bool,
                                           any_identity_alias: bool,
                                           identity_unknown: bool) -> bool:
            ensure result
            StudioStorageControlDestinationPolicy::may_write_artifact(canonical_verified, any_reserved_path_match, any_identity_alias, identity_unknown) == (canonical_verified and not any_reserved_path_match and not any_identity_alias and not identity_unknown)

        # The aggregated match covers manifest, preferences, exemptions, and
        # the persistent lock. Any other blocker is included in the same law.
        def a_write_requires_all_destination_facts(canonical_verified: bool,
                                                   any_reserved_path_match: bool,
                                                   any_identity_alias: bool,
                                                   identity_unknown: bool) -> bool:
            ensure result
            StudioStorageControlDestinationPolicy::may_write_artifact(canonical_verified, any_reserved_path_match, any_identity_alias, identity_unknown) or not canonical_verified or any_reserved_path_match or any_identity_alias or identity_unknown
