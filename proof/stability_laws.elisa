# Stability laws: the wring limit never touches in-limit motion, never pushes
# a value past where it was, and a zero-width limit still halves the excess.
include "../src/core/stability.elisa"

module StabilityLaws:
    public:
        const L: i64 = 1000000000

        def guard_is_fixed(guard: i64, limit: i64) -> i64:
            requires guard >= -L / 2
            requires guard <= L / 2
            requires limit >= 0
            requires limit <= L
            ensure result == guard
            return Stability::limit_wring(guard, guard, limit)

        def inside_untouched(deviation: i64, limit: i64) -> i64:
            requires limit >= 0
            requires limit <= L
            requires deviation >= -limit
            requires deviation <= limit
            ensure result == deviation
            return Stability::soften(deviation, limit)

        def above_stays_above_limit(deviation: i64, limit: i64) -> i64:
            requires limit >= 0
            requires limit <= L
            requires deviation > limit
            requires deviation <= L
            ensure result >= limit
            ensure result <= deviation
            return Stability::soften(deviation, limit)

        def below_stays_below_limit(deviation: i64, limit: i64) -> i64:
            requires limit >= 0
            requires limit <= L
            requires deviation < -limit
            requires deviation >= -L
            ensure result <= -limit
            ensure result >= deviation
            return Stability::soften(deviation, limit)

        def zero_is_zero(limit: i64) -> i64:
            requires limit >= 0
            requires limit <= L
            ensure result == 0
            return Stability::soften(0, limit)
