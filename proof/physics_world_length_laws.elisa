include "../src/physics/length_boundary.elisa"

module PhysicsWorldLengthLaws:
    public:
        def nonfinite_world_value_refused(value: f64) -> bool:
            requires value - value != 0.0
            ensure result
            not PhysicsLengthBoundary::world_admitted(value)

        def outside_world_domain_refused(value: f64) -> bool:
            requires value < -PhysicsLengthBoundary::Domain::MAX_METRES or value > PhysicsLengthBoundary::Domain::MAX_METRES
            ensure result
            not PhysicsLengthBoundary::world_admitted(value)

        def positive_world_boundary_exact() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(PhysicsLengthBoundary::Domain::MAX_METRES) == PhysicsLengthBoundary::Domain::MAX_COORDINATE

        def negative_world_boundary_exact() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(-PhysicsLengthBoundary::Domain::MAX_METRES) == -PhysicsLengthBoundary::Domain::MAX_COORDINATE

        def positive_half_unit_rounds_outward() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(0.00005) == 1

        def negative_half_unit_rounds_outward() -> bool:
            ensure result
            PhysicsLengthBoundary::from_metres(-0.00005) == -1

        def one_metre_inverse_exact() -> bool:
            ensure result
            PhysicsLengthBoundary::metres(LengthUnits::Scale::UNITS_PER_METRE) == 1.0
