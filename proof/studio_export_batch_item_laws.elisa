include "../src/studio/export_batch_item_policy.elisa"

module StudioExportBatchItemLaws:
    public:
        def new_item_is_valid() -> bool:
            ensure result
            StudioExportBatchItemPolicy::valid(StudioExportBatchQueuePolicy::ItemState.Queued, 0, false)

        def negative_warning_count_is_refused(state: StudioExportBatchQueuePolicy::ItemState, warning_count: i64, approved: bool) -> bool:
            requires warning_count < 0
            ensure result
            not StudioExportBatchItemPolicy::valid(state, warning_count, approved)

        def approval_requires_published_warning(state: StudioExportBatchQueuePolicy::ItemState, warning_count: i64) -> bool:
            requires state != StudioExportBatchQueuePolicy::ItemState.Warning
            ensure result
            not StudioExportBatchItemPolicy::valid(state, warning_count, true)

        def warning_state_requires_warning_evidence() -> bool:
            ensure result
            not StudioExportBatchItemPolicy::valid(StudioExportBatchQueuePolicy::ItemState.Warning, 0, true) and not StudioExportBatchItemPolicy::valid(StudioExportBatchQueuePolicy::ItemState.AwaitingReview, 0, false)

        def clean_publication_cannot_hide_warnings(warning_count: i64) -> bool:
            requires warning_count > 0
            ensure result
            not StudioExportBatchItemPolicy::valid(StudioExportBatchQueuePolicy::ItemState.Passed, warning_count, false)

        def reviewed_warning_is_valid(warning_count: i64) -> bool:
            requires warning_count > 0
            ensure result
            StudioExportBatchItemPolicy::valid(StudioExportBatchQueuePolicy::ItemState.Warning, warning_count, true)

        def failed_item_retains_warning_evidence(warning_count: i64) -> bool:
            requires warning_count >= 0
            ensure result
            StudioExportBatchItemPolicy::valid(StudioExportBatchQueuePolicy::ItemState.Failed, warning_count, false)
