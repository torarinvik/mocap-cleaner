# Contact laws ("contacts are sacred"): pinned feet sit exactly on the floor,
# feet in flight are untouched, and hysteresis never flickers inside the band.
include "../src/detect/contact.elisa"

module ContactLaws:
    public:
        # A planted foot's lowest point is at floor height.
        def planted_on_floor(lowest: i64, floor: i64) -> i64:
            ensure result == floor
            return Contact::pinned_height(true, lowest, floor)

        # A foot in the air keeps its height.
        def flight_untouched(lowest: i64, floor: i64) -> i64:
            ensure result == lowest
            return Contact::pinned_height(false, lowest, floor)

        # Inside the hysteresis band a planted, slow foot stays planted.
        def band_holds_plant(height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            requires height <= leave
            requires speed <= max_speed
            ensure result
            return Contact::step(true, height, speed, enter, leave, max_speed)

        # Inside the band (above enter) a lifted foot stays lifted.
        def band_holds_lift(height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            requires height > enter
            ensure not result
            return Contact::step(false, height, speed, enter, leave, max_speed)

        # A fast foot is never planted, whatever its height.
        def fast_is_lifted(planted: bool, height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            requires speed > max_speed
            ensure not result
            return Contact::step(planted, height, speed, enter, leave, max_speed)

        # Above `leave` nothing is planted.
        def high_is_lifted(planted: bool, height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            requires height > leave
            ensure not result
            return Contact::step(planted, height, speed, enter, leave, max_speed)

        # A slow foot below `enter` plants from either state.
        def low_slow_plants(planted: bool, height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            requires height <= enter
            requires speed <= max_speed
            ensure result
            return Contact::step(planted, height, speed, enter, leave, max_speed)
