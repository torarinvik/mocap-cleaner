include "../src/studio/state/generation_move_worker_policy.elisa"

module StudioGenerationMoveWorkerLaws:
    public:
        def retained_handle_blocks_discard(handle: i64, required: bool, recorded: bool) -> bool:
            requires handle != 0
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_discard_reply(handle, required, recorded)

        def unrecorded_recovery_blocks_discard() -> bool:
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_discard_reply(0, true, false)

        def closed_recorded_reply_can_be_discarded() -> bool:
            ensure result
            StudioGenerationMoveWorkerPolicy::may_discard_reply(0, true, true)

        def invalid_ticket_refused(ticket: i64, captured: bool, review: StudioGenerationReviewBindingPolicy::Review, retention: i64) -> bool:
            requires ticket <= 0
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_start(ticket, captured, review, retention)

        def invalid_capture_refused(ticket: i64, review: StudioGenerationReviewBindingPolicy::Review, retention: i64) -> bool:
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_start(ticket, false, review, retention)

        def stale_review_refused(ticket: i64, captured: bool, review: StudioGenerationReviewBindingPolicy::Review, retention: i64) -> bool:
            requires not StudioGenerationReviewBindingPolicy::review_current(review)
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_start(ticket, captured, review, retention)

        def different_retention_refused(ticket: i64, captured: bool, review: StudioGenerationReviewBindingPolicy::Review, retention: i64) -> bool:
            requires retention != review.reviewed_retention_days
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_start(ticket, captured, review, retention)

        def out_of_range_retention_refused(ticket: i64, captured: bool, review: StudioGenerationReviewBindingPolicy::Review, retention: i64) -> bool:
            requires retention < 0 or retention > StudioBuildGenerationCandidateProviderRetention::MAX_RETENTION_DAYS
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_start(ticket, captured, review, retention)

        def unknown_reservation_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires not intent.reserved.valid
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def missing_operation_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires not intent.operation_id_valid or intent.operation_id_bytes <= 0
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def wrong_phase_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires not intent.phase.known or intent.phase.phase != StudioBuildGenerationTrashPolicy::Phase.Intent
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def uncertain_move_can_be_reconciled() -> bool:
            ensure result
            StudioGenerationMoveWorkerPolicy::recoverable(StudioBuildGenerationTrashBindingPolicy::DecodedStatus{status: StudioBuildGenerationTrashNative::Status.DurabilityUnknown, known: true}, StudioBuildGenerationTrashBindingPolicy::DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Acquired, known: true}, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, true, 0)

        def missing_reconciliation_details_refuse(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure not result
            StudioGenerationMoveWorkerPolicy::recoverable(commit, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined, false, 0)

        def legacy_intent_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires intent.scope == StudioGenerationReceiptControlPolicy::Evidence.Legacy
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def unknown_scope_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires intent.scope == StudioGenerationReceiptControlPolicy::Evidence.Unknown
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def nondurable_intent_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires not intent.durable.value
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def unknown_durability_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires not intent.durable.valid
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def unreserved_operation_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires not intent.reserved.value
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def oversized_receipt_refused(intent: StudioGenerationMoveWorkerPolicy::Intent) -> bool:
            requires intent.receipt_bytes > StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES
            ensure not result
            StudioGenerationMoveWorkerPolicy::may_commit(intent)

        def retained_handle_cannot_report_recovery(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome, details: bool, handle: i64) -> bool:
            requires handle != 0
            ensure not result
            StudioGenerationMoveWorkerPolicy::recoverable(commit, release, outcome, details, handle)

        def unresolved_location_cannot_report_recovery(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus, details: bool) -> bool:
            ensure not result
            StudioGenerationMoveWorkerPolicy::recoverable(commit, release, StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown, details, 0)
