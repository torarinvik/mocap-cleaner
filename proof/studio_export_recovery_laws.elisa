include "../src/studio/export_recovery_policy.elisa"

module StudioExportRecoveryLaws:
    public:
        def verified_missing_report_is_admitted() -> bool:
            ensure result
            StudioExportRecoveryPolicy::retry_admitted(true, true, true, true, true, true)

        def missing_output_is_rejected(output_matches: bool, snapshot_valid: bool,
                                        workspace_matches: bool, report_missing: bool,
                                        operation_idle: bool) -> bool:
            ensure not result
            StudioExportRecoveryPolicy::retry_admitted(false, output_matches, snapshot_valid, workspace_matches, report_missing, operation_idle)

        def changed_output_is_rejected(output_exists: bool, snapshot_valid: bool,
                                        workspace_matches: bool, report_missing: bool,
                                        operation_idle: bool) -> bool:
            ensure not result
            StudioExportRecoveryPolicy::retry_admitted(output_exists, false, snapshot_valid, workspace_matches, report_missing, operation_idle)

        def invalid_snapshot_is_rejected(output_exists: bool, output_matches: bool,
                                          workspace_matches: bool, report_missing: bool,
                                          operation_idle: bool) -> bool:
            ensure not result
            StudioExportRecoveryPolicy::retry_admitted(output_exists, output_matches, false, workspace_matches, report_missing, operation_idle)

        def changed_workspace_is_rejected(output_exists: bool, output_matches: bool,
                                           snapshot_valid: bool, report_missing: bool,
                                           operation_idle: bool) -> bool:
            ensure not result
            StudioExportRecoveryPolicy::retry_admitted(output_exists, output_matches, snapshot_valid, false, report_missing, operation_idle)

        def existing_report_is_rejected(output_exists: bool, output_matches: bool,
                                        snapshot_valid: bool, workspace_matches: bool,
                                        operation_idle: bool) -> bool:
            ensure not result
            StudioExportRecoveryPolicy::retry_admitted(output_exists, output_matches, snapshot_valid, workspace_matches, false, operation_idle)

        def active_operation_is_rejected(output_exists: bool, output_matches: bool,
                                          snapshot_valid: bool, workspace_matches: bool,
                                          report_missing: bool) -> bool:
            ensure not result
            StudioExportRecoveryPolicy::retry_admitted(output_exists, output_matches, snapshot_valid, workspace_matches, report_missing, false)
