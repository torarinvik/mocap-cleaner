include "../src/studio/export_recovery_accessibility_text_policy.elisa"

module StudioExportRecoveryAccessibilityTextLaws:
    public:
        def ordinary_read_preserves_content_length(length: usize) -> bool:
            requires length <= StudioExportRecoveryAccessibilityTextPolicy::usable()
            ensure result
            StudioExportRecoveryAccessibilityTextPolicy::view_length(length, false) == length

        def truncated_read_stays_in_buffer(length: usize) -> bool:
            requires length <= StudioExportRecoveryAccessibilityTextPolicy::usable()
            ensure result
            StudioExportRecoveryAccessibilityTextPolicy::view_length(length, true) <= StudioExportRecoveryAccessibilityTextPolicy::Format::CAPACITY

        def full_content_and_notice_exactly_fill_buffer() -> bool:
            ensure result
            StudioExportRecoveryAccessibilityTextPolicy::view_length(StudioExportRecoveryAccessibilityTextPolicy::usable(), true) == StudioExportRecoveryAccessibilityTextPolicy::Format::CAPACITY
