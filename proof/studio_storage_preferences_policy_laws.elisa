include "../src/studio/storage_preferences_policy.elisa"

module StudioStoragePreferencesPolicyLaws:
    public:
        def encoded_preset_roundtrips(preset: i64) -> bool:
            requires preset >= 0 and preset <= 3
            ensure result
            # The two equalities establish the composition without nesting
            # helper-result terms in another helper's argument.
            StudioStoragePreferencesPolicy::encode_digit(preset) == preset + 48 and StudioStoragePreferencesPolicy::decode_digit(preset + 48) == preset

        def non_preset_digit_rejected(byte: i64) -> bool:
            requires byte < 48 or byte > 51
            ensure result
            StudioStoragePreferencesPolicy::decode_digit(byte) == -1

        def valid_file_preserves_choice(preset: i64) -> bool:
            requires preset >= 0 and preset <= 3
            ensure result
            StudioStoragePreferencesPolicy::loaded_preset(false, preset) == preset

        def first_use_has_default(decoded: i64) -> bool:
            ensure result
            StudioStoragePreferencesPolicy::loaded_preset(true, decoded) == 1

        def invalid_existing_file_is_not_default(decoded: i64) -> bool:
            requires decoded < 0 or decoded > 3
            ensure result
            StudioStoragePreferencesPolicy::loaded_preset(false, decoded) == -1

        def unreadable_settings_cannot_be_overwritten(path_verified: bool, preset: i64) -> bool:
            ensure result
            not StudioStoragePreferencesPolicy::may_publish(false, path_verified, preset)

        def unverified_path_cannot_be_written(read_valid: bool, preset: i64) -> bool:
            ensure result
            not StudioStoragePreferencesPolicy::may_publish(read_valid, false, preset)

        def unsupported_choice_cannot_be_written(read_valid: bool, path_verified: bool, preset: i64) -> bool:
            requires preset < 0 or preset > 3
            ensure result
            not StudioStoragePreferencesPolicy::may_publish(read_valid, path_verified, preset)
