include "../src/studio/export_batch_recovery_policy.elisa"

module StudioExportBatchRecoveryPolicyLaws:
    public:
        def interrupted_running_is_recoverable() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(true, true, true, true, true, false, false, false, false, false, false, false, 0)
            item.state == StudioExportBatchQueuePolicy::ItemState.Recoverable and not item.approved

        def modified_source_never_restores_success() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(false, true, false, true, true, true, false, true, true, true, false, false, 0)
            item.state == StudioExportBatchQueuePolicy::ItemState.Recoverable and not item.approved

        def exact_completed_clean_outputs_are_rechecked() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(false, true, true, true, true, true, false, true, true, true, false, true, 0)
            item.state == StudioExportBatchQueuePolicy::ItemState.Passed and not item.approved

        def exact_completed_warning_outputs_still_need_review() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(false, true, true, true, true, true, false, true, true, true, false, true, 2)
            item.state == StudioExportBatchQueuePolicy::ItemState.Warning and not item.approved and item.warning_count == 2

        def conflicting_sidecar_never_restores_success() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(false, true, true, true, true, true, false, true, false, true, false, true, 0)
            item.state == StudioExportBatchQueuePolicy::ItemState.Recoverable

        def exact_unpublished_result_returns_to_review() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(false, true, true, true, true, true, true, false, false, false, true, true, 1)
            item.state == StudioExportBatchQueuePolicy::ItemState.AwaitingReview and not item.approved

        def missing_warning_parser_never_restores_final_success() -> bool:
            ensure result
            item: StudioExportBatchQueue::Item = StudioExportBatchRecoveryPolicy::item_after_reopen(false, true, true, true, true, true, false, true, true, true, false, false, 0)
            item.state == StudioExportBatchQueuePolicy::ItemState.Recoverable and not item.approved
