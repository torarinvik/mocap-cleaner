# Timestamp status rejects malformed clock facts and reports future receipts;
# bounded recent differences count completed days and old receipts clamp.
include "../src/studio/storage_age_policy.elisa"

module StudioStorageAgePolicyLaws:
    public:
        def valid_timestamp_is_current(modified_seconds: i64, current_seconds: i64) -> bool:
            requires modified_seconds >= 0 - StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_seconds
            requires current_seconds >= 0
            requires current_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            ensure result
            StudioStorageAgePolicy::timestamp_status(modified_seconds, current_seconds) == StudioStorageAgePolicy::STATUS_VALID

        def negative_clock_is_invalid(modified_seconds: i64, current_seconds: i64) -> bool:
            requires current_seconds < 0
            ensure result
            StudioStorageAgePolicy::timestamp_status(modified_seconds, current_seconds) == StudioStorageAgePolicy::STATUS_INVALID

        def future_receipt_is_reported(modified_seconds: i64, current_seconds: i64) -> bool:
            requires modified_seconds >= 0 - StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires current_seconds >= 0
            requires current_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds > current_seconds
            ensure result
            StudioStorageAgePolicy::timestamp_status(modified_seconds, current_seconds) == StudioStorageAgePolicy::STATUS_FUTURE

        def timestamp_below_bound_is_invalid(current_seconds: i64) -> bool:
            requires current_seconds >= 0
            requires current_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            ensure result
            StudioStorageAgePolicy::timestamp_status(0 - StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS - 1, current_seconds) == StudioStorageAgePolicy::STATUS_INVALID

        def valid_age_is_clamped(modified_seconds: i64, current_seconds: i64) -> bool:
            requires modified_seconds >= 0 - StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires current_seconds >= 0
            requires current_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_seconds
            ensure result
            age: i64 = StudioStorageAgePolicy::completed_age_days(modified_seconds, current_seconds)
            age >= 0 and age <= StudioStorageAgePolicy::MAX_AGE_DAYS

        def completed_age_saturation_contract(modified_seconds: i64, current_seconds: i64) -> bool:
            requires modified_seconds >= 0 - StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires current_seconds >= 0
            requires current_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_seconds
            ensure result
            age: i64 = StudioStorageAgePolicy::completed_age_days(modified_seconds, current_seconds)
            age == StudioStorageAgePolicy::MAX_AGE_DAYS or modified_seconds > current_seconds - StudioStorageAgePolicy::MAX_AGE_SECONDS

        def timestamp_above_bound_is_invalid(current_seconds: i64) -> bool:
            requires current_seconds >= 0
            requires current_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            ensure result
            StudioStorageAgePolicy::timestamp_status(StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS + 1, current_seconds) == StudioStorageAgePolicy::STATUS_INVALID

        def clock_above_bound_is_invalid(modified_seconds: i64) -> bool:
            requires modified_seconds >= 0 - StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS
            ensure result
            StudioStorageAgePolicy::timestamp_status(modified_seconds, StudioStorageAgePolicy::MAX_TIMESTAMP_SECONDS + 1) == StudioStorageAgePolicy::STATUS_INVALID
