include "../src/studio/timeline_clock_policy.elisa"

module StudioTimelineClockLaws:
    public:
        def invalid_rate_refused() -> bool:
            ensure result
            not StudioTimelineClockPolicy::rate_valid(0) and not StudioTimelineClockPolicy::rate_valid(1001)

        def supported_rate(rate: i64) -> bool:
            requires rate >= 1 and rate <= 1000
            ensure result
            StudioTimelineClockPolicy::rate_valid(rate)

        def start_at_24fps() -> bool:
            ensure result
            StudioTimelineClockPolicy::frame_start_us(1, 24) == 41667

        def start_at_120fps() -> bool:
            ensure result
            StudioTimelineClockPolicy::frame_start_us(1, 120) == 8334

        def rounded_start_selects_24fps_frame() -> bool:
            ensure result
            StudioTimelineClockPolicy::frame_at_us(41666, 24, 100) == 0 and StudioTimelineClockPolicy::frame_at_us(41667, 24, 100) == 1

        def one_second_duration() -> bool:
            ensure result
            StudioTimelineClockPolicy::duration_us(24, 24) == 1000000 and StudioTimelineClockPolicy::duration_us(120, 120) == 1000000

        def slow_maximum_clip_duration() -> bool:
            ensure result
            StudioTimelineClockPolicy::duration_us(10000000, 1) == 10000000000000

        def clip_end_clamps() -> bool:
            ensure result
            StudioTimelineClockPolicy::frame_at_us(1000000, 24, 24) == 23

        def short_loop_preserves_phase() -> bool:
            ensure result
            StudioTimelineClockPolicy::loop_time(250123, 1000) == 123

        def paused_phase_inside_loop() -> bool:
            ensure result
            StudioTimelineClockPolicy::loop_time(123, 1000) == 123
