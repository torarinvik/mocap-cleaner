include "../src/studio/export_batch_publication_policy.elisa"

module StudioExportBatchPublicationLaws:
    public:
        def synced_create_is_verified() -> bool:
            ensure result
            StudioExportBatchPublication::stage_for_native_status(1) == StudioExportBatchPublication::ArtifactStage.PublishedDirectorySynced and StudioExportBatchPublication::native_bytes_verified(1)

        def uncertain_create_keeps_exact_bytes_distinct_from_durability() -> bool:
            ensure result
            StudioExportBatchPublication::stage_for_native_status(2) == StudioExportBatchPublication::ArtifactStage.PublishedDurabilityUnknown and StudioExportBatchPublication::native_bytes_verified(2)

        def exact_existing_is_verified_without_overwrite_claim() -> bool:
            ensure result
            StudioExportBatchPublication::stage_for_native_status(3) == StudioExportBatchPublication::ArtifactStage.ExistingExact and StudioExportBatchPublication::native_bytes_verified(3)

        def partial_file_is_never_reported_exact() -> bool:
            ensure result
            StudioExportBatchPublication::stage_for_native_status(4) == StudioExportBatchPublication::ArtifactStage.ConflictingOrUnavailable and not StudioExportBatchPublication::native_bytes_verified(4)

        def no_publication_is_never_reported_exact() -> bool:
            ensure result
            StudioExportBatchPublication::stage_for_native_status(0) == StudioExportBatchPublication::ArtifactStage.ConflictingOrUnavailable and not StudioExportBatchPublication::native_bytes_verified(0)
