include "../src/studio/state/generation_review_accessibility_policy.elisa"

module StudioGenerationReviewAccessibilityLaws:
    public:
        def row_ids_round_trip(slot: usize) -> bool:
            requires slot < StudioGenerationReviewAccessibilityPolicy::Node::ROW_COUNT.usize()
            ensure StudioGenerationReviewAccessibilityPolicy::row_slot(StudioGenerationReviewAccessibilityPolicy::row_id(slot)) == slot.i64()
            StudioGenerationReviewAccessibilityPolicy::row_slot(StudioGenerationReviewAccessibilityPolicy::row_id(slot)) == slot.i64()

        def storage_entry_is_unavailable_outside_storage() -> bool:
            ensure not StudioGenerationReviewAccessibilityPolicy::entry_enabled(false, false, false)
            StudioGenerationReviewAccessibilityPolicy::entry_enabled(false, false, false)

        def storage_entry_is_hidden_while_modal_open() -> bool:
            ensure not StudioGenerationReviewAccessibilityPolicy::entry_enabled(true, true, false)
            StudioGenerationReviewAccessibilityPolicy::entry_enabled(true, true, false)

        def storage_entry_is_disabled_during_cleanup() -> bool:
            ensure not StudioGenerationReviewAccessibilityPolicy::entry_enabled(true, false, true)
            StudioGenerationReviewAccessibilityPolicy::entry_enabled(true, false, true)

        def modal_consumes_every_widget_event() -> bool:
            ensure StudioGenerationReviewAccessibilityPolicy::consumes_widget_event(true)
            StudioGenerationReviewAccessibilityPolicy::consumes_widget_event(true)

        def previous_disables_on_first_page(pages: i64) -> bool:
            requires pages > 0
            ensure not StudioGenerationReviewAccessibilityPolicy::action_enabled(StudioGenerationReviewAccessibilityPolicy::Action.Previous, 0, pages)
            StudioGenerationReviewAccessibilityPolicy::action_enabled(StudioGenerationReviewAccessibilityPolicy::Action.Previous, 0, pages)

        def next_disables_at_last_page(page: i64, pages: i64) -> bool:
            requires pages > 0 and page == pages - 1
            ensure not StudioGenerationReviewAccessibilityPolicy::action_enabled(StudioGenerationReviewAccessibilityPolicy::Action.Next, page, pages)
            StudioGenerationReviewAccessibilityPolicy::action_enabled(StudioGenerationReviewAccessibilityPolicy::Action.Next, page, pages)

        def action_ids_are_unique() -> bool:
            ensure StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Previous) != StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Next)
            ensure StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Next) != StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Refresh)
            ensure StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Refresh) != StudioGenerationReviewAccessibilityPolicy::action_id(StudioGenerationReviewAccessibilityPolicy::Action.Back)
            true

        def modal_tree_orders_controls_after_inspection() -> bool:
            ensure StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::Node::DETAILS, 0) == StudioGenerationReviewAccessibilityPolicy::Node::PREVIOUS
            ensure StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::Node::PREVIOUS, 0) == StudioGenerationReviewAccessibilityPolicy::Node::NEXT
            ensure StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::Node::REFRESH, 0) == StudioGenerationReviewAccessibilityPolicy::Node::BACK
            true

        def final_row_has_no_row_sibling() -> bool:
            requires StudioGenerationReviewAccessibilityPolicy::Node::ROW_COUNT > 0
            ensure StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::row_id((StudioGenerationReviewAccessibilityPolicy::Node::ROW_COUNT - 1).usize()), StudioGenerationReviewAccessibilityPolicy::Node::ROW_COUNT) == StudioAccessibility::SemanticId::NO_NODE
            StudioGenerationReviewAccessibilityPolicy::next_sibling(StudioGenerationReviewAccessibilityPolicy::row_id((StudioGenerationReviewAccessibilityPolicy::Node::ROW_COUNT - 1).usize()), StudioGenerationReviewAccessibilityPolicy::Node::ROW_COUNT) == StudioAccessibility::SemanticId::NO_NODE

        def storage_entry_is_child_of_storage_dialog() -> bool:
            ensure StudioGenerationReviewAccessibilityPolicy::parent(StudioGenerationReviewAccessibilityPolicy::Node::STORAGE_ENTRY) == StudioStorageAccessibilityPolicy::Node::DIALOG
            StudioGenerationReviewAccessibilityPolicy::parent(StudioGenerationReviewAccessibilityPolicy::Node::STORAGE_ENTRY) == StudioStorageAccessibilityPolicy::Node::DIALOG
