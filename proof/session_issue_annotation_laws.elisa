# Persisted ignore intent is valid only for bounded complete findings and
# restores only when the whole stable analysis record matches.
include "../src/studio/state/session_issue_annotation_policy.elisa"

module SessionIssueAnnotationLaws:
    public:
        def valid_record_stays_within_analysis(record: SessionIssueAnnotationPolicy::Record, frames: i64) -> bool:
            requires frames >= 1
            requires frames <= SessionIssueAnnotationPolicy::MAX_FRAMES
            requires record.first_frame >= 0
            requires record.first_frame <= record.peak_frame
            requires record.peak_frame <= record.last_frame
            requires record.last_frame < frames
            ensure result
            record.first_frame >= 0 and record.first_frame <= record.peak_frame and record.peak_frame <= record.last_frame and record.last_frame < frames

        def exact_analysis_record_matches(a: SessionIssueAnnotationPolicy::Record, b: SessionIssueAnnotationPolicy::Record) -> bool:
            requires a.first_frame == b.first_frame
            requires a.last_frame == b.last_frame
            requires a.issue_type == b.issue_type
            requires a.subject_id == b.subject_id
            requires a.peak_frame == b.peak_frame
            requires a.severity == b.severity
            requires a.peak_value == b.peak_value
            requires a.threshold == b.threshold
            ensure result
            SessionIssueAnnotationPolicy::same_analysis(a, b)

        def persisted_record_capacity_bound(count: i64) -> bool:
            requires count >= 0
            requires count <= SessionIssueAnnotationPolicy::MAX_RECORDS
            ensure result
            count >= 0 and count <= SessionIssueAnnotationPolicy::MAX_RECORDS
