include "../src/studio/state/generation_review_list_policy.elisa"

module StudioGenerationReviewListLaws:
    public:
        def empty_list_has_no_target(page: i64, slot: i64) -> bool:
            ensure result
            StudioGenerationReviewListPolicy::inspection_target(0, page, slot) == -1

        def overflow_list_has_no_target(count: i64, page: i64, slot: i64) -> bool:
            requires count > StudioGenerationReviewListPolicy::Limit::ROWS
            ensure result
            StudioGenerationReviewListPolicy::inspection_target(count, page, slot) == -1

        def negative_slot_refused(count: i64, page: i64, slot: i64) -> bool:
            requires slot < 0
            ensure result
            StudioGenerationReviewListPolicy::inspection_target(count, page, slot) == -1

        def partial_last_page_preserves_last_row() -> bool:
            ensure result
            StudioGenerationReviewListPolicy::visible_rows(33, 2) == 1 and StudioGenerationReviewListPolicy::inspection_target(33, 2, 0) == 32 and StudioGenerationReviewListPolicy::inspection_target(33, 2, 1) == -1

        def maximum_last_row_reachable() -> bool:
            ensure result
            StudioGenerationReviewListPolicy::inspection_target(512, 31, 15) == 511

        def protected_row_cannot_be_reviewed(complete: bool, valid: bool, current: bool, busy: bool) -> bool:
            ensure not result
            StudioGenerationReviewListPolicy::may_review(complete, valid, false, current, busy)

        def stale_scan_cannot_be_reviewed(complete: bool, valid: bool, eligible: bool, busy: bool) -> bool:
            ensure not result
            StudioGenerationReviewListPolicy::may_review(complete, valid, eligible, false, busy)

        def busy_transaction_cannot_be_reviewed(complete: bool, valid: bool, eligible: bool, current: bool) -> bool:
            ensure not result
            StudioGenerationReviewListPolicy::may_review(complete, valid, eligible, current, true)
