include "../src/studio/session_locate_accessibility_policy.elisa"

module StudioSessionLocateAccessibilityPolicyLaws:
    public:
        def semantic_range_is_reserved() -> bool:
            ensure result
            StudioSessionLocateAccessibilityPolicy::ids_fit_reserved_range()

        def dialog_is_root() -> bool:
            ensure result
            parent: usize = StudioSessionLocateAccessibilityPolicy::parent_id(StudioSessionLocateAccessibilityPolicy::Node::DIALOG)
            parent == StudioAccessibility::SemanticId::NO_NODE

        def choices_share_dialog_parent() -> bool:
            ensure result
            StudioSessionLocateAccessibilityPolicy::parent_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.Locate)) == StudioSessionLocateAccessibilityPolicy::Node::DIALOG and StudioSessionLocateAccessibilityPolicy::parent_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.RestoreSession)) == StudioSessionLocateAccessibilityPolicy::Node::DIALOG and StudioSessionLocateAccessibilityPolicy::parent_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.OpenAsNewTake)) == StudioSessionLocateAccessibilityPolicy::Node::DIALOG and StudioSessionLocateAccessibilityPolicy::parent_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.Cancel)) == StudioSessionLocateAccessibilityPolicy::Node::DIALOG

        def choice_siblings_are_stable() -> bool:
            ensure result
            StudioSessionLocateAccessibilityPolicy::next_sibling_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.Locate)) == StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.OpenAsNewTake) and StudioSessionLocateAccessibilityPolicy::next_sibling_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.OpenAsNewTake)) == StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.RestoreSession) and StudioSessionLocateAccessibilityPolicy::next_sibling_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.RestoreSession)) == StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.Cancel) and StudioSessionLocateAccessibilityPolicy::next_sibling_id(StudioSessionLocateAccessibilityPolicy::choice_id(StudioSessionLocatePolicy::Choice.Cancel)) == StudioAccessibility::SemanticId::NO_NODE

        def unknown_node_has_no_choice(id: usize) -> bool:
            requires id < StudioSessionLocateAccessibilityPolicy::Node::CHOICE_FIRST or id > StudioSessionLocateAccessibilityPolicy::Node::LAST
            ensure result
            StudioSessionLocateAccessibilityPolicy::choice_for_id(id) == null
