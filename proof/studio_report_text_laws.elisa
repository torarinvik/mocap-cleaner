include "../src/studio/report_text_policy.elisa"

module StudioReportTextLaws:
    public:
        def last_slot_fits() -> bool:
            ensure result
            StudioReportTextPolicy::offset(95) + 512 == 49152

        def last_slot_wraps() -> bool:
            ensure result
            StudioReportTextPolicy::next_slot(95) == 0

        def advancing_is_nonnegative(slot: i64) -> bool:
            requires slot >= 0 and slot < StudioReportTextPolicy::Buffer::SLOTS
            ensure result
            StudioReportTextPolicy::next_slot(slot) >= 0

        def advancing_is_below_capacity(slot: i64) -> bool:
            requires slot >= 0 and slot < StudioReportTextPolicy::Buffer::SLOTS
            ensure result
            StudioReportTextPolicy::next_slot(slot) < StudioReportTextPolicy::Buffer::SLOTS
