include "../src/studio/report_text_policy.elisa"

module StudioReportTextLaws:
    public:
        def last_slot_fits() -> bool:
            ensure result
            StudioReportTextPolicy::offset(159) + 512 == 81920

        def last_slot_wraps() -> bool:
            ensure result
            StudioReportTextPolicy::next_slot(159) == 0

        def advancing_is_nonnegative(slot: i64) -> bool:
            requires slot >= 0 and slot < StudioReportTextPolicy::Buffer::SLOTS
            ensure result
            StudioReportTextPolicy::next_slot(slot) >= 0

        def advancing_is_below_capacity(slot: i64) -> bool:
            requires slot >= 0 and slot < StudioReportTextPolicy::Buffer::SLOTS
            ensure result
            StudioReportTextPolicy::next_slot(slot) < StudioReportTextPolicy::Buffer::SLOTS

        def full_stack_views_fit() -> bool:
            ensure result
            StudioReportTextPolicy::stack_counts_admitted(16, 8, 32, 16)

        def zero_bits_are_zero() -> bool:
            ensure result
            StudioReportTextPolicy::bits_integer(0) == 0

        def highest_bits_stay_positive() -> bool:
            ensure result
            StudioReportTextPolicy::bits_integer(4294967295) == 4294967295

        def arbitrary_bits_fit(value: u32) -> bool:
            ensure result
            captured: i64 = StudioReportTextPolicy::bits_integer(value)
            captured >= 0 and captured <= 4294967295

        def oversized_contacts_are_rejected(operations: i64, bands: i64, corrections: i64) -> bool:
            ensure not result
            StudioReportTextPolicy::stack_counts_admitted(operations, bands, 33, corrections)

        def negative_corrections_are_rejected(operations: i64, bands: i64, contacts: i64) -> bool:
            ensure not result
            StudioReportTextPolicy::stack_counts_admitted(operations, bands, contacts, -1)
