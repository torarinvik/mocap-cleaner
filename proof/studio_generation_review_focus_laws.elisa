include "../src/studio/state/generation_review_focus_policy.elisa"

module StudioGenerationReviewFocusLaws:
    public:
        def forward_tab_skips_disabled_targets(enabled: darray[bool]&) -> bool:
            requires enabled.count.i64() == StudioGenerationReviewFocusPolicy::Limit::COUNT
            requires not enabled[0] and enabled[1]
            ensure StudioGenerationReviewFocusPolicy::next(-1, false, enabled) == 1
            StudioGenerationReviewFocusPolicy::next(-1, false, enabled) == 1

        def reverse_tab_wraps_to_last_enabled(enabled: darray[bool]&) -> bool:
            requires enabled.count.i64() == StudioGenerationReviewFocusPolicy::Limit::COUNT
            requires enabled[7] and not enabled[0] and not enabled[1] and not enabled[2] and not enabled[3] and not enabled[4] and not enabled[5] and not enabled[6]
            ensure StudioGenerationReviewFocusPolicy::next(0, true, enabled) == 7
            StudioGenerationReviewFocusPolicy::next(0, true, enabled) == 7

        def no_enabled_targets_clears_focus(enabled: darray[bool]&) -> bool:
            requires enabled.count.i64() == StudioGenerationReviewFocusPolicy::Limit::COUNT
            requires not enabled[0] and not enabled[1] and not enabled[2] and not enabled[3] and not enabled[4] and not enabled[5] and not enabled[6] and not enabled[7]
            ensure StudioGenerationReviewFocusPolicy::next(3, false, enabled) == -1
            StudioGenerationReviewFocusPolicy::next(3, false, enabled) == -1

        def path_open_and_close_round_trips_trigger_focus() -> bool:
            ensure StudioGenerationReviewFocusPolicy::trigger_focus(StudioGenerationReviewFocusPolicy::Limit::PATH) == StudioGenerationReviewFocusPolicy::Limit::PATH
            ensure StudioGenerationReviewFocusPolicy::restore_focus(StudioGenerationReviewFocusPolicy::trigger_focus(StudioGenerationReviewFocusPolicy::Limit::PATH)) == StudioGenerationReviewFocusPolicy::Limit::PATH
            StudioGenerationReviewFocusPolicy::restore_focus(StudioGenerationReviewFocusPolicy::trigger_focus(StudioGenerationReviewFocusPolicy::Limit::PATH)) == StudioGenerationReviewFocusPolicy::Limit::PATH
