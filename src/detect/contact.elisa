# Foot-contact classification from fixed-point heights (0.1 mm units) and
# horizontal speeds (mm/s). Hysteresis keeps a contact from flickering: a foot
# plants below `enter` and lifts only above `leave`.
module Contact:
    public:
        const LIMIT: i64 = 1000000000

        def valid_thresholds(enter: i64, leave: i64, speed: i64) -> bool:
            ensure not result or enter <= leave
            ensure not result or enter >= 0
            ensure not result or speed >= 0
            return enter >= 0 and enter <= leave and leave <= LIMIT and speed >= 0 and speed <= LIMIT

        # Next contact state from the previous state and this frame's measurements.
        def step(planted: bool, height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            ensure not result or height <= leave
            ensure not result or speed <= max_speed
            ensure planted or not result or height <= enter
            ensure not planted or height > leave or speed > max_speed or result
            ensure planted or height > enter or speed > max_speed or result
            return false if speed > max_speed
            return height <= leave if planted
            return height <= enter

        # A planted foot's corrected height: its lowest point sits on the floor.
        def pinned_height(planted: bool, lowest: i64, floor: i64) -> i64:
            ensure not planted or result == floor
            ensure planted or result == lowest
            return floor if planted
            return lowest
