# Foot-contact classification from fixed-point heights (0.1 mm units) and
# horizontal speeds (mm/s). Hysteresis keeps a contact from flickering: a foot
# plants below `enter` and lifts only above `leave`.
module Contact:
    public:
        const LIMIT: i64 = 1000000000

        def valid_thresholds(enter: i64, leave: i64, speed: i64) -> bool:
            ensure not result or enter <= leave
            ensure not result or enter >= 0
            ensure not result or speed >= 0
            return enter >= 0 and enter <= leave and leave <= LIMIT and speed >= 0 and speed <= LIMIT

        # Next contact state from the previous state and this frame's measurements.
        def step(planted: bool, height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            requires enter <= leave
            ensure not result or height <= leave
            ensure not result or speed <= max_speed
            ensure planted or not result or height <= enter
            ensure not planted or height > leave or speed > max_speed or result
            ensure planted or height > enter or speed > max_speed or result
            return false if speed > max_speed
            return height <= leave if planted
            return height <= enter

        # A planted foot's corrected height: its lowest point sits on the floor.
        def pinned_height(planted: bool, lowest: i64, floor: i64) -> i64:
            ensure not planted or result == floor
            ensure planted or result == lowest
            return floor if planted
            return lowest

        # A hand edit of the contact track: frames first..last are forced to
        # `planted`; every other frame keeps the detected state.
        def edited(detected: bool, frame: i64, first: i64, last: i64, planted: bool) -> bool:
            ensure frame >= first or result == detected
            ensure frame <= last or result == detected
            ensure frame < first or frame > last or result == planted
            return planted if frame >= first and frame <= last
            return detected

        # Contact debounce. Detected contacts chatter where a foot hovers at
        # the threshold: a one-frame plant between two short lifts. Locking
        # such a frame jerks the leg, so before locking, a lift of at most
        # `max_gap` frames between two plants is filled, then a plant of at
        # most `max_blip` frames is dropped. Runs at the clip's ends are never
        # filled (the foot may be leaving or arriving off-clip).
        const module Debounce:
            GAP_MS: i64 = 70
            BLIP_MS: i64 = 50
            MAX_FRAMES: i64 = 64

        # A duration in milliseconds as a frame count at `fps`, rounded down
        # and kept within [0, Debounce::MAX_FRAMES].
        def frames_of(ms: i64, fps: i64) -> i64:
            requires ms >= 0
            requires ms <= 1000
            ensure result >= 0
            ensure result <= Debounce::MAX_FRAMES
            return 0 if fps <= 0 or fps > 100000
            n: i64 = ms * fps / 1000
            return Debounce::MAX_FRAMES if n > Debounce::MAX_FRAMES
            return 0 if n < 0
            return n

        # Whether a lift run of `length` frames is filled: only between two
        # plants and only when short.
        def fills_gap(length: i64, bounded: bool, max_gap: i64) -> bool:
            ensure not result or bounded
            ensure not result or length <= max_gap
            ensure not bounded or length > max_gap or result
            return bounded and length <= max_gap

        # Whether a plant run of `length` frames is dropped.
        def drops_blip(length: i64, max_blip: i64) -> bool:
            ensure not result or length <= max_blip
            ensure length > max_blip or result
            return length <= max_blip
