# Spike detector: second difference of a fixed-point track, i.e. acceleration
# per frame squared. Large values are twitches the de-spike tool should remove.
module Spike:
    public:
        const LIMIT: i64 = 1000000000000

        def accel(prev: i64, now: i64, next: i64) -> i64:
            requires prev >= -LIMIT
            requires prev <= LIMIT
            requires now >= -LIMIT
            requires now <= LIMIT
            requires next >= -LIMIT
            requires next <= LIMIT
            ensure result >= -4 * LIMIT
            ensure result <= 4 * LIMIT
            ensure prev != now or now != next or result == 0
            return prev - 2 * now + next

        def magnitude(value: i64) -> i64:
            requires value >= -4 * LIMIT
            requires value <= 4 * LIMIT
            ensure result >= 0
            ensure result == value or result == -value
            return -value if value < 0
            return value

        # A frame is a spike when its acceleration exceeds the threshold and it
        # reverses (out-and-back), unlike a deliberate turn.
        def is_spike(prev: i64, now: i64, next: i64, threshold: i64) -> bool:
            requires prev >= -LIMIT
            requires prev <= LIMIT
            requires now >= -LIMIT
            requires now <= LIMIT
            requires next >= -LIMIT
            requires next <= LIMIT
            requires threshold >= 0
            ensure not result or prev != now or now != next
            out: i64 = now - prev
            back: i64 = next - now
            return false if out == 0 or back == 0
            return false if (out > 0) == (back > 0)
            size: i64 = magnitude(accel(prev, now, next))
            return size > threshold
