# Report diff: compare two JSON reports per clip and metric (Phase 6).
# Direct root scalar members belong to "total". Direct members of named
# objects in the root "clips" array belong to that clip. Nested metadata and
# timing values are skipped using the engine JSON token subtree boundaries.
# Lower-is-better metrics: keys ending in _after or _after_um, plus
# unbalanced_frames and unbalanced_runs. "ok" turning false regresses, and so
# does a metric or clip missing from b. The verdict is Regress::verdict.
include "../core/regress.elisa"
include "../core/report_budget.elisa"
include "../core/report_decimal.elisa"
include "../../../elisa-engine-mocap/src/assets/glb_json.elisa"
include "report.elisa"
include "json_string.elisa"
include "report_diff_html.elisa"
include "console.elisa"

@link_name("fgetc")
extern d_fgetc(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("ferror")
extern d_ferror(file: mutable heap void&) -> i32 can[Blocking.IO]

module ReportDiff:
    private:
        struct Metric:
            clip_at: i64
            clip_len: i64
            key_at: i64
            key_len: i64
            value: i64
            flag: bool
            exact_integer: bool

        struct Identity:
            at: i64
            len: i64

        def member_count(text: darray[u8]&, tokens: darray[GlbJson::Token]&, object: usize, key: sview) -> i64:
            ensure result >= 0
            mutable count: i64 = 0
            mutable at: usize = object + 1
            for member in 0..<tokens[object].size:
                count <- count + 1 if decoded_key_is(text, tokens[at], key)
                at <- tokens[at + 1].after
            count

        def bounded(value: i64) -> i64:
            ensure result >= 0 - Regress::Domain::MAGNITUDE
            ensure result <= Regress::Domain::MAGNITUDE
            return Regress::Domain::MAGNITUDE if value > Regress::Domain::MAGNITUDE
            return 0 - Regress::Domain::MAGNITUDE if value < 0 - Regress::Domain::MAGNITUDE
            return value

        def tolerance(permille: i64) -> i64:
            ensure result >= 0
            ensure result <= Regress::Domain::TOLERANCE_PERMILLE
            return Regress::Domain::TOLERANCE_PERMILLE if permille > Regress::Domain::TOLERANCE_PERMILLE
            return 0 if permille < 0
            return permille

        def floor_of(value: i64) -> i64:
            ensure result >= 0
            ensure result <= Regress::Domain::MAGNITUDE
            return Regress::Domain::MAGNITUDE if value > Regress::Domain::MAGNITUDE
            return 0 if value < 0
            return value

        def ends_with(pool: darray[u8]&, at: i64, len: i64, s: sview) -> bool:
            mutable n: i64 = 0
            for c in s:
                n <- n + 1
            return false if n > len
            mutable i: i64 = 0
            for c in s:
                return false if pool[(at + len - n + i).usize()] != c
                i <- i + 1
            return true

        def is_text(pool: darray[u8]&, at: i64, len: i64, s: sview) -> bool:
            mutable n: i64 = 0
            for c in s:
                n <- n + 1
            return false if n != len
            return ends_with(pool, at, len, s)

        def lower_better(pool: darray[u8]&, m: Metric) -> bool:
            return true if ends_with(pool, m.key_at, m.key_len, "_after")
            return true if ends_with(pool, m.key_at, m.key_len, "_after_um")
            return true if is_text(pool, m.key_at, m.key_len, "unbalanced_frames")
            return is_text(pool, m.key_at, m.key_len, "unbalanced_runs")

        def same_span(pa: darray[u8]&, a_at: i64, a_len: i64, pb: darray[u8]&, b_at: i64, b_len: i64) -> bool:
            return false if a_len != b_len
            for i in 0..<a_len.usize():
                return false if pa[a_at.usize() + i] != pb[b_at.usize() + i]
            return true

        def is_space(c: u8) -> bool:
            return c == 32 or c == 10 or c == 13 or c == 9

        def copy_string(text: darray[u8]&, token: GlbJson::Token, pool: mutable darray[u8]&) -> i64:
            start: i64 = pool.count.i64()
            return -1 if not JsonString::decode(text, token.start, token.stop, pool)
            pool.count.i64() - start

        def decoded_key_is(text: darray[u8]&, token: GlbJson::Token, key: sview) -> bool:
            mutable decoded: darray[u8] = []
            return false if not JsonString::decode(text, token.start, token.stop, &decoded)
            is_text(&decoded, 0, decoded.count.i64(), key)

        def decoded_member(text: darray[u8]&, tokens: darray[GlbJson::Token]&, object: usize, key: sview) -> i64:
            return -1 if tokens[object].kind != GlbJson::KIND_OBJECT
            mutable at: usize = object + 1
            for member in 0..<tokens[object].size:
                return (at + 1).i64() if decoded_key_is(text, tokens[at], key)
                at <- tokens[at + 1].after
            -1

        # Read only direct scalar members of the report or a clip object.
        # Nested timing and metadata objects cannot change metric ownership.
        def object_metrics(text: darray[u8]&, tokens: darray[GlbJson::Token]&, object: usize, clip_at: i64, clip_len: i64, pool: mutable darray[u8]&, out: mutable darray[Metric]&):
            mutable at: usize = object + 1
            for member in 0..<tokens[object].size:
                key: GlbJson::Token = tokens[at]
                value_token: GlbJson::Token = tokens[at + 1]
                if value_token.kind == GlbJson::KIND_PRIMITIVE:
                    key_at: i64 = pool.count.i64()
                    key_len: i64 = copy_string(text, key, pool)
                    mutable value: i64 = 0
                    mutable flag: bool = false
                    mutable exact_integer: bool = true
                    if GlbJson::text_is(text, value_token, "true") or GlbJson::text_is(text, value_token, "false"):
                        flag <- true
                        value <- 1 if GlbJson::text_is(text, value_token, "true") else 0
                    else:
                        mutable digit: usize = value_token.start
                        negative: bool = text[digit] == 45
                        digit <- digit + 1 if negative
                        while digit < value_token.stop:
                            c: u8 = text[digit]
                            if c < 48 or c > 57:
                                exact_integer <- false
                            elif exact_integer:
                                next_digit: i64 = (c - 48).i64()
                                if ReportDecimal::can_append_digit(value, next_digit):
                                    value <- ReportDecimal::append_digit(value, next_digit)
                                else:
                                    exact_integer <- false
                            digit <- digit + 1
                        value <- -value if negative
                    out.push(Metric{clip_at: clip_at, clip_len: clip_len, key_at: key_at, key_len: key_len, value: value, flag: flag, exact_integer: exact_integer})
                at <- value_token.after

        # Root scalars belong to `total`; only direct `clips` elements may
        # introduce clip identities. Name order within an object is irrelevant.
        def parse(text: darray[u8]&, pool: mutable darray[u8]&, out: mutable darray[Metric]&) -> bool:
            pool.clear()
            out.clear()
            return false if not ReportBudget::admitted(text.count.i64())
            mutable tokens: darray[GlbJson::Token] = []
            return false if not GlbJson::tokenize(text, 0, text.count, &tokens)
            return false if tokens.count == 0 or tokens[0].kind != GlbJson::KIND_OBJECT
            return false if member_count(text, &tokens, 0, "clips") > 1
            # Validate every string, including skipped metadata, before admitting
            # the report. Invalid escapes must not hide a recognized field.
            mutable decoded: darray[u8] = []
            for token in tokens:
                if token.kind == GlbJson::KIND_STRING:
                    decoded.clear()
                    return false if not JsonString::decode(text, token.start, token.stop, &decoded)
            Report::push_text(pool, "total")
            mutable identities: darray[Identity] = [Identity{at: 0, len: 5}]
            object_metrics(text, &tokens, 0, 0, 5, pool, out)
            clips: i64 = decoded_member(text, &tokens, 0, "clips")
            if clips >= 0:
                if GlbJson::kind_of(&tokens, clips) != GlbJson::KIND_ARRAY:
                    out.clear()
                    return false
                mutable clip: usize = clips.usize() + 1
                for index in 0..<tokens[clips.usize()].size:
                    if GlbJson::kind_of(&tokens, clip.i64()) != GlbJson::KIND_OBJECT:
                        out.clear()
                        return false
                    if not ReportBudget::unique_identity(member_count(text, &tokens, clip, "name")):
                        out.clear()
                        return false
                    name: i64 = decoded_member(text, &tokens, clip, "name")
                    if GlbJson::kind_of(&tokens, clip.i64()) != GlbJson::KIND_OBJECT or GlbJson::kind_of(&tokens, name) != GlbJson::KIND_STRING:
                        out.clear()
                        return false
                    clip_at: i64 = pool.count.i64()
                    clip_len: i64 = copy_string(text, tokens[name.usize()], pool)
                    if clip_len == 0:
                        out.clear()
                        return false
                    for identity in identities:
                        if same_span(pool, identity.at, identity.len, pool, clip_at, clip_len):
                            out.clear()
                            return false
                    identities.push(Identity{at: clip_at, len: clip_len})
                    object_metrics(text, &tokens, clip, clip_at, clip_len, pool, out)
                    clip <- tokens[clip].after

            # A clip/key pair must identify exactly one value. Otherwise the
            # first-match comparison could silently hide a later regression.
            for index in 0..<out.count:
                first: Metric = out[index]
                # Only quality and pass-status keys participate in comparison.
                continue if not lower_better(pool, first) and not is_text(pool, first.key_at, first.key_len, "ok")
                for earlier in 0..<index:
                    second: Metric = out[earlier]
                    if same_span(pool, first.clip_at, first.clip_len, pool, second.clip_at, second.clip_len) and same_span(pool, first.key_at, first.key_len, pool, second.key_at, second.key_len):
                        out.clear()
                        return false
            true

    public:
        def read_bytes(path: cstr, out: mutable darray[u8]&) -> bool:
            out.clear()
            mutable ok: bool = false
            can Blocking.IO, Memory.Allocate, Memory.Release:
                file: mutable heap void&? = r_fopen(path.cast[u8&], "rb".cast[u8&])
                if file != null:
                    handle: mutable heap void& = file
                    mutable c: i32 = d_fgetc(handle)
                    while c >= 0 and ReportBudget::can_append(out.count.i64()):
                        out.push(c.u8())
                        c <- d_fgetc(handle)
                    failed: bool = d_ferror(handle) != 0
                    closed: i32 = r_fclose(handle)
                    ok <- c < 0 and not failed and closed == 0
            out.clear() if not ok
            return ok

    private:
        def find(pool: darray[u8]&, list: darray[Metric]&, pa: darray[u8]&, m: Metric) -> i64:
            for k in 0..<list.count:
                n: Metric = list[k]
                if same_span(pool, n.clip_at, n.clip_len, pa, m.clip_at, m.clip_len) and same_span(pool, n.key_at, n.key_len, pa, m.key_at, m.key_len):
                    return k.i64()
            return -1

        def push_span(out: mutable darray[u8]&, pool: darray[u8]&, at: i64, len: i64):
            for i in 0..<len.usize():
                c: u8 = pool[at.usize() + i]
                if c == 60:
                    Report::push_text(out, "&lt;")
                elif c == 38:
                    Report::push_text(out, "&amp;")
                else:
                    out.push(c)

        def print_span(pool: darray[u8]&, at: i64, len: i64):
            can Blocking.IO:
                for i in 0..<len.usize():
                    _ = c_putchar(pool[at.usize() + i].i32())

    public:
        # Compare report files; returns the exit code (0 clean, 1 regression,
        # 2 unreadable input).
        def run(a_path: cstr, b_path: cstr, tol_permille: i64, floor: i64, html: cstr) -> i64 can[Memory.Allocate, Memory.Release, Blocking.IO]:
            mutable a_text: darray[u8] = []
            mutable b_text: darray[u8] = []
            mutable errors: i64 = 0
            if not read_bytes(a_path, &a_text):
                errors <- errors + 1
            if not read_bytes(b_path, &b_text):
                errors <- errors + 1
            mutable pa: darray[u8] = []
            mutable pb: darray[u8] = []
            mutable ma: darray[Metric] = []
            mutable mb: darray[Metric] = []
            if not parse(&a_text, &pa, &ma):
                errors <- errors + 1
                Out::line("Baseline report is empty, malformed or has duplicate metric identities.")
            if not parse(&b_text, &pb, &mb):
                errors <- errors + 1
                Out::line("Candidate report is empty, malformed or has duplicate metric identities.")
            if errors == 0 and ma.count == 0:
                errors <- 1
            tol: i64 = tolerance(tol_permille)
            fl: i64 = floor_of(floor)
            mutable regressions: i64 = 0
            mutable compared: i64 = 0
            mutable page: darray[u8] = []
            Report::push_text(&page, "<table><caption>Comparable baseline metrics</caption><thead><tr><th scope=col>Clip</th><th scope=col>Metric</th><th scope=col>Baseline</th><th scope=col>Candidate</th><th scope=col>Verdict</th></tr></thead><tbody>")
            for m in ma:
                flagged: bool = m.flag and m.value == 1 and is_text(&pa, m.key_at, m.key_len, "ok")
                if lower_better(&pa, m) or flagged:
                    compared <- compared + 1
                    if not flagged and m.flag:
                        errors <- errors + 1
                        Out::line("Baseline numeric metric has a Boolean value.")
                        continue
                    if not flagged and not Regress::metric_available(m.value, m.exact_integer):
                        errors <- errors + 1
                        Out::line("Baseline metric has unsupported numeric precision or range.")
                        continue
                    at: i64 = find(&pb, &mb, &pa, m)
                    mutable bad: bool = at < 0
                    mutable after: i64 = 0
                    if at >= 0:
                        other: Metric = mb[at.usize()]
                        if other.flag != m.flag:
                            errors <- errors + 1
                            Out::line("Report metric types differ between baseline and candidate.")
                            continue
                        after <- other.value
                        if not flagged and not Regress::metric_available(after, other.exact_integer):
                            errors <- errors + 1
                            Out::line("Candidate metric has unsupported numeric precision or range.")
                            continue
                        if flagged:
                            bad <- Regress::ok_lost(true, other.value == 1)
                        else:
                            bad <- Regress::metric_regressed(bounded(m.value), bounded(other.value), tol, fl)
                    if bad:
                        regressions <- regressions + 1
                        Out::text("regression ")
                        print_span(&pa, m.clip_at, m.clip_len)
                        Out::text(" ")
                        print_span(&pa, m.key_at, m.key_len)
                        Out::text(" ")
                        Out::number(m.value)
                        Out::text(" -> ")
                        if at >= 0:
                            Out::number(after)
                            Out::line("")
                        else:
                            Out::line("missing")
                    Report::push_text(&page, "<tr><td>")
                    push_span(&page, &pa, m.clip_at, m.clip_len)
                    Report::push_text(&page, "</td><td>")
                    push_span(&page, &pa, m.key_at, m.key_len)
                    Report::push_text(&page, "</td>")
                    Report::cell(&page, m.value)
                    if at >= 0:
                        Report::cell(&page, after)
                    else:
                        Report::push_text(&page, "<td>missing</td>")
                    Report::push_text(&page, "<td>regressed</td></tr>" if bad else "<td>ok</td></tr>")
            if compared == 0:
                errors <- errors + 1
                Out::line("Baseline report has no comparable quality metrics or passing status.")
            Report::push_text(&page, "</tbody></table>")
            mutable document: darray[u8] = []
            ReportDiffHtml::begin(&document, compared, regressions, errors, tol, fl)
            document.extend(page)
            ReportDiffHtml::end(&document)
            if html[0] != 0:
                if not Report::save(&document, html):
                    Out::line("HTML report could not be saved. Check the output path, permissions and available space.")
                    errors <- errors + 1
            Out::field("regressions ", regressions)
            Out::field("errors ", errors)
            return Regress::verdict(regressions, errors)
