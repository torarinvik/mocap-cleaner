include "../core/report_qualification.elisa"
# Report diff: compare two JSON reports per clip and metric (Phase 6).
# Direct root scalar members belong to "total". Direct members of named
# objects in the root "clips" array belong to that clip. Nested metadata and
# timing values are skipped using the engine JSON token subtree boundaries.
# Lower-is-better metrics: keys ending in _after or _after_um, plus
# unbalanced_frames and unbalanced_runs. "ok" turning false regresses, and so
# does a metric or clip missing from b. The verdict is Regress::verdict.
include "../core/regress.elisa"
include "../core/report_budget.elisa"
include "../core/report_decimal.elisa"
include "../core/report_index_kernel.elisa"
include "../core/report_compatibility.elisa"
include "../../../elisa-engine-mocap/src/assets/glb_json.elisa"
include "report.elisa"
include "json_string.elisa"
include "report_diff_html.elisa"
include "report_number.elisa"
include "console.elisa"

@link_name("fgetc")
extern d_fgetc(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("ferror")
extern d_ferror(file: mutable heap void&) -> i32 can[Blocking.IO]

module ReportDiff:
    private:
        struct Metric:
            clip_at: i64
            clip_len: i64
            key_at: i64
            key_len: i64
            value: i64
            exponent: i64
            flag: bool
            exact_number: bool

        struct Identity:
            at: i64
            len: i64

        def member_count(text: darray[u8]&, tokens: darray[GlbJson::Token]&, object: usize, key: sview) -> i64:
            ensure result >= 0
            mutable count: i64 = 0
            mutable at: usize = object + 1
            for member in 0..<tokens[object].size:
                count <- count + 1 if decoded_key_is(text, tokens[at], key)
                at <- tokens[at + 1].after
            count

        def tolerance(permille: i64) -> i64:
            ensure result >= 0
            ensure result <= Regress::Domain::TOLERANCE_PERMILLE
            return Regress::Domain::TOLERANCE_PERMILLE if permille > Regress::Domain::TOLERANCE_PERMILLE
            return 0 if permille < 0
            return permille

        def floor_of(value: i64) -> i64:
            ensure result >= 0
            ensure result <= Regress::Domain::MAGNITUDE
            return Regress::Domain::MAGNITUDE if value > Regress::Domain::MAGNITUDE
            return 0 if value < 0
            return value

        def ends_with(pool: darray[u8]&, at: i64, len: i64, s: sview) -> bool:
            mutable n: i64 = 0
            for c in s:
                n <- n + 1
            return false if n > len
            mutable i: i64 = 0
            for c in s:
                return false if pool[(at + len - n + i).usize()] != c
                i <- i + 1
            return true

        def is_text(pool: darray[u8]&, at: i64, len: i64, s: sview) -> bool:
            mutable n: i64 = 0
            for c in s:
                n <- n + 1
            return false if n != len
            return ends_with(pool, at, len, s)

        def lower_better(pool: darray[u8]&, m: Metric) -> bool:
            return true if ends_with(pool, m.key_at, m.key_len, "_after")
            return true if ends_with(pool, m.key_at, m.key_len, "_after_um")
            return true if is_text(pool, m.key_at, m.key_len, "unbalanced_frames")
            return is_text(pool, m.key_at, m.key_len, "unbalanced_runs")

        def copy_string(text: darray[u8]&, token: GlbJson::Token, pool: mutable darray[u8]&) -> i64:
            start: i64 = pool.count.i64()
            return -1 if not JsonString::decode(text, token.start, token.stop, pool)
            pool.count.i64() - start

        def decoded_key_is(text: darray[u8]&, token: GlbJson::Token, key: sview) -> bool:
            mutable decoded: darray[u8] = []
            return false if not JsonString::decode(text, token.start, token.stop, &decoded)
            is_text(&decoded, 0, decoded.count.i64(), key)

        def decoded_member(text: darray[u8]&, tokens: darray[GlbJson::Token]&, object: usize, key: sview) -> i64:
            return -1 if tokens[object].kind != GlbJson::KIND_OBJECT
            mutable at: usize = object + 1
            for member in 0..<tokens[object].size:
                return (at + 1).i64() if decoded_key_is(text, tokens[at], key)
                at <- tokens[at + 1].after
            -1

        # Read only direct scalar members of the report or a clip object.
        # Nested timing and metadata objects cannot change metric ownership.
        def object_metrics(text: darray[u8]&, tokens: darray[GlbJson::Token]&, object: usize, clip_at: i64, clip_len: i64, pool: mutable darray[u8]&, out: mutable darray[Metric]&):
            mutable at: usize = object + 1
            for member in 0..<tokens[object].size:
                key: GlbJson::Token = tokens[at]
                value_token: GlbJson::Token = tokens[at + 1]
                if value_token.kind == GlbJson::KIND_PRIMITIVE:
                    key_at: i64 = pool.count.i64()
                    key_len: i64 = copy_string(text, key, pool)
                    mutable value: i64 = 0
                    mutable flag: bool = false
                    mutable exact_number: bool = true
                    mutable exponent: i64 = 0
                    if GlbJson::text_is(text, value_token, "true") or GlbJson::text_is(text, value_token, "false"):
                        flag <- true
                        value <- 1 if GlbJson::text_is(text, value_token, "true") else 0
                    else:
                        match ReportNumber::parse(text, value_token.start, value_token.stop):
                            ReportNumber::Result.Exact(coefficient, power):
                                value <- coefficient
                                exponent <- power
                            ReportNumber::Result.Unavailable:
                                exact_number <- false
                    out.push(Metric{clip_at: clip_at, clip_len: clip_len, key_at: key_at, key_len: key_len, value: value, exponent: exponent, flag: flag, exact_number: exact_number})
                at <- value_token.after

        # Root scalars belong to `total`; only direct `clips` elements may
        # introduce clip identities. Name order within an object is irrelevant.
        def parse(text: darray[u8]&, pool: mutable darray[u8]&, out: mutable darray[Metric]&, tokens: mutable darray[GlbJson::Token]&) -> bool:
            pool.clear()
            out.clear()
            return false if not ReportBudget::admitted(text.count.i64())
            tokens.clear()
            return false if not GlbJson::tokenize(text, 0, text.count, tokens)
            return false if tokens.count == 0 or tokens[0].kind != GlbJson::KIND_OBJECT
            return false if member_count(text, tokens, 0, "clips") > 1
            # Validate every string, including skipped metadata, before admitting
            # the report. Invalid escapes must not hide a recognized field.
            mutable decoded: darray[u8] = []
            for token in tokens:
                if token.kind == GlbJson::KIND_STRING:
                    decoded.clear()
                    return false if not JsonString::decode(text, token.start, token.stop, &decoded)
            Report::push_text(pool, "total")
            mutable identities: darray[Identity] = [Identity{at: 0, len: 5}]
            object_metrics(text, tokens, 0, 0, 5, pool, out)
            clips: i64 = decoded_member(text, tokens, 0, "clips")
            if clips >= 0:
                if GlbJson::kind_of(tokens, clips) != GlbJson::KIND_ARRAY:
                    out.clear()
                    return false
                mutable clip: usize = clips.usize() + 1
                for index in 0..<tokens[clips.usize()].size:
                    if GlbJson::kind_of(tokens, clip.i64()) != GlbJson::KIND_OBJECT:
                        out.clear()
                        return false
                    if not ReportBudget::unique_identity(member_count(text, tokens, clip, "name")):
                        out.clear()
                        return false
                    name: i64 = decoded_member(text, tokens, clip, "name")
                    if GlbJson::kind_of(tokens, clip.i64()) != GlbJson::KIND_OBJECT or GlbJson::kind_of(tokens, name) != GlbJson::KIND_STRING:
                        out.clear()
                        return false
                    clip_at: i64 = pool.count.i64()
                    clip_len: i64 = copy_string(text, tokens[name.usize()], pool)
                    if clip_len == 0:
                        out.clear()
                        return false
                    identities.push(Identity{at: clip_at, len: clip_len})
                    object_metrics(text, tokens, clip, clip_at, clip_len, pool, out)
                    clip <- tokens[clip].after

            if not unique_clip_identities(pool, &identities):
                out.clear()
                return false
            # A clip/key pair must identify exactly one value. Otherwise the
            # first-match comparison could silently hide a later regression.
            mutable metric_index: darray[usize] = []
            build_index(pool, out, &metric_index)
            for index in 1..<metric_index.count:
                first: Metric = out[metric_index[index]]
                continue if not lower_better(pool, first) and not is_text(pool, first.key_at, first.key_len, "ok")
                second: Metric = out[metric_index[index - 1]]
                if compare_identity(pool, first, pool, second) == 0:
                    out.clear()
                    return false
            true

    public:
        def read_bytes(path: cstr, out: mutable darray[u8]&) -> bool:
            out.clear()
            mutable ok: bool = false
            can Blocking.IO, Memory.Allocate, Memory.Release:
                file: mutable heap void&? = r_fopen(path.cast[u8&], "rb".cast[u8&])
                if file != null:
                    handle: mutable heap void& = file
                    mutable c: i32 = d_fgetc(handle)
                    while c >= 0 and ReportBudget::can_append(out.count.i64()):
                        out.push(c.u8())
                        c <- d_fgetc(handle)
                    failed: bool = d_ferror(handle) != 0
                    closed: i32 = r_fclose(handle)
                    ok <- c < 0 and not failed and closed == 0
            out.clear() if not ok
            return ok

    private:
        def push_span(out: mutable darray[u8]&, pool: darray[u8]&, at: i64, len: i64):
            for i in 0..<len.usize():
                c: u8 = pool[at.usize() + i]
                if c == 60:
                    Report::push_text(out, "&lt;")
                elif c == 38:
                    Report::push_text(out, "&amp;")
                else:
                    out.push(c)

        def print_span(pool: darray[u8]&, at: i64, len: i64):
            can Blocking.IO:
                for i in 0..<len.usize():
                    _ = c_putchar(pool[at.usize() + i].i32())

        def print_value(value: i64, exponent: i64):
            Out::number(value)
            if exponent != 0:
                Out::text("e")
                Out::number(exponent)

        def push_value_cell(out: mutable darray[u8]&, value: i64, exponent: i64):
            Report::push_text(out, "<td>")
            Report::push_number(out, value)
            if exponent != 0:
                Report::push_text(out, "e")
                Report::push_number(out, exponent)
            Report::push_text(out, "</td>")

        def validation_problem(errors: mutable i64&, diagnostics: mutable darray[u8]&, message: sview):
            errors <- errors + 1
            Out::line(message)
            Report::push_text(diagnostics, "<li>")
            Report::push_text(diagnostics, message)
            Report::push_text(diagnostics, "</li>")

        def metric_problem(errors: mutable i64&, diagnostics: mutable darray[u8]&, message: sview,
                           pool: darray[u8]&, metric: Metric):
            errors <- errors + 1
            Out::line(message)
            Out::text("Clip: ")
            print_span(pool, metric.clip_at, metric.clip_len)
            Out::text("; metric: ")
            print_span(pool, metric.key_at, metric.key_len)
            Out::line("")
            Report::push_text(diagnostics, "<li>")
            Report::push_text(diagnostics, message)
            Report::push_text(diagnostics, " Clip: <strong>")
            push_span(diagnostics, pool, metric.clip_at, metric.clip_len)
            Report::push_text(diagnostics, "</strong>; metric: <strong>")
            push_span(diagnostics, pool, metric.key_at, metric.key_len)
            Report::push_text(diagnostics, "</strong>.</li>")

    public:
        # Compare report files; returns the exit code (0 clean, 1 regression,
        # 2 unreadable input).
        def run(a_path: cstr, b_path: cstr, tol_permille: i64, floor: i64, html: cstr) -> i64 can[Memory.Allocate, Memory.Release, Blocking.IO]:
            mutable a_text: darray[u8] = []
            mutable b_text: darray[u8] = []
            mutable errors: i64 = 0
            mutable diagnostics: darray[u8] = []
            if not read_bytes(a_path, &a_text):
                validation_problem(&errors, &diagnostics, "Baseline report could not be read within the 16 MiB limit. Check the path, permissions and file size.")
            if not read_bytes(b_path, &b_text):
                validation_problem(&errors, &diagnostics, "Candidate report could not be read within the 16 MiB limit. Check the path, permissions and file size.")
            mutable pa: darray[u8] = []
            mutable pb: darray[u8] = []
            mutable ma: darray[Metric] = []
            mutable mb: darray[Metric] = []
            mutable a_tokens: darray[GlbJson::Token] = []
            mutable b_tokens: darray[GlbJson::Token] = []
            if not parse(&a_text, &pa, &ma, &a_tokens):
                validation_problem(&errors, &diagnostics, "Baseline report is empty, malformed or has duplicate metric identities.")
            if not parse(&b_text, &pb, &mb, &b_tokens):
                validation_problem(&errors, &diagnostics, "Candidate report is empty, malformed or has duplicate metric identities.")
            if errors == 0 and ma.count == 0:
                validation_problem(&errors, &diagnostics, "Baseline report contains no scalar metrics.")
            mutable schema_unknown: bool = false
            mutable units_unknown: bool = false
            mutable detectors_unknown: bool = false
            mutable spike_status: ReportCompatibility::Status = ReportCompatibility::Status.Unknown
            mutable a_units: UnitDeclaration = UnitDeclaration.Missing
            mutable b_units: UnitDeclaration = UnitDeclaration.Missing
            if errors == 0:
                schema_status: ReportCompatibility::Status = declared_schema_status(&a_text, &b_text, &a_tokens, &b_tokens)
                if schema_status == ReportCompatibility::Status.Invalid:
                    validation_problem(&errors, &diagnostics, "Report schema declarations are malformed or duplicated.")
                elif schema_status == ReportCompatibility::Status.Incompatible:
                    validation_problem(&errors, &diagnostics, "Report schemas differ or only one report declares a schema. Regenerate both reports with the same supported producer.")
                elif schema_status == ReportCompatibility::Status.Unknown:
                    schema_unknown <- true
                    Out::line("Schema compatibility is unknown. Numeric results do not qualify units, detector settings or provenance.")
            if errors == 0:
                a_units <- unit_object(&a_text, &a_tokens)
                b_units <- unit_object(&b_text, &b_tokens)
                spike_status <- declared_spike_status(&a_text, &a_tokens, spike_setting(&a_text, &a_tokens), &b_text, &b_tokens, spike_setting(&b_text, &b_tokens))
                if unit_invalid(a_units) or unit_invalid(b_units):
                    validation_problem(&errors, &diagnostics, "Metric unit declarations are duplicated, malformed or exceed the supported declaration budget.")
            mutable candidate_index: darray[usize] = []
            build_index(&pb, &mb, &candidate_index)
            tol: i64 = tolerance(tol_permille)
            fl: i64 = floor_of(floor)
            mutable regressions: i64 = 0
            mutable compared: i64 = 0
            mutable page: darray[u8] = []
            Report::push_text(&page, "<table><caption>Comparable baseline metrics</caption><thead><tr><th scope=col>Clip</th><th scope=col>Metric</th><th scope=col>Baseline</th><th scope=col>Candidate</th><th scope=col>Verdict</th></tr></thead><tbody>")
            for m in ma:
                # An invalid document/schema cannot produce a numeric judgment.
                break if errors != 0
                flagged: bool = m.flag and m.value == 1 and is_text(&pa, m.key_at, m.key_len, "ok")
                if lower_better(&pa, m) or flagged:
                    compared <- compared + 1
                    if not flagged and m.flag:
                        metric_problem(&errors, &diagnostics, "Baseline numeric metric has a Boolean value.", &pa, m)
                        continue
                    if not flagged and not Regress::metric_available(m.value, m.exact_number):
                        metric_problem(&errors, &diagnostics, "Baseline metric has unsupported numeric precision or range.", &pa, m)
                        continue
                    at: i64 = find_indexed(&pb, &mb, &candidate_index, &pa, m)
                    mutable bad: bool = at < 0
                    mutable after: i64 = 0
                    mutable after_exponent: i64 = 0
                    if at >= 0:
                        other: Metric = mb[at.usize()]
                        if other.flag != m.flag:
                            metric_problem(&errors, &diagnostics, "Report metric types differ between baseline and candidate.", &pa, m)
                            continue
                        after <- other.value
                        after_exponent <- other.exponent
                        if not flagged and not Regress::metric_available(after, other.exact_number):
                            metric_problem(&errors, &diagnostics, "Candidate metric has unsupported numeric precision or range.", &pa, m)
                            continue
                        if flagged:
                            bad <- Regress::ok_lost(true, other.value == 1)
                        else:
                            if uses_spike_threshold(&pa, m):
                                if spike_status == ReportCompatibility::Status.Invalid or spike_status == ReportCompatibility::Status.Incompatible:
                                    metric_problem(&errors, &diagnostics, "Spike detector settings differ, are malformed, or are missing on only one side.", &pa, m)
                                    continue
                                detectors_unknown <- true if spike_status == ReportCompatibility::Status.Unknown
                            unit_status: ReportCompatibility::Status = declared_unit_status(&a_text, &a_tokens, a_units, &b_text, &b_tokens, b_units, &pa, m)
                            if unit_status == ReportCompatibility::Status.Invalid or unit_status == ReportCompatibility::Status.Incompatible:
                                metric_problem(&errors, &diagnostics, "Metric units differ, have the wrong dimension, are malformed, or are missing on only one side.", &pa, m)
                                continue
                            units_unknown <- true if unit_status == ReportCompatibility::Status.Unknown
                            match ReportDecimal::align(m.value, m.exponent, other.value, other.exponent, fl):
                                ReportDecimal::Alignment.Exact(before_scaled, after_scaled, floor_scaled, power):
                                    bad <- Regress::metric_regressed(before_scaled, after_scaled, tol, floor_scaled)
                                ReportDecimal::Alignment.Unavailable:
                                    metric_problem(&errors, &diagnostics, "Metrics cannot share an exact scale within the supported comparison domain.", &pa, m)
                                    continue
                    if bad:
                        regressions <- regressions + 1
                        Out::text("regression ")
                        print_span(&pa, m.clip_at, m.clip_len)
                        Out::text(" ")
                        print_span(&pa, m.key_at, m.key_len)
                        Out::text(" ")
                        print_value(m.value, m.exponent)
                        Out::text(" -> ")
                        if at >= 0:
                            print_value(after, after_exponent)
                            Out::line("")
                        else:
                            Out::line("missing")
                    Report::push_text(&page, "<tr><td>")
                    push_span(&page, &pa, m.clip_at, m.clip_len)
                    Report::push_text(&page, "</td><td>")
                    push_span(&page, &pa, m.key_at, m.key_len)
                    Report::push_text(&page, "</td>")
                    push_value_cell(&page, m.value, m.exponent)
                    if at >= 0:
                        push_value_cell(&page, after, after_exponent)
                    else:
                        Report::push_text(&page, "<td>missing</td>")
                    Report::push_text(&page, "<td>regressed</td></tr>" if bad else "<td>ok</td></tr>")
            if not ReportQualification::metadata_available(not schema_unknown, not units_unknown, not detectors_unknown):
                validation_problem(&errors, &diagnostics, "Comparison metadata is unqualified. Regenerate both reports with supported schema, units and detector settings before acceptance.")
            if compared == 0:
                validation_problem(&errors, &diagnostics, "Baseline report has no comparable quality metrics or passing status.")
            Report::push_text(&page, "</tbody></table>")
            mutable document: darray[u8] = []
            ReportDiffHtml::begin(&document, compared, regressions, errors, tol, fl)
            if diagnostics.count > 0:
                Report::push_text(&document, "<section aria-labelledby=validation-heading><h2 id=validation-heading>Validation problems</h2><ul>")
                document.extend(diagnostics)
                Report::push_text(&document, "</ul></section>")
            if schema_unknown:
                Report::push_text(&document, "<section aria-labelledby=schema-heading><h2 id=schema-heading>Schema compatibility unknown</h2><p>These reports use a legacy or unrecognized schema. Numeric results do not establish matching units, detector settings or provenance. Regenerate both reports with the same supported producer before acceptance.</p></section>")
            if units_unknown:
                Report::push_text(&document, "<section aria-labelledby=units-heading><h2 id=units-heading>Metric units unqualified</h2><p>At least one compared metric has missing or unrecognized units. Its numeric result does not establish a physically compatible comparison. Regenerate both reports with matching supported unit declarations before acceptance.</p></section>")
            if detectors_unknown:
                Report::push_text(&document, "<section aria-labelledby=detectors-heading><h2 id=detectors-heading>Spike detector settings unqualified</h2><p>At least one compared spike count lacks a declared threshold. Its numeric result does not establish matching detector settings.</p></section>")
            ReportDiffHtml::table_begin(&document)
            document.extend(page)
            ReportDiffHtml::end(&document)
            if html[0] != 0:
                if not Report::save(&document, html):
                    Out::line("HTML report could not be saved. Check the output path, permissions and available space.")
                    errors <- errors + 1
            Out::field("regressions ", regressions)
            Out::field("errors ", errors)
            return Regress::verdict(regressions, errors)

include "report_diff_index.elisa"

include "report_diff_schema.elisa"

include "report_diff_units.elisa"

include "report_diff_detectors.elisa"
