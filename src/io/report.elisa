# HTML batch report writer.
@link_name("fopen")
extern r_fopen(path: u8&, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("fputc")
extern r_fputc(c: i32, file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fclose")
extern r_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]

module Report:
    public:
        struct Row:
            ok: bool
            tracks: i64
            changed: i64
            before: i64
            after: i64

        # Rig and physics columns of a take (see RigOps::Summary, Physics::Findings).
        struct Detail:
            animations: i64
            rig_changed: i64
            pole_before: i64
            pole_after: i64
            slide_before: i64
            slide_after: i64
            planted: i64
            unbalanced: i64
            unbalanced_runs: i64
            airborne: i64
            flights: i64
            momentum_before: i64
            momentum_after: i64

        def empty_detail() -> Detail:
            return Detail{animations: 0, rig_changed: 0, pole_before: 0, pole_after: 0, slide_before: 0, slide_after: 0, planted: 0, unbalanced: 0, unbalanced_runs: 0, airborne: 0, flights: 0, momentum_before: 0, momentum_after: 0}

        def push_text(out: mutable darray[u8]&, s: sview):
            for c in s:
                out.push(c)

        def push_cstr(out: mutable darray[u8]&, s: cstr):
            mutable i: usize = 0
            while s[i] != 0:
                c: u8 = s[i]
                if c == 60:
                    push_text(out, "&lt;")
                elif c == 62:
                    push_text(out, "&gt;")
                elif c == 38:
                    push_text(out, "&amp;")
                else:
                    out.push(c)
                i <- i + 1

        def push_number(out: mutable darray[u8]&, value: i64):
            if value < 0:
                out.push(45)
            rest: i64 = value if value >= 0 else -value
            # Most significant digit first (G78): walk the 19 powers of ten an
            # i64 holds from 10^18 down and skip leading zeros; the units
            # digit is always written. Same bytes as the earlier reversed
            # buffer, without a loop invariant on `place`.
            place: mutable i64 = 1000000000000000000
            started: mutable bool = false
            for k in 0..<19:
                if place > 0:
                    digit: i64 = rest / place % 10
                    if started or (digit != 0 and rest > 0) or place == 1:
                        out.push((48 + digit).u8())
                        started <- true
                    place <- place / 10

        def cell(out: mutable darray[u8]&, value: i64):
            push_text(out, "<td>")
            push_number(out, value)
            push_text(out, "</td>")

        def begin(out: mutable darray[u8]&):
            push_text(out, "<!doctype html><meta charset=utf-8><title>Mocap cleanup report</title>")
            push_text(out, "<style>body{font:14px system-ui;margin:24px}td,th{padding:4px 10px;text-align:right}td:first-child,th:first-child{text-align:left}.bad{color:#b00}</style>")
            push_text(out, "<h1>Mocap cleanup report</h1><table><tr><th>Take</th><th>Status</th><th>Tracks</th><th>Values changed</th><th>Spikes before</th><th>Spikes after</th></tr>")

        def row(out: mutable darray[u8]&, name: cstr, r: Row):
            push_text(out, "<tr><td>")
            push_cstr(out, name)
            if r.ok:
                push_text(out, "</td><td>ok</td>")
            else:
                push_text(out, "</td><td class=bad>failed</td>")
            cell(out, r.tracks)
            cell(out, r.changed)
            cell(out, r.before)
            cell(out, r.after)
            push_text(out, "</tr>")

        def pair(out: mutable darray[u8]&, before: i64, after: i64):
            if after > before:
                push_text(out, "<td class=bad>")
            else:
                push_text(out, "<td>")
            push_number(out, before)
            push_text(out, " &rarr; ")
            push_number(out, after)
            push_text(out, "</td>")

        # Full report: curve cleanup, rig fixes and physics checks per take.
        def begin_detail(out: mutable darray[u8]&):
            push_text(out, "<!doctype html><meta charset=utf-8><title>Mocap cleanup report</title>")
            push_text(out, "<style>body{font:14px system-ui;margin:24px}table{border-collapse:collapse}td,th{padding:4px 10px;text-align:right;border-bottom:1px solid #ddd}td:first-child,th:first-child{text-align:left}.bad{color:#b00}.warn{background:#fff3cd}</style>")
            push_text(out, "<h1>Mocap cleanup report</h1>")
            push_text(out, "<p>Spikes, pole flips, foot slide and torso momentum spikes are shown as before &rarr; after. Unbalanced frames: a planted body whose centre of mass and capture point both leave the support region for at least 12 frames. Flights: airborne runs checked against a gravity parabola.</p>")
            push_text(out, "<table><tr><th>Take</th><th>Status</th><th>Clips</th><th>Tracks</th><th>Values changed</th><th>Spikes</th><th>Rig values changed</th><th>Pole flips</th><th>Foot slide (&micro;m)</th><th>Planted frames</th><th>Unbalanced frames (runs)</th><th>Airborne frames (flights)</th><th>Momentum spikes</th></tr>")

        def row_detail(out: mutable darray[u8]&, name: cstr, r: Row, d: Detail):
            if d.unbalanced > 0:
                push_text(out, "<tr class=warn><td>")
            else:
                push_text(out, "<tr><td>")
            push_cstr(out, name)
            if r.ok:
                push_text(out, "</td><td>ok</td>")
            else:
                push_text(out, "</td><td class=bad>failed</td>")
            cell(out, d.animations)
            cell(out, r.tracks)
            cell(out, r.changed)
            pair(out, r.before, r.after)
            cell(out, d.rig_changed)
            pair(out, d.pole_before, d.pole_after)
            pair(out, d.slide_before, d.slide_after)
            cell(out, d.planted)
            push_text(out, "<td>")
            push_number(out, d.unbalanced)
            push_text(out, " (")
            push_number(out, d.unbalanced_runs)
            push_text(out, ")</td><td>")
            push_number(out, d.airborne)
            push_text(out, " (")
            push_number(out, d.flights)
            push_text(out, ")</td>")
            pair(out, d.momentum_before, d.momentum_after)
            push_text(out, "</tr>")

        def finish(out: mutable darray[u8]&):
            push_text(out, "</table>")

        # Profile table: CPU microseconds per take and stage (see the CLI's
        # TIME_* slots); rows come from time_row, closed by finish_times.
        def begin_times(out: mutable darray[u8]&, names: darray[sview]&):
            push_text(out, "<h2>Time per stage (CPU &micro;s)</h2><p>Tracks covers the curve operations listed after the save column.</p><table><tr><th>Take</th>")
            for name in names |out|:
                push_text(out, "<th>")
                push_text(out, name)
                push_text(out, "</th>")
            push_text(out, "</tr>")

        def time_row(out: mutable darray[u8]&, name: cstr, times: darray[i64]&):
            push_text(out, "<tr><td>")
            push_cstr(out, name)
            push_text(out, "</td>")
            for t in times |out|:
                cell(out, t)
            push_text(out, "</tr>")

        # Append the closed profile table to the report.
        def finish_times(out: mutable darray[u8]&, profile: darray[u8]&):
            for c in profile |out|:
                out.push(c)
            push_text(out, "</table>")

        def save(out: darray[u8]&, path: cstr) -> bool:
            mutable ok: bool = false
            can Blocking.IO, Memory.Allocate, Memory.Release:
                file: mutable heap void&? = r_fopen(path.cast[u8&], "wb".cast[u8&])
                if file != null:
                    handle: mutable heap void& = file
                    for c in out:
                        _ = r_fputc(c.i32(), handle)
                    _ = r_fclose(handle)
                    ok <- true
            return ok
