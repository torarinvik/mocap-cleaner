# Pure classification for POSIX waitpid outcomes. Runtime errno values come
# from the platform adapter and are not proved by this policy.
module WorkerWaitPolicy:
    public:
        const enum Action of i64:
            Retry = 0
            Reaped = 1
            Failed = 2

        const module Posix:
            EINTR: i64 = 4

        # A positive pid means one child was reaped. EINTR means retry the
        # blocking wait. Every other result is a wait failure.
        def action(wait_result: i64, error_number: i64) -> Action:
            ensure result == (Action.Retry if wait_result < 0 and error_number == Posix::EINTR else Action.Reaped if wait_result > 0 else Action.Failed)
            return Action.Retry if wait_result < 0 and error_number == Posix::EINTR
            return Action.Reaped if wait_result > 0
            Action.Failed

        # Running-child counts change only after waitpid reaps a child.
        def remaining(running: i64, reaped: bool) -> i64:
            requires running >= 0
            ensure result == (running - 1 if reaped and running > 0 else running)
            return running - 1 if reaped and running > 0
            running

        # A child counts as successful only if waitpid reaped it and status
        # reports success. This says nothing about the status encoding source.
        def completion_ok(reaped: bool, status: i64) -> bool:
            ensure result == (reaped and status == 0)
            reaped and status == 0
