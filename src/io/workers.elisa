# Worker processes for `batch --jobs N` (POSIX fork/waitpid). A worker
# sends its stdout to a part file, so the parent can print every take's
# output in input order once the workers finish.
include "output_completion_policy.elisa"
include "worker_wait_policy.elisa"
@link_name("fork")
extern w_fork() -> i32 can[Blocking.IO]
@link_name("waitpid")
extern w_waitpid(pid: i32, status: mutable i32&, options: i32) -> i32 can[Blocking.IO]
@link_name("_exit")
extern w_exit(code: i32) -> void can[Blocking.IO]
@link_name("fflush")
extern w_fflush(file: mutable heap void&?) -> i32 can[Blocking.IO]
@link_name("fopen")
extern w_fopen(path: u8&, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("fileno")
extern w_fileno(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("dup2")
extern w_dup2(old_fd: i32, new_fd: i32) -> i32 can[Blocking.IO]
@link_name("fgetc")
extern w_fgetc(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fclose")
extern w_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]
@link_name("remove")
extern w_remove(path: u8&) -> i32 can[Blocking.IO]

# POSIX errno accessor. This IO adapter currently supports Darwin and Linux;
# each accessor returns the calling thread's errno storage.
static if ELISA_TARGET_OS_MACOS:
    @link_name("__error")
    extern w_errno_address() -> mutable i32& can[Blocking.IO]
static else:
    @link_name("__errno_location")
    extern w_errno_address() -> mutable i32& can[Blocking.IO]

module Workers:
    public:
        # Flush every stdio stream (before a fork, so buffers are not doubled,
        # and before a worker exits).
        def flush_all():
            can Blocking.IO:
                _ = w_fflush(null)

        # Fork: 0 in the worker, the worker's pid in the parent, -1 on error.
        def spawn() -> i32:
            flush_all()
            mutable pid: i32 = -1
            can Blocking.IO:
                pid <- w_fork()
            return pid

        # Wait for any worker. `reaped` is false only on a non-EINTR wait
        # failure; `ok` is true only when a child was reaped with status 0.
        def wait_any() -> (reaped: bool, ok: bool):
            mutable status: i32 = 1
            mutable pid: i32 = -1
            can Blocking.IO:
                pid <- w_waitpid(-1, &status, 0)
                while pid < 0 and w_errno_address()[0] == WorkerWaitPolicy::EINTR:
                    pid <- w_waitpid(-1, &status, 0)
            reaped: bool = pid > 0
            (reaped: reaped, ok: WorkerWaitPolicy::completion_ok(reaped, status.i64()))

        # End a worker with `code` after flushing its output.
        def finish(code: i32):
            flush_all()
            can Blocking.IO:
                w_exit(code)

        # Send stdout to a newly created path; never truncate an existing file.
        def redirect_stdout(path: cstr) -> bool:
            mutable ok: bool = false
            flush_all()
            can Blocking.IO, Memory.Allocate, Memory.Release:
                file: mutable heap void&? = w_fopen(path.cast[u8&], "wbx".cast[u8&])
                if file != null:
                    handle: mutable heap void& = file
                    descriptor: i32 = w_fileno(handle)
                    # If stdout was closed, fopen can occupy descriptor 1.
                    # Closing this FILE would close the redirected stream.
                    duplicated: bool = descriptor >= 0 and descriptor != 1 and w_dup2(descriptor, 1) >= 0
                    closed: i32 = w_fclose(handle)
                    ok <- OutputCompletionPolicy::success(duplicated, closed == 0)
            return ok

        # Bytes of the file at `path` (empty when it cannot be read).
        def read_all(path: cstr) -> darray[u8]:
            mutable out: darray[u8] = []
            can Blocking.IO, Memory.Allocate, Memory.Release:
                file: mutable heap void&? = w_fopen(path.cast[u8&], "rb".cast[u8&])
                if file != null:
                    handle: mutable heap void& = file
                    mutable c: i32 = w_fgetc(handle)
                    while c >= 0:
                        out.push(c.u8())
                        c <- w_fgetc(handle)
                    _ = w_fclose(handle)
            return out

        def remove(path: cstr):
            can Blocking.IO:
                _ = w_remove(path.cast[u8&])
