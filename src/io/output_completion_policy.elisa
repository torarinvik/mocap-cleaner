# Pure completion gate. The IO adapter must supply accurate write/duplication
# and close outcomes; this policy does not prove libc or crash durability.
module OutputCompletionPolicy:
    public:
        def success(operation_succeeded: bool, close_succeeded: bool) -> bool:
            ensure result == (operation_succeeded and close_succeeded)
            ensure result implies operation_succeeded
            ensure result implies close_succeeded
            operation_succeeded and close_succeeded
