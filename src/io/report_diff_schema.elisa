# Schema declaration admission. Part of ReportDiff, with decoded key semantics.
extend ReportDiff:
    private:
        def declared_schema_status(left: darray[u8]&, right: darray[u8]&, left_tokens: darray[GlbJson::Token]&, right_tokens: darray[GlbJson::Token]&) -> ReportCompatibility::Status:
            return ReportCompatibility::Status.Invalid if left_tokens.count == 0 or right_tokens.count == 0
            return ReportCompatibility::Status.Invalid if left_tokens[0].kind != GlbJson::KIND_OBJECT or right_tokens[0].kind != GlbJson::KIND_OBJECT
            return ReportCompatibility::Status.Invalid if member_count(left, left_tokens, 0, "schema") > 1
            return ReportCompatibility::Status.Invalid if member_count(right, right_tokens, 0, "schema") > 1
            left_schema: i64 = decoded_member(left, left_tokens, 0, "schema")
            right_schema: i64 = decoded_member(right, right_tokens, 0, "schema")
            if left_schema >= 0:
                return ReportCompatibility::Status.Invalid if left_tokens[left_schema.usize()].kind != GlbJson::KIND_STRING
            if right_schema >= 0:
                return ReportCompatibility::Status.Invalid if right_tokens[right_schema.usize()].kind != GlbJson::KIND_STRING
            if left_schema < 0 or right_schema < 0:
                return ReportCompatibility::schema_status(left_schema >= 0, right_schema >= 0, true, false, false)
            mutable left_name: darray[u8] = []
            mutable right_name: darray[u8] = []
            left_token: GlbJson::Token = left_tokens[left_schema.usize()]
            right_token: GlbJson::Token = right_tokens[right_schema.usize()]
            return ReportCompatibility::Status.Invalid if not JsonString::decode(left, left_token.start, left_token.stop, &left_name)
            return ReportCompatibility::Status.Invalid if not JsonString::decode(right, right_token.start, right_token.stop, &right_name)
            return ReportCompatibility::Status.Invalid if left_name.count == 0 or right_name.count == 0
            equal: bool = compare_span(&left_name, 0, left_name.count.i64(), &right_name, 0, right_name.count.i64()) == 0
            recognized: bool = is_text(&left_name, 0, left_name.count.i64(), "mocap-cleaner-report-v1")
            ReportCompatibility::schema_status(true, true, true, recognized, equal)
