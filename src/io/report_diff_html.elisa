include "report.elisa"
include "../core/regress.elisa"

module ReportDiffHtml:
    public:
        def begin(out: mutable darray[u8]&, compared: i64, regressions: i64, errors: i64, tolerance: i64, floor: i64):
            requires compared >= 0 and regressions >= 0 and errors >= 0
            Report::push_text(out, "<!doctype html><html lang=en><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Motion report comparison</title>")
            Report::push_text(out, "<style>body{font:16px system-ui;line-height:1.5;color:#17212b;background:#f6f8fa;margin:0}main{max-width:1100px;margin:auto;padding:24px}h1{font-size:1.7rem}.status{padding:16px;border:1px solid #8c959f;border-radius:8px;background:white}.unavailable{border-color:#9a6700}.regressed{border-color:#cf222e}.clean{border-color:#1a7f37}.table-scroll{overflow:auto}.table-scroll:focus-visible{outline:3px solid #0969da;outline-offset:4px}table{border-collapse:collapse;background:white;width:100%}th,td{padding:10px;border-bottom:1px solid #d0d7de;text-align:left}caption{text-align:left;padding:16px 0;font-weight:600}th{background:#eaeef2}td{font-variant-numeric:tabular-nums}td:first-child{white-space:pre-wrap}</style><main><h1>Motion report comparison</h1>")
            verdict: i64 = Regress::verdict(regressions, errors)
            if verdict == 2:
                Report::push_text(out, "<section class=\"status unavailable\"><h2>Comparison unavailable</h2><p>One or more inputs or metrics could not be validated. This report does not establish that the candidate is clean. Check the command output for input, type, precision, or range errors.</p>")
            elif verdict == 1:
                Report::push_text(out, "<section class=\"status regressed\"><h2>Regressions found</h2><p>Review the changed or missing metrics below before accepting the candidate.</p>")
            else:
                Report::push_text(out, "<section class=\"status clean\"><h2>No numeric regressions found</h2><p>The comparable baseline metrics satisfy the selected tolerance and floor. Metrics outside this comparison are not qualified by this result.</p>")
            Report::push_text(out, "<p>Baseline metrics considered: ")
            Report::push_number(out, compared)
            Report::push_text(out, ". Regressions: ")
            Report::push_number(out, regressions)
            Report::push_text(out, ". Validation errors: ")
            Report::push_number(out, errors)
            Report::push_text(out, ".</p><p>Tolerance: ")
            Report::push_number(out, tolerance)
            Report::push_text(out, " permille. Absolute floor: ")
            Report::push_number(out, floor)
            Report::push_text(out, " in each metric's reported unit.</p></section>")

        def table_begin(out: mutable darray[u8]&):
            Report::push_text(out, "<div class=table-scroll tabindex=0 role=region aria-label=\"Metric comparison table\">")

        def end(out: mutable darray[u8]&):
            Report::push_text(out, "</div></main></html>")
