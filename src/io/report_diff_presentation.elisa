# The table states physical units and Boolean status explicitly.
extend ReportDiff:
    private:
        def push_review_value(out: mutable darray[u8]&, flagged: bool, value: i64, exponent: i64):
            if flagged:
                Report::push_text(out, "<td>true</td>" if value == 1 else "<td>false</td>")
            else:
                push_value_cell(out, value, exponent)

        def push_unit_cell(out: mutable darray[u8]&, pool: darray[u8]&, metric: Metric, flagged: bool):
            Report::push_text(out, "<td>")
            if flagged:
                Report::push_text(out, "Boolean status")
            else:
                match expected_dimension(pool, metric):
                    ReportUnitPolicy::Dimension.Count:
                        Report::push_text(out, "count")
                    ReportUnitPolicy::Dimension.Frames:
                        Report::push_text(out, "frames")
                    ReportUnitPolicy::Dimension.Distance:
                        Report::push_text(out, "micrometres")
                    _:
                        Report::push_text(out, "unqualified")
            Report::push_text(out, "</td>")
