# Minimal console output: the stage1 backend declines f-strings and print of
# ints in some contexts, so characters go out one by one.
@link_name("putchar")
extern c_putchar(c: i32) -> i32 can[Blocking.IO]

module Out:
    public:
        def text(s: sview):
            for c in s:
                _ = c_putchar(c.i32())

        def c_text(s: cstr):
            mutable i: usize = 0
            while s[i] != 0:
                _ = c_putchar(s[i].i32())
                i <- i + 1

        def number(value: i64):
            if value < 0:
                _ = c_putchar(45)
            mutable rest: i64 = value if value >= 0 else -value
            mutable digits: darray[i32] = []
            digits.push((rest % 10).i32())
            rest <- rest / 10
            while rest > 0:
                digits.push((rest % 10).i32())
                rest <- rest / 10
            for k in 0..<digits.count:
                _ = c_putchar(48 + digits[digits.count - 1 - k])

        def byte(c: u8):
            _ = c_putchar(c.i32())

        def line(s: sview):
            text(s)
            _ = c_putchar(10)

        def field(label: sview, value: i64):
            text(label)
            number(value)
            _ = c_putchar(10)
