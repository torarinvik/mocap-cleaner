module FolderScanPolicy:
    public:
        const module Capacity:
            NAMES: i64 = 4096

        const module DarwinDirent:
            HEADER: i64 = 24
            NAME_OFFSET: i64 = 21
            MAX_RECORD: i64 = 1048

        def limit_admitted(limit: i64) -> bool:
            ensure result == (limit > 0 and limit <= Capacity::NAMES)
            limit > 0 and limit <= Capacity::NAMES

        def record_admitted(record_bytes: i64, name_bytes: i64) -> bool:
            ensure result == (record_bytes >= DarwinDirent::HEADER and record_bytes <= DarwinDirent::MAX_RECORD and name_bytes > 0 and name_bytes < record_bytes - DarwinDirent::NAME_OFFSET)
            ensure result implies record_bytes >= DarwinDirent::HEADER and record_bytes <= DarwinDirent::MAX_RECORD
            ensure result implies name_bytes > 0 and name_bytes < record_bytes - DarwinDirent::NAME_OFFSET
            record_bytes >= DarwinDirent::HEADER and record_bytes <= DarwinDirent::MAX_RECORD and name_bytes > 0 and name_bytes < record_bytes - DarwinDirent::NAME_OFFSET

        def append_admitted(count: i64, limit: i64) -> bool:
            ensure result == (count >= 0 and count < limit and limit_admitted(limit))
            ensure result implies count >= 0 and count < limit
            ensure result implies limit_admitted(limit)
            count >= 0 and count < limit and limit_admitted(limit)
