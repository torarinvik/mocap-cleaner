extend Physics:
    public:
        def accumulate_residual(before: mutable i64&, after: mutable i64&, available: mutable bool&, addition: i64, is_before: bool):
            requires before >= 0
            requires after >= 0
            requires addition >= 0
            requires available or before == 0 and after == 0
            ensure not available or PhysicsLengthBoundary::report_admitted(before)
            ensure not available or PhysicsLengthBoundary::report_admitted(after)
            ensure available or before == 0 and after == 0
            return if not available
            if not PhysicsLengthBoundary::report_admitted(before) or not PhysicsLengthBoundary::report_admitted(after):
                before <- 0
                after <- 0
                available <- false
                return
            current: i64 = before if is_before else after
            if PhysicsLengthBoundary::report_sum_admitted(current, addition):
                before <- before + addition if is_before
                after <- after + addition if not is_before
            else:
                before <- 0
                after <- 0
                available <- false

        def merge_residual(before: mutable i64&, after: mutable i64&, available: mutable bool&, source_available: bool, addition: i64, is_before: bool):
            requires before >= 0
            requires after >= 0
            requires addition >= 0
            requires available or before == 0 and after == 0
            requires source_available or addition == 0
            ensure not available or PhysicsLengthBoundary::report_admitted(before)
            ensure not available or PhysicsLengthBoundary::report_admitted(after)
            ensure available or before == 0 and after == 0
            if not available or not source_available:
                before <- 0
                after <- 0
                available <- false
                return
            if not PhysicsLengthBoundary::report_admitted(before) or not PhysicsLengthBoundary::report_admitted(after):
                before <- 0
                after <- 0
                available <- false
                return
            current: i64 = before if is_before else after
            if PhysicsLengthBoundary::report_sum_admitted(current, addition):
                before <- before + addition if is_before
                after <- after + addition if not is_before
            else:
                before <- 0
                after <- 0
                available <- false
