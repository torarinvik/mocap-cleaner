include "../core/length_units.elisa"

# Length-derived physics quantities use 0.1 mm per stated time basis.
# Angular quantities must not pass through this boundary.
module PhysicsLengthBoundary:
    public:
        const module Domain:
            MAX_COORDINATE: i64 = 10000000
            MAX_GRAVITY_STEP: i64 = 10000
            MAX_INPUT_MICROMETRES: i64 = MAX_COORDINATE * LengthUnits::Scale::MICROMETRES_PER_UNIT
            MAX_METRES: f64 = 1000.0

        def world_admitted(metres: f64) -> bool:
            ensure result == (metres - metres == 0.0 and metres >= -Domain::MAX_METRES and metres <= Domain::MAX_METRES)
            metres - metres == 0.0 and metres >= -Domain::MAX_METRES and metres <= Domain::MAX_METRES

        # Round once at the final internal scale. Admission is explicit;
        # unsupported coordinates are not silently saturated into valid data.
        def from_metres(metres: f64) -> i64:
            requires world_admitted(metres)
            ensure result >= -Domain::MAX_COORDINATE and result <= Domain::MAX_COORDINATE
            (metres * LengthUnits::Scale::UNITS_PER_METRE.f64()).round().i64()

        def metres(units: i64) -> f64:
            requires units >= -Domain::MAX_COORDINATE and units <= Domain::MAX_COORDINATE
            ensure result >= -Domain::MAX_METRES and result <= Domain::MAX_METRES
            units.f64() / LengthUnits::Scale::UNITS_PER_METRE.f64()

        def input_admitted(micrometres: i64) -> bool:
            ensure result == (micrometres >= -Domain::MAX_INPUT_MICROMETRES and micrometres <= Domain::MAX_INPUT_MICROMETRES)
            micrometres >= -Domain::MAX_INPUT_MICROMETRES and micrometres <= Domain::MAX_INPUT_MICROMETRES

        def from_micrometres(micrometres: i64) -> i64:
            requires input_admitted(micrometres)
            ensure result >= -Domain::MAX_COORDINATE and result <= Domain::MAX_COORDINATE
            ensure result == LengthUnits::from_micrometres(micrometres)
            LengthUnits::from_bounded_micrometres(micrometres, Domain::MAX_COORDINATE)

        # Reports retain their micrometre schema. Admission stays explicit
        # because accumulated residuals have a wider domain than coordinates.
        def report_admitted(units: i64) -> bool:
            ensure result == LengthUnits::can_export_micrometres(units)
            LengthUnits::can_export_micrometres(units)

        def report_micrometres(units: i64) -> i64:
            requires report_admitted(units)
            ensure result == units * LengthUnits::Scale::MICROMETRES_PER_UNIT
            LengthUnits::to_micrometres(units)
