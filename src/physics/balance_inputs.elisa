include "../ops/rig_stack.elisa"
include "length_boundary.elisa"

module PhysicsBalanceInputs:
    public:
        # Capture points that cannot be represented in the admitted support
        # domain make this balance operation unavailable, never a clean result.
        def capture_admitted(coms: darray[MotionQuat::V]&, floor: i64, fps: f64, gravity: f64) -> bool:
            return false if coms.count < 3
            return false if floor < -PhysicsLengthBoundary::Domain::MAX_COORDINATE or floor > PhysicsLengthBoundary::Domain::MAX_COORDINATE
            return false if fps - fps != 0.0 or fps <= 0.0
            return false if gravity - gravity != 0.0 or gravity <= 0.0
            floor_metres: f64 = PhysicsLengthBoundary::metres(floor)
            for f in 0..<coms.count:
                p: MotionQuat::V = coms[f]
                a: MotionQuat::V = coms[(f - 1) if f > 0 else f]
                b: MotionQuat::V = coms[(f + 1) if f + 1 < coms.count else f]
                return false if not PhysicsLengthBoundary::world_admitted(p.x) or not PhysicsLengthBoundary::world_admitted(p.y) or not PhysicsLengthBoundary::world_admitted(p.z)
                return false if not PhysicsLengthBoundary::world_admitted(a.x) or not PhysicsLengthBoundary::world_admitted(a.z) or not PhysicsLengthBoundary::world_admitted(b.x) or not PhysicsLengthBoundary::world_admitted(b.z)
                height: f64 = p.y - floor_metres
                omega: f64 = (gravity / height).sqrt() if height > 0.05 else 14.0
                span: f64 = 2.0 if f > 0 and f + 1 < coms.count else 1.0
                vx: f64 = (b.x - a.x) * fps / span
                vz: f64 = (b.z - a.z) * fps / span
                cap_x: f64 = p.x + vx / omega
                cap_z: f64 = p.z + vz / omega
                return false if not PhysicsLengthBoundary::world_admitted(cap_x) or not PhysicsLengthBoundary::world_admitted(cap_z)
            true
