include "length_boundary.elisa"

module PhysicsTrackShapePolicy:
    public:
        const module Length:
            MIN_LEG_METRES: f64 = 0.000001

        const enum BalanceInput of i64:
            Ready = 0
            Inapplicable = 1
            Unavailable = 2

        def contact_source_admitted(left_node: i64, right_node: i64, length: f64) -> bool:
            ensure result == (left_node >= 0 and right_node >= 0 and length - length == 0.0 and length > Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES)
            left_node >= 0 and right_node >= 0 and length - length == 0.0 and length > Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES

        def contacts_admitted(frames: i64, left: i64, right: i64) -> bool:
            ensure result == (frames >= 0 and left == frames and right == frames)
            frames >= 0 and left == frames and right == frames

        def balance_admitted(frames: i64, left: i64, right: i64, coms: i64) -> bool:
            ensure result == (contacts_admitted(frames, left, right) and coms == frames)
            contacts_admitted(frames, left, right) and coms == frames

        def balance_length_admitted(length: f64) -> bool:
            ensure result == (length - length == 0.0 and length > Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES)
            length - length == 0.0 and length > Length::MIN_LEG_METRES and length <= PhysicsLengthBoundary::Domain::MAX_METRES

        # A well-formed take shorter than three samples cannot support the
        # velocity-based capture point; malformed data remains unavailable.
        def balance_input(frames: i64, left: i64, right: i64, coms: i64, length: f64) -> BalanceInput:
            ensure result == (BalanceInput.Unavailable if not balance_admitted(frames, left, right, coms) or not balance_length_admitted(length) else BalanceInput.Inapplicable if frames < 3 else BalanceInput.Ready)
            return BalanceInput.Unavailable if not balance_admitted(frames, left, right, coms)
            return BalanceInput.Unavailable if not balance_length_admitted(length)
            return BalanceInput.Inapplicable if frames < 3
            BalanceInput.Ready
