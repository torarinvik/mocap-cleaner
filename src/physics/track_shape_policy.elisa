module PhysicsTrackShapePolicy:
    public:
        def contacts_admitted(frames: i64, left: i64, right: i64) -> bool:
            ensure result == (frames >= 0 and left == frames and right == frames)
            frames >= 0 and left == frames and right == frames

        def balance_admitted(frames: i64, left: i64, right: i64, coms: i64) -> bool:
            ensure result == (contacts_admitted(frames, left, right) and coms == frames)
            contacts_admitted(frames, left, right) and coms == frames
