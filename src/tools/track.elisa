# Track-level cleanup tools over fixed-point channels. Each tool loops over
# frames and delegates the per-frame decision to a proved kernel.
include "../core/stability.elisa"
include "../core/fade.elisa"
include "../core/order.elisa"
include "../core/span.elisa"
include "../core/gate.elisa"
include "../core/seam.elisa"
include "../core/smooth.elisa"
include "../core/lock.elisa"
include "../core/footing.elisa"
include "../core/window.elisa"
include "../core/slide.elisa"
include "../detect/contact.elisa"
include "../detect/spike.elisa"

module Track:
    public:
        const LIMIT: i64 = 1000000000
        # The kernels' bounds under names of their own: a negated qualified
        # constant (`-Lock::LIMIT`) is ambiguous to the prover here, since six
        # included modules each define a LIMIT. A wrong value here fails the
        # kernels' preconditions, so the prover keeps them in step.
        const SMOOTH_LIMIT: i64 = 1000000000000   # Smooth::LIMIT
        const LOCK_LIMIT: i64 = 1000000000        # Lock::LIMIT
        const FOOT_LIMIT: i64 = 1000000000        # Footing::LIMIT
        const WRING_HALF: i64 = 500000000         # Stability::LIMIT / 2
        const STABLE_LIMIT: i64 = 1000000000      # Stability::LIMIT

        # Order::clamp under a name of its own: Span::clamp is also included,
        # and with two `clamp`s in scope the prover does not apply
        # Order::clamp's ensures at the call. Same body and contract.
        def bounded(value: i64, lo: i64, hi: i64) -> i64:
            requires lo <= hi
            ensure result >= lo
            ensure result <= hi
            ensure value < lo or value > hi or result == value
            return lo if value < lo
            return hi if value > hi
            return value

        # bounded(v, -k, k), with k passed positive: a negated constant
        # argument is a mixed-sign constant the prover will not compare.
        def bound_to(v: i64, k: i64) -> i64:
            requires k >= 0
            ensure result >= -k
            ensure result <= k
            ensure v < -k or v > k or result == v
            return -k if v < -k
            return k if v > k
            return v

        # bound_to at each kernel bound. Called inside loops, where a
        # constant argument's `k >= 0` is not re-proved per call.
        def lock_value(v: i64) -> i64:
            ensure result >= -LOCK_LIMIT
            ensure result <= LOCK_LIMIT
            return bound_to(v, LOCK_LIMIT)

        def foot_value(v: i64) -> i64:
            ensure result >= -FOOT_LIMIT
            ensure result <= FOOT_LIMIT
            return bound_to(v, FOOT_LIMIT)

        def wring_value(v: i64) -> i64:
            ensure result >= -WRING_HALF
            ensure result <= WRING_HALF
            return bound_to(v, WRING_HALF)

        # Fade weight that matches Fade::weight / eased_weight at runtime for
        # every edge, frame and length: in the kernel domain it calls the
        # kernel, otherwise it repeats the kernel body (G76). `eased` picks
        # the smoothstep variant.
        def fade_at(frame: i64, last: i64, edge: i64, looping: bool, eased: bool) -> i64:
            ensure result >= 0
            ensure result <= Fade::FULL
            return Fade::FULL if looping or frame < 0 or frame > last
            if last < Fade::MAX_FRAMES and edge >= 1 and edge <= Fade::MAX_EDGE:
                if eased:
                    return Fade::eased_weight(frame, last, edge, looping)
                return Fade::weight(frame, last, edge, looping)
            rest: i64 = last - frame
            distance: i64 = frame if frame <= rest else rest
            return Fade::FULL if distance >= edge
            return 0 if distance == 0
            linear: i64 = distance * Fade::FULL / edge
            return Fade::FULL if linear > Fade::FULL or linear < 0
            return Fade::ease(linear) if eased
            return linear

        # Gate::apply for any channel values: the kernel inside its +-LIMIT
        # domain, the identical arithmetic outside it (G76).
        def blend(source: i64, fixed: i64, w: i64) -> i64:
            requires w >= 0
            requires w <= Fade::FULL
            ensure w != 0 or result == source
            return source if source == fixed
            return source if w == 0
            return fixed if w == Fade::FULL
            if source >= -LIMIT and source <= LIMIT and fixed >= -LIMIT and fixed <= LIMIT:
                return Gate::apply(source, fixed, w)
            return source + (fixed - source) * w / Fade::FULL

        # Fade the filtered buffer back toward the source at clip edges. The
        # filter passes only assign existing slots, so `fixed` has the
        # source's length and the `fixed.count` guard never fires (G76).
        def faded(values: darray[i64]&, fixed: darray[i64]&, edge: i64, looping: bool, eased: bool) -> darray[i64]:
            out: mutable darray[i64] = []
            last: i64 = values.count.i64() - 1
            for i in 0..<values.count:
                source: i64 = values[i]
                target: mutable i64 = source
                if i < fixed.count:
                    target <- fixed[i]
                w: i64 = fade_at(i.i64(), last, edge, looping, eased)
                out.push(blend(source, target, w))
            return out

        # Element `k`, or 0 off the track. Every caller passes an in-range
        # frame, so this is the plain read; the check is what lets the prover
        # see the bound without a model of the caller's arithmetic.
        def item(values: darray[i64]&, k: i64) -> i64:
            return 0 if k < 0
            index: usize = k.usize()
            return 0 if index >= values.count
            return values[index]

        # Flag `k`, false off the end (the callers' own `k < flags.count` test).
        def flag(flags: darray[bool]&, k: i64) -> bool:
            return false if k < 0
            index: usize = k.usize()
            return false if index >= flags.count
            return flags[index]

        # Store `v` at `k`; callers only write existing slots.
        def put(values: mutable darray[i64]&, k: i64, v: i64) -> void:
            return if k < 0
            index: usize = k.usize()
            return if index >= values.count
            values[index] <- v

        # Span::clamp for any count (its body beyond MAX_FRAMES).
        def clamped(frame: i64, count: i64) -> i64:
            requires count >= 1
            ensure result >= 0
            ensure result < count
            return Span::clamp(frame, count) if count <= Span::MAX_FRAMES
            return 0 if frame < 0
            return count - 1 if frame >= count
            return frame

        # Span::wrap for any count and frame (its body outside the kernel
        # domain; a frame so large the shift would overflow reads slot 0).
        def wrapped(frame: i64, count: i64) -> i64:
            requires count >= 1
            if count <= Span::MAX_FRAMES and frame > -Span::MAX_FRAMES and frame < 2 * Span::MAX_FRAMES:
                return Span::wrap(frame, count)
            return 0 if frame > 9000000000000000000 or frame < -9000000000000000000
            return (frame + Span::MAX_FRAMES) % count

        # Odd-reflection sample: off-clip frames mirror through the end value,
        # so symmetric filters keep the end frames exactly.
        def odd_sample(values: darray[i64]&, frame: i64) -> i64:
            count: i64 = values.count.i64()
            return 0 if count <= 0
            return item(values, frame) if frame >= 0 and frame < count
            return item(values, clamped(frame, count)) if count > Window::MAX_FRAMES
            # The last two tests are implied by the first two once count <= MAX_FRAMES.
            return item(values, clamped(frame, count)) if frame <= -count or frame >= 2 * count - 1 or frame <= -Window::MAX_FRAMES or frame >= 2 * Window::MAX_FRAMES
            at: i64 = Window::mirror(frame, count)
            end: mutable i64 = item(values, count - 1)
            if frame < 0:
                end <- item(values, 0)
            return reflected(end, item(values, at))

        # Window::reflect within +-LIMIT, the mirrored value itself outside it.
        def reflected(end: i64, mirrored: i64) -> i64:
            return mirrored if end < -LIMIT or end > LIMIT or mirrored < -LIMIT or mirrored > LIMIT
            return Window::reflect(end, mirrored, LIMIT)

        def sample(values: darray[i64]&, frame: i64, looping: bool) -> i64:
            count: i64 = values.count.i64()
            return 0 if count <= 0
            if looping:
                return item(values, wrapped(frame, count))
            return item(values, clamped(frame, count))

        # One median-of-3 pass from `src` into `dst` (same length). Without
        # looping, interior frames (both neighbours on the track, the
        # Slide::inner test) read their neighbours directly and the ends go
        # through `sample`, so the result equals the padded form everywhere.
        # Looping keeps `sample` on every frame: Span::wrap offsets in-range
        # frames by MAX_FRAMES % count.
        def despike_pass(src: darray[i64]&, dst: mutable darray[i64]&, looping: bool) -> void:
            count: i64 = src.count.i64()
            for f in 0..<count |f, src, dst, count, looping|:
                if not looping and f >= 1 and f + 1 < count:
                    a: i64 = item(src, f - 1)
                    b: i64 = item(src, f)
                    c: i64 = item(src, f + 1)
                    put(dst, f, Order::median3(a, b, c))
                else:
                    before: i64 = sample(src, f - 1, looping)
                    now: i64 = item(src, f)
                    after: i64 = sample(src, f + 1, looping)
                    put(dst, f, Order::median3(before, now, after))

        # Running median-of-3 de-spike, repeated `passes` times, then faded to
        # the source at clip edges (unless looping). Two buffers are reused
        # for every pass (Slide::flip picks the one a pass writes).
        def despike(values: darray[i64]&, passes: i64, edge: i64, looping: bool) -> darray[i64]:
            count: i64 = values.count.i64()
            first: mutable darray[i64] = []
            second: mutable darray[i64] = []
            for v in values |first, second|:
                first.push(v)
                second.push(v)
            return first if count < 3
            side: mutable i64 = 1
            round: mutable i64 = 0
            while round < passes:
                invariant side >= 0
                invariant side <= 1
                if side == 1:
                    despike_pass(&first, &second, looping)
                else:
                    despike_pass(&second, &first, looping)
                side <- Slide::flip(side)
                round <- round + 1
            return faded(values, &first, edge, looping, false) if side == 1
            return faded(values, &second, edge, looping, false)

        # First slot of a sorted window whose value is above `v` (`above`
        # true) or at least `v` (`above` false): a binary search through the
        # proved Slide::probe / right_of / left_of.
        def sorted_slot(window: darray[i64]&, v: i64, above: bool) -> i64:
            lo: mutable i64 = 0
            hi: mutable i64 = window.count.i64()
            return hi if hi > Slide::SEARCH_MAX
            while lo < hi:
                invariant lo >= 0
                invariant hi <= Slide::SEARCH_MAX
                at: i64 = Slide::probe(lo, hi)
                x: i64 = item(window, at)
                if x < v or (above and x == v):
                    lo <- Slide::right_of(lo, hi)
                else:
                    hi <- Slide::left_of(lo, hi)
            return lo

        # Insert `v` into a sorted window, shifting the larger values up.
        def sorted_insert(window: mutable darray[i64]&, v: i64) -> void:
            at: i64 = sorted_slot(window, v, true)
            window.push(v)
            last: i64 = window.count.i64() - 1
            for k in 0..<(last - at) |k, at, last, window|:
                j: i64 = last - k
                moved: i64 = item(window, j - 1)
                put(window, j, moved)
            put(window, at, v)

        # Remove one copy of `v` from a sorted window that holds it.
        def sorted_remove(window: mutable darray[i64]&, v: i64) -> void:
            at: i64 = sorted_slot(window, v, false)
            n: i64 = window.count.i64()
            return if at >= n
            for j in at..<(n - 1) |j, n, window|:
                moved: i64 = item(window, j + 1)
                put(window, j, moved)
            window.pop()

        # Window::middle for any size (its body outside the kernel domain).
        def middle_of(size: i64) -> i64:
            return Window::middle(size) if size >= 1 and size <= 2 * Window::MAX_RADIUS + 1
            return (size - 1) / 2

        # Wide running median over 2*radius+1 frames (odd-reflected at clip
        # ends), faded to the source at clip edges. Removes long jitter runs
        # that a median-of-3 cannot. The window stays sorted as it slides:
        # each frame removes the frame that leaves (Slide::outgoing) and
        # inserts the one that enters (Slide::incoming), O(log w) to find each
        # slot instead of re-sorting 2r+1 values per frame. The fade is
        # Fade::eased_weight (`fade_at` in its domain) and the blend Gate::apply
        # (`blend` within +-LIMIT).
        def median(values: darray[i64]&, radius: i64, edge: i64) -> darray[i64]:
            count: i64 = values.count.i64()
            out: mutable darray[i64] = []
            for v in values |out|:
                out.push(v)
            return out if count < 3 or radius < 1 or radius > Window::MAX_RADIUS or radius > Slide::REACH_MAX or count >= Window::MAX_FRAMES or count >= Slide::SPAN_MAX
            window: mutable darray[i64] = []
            for d in 0..<(2 * radius + 1) |d, values, window, radius|:
                sorted_insert(&window, odd_sample(values, d - radius))
            for f in 0..<count |f, values, out, window, count, radius, edge|:
                if f >= 1:
                    sorted_remove(&window, odd_sample(values, Slide::outgoing(f, radius)))
                    sorted_insert(&window, odd_sample(values, Slide::incoming(f, radius)))
                m: i64 = middle_of(window.count.i64())
                w: i64 = fade_at(f, count - 1, edge, false, true)
                put(&out, f, blend(item(values, f), item(window, m), w))
            return out

        # Smooth::binomial for any values (its body outside +-Smooth::LIMIT).
        def binomial(a: i64, b: i64, c: i64) -> i64:
            if a >= -Smooth::LIMIT and a <= Smooth::LIMIT and b >= -Smooth::LIMIT and b <= Smooth::LIMIT and c >= -Smooth::LIMIT and c <= Smooth::LIMIT:
                return Smooth::binomial(a, b, c)
            return b if a == b and b == c
            return (a + 2 * b + c) / 4

        # One 1-2-1 pass from `src` into `dst` (same length); without looping,
        # interior frames read their neighbours directly and the ends are
        # padded as before (looping keeps `sample`, as in despike_pass).
        def smooth_pass(src: darray[i64]&, dst: mutable darray[i64]&, looping: bool) -> void:
            count: i64 = src.count.i64()
            for f in 0..<count |f, src, dst, count, looping|:
                if not looping and f >= 1 and f + 1 < count:
                    a: i64 = item(src, f - 1)
                    b: i64 = item(src, f)
                    c: i64 = item(src, f + 1)
                    put(dst, f, binomial(a, b, c))
                else:
                    before: mutable i64 = 0
                    after: mutable i64 = 0
                    if looping:
                        before <- sample(src, f - 1, true)
                        after <- sample(src, f + 1, true)
                    else:
                        before <- odd_sample(src, f - 1)
                        after <- odd_sample(src, f + 1)
                    now: i64 = item(src, f)
                    put(dst, f, binomial(before, now, after))

        # Repeated 1-2-1 smoothing, faded to the source at clip edges; two
        # buffers are reused for every pass.
        def smooth(values: darray[i64]&, passes: i64, edge: i64, looping: bool) -> darray[i64]:
            count: i64 = values.count.i64()
            first: mutable darray[i64] = []
            second: mutable darray[i64] = []
            for v in values |first, second|:
                first.push(Order::clamp(v, -SMOOTH_LIMIT, SMOOTH_LIMIT))
                second.push(0)
            return first if count < 3
            side: mutable i64 = 1
            round: mutable i64 = 0
            while round < passes:
                invariant side >= 0
                invariant side <= 1
                if side == 1:
                    smooth_pass(&first, &second, looping)
                else:
                    smooth_pass(&second, &first, looping)
                side <- Slide::flip(side)
                round <- round + 1
            return faded(values, &first, edge, looping, true) if side == 1
            return faded(values, &second, edge, looping, true)

        # Spike::is_spike for any values (its body outside +-Spike::LIMIT).
        def spiked(prev: i64, now: i64, next: i64, threshold: i64) -> bool:
            if threshold >= 0 and prev >= -Spike::LIMIT and prev <= Spike::LIMIT and now >= -Spike::LIMIT and now <= Spike::LIMIT and next >= -Spike::LIMIT and next <= Spike::LIMIT:
                return Spike::is_spike(prev, now, next, threshold)
            out: i64 = now - prev
            back: i64 = next - now
            return false if out == 0 or back == 0
            return false if (out > 0) == (back > 0)
            bend: i64 = prev - 2 * now + next
            size: mutable i64 = bend
            if bend < 0:
                size <- -bend
            return size > threshold

        # Count spikes in a track (the de-spike detector).
        def spike_count(values: darray[i64]&, threshold: i64, looping: bool) -> i64:
            total: mutable i64 = 0
            count: i64 = values.count.i64()
            for f in 0..<count |f, values, total, threshold, looping|:
                total <- total + 1 if spiked(sample(values, f - 1, looping), item(values, f), sample(values, f + 1, looping), threshold)
            return total

        # Contact::step for any thresholds (its body when enter > leave).
        def stepped(planted: bool, height: i64, speed: i64, enter: i64, leave: i64, max_speed: i64) -> bool:
            return Contact::step(planted, height, speed, enter, leave, max_speed) if enter <= leave
            return false if speed > max_speed
            return height <= leave if planted
            return height <= enter

        # Contact flags from heights and speeds with hysteresis.
        def contacts(heights: darray[i64]&, speeds: darray[i64]&, enter: i64, leave: i64, max_speed: i64) -> darray[bool]:
            flags: mutable darray[bool] = []
            planted: mutable bool = false
            for i in 0..<heights.count |i, heights, speeds, flags, planted, enter, leave, max_speed|:
                speed: i64 = get speeds[i] else 0
                planted <- stepped(planted, heights[i], speed, enter, leave, max_speed)
                flags.push(planted)
            return flags

        # Pin planted frames of a height track to the floor.
        def pin(heights: darray[i64]&, flags: darray[bool]&, floor: i64) -> darray[i64]:
            out: mutable darray[i64] = []
            for i in 0..<heights.count |i, heights, flags, out, floor|:
                planted: bool = get flags[i] else false
                out.push(Contact::pinned_height(planted, heights[i], floor))
            return out

        # Seam::pull for any clip length (its body beyond MAX_FRAMES).
        def pulled(frame: i64, last: i64, window: i64) -> i64:
            requires last >= 1
            requires window >= 1
            requires window <= last
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= Fade::FULL
            return Seam::pull(frame, last, window) if last < Seam::MAX_FRAMES
            start: i64 = last - window
            return 0 if frame <= start
            return Fade::FULL if frame == last
            into: i64 = frame - start
            w: i64 = into * Fade::FULL / window
            # 0 < into < window here, so w is already in [0, FULL].
            return Fade::FULL if w > Fade::FULL
            return 0 if w < 0
            return w

        # Close a loop seam: pull the last `window` frames toward a linear
        # continuation into frame 0 (Gate::apply through `blend`).
        def close_seam(values: darray[i64]&, window: i64) -> darray[i64]:
            out: mutable darray[i64] = []
            for v in values |out|:
                out.push(v)
            last: i64 = values.count.i64() - 1
            return out if last < 1 or window < 1 or window > last
            target_end: i64 = item(values, 0)
            count: i64 = last + 1
            for f in 0..<count |f, values, out, last, window, target_end|:
                # Always true (f < count = last + 1, and the guard above);
                # restated because the loop body does not carry the guard.
                if f >= 0 and f <= last and window >= 1 and window <= last:
                    w: i64 = pulled(f, last, window)
                    source: i64 = item(values, f)
                    put(&out, f, blend(source, target_end, w))
            return out

        # Sum of the clamped channel values (wring_guard's numerator).
        def wring_total(values: darray[i64]&) -> i64:
            total: mutable i64 = 0
            for v in values |total|:
                total <- total + wring_value(v)
            return total

        # The guard pose: the mean of the channel clamped to half the
        # stability range, clamped again into that range.
        def wring_guard(values: darray[i64]&) -> i64:
            ensure result >= -WRING_HALF
            ensure result <= WRING_HALF
            n: i64 = values.count.i64()
            # n is 0 here, so this is 0 (a literal 0 does not establish a
            # negative lower bound for the prover; a clamped name does).
            return wring_value(n) if values.count == 0
            total: i64 = wring_total(values)
            mean: i64 = total / n
            return wring_value(mean)

        # One frame of limit_wring, the value clamped like the guard.
        def wring_one(v: i64, about: i64, bound: i64) -> i64:
            requires bound >= 0
            requires bound <= Stability::LIMIT
            value: i64 = wring_value(v)
            # Never taken: value is a wring_value and `about` the wring_guard,
            # both within WRING_HALF = STABLE_LIMIT / 2. Written in
            # limit_wring's own terms, which the prover matches directly.
            return value if value < -STABLE_LIMIT / 2 or value > STABLE_LIMIT / 2 or about < -STABLE_LIMIT / 2 or about > STABLE_LIMIT / 2
            return Stability::limit_wring(value, about, bound)

        # Knee/elbow stability: soft-limit a channel about its mean (the guard pose).
        def limit_wring(values: darray[i64]&, limit: i64) -> darray[i64]:
            out: mutable darray[i64] = []
            return out if values.count == 0
            about: i64 = wring_guard(values)
            bound: i64 = Order::clamp(limit, 0, Stability::LIMIT)
            for v in values |out, about, bound|:
                out.push(wring_one(v, about, bound))
            return out

        # Last frame of the planted run that starts at `start`.
        def run_end(flags: darray[bool]&, start: i64, count: i64) -> i64:
            requires start >= 0
            requires start < count
            ensure result >= start
            ensure result < count
            finish: mutable i64 = start
            while finish + 1 < count:
                invariant finish >= start
                invariant finish < count
                break if not flag(flags, finish + 1)
                finish <- finish + 1
            return finish

        # First planted frame after `f`, or `count` when none is.
        def next_plant(flags: darray[bool]&, f: i64, count: i64) -> i64:
            requires f < count
            ensure result > f
            ensure result <= count
            next: mutable i64 = f + 1
            while next < count:
                invariant next > f
                invariant next <= count
                break if flag(flags, next)
                next <- next + 1
            return next

        # Foot-slide lock: hold each planted run of a foot channel at its value
        # on the plant frame, ramping in and out over `blend` frames.
        def lock(values: darray[i64]&, flags: darray[bool]&, blend: i64) -> darray[i64]:
            out: mutable darray[i64] = []
            for v in values |out|:
                out.push(v)
            count: i64 = values.count.i64()
            return out if count == 0 or count > Fade::MAX_FRAMES or blend < 1 or blend > Fade::MAX_EDGE
            start: mutable i64 = 0
            while start < count:
                invariant start >= 0
                invariant count <= Fade::MAX_FRAMES
                invariant blend >= 1
                invariant blend <= Fade::MAX_EDGE
                if not flag(flags, start):
                    start <- start + 1
                    continue
                finish: i64 = run_end(flags, start, count)
                held: i64 = item(values, start)
                # Never taken (run_end ensures start <= finish < count); the
                # prover does not tie `finish` to those ensures, so say it.
                break if finish < start or finish >= count
                lock_run(values, &out, start, finish, blend)
                start <- finish + 1
            return out

        # Hold one planted run start..finish at its plant value (lock's inner
        # loop, in a body of its own to stay within the fact budget).
        def lock_run(values: darray[i64]&, out: mutable darray[i64]&, start: i64, finish: i64, ramp: i64) -> void:
            requires ramp >= 1
            requires ramp <= Fade::MAX_EDGE
            requires start >= 0
            requires start <= finish
            requires finish < Fade::MAX_FRAMES
            held: i64 = item(values, start)
            anchor: i64 = lock_value(held)
            stop: i64 = finish + 1
            for f in start..<stop |f, start, finish, values, out, anchor, ramp|:
                into: i64 = f - start
                left: i64 = finish - f
                # Always true (lock passes start <= f <= finish < count <=
                # MAX_FRAMES and anchor is a lock_value); restated for the body.
                if into >= 0 and into <= Fade::MAX_FRAMES and left >= 0 and left <= Fade::MAX_FRAMES and ramp >= 1 and ramp <= Fade::MAX_EDGE and anchor >= -LOCK_LIMIT and anchor <= LOCK_LIMIT:
                    put(out, f, lock_frame(item(values, f), anchor, into, left, ramp))

        # One frame of `lock`: Lock::locked on the clamped value.
        def lock_frame(raw: i64, anchor: i64, into: i64, left: i64, ramp: i64) -> i64:
            requires anchor >= -LOCK_LIMIT
            requires anchor <= LOCK_LIMIT
            requires into >= 0
            requires into <= Fade::MAX_FRAMES
            requires left >= 0
            requires left <= Fade::MAX_FRAMES
            requires ramp >= 1
            requires ramp <= Fade::MAX_EDGE
            v: i64 = lock_value(raw)
            return Lock::locked(v, anchor, into, left, ramp)

        # Spread planted corrections into the swing: a planted frame keeps its
        # own offset in full; a swing frame gets the offset of the run before
        # it and of the run after it, each eased out over at least `blend` frames
        # and slowly enough to move at most `step` per frame (Footing::span), so the catch-up happens in the air.
        def carried(offsets: darray[i64]&, flags: darray[bool]&, blend: i64, step: i64) -> darray[i64]:
            valid: bool = blend >= 1 and blend <= Fade::MAX_EDGE
            blends: mutable darray[i64] = []
            for v in offsets |blends, valid, blend|:
                blends.push(blend if valid else 0)
            if not valid:
                for k in 0..<blends.count |k, blends|:
                    blends[k] <- 0
                return blends
            return carried_blends(offsets, flags, &blends, step)

        # One side of a swing frame's carried offset: the plant's offset
        # eased out over `distance` frames at the plant's blend.
        def carried_side(offset: i64, distance: i64, blend: i64, step: i64) -> i64:
            requires step >= 1
            requires step <= Footing::LIMIT
            reach: i64 = bounded(distance, 1, Fade::MAX_FRAMES)
            return side_eased(offset, reach, blend, step)

        # carried_side split one clamp per function: the prover keeps the
        # ensures of one call result per body, not of three.
        def side_eased(offset: i64, reach: i64, ramp: i64, step: i64) -> i64:
            requires reach >= 1
            requires reach <= Fade::MAX_FRAMES
            requires step >= 1
            requires step <= Footing::LIMIT
            ease: i64 = bounded(ramp, 1, Fade::MAX_EDGE)
            return side_held(offset, reach, ease, step)

        def side_held(offset: i64, reach: i64, ease: i64, step: i64) -> i64:
            requires reach >= 1
            requires reach <= Fade::MAX_FRAMES
            requires ease >= 1
            requires ease <= Fade::MAX_EDGE
            requires step >= 1
            requires step <= Footing::LIMIT
            held: i64 = foot_value(offset)
            return carry_over(held, reach, ease, step)

        def carry_over(held: i64, reach: i64, ease: i64, step: i64) -> i64:
            requires held >= -FOOT_LIMIT
            requires held <= FOOT_LIMIT
            requires reach >= 1
            requires reach <= Fade::MAX_FRAMES
            requires ease >= 1
            requires ease <= Fade::MAX_EDGE
            requires step >= 1
            requires step <= Footing::LIMIT
            width: i64 = Footing::span(held, step, ease)
            return Footing::carry(held, reach, width)

        # The carried offset of one swing frame `g` between the plant at
        # `prev` (-1: none) and the one at `next` (`count`: none). A missing
        # plant contributes offset 0 at distance MAX_EDGE with blend 1.
        def carried_at(offsets: darray[i64]&, blends: darray[i64]&, g: i64, prev: i64, next: i64, count: i64, step: i64) -> i64:
            requires step >= 1
            requires step <= Footing::LIMIT
            first: mutable i64 = carried_side(0, Fade::MAX_EDGE, 1, step)
            if prev >= 0:
                before: i64 = item(offsets, prev)
                release: i64 = item(blends, prev)
                first <- carried_side(before, g - prev, release, step)
            second: mutable i64 = carried_side(0, Fade::MAX_EDGE, 1, step)
            if next < count:
                after: i64 = item(offsets, next)
                approach: i64 = item(blends, next)
                second <- carried_side(after, next - g, approach, step)
            return first + second

        # Carry with a blend per frame: a free stretch eases out over the
        # blend of the plant it leaves and in over the blend of the plant it
        # reaches (the adaptive release of a straight leg).
        def carried_blends(offsets: darray[i64]&, flags: darray[bool]&, blends: darray[i64]&, step: i64) -> darray[i64]:
            out: mutable darray[i64] = []
            for v in offsets |out|:
                out.push(0)
            count: i64 = offsets.count.i64()
            return out if count == 0 or count > Fade::MAX_FRAMES or blends.count.i64() < count or flags.count.i64() < count or step < 1 or step > Footing::LIMIT
            for f in 0..<count |f, offsets, flags, out|:
                if flag(flags, f):
                    planted: i64 = item(offsets, f)
                    put(&out, f, foot_value(planted))
            prev: mutable i64 = -1
            f: mutable i64 = 0
            while f < count:
                invariant f >= 0
                invariant step >= 1
                invariant step <= Footing::LIMIT
                if flag(flags, f):
                    prev <- f
                    f <- f + 1
                    continue
                next: i64 = next_plant(flags, f, count)
                carry_gap(offsets, blends, &out, f, next, prev, count, step)
                # Never taken (next_plant ensures next > f); the call above
                # drops that fact, the loop invariant needs it.
                break if next <= f
                f <- next
            return out

        # Fill the free frames f..<next of carried_blends (its inner loop,
        # in a body of its own to stay within the prover's fact budget).
        def carry_gap(offsets: darray[i64]&, blends: darray[i64]&, out: mutable darray[i64]&, f: i64, next: i64, prev: i64, count: i64, step: i64) -> void:
            requires step >= 1
            requires step <= Footing::LIMIT
            for g in f..<next |g, f, next, prev, count, offsets, out, blends, step|:
                put(out, g, carried_at(offsets, blends, g, prev, next, count, step))

        # Offset that holds each planted frame at its run's first value.
        def hold_offsets(values: darray[i64]&, flags: darray[bool]&) -> darray[i64]:
            out: mutable darray[i64] = []
            anchor: mutable i64 = 0
            count: i64 = values.count.i64()
            for k in 0..<count |k, values, flags, out, anchor|:
                planted: bool = flag(flags, k)
                raw: i64 = item(values, k)
                if planted and (k == 0 or not flag(flags, k - 1)):
                    anchor <- lock_value(raw)
                v: i64 = lock_value(raw)
                if planted:
                    out.push(anchor - v)
                else:
                    out.push(0)
            return out
