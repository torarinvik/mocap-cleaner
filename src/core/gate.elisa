# Operation gating: which frames and bones an operation may change.
include "span.elisa"
include "fade.elisa"

module Gate:
    public:
        const MAX_BONES: i64 = 256

        def bone_selected(mask_word: i64, bone: i64) -> bool:
            requires bone >= 0
            requires bone < 62
            ensure true
            return (mask_word >> bone) & 1 == 1

        # Effect weight of an operation on one frame, in permille.
        def weight(enabled: bool, in_range: bool, selected: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::FULL
            ensure result >= 0
            ensure result <= Fade::FULL
            ensure enabled or result == 0
            ensure in_range or result == 0
            ensure selected or result == 0
            ensure not enabled or not in_range or not selected or result == fade
            return 0 if not enabled
            return 0 if not in_range
            return 0 if not selected
            return fade

        # Apply a gated change to one fixed-point channel value.
        def apply(source: i64, fixed: i64, weight: i64) -> i64:
            requires weight >= 0
            requires weight <= Fade::FULL
            requires source >= -1000000000
            requires source <= 1000000000
            requires fixed >= -1000000000
            requires fixed <= 1000000000
            ensure weight != 0 or result == source
            ensure weight != Fade::FULL or result == fixed
            ensure source != fixed or result == source
            return source if source == fixed
            return source if weight == 0
            return fixed if weight == Fade::FULL
            return source + (fixed - source) * weight / Fade::FULL
