include "cache_budget_arithmetic.elisa"

module RigCacheBudgetPolicy:
    public:
        const module Limit:
            MAX_LOGICAL_BYTES: i64 = 268435456
        const module LogicalSize:
            JOINT_BYTES: i64 = 192
            OPERATION_BYTES: i64 = 80
            INDEX_BYTES: i64 = 8
            QUATERNION_BYTES: i64 = 32
            VECTOR_BYTES: i64 = 24
            FLAG_BYTES: i64 = 1
            RETAINED_CLIPS: i64 = 3

        def add_array(total: i64, count: i64, entry_bytes: i64) -> i64:
            bytes: i64 = CacheBudgetArithmetic::bounded_product(count, entry_bytes, Limit::MAX_LOGICAL_BYTES)
            CacheBudgetArithmetic::bounded_sum(total, bytes, Limit::MAX_LOGICAL_BYTES)

        def admits(clip_bytes: i64, operations: i64) -> bool:
            ensure result implies clip_bytes >= 0 and operations >= 0
            snapshots: i64 = CacheBudgetArithmetic::bounded_product(clip_bytes, LogicalSize::RETAINED_CLIPS, Limit::MAX_LOGICAL_BYTES)
            total: i64 = add_array(snapshots, operations, LogicalSize::OPERATION_BYTES + LogicalSize::INDEX_BYTES)
            total >= 0
