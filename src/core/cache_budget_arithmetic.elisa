# Checked scalar arithmetic shared by cache admission policies.
module CacheBudgetArithmetic:
    public:
        const module ChannelLayout:
            VALUE_BYTES: i64 = 8
            OPERATION_BYTES: i64 = 64

        # Return -1 when a checked sum is invalid or exceeds its budget. Both
        # operands are bounded before subtraction and addition, avoiding i64
        # overflow even when callers present hostile counts.
        def bounded_sum(left: i64, right: i64, limit: i64) -> i64:
            requires limit >= 0
            ensure result == -1 or result >= 0
            ensure left >= 0 and right >= 0 and left <= limit and right <= limit and left <= limit - right implies result == left + right
            return -1 if left < 0 or right < 0 or left > limit or right > limit
            return -1 if left > limit - right
            left + right

        # Estimate a logical byte count without ever forming an overflowing
        # product. A negative sentinel means invalid or above-limit input.
        def bounded_product(count: i64, bytes_per_entry: i64, limit: i64) -> i64:
            requires limit >= 0
            ensure result == -1 or result >= 0
            return -1 if count < 0 or bytes_per_entry < 0 or bytes_per_entry > limit
            return 0 if bytes_per_entry == 0
            return -1 if count > limit / bytes_per_entry
            count * bytes_per_entry

