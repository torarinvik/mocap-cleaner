include "report_budget.elisa"

module ReportIndexKernel:
    public:
        def midpoint(first: i64, stop: i64) -> i64:
            requires first >= 0 and first < stop
            requires stop <= ReportBudget::Capacity::BYTES
            ensure result >= first and result < stop
            ensure result == first + (stop - first) / 2
            first + (stop - first) / 2

        def next_width(width: i64) -> i64:
            requires width >= 1 and width <= ReportBudget::Capacity::BYTES
            ensure result == width * 2
            ensure result > width
            ensure result <= ReportBudget::Capacity::BYTES * 2
            width * 2
