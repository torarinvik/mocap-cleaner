# Order statistics on fixed-point samples. The running-median de-spike picks the
# median of a small window; these are its building blocks.
module Order:
    public:
        const LIMIT: i64 = 1000000000000   # |sample| bound: 1e12 fixed-point units

        def low(a: i64, b: i64) -> i64:
            ensure result <= a
            ensure result <= b
            ensure result == a or result == b
            return a if a <= b
            return b

        def high(a: i64, b: i64) -> i64:
            ensure result >= a
            ensure result >= b
            ensure result == a or result == b
            return a if a >= b
            return b

        # Median of three: one of the samples, and never above both others nor below both.
        def median3(a: i64, b: i64, c: i64) -> i64:
            ensure result == a or result == b or result == c
            ensure result <= a or result <= b
            ensure result >= a or result >= b
            ensure result <= b or result <= c
            ensure result >= b or result >= c
            ensure result <= a or result <= c
            ensure result >= a or result >= c
            if a <= b:
                return b if b <= c
                return a if c <= a
                return c
            return a if a <= c
            return b if c <= b
            return c

        # Clamp a sample into [lo, hi].
        def clamp(value: i64, lo: i64, hi: i64) -> i64:
            requires lo <= hi
            ensure result >= lo
            ensure result <= hi
            ensure value < lo or value > hi or result == value
            return lo if value < lo
            return hi if value > hi
            return value

        def absolute(value: i64) -> i64:
            requires value >= -LIMIT
            requires value <= LIMIT
            ensure result >= 0
            ensure result <= LIMIT
            ensure result == value or result == -value
            return -value if value < 0
            return value
