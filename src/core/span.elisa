# Frame ranges used to scope operations. `first..last` inclusive.
module Span:
    public:
        const MAX_FRAMES: i64 = 10000000

        def valid(first: i64, last: i64, count: i64) -> bool:
            requires count >= 0
            requires count <= MAX_FRAMES
            ensure not result or first >= 0
            ensure not result or first <= last
            ensure not result or last < count
            return first >= 0 and first <= last and last < count

        def contains(first: i64, last: i64, frame: i64) -> bool:
            ensure not result or frame >= first
            ensure not result or frame <= last
            ensure result or frame < first or frame > last
            return frame >= first and frame <= last

        def length(first: i64, last: i64) -> i64:
            requires first >= 0
            requires first <= last
            requires last < MAX_FRAMES
            ensure result >= 1
            ensure result <= MAX_FRAMES
            return last - first + 1

        # Clamp a frame into the clip.
        def clamp(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= MAX_FRAMES
            ensure result >= 0
            ensure result < count
            ensure frame < 0 or frame >= count or result == frame
            return 0 if frame < 0
            return count - 1 if frame >= count
            return frame

        # Wrap a frame into a looping clip.
        def wrap(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= MAX_FRAMES
            requires frame > -MAX_FRAMES
            requires frame < 2 * MAX_FRAMES
            ensure result >= 0
            ensure result < count
            shifted: i64 = frame + MAX_FRAMES
            rem: i64 = shifted % count
            return rem
