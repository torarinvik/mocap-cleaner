# Hinge-joint decisions in micro-radians: angle wrapping for pole tracks,
# how much off-hinge rotation a knee or elbow keeps, and how much of the
# removed twist moves to a roll bone.
include "fade.elisa"

module Hinge:
    public:
        const PI: i64 = 3141593
        const TWO_PI: i64 = 6283186
        const LIMIT: i64 = 1000000000

        # The same angle in (-PI, PI], for an angle within two turns.
        def wrap_angle(angle: i64) -> i64:
            requires angle >= -6283186
            requires angle <= 6283186
            ensure result > -3141593
            ensure result <= 3141593
            ensure angle <= -3141593 or angle > 3141593 or result == angle
            if angle > 3141593:
                return angle - 6283186
            if angle <= -3141593:
                return angle + 6283186
            return angle

        # Step from raw pole angle `previous` to raw `angle` (both in
        # [-PI, PI]) taken the short way round, so an accumulated pole track
        # never jumps by 2 PI across the +-PI seam.
        def unwrap_step(previous: i64, angle: i64) -> i64:
            requires previous >= -3141593
            requires previous <= 3141593
            requires angle >= -3141593
            requires angle <= 3141593
            ensure result > -3141593
            ensure result <= 3141593
            ensure angle - previous <= -3141593 or angle - previous > 3141593 or result == angle - previous
            d: i64 = angle - previous
            if d > 3141593:
                return d - 6283186
            if d <= -3141593:
                return d + 6283186
            return d

        # Off-hinge rotation a hinge keeps: at most `tolerance`. A zero
        # tolerance rebuilds the joint from the hinge plane alone.
        def kept_off_axis(off: i64, tolerance: i64) -> i64:
            requires off >= 0
            requires off <= LIMIT
            requires tolerance >= 0
            requires tolerance <= LIMIT
            ensure result >= 0
            ensure result <= off
            ensure result <= tolerance
            ensure off > tolerance or result == off
            ensure off <= tolerance or result == tolerance
            return off if off <= tolerance
            return tolerance

        # Part of a removed twist that moves to the roll bone (share permille).
        def roll_share(removed: i64, share: i64) -> i64:
            requires removed >= -1000000000
            requires removed <= 1000000000
            requires share >= 0
            requires share <= 1000
            ensure share != 0 or result == 0
            ensure share != 1000 or result == removed
            ensure removed < 0 or result >= 0
            ensure removed < 0 or result <= removed
            ensure removed > 0 or result <= 0
            ensure removed > 0 or result >= removed
            if share == 0 or removed == 0:
                return 0
            if share == 1000:
                return removed
            if removed > 0:
                p: i64 = removed * share / 1000
                if p < 0:
                    return 0
                if p > removed:
                    return removed
                return p
            n: i64 = (0 - removed) * share / 1000
            if n < 0:
                return 0
            if n > 0 - removed:
                return removed
            return 0 - n

        # Roll a hinge keeps about its bone once `share` of it moved to the
        # roll bone: all of it with no roll bone (share 0), none at 1000.
        def kept_roll(roll: i64, share: i64) -> i64:
            requires roll >= -1000000000
            requires roll <= 1000000000
            requires share >= 0
            requires share <= 1000
            ensure share != 0 or result == roll
            ensure share != 1000 or result == 0
            ensure roll < 0 or result >= 0
            ensure roll < 0 or result <= roll
            ensure roll > 0 or result <= 0
            ensure roll > 0 or result >= roll
            moved: i64 = roll_share(roll, share)
            return roll - moved
