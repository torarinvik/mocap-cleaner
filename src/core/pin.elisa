# Range weights for user layers (pin and offset): an end effector pin or an
# additive offset acts on frames first..last, ramping in from `first` and out
# to `last` over `blend` frames, and is exactly zero outside the range.
include "lock.elisa"

module Pin:
    public:
        def pin_weight(frame: i64, first: i64, last: i64, blend: i64) -> i64:
            requires frame >= 0
            requires frame <= Fade::Domain::MAX_FRAMES
            requires first >= 0
            requires first <= last
            requires last <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result >= 0
            ensure result <= Fade::Domain::FULL_PERMILLE
            ensure frame >= first or result == 0
            ensure frame <= last or result == 0
            ensure frame != first or result == 0
            ensure frame != last or result == 0
            ensure frame - first < blend or last - frame < blend or result == Fade::Domain::FULL_PERMILLE
            return 0 if frame < first or frame > last
            return Lock::hold(frame - first, last - frame, blend)
