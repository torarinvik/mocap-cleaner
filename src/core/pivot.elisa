# Heel/ball pivot of a planted foot. While a foot is planted it turns about
# whichever of its heel and ball is lower; that point is locked to its plant
# position and settled on the floor (no sink, no float), and the ankle is
# shifted by the same amount. A hysteresis margin keeps the choice from
# flickering when heel and ball are level.
include "gate.elisa"

module Pivot:
    public:
        const HEEL: i64 = 0
        const BALL: i64 = 1
        const LIMIT: i64 = 1000000000

        # The pivot for this frame from the previous one and the heel and
        # ball heights (micro-units above the floor).
        def choose(previous: i64, heel: i64, ball: i64, margin: i64) -> i64:
            requires previous >= 0
            requires previous <= 1
            requires heel >= -1000000000
            requires heel <= 1000000000
            requires ball >= -1000000000
            requires ball <= 1000000000
            requires margin >= 0
            requires margin <= 1000000000
            ensure result >= 0
            ensure result <= 1
            ensure ball + margin >= heel or result == 1
            ensure heel + margin >= ball or result == 0
            ensure ball + margin < heel or heel + margin < ball or result == previous
            return 1 if ball + margin < heel
            return 0 if heel + margin < ball
            return previous

        # Ankle shift (one channel) that carries the pivot from `point` to its
        # locked position `held`, at lock weight `w`.
        def shift(point: i64, held: i64, w: i64) -> i64:
            requires point >= -1000000000
            requires point <= 1000000000
            requires held >= -1000000000
            requires held <= 1000000000
            requires w >= 0
            requires w <= 1000
            ensure w != 0 or result == 0
            ensure w != 1000 or result == held - point
            ensure point != held or result == 0
            moved: i64 = Gate::apply(point, held, w)
            return moved - point

        # Pivot height target: a fully locked pivot sits exactly on the floor;
        # an unlocked one keeps its height.
        def settle(height: i64, floor: i64, w: i64) -> i64:
            requires height >= -1000000000
            requires height <= 1000000000
            requires floor >= -1000000000
            requires floor <= 1000000000
            requires w >= 0
            requires w <= 1000
            ensure w != 1000 or result == floor
            ensure w != 0 or result == height
            ensure height != floor or result == floor
            return Gate::apply(height, floor, w)
