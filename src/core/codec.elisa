# Decimal field codec for the ops file: one rig operation per line, its
# fields written as signed decimal integers. Every digit step goes through
# these kernels so the reader and the writer agree on the value range.
module Codec:
    public:
        const module Domain:
            FIELD_MAGNITUDE: i64 = 1000000000000
            KIND_COUNT: i64 = 9

        def kind_ok(code: i64) -> bool:
            ensure not result or code >= 0
            ensure not result or code < Domain::KIND_COUNT
            ensure code < 0 or code >= Domain::KIND_COUNT or result
            return code >= 0 and code < Domain::KIND_COUNT

        # Append one decimal digit to a magnitude being read.
        def push_digit(acc: i64, d: i64) -> i64:
            requires acc >= 0
            requires acc <= Domain::FIELD_MAGNITUDE
            requires d >= 0
            requires d <= 9
            ensure result >= acc
            ensure result == acc * 10 + d
            ensure result <= 10000000000009
            ensure acc > 99999999999 or result <= 999999999999
            return acc * 10 + d

        # A magnitude stays readable while it is within the field limit.
        def in_limit(acc: i64) -> bool:
            ensure not result or acc <= Domain::FIELD_MAGNITUDE
            ensure not result or acc >= 0
            ensure acc < 0 or acc > Domain::FIELD_MAGNITUDE or result
            return acc >= 0 and acc <= Domain::FIELD_MAGNITUDE

        # Lowest decimal digit of a magnitude being written.
        def last_digit(value: i64) -> i64:
            requires value >= 0
            ensure result >= 0
            ensure result <= 9
            ensure value >= 10 or result == value
            if value < 10:
                return value
            return value % 10

        # The magnitude left after writing its lowest digit.
        def drop_digit(value: i64) -> i64:
            requires value >= 0
            ensure result >= 0
            ensure result <= value
            ensure value < 10 or result >= 1
            ensure value >= 10 or result == 0
            ensure value == 0 or result < value
            if value < 10:
                return 0
            q: i64 = value / 10
            if q < 1:
                return 1
            if q >= value:
                return value - 1
            return q

        # The signed value of a field from its sign and magnitude.
        def signed(negative: bool, magnitude: i64) -> i64:
            requires magnitude >= 0
            requires magnitude <= Domain::FIELD_MAGNITUDE
            ensure negative or result == magnitude
            ensure not negative or result == 0 - magnitude
            ensure result >= -Domain::FIELD_MAGNITUDE
            ensure result <= Domain::FIELD_MAGNITUDE
            return 0 - magnitude if negative
            return magnitude
