include "regress.elisa"

# Exact common-scale admission for decimal report metrics. Never round a
# discarded fraction into a passing regression verdict.
module ReportDecimal:
    public:
        const module Capacity:
            FACTOR: i64 = 1000000000
            DIGITS: i64 = 9

        def factor(digits: i64) -> i64:
            requires digits >= 0 and digits <= Capacity::DIGITS
            ensure result >= 1 and result <= Capacity::FACTOR
            ensure digits != 0 or result == 1
            ensure digits != 1 or result == 10
            ensure digits != 2 or result == 100
            ensure digits != 3 or result == 1000
            ensure digits != 4 or result == 10000
            ensure digits != 5 or result == 100000
            ensure digits != 6 or result == 1000000
            ensure digits != 7 or result == 10000000
            ensure digits != 8 or result == 100000000
            ensure digits != 9 or result == Capacity::FACTOR
            return match digits:
                0: 1
                1: 10
                2: 100
                3: 1000
                4: 10000
                5: 100000
                6: 1000000
                7: 10000000
                8: 100000000
                _: Capacity::FACTOR

        def can_scale(value: i64, factor: i64) -> bool:
            requires factor >= 1 and factor <= Capacity::FACTOR
            ensure result == (value >= 0 - Regress::Domain::MAGNITUDE / factor and value <= Regress::Domain::MAGNITUDE / factor)
            value >= 0 - Regress::Domain::MAGNITUDE / factor and value <= Regress::Domain::MAGNITUDE / factor

        def scale(value: i64, factor: i64) -> i64:
            requires factor >= 1 and factor <= Capacity::FACTOR
            requires value >= 0 - Regress::Domain::MAGNITUDE / factor
            requires value <= Regress::Domain::MAGNITUDE / factor
            ensure result == value * factor
            ensure result >= 0 - Regress::Domain::MAGNITUDE
            ensure result <= Regress::Domain::MAGNITUDE
            value * factor

        # Admit a decimal digit before multiplication; callers can reject an
        # unavailable coefficient without overflowing or rounding it.
        def can_append_digit(value: i64, digit: i64) -> bool:
            requires value >= 0 and value <= Regress::Domain::MAGNITUDE
            requires digit >= 0 and digit <= 9
            ensure result == (value <= (Regress::Domain::MAGNITUDE - digit) / 10)
            value <= (Regress::Domain::MAGNITUDE - digit) / 10

        def append_digit(value: i64, digit: i64) -> i64:
            requires value >= 0
            requires digit >= 0 and digit <= 9
            requires value <= (Regress::Domain::MAGNITUDE - digit) / 10
            ensure result == value * 10 + digit
            ensure result >= 0 and result <= Regress::Domain::MAGNITUDE
            value * 10 + digit

        enum Alignment:
            Unavailable
            Exact(before: i64, after: i64, floor: i64, exponent: i64)

        # Bring both exact values and the absolute floor onto one integer scale.
        # Admission rejects an unrepresentable comparison rather than rounding.
        def align(before: i64, before_exponent: i64, after: i64,
                  after_exponent: i64, floor: i64) -> Alignment:
            requires before >= 0 - Regress::Domain::MAGNITUDE and before <= Regress::Domain::MAGNITUDE
            requires after >= 0 - Regress::Domain::MAGNITUDE and after <= Regress::Domain::MAGNITUDE
            requires floor >= 0 and floor <= Regress::Domain::MAGNITUDE
            return Alignment.Unavailable if before_exponent < -Capacity::DIGITS or before_exponent > Capacity::DIGITS
            return Alignment.Unavailable if after_exponent < -Capacity::DIGITS or after_exponent > Capacity::DIGITS
            mutable exponent: i64 = 0
            exponent <- before_exponent if before_exponent < exponent
            exponent <- after_exponent if after_exponent < exponent
            before_digits: i64 = before_exponent - exponent
            after_digits: i64 = after_exponent - exponent
            return Alignment.Unavailable if before_digits > Capacity::DIGITS or after_digits > Capacity::DIGITS
            before_factor: i64 = factor(before_digits)
            after_factor: i64 = factor(after_digits)
            floor_factor: i64 = factor(-exponent)
            return Alignment.Unavailable if not can_scale(before, before_factor)
            return Alignment.Unavailable if not can_scale(after, after_factor)
            return Alignment.Unavailable if not can_scale(floor, floor_factor)
            Alignment.Exact(before: scale(before, before_factor), after: scale(after, after_factor), floor: scale(floor, floor_factor), exponent: exponent)
