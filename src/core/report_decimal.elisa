include "regress.elisa"

# Exact common-scale admission for decimal report metrics. Never round a
# discarded fraction into a passing regression verdict.
module ReportDecimal:
    public:
        const module Capacity:
            FACTOR: i64 = 1000000000

        def can_scale(value: i64, factor: i64) -> bool:
            requires factor >= 1 and factor <= Capacity::FACTOR
            ensure result == (value >= 0 - Regress::Domain::MAGNITUDE / factor and value <= Regress::Domain::MAGNITUDE / factor)
            value >= 0 - Regress::Domain::MAGNITUDE / factor and value <= Regress::Domain::MAGNITUDE / factor

        def scale(value: i64, factor: i64) -> i64:
            requires factor >= 1 and factor <= Capacity::FACTOR
            requires value >= 0 - Regress::Domain::MAGNITUDE / factor
            requires value <= Regress::Domain::MAGNITUDE / factor
            ensure result == value * factor
            ensure result >= 0 - Regress::Domain::MAGNITUDE
            ensure result <= Regress::Domain::MAGNITUDE
            value * factor
