# Admission limits for externally supplied comparison reports.
module ReportBudget:
    public:
        const module Capacity:
            BYTES: i64 = 16777216

        def can_append(count: i64) -> bool:
            ensure result == (count >= 0 and count < Capacity::BYTES)
            count >= 0 and count < Capacity::BYTES

        def admitted(count: i64) -> bool:
            ensure result == (count > 0 and count <= Capacity::BYTES)
            count > 0 and count <= Capacity::BYTES
