# Admission limits for externally supplied comparison reports.
module ReportBudget:
    public:
        const module Capacity:
            BYTES: i64 = 16777216
            UNIT_DECLARATIONS: i64 = 128

        def can_append(count: i64) -> bool:
            ensure result == (count >= 0 and count < Capacity::BYTES)
            count >= 0 and count < Capacity::BYTES

        def admitted(count: i64) -> bool:
            ensure result == (count > 0 and count <= Capacity::BYTES)
            count > 0 and count <= Capacity::BYTES

        def unique_identity(count: i64) -> bool:
            ensure result == (count == 1)
            count == 1

        def unit_declarations_admitted(count: i64) -> bool:
            ensure result == (count >= 0 and count <= Capacity::UNIT_DECLARATIONS)
            count >= 0 and count <= Capacity::UNIT_DECLARATIONS
