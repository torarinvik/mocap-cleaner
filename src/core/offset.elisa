# Offset layer: an additive per-bone correction (micro-radians) scaled by its
# layer weight. Zero weight or zero delta leaves the bone exactly as it was.
include "fade.elisa"

module Offset:
    public:
        const LIMIT: i64 = 1000000000

        def offset_amount(delta: i64, w: i64) -> i64:
            requires delta >= -1000000000
            requires delta <= 1000000000
            requires w >= 0
            requires w <= 1000
            ensure w != 0 or result == 0
            ensure w != 1000 or result == delta
            ensure delta < 0 or result >= 0
            ensure delta < 0 or result <= delta
            ensure delta > 0 or result <= 0
            ensure delta > 0 or result >= delta
            if w == 0 or delta == 0:
                return 0
            if w == 1000:
                return delta
            if delta > 0:
                p: i64 = delta * w / 1000
                if p < 0:
                    return 0
                if p > delta:
                    return delta
                return p
            n: i64 = (0 - delta) * w / 1000
            if n < 0:
                return 0
            if n > 0 - delta:
                return delta
            return 0 - n

        # Share of `span` reached `into` frames along a `length`-frame gap:
        # span * into / length, never outside 0..span.
        def segment_share(span: i64, into: i64, length: i64) -> i64:
            requires span >= 0
            requires span <= 2000000000
            requires into >= 0
            requires into <= length
            requires length >= 1
            requires length <= 10000000
            ensure result >= 0
            ensure result <= span
            ensure result <= 2000000000
            ensure into != 0 or result == 0
            ensure into != length or result == span
            if into == 0:
                return 0
            if into == length:
                return span
            r: i64 = span * into / length
            if r < 0:
                return 0
            if r > span:
                return span
            return r

        # Keyed offset curve: linear between keys (f0, a0) and (f1, a1). The
        # curve passes through both keys and never leaves the span of the two.
        def keyed(frame: i64, f0: i64, a0: i64, f1: i64, a1: i64) -> i64:
            requires f0 >= 0
            requires f0 < f1
            requires f1 <= 10000000
            requires frame >= f0
            requires frame <= f1
            requires a0 >= -1000000000
            requires a0 <= 1000000000
            requires a1 >= -1000000000
            requires a1 <= 1000000000
            ensure frame != f0 or result == a0
            ensure frame != f1 or result == a1
            ensure a0 != a1 or result == a0
            ensure a1 < a0 or result >= a0
            ensure a1 < a0 or result <= a1
            ensure a1 > a0 or result <= a0
            ensure a1 > a0 or result >= a1
            if a1 >= a0:
                up: i64 = segment_share(a1 - a0, frame - f0, f1 - f0)
                return a0 + up
            down: i64 = segment_share(a0 - a1, frame - f0, f1 - f0)
            return a0 - down
