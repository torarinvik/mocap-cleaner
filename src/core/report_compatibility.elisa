module ReportCompatibility:
    public:
        const enum Status of i64:
            Unknown = 0
            Compatible = 1
            Incompatible = 2
            Invalid = 3

        def schema_status(left_present: bool, right_present: bool,
                          well_formed: bool, recognized: bool, equal: bool) -> Status:
            ensure not well_formed implies result == Status.Invalid
            ensure result == Status.Compatible implies left_present and right_present and well_formed and recognized and equal
            ensure well_formed and left_present != right_present implies result == Status.Incompatible
            ensure well_formed and left_present and right_present and not equal implies result == Status.Incompatible
            ensure well_formed and not left_present and not right_present implies result == Status.Unknown
            ensure well_formed and left_present and right_present and recognized and equal implies result == Status.Compatible
            ensure well_formed and left_present and right_present and not recognized and equal implies result == Status.Unknown
            if not well_formed:
                return Status.Invalid
            if left_present != right_present:
                return Status.Incompatible
            if not left_present:
                return Status.Unknown
            if not equal:
                return Status.Incompatible
            Status.Compatible if recognized else Status.Unknown
