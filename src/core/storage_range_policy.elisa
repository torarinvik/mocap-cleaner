# Half-open ranges, compared by distance so endpoints never overflow usize.
module StorageRangePolicy:
    public:
        const module FloatLayout:
            COMPONENT_BYTES: usize = 4

        # Divide the available bytes before multiplying dimensions. Invalid
        # starts and oversized counts cannot wrap into an admitted small span.
        def float_span_length(bytes: usize, start: usize, count: usize, components: usize) -> usize?:
            return null if components == 0 or start > bytes
            available: usize = bytes - start
            return null if count > (available / FloatLayout::COMPONENT_BYTES) / components
            count * components * FloatLayout::COMPONENT_BYTES

        def overlaps(a: usize, a_length: usize, b: usize, b_length: usize) -> bool:
            ensure result == (a_length > 0 and b_length > 0 and ((a <= b and b - a < a_length) or (b < a and a - b < b_length)))
            return false if a_length == 0 or b_length == 0
            return b - a < a_length if a <= b
            a - b < b_length
