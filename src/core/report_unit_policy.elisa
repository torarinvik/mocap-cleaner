module ReportUnitPolicy:
    public:
        const enum Dimension of i64:
            Unknown = 0
            Count = 1
            Frames = 2
            Distance = 3
            Angle = 4

        def admitted(expected: Dimension, declared: Dimension) -> bool:
            ensure result implies expected != Dimension.Unknown
            ensure result implies expected == declared
            ensure expected != Dimension.Unknown and expected == declared implies result
            expected != Dimension.Unknown and expected == declared

        def number_admitted(dimension: Dimension, coefficient: i64, exponent: i64) -> bool:
            ensure result implies coefficient >= 0
            ensure result implies dimension != Dimension.Unknown
            ensure result and (dimension == Dimension.Count or dimension == Dimension.Frames) implies exponent >= 0
            return false if coefficient < 0 or dimension == Dimension.Unknown
            return exponent >= 0 if dimension == Dimension.Count or dimension == Dimension.Frames
            true
