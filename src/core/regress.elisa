# Regression verdicts for a report diff. A lower-is-better metric regresses
# when the new value exceeds the old one by more than its allowance: a
# relative tolerance (permille of the old magnitude) plus an absolute floor.
# A run that was ok and is no longer ok, or a clip that disappeared, is a
# regression whatever its numbers. The exit code is 0 when clean, 1 on any
# regression and 2 when a report could not be read.
module Regress:
    public:
        const REG_BOUND: i64 = 1000000000
        const REG_TOL_MAX: i64 = 1000

        # Magnitude of a bounded value.
        def size(value: i64) -> i64:
            requires value >= 0 - REG_BOUND
            requires value <= REG_BOUND
            ensure result >= 0
            ensure result <= REG_BOUND
            ensure value < 0 or result == value
            return value if value >= 0
            return 0 - value

        # Allowed growth over `before`: tolerance permille of its magnitude
        # plus the floor.
        def allowance(before: i64, tol: i64, floor: i64) -> i64:
            requires before >= 0 - REG_BOUND
            requires before <= REG_BOUND
            requires tol >= 0
            requires tol <= REG_TOL_MAX
            requires floor >= 0
            requires floor <= REG_BOUND
            ensure result >= floor
            ensure result <= floor + REG_BOUND
            ensure tol > 0 or result == floor
            return floor if tol == 0
            part: i64 = size(before) * tol / 1000
            return floor + REG_BOUND if part > REG_BOUND
            return floor if part < 0
            return floor + part

        # Did a lower-is-better metric regress?
        def regressed(before: i64, after: i64, allow: i64) -> bool:
            requires allow >= 0
            requires before >= 0 - REG_BOUND
            requires before <= REG_BOUND
            requires after >= 0 - REG_BOUND
            requires after <= REG_BOUND
            requires allow <= REG_BOUND + REG_BOUND
            ensure not result or after > before
            ensure not result or after > before + allow
            ensure after <= before + allow or result
            return after > before + allow

        # A lower-is-better metric, checked with its own allowance.
        def metric_regressed(before: i64, after: i64, tol: i64, floor: i64) -> bool:
            requires before >= 0 - REG_BOUND
            requires before <= REG_BOUND
            requires after >= 0 - REG_BOUND
            requires after <= REG_BOUND
            requires tol >= 0
            requires tol <= REG_TOL_MAX
            requires floor >= 0
            requires floor <= REG_BOUND
            ensure not result or after > before
            ensure not result or after > before + floor
            allow: i64 = allowance(before, tol, floor)
            return regressed(before, after, allow)

        # A run that was ok and no longer is.
        def ok_lost(before: bool, after: bool) -> bool:
            ensure not result or before
            ensure after or not before or result
            ensure not after or not result
            return false if not before
            return false if after
            return true

        # Exit code of a diff.
        def verdict(regressions: i64, errors: i64) -> i64:
            requires regressions >= 0
            requires errors >= 0
            ensure result >= 0
            ensure result <= 2
            ensure errors == 0 or result == 2
            ensure errors > 0 or regressions > 0 or result == 0
            ensure errors > 0 or regressions == 0 or result == 1
            return 2 if errors > 0
            return 1 if regressions > 0
            return 0
