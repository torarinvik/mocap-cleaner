include "key_weight.elisa"

# Shared admission for authored and decoded keyed correction scopes.
module CorrectionScopePolicy:
    public:
        def sampled_channel_admitted(clock_ready: bool, clock_count: i64, frames: i64, keys: i64, frame: i64) -> bool:
            ensure result == (clock_ready and frames > 0 and frames <= KeyWeight::Domain::MAX_FRAMES and clock_count == frames and keys == frames and frame >= 0 and frame < frames)
            clock_ready and frames > 0 and frames <= KeyWeight::Domain::MAX_FRAMES and clock_count == frames and keys == frames and frame >= 0 and frame < frames

        def channel_admitted(found: bool, supported: bool, has_key: bool) -> bool:
            ensure result == (found and supported and has_key)
            found and supported and has_key

        def valid(node: i64, first: i64, key: i64, last: i64) -> bool:
            ensure result == (node >= 0 and first >= 0 and first <= key and key <= last and last <= KeyWeight::Domain::MAX_FRAMES)
            node >= 0 and first >= 0 and first <= key and key <= last and last <= KeyWeight::Domain::MAX_FRAMES

        def can_append(count: i64, capacity: i64, node: i64, first: i64, key: i64, last: i64) -> bool:
            requires capacity > 0
            ensure result == (count >= 0 and count < capacity and valid(node, first, key, last))
            ensure not result or count >= 0
            ensure not result or count < capacity
            count >= 0 and count < capacity and valid(node, first, key, last)
