# Cache bookkeeping for the interactive studio (Phase 6): where a track's
# stack cache lives in a bank, which frames an edit dirtied, when a memoised
# result is still valid, how the rig-stack cache keys its steps around the
# contact-edit boundary, and which bones a gizmo drag moves.
#
# Everything here is pure integer logic with contracts; the laws are in
# proof/perf_cache_laws.elisa. Callers keep the data, these decide reuse.
include "stack_cache.elisa"

module PerfCache:
    public:
        const module Layout:
            STRIDE: i64 = 4            # components per bank slot (TRS ≤ 4)

        const module Capacity:
            MAX_TRACKS: i64 = 65536
            MAX_FRAMES: i64 = 1000000
        const NONE: i64 = -1

        # Bank index of (track ordinal, component); NONE when the component
        # does not fit a slot, so the caller falls back to the uncached path.
        def slot(ordinal: i64, component: i64) -> i64:
            requires ordinal >= 0
            requires ordinal < Capacity::MAX_TRACKS
            requires component >= 0
            ensure component < Layout::STRIDE or result <= NONE
            ensure component >= Layout::STRIDE or result >= ordinal * Layout::STRIDE + component
            ensure component >= Layout::STRIDE or result <= ordinal * Layout::STRIDE + component
            if component >= Layout::STRIDE:
                return NONE
            return ordinal * 4 + component

        # Entries the bank must hold for `ordinal`'s slots.
        def bank_size(ordinal: i64) -> i64:
            requires ordinal >= 0
            requires ordinal < Capacity::MAX_TRACKS
            ensure result >= ordinal * Layout::STRIDE + Layout::STRIDE
            ensure result <= ordinal * Layout::STRIDE + Layout::STRIDE
            return ordinal * Layout::STRIDE + Layout::STRIDE

        # Grow one step toward `needed` entries.
        def grows(count: i64, needed: i64) -> bool:
            requires count >= 0
            requires needed >= 0
            ensure result or count >= needed
            ensure not result or count < needed
            return count < needed

        # ---- Dirty frame windows ----------------------------------------
        # A window is [lo, hi] over frames 0..frames-1; empty when lo > hi.

        # The empty window's bounds.
        def empty_lo(frames: i64) -> i64:
            requires frames >= 0
            requires frames <= Capacity::MAX_FRAMES
            ensure result >= frames
            ensure result <= frames
            return frames

        def empty_hi(frames: i64) -> i64:
            requires frames >= 0
            requires frames <= Capacity::MAX_FRAMES
            ensure result <= frames - frames - 1
            ensure result >= frames - frames - 1
            return frames - frames - 1

        # Widen [lo, hi] to include frame f (lo > hi means empty).
        def take_lo(lo: i64, f: i64) -> i64:
            ensure result <= lo
            ensure result <= f
            ensure result >= lo or result >= f
            if f < lo:
                return f
            return lo

        def take_hi(hi: i64, f: i64) -> i64:
            ensure result >= hi
            ensure result >= f
            ensure result <= hi or result <= f
            if f > hi:
                return f
            return hi

        # A scope A..B widened by `edge` frames of fade margin, clamped.
        def margin_lo(first: i64, edge: i64) -> i64:
            requires edge >= 0
            requires first >= 0
            requires first <= Capacity::MAX_FRAMES
            ensure result >= 0
            ensure result <= first
            ensure result >= first - edge
            if first < edge:
                return 0
            return first - edge

        def margin_hi(last: i64, edge: i64, frames: i64) -> i64:
            requires edge >= 0
            requires edge <= Capacity::MAX_FRAMES
            requires last >= 0
            requires last <= Capacity::MAX_FRAMES
            requires frames >= 1
            requires frames <= Capacity::MAX_FRAMES
            requires last < frames
            ensure result <= frames - 1
            ensure result <= last + edge
            ensure result >= last
            if last + edge > frames - 1:
                return frames - 1
            return last + edge

        # Whether frame f must be recomputed (inside [lo, hi]).
        def dirty(f: i64, lo: i64, hi: i64) -> i64:
            ensure result >= 0
            ensure result <= 1
            ensure result <= 0 or f >= lo
            ensure result <= 0 or f <= hi
            ensure result >= 1 or f < lo or f > hi
            if f < lo:
                return 0
            if f > hi:
                return 0
            return 1

        # Frames to recompute: the window length, 0 when empty.
        def span(lo: i64, hi: i64) -> i64:
            requires lo >= 0
            requires hi + 1 >= 0
            requires lo <= Capacity::MAX_FRAMES
            requires hi <= Capacity::MAX_FRAMES
            ensure result >= 0
            ensure hi >= lo or result <= 0
            ensure hi < lo or result >= hi - lo + 1
            ensure hi < lo or result <= hi - lo + 1
            if hi < lo:
                return 0
            return hi - lo + 1

        # ---- Memoisation --------------------------------------------------

        # A memo is valid only for the revision and key it was made for.
        def memo_hit(valid: bool, stored_revision: i64, revision: i64, stored_key: i64, key: i64) -> i64:
            ensure result >= 0
            ensure result <= 1
            ensure result <= 0 or valid
            ensure result <= 0 or stored_revision == revision
            ensure result <= 0 or stored_key == key
            ensure result >= 1 or not valid or stored_revision != revision or stored_key != key
            if not valid:
                return 0
            if stored_revision != revision:
                return 0
            if stored_key != key:
                return 0
            return 1

        # The memo key of (bone, mode).
        def memo_key(bone: i64, mode: i64) -> i64:
            requires bone >= NONE
            requires bone < Capacity::MAX_TRACKS
            requires mode >= 0
            requires mode < Layout::STRIDE * 4
            ensure result >= 0
            ensure result >= bone * 16 + 16 + mode
            ensure result <= bone * 16 + 16 + mode
            return bone * 16 + 16 + mode

        # ---- Rig-stack step keys ------------------------------------------
        # key[i] chains the clip key through every executed step; steps that
        # read foot contacts (foot lock) also fold in the contact-edit key, so
        # a contact edit invalidates from the first contact reader onward.

        def step_key(base: i64, reads_contacts: bool, contacts: i64) -> i64:
            requires base >= 0
            requires base < StackCache::Fingerprint::MODULUS
            requires contacts >= 0
            requires contacts < StackCache::Fingerprint::MODULUS
            ensure result >= 0
            ensure result < StackCache::Fingerprint::MODULUS
            ensure reads_contacts or result >= base
            ensure reads_contacts or result <= base
            if not reads_contacts:
                return base
            return StackCache::mix(base, contacts)

        # The step key without contacts: what step_key gives a non-reader.
        def plain_key(previous: i64, params: i64) -> i64:
            requires previous >= 0
            requires previous < StackCache::Fingerprint::MODULUS
            requires params >= 0
            requires params < StackCache::Fingerprint::MODULUS
            ensure result >= 0
            ensure result < StackCache::Fingerprint::MODULUS
            return StackCache::mix(previous, params)

        # Steps to reuse after a contact edit: everything before the first
        # contact reader (the boundary), never more than is cached.
        def boundary_reuse(cached: i64, first_reader: i64, count: i64) -> i64:
            requires cached >= 0
            requires first_reader >= 0
            requires count >= 0
            requires count <= StackCache::Capacity::MAX_OPS
            ensure result >= 0
            ensure result <= cached
            ensure result <= first_reader
            ensure result <= count
            ensure first_reader > cached or first_reader > count or result >= first_reader
            ensure first_reader > cached or first_reader > count or result <= first_reader
            return StackCache::reusable(cached, first_reader, count)

        # ---- Window end -------------------------------------------------
        # Last frame a correction window must re-evaluate. Sampling holds a
        # channel's last key past its end, so a window reaching the shortest
        # channel's last key (or the clip end) runs to the clip's last frame.
        def window_end(hi: i64, shortest: i64, frames: i64) -> i64:
            requires frames >= 1
            requires frames <= Capacity::MAX_FRAMES
            requires hi >= 0
            requires shortest >= 0
            ensure result <= frames - 1
            ensure result >= hi or result == frames - 1
            ensure hi < shortest - 1 or result == frames - 1
            ensure hi < frames or result == frames - 1
            ensure hi >= shortest - 1 or hi >= frames or result == hi
            return frames - 1 if hi >= shortest - 1 or hi >= frames
            return hi

        # ---- Gizmo drag chain ---------------------------------------------
        # Bones are in parent-first order. A bone moves with the drag when it
        # is the dragged bone or its parent moves.

        def on_chain(bone: i64, dragged: i64, parent: i64, parent_moves: bool) -> i64:
            requires bone >= 0
            requires parent < bone
            ensure result >= 0
            ensure result <= 1
            ensure bone != dragged or result >= 1
            ensure bone == dragged or parent >= 0 or result <= 0
            ensure bone == dragged or parent_moves or result <= 0
            ensure bone == dragged or parent < 0 or not parent_moves or result >= 1
            if bone == dragged:
                return 1
            if parent < 0:
                return 0
            if parent_moves:
                return 1
            return 0
