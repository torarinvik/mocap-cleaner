# Aggregate logical contents of a channel-cache bank. Physical allocator
# capacity and temporary evaluation buffers require separate qualification.
include "cache_budget_policy.elisa"

module CacheBankBudgetPolicy:
    public:
        const module Limit:
            MAX_LOGICAL_BYTES: i64 = 268435456

        # Exclude the slot being replaced from retained_bytes. Refuse before
        # addition so hostile dimensions cannot wrap into an admitted request.
        def admits(retained_bytes: i64, replacement_bytes: i64) -> bool:
            ensure result == (retained_bytes >= 0 and replacement_bytes >= 0 and retained_bytes <= Limit::MAX_LOGICAL_BYTES and replacement_bytes <= Limit::MAX_LOGICAL_BYTES and retained_bytes <= Limit::MAX_LOGICAL_BYTES - replacement_bytes)
            return false if retained_bytes < 0 or replacement_bytes < 0
            return false if retained_bytes > Limit::MAX_LOGICAL_BYTES or replacement_bytes > Limit::MAX_LOGICAL_BYTES
            retained_bytes <= Limit::MAX_LOGICAL_BYTES - replacement_bytes

        def accumulate(retained_bytes: i64, slot_bytes: i64) -> i64:
            ensure result == -1 or result >= 0 and result <= Limit::MAX_LOGICAL_BYTES
            return -1 if not admits(retained_bytes, slot_bytes)
            retained_bytes + slot_bytes
