# A C-string destination needs one byte beyond the payload for its terminator.
module BoundedPathPolicy:
    public:
        def admitted(length: i64, capacity: i64) -> bool:
            ensure result == (capacity > 0 and length >= 0 and length < capacity)
            capacity > 0 and length >= 0 and length < capacity

        # Retained take paths additionally require a nonempty payload.
        def nonempty_admitted(length: i64, capacity: i64) -> bool:
            ensure result == (capacity > 0 and length > 0 and length < capacity)
            length > 0 and length < capacity
