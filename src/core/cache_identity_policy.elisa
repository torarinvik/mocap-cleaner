# Hash equality is necessary but insufficient for cache reuse. Callers must
# establish exact identity and storage shape from the actual retained data.
module CacheIdentityPolicy:
    public:
        def reuse_admitted(hash_equal: bool, input_equal: bool, operation_equal: bool, storage_valid: bool) -> bool:
            ensure result == (hash_equal and input_equal and operation_equal and storage_valid)
            hash_equal and input_equal and operation_equal and storage_valid
