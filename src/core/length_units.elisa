# Integer length boundary: one internal unit is 0.1 mm, or 100 micrometres.
# This module does not convert angles, speeds or per-frame acceleration.
module LengthUnits:
    public:
        const module Scale:
            MICROMETRES_PER_UNIT: i64 = 100
            UNITS_PER_METRE: i64 = 10000
            HALF_UNIT: i64 = 50
            MAX_MICROMETRES: i64 = 9223372036854775807
            MIN_MICROMETRES: i64 = -9223372036854775807 - 1
            MAX_EXPORT_UNITS: i64 = 92233720368547758
            MIN_EXPORT_UNITS: i64 = -92233720368547758

        # Round nearest, with exact half-unit ties away from zero. Divide first
        # so neither adding a rounding bias nor negating i64 minimum can overflow.
        def from_micrometres(value: i64) -> i64:
            ensure result >= Scale::MIN_EXPORT_UNITS
            ensure result <= Scale::MAX_EXPORT_UNITS
            ensure value < 0 or result >= 0
            ensure value > 0 or result <= 0
            ensure result * Scale::MICROMETRES_PER_UNIT - value >= -Scale::HALF_UNIT
            ensure result * Scale::MICROMETRES_PER_UNIT - value <= Scale::HALF_UNIT
            ensure value % Scale::MICROMETRES_PER_UNIT < Scale::HALF_UNIT or result == value / Scale::MICROMETRES_PER_UNIT + 1
            ensure value % Scale::MICROMETRES_PER_UNIT > -Scale::HALF_UNIT or result == value / Scale::MICROMETRES_PER_UNIT - 1
            ensure value % Scale::MICROMETRES_PER_UNIT >= Scale::HALF_UNIT or value % Scale::MICROMETRES_PER_UNIT <= -Scale::HALF_UNIT or result == value / Scale::MICROMETRES_PER_UNIT
            quotient: i64 = value / Scale::MICROMETRES_PER_UNIT
            remainder: i64 = value % Scale::MICROMETRES_PER_UNIT
            return quotient + 1 if remainder >= Scale::HALF_UNIT
            return quotient - 1 if remainder <= -Scale::HALF_UNIT
            return quotient

        # A physical adapter can retain a tighter bound than the full i64
        # conversion domain without saturating or changing the rounding rule.
        def from_bounded_micrometres(value: i64, bound_units: i64) -> i64:
            requires bound_units >= 0
            requires bound_units <= Scale::MAX_EXPORT_UNITS
            requires value >= 0 - bound_units * Scale::MICROMETRES_PER_UNIT
            requires value <= bound_units * Scale::MICROMETRES_PER_UNIT
            ensure result >= 0 - bound_units
            ensure result <= bound_units
            ensure result == from_micrometres(value)
            from_micrometres(value)

        def can_export_micrometres(units: i64) -> bool:
            ensure result == (units >= Scale::MIN_EXPORT_UNITS and units <= Scale::MAX_EXPORT_UNITS)
            units >= Scale::MIN_EXPORT_UNITS and units <= Scale::MAX_EXPORT_UNITS

        # Admission is explicit. Never saturate an unrepresentable report value.
        def to_micrometres(units: i64) -> i64:
            requires units >= Scale::MIN_EXPORT_UNITS
            requires units <= Scale::MAX_EXPORT_UNITS
            ensure result == units * Scale::MICROMETRES_PER_UNIT
            units * Scale::MICROMETRES_PER_UNIT
