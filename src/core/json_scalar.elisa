module JsonScalar:
    public:
        const module Domain:
            MAXIMUM: i64 = 1114111
            SURROGATE_FIRST: i64 = 55296
            SURROGATE_LAST: i64 = 57343
            HIGH_LAST: i64 = 56319
            LOW_FIRST: i64 = 56320
            PAIR_BASE: i64 = 65536
            PAIR_WIDTH: i64 = 1024

        def combine_surrogates(high: i64, low: i64) -> i64:
            requires high >= Domain::SURROGATE_FIRST and high <= Domain::HIGH_LAST
            requires low >= Domain::LOW_FIRST and low <= Domain::SURROGATE_LAST
            ensure result >= Domain::PAIR_BASE and result <= Domain::MAXIMUM
            ensure result == Domain::PAIR_BASE + (high - Domain::SURROGATE_FIRST) * Domain::PAIR_WIDTH + low - Domain::LOW_FIRST
            Domain::PAIR_BASE + (high - Domain::SURROGATE_FIRST) * Domain::PAIR_WIDTH + low - Domain::LOW_FIRST

        def valid(value: i64) -> bool:
            ensure result == (value >= 0 and value <= Domain::MAXIMUM and (value < Domain::SURROGATE_FIRST or value > Domain::SURROGATE_LAST))
            value >= 0 and value <= Domain::MAXIMUM and (value < Domain::SURROGATE_FIRST or value > Domain::SURROGATE_LAST)

        def hex(byte: i64) -> i64:
            ensure result >= -1 and result <= 15
            ensure byte < 48 or byte > 57 or result == byte - 48
            ensure byte < 65 or byte > 70 or result == byte - 65 + 10
            ensure byte < 97 or byte > 102 or result == byte - 97 + 10
            return byte - 48 if byte >= 48 and byte <= 57
            return byte - 65 + 10 if byte >= 65 and byte <= 70
            return byte - 97 + 10 if byte >= 97 and byte <= 102
            -1
