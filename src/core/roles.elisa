# The common rig: every supported skeleton (Mixamo, plain, Rokoko-style) maps
# its joints onto these roles, so tools name joints by role, never by a
# source rig's bone names. A role is an index; NONE marks an unmapped joint.
module Roles:
    public:
        const module Capacity:
            COUNT: i64 = 26

        const enum Joint of i64:
            None = -1
            Hips = 0
            Spine = 1
            Spine1 = 2
            Spine2 = 3
            Neck = 4
            Head = 5
            LeftShoulder = 6
            LeftArm = 7
            LeftForearm = 8
            LeftHand = 9
            RightShoulder = 10
            RightArm = 11
            RightForearm = 12
            RightHand = 13
            LeftUpleg = 14
            LeftLeg = 15
            LeftFoot = 16
            LeftToe = 17
            RightUpleg = 18
            RightLeg = 19
            RightFoot = 20
            RightToe = 21
            LeftForearmRoll = 22
            RightForearmRoll = 23
            LeftLegRoll = 24
            RightLegRoll = 25

        # Operation mask groups (bit index in an operation's bone mask).
        const enum Group of i64:
            Other = 0
            Leg = 1
            Arm = 2

        def role_valid(role: i64) -> bool:
            ensure result == (role >= 0 and role < 26)
            return role >= 0 and role < 26

        # The same joint on the other side; centre joints map to themselves.
        def role_mirror(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result >= 0
            ensure result < 26
            ensure role > 5 or result == role
            ensure role < 6 or role > 9 or result == role + 4
            ensure role < 10 or role > 13 or result == role - 4
            ensure role < 14 or role > 17 or result == role + 4
            ensure role < 18 or role > 21 or result == role - 4
            if role <= 5:
                return role
            if role <= 9:
                return role + 4
            if role <= 13:
                return role - 4
            if role <= 17:
                return role + 4
            if role <= 21:
                return role - 4
            if role == 22 or role == 24:
                return role + 1
            return role - 1

        # Mask group: legs (with their roll bones), arms, everything else.
        def role_group(role: i64) -> i64:
            ensure result >= 0
            ensure result <= 2
            ensure role >= 6 or result == 0
            if role < 6 or role >= 26:
                return Group.Other.i64()
            if role <= 13:
                return Group.Arm.i64()
            if role <= 21:
                return Group.Leg.i64()
            if role <= 23:
                return Group.Arm.i64()
            return Group.Leg.i64()

        # Hinge joints: knees and elbows (LEFT_FOREARM 8, RIGHT_FOREARM 12,
        # LEFT_LEG 15, RIGHT_LEG 19).
        def is_hinge(role: i64) -> bool:
            ensure not result or role >= 8
            ensure not result or role <= 19
            return role == 8 or role == 12 or role == 15 or role == 19

        # The joint above a hinge (hip or shoulder ball joint), or NONE.
        def hinge_upper(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result == -1 or result == role - 1
            if role == 8 or role == 12 or role == 15 or role == 19:
                return role - 1
            return -1

        # The end effector driven by a hinge (ankle or wrist), or NONE.
        def hinge_end(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result == -1 or result == role + 1
            if role == 8 or role == 12 or role == 15 or role == 19:
                return role + 1
            return -1

        # The roll (twist) bone that takes a hinge's twist, or NONE.
        def hinge_roll(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result < 0 or result >= 22
            if role == 8:
                return role + 14
            if role == 12:
                return role + 11
            if role == 15:
                return role + 9
            if role == 19:
                return role + 6
            return 0 - 1

        # The hinge an end effector hangs from (the pin tool's chain), or NONE.
        def effector_hinge(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result == -1 or result == role - 1
            if role == 9 or role == 13 or role == 16 or role == 20:
                return role - 1
            return -1
