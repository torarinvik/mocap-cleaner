# Clamped sliding windows for wide running filters (median over 2r+1 frames).
module Window:
    public:
        const module Domain:
            MAX_FRAMES: i64 = 10000000
            MAX_RADIUS: i64 = 1000
            MAX_MAGNITUDE: i64 = 1000000000

        # First frame of the window around `frame`, clamped to the clip start.
        def low(frame: i64, radius: i64) -> i64:
            requires frame >= 0
            requires frame < Domain::MAX_FRAMES
            requires radius >= 0
            requires radius <= Domain::MAX_RADIUS
            ensure result >= 0
            ensure result <= frame
            ensure frame - result <= radius
            return frame - radius if frame >= radius
            return 0

        # Last frame of the window, clamped to the clip end.
        def high(frame: i64, radius: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Domain::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            requires radius >= 0
            requires radius <= Domain::MAX_RADIUS
            ensure result >= frame
            ensure result < count
            ensure result - frame <= radius
            return frame + radius if frame + radius < count
            return count - 1

        # Index of the median in a sorted window of `size` values.
        def middle(size: i64) -> i64:
            requires size >= 1
            requires size <= 2 * Domain::MAX_RADIUS + 1
            ensure result >= 0
            ensure result < size
            ensure size - 1 - result <= result + 1
            ensure result <= size - 1 - result
            ensure 2 * result + 1 == size or 2 * result + 2 == size
            return (size - 1) / 2

        # Mirrored index for point-reflection padding: frames before the clip
        # reflect about frame 0, frames after it about the last frame.
        def mirror(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Domain::MAX_FRAMES
            requires frame > -count
            requires frame < 2 * count - 1
            requires frame > -Domain::MAX_FRAMES
            requires frame < 2 * Domain::MAX_FRAMES
            ensure result >= 0
            ensure result < count
            ensure frame < 0 or frame >= count or result == frame
            ensure frame >= 0 or result == 0 - frame
            return 0 - frame if frame < 0
            return (count - 1) + ((count - 1) - frame) if frame >= count
            return frame

        # Point-reflected value: 2*end - mirrored, clamped to +-limit.
        def reflect(end: i64, mirrored: i64, limit: i64) -> i64:
            requires limit >= 0
            requires limit <= Domain::MAX_MAGNITUDE
            requires end >= -limit
            requires end <= limit
            requires mirrored >= -limit
            requires mirrored <= limit
            requires end >= -Domain::MAX_MAGNITUDE
            requires end <= Domain::MAX_MAGNITUDE
            requires mirrored >= -Domain::MAX_MAGNITUDE
            requires mirrored <= Domain::MAX_MAGNITUDE
            ensure result >= -limit
            ensure result <= limit
            ensure end != mirrored or result == end
            gap: i64 = end - mirrored
            value: i64 = end + gap
            return limit if value > limit
            return -limit if value < -limit
            return value
