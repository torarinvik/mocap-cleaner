# Knee/elbow stability: keep an off-hinge channel (ankle or wrist "wring",
# fixed-point angle) within a soft limit of the clip's guard pose. Deviations
# inside the limit pass unchanged; beyond it they are compressed toward it.
module Stability:
    public:
        const LIMIT: i64 = 1000000000

        # Soft limit: inside `limit` unchanged; beyond, the excess is halved.
        def soften(deviation: i64, limit: i64) -> i64:
            requires deviation >= -LIMIT
            requires deviation <= LIMIT
            requires limit >= 0
            requires limit <= LIMIT
            ensure deviation > limit or deviation < -limit or result == deviation
            ensure deviation <= limit or result >= limit
            ensure deviation <= limit or result <= deviation
            ensure deviation >= -limit or result <= -limit
            ensure deviation >= -limit or result >= deviation
            if deviation > limit:
                excess: i64 = deviation - limit
                half: i64 = excess / 2
                return limit + half
            if deviation < -limit:
                shortfall: i64 = -limit - deviation
                half: i64 = shortfall / 2
                return -limit - half
            return deviation

        # A channel value re-expressed about the guard with the soft limit.
        def limit_wring(value: i64, guard: i64, limit: i64) -> i64:
            requires value >= -LIMIT / 2
            requires value <= LIMIT / 2
            requires guard >= -LIMIT / 2
            requires guard <= LIMIT / 2
            requires limit >= 0
            requires limit <= LIMIT
            ensure value - guard > limit or guard - value > limit or result == value
            deviation: i64 = value - guard
            return guard + soften(deviation, limit)
