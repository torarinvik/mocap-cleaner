# Two-bone limb reach (homogeneous integer lengths): an IK target is pulled onto the annulus
# the limb can reach, so a re-solve never asks a leg to stretch or fold
# beyond its bones.
module Reach:
    public:
        const LIMIT: i64 = 1000000000

        def limb_reach(distance: i64, upper: i64, lower: i64) -> i64:
            requires distance >= 0
            requires distance <= 1000000000
            requires upper >= 0
            requires upper <= 1000000000
            requires lower >= 0
            requires lower <= 1000000000
            ensure result >= 0
            ensure result <= upper + lower
            ensure result >= upper - lower
            ensure result >= lower - upper
            ensure distance <= upper + lower or result == upper + lower
            ensure upper < lower or distance > upper + lower or distance < upper - lower or result == distance
            if distance > upper + lower:
                return upper + lower
            if upper >= lower:
                if distance < upper - lower:
                    return upper - lower
                return distance
            if distance < lower - upper:
                return lower - upper
            return distance
