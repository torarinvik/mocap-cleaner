# Loop seam: cross-fade the last frames of a looping clip toward values that
# continue from frame 0, so the loop closes without a jump.
include "fade.elisa"

module Seam:
    public:
        const MAX_FRAMES: i64 = 10000000

        # Weight (permille) with which frame `frame` is pulled toward the wrapped
        # continuation; 0 before the seam window, FULL at the last frame.
        def pull(frame: i64, last: i64, window: i64) -> i64:
            requires last >= 1
            requires last < MAX_FRAMES
            requires window >= 1
            requires window <= last
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= Fade::Domain::FULL_PERMILLE
            ensure frame != last or result == Fade::Domain::FULL_PERMILLE
            ensure frame > last - window or result == 0
            start: i64 = last - window
            return 0 if frame <= start
            return Fade::Domain::FULL_PERMILLE if frame == last
            into: i64 = frame - start
            return into * Fade::Domain::FULL_PERMILLE / window

        # Jump between the last and first sample, the seam detector's measure.
        def jump(first: i64, last: i64) -> i64:
            requires first >= -1000000000
            requires first <= 1000000000
            requires last >= -1000000000
            requires last <= 1000000000
            ensure result >= 0
            ensure first != last or result == 0
            ensure result == first - last or result == last - first
            return first - last if first >= last
            return last - first
