# Weight (permille) of a keyed correction at a frame: FULL at the key frame,
# falling linearly to 0 at the scope ends `first` and `last`, and 0 outside
# the scope, so a correction never touches frames outside it.
module KeyWeight:
    public:
        const FULL: i64 = 1000
        const MAX_FRAMES: i64 = 10000000

        def weight(frame: i64, first: i64, key: i64, last: i64) -> i64:
            requires first >= 0
            requires first <= key
            requires key <= last
            requires last <= MAX_FRAMES
            requires frame >= -MAX_FRAMES
            requires frame <= 2 * MAX_FRAMES
            ensure result >= 0
            ensure result <= FULL
            ensure frame != key or result == FULL
            ensure frame >= first or result == 0
            ensure frame <= last or result == 0
            return FULL if frame == key
            return 0 if frame < first or frame > last
            if frame < key:
                up: i64 = ramp(frame - first, key - first)
                return up
            down: i64 = ramp(last - frame, last - key)
            return down

        # `part / whole` of FULL, held inside [0, FULL].
        def ramp(part: i64, whole: i64) -> i64:
            requires whole >= 1
            requires whole <= 2 * MAX_FRAMES
            requires part >= 0
            requires part <= whole
            ensure result >= 0
            ensure result <= FULL
            v: i64 = part * FULL / whole
            return 0 if v < 0
            return FULL if v > FULL
            return v
