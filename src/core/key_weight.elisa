# Weight (permille) of a keyed correction at a frame: FULL at the key frame,
# falling linearly to 0 at the scope ends `first` and `last`, and 0 outside
# the scope, so a correction never touches frames outside it.
module KeyWeight:
    public:
        const module Domain:
            FULL_PERMILLE: i64 = 1000
            MAX_FRAMES: i64 = 10000000

        # Check the unsigned channel index before narrowing it to a frame.
        def admits_index(index: usize, first: i64, last: i64) -> bool:
            requires first >= 0
            requires first <= last
            requires last <= Domain::MAX_FRAMES
            ensure result == (index >= first.usize() and index <= last.usize())
            ensure not result or index <= Domain::MAX_FRAMES.usize()
            index >= first.usize() and index <= last.usize()

        def weight(frame: i64, first: i64, key: i64, last: i64) -> i64:
            requires first >= 0
            requires first <= key
            requires key <= last
            requires last <= Domain::MAX_FRAMES
            requires frame >= -Domain::MAX_FRAMES
            requires frame <= 2 * Domain::MAX_FRAMES
            ensure result >= 0
            ensure result <= Domain::FULL_PERMILLE
            ensure frame != key or result == Domain::FULL_PERMILLE
            ensure frame >= first or result == 0
            ensure frame <= last or result == 0
            return Domain::FULL_PERMILLE if frame == key
            return 0 if frame < first or frame > last
            if frame < key:
                up: i64 = ramp(frame - first, key - first)
                return up
            down: i64 = ramp(last - frame, last - key)
            return down

        # `part / whole` of Domain::FULL_PERMILLE, held inside [0, Domain::FULL_PERMILLE].
        def ramp(part: i64, whole: i64) -> i64:
            requires whole >= 1
            requires whole <= 2 * Domain::MAX_FRAMES
            requires part >= 0
            requires part <= whole
            ensure result >= 0
            ensure result <= Domain::FULL_PERMILLE
            v: i64 = part * Domain::FULL_PERMILLE / whole
            return 0 if v < 0
            return Domain::FULL_PERMILLE if v > Domain::FULL_PERMILLE
            return v
