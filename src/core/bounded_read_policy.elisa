# Outcomes for bounded native text reads. Failed reads never publish bytes.
module BoundedReadPolicy:
    public:
        const module Capacity:
            DEFAULT_BYTES: i64 = 8388608
            MAX_BYTES: i64 = 67108864

        const enum Status of i64:
            Ok = 0
            OpenFailed = 1
            ReadFailed = 2
            TooLarge = 3
            CloseFailed = 4
            InvalidLimit = 5

        def valid_limit(limit: i64) -> bool:
            ensure result == (limit > 0 and limit <= Capacity::MAX_BYTES)
            limit > 0 and limit <= Capacity::MAX_BYTES

        def append_admitted(count: i64, limit: i64) -> bool:
            requires count >= 0
            requires count <= limit
            requires limit > 0 and limit <= Capacity::MAX_BYTES
            ensure result == (count < limit)
            count < limit

        def finish(too_large: bool, read_failed: bool, close_failed: bool) -> Status:
            ensure (result == Status.TooLarge) == too_large
            ensure (result == Status.ReadFailed) == (not too_large and read_failed)
            ensure (result == Status.CloseFailed) == (not too_large and not read_failed and close_failed)
            ensure (result == Status.Ok) == (not too_large and not read_failed and not close_failed)
            return Status.TooLarge if too_large
            return Status.ReadFailed if read_failed
            return Status.CloseFailed if close_failed
            Status.Ok
