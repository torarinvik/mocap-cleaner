# Foot-slide lock: during a planted run a foot channel is pulled to the run's
# anchor (its value at the plant frame). The pull ramps in from the plant frame
# and back out to the lift frame over `blend` frames, so the lock never pops.
include "fade.elisa"
include "gate.elisa"

module Lock:
    public:
        const LIMIT: i64 = 1000000000

        # Lock weight for a planted frame `into` frames after the plant and
        # `left` frames before the lift.
        def hold(into: i64, left: i64, blend: i64) -> i64:
            requires into >= 0
            requires into <= Fade::Domain::MAX_FRAMES
            requires left >= 0
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure result >= 0
            ensure result <= Fade::Domain::FULL_PERMILLE
            ensure into != 0 or result == 0
            ensure left != 0 or result == 0
            ensure into < blend or left < blend or result == Fade::Domain::FULL_PERMILLE
            distance: i64 = Fade::nearer(into, left)
            return Fade::scale(distance, blend)

        # The locked value of one planted frame.
        def locked(value: i64, anchor: i64, into: i64, left: i64, blend: i64) -> i64:
            requires value >= -LIMIT
            requires value <= LIMIT
            requires anchor >= -LIMIT
            requires anchor <= LIMIT
            requires into >= 0
            requires into <= Fade::Domain::MAX_FRAMES
            requires left >= 0
            requires left <= Fade::Domain::MAX_FRAMES
            requires blend >= 1
            requires blend <= Fade::Domain::MAX_EDGE
            ensure into != 0 or result == value
            ensure left != 0 or result == value
            ensure into < blend or left < blend or result == anchor
            ensure value != anchor or result == value
            distance: i64 = Fade::nearer(into, left)
            w: i64 = Fade::scale(distance, blend)
            return Gate::apply(value, anchor, w)
