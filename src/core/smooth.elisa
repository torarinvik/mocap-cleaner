# Binomial (1-2-1) smoothing on fixed-point samples; repeated passes approach a
# Gaussian. Used for pelvis path and contact-height smoothing.
module Smooth:
    public:
        const LIMIT: i64 = 1000000000000

        def binomial(a: i64, b: i64, c: i64) -> i64:
            requires a >= -LIMIT
            requires a <= LIMIT
            requires b >= -LIMIT
            requires b <= LIMIT
            requires c >= -LIMIT
            requires c <= LIMIT
            ensure result >= -LIMIT
            ensure result <= LIMIT
            ensure a != b or b != c or result == b
            return b if a == b and b == c
            return (a + 2 * b + c) / 4
