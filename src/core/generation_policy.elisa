module GenerationPolicy:
    public:
        const module Domain:
            MAX: i64 = 9223372036854775807

        def can_advance(value: i64) -> bool:
            ensure result == (value >= 0 and value < Domain::MAX)
            value >= 0 and value < Domain::MAX

        def advance(value: i64) -> i64:
            requires can_advance(value)
            ensure result == value + 1
            ensure result > value and result > 0
            value + 1
