# Headless CLI.
#   mocap-cleaner clean <in.glb> (<out.glb> | -o <out.glb>) [--preset boxing|raw|rokoko]
#       [--anim NAME] [--report r.json] [--op OP]... [--pin ROLE:FIRST:LAST[:BLEND]]...
#       [--offset ROLE:AXIS:DEGREES:FIRST:LAST[:FADE]]...
#       [--keyed ROLE:AXIS:FRAME:DEGREES:FRAME:DEGREES[:FRAME:DEGREES...]]...
#       [--contact FOOT:FIRST:LAST:on|off]... [--hand-contact HAND:FIRST:LAST:on|off]...
#       [--retime FIRST:LAST:SPEED[:BLEND]]... [--ops FILE]... [--save-ops FILE]
#   mocap-cleaner batch <outdir> [--preset boxing|raw|rokoko] [--op OP]... [--jobs N] <in.glb|folder>...
#   mocap-cleaner diff <a.json> <b.json> [--tolerance PERCENT] [--floor N] [--html out.html]
# OP: twist|pole|pelvis|lock|pivot|hands (rig fixes; hands is opt-in), balance (centre-of-mass check),
#     ballistic (fit airborne phases to a parabola), momentum (cap torso
#     angular-acceleration spikes).
# --pin takes a hand, a foot or the head. --contact hand-edits a foot's
# contact track (FOOT is LeftFoot, RightFoot or all); --hand-contact marks
# a planted hand (HAND is LeftHand or RightHand) for --op hands. --retime plays source
# frames FIRST..LAST at SPEED (0.1 to 4, eased over BLEND frames, default 4);
# it runs last and changes the clip's length. --ops appends the
# operations of an ops file; --save-ops writes the user stack (every --op,
# --pin, --offset, --keyed, --contact and --ops operation) to FILE.
# ROLE is a bare joint name in any supported naming (LeftHand, LeftFoot,
# LeftShin, ...); AXIS is x, y or z (the bone's local axis).
# Batch expands folders to their sorted .glb files, writes each cleaned take
# to <outdir>/<basename> and <outdir>/report.html; it always runs the
# balance, ballistic and momentum detectors for the report. --jobs N cleans
# up to N takes at once in worker processes; output and report keep input
# order. Both reports carry per-stage CPU times (load, each curve op, rig,
# physics, save) in microseconds.
include "../io/glb_tracks.elisa"
include "../io/console.elisa"
include "../io/report.elisa"
include "../io/folder.elisa"
include "../ops/presets.elisa"
include "../io/ops_file.elisa"
include "../physics/rig_physics.elisa"
include "../io/report_diff.elisa"
include "../io/workers.elisa"
include "../ops/retime_apply.elisa"
include "output_guard.elisa"
include "output_publisher.elisa"
include "worker_directory.elisa"

def output_error(reason: i64) -> sview:
    return "path could not be verified" if reason == CliOutputGuardPolicy::PATH_UNRESOLVED
    return "derived files must be inside build/" if reason == CliOutputGuardPolicy::OUTSIDE_BUILD
    return "destination aliases a source file" if reason == CliOutputGuardPolicy::SOURCE_COLLISION
    return "destination is a symbolic link" if reason == CliOutputGuardPolicy::SYMBOLIC_LINK
    return "destination is not a regular file" if reason == CliOutputGuardPolicy::NOT_REGULAR
    return "destination already exists; choose a new name" if reason == CliOutputGuardPolicy::EXISTS
    return "destination is reserved for Studio metadata or its namespace could not be verified" if reason == CliOutputGuardPolicy::RESERVED_METADATA
    "destination was not admitted"

def output_allowed(source: cstr, destination: cstr) -> bool:
    reason: i64 = CliOutputGuard::file_decision("build".cast[cstr], source, destination)
    return true if reason == CliOutputGuardPolicy::ALLOW
    Out::text("error: ")
    Out::text(output_error(reason))
    Out::text(": ")
    Out::c_text(destination)
    Out::line("")
    false

def optional_output_allowed(source: cstr, destination: cstr) -> bool:
    destination[0] == 0 or output_allowed(source, destination)

def optional_outputs_distinct(first: cstr, second: cstr) -> bool:
    return true if first[0] == 0 or second[0] == 0
    return true if CliOutputGuard::distinct_destinations(first, second)
    Out::line("error: output paths overlap or cannot be compared; choose distinct verified names")
    false

def same(arg: cstr, text: cstr) -> bool:
    mutable i: usize = 0
    while text[i] != 0:
        return false if arg[i] != text[i]
        i <- i + 1
    return arg[i] == 0

def load_or_empty(path: cstr) -> GlbDocument::Document:
    doc: GlbDocument::Document = catch GlbDocument::load(path):
        value: value
        error failure: GlbDocument::Document()
    return move doc

def animation_matches(doc: GlbDocument::Document&, a: usize, name: cstr) -> bool:
    mutable text: darray[u8] = []
    n: usize = GlbDocument::animation_name(doc, a, &text)
    for i in 0..<n:
        return false if name[i] == 0 or name[i] != text[i]
    return name[n] == 0

def preset_of(name: cstr) -> Presets::Preset:
    return Presets::Preset.Boxing if same(name, "boxing".cast[cstr])
    return Presets::Preset.Raw if same(name, "raw".cast[cstr])
    return Presets::Preset.Rokoko if same(name, "rokoko".cast[cstr])
    return Presets::Preset.Unknown

# Profile slots of `clean_take` (CPU clock units, microseconds): the stages,
# then one slot per curve op of the preset from TIME_OPS on.
const TIME_LOAD: usize = 0
const TIME_TRACKS: usize = 1
const TIME_RIG: usize = 2
const TIME_PHYSICS: usize = 3
const TIME_SAVE: usize = 4
const TIME_OPS: usize = 5

def op_name(kind: Ops::Kind) -> sview:
    match kind:
        Ops::Kind.Despike:
            return "despike"
        Ops::Kind.SmoothPath:
            return "smooth_path"
        Ops::Kind.LimitWring:
            return "limit_wring"
        Ops::Kind.Median:
            return "median"
        Ops::Kind.CloseSeam:
            return "close_seam"
        Ops::Kind.PinContacts:
            return "pin_contacts"

# Clean one take. `only` is an animation name, or empty for all. The GLB is
# parsed once; `clips` gets its animation count and `times` the profile.
def clean_take(input: cstr, output: cstr, preset: Presets::Preset, only: cstr, extra: darray[RigOps::RigOp]&, phys: darray[Physics::PhysOp]&, rig: mutable RigOps::Summary&, found: mutable Physics::Findings&, bank: mutable darray[Ops::Cache]&, clips: mutable i64&, times: mutable darray[i64]&, clip_reports: mutable darray[u8]&) -> Report::Row:
    failed: Report::Row = Report::Row{ok: false, tracks: 0, changed: 0, before: 0, after: 0}
    return failed if not output_allowed(input, output)
    ops: darray[Ops::Operation] = Presets::operations(preset)
    times.clear()
    for slot in 0..<(TIME_OPS + ops.count) |times|:
        times.push(0)
    mutable op_times: darray[i64] = []
    start: i64 = s_clock()
    mutable doc: GlbDocument::Document = catch GlbDocument::load(input):
        value: value
        error failure: return failed
    times[TIME_LOAD] <- s_clock() - start
    clips <- GlbDocument::animation_count(&doc).i64()
    return failed if clips == 0
    clip_reports.clear()
    threshold: i64 = Presets::spike_threshold(preset)
    mutable rig_ops: darray[RigOps::RigOp] = Presets::rig_operations(preset)
    for op in extra:
        rig_ops.push(op)
    mutable tracks: i64 = 0
    mutable changed: i64 = 0
    mutable before: i64 = 0
    mutable after: i64 = 0
    for a in 0..<GlbDocument::animation_count(&doc):
        continue if only[0] != 0 and not animation_matches(&doc, a, only)
        mutable animation_name: darray[u8] = []
        _ = GlbDocument::animation_name(&doc, a, &animation_name)
        t0: i64 = s_clock()
        result: (tracks: i64, changed: i64, before: i64, after: i64) = GlbTracks::clean_animation_timed(&doc, a, ops, threshold, bank, &op_times, true)
        t1: i64 = s_clock()
        tracks <- tracks + result.tracks
        changed <- changed + result.changed
        before <- before + result.before
        after <- after + result.after
        summary: RigOps::Summary = RigOps::run(&doc, a, &rig_ops, threshold)
        add_summary(rig, summary)
        t2: i64 = s_clock()
        clip_found: Physics::Findings = Physics::run(&doc, a, phys)
        Physics::add(found, &clip_found)
        if clip_reports.count > 0:
            clip_reports.extend([44u8, 10u8])
        append_clip_report(clip_reports, a.i64(), &animation_name, result, summary, clip_found)
        # Retime runs last, on the finished pose.
        mutable timed: RetimeApply::Report = RetimeApply::empty_report()
        retimed: GlbDocument::Document = RetimeApply::apply(&doc, a, &rig_ops, &timed)
        doc <- move retimed
        print_retime(&timed)
        t3: i64 = s_clock()
        times[TIME_TRACKS] <- times[TIME_TRACKS] + t1 - t0
        times[TIME_RIG] <- times[TIME_RIG] + t2 - t1
        times[TIME_PHYSICS] <- times[TIME_PHYSICS] + t3 - t2
    for i in 0..<op_times.count |op_times, times|:
        times[TIME_OPS + i] <- op_times[i]
    t4: i64 = s_clock()
    saved: bool = output_allowed(input, output) and CliOutputPublisher::publish_glb(&doc, output)
    times[TIME_SAVE] <- s_clock() - t4
    Out::line("error: cleaned GLB could not be published; its destination was not overwritten") if not saved
    return Report::Row{ok: saved, tracks: tracks, changed: changed, before: before, after: after}

# Column names of a profile (see TIME_*), for the reports.
def time_names(preset: Presets::Preset) -> darray[sview]:
    mutable names: darray[sview] = ["load", "tracks", "rig", "physics", "save"]
    for op in Presets::operations(preset) |names|:
        names.push(op_name(op.kind))
    return names

def print_retime(r: RetimeApply::Report&):
    return if r.ranges.count == 0
    Out::field("retime frames before: ", r.frames_before)
    Out::field("retime frames after: ", r.frames_after)
    Out::field("retime status: ", r.status)
    for g in r.ranges:
        Out::field("retime range first: ", g.first)
        Out::field("  last: ", g.last)
        Out::field("  speed permille: ", g.speed)
        Out::field("  source frames: ", g.source_frames)
        Out::field("  output frames: ", g.output_frames)

def add_summary(total: mutable RigOps::Summary&, s: RigOps::Summary):
    total.ops <- total.ops + s.ops
    total.changed <- total.changed + s.changed
    total.twist_max <- s.twist_max if s.twist_max > total.twist_max
    total.pole_before <- total.pole_before + s.pole_before
    total.pole_after <- total.pole_after + s.pole_after
    total.slide_before <- total.slide_before + s.slide_before
    total.slide_after <- total.slide_after + s.slide_after
    total.pelvis_before <- total.pelvis_before + s.pelvis_before
    total.pelvis_after <- total.pelvis_after + s.pelvis_after
    total.sink_before <- total.sink_before + s.sink_before
    total.sink_after <- total.sink_after + s.sink_after
    total.hand_before <- total.hand_before + s.hand_before
    total.hand_after <- total.hand_after + s.hand_after

def print_rig(s: RigOps::Summary&):
    return if s.ops == 0
    Out::field("rig ops: ", s.ops)
    Out::field("rig values changed: ", s.changed)
    Out::field("twist removed max (urad): ", s.twist_max)
    Out::field("pole spikes before: ", s.pole_before)
    Out::field("pole spikes after: ", s.pole_after)
    Out::field("pelvis spikes before: ", s.pelvis_before)
    Out::field("pelvis spikes after: ", s.pelvis_after)
    Out::field("foot slide before (um): ", s.slide_before)
    Out::field("foot slide after (um): ", s.slide_after)
    Out::field("pivot sink before (um): ", s.sink_before)
    Out::field("pivot sink after (um): ", s.sink_after)
    Out::field("hand slide before (um): ", s.hand_before)
    Out::field("hand slide after (um): ", s.hand_after)

def print_physics(f: Physics::Findings&):
    return if f.ops == 0
    Out::field("physics ops: ", f.ops)
    Out::field("physics values changed: ", f.changed)
    Out::field("planted frames: ", f.planted)
    Out::field("unbalanced frames: ", f.unbalanced)
    Out::field("unbalanced runs: ", f.unbalanced_runs)
    Out::field("stepping frames (recovered): ", f.stepped)
    Out::field("airborne frames: ", f.airborne)
    Out::field("flights: ", f.flights)
    Out::field("ballistic residual before (um): ", f.ballistic_before)
    Out::field("ballistic residual after (um): ", f.ballistic_after)
    Out::field("momentum cap (urad/frame^2): ", f.momentum_cap)
    Out::field("momentum spikes before: ", f.momentum_before)
    Out::field("momentum spikes after: ", f.momentum_after)
    Out::field("momentum max drift (urad): ", f.momentum_drift)

def detail_of(clips: i64, s: RigOps::Summary&, f: Physics::Findings&) -> Report::Detail:
    mutable d: Report::Detail = Report::empty_detail()
    d.animations <- clips
    d.rig_changed <- s.changed + f.changed
    d.pole_before <- s.pole_before
    d.pole_after <- s.pole_after
    d.slide_before <- s.slide_before
    d.slide_after <- s.slide_after
    d.planted <- f.planted
    d.unbalanced <- f.unbalanced
    d.unbalanced_runs <- f.unbalanced_runs
    d.airborne <- f.airborne
    d.flights <- f.flights
    d.momentum_before <- f.momentum_before
    d.momentum_after <- f.momentum_after
    return d

def json_field(out: mutable darray[u8]&, name: sview, value: i64, last: bool):
    Report::push_text(out, "  \"")
    Report::push_text(out, name)
    Report::push_text(out, "\": ")
    Report::push_number(out, value)
    if last:
        Report::push_text(out, "\n")
    else:
        Report::push_text(out, ",\n")

def json_bool_field(out: mutable darray[u8]&, name: sview, value: bool, last: bool):
    Report::push_text(out, "  \"")
    Report::push_text(out, name)
    Report::push_text(out, "\": ")
    Report::push_text(out, "true" if value else "false")
    Report::push_text(out, "\n" if last else ",\n")

def json_quoted(out: mutable darray[u8]&, value: darray[u8]&):
    out.push(34)
    for c in value |out|:
        if c == 34 or c == 92:
            out.extend([92u8, c])
        elif c == 8:
            Report::push_text(out, "\\b")
        elif c == 9:
            Report::push_text(out, "\\t")
        elif c == 10:
            Report::push_text(out, "\\n")
        elif c == 12:
            Report::push_text(out, "\\f")
        elif c == 13:
            Report::push_text(out, "\\r")
        elif c < 32:
            Report::push_text(out, "\\u00")
            hex: sview = "0123456789abcdef"
            out.extend([hex[(c / 16).usize()], hex[(c % 16).usize()]])
        else:
            out.push(c)
    out.push(34)

# Append one machine-readable animation record. The synthetic name is unique
# even when a GLB repeats an animation name; the original name remains beside
# it for display.
def append_clip_report(out: mutable darray[u8]&, index: i64, animation_name: darray[u8]&, row: (tracks: i64, changed: i64, before: i64, after: i64), rig: RigOps::Summary, physics: Physics::Findings):
    Report::push_text(out, "  {\n    \"name\": \"animation_")
    Report::push_number(out, index)
    Report::push_text(out, "\",\n    \"animation_name\": ")
    json_quoted(out, animation_name)
    Report::push_text(out, ",\n")
    json_field(out, "tracks", row.tracks, false)
    json_field(out, "values_changed", row.changed, false)
    json_field(out, "spikes_before", row.before, false)
    json_field(out, "spikes_after", row.after, false)
    json_field(out, "rig_ops", rig.ops, false)
    json_field(out, "rig_values_changed", rig.changed, false)
    json_field(out, "twist_removed_max_urad", rig.twist_max, false)
    json_field(out, "pole_before", rig.pole_before, false)
    json_field(out, "pole_after", rig.pole_after, false)
    json_field(out, "pelvis_before", rig.pelvis_before, false)
    json_field(out, "pelvis_after", rig.pelvis_after, false)
    json_field(out, "slide_before_um", rig.slide_before, false)
    json_field(out, "slide_after_um", rig.slide_after, false)
    json_field(out, "hand_slide_before_um", rig.hand_before, false)
    json_field(out, "hand_slide_after_um", rig.hand_after, false)
    json_field(out, "physics_ops", physics.ops, false)
    json_field(out, "physics_values_changed", physics.changed, false)
    json_field(out, "planted_frames", physics.planted, false)
    json_field(out, "unbalanced_frames", physics.unbalanced, false)
    json_field(out, "unbalanced_runs", physics.unbalanced_runs, false)
    json_field(out, "stepping_frames", physics.stepped, false)
    json_field(out, "airborne_frames", physics.airborne, false)
    json_field(out, "flights", physics.flights, false)
    json_field(out, "ballistic_before_um", physics.ballistic_before, false)
    json_field(out, "ballistic_after_um", physics.ballistic_after, false)
    json_field(out, "momentum_cap_urad", physics.momentum_cap, false)
    json_field(out, "momentum_before", physics.momentum_before, false)
    json_field(out, "momentum_after", physics.momentum_after, false)
    json_field(out, "momentum_drift_urad", physics.momentum_drift, false)
    json_bool_field(out, "ok", true, false)
    json_field(out, "animation_index", index, true)
    Report::push_text(out, "  }")

# Machine-readable report of one `clean` run.
def json_report(row: Report::Row, s: RigOps::Summary&, f: Physics::Findings&, names: darray[sview]&, times: darray[i64]&, clip_reports: darray[u8]&) -> darray[u8]:
    mutable out: darray[u8] = []
    Report::push_text(&out, "{\n  \"ok\": ")
    if row.ok:
        Report::push_text(&out, "true,\n")
    else:
        Report::push_text(&out, "false,\n")
    json_field(&out, "tracks", row.tracks, false)
    json_field(&out, "values_changed", row.changed, false)
    json_field(&out, "spikes_before", row.before, false)
    json_field(&out, "spikes_after", row.after, false)
    json_field(&out, "rig_ops", s.ops, false)
    json_field(&out, "rig_values_changed", s.changed, false)
    json_field(&out, "twist_removed_max_urad", s.twist_max, false)
    json_field(&out, "pole_before", s.pole_before, false)
    json_field(&out, "pole_after", s.pole_after, false)
    json_field(&out, "pelvis_before", s.pelvis_before, false)
    json_field(&out, "pelvis_after", s.pelvis_after, false)
    json_field(&out, "slide_before_um", s.slide_before, false)
    json_field(&out, "slide_after_um", s.slide_after, false)
    json_field(&out, "hand_slide_before_um", s.hand_before, false)
    json_field(&out, "hand_slide_after_um", s.hand_after, false)
    json_field(&out, "physics_ops", f.ops, false)
    json_field(&out, "physics_values_changed", f.changed, false)
    json_field(&out, "planted_frames", f.planted, false)
    json_field(&out, "unbalanced_frames", f.unbalanced, false)
    json_field(&out, "unbalanced_runs", f.unbalanced_runs, false)
    json_field(&out, "stepping_frames", f.stepped, false)
    json_field(&out, "airborne_frames", f.airborne, false)
    json_field(&out, "flights", f.flights, false)
    json_field(&out, "ballistic_before_um", f.ballistic_before, false)
    json_field(&out, "ballistic_after_um", f.ballistic_after, false)
    json_field(&out, "momentum_cap_urad", f.momentum_cap, false)
    json_field(&out, "momentum_before", f.momentum_before, false)
    json_field(&out, "momentum_after", f.momentum_after, false)
    json_field(&out, "momentum_drift_urad", f.momentum_drift, false)
    # CPU microseconds per stage; "tracks" includes the curve ops listed
    # after it (each op's own time).
    Report::push_text(&out, "  \"time_us\": [")
    for i in 0..<times.count |out, names, times|:
        Report::push_text(&out, ", ") if i > 0
        Report::push_text(&out, "{\"stage\": \"")
        Report::push_text(&out, names[i]) if i < names.count
        Report::push_text(&out, "\", \"us\": ")
        Report::push_number(&out, times[i])
        Report::push_text(&out, "}")
    Report::push_text(&out, "],\n  \"clips\": [\n")
    for c in clip_reports |out|:
        out.push(c)
    Report::push_text(&out, "\n  ]\n}\n")
    return out

# Fields of "A:B:C" split at ':' (each NUL-free byte run).
def split_fields(text: cstr) -> darray[darray[u8]]:
    mutable out: darray[darray[u8]] = []
    mutable cur: darray[u8] = []
    mutable i: usize = 0
    while text[i] != 0:
        if text[i] == 58:
            out.push(cur)
            cur <- []
        else:
            cur.push(text[i])
        i <- i + 1
    out.push(cur)
    return out

# Signed decimal (optionally with a fraction, scaled by `scale`); ok=false on junk.
def parse_scaled(bytes: darray[u8]&, scale: i64) -> (ok: bool, value: i64):
    return (false, 0) if bytes.count == 0
    mutable k: usize = 0
    negative: bool = bytes[0] == 45
    k <- 1 if negative
    mutable whole: i64 = 0
    mutable frac: i64 = 0
    mutable div: i64 = 1
    mutable dot: bool = false
    mutable digits: i64 = 0
    while k < bytes.count:
        c: u8 = bytes[k]
        if c == 46 and not dot:
            dot <- true
        elif c >= 48 and c <= 57:
            return (false, 0) if digits > 12
            digits <- digits + 1
            if dot:
                if div < 1000000:
                    frac <- frac * 10 + (c - 48).i64()
                    div <- div * 10
            else:
                whole <- whole * 10 + (c - 48).i64()
        else:
            return (false, 0)
        k <- k + 1
    return (false, 0) if digits == 0
    value: i64 = whole * scale + frac * scale / div
    return (true, -value if negative else value)

def role_field(bytes: darray[u8]&) -> i64:
    return RigMap::role_of_name(bytes)

# --pin ROLE:FIRST:LAST[:BLEND]
def parse_pin(text: cstr) -> (ok: bool, op: RigOps::RigOp):
    f: darray[darray[u8]] = split_fields(text)
    bad: RigOps::RigOp = RigOps::pin(Roles::NONE, 0, 0, 1)
    return (false, bad) if f.count < 3 or f.count > 4
    role: i64 = role_field(&f[0])
    first: (ok: bool, value: i64) = parse_scaled(&f[1], 1)
    last: (ok: bool, value: i64) = parse_scaled(&f[2], 1)
    mutable blend: (ok: bool, value: i64) = (true, 8)
    blend <- parse_scaled(&f[3], 1) if f.count == 4
    return (false, bad) if not Roles::role_valid(role) or (Roles::effector_hinge(role) < 0 and role != Roles::HEAD)
    return (false, bad) if not first.ok or not last.ok or not blend.ok or first.value < 0 or last.value < first.value or blend.value < 1
    return (true, RigOps::pin(role, first.value, last.value, blend.value))

# --offset ROLE:AXIS:DEGREES:FIRST:LAST[:FADE]
def parse_offset(text: cstr) -> (ok: bool, op: RigOps::RigOp):
    f: darray[darray[u8]] = split_fields(text)
    bad: RigOps::RigOp = RigOps::offset(Roles::NONE, 0, 0, 0, 0, 1)
    return (false, bad) if f.count < 5 or f.count > 6
    role: i64 = role_field(&f[0])
    return (false, bad) if not Roles::role_valid(role) or f[1].count != 1
    axis: i64 = (f[1][0] - 120).i64()
    return (false, bad) if axis < 0 or axis > 2
    degrees: (ok: bool, value: i64) = parse_scaled(&f[2], 1000000)
    first: (ok: bool, value: i64) = parse_scaled(&f[3], 1)
    last: (ok: bool, value: i64) = parse_scaled(&f[4], 1)
    mutable fade: (ok: bool, value: i64) = (true, 8)
    fade <- parse_scaled(&f[5], 1) if f.count == 6
    return (false, bad) if not degrees.ok or not first.ok or not last.ok or not fade.ok
    return (false, bad) if first.value < 0 or last.value < first.value or fade.value < 1
    return (false, bad) if degrees.value > 360000000 or degrees.value < -360000000
    radians: i64 = degrees_to_micro_rad(degrees.value)
    return (true, RigOps::offset(role, axis, radians, first.value, last.value, fade.value))

def degrees_to_micro_rad(degrees: i64) -> i64:
    return degrees * 314159 / 18000000

# --keyed ROLE:AXIS:FRAME:DEGREES:FRAME:DEGREES[...]: segments of the curve.
def parse_keyed(text: cstr, out: mutable darray[RigOps::RigOp]&) -> bool:
    f: darray[darray[u8]] = split_fields(text)
    return false if f.count < 6 or f.count % 2 != 0
    role: i64 = role_field(&f[0])
    return false if not Roles::role_valid(role) or f[1].count != 1
    axis: i64 = (f[1][0] - 120).i64()
    return false if axis < 0 or axis > 2
    mutable frames: darray[i64] = []
    mutable angles: darray[i64] = []
    mutable k: usize = 2
    while k + 1 < f.count:
        frame: (ok: bool, value: i64) = parse_scaled(&f[k], 1)
        degrees: (ok: bool, value: i64) = parse_scaled(&f[k + 1], 1000000)
        return false if not frame.ok or not degrees.ok or frame.value < 0 or frame.value > Fade::MAX_FRAMES
        return false if degrees.value > 360000000 or degrees.value < -360000000
        return false if frames.count > 0 and frame.value <= frames[frames.count - 1]
        frames.push(frame.value)
        angles.push(degrees_to_micro_rad(degrees.value))
        k <- k + 2
    for seg in RigOps::keyed(role, axis, &frames, &angles):
        out.push(seg)
    return true

def bytes_are(bytes: darray[u8]&, text: sview) -> bool:
    mutable t: darray[u8] = []
    Report::push_text(&t, text)
    return false if t.count != bytes.count
    for k in 0..<t.count:
        return false if t[k] != bytes[k]
    return true

# --retime FIRST:LAST:SPEED[:BLEND] (SPEED as a decimal, 0.5 = half speed)
def parse_retime(text: cstr) -> (ok: bool, op: RigOps::RigOp):
    f: darray[darray[u8]] = split_fields(text)
    bad: RigOps::RigOp = RigOps::retime(0, 0, 1000, 0)
    return (false, bad) if f.count < 3 or f.count > 4
    first: (ok: bool, value: i64) = parse_scaled(&f[0], 1)
    last: (ok: bool, value: i64) = parse_scaled(&f[1], 1)
    speed: (ok: bool, value: i64) = parse_scaled(&f[2], 1000)
    mutable blend: (ok: bool, value: i64) = (true, Retime::DEFAULT_BLEND)
    blend <- parse_scaled(&f[3], 1) if f.count == 4
    return (false, bad) if not first.ok or not last.ok or not speed.ok or not blend.ok
    return (false, bad) if first.value < 0 or last.value <= first.value or blend.value < 0
    return (false, bad) if not Retime::speed_ok(speed.value)
    return (true, RigOps::retime(first.value, last.value, speed.value, blend.value))

# --contact FOOT:FIRST:LAST:on|off
def parse_contact(text: cstr) -> (ok: bool, op: RigOps::RigOp):
    f: darray[darray[u8]] = split_fields(text)
    bad: RigOps::RigOp = RigOps::contact_edit(Roles::NONE, 0, 0, false)
    return (false, bad) if f.count != 4
    role: i64 = RigOps::ALL if bytes_are(&f[0], "all") else role_field(&f[0])
    return (false, bad) if role != RigOps::ALL and role != Roles::LEFT_FOOT and role != Roles::RIGHT_FOOT
    first: (ok: bool, value: i64) = parse_scaled(&f[1], 1)
    last: (ok: bool, value: i64) = parse_scaled(&f[2], 1)
    return (false, bad) if not first.ok or not last.ok or first.value < 0 or last.value < first.value
    on: bool = bytes_are(&f[3], "on")
    return (false, bad) if not on and not bytes_are(&f[3], "off")
    return (true, RigOps::contact_edit(role, first.value, last.value, on))

# --hand-contact HAND:FIRST:LAST:on|off (one named hand, never "all").
def parse_hand_contact(text: cstr) -> (ok: bool, op: RigOps::RigOp):
    f: darray[darray[u8]] = split_fields(text)
    bad: RigOps::RigOp = RigOps::contact_edit(Roles::NONE, 0, 0, false)
    return (false, bad) if f.count != 4
    role: i64 = role_field(&f[0])
    return (false, bad) if role != Roles::LEFT_HAND and role != Roles::RIGHT_HAND
    first: (ok: bool, value: i64) = parse_scaled(&f[1], 1)
    last: (ok: bool, value: i64) = parse_scaled(&f[2], 1)
    return (false, bad) if not first.ok or not last.ok or first.value < 0 or last.value < first.value
    on: bool = bytes_are(&f[3], "on")
    return (false, bad) if not on and not bytes_are(&f[3], "off")
    return (true, RigOps::contact_edit(role, first.value, last.value, on))

def parse_op(name: cstr) -> (ok: bool, op: RigOps::RigOp):
    return (true, RigOps::twist(RigOps::ALL, 280000, 500)) if same(name, "twist".cast[cstr])
    return (true, RigOps::pole(RigOps::ALL, 2, 0)) if same(name, "pole".cast[cstr])
    return (true, RigOps::pelvis(4)) if same(name, "pelvis".cast[cstr])
    return (true, RigOps::foot_lock(4)) if same(name, "lock".cast[cstr])
    return (true, RigOps::foot_pivot(4)) if same(name, "pivot".cast[cstr])
    return (true, RigOps::hand_lock(4)) if same(name, "hands".cast[cstr])
    return (false, RigOps::pelvis(1))

# Physics op by name.
def parse_phys(name: cstr) -> (ok: bool, op: Physics::PhysOp):
    return (true, Physics::balance(false)) if same(name, "balance".cast[cstr])
    return (true, Physics::ballistic(true)) if same(name, "ballistic".cast[cstr])
    return (true, Physics::momentum(true, 0)) if same(name, "momentum".cast[cstr])
    return (false, Physics::balance(false))

def has_kind(ops: darray[Physics::PhysOp]&, kind: Physics::PhysKind) -> bool:
    for op in ops:
        return true if op.kind == kind
    return false

# Batch reports always carry the physics detectors.
def with_detectors(ops: darray[Physics::PhysOp]&) -> darray[Physics::PhysOp]:
    mutable out: darray[Physics::PhysOp] = []
    for op in ops:
        out.push(op)
    out.push(Physics::balance(false)) if not has_kind(ops, Physics::PhysKind.Balance)
    out.push(Physics::ballistic(false)) if not has_kind(ops, Physics::PhysKind.Ballistic)
    out.push(Physics::momentum(false, 0)) if not has_kind(ops, Physics::PhysKind.Momentum)
    return out

def print_row(row: Report::Row):
    if row.ok:
        Out::line("ok")
    else:
        Out::line("failed")
    Out::field("tracks: ", row.tracks)
    Out::field("values changed: ", row.changed)
    Out::field("spikes before: ", row.before)
    Out::field("spikes after: ", row.after)

def usage() -> i64:
    Out::line("usage: mocap-cleaner clean <in.glb> (<out.glb> | -o <out.glb>) [--preset boxing|raw|rokoko]")
    Out::line("           [--anim NAME] [--report r.json] [--op OP] [--pin ROLE:FIRST:LAST[:BLEND]]")
    Out::line("           [--offset ROLE:AXIS:DEGREES:FIRST:LAST[:FADE]]")
    Out::line("           [--keyed ROLE:AXIS:FRAME:DEGREES:FRAME:DEGREES...]")
    Out::line("           [--contact FOOT:FIRST:LAST:on|off] [--hand-contact HAND:FIRST:LAST:on|off]")
    Out::line("           [--retime FIRST:LAST:SPEED[:BLEND]]")
    Out::line("           [--ops FILE] [--save-ops FILE]")
    Out::line("       mocap-cleaner batch <outdir> [--preset boxing|raw|rokoko] [--op OP] [--jobs N] <in.glb|folder>...")
    Out::line("       mocap-cleaner diff <a.json> <b.json> [--tolerance PERCENT] [--floor N] [--html out.html]")
    Out::line("  OP: twist pole pelvis lock pivot hands balance ballistic momentum")
    return 2

# <dir>/<basename of path>, NUL-terminated.
def join(dir: cstr, path: cstr, name: cstr) -> darray[u8]:
    mutable out: darray[u8] = []
    mutable i: usize = 0
    while dir[i] != 0:
        out.push(dir[i])
        i <- i + 1
    out.push(47)
    if name[0] != 0:
        mutable n: usize = 0
        while name[n] != 0:
            out.push(name[n])
            n <- n + 1
    else:
        mutable start: usize = 0
        mutable j: usize = 0
        while path[j] != 0:
            start <- j + 1 if path[j] == 47
            j <- j + 1
        for k in start..<j:
            out.push(path[k])
    out.push(0)
    return out

# Rig (`--op twist`...) or physics (`--op balance`...) op into the lists.
def push_op(value: cstr, rig: mutable darray[RigOps::RigOp]&, phys: mutable darray[Physics::PhysOp]&) -> bool:
    parsed: (ok: bool, op: RigOps::RigOp) = parse_op(value)
    if parsed.ok:
        rig.push(parsed.op)
        return true
    p: (ok: bool, op: Physics::PhysOp) = parse_phys(value)
    phys.push(p.op) if p.ok
    return p.ok

# Clean one batch take and append its report rows; false when it failed.
def take_row(input: cstr, outdir: cstr, preset: Presets::Preset, extra: darray[RigOps::RigOp]&, checks: darray[Physics::PhysOp]&, bank: mutable darray[Ops::Cache]&, html: mutable darray[u8]&, profile: mutable darray[u8]&) -> bool can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console, Blocking.IO]:
    target: darray[u8] = join(outdir, input, "".cast[cstr])
    output: cstr = (&target[0]).cast[cstr]
    mutable rig: RigOps::Summary = RigOps::empty_summary()
    mutable found: Physics::Findings = Physics::empty_findings()
    mutable clips: i64 = 0
    mutable times: darray[i64] = []
    mutable clip_reports: darray[u8] = []
    row: Report::Row = clean_take(input, output, preset, "".cast[cstr], extra, checks, &rig, &found, bank, &clips, &times, &clip_reports)
    Report::row_detail(html, input, row, detail_of(clips, &rig, &found))
    Report::time_row(profile, input, &times)
    Out::c_text(input)
    Out::text(": ")
    print_row(row)
    print_rig(&rig)
    print_physics(&found)
    return row.ok

# <outdir>/.mc-part-<index>.<kind>, NUL-terminated (a worker's output).
def part_path(outdir: cstr, index: usize, kind: sview) -> darray[u8]:
    mutable out: darray[u8] = []
    mutable i: usize = 0
    while outdir[i] != 0:
        out.push(outdir[i])
        i <- i + 1
    Report::push_text(&out, "/.mc-part-")
    Report::push_number(&out, index.i64())
    out.push(46)
    Report::push_text(&out, kind)
    out.push(0)
    return out

# Bytes of a worker's part file, which is then removed.
def take_part(outdir: cstr, index: usize, kind: sview) -> darray[u8] can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Blocking.IO]:
    path: darray[u8] = part_path(outdir, index, kind)
    bytes: darray[u8] = Workers::read_all((&path[0]).cast[cstr])
    Workers::remove((&path[0]).cast[cstr])
    return bytes

# Positive decimal count (1..1024).
def parse_count(text: cstr) -> (ok: bool, value: i64):
    mutable value: i64 = 0
    mutable i: usize = 0
    while text[i] >= 48 and text[i] <= 57 and value <= 1024:
        value <- value * 10 + (text[i] - 48).i64()
        i <- i + 1
    return (text[i] == 0 and i > 0 and value >= 1 and value <= 1024, value)

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console, Blocking.IO]:
    return usage() if argc < 3
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    command: cstr = slots[1].cast[cstr]
    mutable preset: Presets::Preset = Presets::Preset.Boxing
    mutable extra: darray[RigOps::RigOp] = []
    mutable phys: darray[Physics::PhysOp] = []
    # Op caches shared by every take this run cleans (Phase 6).
    mutable bank: darray[Ops::Cache] = []
    if same(command, "diff".cast[cstr]):
        return usage() if argc < 4
        mutable tol: i64 = 10
        mutable floor: i64 = 0
        mutable html: cstr = "".cast[cstr]
        mutable k: i64 = 4
        while k + 1 < argc:
            flag: cstr = slots[k.usize()].cast[cstr]
            value: cstr = slots[(k + 1).usize()].cast[cstr]
            if same(flag, "--tolerance".cast[cstr]):
                tol_fields: darray[darray[u8]] = split_fields(value)
                got_tol: (ok: bool, value: i64) = parse_scaled(&tol_fields[0], 10)
                return usage() if not got_tol.ok
                tol <- got_tol.value
            elif same(flag, "--floor".cast[cstr]):
                floor_fields: darray[darray[u8]] = split_fields(value)
                got_floor: (ok: bool, value: i64) = parse_scaled(&floor_fields[0], 1)
                return usage() if not got_floor.ok
                floor <- got_floor.value
            elif same(flag, "--html".cast[cstr]):
                html <- value
            else:
                return usage()
            k <- k + 2
        return usage() if k != argc
        if not optional_output_allowed(slots[2].cast[cstr], html) or not optional_output_allowed(slots[3].cast[cstr], html):
            return 2
        return ReportDiff::run(slots[2].cast[cstr], slots[3].cast[cstr], tol, floor, html)
    if same(command, "clean".cast[cstr]):
        input: cstr = slots[2].cast[cstr]
        mutable output: cstr = "".cast[cstr]
        mutable report: cstr = "".cast[cstr]
        mutable only: cstr = "".cast[cstr]
        mutable save_ops: cstr = "".cast[cstr]
        mutable k: i64 = 3
        if argc > 3 and slots[3].cast[cstr][0] != 45:
            output <- slots[3].cast[cstr]
            k <- 4
        while k + 1 < argc:
            flag: cstr = slots[k.usize()].cast[cstr]
            value: cstr = slots[(k + 1).usize()].cast[cstr]
            if same(flag, "--preset".cast[cstr]):
                preset <- preset_of(value)
            elif same(flag, "-o".cast[cstr]):
                output <- value
            elif same(flag, "--report".cast[cstr]):
                report <- value
            elif same(flag, "--anim".cast[cstr]):
                only <- value
            elif same(flag, "--op".cast[cstr]):
                return usage() if not push_op(value, &extra, &phys)
            elif same(flag, "--pin".cast[cstr]):
                parsed: (ok: bool, op: RigOps::RigOp) = parse_pin(value)
                return usage() if not parsed.ok
                extra.push(parsed.op)
            elif same(flag, "--offset".cast[cstr]):
                parsed: (ok: bool, op: RigOps::RigOp) = parse_offset(value)
                return usage() if not parsed.ok
                extra.push(parsed.op)
            elif same(flag, "--keyed".cast[cstr]):
                return usage() if not parse_keyed(value, &extra)
            elif same(flag, "--contact".cast[cstr]):
                parsed: (ok: bool, op: RigOps::RigOp) = parse_contact(value)
                return usage() if not parsed.ok
                extra.push(parsed.op)
            elif same(flag, "--hand-contact".cast[cstr]):
                parsed: (ok: bool, op: RigOps::RigOp) = parse_hand_contact(value)
                return usage() if not parsed.ok
                extra.push(parsed.op)
            elif same(flag, "--retime".cast[cstr]):
                parsed: (ok: bool, op: RigOps::RigOp) = parse_retime(value)
                return usage() if not parsed.ok
                extra.push(parsed.op)
            elif same(flag, "--ops".cast[cstr]):
                if not OpsFile::load(value, &extra):
                    Out::line("error: cannot read ops file")
                    return 1
            elif same(flag, "--save-ops".cast[cstr]):
                save_ops <- value
            else:
                return usage()
            k <- k + 2
        return usage() if k < argc or preset == Presets::Preset.Unknown or output[0] == 0
        if not output_allowed(input, output) or not optional_output_allowed(input, report) or not optional_output_allowed(input, save_ops):
            return 1
        if not optional_outputs_distinct(output, report) or not optional_outputs_distinct(output, save_ops) or not optional_outputs_distinct(report, save_ops):
            return 1
        if save_ops[0] != 0 and not OpsFile::save(&extra, save_ops):
            Out::line("error: cannot write ops file")
            return 1
        mutable rig: RigOps::Summary = RigOps::empty_summary()
        mutable found: Physics::Findings = Physics::empty_findings()
        mutable clips: i64 = 0
        mutable times: darray[i64] = []
        mutable clip_reports: darray[u8] = []
        row: Report::Row = clean_take(input, output, preset, only, &extra, &phys, &rig, &found, &bank, &clips, &times, &clip_reports)
        if clips == 0:
            Out::line("error: input could not be loaded or has no usable animations; check that it is a complete, supported animated GLB")
        print_row(row)
        print_rig(&rig)
        print_physics(&found)
        if report[0] != 0:
            names: darray[sview] = time_names(preset)
            json: darray[u8] = json_report(row, &rig, &found, &names, &times, &clip_reports)
            if not Report::save(&json, report):
                Out::line("error: cannot write report")
                return 1
        return 1 if not row.ok
        return 0 if row.after <= row.before
        return 3
    if same(command, "batch".cast[cstr]):
        outdir: cstr = slots[2].cast[cstr]
        mutable k: i64 = 3
        mutable flags: bool = true
        mutable jobs: i64 = 1
        while flags and k + 1 < argc:
            flag: cstr = slots[k.usize()].cast[cstr]
            value: cstr = slots[(k + 1).usize()].cast[cstr]
            if same(flag, "--preset".cast[cstr]):
                preset <- preset_of(value)
                k <- k + 2
            elif same(flag, "--op".cast[cstr]):
                return usage() if not push_op(value, &extra, &phys)
                k <- k + 2
            elif same(flag, "--jobs".cast[cstr]):
                parsed: (ok: bool, value: i64) = parse_count(value)
                return usage() if not parsed.ok
                jobs <- parsed.value
                k <- k + 2
            else:
                flags <- false
        return usage() if k >= argc or preset == Presets::Preset.Unknown
        # Expand folders into their sorted .glb files.
        mutable inputs: darray[darray[u8]] = []
        while k < argc:
            arg: cstr = slots[k.usize()].cast[cstr]
            k <- k + 1
            if Folder::is_dir(arg):
                for path in Folder::glb_files(arg):
                    inputs.push(path)
            else:
                mutable path: darray[u8] = []
                mutable i: usize = 0
                while arg[i] != 0:
                    path.push(arg[i])
                    i <- i + 1
                path.push(0)
                inputs.push(path)
        if inputs.count == 0:
            Out::line("error: no .glb inputs")
            return 1
        if not CliOutputGuard::directory_allowed("build".cast[cstr], outdir):
            Out::line("error: batch output must be an existing non-symlink directory inside build/")
            return 1
        report_path: darray[u8] = join(outdir, "".cast[cstr], "report.html".cast[cstr])
        # Admit every final destination before writing any result or part.
        for index in 0..<inputs.count |inputs, outdir, report_path|:
            input: cstr = (&inputs[index][0]).cast[cstr]
            target: darray[u8] = join(outdir, input, "".cast[cstr])
            target_path: cstr = (&target[0]).cast[cstr]
            if not optional_outputs_distinct(target_path, (&report_path[0]).cast[cstr]):
                return 1
            for source in inputs:
                source_path: cstr = (&source[0]).cast[cstr]
                if not output_allowed(source_path, target_path) or not output_allowed(source_path, (&report_path[0]).cast[cstr]):
                    return 1
            for previous in 0..<index:
                previous_input: cstr = (&inputs[previous][0]).cast[cstr]
                previous_target: darray[u8] = join(outdir, previous_input, "".cast[cstr])
                if not optional_outputs_distinct(target_path, (&previous_target[0]).cast[cstr]):
                    return 1
        checks: darray[Physics::PhysOp] = with_detectors(&phys)
        names: darray[sview] = time_names(preset)
        mutable html: darray[u8] = []
        Report::begin_detail(&html)
        mutable profile: darray[u8] = []
        Report::begin_times(&profile, &names)
        mutable failures: i64 = 0
        if jobs <= 1 or inputs.count < 2:
            for path in inputs:
                input: cstr = (&path[0]).cast[cstr]
                failures <- failures + 1 if not take_row(input, outdir, preset, &extra, &checks, &bank, &html, &profile)
        else:
            # Workers clean takes into part files; the parent waits for a free
            # slot before each fork, then replays the parts in input order.
            worker_directory: darray[u8] = CliWorkerDirectory::create(outdir)
            if worker_directory.count == 0:
                Out::line("error: cannot create a private batch worker directory")
                return 1
            part_root: cstr = (&worker_directory[0]).cast[cstr]
            mutable running: i64 = 0
            mutable launch_failed: bool = false
            for i in 0..<inputs.count |i, inputs, outdir, part_root, preset, extra, checks, bank, running, jobs, failures, launch_failed|:
                if running >= jobs:
                    waited = Workers::wait_any()
                    if not waited.reaped:
                        Out::line("error: cannot confirm worker completion; private worker files retained")
                        return 1
                    failures <- failures + 1 if not waited.ok
                    running <- running - 1
                pid: i32 = Workers::spawn()
                if pid == 0:
                    mutable part_html: darray[u8] = []
                    mutable part_time: darray[u8] = []
                    out_path: darray[u8] = part_path(part_root, i, "txt")
                    ok_redirect: bool = Workers::redirect_stdout((&out_path[0]).cast[cstr])
                    if not ok_redirect:
                        Workers::finish(1)
                    input: cstr = (&inputs[i][0]).cast[cstr]
                    ok: bool = take_row(input, outdir, preset, &extra, &checks, &bank, &part_html, &part_time)
                    html_path: darray[u8] = part_path(part_root, i, "html")
                    time_path: darray[u8] = part_path(part_root, i, "time")
                    saved: bool = Report::save(&part_html, (&html_path[0]).cast[cstr]) and Report::save(&part_time, (&time_path[0]).cast[cstr])
                    Workers::finish(0 if ok and ok_redirect and saved else 1)
                if pid < 0:
                    Out::line("error: cannot start a worker")
                    launch_failed <- true
                    failures <- failures + 1
                    break
                running <- running + 1
            while running > 0 |running, failures|:
                waited = Workers::wait_any()
                if not waited.reaped:
                    Out::line("error: cannot confirm worker completion; private worker files retained")
                    return 1
                failures <- failures + 1 if not waited.ok
                running <- running - 1
            for i in 0..<inputs.count |i, part_root, html, profile|:
                text: darray[u8] = take_part(part_root, i, "txt")
                for c in text:
                    Out::byte(c)
                rows: darray[u8] = take_part(part_root, i, "html")
                html.extend(rows)
                timing: darray[u8] = take_part(part_root, i, "time")
                profile.extend(timing)
            if not CliWorkerDirectory::remove(part_root):
                Out::text("warning: batch worker files remain at ")
                Out::c_text(part_root)
                Out::line("")
            if launch_failed:
                Out::line("error: batch incomplete; report was not published")
                return 1
        Report::finish(&html)
        Report::finish_times(&html, &profile)
        if not Report::save(&html, (&report_path[0]).cast[cstr]):
            Out::line("error: cannot write report.html")
            return 1
        return 1 if failures > 0
        return 0
    return usage()
