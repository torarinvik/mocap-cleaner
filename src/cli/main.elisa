# Headless CLI.
#   mocap-cleaner clean <in.glb> <out.glb> [--preset boxing|raw] [--anim NAME]
#   mocap-cleaner batch <outdir> [--preset boxing|raw] <in.glb>...
# Batch writes each cleaned take to <outdir>/<basename> and <outdir>/report.html.
include "../io/glb_tracks.elisa"
include "../io/console.elisa"
include "../io/report.elisa"
include "../ops/presets.elisa"

def same(arg: cstr, text: cstr) -> bool:
    mutable i: usize = 0
    while text[i] != 0:
        return false if arg[i] != text[i]
        i <- i + 1
    return arg[i] == 0

def load_or_empty(path: cstr) -> GlbDocument::Document:
    doc: GlbDocument::Document = catch GlbDocument::load(path):
        value: value
        error failure: GlbDocument::Document()
    return move doc

def animation_matches(doc: GlbDocument::Document&, a: usize, name: cstr) -> bool:
    mutable text: darray[u8] = []
    n: usize = GlbDocument::animation_name(doc, a, &text)
    for i in 0..<n:
        return false if name[i] == 0 or name[i] != text[i]
    return name[n] == 0

def preset_of(name: cstr) -> Presets::Preset:
    return Presets::Preset.Boxing if same(name, "boxing".cast[cstr])
    return Presets::Preset.Raw if same(name, "raw".cast[cstr])
    return Presets::Preset.Unknown

# Clean one take. `only` is an animation name, or empty for all.
def clean_take(input: cstr, output: cstr, preset: Presets::Preset, only: cstr) -> Report::Row:
    failed: Report::Row = Report::Row{ok: false, tracks: 0, changed: 0, before: 0, after: 0}
    opened: i32 = catch GlbDocument::load(input):
        value: 0
        error failure: 1
    return failed if opened != 0
    mutable doc: GlbDocument::Document = load_or_empty(input)
    ops: darray[Ops::Operation] = Presets::operations(preset)
    threshold: i64 = Presets::spike_threshold(preset)
    mutable tracks: i64 = 0
    mutable changed: i64 = 0
    mutable before: i64 = 0
    mutable after: i64 = 0
    for a in 0..<GlbDocument::animation_count(&doc):
        continue if only[0] != 0 and not animation_matches(&doc, a, only)
        result: (tracks: i64, changed: i64, before: i64, after: i64) = GlbTracks::clean_animation(&doc, a, ops, threshold)
        tracks <- tracks + result.tracks
        changed <- changed + result.changed
        before <- before + result.before
        after <- after + result.after
    saved: i32 = catch GlbDocument::save(&doc, output):
        value: 0
        error failure: 1
    return Report::Row{ok: saved == 0, tracks: tracks, changed: changed, before: before, after: after}

def print_row(row: Report::Row):
    if row.ok:
        Out::line("ok")
    else:
        Out::line("failed")
    Out::field("tracks: ", row.tracks)
    Out::field("values changed: ", row.changed)
    Out::field("spikes before: ", row.before)
    Out::field("spikes after: ", row.after)

def usage() -> i64:
    Out::line("usage: mocap-cleaner clean <in.glb> <out.glb> [--preset boxing|raw] [--anim NAME]")
    Out::line("       mocap-cleaner batch <outdir> [--preset boxing|raw] <in.glb>...")
    return 2

# <dir>/<basename of path>, NUL-terminated.
def join(dir: cstr, path: cstr, name: cstr) -> darray[u8]:
    mutable out: darray[u8] = []
    mutable i: usize = 0
    while dir[i] != 0:
        out.push(dir[i])
        i <- i + 1
    out.push(47)
    if name[0] != 0:
        mutable n: usize = 0
        while name[n] != 0:
            out.push(name[n])
            n <- n + 1
    else:
        mutable start: usize = 0
        mutable j: usize = 0
        while path[j] != 0:
            start <- j + 1 if path[j] == 47
            j <- j + 1
        for k in start..<j:
            out.push(path[k])
    out.push(0)
    return out

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console, Blocking.IO]:
    return usage() if argc < 3
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    command: cstr = slots[1].cast[cstr]
    mutable preset: Presets::Preset = Presets::Preset.Boxing
    if same(command, "clean".cast[cstr]):
        return usage() if argc < 4
        mutable only: cstr = "".cast[cstr]
        mutable k: i64 = 4
        while k + 1 < argc:
            flag: cstr = slots[k.usize()].cast[cstr]
            value: cstr = slots[(k + 1).usize()].cast[cstr]
            if same(flag, "--preset".cast[cstr]):
                preset <- preset_of(value)
            elif same(flag, "--anim".cast[cstr]):
                only <- value
            else:
                return usage()
            k <- k + 2
        return usage() if k < argc or preset == Presets::Preset.Unknown
        row: Report::Row = clean_take(slots[2].cast[cstr], slots[3].cast[cstr], preset, only)
        print_row(row)
        return 1 if not row.ok
        return 0 if row.after <= row.before
        return 3
    if same(command, "batch".cast[cstr]):
        outdir: cstr = slots[2].cast[cstr]
        mutable first: i64 = 3
        if argc > 4 and same(slots[3].cast[cstr], "--preset".cast[cstr]):
            preset <- preset_of(slots[4].cast[cstr])
            first <- 5
        return usage() if first >= argc or preset == Presets::Preset.Unknown
        mutable html: darray[u8] = []
        Report::begin(&html)
        mutable failures: i64 = 0
        mutable k: i64 = first
        while k < argc:
            input: cstr = slots[k.usize()].cast[cstr]
            k <- k + 1
            target: darray[u8] = join(outdir, input, "".cast[cstr])
            output: cstr = (&target[0]).cast[cstr]
            row: Report::Row = clean_take(input, output, preset, "".cast[cstr])
            failures <- failures + 1 if not row.ok
            Report::row(&html, input, row)
            Out::c_text(input)
            Out::text(": ")
            print_row(row)
        Report::finish(&html)
        report_path: darray[u8] = join(outdir, "".cast[cstr], "report.html".cast[cstr])
        if not Report::save(&html, (&report_path[0]).cast[cstr]):
            Out::line("error: cannot write report.html")
            return 1
        return 1 if failures > 0
        return 0
    return usage()
