# Pure destination admission rules for headless CLI output.
module CliOutputGuardPolicy:
    public:
        const ALLOW: i64 = 0
        const PATH_UNRESOLVED: i64 = 1
        const OUTSIDE_BUILD: i64 = 2
        const SOURCE_COLLISION: i64 = 3
        const SYMBOLIC_LINK: i64 = 4
        const NOT_REGULAR: i64 = 5
        const EXISTS: i64 = 6

        # `root` and `target` are canonical-parent paths with the final
        # component intact. A file destination must be below, not equal to,
        # the build directory.
        def file_is_under_build(root: darray[u8]&, target: darray[u8]&) -> bool:
            return false if root.count <= 1 or target.count <= root.count
            return false if root[root.count - 1] == 47
            for index in 0..<root.count |root, target, index|:
                return false if root[index] != target[index]
            target[root.count] == 47

        # Existing results are never silently replaced. The filesystem
        # adapter supplies canonical paths and lstat-style final component
        # facts; inability to inspect the path must fail closed.
        def file_decision(path_resolved: bool, target_inside_build: bool,
                          same_as_source: bool, target_exists: bool,
                          target_is_symlink: bool,
                          target_is_regular: bool) -> i64:
            requires target_exists or (not target_is_symlink and not target_is_regular)
            ensure result >= ALLOW
            ensure result <= EXISTS
            ensure result != ALLOW or (path_resolved and target_inside_build and not same_as_source and not target_exists)
            return PATH_UNRESOLVED if not path_resolved
            return OUTSIDE_BUILD if not target_inside_build
            return SOURCE_COLLISION if same_as_source
            return SYMBOLIC_LINK if target_is_symlink
            return NOT_REGULAR if target_exists and not target_is_regular
            return EXISTS if target_exists
            ALLOW

        # A batch destination is an existing, non-symlink directory strictly
        # below build. Its individual output names are checked with
        # `file_decision` before any worker starts.
        def directory_is_under_build(root: darray[u8]&, target: darray[u8]&) -> bool:
            return false if root.count <= 1 or target.count <= root.count
            return false if root[root.count - 1] == 47
            for index in 0..<root.count |root, target, index|:
                return false if root[index] != target[index]
            target[root.count] == 47
