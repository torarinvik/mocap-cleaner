# Metadata comes from the same preset used to evaluate the exported result.
extend Cli:
    private:
        def append_report_metadata(out: mutable darray[u8]&, preset: Presets::Preset):
            Report::push_text(out, "{\n  \"schema\": \"mocap-cleaner-report-v1\",\n  \"numeric_encoding\": \"exact-integer\",\n")
            Report::push_text(out, "  \"metric_units\": {\"spikes_after\": \"count\", \"pole_after\": \"count\", \"pelvis_after\": \"count\", \"momentum_after\": \"frame-count\", \"slide_after_um\": \"micrometre\", \"hand_slide_after_um\": \"micrometre\", \"ballistic_after_um\": \"micrometre\", \"unbalanced_frames\": \"frame-count\", \"unbalanced_runs\": \"count\"},\n")
            Report::push_text(out, "  \"detector_settings\": {\"spike_threshold_fixed_point\": ")
            Report::push_number(out, Presets::spike_threshold(preset))
            Report::push_text(out, "},\n")
