# Bounds for a virtualized Storage inventory window.
module StudioStorageWindowPolicy:
    public:
        def first_visible(count: i64, limit: i64, selected: i64) -> i64:
            requires count >= 1 and count <= 256
            requires limit >= 1 and limit <= count
            requires selected >= 0 and selected < count
            ensure result >= 0
            ensure result + limit <= count
            return 0 if selected < limit / 2
            first: i64 = selected - limit / 2
            return count - limit if first > count - limit
            first

        def next_inspection(count: i64, selected: i64) -> i64:
            requires count >= 1 and count <= 256
            requires selected >= 0 and selected < count
            ensure result >= 0 and result < count
            ensure result == (selected + 1 if selected < count - 1 else selected)
            return selected + 1 if selected < count - 1
            selected

        def previous_inspection(count: i64, selected: i64) -> i64:
            requires count >= 1 and count <= 256
            requires selected >= 0 and selected < count
            ensure result >= 0 and result < count
            ensure result == (selected - 1 if selected > 0 else selected)
            return selected - 1 if selected > 0
            selected

        # Inspection changes focus only; it never changes cleanup selection.
        # Invalid inventory counts produce no row rather than an unsafe index.
        def inspection_target(count: i64, selected: i64, forward: bool) -> i64:
            ensure result >= -1 and result <= 255
            ensure count < 1 or count > 256 or (result >= 0 and result < count)
            ensure count >= 1 and count <= 256 or result == -1
            return -1 if count < 1 or count > 256
            return 0 if selected < 0
            return count - 1 if selected >= count
            return next_inspection(count, selected) if forward
            previous_inspection(count, selected)
