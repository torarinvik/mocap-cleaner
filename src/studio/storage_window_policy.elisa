# Bounds for a virtualized Storage inventory window.
module StudioStorageWindowPolicy:
    public:
        def first_visible(count: i64, limit: i64, selected: i64) -> i64:
            requires count >= 1 and count <= 256
            requires limit >= 1 and limit <= count
            requires selected >= 0 and selected < count
            ensure result >= 0
            ensure result + limit <= count
            return 0 if selected < limit / 2
            first: i64 = selected - limit / 2
            return count - limit if first > count - limit
            first
