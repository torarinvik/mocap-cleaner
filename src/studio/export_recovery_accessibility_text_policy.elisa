module StudioExportRecoveryAccessibilityTextPolicy:
    public:
        const module Format:
            CAPACITY: usize = 1024
            TRUNCATION_NOTICE: sview = " Summary truncated; use recovery actions for details."

        def usable() -> usize:
            ensure result <= Format::CAPACITY
            ensure result + Format::TRUNCATION_NOTICE.len.usize() == Format::CAPACITY
            Format::CAPACITY - Format::TRUNCATION_NOTICE.len.usize()

        # Content length excludes the notice and never changes during a read.
        def view_length(content_length: usize, truncated: bool) -> usize:
            requires content_length <= usable()
            ensure result <= Format::CAPACITY
            ensure not truncated implies result == content_length
            ensure truncated implies result == content_length + Format::TRUNCATION_NOTICE.len.usize()
            return content_length + Format::TRUNCATION_NOTICE.len.usize() if truncated
            content_length
