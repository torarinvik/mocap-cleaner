# The File menu's row-to-command mapping and availability rules.
module StudioFilePolicy:
    public:
        const NONE: i64 = 0
        const OPEN_TAKE: i64 = 1
        const OPEN_SESSION: i64 = 2
        const SAVE: i64 = 3
        const SAVE_AS: i64 = 4
        const EXPORT_CURRENT: i64 = 5
        const EXPORT_AS: i64 = 6
        const OPEN_STORAGE: i64 = 7
        const WORKSPACE: i64 = 8
        const ROWS: i64 = 8

        def action(row: i64) -> i64:
            requires row >= 0
            requires row < ROWS
            ensure result >= OPEN_TAKE
            ensure result <= WORKSPACE
            ensure row != 0 or result == OPEN_TAKE
            ensure row != 1 or result == OPEN_SESSION
            ensure row != 2 or result == SAVE
            ensure row != 3 or result == SAVE_AS
            ensure row != 4 or result == EXPORT_CURRENT
            ensure row != 5 or result == EXPORT_AS
            ensure row != 6 or result == OPEN_STORAGE
            ensure row != 7 or result == WORKSPACE
            return OPEN_TAKE if row == 0
            return OPEN_SESSION if row == 1
            return SAVE if row == 2
            return SAVE_AS if row == 3
            return EXPORT_CURRENT if row == 4
            return EXPORT_AS if row == 5
            return OPEN_STORAGE if row == 6
            WORKSPACE

        def enabled(command: i64, has_take: bool) -> bool:
            requires command >= NONE
            requires command <= WORKSPACE
            ensure command != OPEN_TAKE or result
            ensure command != OPEN_STORAGE or result
            ensure command != WORKSPACE or result
            ensure command == OPEN_TAKE or command == OPEN_STORAGE or command == WORKSPACE or command == NONE or result == has_take
            return false if command == NONE
            return true if command == OPEN_TAKE
            return true if command == OPEN_STORAGE
            return true if command == WORKSPACE
            return false if command == NONE
            has_take

        def activate(row: i64, has_take: bool) -> i64:
            requires row >= -1
            requires row < ROWS
            ensure result == NONE or result >= OPEN_TAKE
            ensure result <= WORKSPACE
            ensure has_take or row <= 0 or row == 6 or row == ROWS - 1 or result == NONE
            ensure row == 6 or row == ROWS - 1 or result != OPEN_STORAGE
            ensure row != ROWS - 1 or result == WORKSPACE
            return NONE if row < 0
            return NONE if not has_take and row > 0 and row < 6
            return OPEN_TAKE if row == 0
            return OPEN_SESSION if row == 1
            return SAVE if row == 2
            return SAVE_AS if row == 3
            return EXPORT_CURRENT if row == 4
            return EXPORT_AS if row == 5
            return OPEN_STORAGE if row == 6
            WORKSPACE

        def next_enabled(row: i64, direction: i64, has_take: bool) -> i64:
            requires row >= 0
            requires row < ROWS
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < ROWS
            mutable candidate: i64 = (row + direction + ROWS) % ROWS
            for attempt in 0..<ROWS |attempt, candidate|:
                return candidate if has_take or candidate == 0 or candidate >= 6
                candidate <- (candidate + direction + ROWS) % ROWS
            row
