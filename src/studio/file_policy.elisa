# The File menu's row-to-command mapping and availability rules.
module StudioFilePolicy:
    public:
        const enum Command of i64:
            NONE = 0
            OPEN_TAKE = 1
            OPEN_SESSION = 2
            SAVE = 3
            SAVE_AS = 4
            EXPORT_CURRENT = 5
            EXPORT_AS = 6
            OPEN_STORAGE = 7
            WORKSPACE = 8

        const module Count:
            ROWS: i64 = 8

        def action(row: i64) -> i64:
            requires row >= 0
            requires row < Count::ROWS
            ensure result >= Command.OPEN_TAKE.i64()
            ensure result <= Command.WORKSPACE.i64()
            ensure row != 0 or result == Command.OPEN_TAKE.i64()
            ensure row != 1 or result == Command.OPEN_SESSION.i64()
            ensure row != 2 or result == Command.SAVE.i64()
            ensure row != 3 or result == Command.SAVE_AS.i64()
            ensure row != 4 or result == Command.EXPORT_CURRENT.i64()
            ensure row != 5 or result == Command.EXPORT_AS.i64()
            ensure row != 6 or result == Command.OPEN_STORAGE.i64()
            ensure row != 7 or result == Command.WORKSPACE.i64()
            return Command.OPEN_TAKE.i64() if row == 0
            return Command.OPEN_SESSION.i64() if row == 1
            return Command.SAVE.i64() if row == 2
            return Command.SAVE_AS.i64() if row == 3
            return Command.EXPORT_CURRENT.i64() if row == 4
            return Command.EXPORT_AS.i64() if row == 5
            return Command.OPEN_STORAGE.i64() if row == 6
            Command.WORKSPACE.i64()

        def enabled(command: i64, has_take: bool) -> bool:
            requires command >= Command.NONE.i64()
            requires command <= Command.WORKSPACE.i64()
            ensure command != Command.OPEN_TAKE.i64() or result
            ensure command != Command.OPEN_STORAGE.i64() or result
            ensure command != Command.WORKSPACE.i64() or result
            ensure command == Command.OPEN_TAKE.i64() or command == Command.OPEN_STORAGE.i64() or command == Command.WORKSPACE.i64() or command == Command.NONE.i64() or result == has_take
            return false if command == Command.NONE.i64()
            return true if command == Command.OPEN_TAKE.i64()
            return true if command == Command.OPEN_STORAGE.i64()
            return true if command == Command.WORKSPACE.i64()
            return false if command == Command.NONE.i64()
            has_take

        def activate(row: i64, has_take: bool) -> i64:
            requires row >= -1
            requires row < Count::ROWS
            ensure result == Command.NONE.i64() or result >= Command.OPEN_TAKE.i64()
            ensure result <= Command.WORKSPACE.i64()
            ensure has_take or row <= 0 or row == 6 or row == Count::ROWS - 1 or result == Command.NONE.i64()
            ensure row == 6 or row == Count::ROWS - 1 or result != Command.OPEN_STORAGE.i64()
            ensure row != Count::ROWS - 1 or result == Command.WORKSPACE.i64()
            return Command.NONE.i64() if row < 0
            return Command.NONE.i64() if not has_take and row > 0 and row < 6
            return Command.OPEN_TAKE.i64() if row == 0
            return Command.OPEN_SESSION.i64() if row == 1
            return Command.SAVE.i64() if row == 2
            return Command.SAVE_AS.i64() if row == 3
            return Command.EXPORT_CURRENT.i64() if row == 4
            return Command.EXPORT_AS.i64() if row == 5
            return Command.OPEN_STORAGE.i64() if row == 6
            Command.WORKSPACE.i64()

        def next_enabled(row: i64, direction: i64, has_take: bool) -> i64:
            requires row >= 0
            requires row < Count::ROWS
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < Count::ROWS
            mutable candidate: i64 = (row + direction + Count::ROWS) % Count::ROWS
            for attempt in 0..<Count::ROWS |attempt, candidate|:
                return candidate if has_take or candidate == 0 or candidate >= 6
                candidate <- (candidate + direction + Count::ROWS) % Count::ROWS
            row
