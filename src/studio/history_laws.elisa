# Laws of the undo/redo policy: undo and redo are inverse, recording drops
# redo, and recording never loses the shown snapshot.
include "history.elisa"
include "state/history_state.elisa"

module HistoryLaws:
    public:
        # Undo then redo returns to the same snapshot.
        def undo_then_redo(cursor: i64, count: i64) -> i64:
            requires count >= 2
            requires cursor >= 1
            requires cursor < count
            ensure result == 0
            a: i64 = HistoryPolicy::undo(cursor, count)
            b: i64 = HistoryPolicy::redo(a, count)
            return b - cursor

        # Redo then undo returns to the same snapshot.
        def redo_then_undo(cursor: i64, count: i64) -> i64:
            requires count >= 2
            requires cursor >= 0
            requires cursor < count - 1
            ensure result == 0
            a: i64 = HistoryPolicy::redo(cursor, count)
            b: i64 = HistoryPolicy::undo(a, count)
            return b - cursor

        # After recording there is always something to undo.
        def record_enables_undo(cursor: i64, capacity: i64) -> bool:
            requires capacity >= 2
            requires capacity <= HistoryPolicy::MAX_CAPACITY
            requires cursor >= 0
            requires cursor < capacity
            ensure result
            c: i64 = HistoryPolicy::push_cursor(cursor, capacity)
            return c >= 1

        # A full history drops exactly the oldest snapshot.
        def full_drops_oldest(capacity: i64) -> i64:
            requires capacity >= 2
            requires capacity <= HistoryPolicy::MAX_CAPACITY
            ensure result == 1
            return HistoryPolicy::push_shift(capacity - 1, capacity)

        # Undo at the oldest snapshot stays put.
        def undo_at_start(count: i64) -> i64:
            requires count >= 1
            ensure result == 0
            return HistoryPolicy::undo(0, count)

        # Redo at the newest snapshot stays put.
        def redo_at_end(count: i64) -> i64:
            requires count >= 1
            ensure result == 0
            r: i64 = HistoryPolicy::redo(count - 1, count)
            return r - (count - 1)

        # Recording after undo invalidates a saved snapshot on the redo branch.
        def branch_discards_saved(saved: i64, cursor: i64, shift: i64) -> i64:
            requires saved > cursor
            requires saved < HistoryPolicy::MAX_CAPACITY
            requires cursor >= 0
            requires cursor < HistoryPolicy::MAX_CAPACITY
            requires shift == 0 or shift == 1
            ensure result == -1
            return HistoryPolicy::saved_after_record(saved, true, cursor, shift)

        # Recording shifts an older reachable save point with its snapshot.
        def save_point_follows_shift(saved: i64, cursor: i64) -> i64:
            requires saved >= 1
            requires saved <= cursor
            requires cursor == HistoryPolicy::MAX_CAPACITY - 1
            ensure result == saved - 1
            return HistoryPolicy::saved_after_record(saved, true, cursor, 1)

        # If overflow evicts the saved snapshot, there is no reachable clean point.
        def evicted_save_point_is_invalid(saved: i64, cursor: i64) -> i64:
            requires saved == 0
            requires cursor == HistoryPolicy::MAX_CAPACITY - 1
            ensure result == -1
            return HistoryPolicy::saved_after_record(saved, true, cursor, 1)

        def invalid_save_point_stays_invalid(saved: i64, cursor: i64, shift: i64) -> i64:
            requires saved == -1
            requires cursor >= 0
            requires cursor < HistoryPolicy::MAX_CAPACITY
            requires shift == 0 or shift == 1
            ensure result == -1
            return HistoryPolicy::saved_after_record(saved, false, cursor, shift)

        # Only the current reachable saved snapshot is clean.
        def clean_at_saved_snapshot(cursor: i64) -> bool:
            requires cursor >= 0
            requires cursor < HistoryPolicy::MAX_CAPACITY
            ensure not result
            return HistoryPolicy::dirty(cursor, cursor, true)

        def branch_without_save_point_is_dirty(cursor: i64) -> bool:
            requires cursor >= 0
            requires cursor < HistoryPolicy::MAX_CAPACITY
            ensure result
            return HistoryPolicy::dirty(cursor, -1, false)

        def other_snapshot_is_dirty(cursor: i64, saved: i64) -> bool:
            requires cursor >= 0
            requires cursor < HistoryPolicy::MAX_CAPACITY
            requires saved >= 0
            requires saved < HistoryPolicy::MAX_CAPACITY
            requires cursor != saved
            ensure result
            return HistoryPolicy::dirty(cursor, saved, true)

        # Reading an undo target returns the prior snapshot and preserves the
        # cursor, count, and save-point metadata.
        def undo_target_preserves_history(h: mutable HistoryState::History&) -> bool:
            requires h.count >= 2
            requires h.count <= HistoryState::CAPACITY
            requires h.cursor >= 1
            requires h.cursor < h.count
            ensure result
            before_cursor: i64 = h.cursor
            before_count: i64 = h.count
            before_saved_cursor: i64 = h.saved_cursor
            before_saved_valid: bool = h.saved_valid
            if HistoryState::undo_target(h) is target:
                return StackState::same(target, h.states[before_cursor - 1]) and h.cursor == before_cursor and h.count == before_count and h.saved_cursor == before_saved_cursor and h.saved_valid == before_saved_valid
            false

        # Reading a redo target returns the next snapshot and preserves the
        # cursor, count, and save-point metadata.
        def redo_target_preserves_history(h: mutable HistoryState::History&) -> bool:
            requires h.count >= 2
            requires h.count <= HistoryState::CAPACITY
            requires h.cursor >= 0
            requires h.cursor + 1 < h.count
            ensure result
            before_cursor: i64 = h.cursor
            before_count: i64 = h.count
            before_saved_cursor: i64 = h.saved_cursor
            before_saved_valid: bool = h.saved_valid
            if HistoryState::redo_target(h) is target:
                return StackState::same(target, h.states[before_cursor + 1]) and h.cursor == before_cursor and h.count == before_count and h.saved_cursor == before_saved_cursor and h.saved_valid == before_saved_valid
            false

        # At the oldest/newest boundary, target lookup is unavailable and does
        # not alter the history metadata.
        def undo_target_unavailable_at_start() -> bool:
            ensure result
            h: mutable HistoryState::History = zeroed
            HistoryState::reset(&h, StackState::empty())
            before_count: i64 = h.count
            before_saved_cursor: i64 = h.saved_cursor
            before_saved_valid: bool = h.saved_valid
            absent: bool = HistoryState::undo_target(h) == null
            return absent and h.cursor == 0 and h.count == before_count and h.saved_cursor == before_saved_cursor and h.saved_valid == before_saved_valid

        def redo_target_unavailable_at_end() -> bool:
            ensure result
            h: mutable HistoryState::History = zeroed
            HistoryState::reset(&h, StackState::empty())
            before_count: i64 = h.count
            before_saved_cursor: i64 = h.saved_cursor
            before_saved_valid: bool = h.saved_valid
            absent: bool = HistoryState::redo_target(h) == null
            return absent and h.cursor == 0 and h.count == before_count and h.saved_cursor == before_saved_cursor and h.saved_valid == before_saved_valid
