# A task argument copies this complete value, including all path bytes.
# The dynamic path is reconstructed only inside the receiving worker region.
module StudioWorkerPathCapture:
    public:
        const module Limit:
            MAX_PATH_BYTES: usize = 4095
            STORAGE_BYTES: usize = 4096

        struct Path:
            bytes: u8[4096]
            count: usize

        def source_valid(bytes: darray[u8]&) -> bool:
            ensure result implies bytes.count > 0 and bytes.count <= Limit::MAX_PATH_BYTES
            return false if bytes.count == 0 or bytes.count > Limit::MAX_PATH_BYTES
            for byte in bytes:
                return false if byte == 0
            true

        def capture(bytes: darray[u8]&) -> Path:
            ensure result.count <= Limit::MAX_PATH_BYTES
            ensure result.count > 0 implies result.count == bytes.count
            ensure result.count > 0 implies capture_matches(result, bytes)
            mutable storage: u8[4096] = zeroed
            return Path{bytes: storage, count: 0} if not source_valid(bytes)
            for index in 0..<bytes.count |index, bytes, storage|:
                storage[index] <- bytes[index]
            Path{bytes: storage, count: bytes.count}

        def capture_matches(path: Path&, bytes: darray[u8]&) -> bool:
            ensure result implies path.count == bytes.count
            return false if not source_valid(bytes) or path.count != bytes.count
            for index in 0..<bytes.count |index, path, bytes|:
                return false if path.bytes[index] != bytes[index]
            true

        def restore[@r](path: Path&) -> darray[u8] @r can Memory.Allocate:
            ensure result.count <= Limit::MAX_PATH_BYTES
            ensure result.count == 0 or result.count == path.count
            mutable out: darray[u8] @r = []
            return move out if path.count == 0 or path.count > Limit::MAX_PATH_BYTES
            for index in 0..<path.count |index, path, out|:
                return [] if path.bytes[index] == 0
                out.push(path.bytes[index])
            return move out

        def restore_terminated[@r](path: Path&) -> darray[u8] @r can Memory.Allocate:
            ensure result.count == 0 or result.count == path.count + 1
            ensure result.count <= Limit::STORAGE_BYTES
            ensure result.count == 0 or terminated_valid(result)
            ensure result.count == 0 or terminated_matches(path, result)
            mutable out: darray[u8] @r = []
            return move out if path.count == 0 or path.count > Limit::MAX_PATH_BYTES
            for index in 0..<path.count |index, path, out|:
                return [] if path.bytes[index] == 0
                out.push(path.bytes[index])
            out.push(0)
            return move out

        def terminated_valid(bytes: darray[u8]&) -> bool:
            ensure result implies bytes.count > 1 and bytes.count <= Limit::STORAGE_BYTES
            return false if bytes.count < 2 or bytes.count > Limit::STORAGE_BYTES
            return false if bytes[bytes.count - 1] != 0
            for index in 0..<bytes.count - 1 |index, bytes|:
                return false if bytes[index] == 0
            true

        def terminated_matches(path: Path&, bytes: darray[u8]&) -> bool:
            ensure result implies bytes.count == path.count + 1
            return false if path.count == 0 or path.count > Limit::MAX_PATH_BYTES
            return false if not terminated_valid(bytes) or bytes.count != path.count + 1
            for index in 0..<path.count |index, path, bytes|:
                return false if bytes[index] != path.bytes[index]
            true
