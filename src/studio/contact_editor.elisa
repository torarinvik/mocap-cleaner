# Select-first contact editing policy. Clicking a bar chooses a frame; only an
# explicit Plant/Lift action changes the contact state.
module StudioContactEditor:
    public:
        const NO_SIDE: i64 = -1
        const SIDE_COUNT: i64 = 4
        const MAX_FRAMES: i64 = 1000000
        const PLANT: i64 = 0
        const LIFT: i64 = 1
        const RESET: i64 = 2
        const DELETE: i64 = 3
        const MERGE: i64 = 4
        const SPLIT: i64 = 5
        const ACTION_COUNT: i64 = 6
        const MAX_EDITS: i64 = 32
        const DRAG_SLOP: i64 = 3
        const NUDGE_FIRST: i64 = 0
        const NUDGE_LAST: i64 = 1
        const NUDGE_INTERVAL: i64 = 2

        struct ResetPlan:
            count: i64
            left_first: i64
            left_end: i64
            right_first: i64
            right_end: i64

        struct MergePlan:
            valid: bool
            first: i64
            last: i64

        struct SplitPlan:
            valid: bool
            left_last: i64
            right_first: i64

        struct NudgePlan:
            # Invalid requests are atomic no-ops: endpoints remain unchanged.
            valid: bool
            first: i64
            last: i64

        struct FramePlan:
            # Frame requests use the 1-based frame numbers shown in the UI.
            # Invalid or inverted drafts leave the authored interval intact.
            valid: bool
            first: i64
            last: i64

        # Move one inclusive endpoint or translate the full inclusive range by
        # an exact signed frame count. Requests that cross a clip boundary or
        # invert the interval are rejected without partial movement.
        def nudge_plan(first: i64, last: i64, frame_count: i64, target: i64, delta: i64) -> NudgePlan:
            requires frame_count >= 1
            requires frame_count <= MAX_FRAMES
            requires first >= 0
            requires first <= last
            requires last < frame_count
            ensure result.valid == (delta != 0 and (target == NUDGE_FIRST and delta >= 0 - first and delta <= last - first or target == NUDGE_LAST and delta >= first - last and delta <= frame_count - 1 - last or target == NUDGE_INTERVAL and delta >= 0 - first and delta <= frame_count - 1 - last))
            ensure result.first >= 0
            ensure result.first <= result.last
            ensure result.last < frame_count
            ensure not result.valid or result.first == (first + delta if target == NUDGE_FIRST or target == NUDGE_INTERVAL else first)
            ensure not result.valid or result.last == (last + delta if target == NUDGE_LAST or target == NUDGE_INTERVAL else last)
            ensure result.valid or result.first == first
            ensure result.valid or result.last == last
            valid: bool = delta != 0 and (target == NUDGE_FIRST and delta >= 0 - first and delta <= last - first or target == NUDGE_LAST and delta >= first - last and delta <= frame_count - 1 - last or target == NUDGE_INTERVAL and delta >= 0 - first and delta <= frame_count - 1 - last)
            moved_first: i64 = first + delta if valid and (target == NUDGE_FIRST or target == NUDGE_INTERVAL) else first
            moved_last: i64 = last + delta if valid and (target == NUDGE_LAST or target == NUDGE_INTERVAL) else last
            NudgePlan{valid: valid, first: moved_first, last: moved_last}

        # Apply a typed, 1-based first or last frame without changing the
        # opposite endpoint. Out-of-clip and inverted drafts are atomic no-ops.
        def frame_plan(first: i64, last: i64, frame_count: i64, target: i64, requested_frame: i64) -> FramePlan:
            requires frame_count >= 1
            requires frame_count <= MAX_FRAMES
            requires first >= 0
            requires first <= last
            requires last < frame_count
            ensure result.valid == (requested_frame >= 1 and requested_frame <= frame_count and (target == NUDGE_FIRST and requested_frame - 1 <= last or target == NUDGE_LAST and requested_frame - 1 >= first))
            ensure result.first >= 0
            ensure result.first <= result.last
            ensure result.last < frame_count
            ensure not result.valid or result.first == (requested_frame - 1 if target == NUDGE_FIRST else first)
            ensure not result.valid or result.last == (requested_frame - 1 if target == NUDGE_LAST else last)
            ensure result.valid or result.first == first
            ensure result.valid or result.last == last
            valid: bool = requested_frame >= 1 and requested_frame <= frame_count and (target == NUDGE_FIRST and requested_frame - 1 <= last or target == NUDGE_LAST and requested_frame - 1 >= first)
            next_first: i64 = requested_frame - 1 if valid and target == NUDGE_FIRST else first
            next_last: i64 = requested_frame - 1 if valid and target == NUDGE_LAST else last
            FramePlan{valid: valid, first: next_first, last: next_last}

        # Split immediately before `frame`: the selected frame starts the
        # right interval. Both pieces retain the same inclusive endpoints,
        # side and state as the original interval. Endpoints cannot split.
        def split_plan(first: i64, last: i64, frame: i64) -> SplitPlan:
            requires first >= 0
            requires first <= last
            requires last < MAX_FRAMES
            requires frame >= 0
            ensure result.valid == (frame > first and frame <= last)
            ensure not result.valid or result.left_last + 1 == result.right_first
            ensure not result.valid or result.left_last < last
            ensure not result.valid or result.right_first > first
            ensure not result.valid or result.left_last >= first
            ensure not result.valid or result.right_first <= last
            SplitPlan{valid: frame > first and frame <= last, left_last: frame - 1, right_first: frame}

        # Merge is safe only when these adjacent list entries have the same
        # side and state and their inclusive frame ranges touch exactly.
        def merge_plan(side_a: i64, first_a: i64, last_a: i64, planted_a: bool, side_b: i64, first_b: i64, last_b: i64, planted_b: bool) -> MergePlan:
            requires first_a >= 0
            requires first_a <= last_a
            requires last_a < MAX_FRAMES
            requires first_b >= 0
            requires first_b <= last_b
            requires last_b < MAX_FRAMES
            ensure result.first >= 0
            ensure result.first <= first_a
            ensure result.first <= first_b
            ensure first_a > first_b or result.first == first_a
            ensure first_a < first_b or result.first == first_b
            ensure result.last < MAX_FRAMES
            ensure result.last >= last_a
            ensure result.last >= last_b
            ensure last_a < last_b or result.last == last_a
            ensure last_a > last_b or result.last == last_b
            ensure result.valid == (side_a == side_b and planted_a == planted_b and (last_a + 1 == first_b or last_b + 1 == first_a))
            first: i64 = first_a if first_a <= first_b else first_b
            last: i64 = last_a if last_a >= last_b else last_b
            MergePlan{valid: side_a == side_b and planted_a == planted_b and (last_a + 1 == first_b or last_b + 1 == first_a), first: first, last: last}

        # Compact an edit list after deleting one entry. Destination slots
        # before the removed slot keep their index; later slots shift left.
        def delete_source_index(destination: i64, removed: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= MAX_EDITS
            requires removed >= 0
            requires removed < count
            requires destination >= 0
            requires destination < count - 1
            ensure result >= 0
            ensure result < count
            ensure destination >= removed or result == destination
            ensure destination < removed or result == destination + 1
            destination if destination < removed else destination + 1

        def includes(first: i64, last: i64, frame: i64) -> bool:
            first <= frame and frame < last

        # Remove one frame from an authored interval, preserving all other
        # frames as one or two intervals in the original edit order.
        def reset_interval(first: i64, last: i64, frame: i64) -> ResetPlan:
            requires first >= 0
            requires first <= last
            requires last < MAX_FRAMES
            requires frame >= 0
            ensure result.count == (0 if first == frame and last == frame else 1 if frame < first or frame > last or first == frame or last == frame else 2)
            ensure result.left_first == (0 if first == frame and last == frame else first + 1 if first == frame and frame < last else first)
            ensure result.left_end == (frame if first < frame and frame <= last else last + 1)
            ensure result.right_first == (frame + 1 if first < frame and frame < last else 0)
            ensure result.right_end == (last + 1 if first < frame and frame < last else 0)
            count: i64 = 0 if first == frame and last == frame else 1 if frame < first or frame > last or first == frame or last == frame else 2
            left_first: i64 = 0 if first == frame and last == frame else first + 1 if first == frame and frame < last else first
            left_end: i64 = frame if first < frame and frame <= last else last + 1
            right_first: i64 = frame + 1 if first < frame and frame < last else 0
            right_end: i64 = last + 1 if first < frame and frame < last else 0
            ResetPlan{count: count, left_first: left_first, left_end: left_end, right_first: right_first, right_end: right_end}

        def selection_valid(side: i64, frame: i64, frames: i64) -> bool:
            ensure not result or side >= 0
            ensure not result or side < SIDE_COUNT
            ensure not result or frame >= 0
            ensure not result or frame < frames
            ensure not result or frames <= MAX_FRAMES
            ensure result or frames < 1 or frames > MAX_FRAMES or side < 0 or side >= SIDE_COUNT or frame < 0 or frame >= frames
            frames >= 1 and frames <= MAX_FRAMES and side >= 0 and side < SIDE_COUNT and frame >= 0 and frame < frames

        def action_valid(action: i64) -> bool:
            ensure result == (action == PLANT or action == LIFT or action == RESET or action == DELETE or action == MERGE or action == SPLIT)
            action == PLANT or action == LIFT or action == RESET or action == DELETE or action == MERGE or action == SPLIT

        def plants(action: i64) -> bool:
            requires action == PLANT or action == LIFT
            ensure result == (action == PLANT)
            action == PLANT

        def is_drag(delta_x: i64) -> bool:
            ensure result == (delta_x <= 0 - DRAG_SLOP or delta_x >= DRAG_SLOP)
            delta_x <= 0 - DRAG_SLOP or delta_x >= DRAG_SLOP
