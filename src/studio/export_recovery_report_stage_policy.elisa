module StudioExportRecoveryReportStagePolicy:
    public:
        # Merge an observed report without forgetting an earlier publication.
        def with_report(current: i64, json: bool) -> i64:
            requires current == 1 or current == 3 or current == 5 or current == 7
            ensure result == 1 or result == 3 or result == 5 or result == 7
            ensure result >= current
            ensure json implies result == 3 or result == 7
            ensure not json implies result == 5 or result == 7
            ensure current == 7 implies result == 7
            ensure current == 1 and json implies result == 3
            ensure current == 1 and not json implies result == 5
            ensure current == 3 and json implies result == 3
            ensure current == 3 and not json implies result == 7
            ensure current == 5 and json implies result == 7
            ensure current == 5 and not json implies result == 5
            if current == 1:
                if json:
                    return 3
                return 5
            if current == 3:
                if json:
                    return 3
                return 7
            if current == 5:
                if json:
                    return 7
                return 5
            7
