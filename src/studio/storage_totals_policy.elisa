# Bounded, UI-neutral byte totals for the persisted Studio storage inventory.
# This reports the recorded artifact sizes; moving a file to Trash does not
# establish that disk space has been reclaimed.
include "storage_totals_kernel.elisa"

module StudioStorageTotalsPolicy:
    public:
        const MAX_ITEMS: i64 = StudioStorageTotalsKernel::MAX_ITEMS
        const MAX_ITEM_BYTES: i64 = StudioStorageTotalsKernel::MAX_ITEM_BYTES
        const MAX_TOTAL_BYTES: i64 = StudioStorageTotalsKernel::MAX_TOTAL_BYTES

        const UNIT_BYTES: i64 = StudioStorageTotalsKernel::UNIT_BYTES
        const UNIT_KIB: i64 = StudioStorageTotalsKernel::UNIT_KIB
        const UNIT_MIB: i64 = StudioStorageTotalsKernel::UNIT_MIB
        const UNIT_GIB: i64 = StudioStorageTotalsKernel::UNIT_GIB
        const UNIT_TIB: i64 = StudioStorageTotalsKernel::UNIT_TIB

        struct Totals:
            item_count: mutable i64
            bytes: mutable i64

        struct DisplayAmount:
            magnitude: i64
            unit: i64

        def valid(totals: Totals) -> bool:
            ensure result == (totals.item_count >= 0 and totals.item_count <= MAX_ITEMS and totals.bytes >= 0 and totals.bytes <= MAX_TOTAL_BYTES)
            totals.item_count >= 0 and totals.item_count <= MAX_ITEMS and totals.bytes >= 0 and totals.bytes <= MAX_TOTAL_BYTES

        # Accept one manifest-supported item. Bounds are checked before adding,
        # and the manifest limits prove the sum fits in signed i64 exactly.
        def add(totals: mutable Totals&, size_bytes: i64) -> bool:
            return false if not valid(totals)
            return false if not StudioStorageTotalsKernel::add_allowed(totals.item_count, totals.bytes, size_bytes)
            totals.bytes <- StudioStorageTotalsKernel::next_total(totals.bytes, size_bytes)
            totals.item_count <- StudioStorageTotalsKernel::next_count(totals.item_count)
            true

        # IEC units with a whole-unit magnitude; the accumulated byte count
        # remains exact and is never replaced by the rounded display value.
        def display_amount(bytes: i64) -> DisplayAmount:
            requires bytes >= 0 and bytes <= MAX_TOTAL_BYTES
            ensure result.unit >= UNIT_BYTES and result.unit <= UNIT_TIB
            ensure result.magnitude >= 0
            DisplayAmount{
                magnitude: StudioStorageTotalsKernel::display_magnitude(bytes, StudioStorageTotalsKernel::display_unit(bytes)),
                unit: StudioStorageTotalsKernel::display_unit(bytes)
            }
