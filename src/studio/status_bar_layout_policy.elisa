# Reserve readable message space while keeping frame metadata separate.
module StudioStatusBarLayoutPolicy:
    public:
        const module Layout:
            MAX_WIDTH: i64 = 16384
            INSET: i64 = 12
            WIDE_START: i64 = 560

        def message_start(width: i64) -> i64:
            requires width >= -16384 and width <= 16384
            ensure result >= 0 and result <= Layout::WIDE_START
            ensure width <= 24 or result >= Layout::INSET and result + Layout::INSET <= width
            return 0 if width <= 24
            preferred: i64 = width / 3
            return Layout::WIDE_START if preferred >= Layout::WIDE_START
            Layout::INSET if preferred < Layout::INSET else preferred

        def message_width(width: i64) -> i64:
            requires width >= -16384 and width <= 16384
            ensure result >= 0
            ensure width <= 24 or result <= width
            ensure width > 24 or result == 0
            ensure width <= 24 or message_start(width) + result + Layout::INSET == width
            0 if width <= 24 else width - message_start(width) - Layout::INSET

        def summary_width(width: i64) -> i64:
            requires width >= -16384 and width <= 16384
            ensure result >= 0
            ensure width <= 24 or result <= width
            ensure width > 24 or result == 0
            ensure result == 0 or result + 24 == message_start(width)
            start: i64 = message_start(width)
            0 if start <= 24 else start - 24
