# Keyboard focus for the post-publication result handoff.
module StudioExportResult:
    public:
        const OPEN: i64 = 0
        const SHOW_IN_FOLDER: i64 = 1
        const DONE: i64 = 2
        const ACTION_COUNT: i64 = 3

        def move_focus(current: i64, direction: i64) -> i64:
            requires current >= OPEN and current < ACTION_COUNT
            requires direction == -1 or direction == 1
            ensure result >= OPEN
            ensure result < ACTION_COUNT
            return DONE if current == OPEN and direction == -1
            return OPEN if current == DONE and direction == 1
            return current + direction
