# Keyboard focus for the post-publication result handoff.
module StudioExportResult:
    public:
        const module Action:
            OPEN: i64 = 0
            SHOW_IN_FOLDER: i64 = 1
            DONE: i64 = 2
            COUNT: i64 = 3

        def move_focus(current: i64, direction: i64) -> i64:
            requires current >= Action::OPEN and current < Action::COUNT
            requires direction == -1 or direction == 1
            ensure result >= Action::OPEN
            ensure result < Action::COUNT
            return Action::DONE if current == Action::OPEN and direction == -1
            return Action::OPEN if current == Action::DONE and direction == 1
            return current + direction
