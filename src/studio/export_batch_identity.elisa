# Owned exact identity for one batch export. Arrays are copied into the queue;
# no UI view or digest stands in for path or result bytes.
module StudioExportBatchIdentity:
    public:
        const module Limit:
            MAX_PATH_BYTES: usize = 4095
            MAX_RECIPE_BYTES: usize = 1048576
            MAX_RESULT_BYTES: usize = 67108864
            MAX_REPORT_BYTES: usize = 1048576

        struct Identity:
            source_path: darray[u8]
            source_device: i64
            source_inode: i64
            source_size: i64
            source_modified_seconds: i64
            source_modified_nanoseconds: i64
            result_generation: i64
            animation_id: i64
            staged_path: darray[u8]
            recipe_bytes: darray[u8]
            output_path: darray[u8]
            report_json_path: darray[u8]
            report_text_path: darray[u8]
            staged_result_bytes: darray[u8]
            report_json_bytes: darray[u8]
            report_text_bytes: darray[u8]

        # Byte equality is explicit so identity never relies on a hash.
        def bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            true

        def equal(left: Identity&, right: Identity&) -> bool:
            left.source_device == right.source_device and left.source_inode == right.source_inode and left.source_size == right.source_size and left.source_modified_seconds == right.source_modified_seconds and left.source_modified_nanoseconds == right.source_modified_nanoseconds and left.result_generation == right.result_generation and left.animation_id == right.animation_id and bytes_equal(left.source_path, right.source_path) and bytes_equal(left.staged_path, right.staged_path) and bytes_equal(left.recipe_bytes, right.recipe_bytes) and bytes_equal(left.output_path, right.output_path) and bytes_equal(left.report_json_path, right.report_json_path) and bytes_equal(left.report_text_path, right.report_text_path) and bytes_equal(left.staged_result_bytes, right.staged_result_bytes) and bytes_equal(left.report_json_bytes, right.report_json_bytes) and bytes_equal(left.report_text_bytes, right.report_text_bytes)

        def valid(identity: Identity&) -> bool:
            identity.source_path.count > 0 and identity.source_path.count <= Limit::MAX_PATH_BYTES and identity.source_device >= 0 and identity.source_inode >= 0 and identity.source_size >= 0 and identity.source_modified_nanoseconds >= 0 and identity.source_modified_nanoseconds < 1000000000 and identity.result_generation >= 0 and identity.animation_id >= 0 and identity.staged_path.count > 0 and identity.staged_path.count <= Limit::MAX_PATH_BYTES and identity.recipe_bytes.count > 0 and identity.recipe_bytes.count <= Limit::MAX_RECIPE_BYTES and identity.output_path.count > 0 and identity.output_path.count <= Limit::MAX_PATH_BYTES and identity.report_json_path.count > 0 and identity.report_json_path.count <= Limit::MAX_PATH_BYTES and identity.report_text_path.count > 0 and identity.report_text_path.count <= Limit::MAX_PATH_BYTES and identity.staged_result_bytes.count > 0 and identity.staged_result_bytes.count <= Limit::MAX_RESULT_BYTES and identity.report_json_bytes.count > 0 and identity.report_json_bytes.count <= Limit::MAX_REPORT_BYTES and identity.report_text_bytes.count > 0 and identity.report_text_bytes.count <= Limit::MAX_REPORT_BYTES
