include "timeline_goto_kernel.elisa"
include "timeline_time_input.elisa"

module StudioTimelineEntryPolicy:
    public:
        const enum Mode of i64:
            Frame = 0
            Seconds = 1

        def capacity(mode: Mode) -> i64:
            ensure result == 8 or result == 15
            ensure mode != Mode.Frame or result == 8
            ensure mode != Mode.Seconds or result == 15
            StudioTimelineGotoKernel::Input::MAX_DIGITS if mode == Mode.Frame else StudioTimelineTimeInput::Input::MICRO_MAX_BYTES

        def extent_valid(mode: Mode, length: i64, storage: bool) -> bool:
            ensure result == (length >= 0 and length <= capacity(mode) and (length == 0 or storage))
            length >= 0 and length <= capacity(mode) and (length == 0 or storage)

        def byte_allowed(mode: Mode, byte: u8) -> bool:
            ensure result == (byte >= 48 and byte <= 57 or mode == Mode.Seconds and byte == 46)
            StudioTimelineGotoKernel::digit_byte(byte) or mode == Mode.Seconds and byte == 46
