# A prepared export is publishable only for its captured result generation.
# The Studio increments this generation when replacing or rebuilding a take.
module StudioExportSnapshotPolicy:
    public:
        def current(captured: i64, displayed: i64) -> bool:
            ensure result == (captured >= 0 and displayed >= 0 and captured == displayed)
            captured >= 0 and displayed >= 0 and captured == displayed
