# Journal stages record observed publication. Durability is tracked separately;
# reading an old stage does not establish current file identity or ownership.
module StudioExportRecoveryStagePolicy:
    public:
        const enum Stage of i64:
            Prepared = 0
            GlbPublished = 1
            GlbAndJsonPublished = 3
            GlbAndTextPublished = 5
            Complete = 7

        # Integer checks belong at the wire boundary, before conversion to Stage.
        def wire_admitted(value: i64) -> bool:
            ensure result == (value == 0 or value == 1 or value == 3 or value == 5 or value == 7)
            value == 0 or value == 1 or value == 3 or value == 5 or value == 7

        def transition_admitted(current: i64, next: i64) -> bool:
            ensure result implies wire_admitted(current)
            ensure result implies wire_admitted(next)
            ensure result implies next >= current
            ensure result and current == 3 implies next == 3 or next == 7
            ensure result and current == 5 implies next == 5 or next == 7
            ensure result and current == 7 implies next == 7
            return false if not wire_admitted(current) or not wire_admitted(next)
            return true if current == 0
            return next >= 1 if current == 1
            return next == 3 or next == 7 if current == 3
            return next == 5 or next == 7 if current == 5
            next == 7
