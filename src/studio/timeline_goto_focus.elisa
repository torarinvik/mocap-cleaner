# Closed keyboard focus order for the modal frame dialog.
module StudioTimelineGotoFocus:
    public:
        const enum Control of i64:
            Field = 0
            Apply = 1
            Cancel = 2

        const enum Hit of i64:
            None = -1
            Apply = 0
            Cancel = 1
            Field = 2

        def next(control: Control, reverse: bool) -> Control:
            ensure result != control
            ensure not reverse or control != Control.Field or result == Control.Cancel
            ensure reverse or control != Control.Field or result == Control.Apply
            if reverse:
                return Control.Cancel if control == Control.Field
                return Control.Field if control == Control.Apply
                return Control.Apply
            return Control.Apply if control == Control.Field
            return Control.Cancel if control == Control.Apply
            Control.Field
