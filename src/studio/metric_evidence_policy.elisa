# Explicit evidence states for preservation gates. Unknown data never passes.
module StudioMetricEvidencePolicy:
    public:
        const module State:
            UNKNOWN: i64 = 0
            PASS: i64 = 1
            FAIL: i64 = 2
            INAPPLICABLE: i64 = 3

        def classify(applicable: bool, available: bool, samples: i64, failures: i64) -> i64:
            ensure result == (State::INAPPLICABLE if not applicable else State::UNKNOWN if not available or samples <= 0 or failures < 0 or failures > samples else State::FAIL if failures > 0 else State::PASS)
            ensure result >= State::UNKNOWN and result <= State::INAPPLICABLE
            ensure applicable or result == State::INAPPLICABLE
            ensure not applicable or result != State::INAPPLICABLE
            ensure result != State::PASS or available
            ensure result != State::PASS or samples > 0
            ensure result != State::PASS or failures == 0
            ensure result != State::FAIL or available
            ensure result != State::FAIL or failures > 0 and failures <= samples
            return State::INAPPLICABLE if not applicable
            return State::UNKNOWN if not available or samples <= 0 or failures < 0 or failures > samples
            return State::FAIL if failures > 0
            State::PASS

        def admits(state: i64) -> bool:
            ensure result == (state == State::PASS or state == State::INAPPLICABLE)
            state == State::PASS or state == State::INAPPLICABLE
