# Admission for read-only inspection of a recorded Storage inventory path.
# This intentionally depends only on row bounds, stored path length and the
# current batch state; cleanup eligibility and disk identity do not gate it.
include "storage_selection_policy.elisa"

module StudioStoragePathInspectionPolicy:
    public:
        const PATH_MAX_BYTES: i64 = 4095

        def allowed(row_count: i64, index: i64, path_bytes: i64,
                    batch_running: bool) -> bool:
            ensure result == (row_count >= 0 and row_count <= StudioStorageSelectionPolicy::Capacity::MAX_ROWS and index >= 0 and index < row_count and path_bytes >= 1 and path_bytes <= PATH_MAX_BYTES and not batch_running)
            row_count >= 0 and row_count <= StudioStorageSelectionPolicy::Capacity::MAX_ROWS and index >= 0 and index < row_count and path_bytes >= 1 and path_bytes <= PATH_MAX_BYTES and not batch_running
