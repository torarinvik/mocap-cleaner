# Bounded scalar lifecycle for a reviewed Storage cleanup batch. The owner
# keeps rows in stable identity order and performs at most one item per frame.
include "storage_move_policy.elisa"
include "storage_totals_kernel.elisa"

module StudioStorageBatchPolicy:
    public:
        const module Capacity:
            MAX_ITEMS: i64 = StudioStorageTotalsKernel::Capacity::MAX_ITEMS
            STATE_COUNT: i64 = 8
            ITEM_COUNT: i64 = 7

        const enum State of i64:
            Idle = 0
            Running = 1
            Cancelled = 2
            Complete = 3
            StopReviewChanged = 4
            StopRecoveryRequired = 5
            StopUnknown = 6
            StopInvalid = 7

        const enum ItemStatus of i64:
            NotAttempted = 0
            Recorded = 1
            KnownFailed = 2
            Restored = 3
            RecoveryRequired = 4
            Unknown = 5
            Invalid = 6

        def valid_state(state: i64) -> bool:
            ensure result == (state >= State.Idle.i64() and state < Capacity::STATE_COUNT)
            state >= State.Idle.i64() and state < Capacity::STATE_COUNT


        def valid_item_status(item_status: i64) -> bool:
            ensure result == (item_status >= ItemStatus.NotAttempted.i64() and item_status < Capacity::ITEM_COUNT)
            item_status >= ItemStatus.NotAttempted.i64() and item_status < Capacity::ITEM_COUNT

        def review_ready(confirmed: bool, set_unchanged: bool,
                         recovery_required: bool) -> bool:
            confirmed and set_unchanged and not recovery_required

        # Convert the durable move transaction outcome into the batch's
        # accounting class. Unknown and receipt-recovery states stop progress.
        def item_status(move_outcome: i64) -> i64:
            ensure move_outcome != StudioStorageMovePolicy::Outcome.Recorded.i64() or result == ItemStatus.Recorded.i64()
            ensure move_outcome != StudioStorageMovePolicy::Outcome.MoveFailedOriginal.i64() or result == ItemStatus.KnownFailed.i64()
            ensure move_outcome != StudioStorageMovePolicy::Outcome.OriginalRestored.i64() or result == ItemStatus.Restored.i64()
            ensure move_outcome != StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64() or result == ItemStatus.RecoveryRequired.i64()
            ensure move_outcome != StudioStorageMovePolicy::Outcome.MoveUnknown.i64() or result == ItemStatus.Unknown.i64()
            ensure move_outcome != StudioStorageMovePolicy::Outcome.DurabilityUnknown.i64() or result == ItemStatus.Unknown.i64()
            ensure move_outcome != StudioStorageMovePolicy::Outcome.RollbackUnknownReceiptRetained.i64() or result == ItemStatus.Unknown.i64()
            return ItemStatus.Invalid.i64() if move_outcome < StudioStorageMovePolicy::Outcome.Invalid.i64() or move_outcome >= StudioStorageMovePolicy::Capacity::OUTCOME_COUNT or move_outcome == StudioStorageMovePolicy::Outcome.Invalid.i64()
            return ItemStatus.NotAttempted.i64() if move_outcome == StudioStorageMovePolicy::Outcome.NotStarted.i64()
            return ItemStatus.KnownFailed.i64() if move_outcome == StudioStorageMovePolicy::Outcome.MoveFailedOriginal.i64()
            return ItemStatus.Recorded.i64() if move_outcome == StudioStorageMovePolicy::Outcome.Recorded.i64()
            return ItemStatus.Restored.i64() if move_outcome == StudioStorageMovePolicy::Outcome.OriginalRestored.i64()
            return ItemStatus.RecoveryRequired.i64() if move_outcome == StudioStorageMovePolicy::Outcome.ReceiptPending.i64() or move_outcome == StudioStorageMovePolicy::Outcome.RollbackRequired.i64() or move_outcome == StudioStorageMovePolicy::Outcome.RecoveryReceiptRetained.i64()
            return ItemStatus.Unknown.i64() if move_outcome == StudioStorageMovePolicy::Outcome.MoveUnknown.i64() or move_outcome == StudioStorageMovePolicy::Outcome.DurabilityUnknown.i64() or move_outcome == StudioStorageMovePolicy::Outcome.RollbackUnknownReceiptRetained.i64()
            ItemStatus.Invalid.i64()

        # Start requires a fresh explicit review of the same stable selection.
        # Any running batch blocks duplicate activation.
        def may_start(state: i64, total: i64, review_confirmed: bool,
                      reviewed_set_unchanged: bool,
                      recovery_required: bool) -> bool:
            requires total <= Capacity::MAX_ITEMS
            ensure not result or state != State.Running.i64()
            ensure not result or review_confirmed
            ensure not result or reviewed_set_unchanged
            ensure not result or not recovery_required
            ensure not result or state >= State.Idle.i64()
            ensure not result or state < Capacity::STATE_COUNT
            ensure not result or total > 0
            ensure state != State.Running.i64() or not result
            ensure not result or review_confirmed
            ensure not result or reviewed_set_unchanged
            ensure not result or not recovery_required
            return false if state < State.Idle.i64() or state >= Capacity::STATE_COUNT
            return false if state == State.Running.i64()
            return false if total <= 0
            return false if total > Capacity::MAX_ITEMS
            return false if not review_ready(review_confirmed, reviewed_set_unchanged, recovery_required)
            true

        def next_index(index: i64, total: i64, item: i64) -> i64:
            requires total >= 1 and total <= Capacity::MAX_ITEMS
            requires index >= 0 and index < total
            requires item >= ItemStatus.NotAttempted.i64() and item < Capacity::ITEM_COUNT
            ensure result >= index
            ensure result <= index + 1
            ensure item != ItemStatus.Unknown.i64() or result == index
            index + 1 if item == ItemStatus.Recorded.i64() or item == ItemStatus.KnownFailed.i64() or item == ItemStatus.Restored.i64() or item == ItemStatus.RecoveryRequired.i64() else index

        def next_completed(completed: i64, item: i64) -> i64:
            requires completed >= 0 and completed < Capacity::MAX_ITEMS
            requires item >= ItemStatus.NotAttempted.i64() and item < Capacity::ITEM_COUNT
            ensure item != ItemStatus.Recorded.i64() or result == completed + 1
            ensure item == ItemStatus.Recorded.i64() or result == completed
            completed + 1 if item == ItemStatus.Recorded.i64() else completed

        def next_failed(failed: i64, item: i64) -> i64:
            requires failed >= 0 and failed < Capacity::MAX_ITEMS
            requires item >= ItemStatus.NotAttempted.i64() and item < Capacity::ITEM_COUNT
            ensure (item != ItemStatus.KnownFailed.i64() and item != ItemStatus.Restored.i64() and item != ItemStatus.RecoveryRequired.i64()) or result == failed + 1
            ensure item == ItemStatus.KnownFailed.i64() or item == ItemStatus.Restored.i64() or item == ItemStatus.RecoveryRequired.i64() or result == failed
            failed + 1 if item == ItemStatus.KnownFailed.i64() or item == ItemStatus.Restored.i64() or item == ItemStatus.RecoveryRequired.i64() else failed

        def untouched_after_known(total: i64, next: i64) -> i64:
            requires total >= 0 and total <= Capacity::MAX_ITEMS
            requires next >= 0 and next <= total
            ensure result >= 0
            ensure result <= total
            total - next

        # The item at `index` has unknown location; untouched counts only the
        # later rows, while the batch status separately reports uncertainty.
        def untouched_after_unknown(total: i64, index: i64) -> i64:
            requires total >= 1 and total <= Capacity::MAX_ITEMS
            requires index >= 0 and index < total
            ensure result >= 0
            ensure result < total
            ensure result == total - index - 1
            total - index - 1

        # Advance a single frame. Terminal states are sticky. Known outcomes
        # are counted before cancellation or safety gates stop the next row.
        def next_state(state: i64, total: i64, index: i64,
                       item: i64, cancel_requested: bool,
                       reviewed_set_unchanged: bool,
                       recovery_required: bool) -> i64:
            requires state >= State.Idle.i64() and state < Capacity::STATE_COUNT
            requires total >= 1 and total <= Capacity::MAX_ITEMS
            requires index >= 0 and index < total
            requires item >= ItemStatus.NotAttempted.i64() and item < Capacity::ITEM_COUNT
            ensure result >= State.Idle.i64()
            ensure result < Capacity::STATE_COUNT
            ensure state != State.Running.i64() or item != ItemStatus.Unknown.i64() or result == State.StopUnknown.i64()
            ensure state != State.Running.i64() or item != ItemStatus.RecoveryRequired.i64() or result == State.StopRecoveryRequired.i64()
            ensure state != State.Running.i64() or item != ItemStatus.NotAttempted.i64() or not cancel_requested or result == State.Cancelled.i64()
            ensure state != State.Running.i64() or item != ItemStatus.NotAttempted.i64() or cancel_requested or reviewed_set_unchanged or result == State.StopReviewChanged.i64()
            ensure state != State.Running.i64() or item != ItemStatus.NotAttempted.i64() or cancel_requested or not reviewed_set_unchanged or not recovery_required or result == State.StopRecoveryRequired.i64()
            ensure state == State.Running.i64() or result == state
            return state if state != State.Running.i64()
            return State.StopInvalid.i64() if item == ItemStatus.Invalid.i64()
            return State.StopUnknown.i64() if item == ItemStatus.Unknown.i64()
            return State.StopRecoveryRequired.i64() if item == ItemStatus.RecoveryRequired.i64()
            return State.Cancelled.i64() if item == ItemStatus.NotAttempted.i64() and cancel_requested
            return State.StopReviewChanged.i64() if item == ItemStatus.NotAttempted.i64() and not reviewed_set_unchanged
            return State.StopRecoveryRequired.i64() if item == ItemStatus.NotAttempted.i64() and recovery_required
            return State.Running.i64() if item == ItemStatus.NotAttempted.i64()
            return State.Complete.i64() if index + 1 == total
            return State.Cancelled.i64() if cancel_requested
            return State.StopReviewChanged.i64() if not reviewed_set_unchanged
            return State.StopRecoveryRequired.i64() if recovery_required
            State.Running.i64()
