module StudioWorkspaceEntryLayoutPolicy:
    public:
        const module Geometry:
            LEFT: f32 = 8.0
            TOP: f32 = 38.0
            WIDTH: f32 = 132.0
            HEIGHT: f32 = 30.0
            POPUP_TOP: f32 = 72.0

        def trigger_label(workspace_ready: bool, setup_pending: bool) -> sview:
            ensure setup_pending implies result == "Finish Setup"
            ensure not setup_pending and not workspace_ready implies result == "Choose Workspace"
            ensure not setup_pending and workspace_ready implies result == "Workspace / File"
            return "Finish Setup" if setup_pending
            return "Choose Workspace" if not workspace_ready
            "Workspace / File"

        def trigger_below_badge(trigger_top: f32, trigger_height: f32,
                                badge_bottom: f32) -> bool:
            ensure result implies trigger_top >= badge_bottom
            trigger_top >= badge_bottom and trigger_height > 0.0

        def popup_aligned_with_trigger(trigger_left: f32, popup_left: f32) -> bool:
            trigger_left == popup_left
