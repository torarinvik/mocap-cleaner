# Classify source association for session validation and explicit Locate review.
# Residues detect accidental changes; they do not authenticate source bytes.
# Matching paths are unnecessary: moving a file must preserve its association.
module StudioSessionSourcePolicy:
    public:
        const enum Comparison of i64:
            Matching = 0
            ChangedBytes = 1
            ChangedAnimation = 2
            ChangedShape = 3

        def compare(saved_first: i64, saved_second: i64, saved_animation: i64, saved_frames: i64, saved_nodes: i64, current_first: i64, current_second: i64, current_animation: i64, current_frames: i64, current_nodes: i64) -> Comparison:
            ensure (result == Comparison.Matching) == (saved_first == current_first and saved_second == current_second and saved_animation == current_animation and saved_frames == current_frames and saved_nodes == current_nodes)
            ensure (result == Comparison.ChangedBytes) == (saved_first != current_first or saved_second != current_second)
            ensure (result == Comparison.ChangedAnimation) == (saved_first == current_first and saved_second == current_second and saved_animation != current_animation)
            ensure (result == Comparison.ChangedShape) == (saved_first == current_first and saved_second == current_second and saved_animation == current_animation and (saved_frames != current_frames or saved_nodes != current_nodes))
            return Comparison.ChangedBytes if saved_first != current_first or saved_second != current_second
            return Comparison.ChangedAnimation if saved_animation != current_animation
            return Comparison.ChangedShape if saved_frames != current_frames or saved_nodes != current_nodes
            Comparison.Matching

        def decode_context_matches(frames: i64, nodes: i64, identity_frames: i64, identity_nodes: i64) -> bool:
            ensure result == (frames == identity_frames and nodes == identity_nodes)
            frames == identity_frames and nodes == identity_nodes
