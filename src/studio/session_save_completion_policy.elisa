# Distinguish atomic publication from later adoption and Storage registration.
module StudioSessionSaveCompletionPolicy:
    public:
        const enum Outcome of i64:
            Refused = 0
            Saved = 1
            SavedUntracked = 2
            SavedTargetUnchanged = 3
            SavedUntrackedTargetUnchanged = 4

        def classify(write_succeeded: bool, adoption_requested: bool,
                     path_adopted: bool, storage_registered: bool) -> Outcome:
            ensure result == Outcome.Refused implies not write_succeeded
            ensure result != Outcome.Refused implies write_succeeded
            ensure result == Outcome.Saved or result == Outcome.SavedUntracked implies not adoption_requested or path_adopted
            ensure result == Outcome.SavedTargetUnchanged or result == Outcome.SavedUntrackedTargetUnchanged implies adoption_requested and not path_adopted
            return Outcome.Refused if not write_succeeded
            if adoption_requested and not path_adopted:
                return Outcome.SavedTargetUnchanged if storage_registered else Outcome.SavedUntrackedTargetUnchanged
            Outcome.Saved if storage_registered else Outcome.SavedUntracked
