# User-facing labels for whether balance evidence could be evaluated.
module StudioBalanceStatusPolicy:
    public:
        const enum Availability of i64:
            Unavailable = 0
            Inapplicable = 1
            Available = 2

        def label(availability: Availability) -> sview:
            return "Balance available" if availability == Availability.Available
            return "Balance inapplicable" if availability == Availability.Inapplicable
            "Balance unavailable"

        def detail(availability: Availability) -> sview:
            return "Computed; not a pass score" if availability == Availability.Available
            return "Take has fewer than 3 frames" if availability == Availability.Inapplicable
            "Missing or invalid evidence"

        def help(availability: Availability) -> sview:
            return "Balance was evaluated from valid clip data. This status is not a pass/fail judgment." if availability == Availability.Available
            return "Balance is inapplicable because a velocity-based capture point needs at least three frames." if availability == Availability.Inapplicable
            "Balance could not be evaluated because required shape, frame, or length evidence was missing or invalid."
