# User-facing labels for whether balance evidence could be evaluated.
module StudioBalanceStatusPolicy:
    public:
        const enum Availability of i64:
            Unavailable = 0
            Inapplicable = 1
            Available = 2

        def label(availability: Availability) -> sview:
            return "Balance available" if availability == Availability.Available
            return "Balance inapplicable" if availability == Availability.Inapplicable
            "Balance unavailable"

        def detail(availability: Availability) -> sview:
            return "Computed; not a pass score" if availability == Availability.Available
            return "Take has fewer than 3 frames" if availability == Availability.Inapplicable
            "Missing or invalid evidence"

        def short_label(availability: Availability) -> sview:
            return "available" if availability == Availability.Available
            return "inapplicable" if availability == Availability.Inapplicable
            "unavailable"

        def pair_measured(before: Availability, after: Availability) -> bool:
            ensure result implies before == Availability.Available and after == Availability.Available
            ensure before == Availability.Available and after == Availability.Available implies result
            before == Availability.Available and after == Availability.Available

        def comparison_admitted(before: Availability, after: Availability, same_sample_domain: bool) -> bool:
            ensure result implies same_sample_domain and before == Availability.Available and after == Availability.Available
            ensure same_sample_domain and before == Availability.Available and after == Availability.Available implies result
            same_sample_domain and pair_measured(before, after)

        def comparison_reason(before: Availability, after: Availability, same_sample_domain: bool) -> sview:
            return "The first balance measurement is unavailable." if before == Availability.Unavailable
            return "The first balance measurement is inapplicable for this take." if before == Availability.Inapplicable
            return "The second balance measurement is unavailable." if after == Availability.Unavailable
            return "The second balance measurement is inapplicable for this take." if after == Availability.Inapplicable
            return "The two balance measurements use different frame/time domains." if not same_sample_domain
            ""

        def count_admitted(availability: Availability, impossible_frames: i64) -> bool:
            ensure result == (impossible_frames >= 0 and (availability == Availability.Available or impossible_frames == 0))
            impossible_frames >= 0 and (availability == Availability.Available or impossible_frames == 0)

        def help(availability: Availability) -> sview:
            return "Balance was evaluated from valid clip data. This status is not a pass/fail judgment." if availability == Availability.Available
            return "Balance is inapplicable because a velocity-based capture point needs at least three frames." if availability == Availability.Inapplicable
            "Balance could not be evaluated because required shape, frame, or length evidence was missing or invalid."
