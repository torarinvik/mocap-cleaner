# Laws for Save/Discard/Cancel focus and resolution.
include "replacement.elisa"

module StudioReplacementLaws:
    public:
        def starts_on_save() -> i64:
            ensure result == StudioReplacement::FOCUS_SAVE
            StudioReplacement::initial_focus()

        def focus_wraps_forward() -> i64:
            requires StudioReplacement::FOCUS_CANCEL == 2
            ensure result == StudioReplacement::FOCUS_SAVE
            StudioReplacement::move_focus(StudioReplacement::FOCUS_CANCEL, 1)

        def focus_wraps_backward() -> i64:
            requires StudioReplacement::FOCUS_SAVE == 0
            ensure result == StudioReplacement::FOCUS_CANCEL
            StudioReplacement::move_focus(StudioReplacement::FOCUS_SAVE, -1)

        def closed_prompt_cannot_resolve(choice: i64) -> i64:
            requires choice >= StudioReplacement::SAVE
            requires choice <= StudioReplacement::CANCEL
            ensure result == StudioReplacement::NONE
            StudioReplacement::resolve(false, choice)

        def open_prompt_resolves_choice(choice: i64) -> i64:
            requires choice >= StudioReplacement::SAVE
            requires choice <= StudioReplacement::CANCEL
            ensure result == choice
            StudioReplacement::resolve(true, choice)
