# Overflow-safe conversion from bounded filesystem timestamps to cleanup age.
# The caller validates status before using completed_age_days.
module StudioStorageAgePolicy:
    public:
        const module Status:
            INVALID: i64 = 0
            VALID: i64 = 1
            FUTURE: i64 = 2

        const module Time:
            MAX_TIMESTAMP_SECONDS: i64 = 9000000000000000000
            SECONDS_PER_DAY: i64 = 86400

        const module Age:
            MAX_DAYS: i64 = 365000
            MAX_SECONDS: i64 = 31536000000

        def timestamp_status(modified_seconds: i64, current_unix_seconds: i64) -> i64:
            ensure result == (Status::INVALID if modified_seconds < 0 - Time::MAX_TIMESTAMP_SECONDS or modified_seconds > Time::MAX_TIMESTAMP_SECONDS or current_unix_seconds < 0 or current_unix_seconds > Time::MAX_TIMESTAMP_SECONDS else (Status::FUTURE if modified_seconds > current_unix_seconds else Status::VALID))
            if modified_seconds < 0 - Time::MAX_TIMESTAMP_SECONDS or modified_seconds > Time::MAX_TIMESTAMP_SECONDS:
                return Status::INVALID
            if current_unix_seconds < 0 or current_unix_seconds > Time::MAX_TIMESTAMP_SECONDS:
                return Status::INVALID
            if modified_seconds > current_unix_seconds:
                return Status::FUTURE
            Status::VALID

        # Signed subtraction is evaluated only for receipts newer than the
        # saturation cutoff, so the difference is bounded before division.
        def days_since_recent(modified_seconds: i64, current_unix_seconds: i64) -> i64:
            requires modified_seconds >= 0 - Time::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= Time::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_unix_seconds
            requires current_unix_seconds <= Time::MAX_TIMESTAMP_SECONDS
            requires modified_seconds > current_unix_seconds - Age::MAX_SECONDS
            ensure result == (current_unix_seconds - modified_seconds) / Time::SECONDS_PER_DAY
            (current_unix_seconds - modified_seconds) / Time::SECONDS_PER_DAY

        def completed_age_days(modified_seconds: i64, current_unix_seconds: i64) -> i64:
            requires modified_seconds >= 0 - Time::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= Time::MAX_TIMESTAMP_SECONDS
            requires current_unix_seconds >= 0
            requires current_unix_seconds <= Time::MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_unix_seconds
            ensure result >= 0
            ensure result <= Age::MAX_DAYS
            ensure modified_seconds > current_unix_seconds - Age::MAX_SECONDS or result == Age::MAX_DAYS
            if modified_seconds > current_unix_seconds - Age::MAX_SECONDS:
                recent_days: i64 = (current_unix_seconds - modified_seconds) / Time::SECONDS_PER_DAY
                return 0 if recent_days < 0
                return Age::MAX_DAYS if recent_days > Age::MAX_DAYS
                recent_days
            else:
                Age::MAX_DAYS
