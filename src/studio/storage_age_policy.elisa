# Overflow-safe conversion from bounded filesystem timestamps to cleanup age.
# The caller validates status before using completed_age_days.
module StudioStorageAgePolicy:
    public:
        const STATUS_INVALID: i64 = 0
        const STATUS_VALID: i64 = 1
        const STATUS_FUTURE: i64 = 2
        const MAX_TIMESTAMP_SECONDS: i64 = 9000000000000000000
        const SECONDS_PER_DAY: i64 = 86400
        const MAX_AGE_DAYS: i64 = 365000
        const MAX_AGE_SECONDS: i64 = 31536000000

        def timestamp_status(modified_seconds: i64, current_unix_seconds: i64) -> i64:
            ensure result == (STATUS_INVALID if modified_seconds < 0 - MAX_TIMESTAMP_SECONDS or modified_seconds > MAX_TIMESTAMP_SECONDS or current_unix_seconds < 0 or current_unix_seconds > MAX_TIMESTAMP_SECONDS else (STATUS_FUTURE if modified_seconds > current_unix_seconds else STATUS_VALID))
            if modified_seconds < 0 - MAX_TIMESTAMP_SECONDS or modified_seconds > MAX_TIMESTAMP_SECONDS:
                return STATUS_INVALID
            if current_unix_seconds < 0 or current_unix_seconds > MAX_TIMESTAMP_SECONDS:
                return STATUS_INVALID
            if modified_seconds > current_unix_seconds:
                return STATUS_FUTURE
            STATUS_VALID

        # Signed subtraction is evaluated only for receipts newer than the
        # saturation cutoff, so the difference is bounded before division.
        def days_since_recent(modified_seconds: i64, current_unix_seconds: i64) -> i64:
            requires modified_seconds >= 0 - MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_unix_seconds
            requires current_unix_seconds <= MAX_TIMESTAMP_SECONDS
            requires modified_seconds > current_unix_seconds - MAX_AGE_SECONDS
            ensure result == (current_unix_seconds - modified_seconds) / SECONDS_PER_DAY
            (current_unix_seconds - modified_seconds) / SECONDS_PER_DAY

        def completed_age_days(modified_seconds: i64, current_unix_seconds: i64) -> i64:
            requires modified_seconds >= 0 - MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= MAX_TIMESTAMP_SECONDS
            requires current_unix_seconds >= 0
            requires current_unix_seconds <= MAX_TIMESTAMP_SECONDS
            requires modified_seconds <= current_unix_seconds
            ensure result >= 0
            ensure result <= MAX_AGE_DAYS
            ensure modified_seconds > current_unix_seconds - MAX_AGE_SECONDS or result == MAX_AGE_DAYS
            if modified_seconds > current_unix_seconds - MAX_AGE_SECONDS:
                recent_days: i64 = (current_unix_seconds - modified_seconds) / SECONDS_PER_DAY
                return 0 if recent_days < 0
                return MAX_AGE_DAYS if recent_days > MAX_AGE_DAYS
                recent_days
            else:
                MAX_AGE_DAYS
