# Retry admission is a conjunction of fresh workspace, ownership, binding,
# staging, and destination facts. No one fact stands in for another.
module StudioExportRecoveryRetryPolicy:
    public:
        def prepared_retry_admitted(workspace_matches: bool, locked: bool,
                directory_owned: bool, binding_matches: bool, prepared: bool,
                staging_matches: bool, destinations_ready: bool) -> bool:
            ensure result == (workspace_matches and locked and directory_owned and binding_matches and prepared and staging_matches and destinations_ready)
            workspace_matches and locked and directory_owned and binding_matches and prepared and staging_matches and destinations_ready

        # A prior create-only publication can leave a Prepared journal when its
        # journal update failed. Exact output binding is an alternate admission
        # path; it never authorizes a second GLB write.
        def existing_publication_admitted(workspace_matches: bool, locked: bool,
                directory_owned: bool, binding_matches: bool, prepared: bool,
                output_matches: bool, destinations_ready: bool) -> bool:
            ensure result == (workspace_matches and locked and directory_owned and binding_matches and prepared and output_matches and destinations_ready)
            workspace_matches and locked and directory_owned and binding_matches and prepared and output_matches and destinations_ready
