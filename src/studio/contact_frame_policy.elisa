# Exact typed, 1-based edits to inclusive authored contact frame ranges.
# This kernel is independent of the broader contact editor so its proof
# obligations stay isolated from unrelated drag, reset and merge policies.
module StudioContactFramePolicy:
    public:
        # Keep typed endpoint edits aligned with the timeline and stack limit.
        const module Domain:
            const MAX_FRAMES: i64 = 10000000

        const enum Endpoint of i64:
            First = 0
            Last = 1

        struct FramePlan:
            # Invalid or inverted drafts preserve the original interval.
            valid: bool
            first: i64
            last: i64

        # Requested frame numbers are 1-based, matching the displayed UI.
        # Invalid clip bounds, target, or inverted ranges are atomic no-ops.
        def plan(first: i64, last: i64, frame_count: i64, target: i64, requested_frame: i64) -> FramePlan:
            requires frame_count >= 1
            requires frame_count <= Domain::MAX_FRAMES
            requires first >= 0
            requires first <= last
            requires last < frame_count
            ensure result.valid == (requested_frame >= 1 and requested_frame <= frame_count and (target == Endpoint.First.i64() and requested_frame - 1 <= last or target == Endpoint.Last.i64() and requested_frame - 1 >= first))
            ensure result.first >= 0
            ensure result.first <= result.last
            ensure result.last < frame_count
            ensure not result.valid or result.first == (requested_frame - 1 if target == Endpoint.First.i64() else first)
            ensure not result.valid or result.last == (requested_frame - 1 if target == Endpoint.Last.i64() else last)
            ensure result.valid or result.first == first
            ensure result.valid or result.last == last
            valid: bool = requested_frame >= 1 and requested_frame <= frame_count and (target == Endpoint.First.i64() and requested_frame - 1 <= last or target == Endpoint.Last.i64() and requested_frame - 1 >= first)
            next_first: i64 = requested_frame - 1 if valid and target == Endpoint.First.i64() else first
            next_last: i64 = requested_frame - 1 if valid and target == Endpoint.Last.i64() else last
            FramePlan{valid: valid, first: next_first, last: next_last}
