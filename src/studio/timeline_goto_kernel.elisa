# Scalar, proof-critical decisions for the Studio timeline Go to frame field.
module StudioTimelineGotoKernel:
    public:
        const MAX_FRAMES: i64 = 10000000

        # Convert a validated 1-based frame number to the internal 0-based
        # frame. Values past the clip select the final frame.
        def bounded_frame(one_based: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= MAX_FRAMES
            requires one_based >= 1
            ensure result >= 0
            ensure result < count
            return count - 1 if one_based > count
            one_based - 1

        # Append one decimal digit to a bounded accumulator. The maximum
        # intermediate is 100000019 because both operands are bounded.
        def digit_step(value: i64, digit: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= MAX_FRAMES
            requires value >= 0
            requires value <= count + 1
            requires digit >= 0
            requires digit <= 9
            ensure result >= 0
            ensure result <= count + 1
            raw: i64 = value * 10 + digit
            return count + 1 if raw > count
            raw
