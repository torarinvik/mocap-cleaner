module StudioExportRecoveryBudgetPolicy:
    public:
        const module Capacity:
            OUTPUT_BYTES: i64 = 67108864
            REPORT_BYTES: i64 = 1048576
            JOURNAL_BYTES: i64 = 65536

        def append_admitted(current: i64, incoming: i64, limit: i64) -> bool:
            ensure result implies current >= 0
            ensure result implies incoming >= 0
            ensure result implies limit > 0 and limit <= Capacity::OUTPUT_BYTES
            ensure result implies current + incoming <= limit
            ensure current >= 0 and incoming >= 0 and limit > 0 and limit <= Capacity::OUTPUT_BYTES and current <= limit and incoming <= limit - current implies result
            current >= 0 and incoming >= 0 and limit > 0 and limit <= Capacity::OUTPUT_BYTES and current <= limit and incoming <= limit - current
