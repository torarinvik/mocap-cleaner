# Pure filter admission for the Studio Storage inventory.
# Cleanup-kind identifiers are shared with the cleanup policy.
include "storage_cleanup_policy.elisa"

module StudioStorageListFilterPolicy:
    public:
        const FILTER_ALL: i64 = 0
        const FILTER_ELIGIBLE: i64 = 1
        const FILTER_PROTECTED: i64 = 2
        const FILTER_RECOVERY: i64 = 3
        const FILTER_TEMP_EXPORT: i64 = 4
        const FILTER_REPORT: i64 = 5
        const FILTER_IN_TRASH: i64 = 6
        const FILTER_COUNT: i64 = 7

        def valid_mode(mode: i64) -> bool:
            ensure result == (mode >= FILTER_ALL and mode < FILTER_COUNT)
            mode >= FILTER_ALL and mode < FILTER_COUNT

        # Invalid saved/UI state recovers to All. Valid modes advance in the
        # declared order and wrap from In Trash back to All.
        def next_mode(mode: i64) -> i64:
            ensure result >= FILTER_ALL and result < FILTER_COUNT
            ensure mode < FILTER_ALL or mode >= FILTER_COUNT or mode == FILTER_COUNT - 1 or result == mode + 1
            ensure mode != FILTER_COUNT - 1 or result == FILTER_ALL
            ensure mode >= FILTER_ALL and mode < FILTER_COUNT or result == FILTER_ALL
            ensure mode != FILTER_ALL or result == FILTER_ELIGIBLE
            ensure mode != FILTER_ELIGIBLE or result == FILTER_PROTECTED
            ensure mode != FILTER_PROTECTED or result == FILTER_RECOVERY
            ensure mode != FILTER_RECOVERY or result == FILTER_TEMP_EXPORT
            ensure mode != FILTER_TEMP_EXPORT or result == FILTER_REPORT
            ensure mode != FILTER_REPORT or result == FILTER_IN_TRASH
            if mode < FILTER_ALL or mode >= FILTER_COUNT:
                return FILTER_ALL
            if mode == FILTER_ALL:
                return FILTER_ELIGIBLE
            if mode == FILTER_ELIGIBLE:
                return FILTER_PROTECTED
            if mode == FILTER_PROTECTED:
                return FILTER_RECOVERY
            if mode == FILTER_RECOVERY:
                return FILTER_TEMP_EXPORT
            if mode == FILTER_TEMP_EXPORT:
                return FILTER_REPORT
            if mode == FILTER_REPORT:
                return FILTER_IN_TRASH
            if mode == FILTER_IN_TRASH:
                return FILTER_ALL
            FILTER_ALL

        # The caller supplies kind, validated Trash status, and current cleanup
        # eligibility from the fresh inventory snapshot.
        def matches(mode: i64, kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure mode != FILTER_ALL or result
            ensure mode != FILTER_ELIGIBLE or result == eligible
            ensure mode != FILTER_PROTECTED or result == (not eligible and not in_trash)
            ensure mode != FILTER_RECOVERY or result == (kind == StudioStorageCleanupPolicy::RECOVERY)
            ensure mode != FILTER_TEMP_EXPORT or result == (kind == StudioStorageCleanupPolicy::TEMP_EXPORT)
            ensure mode != FILTER_REPORT or result == (kind == StudioStorageCleanupPolicy::GENERATED_REPORT)
            ensure mode != FILTER_IN_TRASH or result == in_trash
            ensure mode >= FILTER_ALL and mode < FILTER_COUNT or not result
            if mode == FILTER_ALL:
                return true
            if mode == FILTER_ELIGIBLE:
                return eligible
            if mode == FILTER_PROTECTED:
                return not eligible and not in_trash
            if mode == FILTER_RECOVERY:
                return kind == StudioStorageCleanupPolicy::RECOVERY
            if mode == FILTER_TEMP_EXPORT:
                return kind == StudioStorageCleanupPolicy::TEMP_EXPORT
            if mode == FILTER_REPORT:
                return kind == StudioStorageCleanupPolicy::GENERATED_REPORT
            if mode == FILTER_IN_TRASH:
                return in_trash
            false
