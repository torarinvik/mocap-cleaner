# Pure filter admission for the Studio Storage inventory.
# Cleanup-kind identifiers are shared with the cleanup policy.
include "storage_cleanup_policy.elisa"

module StudioStorageListFilterPolicy:
    public:
        const module Filter:
            ALL: i64 = 0
            ELIGIBLE: i64 = 1
            PROTECTED: i64 = 2
            RECOVERY: i64 = 3
            TEMP_EXPORT: i64 = 4
            REPORT: i64 = 5
            IN_TRASH: i64 = 6
            COUNT: i64 = 7

        def valid_mode(mode: i64) -> bool:
            ensure result == (mode >= Filter::ALL and mode < Filter::COUNT)
            mode >= Filter::ALL and mode < Filter::COUNT

        # Invalid saved/UI state recovers to All. Valid modes advance in the
        # declared order and wrap from In Trash back to All.
        def next_mode(mode: i64) -> i64:
            ensure result >= Filter::ALL and result < Filter::COUNT
            ensure mode < Filter::ALL or mode >= Filter::COUNT or mode == Filter::COUNT - 1 or result == mode + 1
            ensure mode != Filter::COUNT - 1 or result == Filter::ALL
            ensure mode >= Filter::ALL and mode < Filter::COUNT or result == Filter::ALL
            ensure mode != Filter::ALL or result == Filter::ELIGIBLE
            ensure mode != Filter::ELIGIBLE or result == Filter::PROTECTED
            ensure mode != Filter::PROTECTED or result == Filter::RECOVERY
            ensure mode != Filter::RECOVERY or result == Filter::TEMP_EXPORT
            ensure mode != Filter::TEMP_EXPORT or result == Filter::REPORT
            ensure mode != Filter::REPORT or result == Filter::IN_TRASH
            if mode < Filter::ALL or mode >= Filter::COUNT:
                return Filter::ALL
            if mode == Filter::ALL:
                return Filter::ELIGIBLE
            if mode == Filter::ELIGIBLE:
                return Filter::PROTECTED
            if mode == Filter::PROTECTED:
                return Filter::RECOVERY
            if mode == Filter::RECOVERY:
                return Filter::TEMP_EXPORT
            if mode == Filter::TEMP_EXPORT:
                return Filter::REPORT
            if mode == Filter::REPORT:
                return Filter::IN_TRASH
            if mode == Filter::IN_TRASH:
                return Filter::ALL
            Filter::ALL

        # The caller supplies kind, validated Trash status, and current cleanup
        # eligibility from the fresh inventory snapshot.
        def matches(mode: i64, kind: i64, in_trash: bool, eligible: bool) -> bool:
            ensure mode != Filter::ALL or result
            ensure mode != Filter::ELIGIBLE or result == eligible
            ensure mode != Filter::PROTECTED or result == (not eligible and not in_trash)
            ensure mode != Filter::RECOVERY or result == (kind == StudioStorageCleanupPolicy::Kind.Recovery.i64())
            ensure mode != Filter::TEMP_EXPORT or result == (kind == StudioStorageCleanupPolicy::Kind.TempExport.i64())
            ensure mode != Filter::REPORT or result == (kind == StudioStorageCleanupPolicy::Kind.GeneratedReport.i64())
            ensure mode != Filter::IN_TRASH or result == in_trash
            ensure mode >= Filter::ALL and mode < Filter::COUNT or not result
            if mode == Filter::ALL:
                return true
            if mode == Filter::ELIGIBLE:
                return eligible
            if mode == Filter::PROTECTED:
                return not eligible and not in_trash
            if mode == Filter::RECOVERY:
                return kind == StudioStorageCleanupPolicy::Kind.Recovery.i64()
            if mode == Filter::TEMP_EXPORT:
                return kind == StudioStorageCleanupPolicy::Kind.TempExport.i64()
            if mode == Filter::REPORT:
                return kind == StudioStorageCleanupPolicy::Kind.GeneratedReport.i64()
            if mode == Filter::IN_TRASH:
                return in_trash
            false
