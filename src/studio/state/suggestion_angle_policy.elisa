# Admission at the floating-point boundary of hinge preservation measurements.
module StudioSuggestionAnglePolicy:
    public:
        const module Domain:
            MAX_MILLI_DEGREES: i64 = 180000
            MIN_LENGTH: f32 = 0.000001

        def length_admitted(value: f32) -> bool:
            ensure result == (value - value == 0.0 and value > Domain::MIN_LENGTH)
            value - value == 0.0 and value > Domain::MIN_LENGTH

        def cosine_admitted(value: f32) -> bool:
            ensure result == (value - value == 0.0)
            value - value == 0.0

        def denominator_admitted(value: f32) -> bool:
            ensure result == (value - value == 0.0 and value > 0.0)
            value - value == 0.0 and value > 0.0

        def angle_admitted(scaled: f64) -> bool:
            ensure result == (scaled - scaled == 0.0 and scaled >= 0.0 and scaled <= Domain::MAX_MILLI_DEGREES.f64())
            scaled - scaled == 0.0 and scaled >= 0.0 and scaled <= Domain::MAX_MILLI_DEGREES.f64()

        def rounded_angle(scaled: f64) -> i64:
            requires angle_admitted(scaled)
            ensure result >= 0 and result <= Domain::MAX_MILLI_DEGREES
            (scaled + 0.5).i64()
