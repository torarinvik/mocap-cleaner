# The studio's editable operation stack: up to StackPolicy::MAX_OPS operations
# in a fixed array (globals cannot hold darrays in stage1), a count and the
# selected row. Every index decision goes through the proved kernels in
# ../stack_policy.elisa; this module only moves values around.
include "../../ops/stack.elisa"
include "../stack_policy.elisa"
include "../../ops/corrections.elisa"
include "../foot_policy.elisa"

module StackState:
    public:
        const MAX_STRENGTH: i64 = 64
        const MAX_EDGE: i64 = 120
        # Hand contact edits kept per stack (timeline contact-bar edits).
        const MAX_EDITS: i64 = 32
        const LEFT: i64 = 0
        const RIGHT: i64 = 1

        # One hand edit of a foot's contact track: frames [first, last] of
        # `side` forced planted or lifted. Later edits win.
        struct FootEdit:
            side: i64
            first: i64
            last: i64
            planted: bool

        struct Stack:
            ops: mutable Ops::Operation[16]
            count: mutable i64
            selected: mutable i64
            # Keyed gizmo corrections, applied after the operations.
            fixes: mutable Corrections::Correction[16]
            fix_count: mutable i64
            # Foot cleanup (K): planted feet held with a speed-limited carry
            # blended over `blend` frames, after the operations and fixes.
            feet: mutable bool
            blend: mutable i64
            edits: mutable FootEdit[32]
            edit_count: mutable i64

        def empty() -> Stack:
            return Stack{ops: zeroed, count: 0, selected: -1, fixes: zeroed, fix_count: 0, feet: false, blend: StudioFoot::DEFAULT_BLEND, edits: zeroed, edit_count: 0}

        def set_feet(s: mutable Stack&, on: bool) -> bool:
            return false if s.feet == on
            s.feet <- on
            return true

        # Nudge the foot blend one frame up or down (clamped).
        def nudge_blend(s: mutable Stack&, up: bool) -> bool:
            v: i64 = StudioFoot::blend(s.blend)
            n: i64 = StudioFoot::nudge_blend(v, up)
            return false if n == s.blend
            s.blend <- n
            return true

        # Append a contact edit; ignored when full or empty.
        def add_edit(s: mutable Stack&, side: i64, first: i64, last: i64, planted: bool) -> bool:
            return false if s.edit_count < 0 or s.edit_count >= MAX_EDITS
            return false if first > last or first < 0 or (side != LEFT and side != RIGHT)
            s.edits[s.edit_count] <- FootEdit{side: side, first: first, last: last, planted: planted}
            s.edit_count <- s.edit_count + 1
            return true

        # Drop every contact edit.
        def clear_edits(s: mutable Stack&) -> bool:
            return false if s.edit_count <= 0
            s.edit_count <- 0
            return true

        # Apply the edits of `side` (in order) to a detected contact track.
        def apply_edits(s: Stack&, side: i64, flags: mutable darray[bool]&) -> void:
            for i in 0..<s.edit_count |i, s, side, flags|:
                e: FootEdit = s.edits[i]
                continue if e.side != side
                for k in 0..<flags.count |k, e, flags|:
                    f: i64 = k.i64()
                    flags[k] <- e.planted if f >= e.first and f <= e.last else flags[k]
            return

        # Append a keyed correction (ignored when full).
        def add_fix(s: mutable Stack&, fix: Corrections::Correction) -> bool:
            return false if s.fix_count < 0 or s.fix_count >= Corrections::MAX
            s.fixes[s.fix_count] <- fix
            s.fix_count <- s.fix_count + 1
            return true

        # Drop the newest correction.
        def drop_fix(s: mutable Stack&) -> bool:
            return false if s.fix_count <= 0
            s.fix_count <- s.fix_count - 1
            return true

        def valid(s: Stack&, at: i64) -> bool:
            return at >= 0 and at < s.count and s.count <= StackPolicy::MAX_OPS

        # Append `op` (ignored when full) and select it.
        def add(s: mutable Stack&, op: Ops::Operation) -> bool:
            return false if not StackPolicy::can_add(s.count)
            s.ops[s.count] <- op
            s.selected <- s.count
            s.count <- s.count + 1
            return true

        def remove(s: mutable Stack&, at: i64) -> bool:
            return false if not valid(s, at)
            old: Ops::Operation[16] = s.ops
            n: i64 = s.count - 1
            for i in 0..<n |s, old, at|:
                s.ops[i] <- old[StackPolicy::removed_source(i, at)]
            s.selected <- StackPolicy::select_after_remove(s.selected, at, s.count)
            s.count <- n
            return true

        # Move row `at` by `delta` rows; the selection follows it.
        def move(s: mutable Stack&, at: i64, delta: i64) -> bool:
            return false if not valid(s, at)
            d: i64 = -16 if delta < -16 else (16 if delta > 16 else delta)
            dst: i64 = StackPolicy::move_target(at, d, s.count)
            return false if dst == at
            old: Ops::Operation[16] = s.ops
            for i in 0..<s.count |s, old, at, dst|:
                s.ops[i] <- old[StackPolicy::move_source(i, at, dst)]
            s.selected <- dst
            return true

        def toggle(s: mutable Stack&, at: i64) -> bool:
            return false if not valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            op.enabled <- not op.enabled
            s.ops[at] <- op
            return true

        # Scope row `at` to frames [first, last] of a clip of `frames` frames.
        def set_scope(s: mutable Stack&, at: i64, first: i64, last: i64, frames: i64) -> bool:
            return false if not valid(s, at) or frames < 1 or frames > StackPolicy::MAX_FRAMES
            mutable op: Ops::Operation = s.ops[at]
            op.first <- StackPolicy::scope_first(first, frames)
            op.last <- StackPolicy::scope_last(op.first, last, frames)
            s.ops[at] <- op
            return true

        def nudge_strength(s: mutable Stack&, at: i64, delta: i64) -> bool:
            return false if not valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            v: i64 = op.strength if op.strength >= 0 and op.strength <= MAX_STRENGTH else 1
            d: i64 = -MAX_STRENGTH if delta < -MAX_STRENGTH else (MAX_STRENGTH if delta > MAX_STRENGTH else delta)
            op.strength <- StackPolicy::nudge(v, d, 1, MAX_STRENGTH)
            s.ops[at] <- op
            return true

        def cycle_bones(s: mutable Stack&, at: i64) -> bool:
            return false if not valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            op.bones <- StackPolicy::next_mask(op.bones)
            s.ops[at] <- op
            return true

        def select(s: mutable Stack&, at: i64) -> void:
            s.selected <- at if valid(s, at) else -1
            return

        # The enabled-and-disabled list in order, for Ops::evaluate.
        def operations(s: Stack&) -> darray[Ops::Operation]:
            out: mutable darray[Ops::Operation] = []
            for i in 0..<s.count |s, out|:
                out.push(s.ops[i])
            return out

        def from_list(list: darray[Ops::Operation]&) -> Stack:
            mutable s: Stack = empty()
            for op in list |op, s|:
                _ = add(&s, op)
            s.selected <- -1 if s.count == 0 else 0
            return s

        def same(a: Stack&, b: Stack&) -> bool:
            return false if a.count != b.count or a.fix_count != b.fix_count
            return false if a.feet != b.feet or a.blend != b.blend or a.edit_count != b.edit_count
            for i in 0..<a.edit_count |a, b|:
                e: FootEdit = a.edits[i]
                g: FootEdit = b.edits[i]
                return false if e.side != g.side or e.first != g.first or e.last != g.last or e.planted != g.planted
            for i in 0..<a.fix_count |a, b|:
                p: Corrections::Correction = a.fixes[i]
                q: Corrections::Correction = b.fixes[i]
                return false if not Corrections::same(&p, &q)
            for i in 0..<a.count |a, b|:
                x: Ops::Operation = a.ops[i]
                y: Ops::Operation = b.ops[i]
                return false if x.kind != y.kind or x.enabled != y.enabled or x.first != y.first
                return false if x.last != y.last or x.bones != y.bones or x.strength != y.strength or x.edge != y.edge
            return true

        def kind_label(k: Ops::Kind) -> sview:
            return "Despike" if k == Ops::Kind.Despike
            return "Pin contacts" if k == Ops::Kind.PinContacts
            return "Close seam" if k == Ops::Kind.CloseSeam
            return "Smooth path" if k == Ops::Kind.SmoothPath
            return "Limit wring" if k == Ops::Kind.LimitWring
            return "Median"

        def bones_label(mask: i64) -> sview:
            return "all bones" if mask == -1
            return "legs" if mask == 2
            return "upper body" if mask == 1
            return "custom"
