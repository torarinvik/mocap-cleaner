# The studio's editable operation stack: up to StackPolicy::Limit::MAX_OPS operations
# in a fixed array (globals cannot hold darrays in stage1), a count and the
# selected row. Every index decision goes through the proved kernels in
# ../stack_policy.elisa; this module only moves values around.
include "../../ops/stack.elisa"
include "../stack_policy.elisa"
include "../operation_duplicate_policy.elisa"
include "../../ops/corrections.elisa"
include "../foot_policy.elisa"
include "../contact_editor.elisa"
include "../../core/retime.elisa"

module StackState:
    public:
        const MAX_STRENGTH: i64 = 64
        const MAX_EDGE: i64 = 120
        # Hand contact edits kept per stack (timeline contact-bar edits).
        const MAX_EDITS: i64 = StudioContactEditor::MAX_EDITS
        const LEFT: i64 = 0
        const RIGHT: i64 = 1
        const LEFT_HAND: i64 = 2
        const RIGHT_HAND: i64 = 3

        # One hand edit of a foot's contact track: frames [first, last] of
        # `side` forced planted or lifted. Later edits win.
        struct FootEdit:
            side: i64
            first: i64
            last: i64
            planted: bool

        # One retime band: source frames [first, last] played at `speed`
        # permille, eased over `blend` frames. Bands never overlap.
        struct Band:
            first: mutable i64
            last: mutable i64
            speed: mutable i64
            blend: mutable i64
            enabled: mutable bool

        const MAX_BANDS: i64 = 8

        struct Stack:
            ops: mutable Ops::Operation[16]
            count: mutable i64
            selected: mutable i64
            # Keyed gizmo corrections, applied after the operations.
            fixes: mutable Corrections::Correction[16]
            fix_count: mutable i64
            # Foot cleanup (K): planted feet held with a speed-limited carry
            # blended over `blend` frames, after the operations and fixes.
            feet: mutable bool
            # Hand cleanup is opt-in and shares the carry blend.
            hands: mutable bool
            blend: mutable i64
            edits: mutable FootEdit[32]
            edit_count: mutable i64
            # Retime bands (source frames, speed in permille), applied last.
            bands: mutable Band[8]
            band_count: mutable i64

        def empty() -> Stack:
            return Stack{ops: zeroed, count: 0, selected: -1, fixes: zeroed, fix_count: 0, feet: false, hands: false, blend: StudioFoot::Blend::DEFAULT, edits: zeroed, edit_count: 0, bands: zeroed, band_count: 0}

        def set_feet(s: mutable Stack&, on: bool) -> bool:
            return false if s.feet == on
            s.feet <- on
            return true

        def set_hands(s: mutable Stack&, on: bool) -> bool:
            return false if s.hands == on
            s.hands <- on
            return true

        # Nudge the foot blend one frame up or down (clamped).
        def nudge_blend(s: mutable Stack&, up: bool) -> bool:
            v: i64 = StudioFoot::blend(s.blend)
            n: i64 = StudioFoot::nudge_blend(v, up)
            return false if n == s.blend
            s.blend <- n
            return true

        # Append a contact edit; ignored when full or empty.
        def add_edit(s: mutable Stack&, side: i64, first: i64, last: i64, planted: bool) -> bool:
            return false if s.edit_count < 0 or s.edit_count >= MAX_EDITS
            return false if first > last or first < 0 or last >= StudioContactEditor::MAX_FRAMES or side < LEFT or side > RIGHT_HAND
            s.edits[s.edit_count] <- FootEdit{side: side, first: first, last: last, planted: planted}
            s.edit_count <- s.edit_count + 1
            return true

        # Return the newest authored interval containing this frame. Later
        # edits win, so deleting this entry reveals the previous authored or
        # detected state for its full interval.
        def edit_index_at(s: Stack&, side: i64, frame: i64) -> i64:
            requires s.edit_count >= 0
            requires s.edit_count <= MAX_EDITS
            ensure result >= -1
            ensure result < s.edit_count
            mutable found: i64 = -1
            for i in 0..<s.edit_count |i, s, side, frame, found|:
                e: FootEdit = s.edits[i]
                found <- i if e.side == side and frame >= e.first and frame <= e.last
            found

        # Return the neighboring stack index that can merge with `index`.
        # Prefer the following entry so repeated Merge presses walk forward.
        def merge_neighbor_index(s: Stack&, index: i64) -> i64:
            requires s.edit_count >= 0
            requires s.edit_count <= MAX_EDITS
            ensure result >= -1
            ensure result < s.edit_count
            return -1 if index < 0 or index >= s.edit_count
            current: FootEdit = s.edits[index]
            if index + 1 < s.edit_count:
                following: FootEdit = s.edits[index + 1]
                next_plan: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(current.side, current.first, current.last, current.planted, following.side, following.first, following.last, following.planted)
                return index + 1 if next_plan.valid
            if index > 0:
                previous: FootEdit = s.edits[index - 1]
                previous_plan: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(previous.side, previous.first, previous.last, previous.planted, current.side, current.first, current.last, current.planted)
                return index - 1 if previous_plan.valid
            -1

        def remove_edit_index(s: mutable Stack&, removed: i64) -> bool:
            return false if s.edit_count <= 0 or s.edit_count > MAX_EDITS or removed < 0 or removed >= s.edit_count
            old_count: i64 = s.edit_count
            for i in 0..<(old_count - 1) |i, s, removed, old_count|:
                source: i64 = StudioContactEditor::delete_source_index(i, removed, old_count)
                s.edits[i] <- s.edits[source]
            s.edit_count <- old_count - 1
            true

        def can_merge_edit_at(s: Stack&, side: i64, frame: i64) -> bool:
            requires s.edit_count >= 0
            requires s.edit_count <= MAX_EDITS
            index: i64 = edit_index_at(s, side, frame)
            index >= 0 and merge_neighbor_index(s, index) >= 0

        def can_split_edit_at(s: Stack&, side: i64, frame: i64) -> bool:
            requires s.edit_count >= 0
            requires s.edit_count <= MAX_EDITS
            return false if s.edit_count >= MAX_EDITS or side < LEFT or side > RIGHT_HAND or frame < 0 or frame >= StudioContactEditor::MAX_FRAMES
            index: i64 = edit_index_at(s, side, frame)
            return false if index < 0
            e: FootEdit = s.edits[index]
            StudioContactEditor::split_plan(e.first, e.last, frame).valid

        # Split the newest interval at the boundary immediately before the
        # selected frame. A temporary list makes capacity and construction
        # atomic; later edits remain later and keep precedence.
        def split_edit_at(s: mutable Stack&, side: i64, frame: i64) -> bool:
            return false if s.edit_count < 1 or s.edit_count >= MAX_EDITS or s.edit_count > MAX_EDITS
            return false if side < LEFT or side > RIGHT_HAND or frame < 0 or frame >= StudioContactEditor::MAX_FRAMES
            selected: i64 = edit_index_at(s, side, frame)
            return false if selected < 0
            original: FootEdit = s.edits[selected]
            plan: StudioContactEditor::SplitPlan = StudioContactEditor::split_plan(original.first, original.last, frame)
            return false if not plan.valid
            mutable next: FootEdit[32] = zeroed
            mutable target: i64 = 0
            for i in 0..<s.edit_count |i, s, selected, original, plan, next, target|:
                e: FootEdit = s.edits[i]
                if i == selected:
                    next[target] <- FootEdit{side: original.side, first: original.first, last: plan.left_last, planted: original.planted}
                    target <- target + 1
                    next[target] <- FootEdit{side: original.side, first: plan.right_first, last: original.last, planted: original.planted}
                    target <- target + 1
                else:
                    next[target] <- e
                    target <- target + 1
            for i in 0..<(s.edit_count + 1) |i, s, next|:
                s.edits[i] <- next[i]
            s.edit_count <- s.edit_count + 1
            true

        # Consolidate the selected newest authored interval with one directly
        # adjacent interval of the same side and state. Preserve list order so
        # all older and newer overrides retain their meaning.
        def merge_edit_at(s: mutable Stack&, side: i64, frame: i64) -> bool:
            return false if s.edit_count <= 1 or s.edit_count > MAX_EDITS
            return false if side < LEFT or side > RIGHT_HAND or frame < 0 or frame >= StudioContactEditor::MAX_FRAMES
            selected: i64 = edit_index_at(s, side, frame)
            return false if selected < 0
            neighbor: i64 = merge_neighbor_index(s, selected)
            return false if neighbor < 0
            keep: i64 = selected if selected < neighbor else neighbor
            removed: i64 = neighbor if selected < neighbor else selected
            a: FootEdit = s.edits[keep]
            b: FootEdit = s.edits[removed]
            plan: StudioContactEditor::MergePlan = StudioContactEditor::merge_plan(a.side, a.first, a.last, a.planted, b.side, b.first, b.last, b.planted)
            return false if not plan.valid
            s.edits[keep] <- FootEdit{side: a.side, first: plan.first, last: plan.last, planted: a.planted}
            remove_edit_index(s, removed)

        # Delete the newest authored interval at the selected frame. Removing
        # the whole interval is explicit and undoable; it does not split the
        # underlying edit or disturb neighboring entries.
        def delete_edit_at(s: mutable Stack&, side: i64, frame: i64) -> bool:
            return false if s.edit_count <= 0 or s.edit_count > MAX_EDITS
            return false if side < LEFT or side > RIGHT_HAND or frame < 0 or frame >= StudioContactEditor::MAX_FRAMES
            removed: i64 = edit_index_at(s, side, frame)
            return false if removed < 0
            remove_edit_index(s, removed)

        def has_edit_at(s: Stack&, side: i64, frame: i64) -> bool:
            edit_index_at(s, side, frame) >= 0

        # Remove one output frame from every authored edit for this side.
        # Splitting each affected range preserves its order, so later edits
        # continue to win on every frame except the one reset to detection.
        def reset_edit_at(s: mutable Stack&, side: i64, frame: i64) -> bool:
            return false if s.edit_count < 0 or s.edit_count > MAX_EDITS
            return false if side < LEFT or side > RIGHT_HAND or frame < 0 or frame >= StudioContactEditor::MAX_FRAMES
            mutable next: FootEdit[32] = zeroed
            mutable next_count: i64 = 0
            mutable changed: bool = false
            for i in 0..<s.edit_count |i, s, side, frame, next, next_count, changed|:
                e: FootEdit = s.edits[i]
                if e.side == side and frame >= e.first and frame <= e.last:
                    changed <- true
                    p: StudioContactEditor::ResetPlan = StudioContactEditor::reset_interval(e.first, e.last, frame)
                    if p.count >= 1:
                        return false if next_count >= MAX_EDITS
                        next[next_count] <- FootEdit{side: e.side, first: p.left_first, last: p.left_end - 1, planted: e.planted}
                        next_count <- next_count + 1
                    if p.count == 2:
                        return false if next_count >= MAX_EDITS
                        next[next_count] <- FootEdit{side: e.side, first: p.right_first, last: p.right_end - 1, planted: e.planted}
                        next_count <- next_count + 1
                else:
                    return false if next_count >= MAX_EDITS
                    next[next_count] <- e
                    next_count <- next_count + 1
            return false if not changed
            for i in 0..<MAX_EDITS |i, s, next|:
                s.edits[i] <- next[i]
            s.edit_count <- next_count
            return true

        # Drop every contact edit.
        def clear_edits(s: mutable Stack&) -> bool:
            return false if s.edit_count <= 0
            s.edit_count <- 0
            return true

        # Drop all authored local pose corrections in one stack mutation.
        def clear_fixes(s: mutable Stack&) -> bool:
            return false if s.fix_count <= 0
            s.fix_count <- 0
            return true

        def has_cleanup(s: Stack&) -> bool:
            s.count > 0 or s.fix_count > 0 or s.feet or s.hands or s.blend != StudioFoot::Blend::DEFAULT or s.edit_count > 0 or s.band_count > 0

        # Restore the source animation result: no cleanup operations, pose
        # corrections, contact overrides, locks, or retime bands. The retained
        # blend value is the valid empty-stack default used by empty(). The
        # caller records this whole-stack change once in HistoryState.
        def reset_to_source(s: mutable Stack&) -> bool:
            changed: bool = has_cleanup(s)
            return false if not changed
            s.count <- 0
            s.selected <- -1
            s.fix_count <- 0
            s.feet <- false
            s.hands <- false
            s.blend <- StudioFoot::Blend::DEFAULT
            s.edit_count <- 0
            s.band_count <- 0
            true

        # Apply the edits of `side` (in order) to a detected contact track.
        def apply_edits(s: Stack&, side: i64, flags: mutable darray[bool]&) -> void:
            for i in 0..<s.edit_count |i, s, side, flags|:
                e: FootEdit = s.edits[i]
                continue if e.side != side
                for k in 0..<flags.count |k, e, flags|:
                    f: i64 = k.i64()
                    flags[k] <- e.planted if f >= e.first and f <= e.last else flags[k]
            return

        # Index of the band holding source frame `frame`, or -1.
        def band_at(s: Stack&, frame: i64) -> i64:
            for i in 0..<s.band_count |i, s, frame|:
                b: Band = s.bands[i]
                return i if frame >= b.first and frame <= b.last
            return -1

        # Whether [first, last] fits in a clip of `frames` frames without
        # overlapping any band but `skip`.
        def band_fits(s: Stack&, first: i64, last: i64, frames: i64, skip: i64) -> bool:
            return false if frames < 0 or frames > Retime::Domain::MAX_FRAMES
            return false if not Retime::range_ok(first, last, frames)
            for i in 0..<s.band_count |i, s, first, last, skip|:
                b: Band = s.bands[i]
                return false if i != skip and not Retime::disjoint(b.first, b.last, first, last)
            return true

        # Add a band (speed clamped); false when full, malformed or overlapping.
        def add_band(s: mutable Stack&, first: i64, last: i64, speed: i64, frames: i64) -> bool:
            return false if s.band_count < 0 or s.band_count >= MAX_BANDS
            return false if not band_fits(s, first, last, frames, -1)
            s.bands[s.band_count] <- Band{first: first, last: last, speed: Retime::clamp_speed(speed), blend: Retime::Defaults::DEFAULT_BLEND, enabled: true}
            s.band_count <- s.band_count + 1
            return true

        def set_band_speed(s: mutable Stack&, at: i64, speed: i64) -> bool:
            return false if at < 0 or at >= s.band_count or at >= MAX_BANDS
            mutable b: Band = s.bands[at]
            v: i64 = Retime::clamp_speed(speed)
            return false if v == b.speed
            b.speed <- v
            s.bands[at] <- b
            return true

        # Move a band's start (`last_edge` false) or end edge to `frame`.
        def move_band_edge(s: mutable Stack&, at: i64, last_edge: bool, frame: i64, frames: i64) -> bool:
            return false if at < 0 or at >= s.band_count or at >= MAX_BANDS
            mutable b: Band = s.bands[at]
            first: i64 = b.first if last_edge else frame
            last: i64 = frame if last_edge else b.last
            return false if first == b.first and last == b.last
            return false if not band_fits(s, first, last, frames, at)
            b.first <- first
            b.last <- last
            s.bands[at] <- b
            return true

        def toggle_band(s: mutable Stack&, at: i64) -> bool:
            return false if at < 0 or at >= s.band_count or at >= MAX_BANDS
            mutable b: Band = s.bands[at]
            b.enabled <- not b.enabled
            s.bands[at] <- b
            return true

        def remove_band(s: mutable Stack&, at: i64) -> bool:
            return false if at < 0 or at >= s.band_count or at >= MAX_BANDS
            for i in at..<(s.band_count - 1) |i, s|:
                s.bands[i] <- s.bands[i + 1]
            s.band_count <- s.band_count - 1
            return true

        # Append a keyed correction (ignored when full).
        def add_fix(s: mutable Stack&, fix: Corrections::Correction) -> bool:
            return false if s.fix_count < 0 or s.fix_count >= Corrections::MAX
            s.fixes[s.fix_count] <- fix
            s.fix_count <- s.fix_count + 1
            return true

        # Drop the newest correction.
        def drop_fix(s: mutable Stack&) -> bool:
            return false if s.fix_count <= 0
            s.fix_count <- s.fix_count - 1
            return true

        def valid(s: Stack&, at: i64) -> bool:
            return at >= 0 and at < s.count and s.count <= StackPolicy::Limit::MAX_OPS

        # Append `op` (ignored when full) and select it.
        def add(s: mutable Stack&, op: Ops::Operation) -> bool:
            return false if not StackPolicy::can_add(s.count)
            s.ops[s.count] <- op
            s.selected <- s.count
            s.count <- s.count + 1
            return true

        # Insert an exact copy of the selected operation immediately after it.
        # All preconditions are checked before writes; full or invalid stacks
        # are unchanged on failure. The caller records this as one snapshot.
        def duplicate_selected(s: mutable Stack&) -> bool:
            return false if not StudioOperationDuplicatePolicy::available(s.count, s.selected)
            source: i64 = s.selected
            target: i64 = StudioOperationDuplicatePolicy::target(source, s.count)
            old: Ops::Operation[16] = s.ops
            for i in 0..<(s.count + 1) |s, old, source, target|:
                s.ops[i] <- old[StudioOperationDuplicatePolicy::source(i, source, s.count)]
            s.count <- s.count + 1
            s.selected <- target
            true

        def remove(s: mutable Stack&, at: i64) -> bool:
            return false if not valid(s, at)
            old: Ops::Operation[16] = s.ops
            n: i64 = s.count - 1
            for i in 0..<n |s, old, at|:
                s.ops[i] <- old[StackPolicy::removed_source(i, at)]
            s.selected <- StackPolicy::select_after_remove(s.selected, at, s.count)
            s.count <- n
            return true

        # Move row `at` by `delta` rows; the selection follows it.
        def move(s: mutable Stack&, at: i64, delta: i64) -> bool:
            return false if not valid(s, at)
            d: i64 = -16 if delta < -16 else (16 if delta > 16 else delta)
            dst: i64 = StackPolicy::move_target(at, d, s.count)
            return false if dst == at
            old: Ops::Operation[16] = s.ops
            for i in 0..<s.count |s, old, at, dst|:
                s.ops[i] <- old[StackPolicy::move_source(i, at, dst)]
            s.selected <- dst
            return true

        def toggle(s: mutable Stack&, at: i64) -> bool:
            return false if not valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            op.enabled <- not op.enabled
            s.ops[at] <- op
            return true

        # Scope row `at` to frames [first, last] of a clip of `frames` frames.
        def set_scope(s: mutable Stack&, at: i64, first: i64, last: i64, frames: i64) -> bool:
            return false if not valid(s, at) or frames < 1 or frames > StackPolicy::Limit::MAX_FRAMES
            mutable op: Ops::Operation = s.ops[at]
            op.first <- StackPolicy::scope_first(first, frames)
            op.last <- StackPolicy::scope_last(op.first, last, frames)
            s.ops[at] <- op
            return true

        def nudge_strength(s: mutable Stack&, at: i64, delta: i64) -> bool:
            return false if not valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            v: i64 = op.strength if op.strength >= 0 and op.strength <= MAX_STRENGTH else 1
            d: i64 = -MAX_STRENGTH if delta < -MAX_STRENGTH else (MAX_STRENGTH if delta > MAX_STRENGTH else delta)
            op.strength <- StackPolicy::nudge(v, d, 1, MAX_STRENGTH)
            s.ops[at] <- op
            return true

        def cycle_bones(s: mutable Stack&, at: i64) -> bool:
            return false if not valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            op.bones <- StackPolicy::next_mask(op.bones)
            s.ops[at] <- op
            return true

        def select(s: mutable Stack&, at: i64) -> void:
            s.selected <- at if valid(s, at) else -1
            return

        # The enabled-and-disabled list in order, for Ops::evaluate.
        def operations(s: Stack&) -> darray[Ops::Operation]:
            out: mutable darray[Ops::Operation] = []
            for i in 0..<s.count |s, out|:
                out.push(s.ops[i])
            return out

        def from_list(list: darray[Ops::Operation]&) -> Stack:
            mutable s: Stack = empty()
            for op in list |op, s|:
                _ = add(&s, op)
            s.selected <- -1 if s.count == 0 else 0
            return s

        def same(a: Stack&, b: Stack&) -> bool:
            return false if a.count != b.count or a.fix_count != b.fix_count
            return false if a.feet != b.feet or a.hands != b.hands or a.blend != b.blend or a.edit_count != b.edit_count
            return false if a.band_count != b.band_count
            for i in 0..<a.band_count |a, b|:
                u: Band = a.bands[i]
                v: Band = b.bands[i]
                return false if u.first != v.first or u.last != v.last or u.speed != v.speed or u.blend != v.blend or u.enabled != v.enabled
            for i in 0..<a.edit_count |a, b|:
                e: FootEdit = a.edits[i]
                g: FootEdit = b.edits[i]
                return false if e.side != g.side or e.first != g.first or e.last != g.last or e.planted != g.planted
            for i in 0..<a.fix_count |a, b|:
                p: Corrections::Correction = a.fixes[i]
                q: Corrections::Correction = b.fixes[i]
                return false if not Corrections::same(&p, &q)
            for i in 0..<a.count |a, b|:
                x: Ops::Operation = a.ops[i]
                y: Ops::Operation = b.ops[i]
                return false if x.kind != y.kind or x.enabled != y.enabled or x.first != y.first
                return false if x.last != y.last or x.bones != y.bones or x.strength != y.strength or x.edge != y.edge
            return true

        # Whether channel cleanup and gizmo corrections leave the same source
        # for the downstream rig cache. Contacts, lock toggles, blend and
        # retime bands do not change this pre-rig source.
        def same_rig_source(a: Stack&, b: Stack&) -> bool:
            return false if a.count != b.count or a.fix_count != b.fix_count
            for i in 0..<a.fix_count |a, b|:
                p: Corrections::Correction = a.fixes[i]
                q: Corrections::Correction = b.fixes[i]
                return false if not Corrections::same(&p, &q)
            for i in 0..<a.count |a, b|:
                x: Ops::Operation = a.ops[i]
                y: Ops::Operation = b.ops[i]
                return false if x.kind != y.kind or x.enabled != y.enabled or x.first != y.first
                return false if x.last != y.last or x.bones != y.bones or x.strength != y.strength or x.edge != y.edge
            return true

        def kind_label(k: Ops::Kind) -> sview:
            return "Despike" if k == Ops::Kind.Despike
            return "Pin contacts" if k == Ops::Kind.PinContacts
            return "Close seam" if k == Ops::Kind.CloseSeam
            return "Smooth path" if k == Ops::Kind.SmoothPath
            return "Limit wring" if k == Ops::Kind.LimitWring
            return "Median"

        def bones_label(mask: i64) -> sview:
            return "all bones" if mask == -1
            return "legs" if mask == 2
            return "upper body" if mask == 1
            return "custom"
