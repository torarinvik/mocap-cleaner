include "generation_handle_policy.elisa"

module StudioGenerationMoveReplyDisposalPolicy:
    def may_discard(published: bool, recorded: bool, remaining_handle: i64,
                    release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
        ensure result == (published and recorded and remaining_handle == 0 and StudioGenerationHandlePolicy::release_certain(release))
        published and recorded and remaining_handle == 0 and StudioGenerationHandlePolicy::release_certain(release)
