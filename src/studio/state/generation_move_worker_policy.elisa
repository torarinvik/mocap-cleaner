include "generation_handle_policy.elisa"
include "generation_receipt_control_policy.elisa"

module StudioGenerationMoveWorkerPolicy:
    public:
        struct Intent:
            status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            phase: StudioBuildGenerationTrashBindingPolicy::DecodedPhase
            durable: StudioBuildGenerationTrashBindingPolicy::DecodedBoolean
            reserved: StudioBuildGenerationTrashBindingPolicy::DecodedBoolean
            operation_id_valid: bool
            operation_id_bytes: i64
            receipt_bytes: i64
            scope: StudioGenerationReceiptControlPolicy::Evidence

        def may_commit(intent: Intent) -> bool:
            ensure result == (intent.status.known and intent.status.status == StudioBuildGenerationTrashNative::Status.Acquired and intent.phase.known and intent.phase.phase == StudioBuildGenerationTrashPolicy::Phase.Intent and intent.durable.valid and intent.durable.value and intent.reserved.valid and intent.reserved.value and intent.operation_id_valid and intent.operation_id_bytes > 0 and intent.operation_id_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES and intent.receipt_bytes > 0 and intent.receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and intent.scope == StudioGenerationReceiptControlPolicy::Evidence.ReviewedControls)
            intent.status.known and intent.status.status == StudioBuildGenerationTrashNative::Status.Acquired and intent.phase.known and intent.phase.phase == StudioBuildGenerationTrashPolicy::Phase.Intent and intent.durable.valid and intent.durable.value and intent.reserved.valid and intent.reserved.value and intent.operation_id_valid and intent.operation_id_bytes > 0 and intent.operation_id_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES and intent.receipt_bytes > 0 and intent.receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and intent.scope == StudioGenerationReceiptControlPolicy::Evidence.ReviewedControls

        def recoverable(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                        release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                        recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome,
                        details_valid: bool, remaining_handle: i64) -> bool:
            ensure result == (commit.known and (commit.status == StudioBuildGenerationTrashNative::Status.Moved or commit.status == StudioBuildGenerationTrashNative::Status.DurabilityUnknown) and StudioGenerationHandlePolicy::release_certain(release) and recovery == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined and details_valid and remaining_handle == 0)
            commit.known and (commit.status == StudioBuildGenerationTrashNative::Status.Moved or commit.status == StudioBuildGenerationTrashNative::Status.DurabilityUnknown) and StudioGenerationHandlePolicy::release_certain(release) and recovery == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined and details_valid and remaining_handle == 0
