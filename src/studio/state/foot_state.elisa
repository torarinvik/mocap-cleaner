# Timeline contact-bar editing: what a press on a limb's contact row grabs,
# and the hand edit a release records in the stack. Every decision (grab,
# drag clamps, edit range, planted/lifted, new span) goes through the proved
# kernels in ../foot_policy.elisa; this module walks the runs and moves
# values around, so it runs headless (test/studio_foot.elisa).
include "stack_state.elisa"
include "timeline_state.elisa"

module FootState:
    public:
        # A press on a contact row: which side, what it grabbed
        # (StudioFoot::ContactPart::NONE/FIRST/LAST/BODY), the grabbed run's ends and the
        # frame under the press.
        struct Press:
            side: mutable i64
            part: mutable i64
            first: mutable i64
            last: mutable i64
            frame: mutable i64

        def idle() -> Press:
            return Press{side: -1, part: StudioFoot::ContactPart::NONE, first: -1, last: -1, frame: -1}

        def active(p: Press&) -> bool:
            return p.side >= StackState::ContactSide.LeftFoot.i64() and p.side <= StackState::ContactSide.RightHand.i64()

        # Pixel of the left edge of `frame` in a strip `width` pixels wide;
        # frames at or past the end map to `width`.
        def x_of(frame: i64, width: i64, count: i64) -> i64:
            return 0 if frame <= 0
            return width if frame >= count
            return Timeline::x_of_frame(frame, width, count)

        # What a press `x` pixels into a strip `width` wide grabs on `flags`.
        def press(flags: darray[bool]&, side: i64, x: i64, width: i64) -> Press:
            n: i64 = flags.count.i64()
            mutable p: Press = idle()
            return p if n < 1 or width < 1 or width > Timeline::Domain::MAX_PIXELS or n > StudioFoot::FrameRange::MAX_FRAMES
            p.side <- side
            p.frame <- Timeline::frame_at_x(x, width, n)
            mutable run: i64 = -1
            for f in 0..<(n + 1) |f, n, flags, run, p, x, width|:
                down: bool = f < n and flags[f.usize()]
                if down and run < 0:
                    run <- f
                if not down and run >= 0:
                    x0: i64 = x_of(run, width, n)
                    x1: i64 = x_of(f, width, n)
                    part: i64 = StudioFoot::grab(x, x0, x1)
                    if part != StudioFoot::ContactPart::NONE and p.part == StudioFoot::ContactPart::NONE:
                        p.part <- part
                        p.first <- run
                        p.last <- f - 1
                    run <- -1
            return p

        # The frame a dragged end lands on.
        def landed(p: Press&, frame: i64, frames: i64) -> i64:
            return StudioFoot::drag_first(frame, p.last) if p.part == StudioFoot::ContactPart::FIRST
            return StudioFoot::drag_last(frame, p.first, frames)

        # Record the edit of a press released over `frame`: a dragged end
        # plants or lifts the frames it swept; a click on a run lifts it; a
        # click off every run plants a new StudioFoot::ContactRow::NEW_SPAN span. False
        # when nothing changed.
        def release(s: mutable StackState::Stack&, p: Press&, frame: i64, frames: i64) -> bool:
            return false if not active(p) or frames < 1 or frames > StudioFoot::FrameRange::MAX_FRAMES
            f: i64 = 0 if frame < 0 else (frames - 1 if frame >= frames else frame)
            if p.part == StudioFoot::ContactPart::NONE:
                first: i64 = StudioFoot::new_first(f, frames)
                return StackState::add_edit(s, p.side, first, StudioFoot::new_last(first, frames), true)
            return false if p.first < 0 or p.last < p.first or p.last >= frames
            if p.part == StudioFoot::ContactPart::BODY or f == p.frame:
                return StackState::add_edit(s, p.side, p.first, p.last, false)
            is_first: bool = p.part == StudioFoot::ContactPart::FIRST
            old: i64 = p.first if is_first else p.last
            moved_to: i64 = landed(p, f, frames)
            return false if not StudioFoot::moved(old, moved_to)
            lo: i64 = StudioFoot::edit_lo(is_first, old, moved_to)
            hi: i64 = StudioFoot::edit_hi(is_first, old, moved_to)
            return StackState::add_edit(s, p.side, lo, hi, StudioFoot::edit_planted(is_first, old, moved_to))

        # Frames over StudioFoot::Metric::MARK_SLIDE per-frame slide.
        def marks(slide: darray[i64]&) -> i64:
            mutable n: i64 = 0
            for v in slide |v, n|:
                n <- n + 1 if StudioFoot::marked(v) else n
            return n
