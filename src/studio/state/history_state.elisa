# Undo/redo over the operation stack: a ring of whole-stack snapshots driven
# by the proved cursor policy in ../history.elisa.
include "stack_state.elisa"
include "../history.elisa"

module HistoryState:
    public:
        const CAPACITY: i64 = 64

        struct History:
            states: mutable StackState::Stack[64]
            cursor: mutable i64
            count: mutable i64
            saved_cursor: mutable i64
            saved_valid: mutable bool

        # Reset in place; History (64 stacks) is never copied by value.
        def reset(h: mutable History&, initial: StackState::Stack) -> void:
            h.cursor <- 0
            h.count <- 1
            h.saved_cursor <- 0
            h.saved_valid <- true
            h.states[0] <- initial

        # The current stack has just been persisted successfully.
        def mark_saved(h: mutable History&) -> void:
            h.saved_cursor <- h.cursor
            h.saved_valid <- true

        def dirty(h: History&) -> bool:
            HistoryPolicy::dirty(h.cursor, h.saved_cursor, h.saved_valid)

        def current(h: History&) -> StackState::Stack:
            return h.states[h.cursor]

        # Read the snapshot undo would select without moving the history cursor.
        def undo_target(h: History&) -> StackState::Stack?:
            ensure result == null or (h.count >= 1 and h.count <= CAPACITY and h.cursor >= 1 and h.cursor < h.count)
            ensure (h.count < 1 or h.count > CAPACITY or h.cursor < 1 or h.cursor >= h.count) or result != null
            return null if h.count < 1 or h.count > CAPACITY or h.cursor < 1 or h.cursor >= h.count
            h.states[h.cursor - 1]

        # Read the snapshot redo would select without moving the history cursor.
        def redo_target(h: History&) -> StackState::Stack?:
            ensure result == null or (h.count >= 1 and h.count <= CAPACITY and h.cursor >= 0 and h.cursor < h.count - 1)
            ensure (h.count < 1 or h.count > CAPACITY or h.cursor < 0 or h.cursor >= h.count - 1) or result != null
            return null if h.count < 1 or h.count > CAPACITY or h.cursor < 0 or h.cursor >= h.count - 1
            h.states[h.cursor + 1]

        # Record `s` as the newest snapshot (no-op when it equals the current one).
        def record(h: mutable History&, s: StackState::Stack) -> bool:
            cur: StackState::Stack = h.states[h.cursor]
            return false if StackState::same(cur, s)
            shift: i64 = HistoryPolicy::push_shift(h.cursor, CAPACITY)
            saved: i64 = HistoryPolicy::saved_after_record(h.saved_cursor, h.saved_valid, h.cursor, shift)
            if shift == 1:
                for i in 1..<CAPACITY |h|:
                    h.states[i - 1] <- h.states[i]
            c: i64 = HistoryPolicy::push_cursor(h.cursor, CAPACITY)
            h.count <- HistoryPolicy::push_count(h.cursor, CAPACITY)
            h.cursor <- c
            h.saved_cursor <- saved
            h.saved_valid <- saved >= 0
            h.states[c] <- s
            return true

        def undo(h: mutable History&) -> bool:
            return false if not HistoryPolicy::can_undo(h.cursor)
            h.cursor <- HistoryPolicy::undo(h.cursor, h.count)
            return true

        def redo(h: mutable History&) -> bool:
            return false if not HistoryPolicy::can_redo(h.cursor, h.count)
            h.cursor <- HistoryPolicy::redo(h.cursor, h.count)
            return true
