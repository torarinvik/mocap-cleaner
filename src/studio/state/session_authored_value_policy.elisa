include "../chrome.elisa"
include "../foot_policy.elisa"

module SessionAuthoredValuePolicy:
    public:
        def enabled_valid(value: i64) -> bool:
            ensure result == (value == 0 or value == 1)
            value == 0 or value == 1

        def blend_valid(value: i64) -> bool:
            ensure result == (value >= StudioFoot::Blend::MIN and value <= StudioFoot::Blend::MAX)
            value >= StudioFoot::Blend::MIN and value <= StudioFoot::Blend::MAX

        def interval_valid(first: i64, last: i64, frames: i64) -> bool:
            ensure result == (frames >= 1 and frames <= StudioChrome::Frame::MAX_FRAMES and first >= 0 and first <= last and last < frames)
            frames >= 1 and frames <= StudioChrome::Frame::MAX_FRAMES and first >= 0 and first <= last and last < frames

        def key_valid(first: i64, key: i64, last: i64, frames: i64) -> bool:
            ensure result == (interval_valid(first, last, frames) and key >= first and key <= last)
            interval_valid(first, last, frames) and key >= first and key <= last

        def component_valid(value: i64, bound: i64) -> bool:
            requires bound >= 0
            ensure result == (value >= -bound and value <= bound)
            value >= -bound and value <= bound

        def rotation_valid(x: i64, y: i64, z: i64, w: i64) -> bool:
            ensure result == (component_valid(x, StudioChrome::Correction::MICRO) and component_valid(y, StudioChrome::Correction::MICRO) and component_valid(z, StudioChrome::Correction::MICRO) and component_valid(w, StudioChrome::Correction::MICRO) and (x != 0 or y != 0 or z != 0 or w != 0))
            component_valid(x, StudioChrome::Correction::MICRO) and component_valid(y, StudioChrome::Correction::MICRO) and component_valid(z, StudioChrome::Correction::MICRO) and component_valid(w, StudioChrome::Correction::MICRO) and (x != 0 or y != 0 or z != 0 or w != 0)

        def translation_valid(x: i64, y: i64, z: i64) -> bool:
            ensure result == (component_valid(x, StudioChrome::Correction::MAX_REACH) and component_valid(y, StudioChrome::Correction::MAX_REACH) and component_valid(z, StudioChrome::Correction::MAX_REACH))
            component_valid(x, StudioChrome::Correction::MAX_REACH) and component_valid(y, StudioChrome::Correction::MAX_REACH) and component_valid(z, StudioChrome::Correction::MAX_REACH)

        def operation_values_valid(bones: i64, strength: i64, edge: i64) -> bool:
            ensure result == ((bones == -1 or bones == 1 or bones == 2) and strength >= 1 and strength <= StudioChrome::Session::MAX_STRENGTH and edge >= 0 and edge <= StudioChrome::Session::MAX_EDGE)
            (bones == -1 or bones == 1 or bones == 2) and strength >= 1 and strength <= StudioChrome::Session::MAX_STRENGTH and edge >= 0 and edge <= StudioChrome::Session::MAX_EDGE
