# Studio session file: the editable stack (operations, foot fix on/off and
# blend, hand contact edits) saved as text next to the take, so a cleanup
# can be closed and reopened. Format:
#
#   mocap-studio session 4
#   # 1 feet blend | 2 kind enabled first last bones strength edge | 3 effector first last planted | 4 correction | 5 hands | 6 source identity
#   1 1 6
#   2 0 1 0 239 -1 2 8
#   3 0 40 52 1
#   4 1 17 120 110 130 0 0 130526 991445 0 0 0
#
# Tag 4 (version 2) is a gizmo correction: quaternion components in
# millionths, translation in micrometres. Tag 5 (version 3) saves the opt-in
# hand fix. Tag 6 (version 4) binds the cleanup to Studio's two-part bounded
# residue fingerprint, selected animation, source frame count and node count.
# This is a conservative identity association, not a cryptographic digest.
# Optional tag 8 saves ignored findings, bound to tag 6 and a versioned stable
# analysis result identity. Tag 9 stores impact review rows with their own
# schema and repeated source/animation/frame/rig binding; malformed, mixed,
# duplicate or mismatched rows reject the session. No tag 9 means unreviewed.
# Versions 1 through 3 remain readable only through an explicit legacy path;
# they have no source identity and must not be silently restored.
# Fields are signed decimals (OpsFile's reader). Every value is brought
# into range by the proved StudioChrome checks, so a session saved on a
# longer take, or edited by hand, still loads safely; unknown operation
# kinds and malformed lines are skipped.
include "stack_state.elisa"
include "session_band_policy.elisa"
include "session_issue_annotation_policy.elisa"
include "session_impact_annotation_policy.elisa"
include "../chrome.elisa"
include "../../io/ops_file.elisa"

const SESSION_PATH_CAPACITY: usize = 4096
const SESSION_TEMP_CAPACITY: usize = 4128

@link_name("mkstemp")
extern session_mkstemp(path_template: u8&) -> i32 can[Blocking.IO]
@link_name("fdopen")
extern session_fdopen(descriptor: i32, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("close")
extern session_close(descriptor: i32) -> i32 can[Blocking.IO]
@link_name("fwrite")
extern session_fwrite(bytes: u8&, size: usize, count: usize, file: mutable heap void&) -> usize can[Blocking.IO]
@link_name("fflush")
extern session_fflush(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fileno")
extern session_fileno(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fsync")
extern session_fsync(descriptor: i32) -> i32 can[Blocking.IO]
@link_name("fclose")
extern session_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]
@link_name("rename")
extern session_rename(old_path: u8&, new_path: u8&) -> i32 can[Blocking.IO]
@link_name("unlink")
extern session_unlink(path: u8&) -> i32 can[Blocking.IO]

module SessionState:
    public:
        const TAG_FEET: i64 = 1
        const TAG_OP: i64 = 2
        const TAG_EDIT: i64 = 3
        const TAG_FIX: i64 = 4
        const TAG_HANDS: i64 = 5
        const TAG_IDENTITY: i64 = 6
        # Optional v4 extension. Older readers ignore unknown tags, so the
        # source-bound v4 envelope remains compatible.
        const TAG_BAND: i64 = 7
        const TAG_ANNOTATION: i64 = 8
        const TAG_IMPACT: i64 = 9

        const SAVE_ERROR_NONE: i64 = 0
        const SAVE_ERROR_PATH: i64 = 1
        const SAVE_ERROR_CREATE: i64 = 2
        const SAVE_ERROR_WRITE: i64 = 3
        const SAVE_ERROR_COMMIT: i64 = 4
        const SAVE_ERROR_ANNOTATIONS: i64 = 5
        const SAVE_ERROR_IMPACT: i64 = 6

        const LOAD_ERROR_NONE: i64 = 0
        const LOAD_ERROR_READ: i64 = 1
        const LOAD_ERROR_FORMAT: i64 = 2
        const LOAD_ERROR_LEGACY: i64 = 3
        const LOAD_ERROR_SOURCE: i64 = 4
        const LOAD_ERROR_ANNOTATIONS: i64 = 5
        const LOAD_ERROR_IMPACT: i64 = 6

        struct SourceIdentity:
            first: i64
            second: i64
            animation: i64
            frames: i64
            nodes: i64

        def session_header() -> sview:
            return "mocap-studio session 4"

        def header_prefix() -> sview:
            return "mocap-studio session "

        # f32 in units of 1/scale, rounded to the nearest integer.
        def to_micro(v: f32, scale: f32) -> i64:
            x: f32 = v * scale
            if x < 0.0:
                return 0 - (0.5 - x).i64()
            return (x + 0.5).i64()

        def from_micro(v: i64, scale: f32) -> f32:
            return v.f32() / scale

        def kind_code(k: Ops::Kind) -> i64:
            return 0 if k == Ops::Kind.Despike
            return 1 if k == Ops::Kind.PinContacts
            return 2 if k == Ops::Kind.CloseSeam
            return 3 if k == Ops::Kind.SmoothPath
            return 4 if k == Ops::Kind.LimitWring
            return 5

        def kind_from(code: i64) -> Ops::Kind:
            return Ops::Kind.Despike if code == 0
            return Ops::Kind.PinContacts if code == 1
            return Ops::Kind.CloseSeam if code == 2
            return Ops::Kind.SmoothPath if code == 3
            return Ops::Kind.LimitWring if code == 4
            return Ops::Kind.Median

        def impact_records_valid(records: darray[SessionImpactAnnotationPolicy::Stored]&,
                                 state: SessionImpactAnnotationPolicy::ReviewState,
                                 identity: SourceIdentity) -> bool:
            return false if records.count.i64() > SessionImpactAnnotationPolicy::Capacity::MAX_RECORDS
            return records.count.i64() == 0 if state == SessionImpactAnnotationPolicy::ReviewState.Unreviewed
            return false if records.count.i64() == 0
            return false if state == SessionImpactAnnotationPolicy::ReviewState.NoEventsReviewed and records.count.i64() != 1
            return false if state != SessionImpactAnnotationPolicy::ReviewState.EventsMarked and state != SessionImpactAnnotationPolicy::ReviewState.NoEventsReviewed
            mutable valid: bool = true
            for record in records |record, state, records, valid, identity|:
                valid <- false if not SessionImpactAnnotationPolicy::schema_matches(record)
                valid <- false if not SessionImpactAnnotationPolicy::source_identity_valid(record.source_first, record.source_second, record.animation, record.source_frames, record.nodes)
                valid <- false if not SessionImpactAnnotationPolicy::source_matches(record, identity.first, identity.second, identity.animation, identity.frames, identity.nodes)
                valid <- false if record.review != state
                if state == SessionImpactAnnotationPolicy::ReviewState.EventsMarked:
                    valid <- false if record.record_count != records.count.i64()
                    valid <- false if not SessionImpactAnnotationPolicy::event_count_valid(record.record_count)
                    valid <- false if not SessionImpactAnnotationPolicy::source_frame_valid(record.source_frame, identity.frames)
                    mutable occurrences: i64 = 0
                    for other in records |other, record, occurrences|:
                        occurrences <- occurrences + 1 if other.source_frame == record.source_frame
                    valid <- false if occurrences != 1
                else:
                    valid <- false if record.record_count != 0 or record.source_frame != -1
            valid

        def encode_session(s: StackState::Stack&, identity: SourceIdentity, out: mutable darray[u8]&):
            mutable records: darray[SessionIssueAnnotationPolicy::Stored] = []
            _ = encode_session_with_annotations(s, identity, records, out)

        # Optional v4 tag 8 stores finding result rows. Tag 6 scopes all
        # records to the bounded source fingerprint, animation, frames and nodes; tag 8
        # adds the schema, analysis output frame count and full stable detector
        # result needed to expire intent if analysis output changes.
        def encode_session_with_annotations(s: StackState::Stack&, identity: SourceIdentity, records: darray[SessionIssueAnnotationPolicy::Stored]&, out: mutable darray[u8]&) -> bool:
            mutable impact_records: darray[SessionImpactAnnotationPolicy::Stored] = []
            encode_session_with_reviews(s, identity, records, SessionImpactAnnotationPolicy::ReviewState.Unreviewed, impact_records, out)

        def encode_session_with_reviews(s: StackState::Stack&, identity: SourceIdentity,
                                        records: darray[SessionIssueAnnotationPolicy::Stored]&, impact_state: SessionImpactAnnotationPolicy::ReviewState,
                                        impact_records: darray[SessionImpactAnnotationPolicy::Stored]&, out: mutable darray[u8]&) -> bool:
            return false if records.count.i64() > SessionIssueAnnotationPolicy::MAX_RECORDS
            for record in records |record|:
                return false if not SessionIssueAnnotationPolicy::valid(record.finding, record.analysis_frames)
            return false if not impact_records_valid(impact_records, impact_state, identity)
            out.clear()
            Report::push_text(out, session_header())
            out.push(10)
            Report::push_text(out, "# 1 feet blend | 2 operation | 3 contact edit | 4 correction | 5 hands | 6 source identity | 7 retime band | 8 ignored finding | 9 impact review")
            out.push(10)
            source: darray[i64] = [TAG_IDENTITY, identity.first, identity.second, identity.animation, identity.frames, identity.nodes]
            for k in 0..<source.count:
                out.push(32) if k > 0
                OpsFile::push_number(out, source[k])
            out.push(10)
            head: darray[i64] = [TAG_FEET, 1 if s.feet else 0, s.blend]
            for k in 0..<head.count:
                out.push(32) if k > 0
                OpsFile::push_number(out, head[k])
            out.push(10)
            hands: darray[i64] = [TAG_HANDS, 1 if s.hands else 0]
            for k in 0..<hands.count:
                out.push(32) if k > 0
                OpsFile::push_number(out, hands[k])
            out.push(10)
            for i in 0..<s.count |s, out|:
                op: Ops::Operation = s.ops[i]
                f: darray[i64] = [TAG_OP, kind_code(op.kind), 1 if op.enabled else 0, op.first, op.last, op.bones, op.strength, op.edge]
                for k in 0..<f.count:
                    out.push(32) if k > 0
                    OpsFile::push_number(out, f[k])
                out.push(10)
            for i in 0..<s.edit_count |s, out|:
                e: StackState::FootEdit = s.edits[i]
                f: darray[i64] = [TAG_EDIT, e.side, e.first, e.last, 1 if e.planted else 0]
                for k in 0..<f.count:
                    out.push(32) if k > 0
                    OpsFile::push_number(out, f[k])
                out.push(10)
            q: f32 = StudioChrome::CHROME_MICRO.f32()
            t: f32 = 1000000.0
            for i in 0..<s.fix_count |s, out, q, t|:
                c: Corrections::Correction = s.fixes[i]
                f: darray[i64] = [TAG_FIX, 1 if c.enabled else 0, c.node, c.key, c.first, c.last, to_micro(c.rotation.x, q), to_micro(c.rotation.y, q), to_micro(c.rotation.z, q), to_micro(c.rotation.w, q), to_micro(c.translation.x, t), to_micro(c.translation.y, t), to_micro(c.translation.z, t)]
                for k in 0..<f.count:
                    out.push(32) if k > 0
                    OpsFile::push_number(out, f[k])
                out.push(10)
            for i in 0..<s.band_count |s, out|:
                b: StackState::Band = s.bands[i]
                f: darray[i64] = [TAG_BAND, b.first, b.last, b.speed, b.blend, 1 if b.enabled else 0]
                for k in 0..<f.count:
                    out.push(32) if k > 0
                    OpsFile::push_number(out, f[k])
                out.push(10)
            record_count: i64 = records.count.i64()
            for i in 0..<record_count |i, records, out, identity|:
                r: SessionIssueAnnotationPolicy::Stored = records[i.usize()]
                f: darray[i64] = [TAG_ANNOTATION, SessionIssueAnnotationPolicy::ANALYSIS_SCHEMA, r.analysis_frames, r.finding.first_frame, r.finding.last_frame, r.finding.issue_type, r.finding.subject_id, r.finding.peak_frame, r.finding.severity, r.finding.peak_value, r.finding.threshold]
                for k in 0..<f.count:
                    out.push(32) if k > 0
                    OpsFile::push_number(out, f[k])
                out.push(10)
            for record in impact_records |record, out|:
                f: darray[i64] = [TAG_IMPACT, record.schema, record.review.i64(), record.source_first, record.source_second, record.animation, record.source_frames, record.nodes, record.record_count, record.source_frame]
                for k in 0..<f.count:
                    out.push(32) if k > 0
                    OpsFile::push_number(out, f[k])
                out.push(10)
            true

        # The version on the header line, or 0 when it is missing or one
        # this build cannot read (StudioChrome::session_version_ok).
        def header_version(text: darray[u8]&) -> i64:
            mutable h: darray[u8] = []
            Report::push_text(&h, header_prefix())
            return 0 if text.count < h.count
            for k in 0..<h.count |text, h|:
                return 0 if text[k] != h[k]
            mutable version: i64 = 0
            mutable digits: i64 = 0
            mutable k: usize = h.count
            while k < text.count and text[k] != 10 and text[k] != 13:
                return 0 if text[k] < 48 or text[k] > 57 or digits >= 6
                version <- version * 10 + (text[k] - 48).i64()
                digits <- digits + 1
                k <- k + 1
            return 0 if digits == 0 or not StudioChrome::session_version_ok(version)
            return version

        def header_line(text: darray[u8]&) -> bool:
            return header_version(text) != 0

        # A gizmo correction from a tag 4 line, or null when its node is not
        # one of this take's `nodes` document nodes.
        def fix_from(fields: darray[i64]&, frames: i64, nodes: i64) -> Corrections::Correction?:
            return null if nodes < 0 or nodes > StudioChrome::CHROME_NODES
            return null if not StudioChrome::session_node_ok(fields[2], nodes)
            key: i64 = StudioChrome::session_frame(fields[3], frames)
            a: i64 = StudioChrome::session_frame(fields[4], frames)
            b: i64 = StudioChrome::session_frame(fields[5], frames)
            lo: i64 = a if a <= b else b
            hi: i64 = b if a <= b else a
            q: f32 = StudioChrome::CHROME_MICRO.f32()
            mutable rx: f32 = from_micro(StudioChrome::session_clamp(fields[6], StudioChrome::CHROME_MICRO), q)
            mutable ry: f32 = from_micro(StudioChrome::session_clamp(fields[7], StudioChrome::CHROME_MICRO), q)
            mutable rz: f32 = from_micro(StudioChrome::session_clamp(fields[8], StudioChrome::CHROME_MICRO), q)
            mutable rw: f32 = from_micro(StudioChrome::session_clamp(fields[9], StudioChrome::CHROME_MICRO), q)
            norm: f32 = Geometry::sqrt_f32(rx * rx + ry * ry + rz * rz + rw * rw)
            if norm < 0.000001:
                rx <- 0.0
                ry <- 0.0
                rz <- 0.0
                rw <- 1.0
            elif norm > 1.001 or norm < 0.999:
                rx <- rx / norm
                ry <- ry / norm
                rz <- rz / norm
                rw <- rw / norm
            t: f32 = 1000000.0
            tx: f32 = from_micro(StudioChrome::session_clamp(fields[10], StudioChrome::CHROME_REACH), t)
            ty: f32 = from_micro(StudioChrome::session_clamp(fields[11], StudioChrome::CHROME_REACH), t)
            tz: f32 = from_micro(StudioChrome::session_clamp(fields[12], StudioChrome::CHROME_REACH), t)
            return Corrections::Correction{enabled: fields[1] != 0, node: fields[2], key: key if key >= lo and key <= hi else lo, first: lo, last: hi, rotation: Geometry::Quat{x: rx, y: ry, z: rz, w: rw}, translation: Geometry::Vec3{x: tx, y: ty, z: tz}}

        # Decode a session for a clip of `frames` frames and `nodes` document
        # nodes. Versions 1..3 are parsed only when the caller has an explicit
        # user-approved legacy migration path. V4 requires exactly one matching
        # source/animation identity record; malformed data is refused.
        def decode_session(text: darray[u8]&, frames: i64, nodes: i64, expected: SourceIdentity, allow_legacy: bool) -> StackState::Stack?:
            mutable records: darray[SessionIssueAnnotationPolicy::Stored] = []
            decode_session_with_annotations(text, frames, nodes, expected, allow_legacy, &records)

        def decode_session_with_annotations(text: darray[u8]&, frames: i64, nodes: i64, expected: SourceIdentity, allow_legacy: bool, annotations: mutable darray[SessionIssueAnnotationPolicy::Stored]&) -> StackState::Stack?:
            mutable state: SessionImpactAnnotationPolicy::ReviewState = SessionImpactAnnotationPolicy::ReviewState.Unreviewed
            mutable impact: darray[SessionImpactAnnotationPolicy::Stored] = []
            decode_session_with_reviews(text, frames, nodes, expected, allow_legacy, annotations, &state, &impact)

        def decode_session_with_reviews(text: darray[u8]&, frames: i64, nodes: i64, expected: SourceIdentity, allow_legacy: bool,
                                        annotations: mutable darray[SessionIssueAnnotationPolicy::Stored]&, impact_state: mutable SessionImpactAnnotationPolicy::ReviewState&,
                                        impact_annotations: mutable darray[SessionImpactAnnotationPolicy::Stored]&) -> StackState::Stack?:
            session_annotation_overflow <- false
            session_impact_invalid <- false
            return null if frames < 1 or frames > StudioChrome::CHROME_FRAMES
            return null if not header_line(text)
            version: i64 = header_version(text)
            return null if version < StudioChrome::CHROME_VERSION and not allow_legacy
            mutable s: StackState::Stack = StackState::empty()
            mutable cur: darray[u8] = []
            mutable fields: darray[i64] = []
            mutable first_line: bool = true
            mutable identity_count: i64 = 0
            mutable identity_matches: bool = false
            mutable decoded_annotations: darray[SessionIssueAnnotationPolicy::Stored] = []
            mutable decoded_impact: darray[SessionImpactAnnotationPolicy::Stored] = []
            mutable decoded_impact_state: SessionImpactAnnotationPolicy::ReviewState = SessionImpactAnnotationPolicy::ReviewState.Unreviewed
            mutable annotation_overflow: bool = false
            mutable k: usize = 0
            while k <= text.count:
                if k < text.count and text[k] != 10:
                    cur.push(text[k])
                    k <- k + 1
                    continue
                k <- k + 1
                if first_line or cur.count == 0 or cur[0] == 35:
                    first_line <- false
                    cur.clear()
                    continue
                if OpsFile::parse_fields(&cur, &fields) and fields.count > 0:
                    tag: i64 = fields[0]
                    if tag == TAG_FEET and fields.count == 3:
                        s.feet <- fields[1] != 0
                        s.blend <- StudioFoot::blend(fields[2])
                    elif tag == TAG_HANDS and fields.count == 2:
                        s.hands <- fields[1] != 0
                    elif tag == TAG_IDENTITY:
                        identity_count <- identity_count + 1
                        identity_matches <- false
                        if fields.count == 6:
                            identity_matches <- StudioChrome::session_identity_matches(fields[1], fields[2], fields[3], fields[4], fields[5], expected.first, expected.second, expected.animation, expected.frames, expected.nodes)
                    elif tag == TAG_OP and fields.count == 8 and StudioChrome::session_kind_ok(fields[1]):
                        a: i64 = StudioChrome::session_frame(fields[3], frames)
                        b: i64 = StudioChrome::session_frame(fields[4], frames)
                        op: Ops::Operation = Ops::Operation{kind: kind_from(fields[1]), enabled: fields[2] != 0, first: a if a <= b else b, last: b if a <= b else a, bones: StudioChrome::session_bones(fields[5]), strength: StudioChrome::session_strength(fields[6]), edge: StudioChrome::session_edge(fields[7])}
                        _ = StackState::add(&s, op)
                    elif tag == TAG_EDIT and fields.count == 5:
                        a: i64 = StudioChrome::session_frame(fields[2], frames)
                        b: i64 = StudioChrome::session_frame(fields[3], frames)
                        _ = StackState::add_edit(&s, fields[1], a if a <= b else b, b if a <= b else a, fields[4] != 0)
                    elif tag == TAG_FIX and fields.count == 13:
                        if fix_from(&fields, frames, nodes) is fix:
                            _ = StackState::add_fix(&s, fix)
                    elif tag == TAG_BAND and fields.count == 6:
                        # Unlike legacy operation fields, bands must be
                        # wholly valid: silently clamping a range/speed could
                        # change the timing the user authored.
                        first: i64 = fields[1]
                        last: i64 = fields[2]
                        speed: i64 = fields[3]
                        blend: i64 = fields[4]
                        enabled: i64 = fields[5]
                        if SessionBandPolicy::band_record_valid(first, last, speed, blend, enabled, frames):
                            if StackState::add_band(&s, first, last, speed, frames):
                                at: i64 = s.band_count - 1
                                mutable band: StackState::Band = s.bands[at]
                                band.blend <- blend
                                band.enabled <- enabled == 1
                                s.bands[at] <- band
                    elif tag == TAG_ANNOTATION and version == StudioChrome::CHROME_VERSION and fields.count == 11 and fields[1] == SessionIssueAnnotationPolicy::ANALYSIS_SCHEMA:
                        record: SessionIssueAnnotationPolicy::Stored = SessionIssueAnnotationPolicy::Stored{analysis_frames: fields[2], finding: SessionIssueAnnotationPolicy::Record{first_frame: fields[3], last_frame: fields[4], issue_type: fields[5], subject_id: fields[6], peak_frame: fields[7], severity: fields[8], peak_value: fields[9], threshold: fields[10]}}
                        if SessionIssueAnnotationPolicy::valid(record.finding, record.analysis_frames):
                            if decoded_annotations.count.i64() >= SessionIssueAnnotationPolicy::MAX_RECORDS:
                                annotation_overflow <- true
                            else:
                                mutable duplicate: bool = false
                                for prior in decoded_annotations |prior, record, duplicate|:
                                    duplicate <- duplicate or (SessionIssueAnnotationPolicy::output_frames_match(prior.analysis_frames, record.analysis_frames) and SessionIssueAnnotationPolicy::same_analysis(prior.finding, record.finding))
                                if not duplicate:
                                    decoded_annotations.push(record)
                    elif tag == TAG_IMPACT:
                        if version != StudioChrome::CHROME_VERSION or fields.count != 10 or fields[1] != SessionImpactAnnotationPolicy::Schema::VERSION or (fields[2] != SessionImpactAnnotationPolicy::ReviewState.EventsMarked.i64() and fields[2] != SessionImpactAnnotationPolicy::ReviewState.NoEventsReviewed.i64()):
                            session_impact_invalid <- true
                        else:
                            review: SessionImpactAnnotationPolicy::ReviewState = SessionImpactAnnotationPolicy::ReviewState.EventsMarked if fields[2] == SessionImpactAnnotationPolicy::ReviewState.EventsMarked.i64() else SessionImpactAnnotationPolicy::ReviewState.NoEventsReviewed
                            record: SessionImpactAnnotationPolicy::Stored = SessionImpactAnnotationPolicy::Stored{schema: fields[1], review: review, source_first: fields[3], source_second: fields[4], animation: fields[5], source_frames: fields[6], nodes: fields[7], record_count: fields[8], source_frame: fields[9]}
                            if decoded_impact.count.i64() >= SessionImpactAnnotationPolicy::Capacity::MAX_RECORDS:
                                session_impact_invalid <- true
                            else:
                                decoded_impact_state <- review if decoded_impact.count.i64() == 0
                                decoded_impact.push(record)
                cur.clear()
            return null if version == StudioChrome::CHROME_VERSION and (identity_count != 1 or not identity_matches)
            session_annotation_overflow <- annotation_overflow
            return null if annotation_overflow
            session_impact_invalid <- true if not impact_records_valid(decoded_impact, decoded_impact_state, expected)
            return null if session_impact_invalid
            s.selected <- -1 if s.count == 0 else 0
            annotations <- move decoded_annotations
            impact_state <- decoded_impact_state
            impact_annotations <- move decoded_impact
            return s

        def save_session(s: StackState::Stack&, identity: SourceIdentity, path: cstr) -> bool:
            mutable text: darray[u8] = []
            encode_session(s, identity, &text)
            atomic_save(&text, path)

        def save_session_with_annotations(s: StackState::Stack&, identity: SourceIdentity, records: darray[SessionIssueAnnotationPolicy::Stored]&, path: cstr) -> bool:
            mutable impact_records: darray[SessionImpactAnnotationPolicy::Stored] = []
            save_session_with_reviews(s, identity, records, SessionImpactAnnotationPolicy::ReviewState.Unreviewed, impact_records, path)

        def save_session_with_reviews(s: StackState::Stack&, identity: SourceIdentity,
                                      records: darray[SessionIssueAnnotationPolicy::Stored]&, impact_state: SessionImpactAnnotationPolicy::ReviewState,
                                      impact_records: darray[SessionImpactAnnotationPolicy::Stored]&, path: cstr) -> bool:
            mutable text: darray[u8] = []
            if not encode_session_with_reviews(s, identity, records, impact_state, impact_records, &text):
                session_save_error <- SAVE_ERROR_ANNOTATIONS
                session_save_error <- SAVE_ERROR_IMPACT if impact_records.count.i64() > 0 or impact_state != SessionImpactAnnotationPolicy::ReviewState.Unreviewed
                return false
            atomic_save(&text, path)

        def save_error() -> i64:
            session_save_error

        def load_session(path: cstr, frames: i64, nodes: i64, expected: SourceIdentity, allow_legacy: bool) -> StackState::Stack?:
            mutable records: darray[SessionIssueAnnotationPolicy::Stored] = []
            load_session_with_annotations(path, frames, nodes, expected, allow_legacy, &records)

        def load_session_with_annotations(path: cstr, frames: i64, nodes: i64, expected: SourceIdentity, allow_legacy: bool, annotations: mutable darray[SessionIssueAnnotationPolicy::Stored]&) -> StackState::Stack?:
            mutable state: SessionImpactAnnotationPolicy::ReviewState = SessionImpactAnnotationPolicy::ReviewState.Unreviewed
            mutable impact: darray[SessionImpactAnnotationPolicy::Stored] = []
            load_session_with_reviews(path, frames, nodes, expected, allow_legacy, annotations, &state, &impact)

        def load_session_with_reviews(path: cstr, frames: i64, nodes: i64, expected: SourceIdentity, allow_legacy: bool,
                                      annotations: mutable darray[SessionIssueAnnotationPolicy::Stored]&, impact_state: mutable SessionImpactAnnotationPolicy::ReviewState&,
                                      impact_annotations: mutable darray[SessionImpactAnnotationPolicy::Stored]&) -> StackState::Stack?:
            session_load_error <- LOAD_ERROR_NONE
            session_impact_invalid <- false
            mutable text: darray[u8] = []
            if not OpsFile::read_bytes(path, &text):
                session_load_error <- LOAD_ERROR_READ
                return null
            version: i64 = header_version(&text)
            if version == 0:
                session_load_error <- LOAD_ERROR_FORMAT
                return null
            if version < StudioChrome::CHROME_VERSION and not allow_legacy:
                session_load_error <- LOAD_ERROR_LEGACY
                return null
            session_annotation_overflow <- false
            if decode_session_with_reviews(&text, frames, nodes, expected, allow_legacy, annotations, impact_state, impact_annotations) is decoded:
                return decoded
            session_load_error <- LOAD_ERROR_IMPACT if session_impact_invalid
            session_load_error <- LOAD_ERROR_ANNOTATIONS if session_annotation_overflow and not session_impact_invalid
            session_load_error <- LOAD_ERROR_SOURCE if session_load_error == LOAD_ERROR_NONE and version == StudioChrome::CHROME_VERSION
            session_load_error <- LOAD_ERROR_FORMAT if session_load_error == LOAD_ERROR_NONE
            return null

        def load_error() -> i64:
            session_load_error

    private:
        global mutable session_save_error: i64 = SAVE_ERROR_NONE
        global mutable session_load_error: i64 = LOAD_ERROR_NONE
        global mutable session_annotation_overflow: bool = false
        global mutable session_impact_invalid: bool = false

        def atomic_save(out: darray[u8]&, path: cstr) -> bool:
            session_save_error <- SAVE_ERROR_NONE
            mutable path_length: usize = 0
            while path_length < SESSION_PATH_CAPACITY and path[path_length] != 0:
                path_length <- path_length + 1
            if path_length == 0 or path_length >= SESSION_PATH_CAPACITY:
                session_save_error <- SAVE_ERROR_PATH
                return false
            # Keep the temporary in the destination directory so rename is
            # atomic on the destination filesystem. mkstemp replaces XXXXXX
            # with a unique suffix and creates the file with private mode.
            mutable temporary: u8[SESSION_TEMP_CAPACITY] = zeroed
            for index in 0..<path_length |path, temporary|:
                temporary[index] <- path[index]
            suffix: cstr = ".mocap-tmp-XXXXXX"
            mutable suffix_length: usize = 0
            while suffix[suffix_length] != 0:
                temporary[path_length + suffix_length] <- suffix[suffix_length]
                suffix_length <- suffix_length + 1
            temporary[path_length + suffix_length] <- 0
            descriptor: i32 = session_mkstemp(&temporary[0])
            if descriptor < 0:
                session_save_error <- SAVE_ERROR_CREATE
                return false
            file: mutable heap void&? = session_fdopen(descriptor, "wb".cast[u8&])
            if file == null:
                _ = session_close(descriptor)
                _ = session_unlink(&temporary[0])
                session_save_error <- SAVE_ERROR_CREATE
                return false
            handle: mutable heap void& = file
            mutable wrote: usize = 0
            if out.count > 0:
                wrote <- session_fwrite(&out[0], 1, out.count, handle)
            flushed: i32 = session_fflush(handle)
            file_descriptor: i32 = session_fileno(handle)
            mutable synced: i32 = -1
            if file_descriptor >= 0:
                synced <- session_fsync(file_descriptor)
            closed: i32 = session_fclose(handle)
            if wrote != out.count or flushed != 0 or synced != 0 or closed != 0:
                _ = session_unlink(&temporary[0])
                session_save_error <- SAVE_ERROR_WRITE
                return false
            committed: bool = session_rename(&temporary[0], path.cast[u8&]) == 0
            if not committed:
                _ = session_unlink(&temporary[0])
                session_save_error <- SAVE_ERROR_COMMIT
                return false
            true
