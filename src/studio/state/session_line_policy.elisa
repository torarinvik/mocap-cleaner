module SessionLinePolicy:
    public:
        const enum Byte of u8:
            Tab = 9
            CarriageReturn = 13
            Space = 32
            Comment = 35

        def whitespace(value: u8) -> bool:
            ensure result == (value == Byte.Tab.u8() or value == Byte.CarriageReturn.u8() or value == Byte.Space.u8())
            value == Byte.Tab.u8() or value == Byte.CarriageReturn.u8() or value == Byte.Space.u8()

        # A comment starts at the first non-whitespace byte. Do not treat a
        # comment marker embedded in an authored record as an ignorable line.
        def ignored(line: darray[u8]&) -> bool:
            ensure result or line.count > 0
            for value in line:
                if not whitespace(value):
                    return value == Byte.Comment.u8()
            true
