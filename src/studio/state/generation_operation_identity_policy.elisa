# Exact native journal identity: "trash-" followed by 32 lowercase hex bytes.
module StudioGenerationOperationIdentityPolicy:
    public:
        const module Limit:
            BYTES: i64 = 38
            PREFIX_BYTES: usize = 6

        def valid(operation: darray[u8]&) -> bool:
            ensure not result or operation.count.i64() == Limit::BYTES
            return false if operation.count.i64() != Limit::BYTES
            prefix: u8[6] = [116, 114, 97, 115, 104, 45]
            for index in 0..<Limit::PREFIX_BYTES |index, operation, prefix|:
                return false if operation[index] != prefix[index]
            for index in Limit::PREFIX_BYTES..<operation.count |index, operation|:
                byte: u8 = operation[index]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
            true
