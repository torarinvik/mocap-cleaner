# Acceptance rule for saved retime bands. Persisted timing values are accepted
# atomically so malformed fields never turn into silently clamped edits.
include "../../core/retime.elisa"

module SessionBandPolicy:
    public:
        def band_record_valid(first: i64, last: i64, speed: i64, blend: i64, enabled: i64, frames: i64) -> bool:
            ensure result == (frames >= 1 and frames <= Retime::Domain::MAX_FRAMES and first >= 0 and last >= first and last < frames and Retime::speed_ok(speed) and blend >= 0 and blend <= Retime::Domain::MAX_BLEND and (enabled == 0 or enabled == 1))
            return frames >= 1 and frames <= Retime::Domain::MAX_FRAMES and first >= 0 and last >= first and last < frames and Retime::speed_ok(speed) and blend >= 0 and blend <= Retime::Domain::MAX_BLEND and (enabled == 0 or enabled == 1)
