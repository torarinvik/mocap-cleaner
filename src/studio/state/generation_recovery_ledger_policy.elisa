include "../build_generation_trash_policy.elisa"

# Admission for a bounded recovery ledger. The controller must reserve a slot
# before dispatch, and retain owning replies when recording cannot complete.
module StudioGenerationRecoveryLedgerPolicy:
    public:
        const module Limit:
            OPERATIONS: i64 = 512

        const enum Admission of i64:
            Accepted = 0
            Invalid = 1
            Duplicate = 2
            Full = 3

        def valid_bytes(bytes: darray[u8]&, maximum: i64) -> bool:
            ensure not result or (bytes.count > 0 and bytes.count.i64() <= maximum)
            return false if maximum <= 0 or bytes.count == 0 or bytes.count.i64() > maximum
            for byte in bytes:
                return false if byte == 0
            true

        def may_reserve(count: i64, reserved: i64) -> bool:
            ensure result == (count >= 0 and reserved >= 0 and count < Limit::OPERATIONS and reserved < Limit::OPERATIONS - count)
            count >= 0 and reserved >= 0 and count < Limit::OPERATIONS and reserved < Limit::OPERATIONS - count

        def admission(count: i64, root: darray[u8]&, operation: darray[u8]&, duplicate: bool) -> Admission:
            return Admission.Invalid if count < 0 or count > Limit::OPERATIONS or not valid_bytes(root, StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES) or not valid_bytes(operation, StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES)
            return Admission.Duplicate if duplicate
            return Admission.Full if count == Limit::OPERATIONS
            Admission.Accepted
