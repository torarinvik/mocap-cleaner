include "../build_generation_trash_policy.elisa"
include "../io/build_generation_candidate_provider.elisa"
include "generation_operation_identity_policy.elisa"

# Full selected-operation identity retained across Restore dispatch and retries.
module StudioGenerationRestoreReviewIdentityPolicy:
    public:
        def valid(root: darray[u8]&, operation: darray[u8]&,
                  artifact_id: darray[u8]&, relative_path: darray[u8]&) -> bool:
            ensure not result or (root.count > 0 and root.count.i64() <= StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES and artifact_id.count > 0 and artifact_id.count <= StudioBuildGenerationCandidateProvider::Limit::MAX_ID_BYTES and relative_path.count > 0 and relative_path.count.i64() <= StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES and StudioGenerationOperationIdentityPolicy::valid(operation))
            return false if root.count == 0 or root.count.i64() > StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES
            return false if artifact_id.count == 0 or artifact_id.count > StudioBuildGenerationCandidateProvider::Limit::MAX_ID_BYTES
            return false if relative_path.count == 0 or relative_path.count.i64() > StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES
            return false if not StudioGenerationOperationIdentityPolicy::valid(operation)
            for byte in root:
                return false if byte == 0
            for byte in artifact_id:
                return false if byte == 0
            for byte in relative_path:
                return false if byte == 0
            true

        def same_bytes(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |index, left, right|:
                return false if left[index] != right[index]
            true

        def exact_match(root: darray[u8]&, operation: darray[u8]&, artifact_id: darray[u8]&, relative_path: darray[u8]&, observed_root: darray[u8]&, observed_operation: darray[u8]&, observed_artifact_id: darray[u8]&, observed_relative_path: darray[u8]&) -> bool:
            ensure result implies valid(root, operation, artifact_id, relative_path) and valid(observed_root, observed_operation, observed_artifact_id, observed_relative_path)
            valid(root, operation, artifact_id, relative_path) and valid(observed_root, observed_operation, observed_artifact_id, observed_relative_path) and same_bytes(root, observed_root) and same_bytes(operation, observed_operation) and same_bytes(artifact_id, observed_artifact_id) and same_bytes(relative_path, observed_relative_path)
