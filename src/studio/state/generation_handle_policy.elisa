include "../build_generation_trash_binding_policy.elisa"

# Native close consumes a registry token only after admission. Busy and
# unknown outcomes retain ownership so the controller cannot lose the handle.
module StudioGenerationHandlePolicy:
    public:
        def consumed(status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure result == (status.known and (status.status == StudioBuildGenerationTrashNative::Status.Acquired or status.status == StudioBuildGenerationTrashNative::Status.ReleaseUncertain or status.status == StudioBuildGenerationTrashNative::Status.StaleHandle))
            status.known and (status.status == StudioBuildGenerationTrashNative::Status.Acquired or status.status == StudioBuildGenerationTrashNative::Status.ReleaseUncertain or status.status == StudioBuildGenerationTrashNative::Status.StaleHandle)

        def remaining(handle: i64, status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> i64:
            requires handle >= 0
            ensure result == (0 if consumed(status) else handle)
            0 if consumed(status) else handle

        def release_certain(status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure result == (status.known and (status.status == StudioBuildGenerationTrashNative::Status.Acquired or status.status == StudioBuildGenerationTrashNative::Status.StaleHandle))
            status.known and (status.status == StudioBuildGenerationTrashNative::Status.Acquired or status.status == StudioBuildGenerationTrashNative::Status.StaleHandle)
