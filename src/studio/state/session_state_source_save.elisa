# V5 publication wrapper kept separate from the large legacy session codec.
include "session_state.elisa"
include "session_state_io.elisa"

extend SessionState:
    public:
        const enum SourceSaveResult of i64:
            Saved = 0
            InvalidRecord = 1
            Path = 2
            Create = 3
            Write = 4
            Commit = 5

        def save_session_with_source_reference(s: StackState::Stack&, identity: SourceIdentity,
                                      source_reference: SessionSourceReferenceCodec::Record&,
                                      records: darray[SessionIssueAnnotationPolicy::Stored]&, impact_state: SessionImpactAnnotationPolicy::ReviewState,
                                      impact_records: darray[SessionImpactAnnotationPolicy::Stored]&, path: cstr) -> SourceSaveResult can[Memory.Allocate, Blocking.IO, Memory.Release]:
            mutable text: darray[u8] = []
            return SourceSaveResult.InvalidRecord if not encode_session_with_source_reference(s, identity, source_reference, records, impact_state, impact_records, &text)
            result: SessionStateIo::SaveError = SessionStateIo::atomic_save(&text, path)
            return SourceSaveResult.Path if result == SessionStateIo::SaveError.Path
            return SourceSaveResult.Create if result == SessionStateIo::SaveError.Create
            return SourceSaveResult.Write if result == SessionStateIo::SaveError.Write
            return SourceSaveResult.Commit if result == SessionStateIo::SaveError.Commit
            SourceSaveResult.Saved
