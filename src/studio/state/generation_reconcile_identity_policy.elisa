# Strict decoding for descriptor identities returned by recovery reconciliation.
module StudioGenerationReconcileIdentityPolicy:
    public:
        const enum State of i64:
            Unavailable = 0
            Verified = 1
            Refused = 2

        struct Facts:
            state: State
            root_device: u64
            root_inode: u64
            receipt_device: u64
            receipt_inode: u64
            receipt_bytes: i64
            receipt_sha256: darray[u8]

        const module Limit:
            SHA256_BYTES: i64 = 64
            MAX_RECEIPT_BYTES: i64 = 1048576

        def digest_valid(digest: darray[u8]&) -> bool:
            return false if digest.count.i64() != Limit::SHA256_BYTES
            for byte in digest:
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
            true

        def verified(root_inode: u64, receipt_inode: u64, receipt_bytes: i64,
                      digest: darray[u8]&) -> bool:
            root_inode > 0 and receipt_inode > 0 and receipt_bytes > 0 and
                receipt_bytes <= Limit::MAX_RECEIPT_BYTES and digest_valid(digest)

        def unavailable() -> Facts:
            Facts{state: State.Unavailable, root_device: 0, root_inode: 0,
                receipt_device: 0, receipt_inode: 0, receipt_bytes: 0,
                receipt_sha256: []}

        def refused() -> Facts:
            Facts{state: State.Refused, root_device: 0, root_inode: 0,
                receipt_device: 0, receipt_inode: 0, receipt_bytes: 0,
                receipt_sha256: []}

        def decode(raw_valid: i32, root_device: u64, root_inode: u64,
                   receipt_device: u64, receipt_inode: u64, receipt_bytes: i64,
                   digest: darray[u8]&) -> Facts can[Memory.Allocate]:
            ensure result.state != State.Verified or verified(result.root_inode,
                result.receipt_inode, result.receipt_bytes, result.receipt_sha256)
            ensure result.state == State.Unavailable implies (result.root_inode == 0 and result.receipt_inode == 0 and result.receipt_bytes == 0 and result.receipt_sha256.count == 0)
            ensure result.state == State.Refused implies (result.root_inode == 0 and result.receipt_inode == 0 and result.receipt_bytes == 0 and result.receipt_sha256.count == 0)
            return unavailable() if raw_valid == 0
            return refused() if raw_valid != 1 or not verified(root_inode, receipt_inode, receipt_bytes, digest)
            owned_digest: darray[u8] = []
            owned_digest.extend(digest)
            Facts{state: State.Verified, root_device: root_device,
                root_inode: root_inode, receipt_device: receipt_device,
                receipt_inode: receipt_inode, receipt_bytes: receipt_bytes,
                receipt_sha256: owned_digest}
