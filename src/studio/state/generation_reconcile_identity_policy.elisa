# Strict adapter policy for identity details returned by native reconciliation.
module StudioGenerationReconcileIdentityPolicy:
    public:
        const enum State of i64:
            Unavailable = 0
            Verified = 1
            Refused = 2

        const module Limit:
            SHA256_BYTES: i64 = 64
            MAX_RECEIPT_BYTES: i64 = 1048576

        struct Details:
            root_device: u64
            root_inode: u64
            receipt_device: u64
            receipt_inode: u64
            receipt_bytes: i64
            receipt_sha256: u8[65]

        def digest_valid(buffer: u8[65]&) -> bool:
            return false if buffer[64] != 0
            for index in 0 ..< 64:
                byte: u8 = buffer[index]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
            true

        def verified(root_device: u64, root_inode: u64,
                     receipt_device: u64, receipt_inode: u64,
                     receipt_bytes: i64, digest: u8[65]&) -> bool:
            root_inode > 0 and receipt_inode > 0 and receipt_bytes > 0 and receipt_bytes <= Limit::MAX_RECEIPT_BYTES and digest_valid(digest)

        def digest_equal(copied: u8[65], digest: u8[65]&) -> bool:
            for index in 0 ..< 65:
                return false if copied[index] != digest[index]
            true

        def decode_state(raw_valid: i32, outputs_zero: bool,
                         context_valid: bool, details_valid: bool) -> State:
            if raw_valid == 0:
                if outputs_zero:
                    return State.Unavailable
                return State.Refused
            if raw_valid != 1 or not context_valid or not details_valid:
                return State.Refused
            State.Verified

        def decode_details(state: State, root_device: u64, root_inode: u64,
                           receipt_device: u64, receipt_inode: u64,
                           receipt_bytes: i64, digest: u8[65]&) -> Details:
            if state != State.Verified:
                return Details{root_device: 0, root_inode: 0, receipt_device: 0, receipt_inode: 0, receipt_bytes: 0, receipt_sha256: zeroed}
            mutable copied_digest: u8[65] = zeroed
            for index in 0 ..< 65:
                copied_digest[index] <- digest[index]
            Details{root_device: root_device, root_inode: root_inode,
                receipt_device: receipt_device, receipt_inode: receipt_inode,
                receipt_bytes: receipt_bytes, receipt_sha256: copied_digest}
