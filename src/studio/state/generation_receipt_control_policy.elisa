module StudioGenerationReceiptControlPolicy:
    public:
        const enum Evidence of i64:
            Legacy = 0
            ReviewedControls = 1

        def controls_admitted(evidence: Evidence, manifest_matches: bool,
                              input_record_matches: bool) -> bool:
            ensure result == (evidence == Evidence.ReviewedControls and manifest_matches and input_record_matches)
            evidence == Evidence.ReviewedControls and manifest_matches and input_record_matches

        def package_input_admitted(is_package: bool, digest_valid: bool,
                                   empty_digest: bool) -> bool:
            ensure result == ((is_package and digest_valid and not empty_digest) or (not is_package and empty_digest))
            (is_package and digest_valid and not empty_digest) or (not is_package and empty_digest)
