include "generation_handle_policy.elisa"

module StudioGenerationRestoreWorkerPolicy:
    public:
        def restored(commit: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                     release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
                     recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome,
                     details_valid: bool, remaining_handle: i64) -> bool:
            ensure result == (commit.known and commit.status == StudioBuildGenerationTrashNative::Status.Restored and StudioGenerationHandlePolicy::release_certain(release) and recovery == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Restored and details_valid and remaining_handle == 0)
            commit.known and commit.status == StudioBuildGenerationTrashNative::Status.Restored and StudioGenerationHandlePolicy::release_certain(release) and recovery == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Restored and details_valid and remaining_handle == 0

        def accept_result(ticket: i64, current_ticket: i64, cancelled: bool) -> bool:
            ensure result == (ticket > 0 and ticket == current_ticket and not cancelled)
            ticket > 0 and ticket == current_ticket and not cancelled

        # Cancellation suppresses publication, but never transfers a retained
        # native handle out of existence. Drain/retain it before discarding.
        def may_discard_reply(remaining_handle: i64) -> bool:
            ensure result == (remaining_handle == 0)
            remaining_handle == 0
