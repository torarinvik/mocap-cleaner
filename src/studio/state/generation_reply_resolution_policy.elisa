include "generation_handle_policy.elisa"

# Releasing ownership and resolving artifact location are separate evidence.
# Callers compare captured bytes, preserve the identity in the ledger and bind
# the native observation to the current selected operation before admission.
module StudioGenerationReplyResolutionPolicy:
    public:
        def terminal(outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome) -> bool:
            ensure result == (outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined or outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.NotMoved or outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Restored)
            outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined or outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.NotMoved or outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Restored

        struct Evidence:
            remaining_handle: i64
            release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            jobs_idle: bool
            identity_matches: bool
            details_match: bool
            identity_recorded: bool
            observation_current: bool
            observation_status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome

        def may_resolve(evidence: Evidence) -> bool:
            ensure result == (evidence.remaining_handle == 0 and StudioGenerationHandlePolicy::release_certain(evidence.release) and evidence.jobs_idle and evidence.identity_matches and evidence.details_match and evidence.identity_recorded and evidence.observation_current and StudioGenerationHandlePolicy::release_certain(evidence.observation_status) and terminal(evidence.outcome))
            evidence.remaining_handle == 0 and StudioGenerationHandlePolicy::release_certain(evidence.release) and evidence.jobs_idle and evidence.identity_matches and evidence.details_match and evidence.identity_recorded and evidence.observation_current and StudioGenerationHandlePolicy::release_certain(evidence.observation_status) and terminal(evidence.outcome)
