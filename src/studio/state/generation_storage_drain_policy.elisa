# Storage must keep its context while any generation filesystem job drains.
module StudioGenerationStorageDrainPolicy:
    public:
        def may_leave(move_active: bool, restore_active: bool,
                      discovery_active: bool, reconcile_active: bool) -> bool:
            ensure result == (not move_active and not restore_active and not discovery_active and not reconcile_active)
            not move_active and not restore_active and not discovery_active and not reconcile_active

        def may_start_job(move_active: bool, restore_active: bool,
                          discovery_active: bool, reconcile_active: bool,
                          inventory_active: bool) -> bool:
            ensure result == (may_leave(move_active, restore_active, discovery_active, reconcile_active) and not inventory_active)
            may_leave(move_active, restore_active, discovery_active, reconcile_active) and not inventory_active

        def may_finish_close(requested: bool, move_active: bool, restore_active: bool,
                             discovery_active: bool, reconcile_active: bool,
                             inventory_active: bool, batch_active: bool) -> bool:
            ensure result == (requested and not batch_active and may_start_job(move_active, restore_active, discovery_active, reconcile_active, inventory_active))
            requested and not batch_active and may_start_job(move_active, restore_active, discovery_active, reconcile_active, inventory_active)
