include "../build_generation_trash_binding_policy.elisa"

# A reconciliation observation only opens review for the exact selected row.
module StudioGenerationRecoveryScanPolicy:
    public:
        const module Limit:
            OPERATIONS: i64 = 512

        def ticket_valid(ticket: i64) -> bool:
            ensure result == (ticket > 0)
            ticket > 0

        def index_valid(index: i64, count: i64) -> bool:
            ensure result == (count > 0 and count <= Limit::OPERATIONS and index >= 0 and index < count)
            count > 0 and count <= Limit::OPERATIONS and index >= 0 and index < count

        def reply_current(reply_ticket: i64, current_ticket: i64,
                          reply_index: i64, selected_index: i64) -> bool:
            ensure result == (ticket_valid(reply_ticket) and reply_ticket == current_ticket and reply_index >= 0 and reply_index == selected_index)
            ticket_valid(reply_ticket) and reply_ticket == current_ticket and reply_index >= 0 and reply_index == selected_index

        def restore_admitted(reply_ticket: i64, current_ticket: i64,
                             reply_index: i64, selected_index: i64,
                             identity_matches: bool, root_current: bool,
                             outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome,
                             details_valid: bool) -> bool:
            ensure result == (reply_current(reply_ticket, current_ticket, reply_index, selected_index) and identity_matches and root_current and outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined and details_valid)
            reply_current(reply_ticket, current_ticket, reply_index, selected_index) and identity_matches and root_current and outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined and details_valid
