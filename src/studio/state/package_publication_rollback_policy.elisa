# Admission model for the build adapter's first-move rollback. A durable
# publication intent stays retained; this never marks the new bundle Published.
module StudioPackagePublicationRollbackPolicy:
    public:
        def may_restore_previous(previous_moved: bool, new_still_pending: bool,
                                 current_absent: bool, identities_verified: bool,
                                 seals_verified: bool, locks_retained: bool) -> bool:
            ensure result == (previous_moved and new_still_pending and current_absent and identities_verified and seals_verified and locks_retained)
            previous_moved and new_still_pending and current_absent and identities_verified and seals_verified and locks_retained
