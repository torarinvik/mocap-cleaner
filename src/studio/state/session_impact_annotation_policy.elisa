# Impact review records bind source events to a take, animation and source
# frame domain. The Studio fingerprint is a residue pair, not a cryptographic
# digest, so it is a conservative session association only.
module SessionImpactAnnotationPolicy:
    public:
        const SCHEMA: i64 = 1
        const MAX_RECORDS: i64 = 512

        const enum ReviewState of i64:
            Unreviewed = 0
            EventsMarked = 1
            NoEventsReviewed = 2

        struct Stored:
            schema: i64
            review: ReviewState
            source_first: i64
            source_second: i64
            animation: i64
            source_frames: i64
            nodes: i64
            record_count: i64
            source_frame: i64

        def source_identity_valid(first: i64, second: i64, animation: i64, frames: i64, nodes: i64) -> bool:
            ensure result == (first >= 0 and second >= 0 and animation >= 0 and frames > 0 and nodes > 0)
            first >= 0 and second >= 0 and animation >= 0 and frames > 0 and nodes > 0

        def source_matches(record: Stored, first: i64, second: i64, animation: i64, frames: i64, nodes: i64) -> bool:
            ensure result == (record.source_first == first and record.source_second == second and record.animation == animation and record.source_frames == frames and record.nodes == nodes)
            record.source_first == first and record.source_second == second and record.animation == animation and record.source_frames == frames and record.nodes == nodes

        def animation_matches(record: Stored, animation: i64) -> bool:
            ensure result == (record.animation == animation)
            record.animation == animation

        def schema_matches(record: Stored) -> bool:
            ensure result == (record.schema == SCHEMA)
            record.schema == SCHEMA

        def event_count_valid(count: i64) -> bool:
            ensure result == (count > 0 and count <= MAX_RECORDS)
            count > 0 and count <= MAX_RECORDS

        def source_frame_valid(frame: i64, frames: i64) -> bool:
            ensure result == (frames > 0 and frame >= 0 and frame < frames)
            frames > 0 and frame >= 0 and frame < frames

        def no_event_fields_valid(count: i64, frame: i64) -> bool:
            ensure result == (count == 0 and frame == -1)
            count == 0 and frame == -1
