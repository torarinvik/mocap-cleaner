# Readouts shown while a gizmo drag is live: the rotation it applies as an
# angle (tenths of a degree) and the translation as a distance (whole
# millimetres). Display only; the keyed correction is unchanged.
include "stack_state.elisa"

module StudioReadout:
    public:
        # acos on [0, 1] (Abramowitz and Stegun 4.4.45, error under 7e-5 rad).
        def acos_unit(x: f32) -> f32 can[Global{Read, Write}]:
            v: f32 = 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)
            poly: f32 = 1.5707288 + v * (0.0 - 0.2121144 + v * (0.0742610 - 0.0187293 * v))
            return Geometry::sqrt_f32(1.0 - v) * poly

        # Rounded non-negative f32 as i64.
        def rounded(x: f32) -> i64:
            return 0 if x <= 0.0
            return (x + 0.5).i64()

        # Angle of a rotation offset (the short arc), tenths of a degree.
        def angle_tenths(q: Geometry::Quat) -> i64 can[Global{Read, Write}]:
            n: f32 = Geometry::sqrt_f32(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
            return 0 if n < 0.000001
            w: f32 = q.w / n
            half: f32 = acos_unit(w if w >= 0.0 else 0.0 - w)
            return rounded(half * 2.0 * 572.957795)

        # Length of a translation offset in metres, as whole millimetres.
        def millimetres(t: Geometry::Vec3) -> i64 can[Global{Read, Write}]:
            return rounded(Geometry::sqrt_f32(t.x * t.x + t.y * t.y + t.z * t.z) * 1000.0)
