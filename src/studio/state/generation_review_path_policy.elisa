# Exact bounded path segments for generation and recovery review.
module StudioGenerationReviewPathPolicy:
    public:
        const module Limit:
            MAX_PATH_BYTES: i64 = 8191
            SCALARS_PER_LINE: usize = 12
            ESCAPED_BYTES_PER_LINE: usize = 6
            MAX_LINE_BYTES: usize = SCALARS_PER_LINE * 4
            LINES_PER_PAGE: i64 = 5
            MAX_PAGES: i64 = ((MAX_PATH_BYTES + ESCAPED_BYTES_PER_LINE.i64() - 1) / ESCAPED_BYTES_PER_LINE.i64() + LINES_PER_PAGE - 1) / LINES_PER_PAGE

        struct Geometry:
            x: f32
            y: f32
            w: f32
            h: f32

        const module Node:
            INSPECT: usize = 303
            DIALOG: usize = 322
            STATUS: usize = 323
            LINE_FIRST: usize = 324
            LINE_COUNT: i64 = 5
            PREVIOUS: usize = 329
            NEXT: usize = 330
            DONE: usize = 331

        def path_valid(path: darray[u8]&) -> bool:
            ensure result implies path.count > 0 and path.count.i64() <= Limit::MAX_PATH_BYTES
            return false if path.count == 0 or path.count.i64() > Limit::MAX_PATH_BYTES
            for byte in path:
                return false if byte == 0
            true

        def continuation(byte: u8) -> bool:
            byte >= 128 and byte <= 191

        def utf8_width(path: darray[u8]&, at: usize) -> usize:
            requires at < path.count
            lead: i64 = path[at].i64()
            width: usize = 1 if lead < 128 else 2 if lead >= 194 and lead <= 223 else 3 if lead >= 224 and lead <= 239 else 4 if lead >= 240 and lead <= 244 else 0
            return 0 if width == 0 or path.count - at < width
            mutable scalar: i64 = lead if width == 1 else lead - (192 if width == 2 else 224 if width == 3 else 240)
            for offset in 1..<width:
                next: i64 = path[at + offset].i64()
                return 0 if not continuation(path[at + offset])
                return 0 if width == 3 and offset == 1 and lead == 224 and next < 160
                return 0 if width == 3 and offset == 1 and lead == 237 and next > 159
                return 0 if width == 4 and offset == 1 and lead == 240 and next < 144
                return 0 if width == 4 and offset == 1 and lead == 244 and next > 143
                scalar <- scalar * 64 + next - 128
            minimum: i64 = 0 if width == 1 else 128 if width == 2 else 2048 if width == 3 else 65536
            return 0 if scalar < minimum
            width

        def escaped_display(path: darray[u8]&) -> bool:
            requires path_valid(path)
            mutable at: usize = 0
            while at < path.count:
                width: usize = utf8_width(path, at)
                return true if width == 0
                scalar: mutable i64 = path[at].i64()
                if width > 1:
                    scalar <- path[at].i64() - (192 if width == 2 else 224 if width == 3 else 240)
                    for offset in 1..<width:
                        scalar <- scalar * 64 + path[at + offset].i64() - 128
                return true if scalar < 32 or (scalar >= 127 and scalar <= 159) or scalar == 8232 or scalar == 8233 or scalar == 8206 or scalar == 8207 or (scalar >= 8234 and scalar <= 8238) or (scalar >= 8294 and scalar <= 8297)
                at <- at + width
            false

        def panel_geometry(view_w: f32, view_h: f32) -> Geometry:
            requires view_w >= 0.0 and view_h >= 0.0
            width: f32 = view_w - 32.0 if view_w < 852.0 and view_w > 32.0 else 0.0 if view_w <= 32.0 else 820.0
            height: f32 = view_h - 32.0 if view_h < 532.0 and view_h > 32.0 else 0.0 if view_h <= 32.0 else 500.0
            Geometry{x: (view_w - width) / 2.0, y: (view_h - height) / 2.0, w: width, h: height}

        def panel_supported(panel: Geometry) -> bool:
            panel.w >= 240.0 and panel.h >= 220.0

        def panel_inset(panel: Geometry) -> f32:
            panel.w / 4.0 if panel.w < 48.0 else 12.0 if panel.w < 400.0 else 24.0

        def review_geometry(view_w: f32, view_h: f32) -> Geometry:
            requires view_w >= 0.0 and view_h >= 0.0
            width: f32 = view_w - 32.0 if view_w < 852.0 and view_w > 32.0 else 0.0 if view_w <= 32.0 else 820.0
            height: f32 = view_h - 32.0 if view_h < 692.0 and view_h > 32.0 else 0.0 if view_h <= 32.0 else 660.0
            Geometry{x: (view_w - width) / 2.0, y: (view_h - height) / 2.0, w: width, h: height}

        def line_end(path: darray[u8]&, start: usize) -> usize:
            requires path_valid(path)
            requires start <= path.count
            ensure result <= path.count
            ensure result <= start + Limit::MAX_LINE_BYTES
            ensure start < path.count implies result > start
            return path.count if start >= path.count
            if escaped_display(path):
                end: usize = start + Limit::ESCAPED_BYTES_PER_LINE
                return path.count if end > path.count
                end
            else:
                mutable end: usize = start
                mutable scalars: usize = 0
                while end < path.count and scalars < Limit::SCALARS_PER_LINE:
                    width: usize = utf8_width(path, end)
                    return end + 1 if width == 0
                    end <- end + width
                    scalars <- scalars + 1
                end

        def line_start(path: darray[u8]&, line: usize) -> usize:
            requires path_valid(path)
            ensure result <= path.count
            mutable offset: usize = 0
            for index in 0..<line |index, path, offset|:
                offset <- line_end(path, offset)
            offset

        def line_count(path: darray[u8]&) -> usize:
            requires path_valid(path)
            mutable offset: usize = 0
            mutable count: usize = 0
            while offset < path.count:
                offset <- line_end(path, offset)
                count <- count + 1
            count

        def utf8_boundary(path: darray[u8]&, target: usize) -> bool:
            requires path_valid(path)
            requires target <= path.count
            mutable at: usize = 0
            while at < target:
                width: usize = utf8_width(path, at)
                return false if width == 0 or at + width > target
                at <- at + width
            at == target

        def page_count(path: darray[u8]&) -> i64:
            ensure path_valid(path) implies result > 0 and result <= Limit::MAX_PAGES
            return 0 if not path_valid(path)
            lines: usize = line_count(path)
            ((lines + Limit::LINES_PER_PAGE.usize() - 1) / Limit::LINES_PER_PAGE.usize()).i64()

        def visible_lines(path: darray[u8]&, page: i64) -> i64:
            ensure result >= 0 and result <= Limit::LINES_PER_PAGE
            ensure path_valid(path) and page >= 0 and page < page_count(path) implies result > 0
            return 0 if not path_valid(path) or page < 0 or page >= page_count(path)
            first: usize = (page * Limit::LINES_PER_PAGE).usize()
            total: usize = line_count(path)
            remaining: usize = total - first
            Limit::LINES_PER_PAGE if remaining >= Limit::LINES_PER_PAGE.usize() else remaining.i64()

        def panel_row_box(panel: Geometry, row: i64) -> Geometry:
            requires row >= 0 and row < Limit::LINES_PER_PAGE
            return Geometry{x: panel.x, y: panel.y, w: 0.0, h: 0.0} if not panel_supported(panel)
            inset: f32 = panel_inset(panel)
            stride: f32 = 32.0 if panel.h >= 340.0 else (panel.h - 152.0) / Limit::LINES_PER_PAGE.f32()
            row_height: f32 = 24.0 if stride >= 26.0 else stride - 2.0
            Geometry{x: panel.x + inset, y: panel.y + 62.0 + row.f32() * stride,
                w: panel.w - inset * 2.0, h: row_height}

        def panel_button_box(panel: Geometry, action: i64) -> Geometry:
            requires action >= 0 and action < 3
            inset: f32 = panel_inset(panel)
            gap: f32 = 8.0 if panel.w > 80.0 else 0.0
            width: f32 = (panel.w - inset * 2.0 - gap * 2.0) / 3.0 if panel.w > inset * 2.0 + gap * 2.0 else 0.0
            height: f32 = 30.0 if panel.h >= 350.0 else 26.0 if panel.h >= 40.0 else 0.0
            Geometry{x: panel.x + inset + action.f32() * (width + gap),
                y: panel.y + (panel.h - height - 14.0 if panel.h >= height + 14.0 else 0.0), w: width, h: height}

        def review_inspect_box(review: Geometry) -> Geometry:
            inset: f32 = panel_inset(review)
            available: f32 = review.w - inset * 2.0
            width: f32 = 150.0 if available >= 150.0 else available if available > 0.0 else 0.0
            height: f32 = 32.0 if review.h >= 46.0 else review.h - 14.0 if review.h >= 14.0 else 0.0
            Geometry{x: review.x + review.w - inset - width, y: review.y + 8.0 if review.h >= height + 8.0 else review.y,
                w: width, h: height}
