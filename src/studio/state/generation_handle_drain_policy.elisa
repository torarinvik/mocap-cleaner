include "generation_handle_policy.elisa"

module StudioGenerationHandleDrainPolicy:
    public:
        def may_retry(handle: i64, worker_active: bool) -> bool:
            ensure result == (handle > 0 and not worker_active)
            handle > 0 and not worker_active

        def may_reconcile(handle: i64, release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure result == (handle == 0 and StudioGenerationHandlePolicy::release_certain(release))
            handle == 0 and StudioGenerationHandlePolicy::release_certain(release)
