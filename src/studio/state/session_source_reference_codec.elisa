# Bounded versioned source metadata record used by session v5. Paths and the
# selected animation name are hex encoded so filesystem bytes never alter the
# line grammar; digest fields remain canonical ASCII SHA-256 hex.
include "../take_source_ref_policy.elisa"

module SessionSourceReferenceCodec:
    public:
        const module Limit:
            LINE_BYTES: usize = 20000
            ANIMATION_BYTES: usize = 1024
            TOKEN_COUNT: usize = 9

        affine struct Record:
            reference: StudioTakeSourceRefPolicy::TakeSourceRef
            animation_name: darray[u8]

        private:
            struct Token:
                start: usize
                end: usize

            def token_count(token: Token) -> usize:
                ensure result <= Limit::LINE_BYTES
                ensure token.start <= token.end
                token.end - token.start

            def token_valid(line: darray[u8]&, token: Token) -> bool:
                ensure result implies token.start <= token.end and token.end <= line.count
                token.start <= token.end and token.end <= line.count

            def token_byte(line: darray[u8]&, token: Token, index: usize) -> u8:
                ensure token_valid(line, token) and index < token_count(token)
                line[token.start + index]

            const module Hex:
                PREFIX: sview = "source-ref-v1"

            def byte_is_hex(byte: u8) -> bool:
                (byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)

            def hex_digit(value: u8) -> u8:
                return 48 + value if value < 10
                87 + value

            def hex_value(value: u8) -> i64:
                return value.i64() - 48 if value >= 48 and value <= 57
                return value.i64() - 87 if value >= 97 and value <= 102
                -1

            def token_equal(line: darray[u8]&, token: Token, expected: sview) -> bool:
                return false if token_count(token) != expected.len.usize()
                for index in 0..<token_count(token) |index, line, expected|:
                    return false if token_byte(line, token, index) != expected[index].u8()
                true

            def name_valid(value: darray[u8]&) -> bool:
                return false if value.count == 0 or value.count > Limit::ANIMATION_BYTES
                for byte in value:
                    return false if byte == 0 or byte < 32 or byte == 127
                utf8_valid(value)

            def continuation(byte: u8) -> bool:
                byte >= 128 and byte <= 191

            def utf8_valid(value: darray[u8]&) -> bool:
                mutable index: usize = 0
                while index < value.count:
                    first: u8 = value[index]
                    if first <= 127:
                        index <- index + 1
                    elif first >= 194 and first <= 223:
                        return false if index + 1 >= value.count or not continuation(value[index + 1])
                        index <- index + 2
                    elif first == 224:
                        return false if index + 2 >= value.count or value[index + 1] < 160 or value[index + 1] > 191 or not continuation(value[index + 2])
                        index <- index + 3
                    elif first >= 225 and first <= 236 or first >= 238 and first <= 239:
                        return false if index + 2 >= value.count or not continuation(value[index + 1]) or not continuation(value[index + 2])
                        index <- index + 3
                    elif first == 237:
                        return false if index + 2 >= value.count or value[index + 1] < 128 or value[index + 1] > 159 or not continuation(value[index + 2])
                        index <- index + 3
                    elif first == 240:
                        return false if index + 3 >= value.count or value[index + 1] < 144 or value[index + 1] > 191 or not continuation(value[index + 2]) or not continuation(value[index + 3])
                        index <- index + 4
                    elif first >= 241 and first <= 243:
                        return false if index + 3 >= value.count or not continuation(value[index + 1]) or not continuation(value[index + 2]) or not continuation(value[index + 3])
                        index <- index + 4
                    elif first == 244:
                        return false if index + 3 >= value.count or value[index + 1] < 128 or value[index + 1] > 143 or not continuation(value[index + 2]) or not continuation(value[index + 3])
                        index <- index + 4
                    else:
                        return false
                true

            def push_hex(value: darray[u8]&, output: mutable darray[u8]&) -> void can Memory.Allocate:
                for byte in value |byte, output|:
                    output.push(hex_digit(byte / 16))
                    output.push(hex_digit(byte % 16))

            def decode_hex(line: darray[u8]&, value: Token, maximum: usize, allow_empty: bool) -> darray[u8]? can Memory.Allocate:
                length: usize = token_count(value)
                return null if length == 0 or length % 2 != 0
                return null if length / 2 > maximum
                mutable decoded: darray[u8] = []
                for index in 0..<(length / 2) |index, line, decoded|:
                    high: i64 = hex_value(token_byte(line, value, index * 2))
                    low: i64 = hex_value(token_byte(line, value, index * 2 + 1))
                    return null if high < 0 or low < 0
                    decoded.push((high * 16 + low).u8())
                return null if decoded.count == 0 and not allow_empty
                decoded

            def split_tokens(line: darray[u8]&) -> darray[Token]? can Memory.Allocate:
                return null if line.count == 0 or line.count > Limit::LINE_BYTES
                mutable values: darray[Token] = []
                mutable start: usize = 0
                for index in 0..<line.count |index, line, values, start|:
                    byte: u8 = line[index]
                    if byte == 32:
                        return null if start == index or values.count >= Limit::TOKEN_COUNT - 1
                        values.push(Token{start: start, end: index})
                        start <- index + 1
                return null if start == line.count
                return null if values.count >= Limit::TOKEN_COUNT
                values.push(Token{start: start, end: line.count})
                values

            def put_separator(output: mutable darray[u8]&) -> void can Memory.Allocate:
                output.push(32)

        def encode(record: Record&, output: mutable darray[u8]&) -> bool can Memory.Allocate:
            ensure result implies output.count <= Limit::LINE_BYTES
            return false if not StudioTakeSourceRefPolicy::valid(record.reference) or not name_valid(record.animation_name)
            name_bytes: usize = record.animation_name.count * 2
            original_bytes: usize = record.reference.original_path.count * 2
            runtime_bytes: usize = record.reference.runtime_glb_path.count * 2
            importer_bytes: usize = 1 if record.reference.importer_revision.count == 0 else record.reference.importer_revision.count * 2
            options_bytes: usize = 1 if record.reference.options_sha256.count == 0 else record.reference.options_sha256.count
            required_bytes: usize = Hex::PREFIX.len.usize() + 8 + 1 + name_bytes + original_bytes + 64 + runtime_bytes + 64 + importer_bytes + options_bytes
            return false if required_bytes > Limit::LINE_BYTES
            output.clear()
            for byte in Hex::PREFIX:
                output.push(byte)
            put_separator(output)
            output.push(48 if record.reference.format == StudioTakeSourceRefPolicy::SourceFormat.DirectGlb else 49)
            put_separator(output)
            push_hex(record.animation_name, output)
            put_separator(output)
            push_hex(record.reference.original_path, output)
            put_separator(output)
            for byte in record.reference.original_sha256:
                output.push(byte)
            put_separator(output)
            push_hex(record.reference.runtime_glb_path, output)
            put_separator(output)
            for byte in record.reference.runtime_glb_sha256:
                output.push(byte)
            put_separator(output)
            if record.reference.importer_revision.count == 0:
                output.push(45)
            else:
                push_hex(record.reference.importer_revision, output)
            put_separator(output)
            if record.reference.options_sha256.count == 0:
                output.push(45)
            else:
                for byte in record.reference.options_sha256:
                    output.push(byte)
            output.count <= Limit::LINE_BYTES

        def has_prefix(line: darray[u8]&) -> bool:
            return false if line.count <= Hex::PREFIX.len.usize()
            for index in 0..<Hex::PREFIX.len.usize() |index, line|:
                return false if line[index] != Hex::PREFIX[index].u8()
            line[Hex::PREFIX.len.usize()] == 32

        def decode(line: darray[u8]&) -> Record? can Memory.Allocate:
            if split_tokens(line) is tokens:
                return null if tokens.count != 9 or not token_equal(line, tokens[0], Hex::PREFIX)
                mutable format: StudioTakeSourceRefPolicy::SourceFormat = StudioTakeSourceRefPolicy::SourceFormat.DirectGlb
                return null if token_count(tokens[1]) != 1 or (token_byte(line, tokens[1], 0) != 48 and token_byte(line, tokens[1], 0) != 49)
                format <- StudioTakeSourceRefPolicy::SourceFormat.FbxDerived if token_byte(line, tokens[1], 0) == 49
                if decode_hex(line, tokens[2], Limit::ANIMATION_BYTES, false) is animation:
                    return null if not name_valid(animation)
                    if decode_hex(line, tokens[3], StudioTakeSourceRefPolicy::Limit::PATH_BYTES, false) is original_path:
                        if decode_hex(line, tokens[5], StudioTakeSourceRefPolicy::Limit::PATH_BYTES, false) is runtime_path:
                            mutable importer: darray[u8] = []
                            mutable options: darray[u8] = []
                            if format == StudioTakeSourceRefPolicy::SourceFormat.FbxDerived:
                                if decode_hex(line, tokens[7], StudioTakeSourceRefPolicy::Limit::IMPORTER_REVISION_BYTES, false) is revision:
                                    importer <- move revision
                                else:
                                    return null
                                if token_count(tokens[8]) == 64:
                                    for index in 0..<token_count(tokens[8]) |index, line, options|:
                                        byte: u8 = token_byte(line, tokens[8], index)
                                        options.push(byte)
                                else:
                                    return null
                            else:
                                return null if not token_equal(line, tokens[7], "-") or not token_equal(line, tokens[8], "-")
                            mutable original_sha256: darray[u8] = []
                            mutable runtime_sha256: darray[u8] = []
                            return null if token_count(tokens[4]) != 64 or token_count(tokens[6]) != 64
                            for index in 0..<token_count(tokens[4]) |index, line, original_sha256|:
                                byte: u8 = token_byte(line, tokens[4], index)
                                return null if not byte_is_hex(byte)
                                original_sha256.push(byte)
                            for index in 0..<token_count(tokens[6]) |index, line, runtime_sha256|:
                                byte: u8 = token_byte(line, tokens[6], index)
                                return null if not byte_is_hex(byte)
                                runtime_sha256.push(byte)
                            reference: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefPolicy::TakeSourceRef{
                                format: format, original_path: move original_path, original_sha256: move original_sha256,
                                runtime_glb_path: move runtime_path, runtime_glb_sha256: move runtime_sha256,
                                importer_revision: move importer, options_sha256: move options}
                            return null if not StudioTakeSourceRefPolicy::valid(reference)
                            decoded: Record = Record{reference: reference, animation_name: move animation}
                            return move decoded
            null
