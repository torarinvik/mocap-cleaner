# Receipt parent identity always describes the original destination. The
# source descriptor can instead name managed quarantine during recovery.
module StudioGenerationRecoveryParentPolicy:
    public:
        const enum SourceLocation of i64:
            Original = 0
            Quarantine = 1

        def source_parent_matches(location: SourceLocation,
                                  matches_original: bool,
                                  matches_managed_items: bool) -> bool:
            ensure result == ((location == SourceLocation.Original and matches_original) or (location == SourceLocation.Quarantine and matches_managed_items))
            (location == SourceLocation.Original and matches_original) or (location == SourceLocation.Quarantine and matches_managed_items)

        def parents_verified(location: SourceLocation,
                             matches_original: bool,
                             matches_managed_items: bool,
                             original_parent_rebound: bool) -> bool:
            ensure result == (source_parent_matches(location, matches_original, matches_managed_items) and original_parent_rebound)
            source_parent_matches(location, matches_original, matches_managed_items) and original_parent_rebound
