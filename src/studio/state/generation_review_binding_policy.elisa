include "../build_generation_trash_binding_policy.elisa"

# Admission for journal preparation after full identity matching under the
# native transaction's retained locks. A fresh provider row alone is insufficient.
module StudioGenerationReviewBindingPolicy:
    public:
        struct Review:
            selected: bool
            reviewed: bool
            confirmed: bool
            inventory_revision: i64
            confirmed_revision: i64
            reviewed_retention_days: i64
            current_retention_days: i64

        def review_current(review: Review) -> bool:
            ensure result == (review.selected and review.reviewed and review.confirmed and review.inventory_revision >= 0 and review.confirmed_revision == review.inventory_revision and review.reviewed_retention_days >= 0 and review.current_retention_days == review.reviewed_retention_days)
            review.selected and review.reviewed and review.confirmed and review.inventory_revision >= 0 and review.confirmed_revision == review.inventory_revision and review.reviewed_retention_days >= 0 and review.current_retention_days == review.reviewed_retention_days

        def may_prepare_intent(review: Review,
                               begin: StudioBuildGenerationTrashBindingPolicy::BeginEvidence,
                               identity_check: StudioBuildGenerationTrashBindingPolicy::DecodedStatus) -> bool:
            ensure result == (review_current(review) and StudioBuildGenerationTrashBindingPolicy::begin_evidence_admitted(begin) and identity_check.known and identity_check.status == StudioBuildGenerationTrashNative::Status.Acquired)
            review_current(review) and StudioBuildGenerationTrashBindingPolicy::begin_evidence_admitted(begin) and identity_check.known and identity_check.status == StudioBuildGenerationTrashNative::Status.Acquired
