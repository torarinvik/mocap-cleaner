# Paging changes inspection only. Eligibility and mutation remain separate.
module StudioGenerationReviewListPolicy:
    public:
        const module Limit:
            ROWS: i64 = 512
            PAGE_ROWS: i64 = 32

        def page_count(count: i64) -> i64:
            ensure result >= 0 and result <= 16
            ensure count <= 0 or count > Limit::ROWS implies result == 0
            return 0 if count <= 0 or count > Limit::ROWS
            (count - 1) / Limit::PAGE_ROWS + 1

        def first_row(count: i64, page: i64) -> i64:
            ensure result >= -1 and result <= 480
            ensure result == -1 or (result >= 0 and result < count)
            return -1 if page < 0 or page >= page_count(count)
            page * Limit::PAGE_ROWS

        def visible_rows(count: i64, page: i64) -> i64:
            ensure result >= 0 and result <= Limit::PAGE_ROWS
            first: i64 = first_row(count, page)
            return 0 if first < 0
            remaining: i64 = count - first
            return Limit::PAGE_ROWS if remaining > Limit::PAGE_ROWS
            remaining

        def inspection_target(count: i64, page: i64, slot: i64) -> i64:
            ensure result >= -1 and result < Limit::ROWS
            ensure result == -1 or (result >= 0 and result < count)
            return -1 if slot < 0 or slot >= visible_rows(count, page)
            first_row(count, page) + slot

        def may_review(snapshot_complete: bool, row_valid: bool,
                       eligible: bool, scan_current: bool, busy: bool) -> bool:
            ensure result == (snapshot_complete and row_valid and eligible and scan_current and not busy)
            snapshot_complete and row_valid and eligible and scan_current and not busy
