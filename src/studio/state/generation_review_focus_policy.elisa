# Eight keyboard focus positions: seven footer controls and the header path action.
module StudioGenerationReviewFocusPolicy:
    public:
        const module Limit:
            COUNT: i64 = 8
            FOOTER_COUNT: i64 = 7
            PATH: i64 = 7

        def valid(index: i64) -> bool:
            ensure result == (index >= 0 and index < Limit::COUNT)
            index >= 0 and index < Limit::COUNT

        def next(current: i64, reverse: bool, enabled: darray[bool]&) -> i64:
            requires enabled.count.i64() == Limit::COUNT
            ensure result == -1 or (valid(result) and enabled[result.usize()])
            direction: i64 = -1 if reverse else 1
            base: i64 = current if valid(current) else 0 if reverse else -1
            mutable distance: i64 = 1
            while distance <= Limit::COUNT:
                candidate: mutable i64 = base + direction * distance
                candidate <- candidate + Limit::COUNT if candidate < 0
                candidate <- candidate - Limit::COUNT if candidate >= Limit::COUNT
                return candidate if enabled[candidate.usize()]
                distance <- distance + 1
            -1

        def trigger_focus(current: i64) -> i64:
            ensure result == (Limit::PATH if current == Limit::PATH else -1)
            Limit::PATH if current == Limit::PATH else -1

        def restore_focus(saved: i64) -> i64:
            ensure result == (saved if valid(saved) else -1)
            saved if valid(saved) else -1
