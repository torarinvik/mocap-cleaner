# A persisted finding annotation is tied to source-bound session identity and
# the complete detector row. No process-local build counter is serialized.
# Bump ANALYSIS_SCHEMA when detector finding semantics change.
include "../issues.elisa"

module SessionIssueAnnotationPolicy:
    public:
        const module Capacity:
            MAX_RECORDS: i64 = 256
        const module Domain:
            MAX_SEVERITY: i64 = 1000
            MAX_FRAMES: i64 = 10000000
        const ANALYSIS_SCHEMA: i64 = 2

        struct Record:
            first_frame: i64
            last_frame: i64
            issue_type: i64
            subject_id: i64
            peak_frame: i64
            severity: i64
            peak_value: i64
            threshold: i64

        struct Stored:
            analysis_frames: i64
            finding: Record

        def interval_valid(r: Record, frame_count: i64) -> bool:
            ensure result == (r.first_frame >= 0 and r.first_frame <= r.last_frame and r.last_frame < frame_count and r.peak_frame >= r.first_frame and r.peak_frame <= r.last_frame)
            return r.first_frame >= 0 and r.first_frame <= r.last_frame and r.last_frame < frame_count and r.peak_frame >= r.first_frame and r.peak_frame <= r.last_frame

        def values_valid(r: Record) -> bool:
            ensure result == (r.issue_type >= 0 and r.subject_id >= -1 and r.severity >= 0 and r.severity <= Domain::MAX_SEVERITY and r.peak_value >= 0 and r.threshold >= 0)
            return r.issue_type >= 0 and r.subject_id >= -1 and r.severity >= 0 and r.severity <= Domain::MAX_SEVERITY and r.peak_value >= 0 and r.threshold >= 0

        def valid(r: Record, frame_count: i64) -> bool:
            return frame_count >= 1 and frame_count <= Domain::MAX_FRAMES and interval_valid(r, frame_count) and values_valid(r)

        # The outer tag-6 identity binds source bytes, animation, source frame
        # count and rig; Stored.analysis_frames binds the retimed output.
        def same_interval(a: Record, b: Record) -> bool:
            ensure result == (a.first_frame == b.first_frame and a.last_frame == b.last_frame and a.peak_frame == b.peak_frame)
            return a.first_frame == b.first_frame and a.last_frame == b.last_frame and a.peak_frame == b.peak_frame

        def same_issue_kind(a: Record, b: Record) -> bool:
            ensure result == (a.issue_type == b.issue_type and a.subject_id == b.subject_id)
            return a.issue_type == b.issue_type and a.subject_id == b.subject_id

        def same_measurement(a: Record, b: Record) -> bool:
            ensure result == (a.severity == b.severity and a.peak_value == b.peak_value and a.threshold == b.threshold)
            return a.severity == b.severity and a.peak_value == b.peak_value and a.threshold == b.threshold

        def same_analysis(a: Record, b: Record) -> bool:
            ensure result == (same_interval(a, b) and same_issue_kind(a, b) and same_measurement(a, b))
            return same_interval(a, b) and same_issue_kind(a, b) and same_measurement(a, b)

        def output_frames_match(saved_frames: i64, current_frames: i64) -> bool:
            ensure result == (saved_frames == current_frames)
            return saved_frames == current_frames

        def record_from_issue(issue: StudioIssues::Issue) -> Record:
            Record{first_frame: issue.first_frame, last_frame: issue.last_frame, issue_type: issue.issue_type, subject_id: issue.subject_id, peak_frame: issue.peak_frame, severity: issue.severity, peak_value: issue.peak_value, threshold: issue.threshold}

        def stored_from_issue(issue: StudioIssues::Issue, analysis_frames: i64) -> Stored:
            Stored{analysis_frames: analysis_frames, finding: record_from_issue(issue)}

        # `source_revision` is intentionally omitted; it is process-local.
        def matches_issue(record: Stored, issue: StudioIssues::Issue, analysis_frames: i64) -> bool:
            issue.selectable and output_frames_match(record.analysis_frames, analysis_frames) and same_analysis(record.finding, record_from_issue(issue))
