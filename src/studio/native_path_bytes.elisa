include "export_batch_identity.elisa"

# Owned native path storage; refusal never returns an unterminated prefix.
module StudioNativePathBytes:
    public:
        def scanned_extent_admitted(count: usize, terminated_at_end: bool) -> bool:
            ensure result == (count > 0 and count <= StudioExportBatchIdentity::Limit::MAX_PATH_BYTES and terminated_at_end)
            count > 0 and count <= StudioExportBatchIdentity::Limit::MAX_PATH_BYTES and terminated_at_end

        def admitted(bytes: darray[u8]&) -> bool:
            return false if bytes.count == 0 or bytes.count > StudioExportBatchIdentity::Limit::MAX_PATH_BYTES
            for byte in bytes:
                return false if byte == 0
            true

        def terminated(bytes: darray[u8]&) -> darray[u8]:
            ensure not admitted(bytes) implies result.count == 0
            ensure admitted(bytes) implies result.count == bytes.count + 1
            mutable output: darray[u8] = []
            return output if not admitted(bytes)
            output.extend(bytes)
            output.push(0)
            output
