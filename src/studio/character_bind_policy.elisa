# Decisions behind drawing a separate character model over a take, as small
# proved kernels:
#   - how a model skin joint finds its clip rig slot: the same bare node
#     name wins over the same rig role (RigMap), and an unmatched joint has
#     none;
#   - how a skin joint is posed: by its own slot (DIRECT), rigidly with its
#     nearest bound ancestor (INHERITED), or held at its bind pose (REST);
#   - the share of skin joints bound by name or role, in permille, and
#     whether that is enough to draw the model (a model of an unrelated rig
#     would otherwise be drawn as a crumpled bind pose).
module StudioCharacterBind:
    public:
        const DIRECT: i64 = 0
        const INHERITED: i64 = 1
        const REST: i64 = 2

        const FULL: i64 = 1000
        # Draw the model only when at least half its skin joints are bound.
        const MIN_COVERAGE: i64 = 500

        # Clip slot for a skin joint, from its exact-name and role matches
        # (each a slot or -1).
        def match_slot(by_name: i64, by_role: i64) -> i64:
            ensure by_name < 0 or result == by_name
            ensure by_name >= 0 or result == by_role or result == -1
            ensure by_name >= 0 or by_role < 0 or result == by_role
            ensure result >= -1
            return by_name if by_name >= 0
            return by_role if by_role >= 0
            return -1

        # How a skin joint is posed, from its own slot and the slot of its
        # nearest bound ancestor (each -1 when none).
        def mode(own: i64, ancestor: i64) -> i64:
            ensure result >= DIRECT
            ensure result <= REST
            ensure own < 0 or result == DIRECT
            ensure own >= 0 or ancestor < 0 or result == INHERITED
            ensure own >= 0 or ancestor >= 0 or result == REST
            return DIRECT if own >= 0
            return INHERITED if ancestor >= 0
            return REST

        # A slot is usable against a rig of `count` slots.
        def slot_ok(slot: i64, count: i64) -> bool:
            ensure not result or slot >= 0
            ensure not result or slot < count
            ensure result or slot < 0 or slot >= count
            return slot >= 0 and slot < count

        # Permille of `total` skin joints bound directly.
        def coverage(bound: i64, total: i64) -> i64:
            requires bound >= 0
            requires bound <= total
            requires total <= 65535
            ensure result >= 0
            ensure result <= FULL
            ensure total <= 0 or bound != total or result == FULL
            ensure bound != 0 or result == 0
            return 0 if total <= 0
            return FULL if bound == total
            return bound * FULL / total

        # Whether a model with this coverage is drawn.
        def drawable(permille: i64) -> bool:
            ensure not result or permille >= MIN_COVERAGE
            ensure result or permille < MIN_COVERAGE
            return permille >= MIN_COVERAGE
