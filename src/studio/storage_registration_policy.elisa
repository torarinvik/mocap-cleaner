# Admission rules for adding completed Studio artifacts to the Storage inventory.
# Filesystem identity and canonical build-root facts come from the caller.
include "storage_receipt_policy.elisa"

module StudioStorageRegistrationPolicy:
    public:
        const ARTIFACT_SESSION: i64 = 0
        const ARTIFACT_FINAL_EXPORT: i64 = 1
        const ARTIFACT_EXPORT_REPORT: i64 = 2
        const ARTIFACT_COUNT: i64 = 3

        const KIND_RECOVERY: i64 = 0
        const KIND_GENERATED_REPORT: i64 = 2
        const KIND_INVALID: i64 = -1

        def artifact_valid(artifact: i64) -> bool:
            ensure result == (artifact >= 0 and artifact < ARTIFACT_COUNT)
            artifact >= 0 and artifact < ARTIFACT_COUNT

        # Session snapshots and report sidecars have existing receipt kinds.
        # A final GLB has no accurate kind in the current persisted schema.
        def receipt_kind(artifact: i64) -> i64:
            ensure result == (KIND_RECOVERY if artifact == ARTIFACT_SESSION else KIND_GENERATED_REPORT if artifact == ARTIFACT_EXPORT_REPORT else KIND_INVALID)
            KIND_RECOVERY if artifact == ARTIFACT_SESSION else KIND_GENERATED_REPORT if artifact == ARTIFACT_EXPORT_REPORT else KIND_INVALID

        # Registration follows a successful save/publication result plus a
        # fresh regular-file identity under build/. This does not assert that
        # the containing directory was fsynced for crash durability.
        def may_register(artifact: i64, write_succeeded: bool,
                        publication_complete: bool, canonical_under_build: bool,
                        identity_verified: bool, regular_file: bool,
                        symlink: bool) -> bool:
            ensure result == ((artifact == ARTIFACT_SESSION or artifact == ARTIFACT_EXPORT_REPORT) and write_succeeded and publication_complete and canonical_under_build and identity_verified and regular_file and not symlink)
            (artifact == ARTIFACT_SESSION or artifact == ARTIFACT_EXPORT_REPORT) and write_succeeded and publication_complete and canonical_under_build and identity_verified and regular_file and not symlink
