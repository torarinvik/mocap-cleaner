# Admission rules for adding completed Studio artifacts to the Storage inventory.
# Filesystem identity and canonical build-root facts come from the caller.
include "storage_receipt_policy.elisa"

module StudioStorageRegistrationPolicy:
    public:
        const enum Artifact of i64:
            Session = 0
            FinalExport = 1
            ExportReport = 2

        const module Format:
            ARTIFACT_COUNT: i64 = 3
            KIND_INVALID: i64 = -1

        def artifact_valid(artifact: i64) -> bool:
            ensure result == (artifact >= 0 and artifact < Format::ARTIFACT_COUNT)
            artifact >= 0 and artifact < Format::ARTIFACT_COUNT

        # Session snapshots and report sidecars have existing receipt kinds.
        # A final GLB has no accurate kind in the current persisted schema.
        def receipt_kind(artifact: i64) -> i64:
            ensure result == (StudioStorageReceiptPolicy::Kind.Recovery.i64() if artifact == Artifact.Session.i64() else StudioStorageReceiptPolicy::Kind.GeneratedReport.i64() if artifact == Artifact.ExportReport.i64() else Format::KIND_INVALID)
            StudioStorageReceiptPolicy::Kind.Recovery.i64() if artifact == Artifact.Session.i64() else StudioStorageReceiptPolicy::Kind.GeneratedReport.i64() if artifact == Artifact.ExportReport.i64() else Format::KIND_INVALID

        # Registration follows a successful save/publication result plus a
        # fresh regular-file identity under build/. This does not assert that
        # the containing directory was fsynced for crash durability.
        def may_register(artifact: i64, write_succeeded: bool,
                        publication_complete: bool, canonical_under_build: bool,
                        identity_verified: bool, regular_file: bool,
                        symlink: bool) -> bool:
            ensure result == ((artifact == Artifact.Session.i64() or artifact == Artifact.ExportReport.i64()) and write_succeeded and publication_complete and canonical_under_build and identity_verified and regular_file and not symlink)
            (artifact == Artifact.Session.i64() or artifact == Artifact.ExportReport.i64()) and write_succeeded and publication_complete and canonical_under_build and identity_verified and regular_file and not symlink
