include "accessibility.elisa"
include "session_locate_policy.elisa"

# Native dialog identity for the source Locate workflow. The range sits in
# the unused Studio semantic-ID block after destination inspection.
module StudioSessionLocateAccessibilityPolicy:
    public:
        const module Node:
            DIALOG: usize = 114
            CHOICE_FIRST: usize = 115
            CHOICE_COUNT: usize = 4
            LAST: usize = CHOICE_FIRST + CHOICE_COUNT - 1

        def is_node(id: usize) -> bool:
            id == Node::DIALOG or (id >= Node::CHOICE_FIRST and id <= Node::LAST)

        def choice_id(choice: StudioSessionLocatePolicy::Choice) -> usize:
            requires choice == StudioSessionLocatePolicy::Choice.Locate or choice == StudioSessionLocatePolicy::Choice.OpenAsNewTake or choice == StudioSessionLocatePolicy::Choice.RestoreSession or choice == StudioSessionLocatePolicy::Choice.Cancel
            ensure result == Node::CHOICE_FIRST + (choice.i64() - 1).usize()
            Node::CHOICE_FIRST + (choice.i64() - 1).usize()

        def choice_for_id(id: usize) -> StudioSessionLocatePolicy::Choice?:
            return null if id < Node::CHOICE_FIRST or id > Node::LAST
            return StudioSessionLocatePolicy::Choice.Locate if id == choice_id(StudioSessionLocatePolicy::Choice.Locate)
            return StudioSessionLocatePolicy::Choice.OpenAsNewTake if id == choice_id(StudioSessionLocatePolicy::Choice.OpenAsNewTake)
            return StudioSessionLocatePolicy::Choice.RestoreSession if id == choice_id(StudioSessionLocatePolicy::Choice.RestoreSession)
            StudioSessionLocatePolicy::Choice.Cancel

        def parent_id(id: usize) -> usize:
            return StudioAccessibility::SemanticId::NO_NODE if id == Node::DIALOG
            return Node::DIALOG if id >= Node::CHOICE_FIRST and id <= Node::LAST
            StudioAccessibility::SemanticId::NO_NODE

        def first_child_id() -> usize:
            Node::CHOICE_FIRST

        def next_sibling_id(id: usize) -> usize:
            return id + 1 if id >= Node::CHOICE_FIRST and id < Node::LAST
            StudioAccessibility::SemanticId::NO_NODE

        def ids_fit_reserved_range() -> bool:
            ensure result
            Node::DIALOG + 1 == Node::CHOICE_FIRST and Node::CHOICE_FIRST + Node::CHOICE_COUNT - 1 == Node::LAST and Node::LAST < StudioAccessibility::SemanticId::NO_NODE
