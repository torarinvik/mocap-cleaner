# Cut validated UTF-8 path previews only at character boundaries.
module StudioPathPreviewPolicy:
    public:
        const module Encoding:
            CONTINUATION_MIN: i64 = 128
            CONTINUATION_MAX: i64 = 191

        def continuation(byte: u8) -> bool:
            ensure result == (byte.i64() >= Encoding::CONTINUATION_MIN and byte.i64() <= Encoding::CONTINUATION_MAX)
            byte.i64() >= Encoding::CONTINUATION_MIN and byte.i64() <= Encoding::CONTINUATION_MAX
