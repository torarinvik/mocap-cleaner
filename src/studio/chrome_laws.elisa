# Laws of the studio chrome: Escape always cancels something while anything
# is open, and pressing it enough times reaches "nothing to cancel"; the
# first-run screen shows exactly when no clip is loaded; the status clock
# never runs backwards; the preset gain is a fair share; session fields
# always land in range and leave good values alone; the help sheet opens
# and closes cleanly.
include "chrome.elisa"

module StudioChromeLaws:
    public:
        # Escape with the help sheet open closes the help sheet first, even
        # in the middle of a drag.
        def help_closes_before_drag(dragging: bool, pressing: bool, gizmo: bool, selected: bool) -> bool:
            ensure result
            return StudioChrome::escape_layer(true, dragging, pressing, gizmo, selected) == StudioChrome::EscapeLayer.Help

        # A drag in progress is cancelled before the gizmo mode is left.
        def drag_cancels_before_mode(pressing: bool, selected: bool) -> bool:
            ensure result
            return StudioChrome::escape_layer(false, true, pressing, true, selected) == StudioChrome::EscapeLayer.Drag

        # A contact-bar press is cancelled before the selection is cleared.
        def press_cancels_before_selection(gizmo: bool) -> bool:
            ensure result
            return StudioChrome::escape_layer(false, false, true, gizmo, true) == StudioChrome::EscapeLayer.Press

        # Escape always cancels something while anything is open: each
        # layer alone is cancelled.
        def lone_drag_cancelled() -> bool:
            ensure result
            return StudioChrome::escape_layer(false, true, false, false, false) == StudioChrome::EscapeLayer.Drag

        def lone_press_cancelled() -> bool:
            ensure result
            return StudioChrome::escape_layer(false, false, true, false, false) == StudioChrome::EscapeLayer.Press

        def lone_gizmo_cancelled() -> bool:
            ensure result
            return StudioChrome::escape_layer(false, false, false, true, false) == StudioChrome::EscapeLayer.Gizmo

        # With nothing open Escape does nothing.
        def escape_idle_when_clear() -> bool:
            ensure result
            return StudioChrome::escape_layer(false, false, false, false, false) == StudioChrome::EscapeLayer.None

        # The selection alone is what Escape clears last.
        def selection_is_last() -> bool:
            ensure result
            return StudioChrome::escape_layer(false, false, false, false, true) == StudioChrome::EscapeLayer.Select

        # The gizmo mode is left before the selection is cleared.
        def gizmo_before_selection() -> bool:
            ensure result
            return StudioChrome::escape_layer(false, false, false, true, true) == StudioChrome::EscapeLayer.Gizmo

        # A loaded clip always shows the editor, failed or not.
        def loaded_shows_editor(failed: bool) -> bool:
            ensure result
            return StudioChrome::chrome_screen(true, failed) == StudioChrome::Screen.Edit

        # First run (nothing loaded, nothing failed) shows the guide.
        def first_run_shows_guide() -> bool:
            ensure result
            return StudioChrome::chrome_screen(false, false) == StudioChrome::Screen.Empty

        # A failed load says so instead of showing an empty editor.
        def failure_is_shown() -> bool:
            ensure result
            return StudioChrome::chrome_screen(false, true) == StudioChrome::Screen.Failed

        # The first frame is at time zero.
        def clock_starts_at_zero(rate: i64) -> i64:
            requires rate >= 1
            requires rate <= StudioChrome::Frame::MAX_RATE
            ensure result == 0
            return StudioChrome::clip_millis(0, rate)

        # Frame labels are one-based: the first frame is "1".
        def first_frame_label(count: i64) -> i64:
            requires count >= 1
            requires count <= StudioChrome::Frame::MAX_FRAMES
            ensure result == 1
            return StudioChrome::shown_frame(0, count)

        # The last frame's label is the frame count.
        def last_frame_label(count: i64) -> bool:
            requires count >= 1
            requires count <= StudioChrome::Frame::MAX_FRAMES
            ensure result
            return StudioChrome::shown_frame(count - 1, count) == count

        # Removing everything is a full gain.
        def full_clean_is_full(before: i64) -> i64:
            requires before >= 1
            requires before <= StudioChrome::Gain::MAX_MAGNITUDE
            ensure result == StudioChrome::Gain::PERMILLE
            return StudioChrome::clean_gain(before, 0)

        # An unchanged value gains nothing.
        def unchanged_gains_nothing(value: i64) -> bool:
            requires value >= 0
            requires value <= StudioChrome::Gain::MAX_MAGNITUDE
            ensure result
            return StudioChrome::clean_gain(value, value) == 0

        # A worse result never shows as a gain.
        def worse_gains_nothing(before: i64, after: i64) -> bool:
            requires before >= 0
            requires before <= StudioChrome::Gain::MAX_MAGNITUDE
            requires after >= before
            requires after <= StudioChrome::Gain::MAX_MAGNITUDE
            ensure result
            return StudioChrome::clean_gain(before, after) == 0

        # Nothing to clean gains nothing.
        def clean_take_gains_nothing(after: i64) -> i64:
            requires after >= 0
            requires after <= StudioChrome::Gain::MAX_MAGNITUDE
            ensure result == 0
            return StudioChrome::clean_gain(0, after)

        # Every gain is a share between none and all.
        def gain_is_share(before: i64, after: i64) -> bool:
            requires before >= 0
            requires before <= StudioChrome::Gain::MAX_MAGNITUDE
            requires after >= 0
            requires after <= StudioChrome::Gain::MAX_MAGNITUDE
            ensure result
            return StudioChrome::clean_gain(before, after) >= 0 and StudioChrome::clean_gain(before, after) <= StudioChrome::Gain::PERMILLE

        # Every operation kind the stack knows round-trips the session file.
        def known_kinds_load(code: i64) -> bool:
            requires code >= 0
            requires code < StudioChrome::Session::KINDS
            ensure result
            return StudioChrome::session_kind_ok(code)

        # Unknown kinds are skipped, not guessed.
        def unknown_kind_skipped(code: i64) -> bool:
            requires code >= StudioChrome::Session::KINDS
            ensure not result
            return StudioChrome::session_kind_ok(code)

        def negative_kind_skipped(code: i64) -> bool:
            requires code < 0
            ensure not result
            return StudioChrome::session_kind_ok(code)

        # A saved strength in range loads unchanged.
        def strength_round_trips(value: i64) -> bool:
            requires value >= 1
            requires value <= StudioChrome::Session::MAX_STRENGTH
            ensure result
            return StudioChrome::session_strength(value) == value

        # A damaged strength still loads in range.
        def strength_in_range(value: i64) -> bool:
            ensure result
            return StudioChrome::session_strength(value) >= 1 and StudioChrome::session_strength(value) <= StudioChrome::Session::MAX_STRENGTH

        # A saved edge in range loads unchanged.
        def edge_round_trips(value: i64) -> bool:
            requires value >= 0
            requires value <= StudioChrome::Session::MAX_EDGE
            ensure result
            return StudioChrome::session_edge(value) == value

        def edge_in_range(value: i64) -> bool:
            ensure result
            return StudioChrome::session_edge(value) >= 0 and StudioChrome::session_edge(value) <= StudioChrome::Session::MAX_EDGE

        # Known bone masks load unchanged; a damaged one loads as all bones.
        def legs_mask_round_trips(mask: i64) -> i64:
            requires mask == 2
            ensure result == 2
            return StudioChrome::session_bones(mask)

        def upper_mask_round_trips(mask: i64) -> i64:
            requires mask == 1
            ensure result == 1
            return StudioChrome::session_bones(mask)

        def damaged_mask_is_all(mask: i64) -> i64:
            requires mask > 2
            ensure result + 1 == 0
            return StudioChrome::session_bones(mask)

        # A saved scope frame inside the clip loads unchanged.
        def frame_round_trips(value: i64, count: i64) -> bool:
            requires count >= 1
            requires count <= StudioChrome::Frame::MAX_FRAMES
            requires value >= 0
            requires value < count
            ensure result
            return StudioChrome::session_frame(value, count) == value

        # A session saved on a longer take lands on this take's last frame.
        def long_scope_lands_on_end(value: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= StudioChrome::Frame::MAX_FRAMES
            requires value >= count
            ensure result + 1 == count
            return StudioChrome::session_frame(value, count)

        # "?" opens a closed help sheet and closes an open one.
        def question_opens(open: bool) -> bool:
            requires not open
            ensure result
            return StudioChrome::help_after(open, true, false)

        def question_closes(open: bool) -> bool:
            requires open
            ensure not result
            return StudioChrome::help_after(open, true, false)

        # Escape always closes the help sheet.
        def escape_closes_help(open: bool, question: bool) -> bool:
            ensure not result
            return StudioChrome::help_after(open, question, true)

        # Other keys leave the help sheet as it was.
        def other_keys_keep_open(open: bool) -> bool:
            requires open
            ensure result
            return StudioChrome::help_after(open, false, false)

        def other_keys_keep_closed(open: bool) -> bool:
            requires not open
            ensure not result
            return StudioChrome::help_after(open, false, false)

        # Old (version 1) and current session files load; a newer or
        # garbled version is refused.
        def version_one_loads(v: i64) -> bool:
            requires v == 1
            ensure result
            return StudioChrome::session_version_ok(v)

        def current_version_loads(v: i64) -> bool:
            requires v == StudioChrome::Session::VERSION
            ensure result
            return StudioChrome::session_version_ok(v)

        def future_version_refused(v: i64) -> bool:
            requires v > StudioChrome::Session::VERSION
            ensure not result
            return StudioChrome::session_version_ok(v)

        def zero_version_refused(v: i64) -> bool:
            requires v < 1
            ensure not result
            return StudioChrome::session_version_ok(v)

        def matching_session_source_restores(first: i64, second: i64, animation: i64, frames: i64, nodes: i64) -> bool:
            ensure result
            return StudioChrome::session_identity_matches(first, second, animation, frames, nodes, first, second, animation, frames, nodes)

        def changed_session_source_is_refused(saved_first: i64, current_first: i64, other: i64, animation: i64, frames: i64, nodes: i64) -> bool:
            requires saved_first != current_first
            ensure not result
            return StudioChrome::session_identity_matches(saved_first, other, animation, frames, nodes, current_first, other, animation, frames, nodes)

        def changed_session_animation_is_refused(fingerprint: i64, animation: i64, current_animation: i64, frames: i64, nodes: i64) -> bool:
            requires animation != current_animation
            ensure not result
            return StudioChrome::session_identity_matches(fingerprint, fingerprint, animation, frames, nodes, fingerprint, fingerprint, current_animation, frames, nodes)

        # A unit quaternion's saved components load unchanged.
        def quat_round_trips(value: i64, bound: i64) -> bool:
            requires bound == 1000000
            requires value + bound >= 0
            requires value <= bound
            ensure result
            return StudioChrome::session_clamp(value, bound) == value

        def quat_in_range(value: i64, bound: i64) -> i64:
            requires bound == 1000000
            ensure result + bound >= 0
            ensure result <= bound
            return StudioChrome::session_clamp(value, bound)

        # A damaged component saturates at the nearest bound.
        def big_quat_saturates(value: i64, bound: i64) -> i64:
            requires bound == 1000000
            requires value > bound
            ensure result == bound
            return StudioChrome::session_clamp(value, bound)

        # Translations within reach load unchanged; others are clamped.
        def offset_round_trips(value: i64, bound: i64) -> bool:
            requires bound >= 0
            requires bound <= StudioChrome::Correction::MAX_REACH
            requires value + bound >= 0
            requires value <= bound
            ensure result
            return StudioChrome::session_clamp(value, bound) == value

        def offset_in_range(value: i64, bound: i64) -> i64:
            requires bound >= 0
            requires bound <= StudioChrome::Correction::MAX_REACH
            ensure result + bound >= 0
            ensure result <= bound
            return StudioChrome::session_clamp(value, bound)

        def far_offset_saturates(value: i64, bound: i64) -> i64:
            requires bound == 1000000000
            requires value > bound
            ensure result == bound
            return StudioChrome::session_clamp(value, bound)

        # A zero offset (an untouched axis) is saved and loaded as zero.
        def zero_stays_zero(value: i64, bound: i64) -> i64:
            requires bound >= 0
            requires bound <= StudioChrome::Correction::MAX_REACH
            requires value == 0
            ensure result == 0
            return StudioChrome::session_clamp(value, bound)

        # A correction on a node of this document is kept; one on a node
        # beyond it (session from another rig) is dropped.
        def own_node_kept(node: i64, nodes: i64) -> bool:
            requires nodes >= 1
            requires nodes <= StudioChrome::Correction::MAX_NODES
            requires node >= 0
            requires node < nodes
            ensure result
            return StudioChrome::session_node_ok(node, nodes)

        def foreign_node_dropped(node: i64, nodes: i64) -> bool:
            requires nodes >= 0
            requires nodes <= StudioChrome::Correction::MAX_NODES
            requires node >= nodes
            ensure not result
            return StudioChrome::session_node_ok(node, nodes)

        def negative_node_dropped(node: i64, nodes: i64) -> bool:
            requires nodes >= 0
            requires nodes <= StudioChrome::Correction::MAX_NODES
            requires node < 0
            ensure not result
            return StudioChrome::session_node_ok(node, nodes)

        # An empty document keeps no corrections at all.
        def empty_document_keeps_none(node: i64, nodes: i64) -> bool:
            requires nodes == 0
            ensure not result
            return StudioChrome::session_node_ok(node, nodes)

        # Despike and smoothing count passes.
        def despike_counts_passes(kind: i64) -> i64:
            requires kind == 0
            ensure result == StudioChrome::ParameterUnit.Passes
            return StudioChrome::param_unit(kind)

        def smooth_counts_passes(kind: i64) -> i64:
            requires kind == 3
            ensure result == StudioChrome::ParameterUnit.Passes
            return StudioChrome::param_unit(kind)

        # The seam window is a frame count.
        def seam_window_in_frames(kind: i64) -> i64:
            requires kind == 2
            ensure result == StudioChrome::ParameterUnit.Frames
            return StudioChrome::param_unit(kind)

        # Pinning has no strength.
        def pin_has_no_unit(kind: i64) -> i64:
            requires kind == 1
            ensure result == StudioChrome::ParameterUnit.None
            return StudioChrome::param_unit(kind)

        # Unknown kinds show no unit rather than a wrong one.
        def unknown_kind_has_no_unit(kind: i64) -> i64:
            requires kind > 5
            ensure result == StudioChrome::ParameterUnit.None
            return StudioChrome::param_unit(kind)

        def deviation_uses_channel_units() -> StudioChrome::ParameterUnit:
            ensure result == StudioChrome::ParameterUnit.ChannelMillionths
            StudioChrome::param_unit(4)

        # A legacy approximate wring reading is never negative.
        def wring_reading_nonnegative(limit: i64) -> i64:
            requires limit >= 0
            requires limit <= 1000000
            ensure result >= 0
            return StudioChrome::wring_degrees(limit)
