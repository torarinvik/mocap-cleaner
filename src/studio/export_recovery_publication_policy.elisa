# Scalar gates and outcome facts for prepared GLB recovery publication.
module StudioExportRecoveryPublicationPolicy:
    public:
        def prepared_binding_admitted(owned: bool, locked: bool,
                                      binding_matches: bool, prepared: bool,
                                      staging_matches: bool,
                                      destination_matches: bool) -> bool:
            ensure result == (owned and locked and binding_matches and prepared and staging_matches and destination_matches)
            owned and locked and binding_matches and prepared and staging_matches and destination_matches

        def durable_stage_admitted(published: bool, directory_synced: bool) -> bool:
            ensure result == (published and directory_synced)
            published and directory_synced

        def publication_preserved(published: bool, journal_written: bool) -> bool:
            ensure result == published
            published

