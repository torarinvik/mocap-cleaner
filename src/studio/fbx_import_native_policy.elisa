include "fbx_import_policy.elisa"
include "take_source_ref_policy.elisa"

module StudioFbxImportNativePolicy:
    public:
        def staging_output_valid(source: darray[u8]&, snapshot: darray[u8]&, destination: darray[u8]&, digest: darray[u8]&) -> bool:
            ensure result implies StudioFbxImportPolicy::terminated(snapshot, StudioFbxImportPolicy::Limit::PATH_BYTES)
            ensure result implies StudioFbxImportPolicy::terminated(destination, StudioFbxImportPolicy::Limit::PATH_BYTES)
            ensure result implies snapshot.count > 1 and snapshot.count.i64() <= StudioFbxImportPolicy::Limit::PATH_BYTES
            ensure result implies destination.count > 1 and destination.count.i64() <= StudioFbxImportPolicy::Limit::PATH_BYTES
            ensure result implies StudioTakeSourceRefPolicy::sha256_valid(digest)
            ensure result implies not StudioFbxImportPolicy::same_path(source, destination)
            ensure result implies not StudioFbxImportPolicy::same_path(source, snapshot)
            ensure result implies not StudioFbxImportPolicy::same_path(snapshot, destination)
            (StudioFbxImportPolicy::terminated(snapshot, StudioFbxImportPolicy::Limit::PATH_BYTES) and
                StudioFbxImportPolicy::terminated(destination, StudioFbxImportPolicy::Limit::PATH_BYTES) and
                StudioTakeSourceRefPolicy::sha256_valid(digest) and
                not StudioFbxImportPolicy::same_path(source, destination) and
                not StudioFbxImportPolicy::same_path(source, snapshot) and
                not StudioFbxImportPolicy::same_path(snapshot, destination))
