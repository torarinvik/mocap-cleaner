# Fail-closed admission for writes to Studio's reserved Storage metadata files.
# The caller establishes canonical path and filesystem identity facts.
module StudioStorageControlDestinationPolicy:
    public:
        const CONTROL_MANIFEST: i64 = 0
        const CONTROL_PREFERENCES: i64 = 1
        const CONTROL_EXEMPTIONS: i64 = 2
        const CONTROL_PERSISTENT_LOCK: i64 = 3
        const CONTROL_COUNT: i64 = 4

        def valid_control(control: i64) -> bool:
            ensure result == (control >= 0 and control < CONTROL_COUNT)
            control >= 0 and control < CONTROL_COUNT

        # `metadata_path_conflict` means the destination aliases a reserved
        # metadata path other than its exact target. Unknown filesystem facts
        # fail closed, including failed canonicalization or identity queries.
        def may_write(control: i64, canonical_destination_verified: bool,
                      metadata_path_conflict: bool, identity_alias: bool,
                      facts_known: bool) -> bool:
            ensure result == (control >= 0 and control < CONTROL_COUNT and canonical_destination_verified and not metadata_path_conflict and not identity_alias and facts_known)
            control >= 0 and control < CONTROL_COUNT and canonical_destination_verified and not metadata_path_conflict and not identity_alias and facts_known
