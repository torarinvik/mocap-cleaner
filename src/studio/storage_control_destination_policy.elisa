# Fail-closed admission for writes to Studio's reserved Storage metadata files.
# The caller establishes canonical path and filesystem identity facts.
module StudioStorageControlDestinationPolicy:
    public:
        # Artifact destinations are vetoed by matches or identity aliases for
        # the manifest, preferences, exemptions, or persistent lock, including
        # an exact match to a control's own path.
        # Unknown canonical-path or filesystem identity facts fail closed.
        def may_write_artifact(canonical_destination_verified: bool,
                               any_reserved_path_match: bool,
                               any_reserved_identity_alias: bool,
                               identity_unknown: bool) -> bool:
            ensure result == (canonical_destination_verified and not any_reserved_path_match and not any_reserved_identity_alias and not identity_unknown)
            canonical_destination_verified and not any_reserved_path_match and not any_reserved_identity_alias and not identity_unknown
