include "export_batch_queue_policy.elisa"

# Scalar UI invalidation context only. The binding remains the authority for
# all queue, identity, and publication decisions.
module StudioExportBatchDestinationInspectorTicketPolicy:
    public:
        struct Ticket:
            revision: i64
            index: i64
            attempt: i64
            state: StudioExportBatchQueuePolicy::ItemState
            warning_count: i64
            approved: bool

        def valid(ticket: Ticket, max_revision: i64, max_attempt: i64) -> bool:
            requires max_revision >= 0 and max_attempt >= 0
            ticket.revision >= 0 and ticket.revision <= max_revision and ticket.index >= 0 and ticket.index < StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and ticket.attempt >= 0 and ticket.attempt <= max_attempt and ticket.warning_count >= 0

        def current(captured: Ticket, observed: Ticket,
                    inspector_open: bool, sheet_open: bool,
                    max_revision: i64, max_attempt: i64) -> bool:
            requires max_revision >= 0 and max_attempt >= 0
            ensure result == (inspector_open and sheet_open and valid(captured, max_revision, max_attempt) and valid(observed, max_revision, max_attempt) and captured.revision == observed.revision and captured.index == observed.index and captured.attempt == observed.attempt and captured.state == observed.state and captured.warning_count == observed.warning_count and captured.approved == observed.approved)
            inspector_open and sheet_open and valid(captured, max_revision, max_attempt) and valid(observed, max_revision, max_attempt) and captured.revision == observed.revision and captured.index == observed.index and captured.attempt == observed.attempt and captured.state == observed.state and captured.warning_count == observed.warning_count and captured.approved == observed.approved
