# Owned, read-only value projection for the prepared-export controller.
include "export_batch_queue_policy.elisa"
include "export_batch_publication_policy.elisa"

module StudioExportBatchDisplayProjection:
    public:
        struct Snapshot:
            source_label: darray[u8]
            output_label: darray[u8]
            warning_json_bytes: darray[u8]
            warning_text_bytes: darray[u8]
            state: StudioExportBatchQueuePolicy::ItemState
            attempt: i64
            warning_count: i64
            approved: bool
            receipt: StudioExportBatchPublication::Receipt

        def copy_bytes(source: darray[u8]&) -> darray[u8]:
            ensure StudioExportBatchDisplayProjection::bytes_equal(result, source)
            mutable owned: darray[u8] = []
            owned.extend(source)
            owned

        def project(source_label: darray[u8]&, output_label: darray[u8]&, json_bytes: darray[u8]&, text_bytes: darray[u8]&, state: StudioExportBatchQueuePolicy::ItemState, attempt: i64, warning_count: i64, approved: bool, receipt: StudioExportBatchPublication::Receipt) -> Snapshot:
            requires attempt >= 0 and warning_count >= 0
            ensure bytes_equal(result.source_label, source_label)
            ensure bytes_equal(result.output_label, output_label)
            ensure bytes_equal(result.warning_json_bytes, json_bytes)
            ensure bytes_equal(result.warning_text_bytes, text_bytes)
            ensure result.state == state and result.attempt == attempt and result.warning_count == warning_count and result.approved == approved
            Snapshot{source_label: copy_bytes(source_label), output_label: copy_bytes(output_label), warning_json_bytes: copy_bytes(json_bytes), warning_text_bytes: copy_bytes(text_bytes), state: state, attempt: attempt, warning_count: warning_count, approved: approved, receipt: receipt}

        # Lightweight queue-row projection. Report payloads are fetched only
        # for the selected item's explicit warning-review route.
        def overview(source_label: darray[u8]&, output_label: darray[u8]&, state: StudioExportBatchQueuePolicy::ItemState, attempt: i64, warning_count: i64, approved: bool, receipt: StudioExportBatchPublication::Receipt) -> Snapshot:
            requires attempt >= 0 and warning_count >= 0
            ensure result.warning_json_bytes.count == 0 and result.warning_text_bytes.count == 0
            ensure bytes_equal(result.source_label, source_label) and bytes_equal(result.output_label, output_label)
            ensure result.state == state and result.attempt == attempt and result.warning_count == warning_count and result.approved == approved
            Snapshot{source_label: copy_bytes(source_label), output_label: copy_bytes(output_label), warning_json_bytes: [], warning_text_bytes: [], state: state, attempt: attempt, warning_count: warning_count, approved: approved, receipt: receipt}

        def bytes_equal(left: darray[u8]&, right: darray[u8]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            true
