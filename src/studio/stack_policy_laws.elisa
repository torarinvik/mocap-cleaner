# Laws of the operation-stack edit policy.
include "stack_policy.elisa"

module StackPolicyLaws:
    public:
        # The moved operation lands where it was asked to.
        def moved_lands(src: i64, dst: i64) -> i64:
            requires src >= 0
            requires src < StackPolicy::Limit::MAX_OPS
            requires dst >= 0
            requires dst < StackPolicy::Limit::MAX_OPS
            ensure result == 0
            return StackPolicy::move_source(dst, src, dst) - src

        # A move to the same slot changes nothing.
        def move_in_place(i: i64, at: i64) -> i64:
            requires i >= 0
            requires i < StackPolicy::Limit::MAX_OPS
            requires at >= 0
            requires at < StackPolicy::Limit::MAX_OPS
            ensure result == 0
            return StackPolicy::move_source(i, at, at) - i

        # Slots before both ends of a move are untouched.
        def move_keeps_prefix(i: i64, src: i64, dst: i64) -> i64:
            requires i >= 0
            requires src < StackPolicy::Limit::MAX_OPS
            requires dst < StackPolicy::Limit::MAX_OPS
            requires i < src
            requires i < dst
            ensure result == 0
            return StackPolicy::move_source(i, src, dst) - i

        # A zero move keeps the operation where it is.
        def zero_move(index: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= StackPolicy::Limit::MAX_OPS
            requires index >= 0
            requires index < count
            ensure result == index
            return StackPolicy::move_target(index, 0, count)

        # Removing never shows the removed slot again.
        def removed_is_gone(i: i64, at: i64) -> bool:
            requires i >= 0
            requires i < StackPolicy::Limit::MAX_OPS
            requires at >= 0
            requires at < StackPolicy::Limit::MAX_OPS
            ensure result
            s: i64 = StackPolicy::removed_source(i, at)
            return s < at or s > at

        # Inserting then removing the same slot is the identity on old slots.
        def insert_then_remove(i: i64, at: i64) -> i64:
            requires i >= 0
            requires i < StackPolicy::Limit::MAX_OPS
            requires at >= 0
            requires at < StackPolicy::Limit::MAX_OPS
            ensure result == 0
            r: i64 = StackPolicy::removed_source(i, at)
            s: i64 = StackPolicy::inserted_source(r, at)
            return s - i

        # Emptying the stack clears the selection.
        def last_remove_clears(selected: i64) -> i64:
            requires selected >= -1
            requires selected < 1
            ensure result == -1
            return StackPolicy::select_after_remove(selected, 0, 1)

        # A scope start already inside the clip is kept.
        def scope_first_fixed(first: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= StackPolicy::Limit::MAX_FRAMES
            requires first >= 0
            requires first < count
            ensure result == first
            return StackPolicy::scope_first(first, count)

        # A scope end already inside [first, count) is kept.
        def scope_last_fixed(first: i64, last: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= StackPolicy::Limit::MAX_FRAMES
            requires first >= 0
            requires first < count
            requires last >= first
            requires last < count
            ensure result == last
            return StackPolicy::scope_last(first, last, count)

        # Nudging by zero inside the range keeps the value.
        def nudge_zero(value: i64, lo: i64, hi: i64) -> i64:
            requires lo <= hi
            requires value >= lo
            requires value <= hi
            requires value >= -1000000000
            requires value <= 1000000000
            ensure result == value
            return StackPolicy::nudge(value, 0, lo, hi)

        # The bone-mask cycle returns after three presses.
        def mask_cycle() -> i64:
            ensure result == -1
            a: i64 = StackPolicy::next_mask(-1)
            b: i64 = StackPolicy::next_mask(a)
            return StackPolicy::next_mask(b)
