# Retention preferences are optional on first use, but corrupt/unsupported
# settings must not silently fall back to a more permissive retention preset.
include "storage_selection_policy.elisa"

module StudioStoragePreferencesPolicy:
    public:
        # Wire sentinels and digit encoding are distinct from valid presets.
        const module Format:
            INVALID: i64 = -1
            ASCII_ZERO: i64 = 48

        def valid_preset(preset: i64) -> bool:
            ensure result == (preset >= 0 and preset <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64())
            preset >= 0 and preset <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64()

        def decode_digit(byte: i64) -> i64:
            ensure result >= Format::INVALID and result <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64()
            ensure byte < Format::ASCII_ZERO or byte > Format::ASCII_ZERO + StudioStorageSelectionPolicy::RetentionPreset.Year.i64() or result + Format::ASCII_ZERO == byte
            ensure result == (byte - Format::ASCII_ZERO if byte >= Format::ASCII_ZERO and byte <= Format::ASCII_ZERO + StudioStorageSelectionPolicy::RetentionPreset.Year.i64() else Format::INVALID)
            return Format::INVALID if byte < Format::ASCII_ZERO or byte > Format::ASCII_ZERO + StudioStorageSelectionPolicy::RetentionPreset.Year.i64()
            byte - Format::ASCII_ZERO

        def encode_digit(preset: i64) -> i64:
            requires preset >= 0 and preset <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64()
            ensure result == preset + Format::ASCII_ZERO
            ensure result >= Format::ASCII_ZERO and result <= Format::ASCII_ZERO + StudioStorageSelectionPolicy::RetentionPreset.Year.i64()
            preset + Format::ASCII_ZERO

        def loaded_preset(file_missing: bool, decoded: i64) -> i64:
            ensure result == (StudioStorageSelectionPolicy::RetentionPreset.Default.i64() if file_missing else decoded if decoded >= 0 and decoded <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64() else Format::INVALID)
            return StudioStorageSelectionPolicy::RetentionPreset.Default.i64() if file_missing
            return Format::INVALID if decoded < 0 or decoded > StudioStorageSelectionPolicy::RetentionPreset.Year.i64()
            decoded

        def may_publish(prior_read_valid: bool, verified_settings_path: bool, preset: i64) -> bool:
            ensure result == (prior_read_valid and verified_settings_path and preset >= 0 and preset <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64())
            prior_read_valid and verified_settings_path and preset >= 0 and preset <= StudioStorageSelectionPolicy::RetentionPreset.Year.i64()
