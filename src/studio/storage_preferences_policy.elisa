# Retention preferences are optional on first use, but corrupt/unsupported
# settings must not silently fall back to a more permissive retention preset.
module StudioStoragePreferencesPolicy:
    public:
        const INVALID: i64 = -1
        const DEFAULT_PRESET: i64 = 1
        const LAST_PRESET: i64 = 3
        const ASCII_ZERO: i64 = 48

        def valid_preset(preset: i64) -> bool:
            ensure result == (preset >= 0 and preset <= LAST_PRESET)
            preset >= 0 and preset <= LAST_PRESET

        def decode_digit(byte: i64) -> i64:
            ensure result >= INVALID and result <= LAST_PRESET
            ensure byte < ASCII_ZERO or byte > ASCII_ZERO + LAST_PRESET or result + ASCII_ZERO == byte
            ensure result == (byte - ASCII_ZERO if byte >= ASCII_ZERO and byte <= ASCII_ZERO + LAST_PRESET else INVALID)
            return INVALID if byte < ASCII_ZERO or byte > ASCII_ZERO + LAST_PRESET
            byte - ASCII_ZERO

        def encode_digit(preset: i64) -> i64:
            requires preset >= 0 and preset <= LAST_PRESET
            ensure result == preset + ASCII_ZERO
            ensure result >= ASCII_ZERO and result <= ASCII_ZERO + LAST_PRESET
            preset + ASCII_ZERO

        def loaded_preset(file_missing: bool, decoded: i64) -> i64:
            ensure result == (DEFAULT_PRESET if file_missing else decoded if decoded >= 0 and decoded <= LAST_PRESET else INVALID)
            return DEFAULT_PRESET if file_missing
            return INVALID if decoded < 0 or decoded > LAST_PRESET
            decoded

        def may_publish(prior_read_valid: bool, verified_settings_path: bool, preset: i64) -> bool:
            ensure result == (prior_read_valid and verified_settings_path and preset >= 0 and preset <= LAST_PRESET)
            prior_read_valid and verified_settings_path and preset >= 0 and preset <= LAST_PRESET
