# Cancel transient studio gestures when the native window loses focus. Keep
# committed selection/tool state, but never let a missing pointer-up complete
# a scrub, contact edit, retime, camera drag or gizmo correction.
module StudioFocus:
    public:
        struct Interaction:
            modifiers: i64
            drag_view: i64
            drag_button: i64
            scrubbing: bool
            selecting: bool
            slider_drag: bool
            retime_speed: i64
            slider_start_speed: i64
            edge_drag_band: i64
            contact_press: bool
            gizmo_view: i64
            typing: bool
            selection_active: bool
            gizmo_mode: i64

        def keep_selection(active: bool, selecting: bool) -> bool:
            ensure selecting or result == active
            ensure not selecting or not result
            return false if selecting
            return active

        def after_focus_lost(s: Interaction) -> Interaction:
            ensure result.modifiers == 0
            ensure result.drag_view == -1
            ensure result.drag_button == -1
            ensure not result.scrubbing
            ensure not result.selecting
            ensure not result.slider_drag
            ensure not s.slider_drag or result.retime_speed == s.slider_start_speed
            ensure s.slider_drag or result.retime_speed == s.retime_speed
            ensure result.edge_drag_band == -1
            ensure not result.contact_press
            ensure result.gizmo_view == -1
            ensure not result.typing
            ensure s.selecting or result.selection_active == s.selection_active
            ensure not s.selecting or not result.selection_active
            ensure result.gizmo_mode == s.gizmo_mode
            return Interaction{
                modifiers: 0,
                drag_view: -1,
                drag_button: -1,
                scrubbing: false,
                selecting: false,
                slider_drag: false,
                retime_speed: s.slider_start_speed if s.slider_drag else s.retime_speed,
                slider_start_speed: s.slider_start_speed,
                edge_drag_band: -1,
                contact_press: false,
                gizmo_view: -1,
                typing: false,
                selection_active: keep_selection(s.selection_active, s.selecting),
                gizmo_mode: s.gizmo_mode
            }
