# Only an active request may replace feedback, including with a loaded take.
module StudioFbxFailureFeedbackPolicy:
    public:
        # A refused replacement still needs an explanation while the old take is open.
        def use_retained_status(message_bytes: i64) -> bool:
            ensure result == (message_bytes > 0)
            message_bytes > 0

        def use_retained_guide(failed: bool, message_bytes: i64) -> bool:
            ensure result == (failed and message_bytes > 0)
            failed and message_bytes > 0

        def may_replace_feedback(cancelled: bool, closing: bool,
                ticket: i64, current_ticket: i64) -> bool:
            ensure result == (not cancelled and not closing and ticket > 0 and ticket == current_ticket)
            not cancelled and not closing and ticket > 0 and ticket == current_ticket

        def show_failure(loaded: bool, cancelled: bool, closing: bool,
                ticket: i64, current_ticket: i64) -> bool:
            ensure result == (not loaded and not cancelled and not closing and ticket > 0 and ticket == current_ticket)
            not loaded and may_replace_feedback(cancelled, closing, ticket, current_ticket)

        def may_capture_setup_refusal(terminal: bool, cancelled: bool, closing: bool) -> bool:
            ensure result == (terminal and not cancelled and not closing)
            terminal and not cancelled and not closing
