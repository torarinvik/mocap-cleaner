# Keyboard and acknowledgement rules for the export review panel.
module StudioExportReview:
    public:
        const ACKNOWLEDGE: i64 = 0
        const CANCEL: i64 = 1
        const EXPORT: i64 = 2
        const FOCUS_COUNT: i64 = 3

        def initial_focus(warnings: i64) -> i64:
            requires warnings >= 0 and warnings <= 5
            ensure result >= ACKNOWLEDGE
            ensure result < FOCUS_COUNT
            return ACKNOWLEDGE if warnings > 0
            EXPORT

        # The review presents acknowledgement, cancel and export in a stable
        # order. Both directions wrap to make the compact panel keyboard-safe.
        def move_focus(current: i64, direction: i64, warnings: i64) -> i64:
            requires current >= ACKNOWLEDGE and current < FOCUS_COUNT
            requires direction == -1 or direction == 1
            requires warnings >= 0 and warnings <= 5
            requires warnings > 0 or current == CANCEL or current == EXPORT
            ensure result >= ACKNOWLEDGE
            ensure result < FOCUS_COUNT
            if warnings == 0:
                return EXPORT if current == CANCEL
                return CANCEL
            return CANCEL if current == ACKNOWLEDGE and direction == 1
            return EXPORT if current == CANCEL and direction == 1
            return ACKNOWLEDGE if current == EXPORT and direction == 1
            return EXPORT if current == ACKNOWLEDGE and direction == -1
            return ACKNOWLEDGE if current == CANCEL and direction == -1
            CANCEL

        def export_enabled(warnings: i64, acknowledged: bool) -> bool:
            requires warnings >= 0 and warnings <= 5
            ensure result == (warnings == 0 or acknowledged)
            warnings == 0 or acknowledged
