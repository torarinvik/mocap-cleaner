# Keyboard and acknowledgement rules for the export review panel.
module StudioExportReview:
    public:
        const ACKNOWLEDGE: i64 = 0
        const DESTINATION: i64 = 1
        const INSPECT_WARNINGS: i64 = 2
        const CANCEL: i64 = 3
        const EXPORT: i64 = 4
        const FOCUS_COUNT: i64 = 5
        const MAX_WARNINGS: i64 = 5
        const NO_WARNING: i64 = -1
        const BALANCE_WARNING: i64 = 0
        const SPIKE_WARNING: i64 = 1
        const FOOT_SLIDE_WARNING: i64 = 2
        const FOOT_SINK_WARNING: i64 = 3
        const HAND_SLIDE_WARNING: i64 = 4

        def initial_focus(warnings: i64) -> i64:
            requires warnings >= 0 and warnings <= MAX_WARNINGS
            ensure result >= ACKNOWLEDGE
            ensure result < FOCUS_COUNT
            return ACKNOWLEDGE if warnings > 0
            EXPORT

        # The five stable review controls surround a single inspector action;
        # the inspector itself pages through any number of present warnings.
        def move_focus(current: i64, direction: i64, warnings: i64) -> i64:
            requires current >= ACKNOWLEDGE and current < FOCUS_COUNT
            requires direction == -1 or direction == 1
            requires warnings >= 0 and warnings <= MAX_WARNINGS
            requires warnings > 0 or current == DESTINATION or current == CANCEL or current == EXPORT
            ensure result >= ACKNOWLEDGE and result < FOCUS_COUNT
            if warnings == 0:
                if direction == 1:
                    return CANCEL if current == DESTINATION
                    return EXPORT if current == CANCEL
                    DESTINATION
                return EXPORT if current == DESTINATION
                return DESTINATION if current == CANCEL
                CANCEL
            return current + 1 if direction == 1 and current + 1 < FOCUS_COUNT
            return ACKNOWLEDGE if direction == 1
            return current - 1 if current > ACKNOWLEDGE
            FOCUS_COUNT - 1

        def export_enabled(warnings: i64, acknowledged: bool) -> bool:
            requires warnings >= 0 and warnings <= MAX_WARNINGS
            ensure result == (warnings == 0 or acknowledged)
            warnings == 0 or acknowledged
