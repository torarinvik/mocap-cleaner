# Keyboard and acknowledgement rules for the export review panel.
module StudioExportReview:
    public:
        const enum Control of i64:
            ACKNOWLEDGE = 0
            DESTINATION = 1
            INSPECT_WARNINGS = 2
            CANCEL = 3
            EXPORT = 4
            QUEUE = 5

        const enum Warning of i64:
            NO_WARNING = -1
            BALANCE_WARNING = 0
            SPIKE_WARNING = 1
            FOOT_SLIDE_WARNING = 2
            FOOT_SINK_WARNING = 3
            HAND_SLIDE_WARNING = 4

        const module Limit:
            FOCUS_COUNT: i64 = 6
            MAX_WARNINGS: i64 = 5

        def initial_focus(warnings: i64) -> i64:
            requires warnings >= 0 and warnings <= Limit::MAX_WARNINGS
            ensure result >= Control.ACKNOWLEDGE.i64()
            ensure result < Limit::FOCUS_COUNT
            return Control.ACKNOWLEDGE.i64() if warnings > 0
            return Control.EXPORT.i64()

        # Stable review controls surround a single inspector action;
        # the inspector itself pages through any number of present warnings.
        def move_focus(current: i64, direction: i64, warnings: i64) -> i64:
            requires current >= Control.ACKNOWLEDGE.i64() and current < Limit::FOCUS_COUNT
            requires direction == -1 or direction == 1
            requires warnings >= 0 and warnings <= Limit::MAX_WARNINGS
            requires warnings > 0 or current == Control.DESTINATION.i64() or current == Control.CANCEL.i64() or current == Control.EXPORT.i64() or current == Control.QUEUE.i64()
            ensure result >= Control.ACKNOWLEDGE.i64() and result < Limit::FOCUS_COUNT
            if warnings == 0:
                if direction == 1:
                    return Control.CANCEL.i64() if current == Control.DESTINATION.i64()
                    return Control.EXPORT.i64() if current == Control.CANCEL.i64()
                    return Control.QUEUE.i64() if current == Control.EXPORT.i64()
                    return Control.DESTINATION.i64()
                return Control.QUEUE.i64() if current == Control.DESTINATION.i64()
                return Control.EXPORT.i64() if current == Control.QUEUE.i64()
                return Control.DESTINATION.i64() if current == Control.CANCEL.i64()
                return Control.CANCEL.i64()
            return current + 1 if direction == 1 and current + 1 < Limit::FOCUS_COUNT
            return Control.ACKNOWLEDGE.i64() if direction == 1
            return current - 1 if current > Control.ACKNOWLEDGE.i64()
            Limit::FOCUS_COUNT - 1

        def export_enabled(warnings: i64, acknowledged: bool) -> bool:
            requires warnings >= 0 and warnings <= Limit::MAX_WARNINGS
            ensure result == (warnings == 0 or acknowledged)
            warnings == 0 or acknowledged

        def publication_requested(control: i64) -> bool:
            ensure result == (control == Control.EXPORT.i64())
            control == Control.EXPORT.i64()
