# Laws of the studio's overlay decisions and the balance report rule.
include "overlay_policy.elisa"
include "../physics/balance.elisa"

module StudioOverlayLaws:
    public:
        # A detector-reported frame is always marked on the timeline.
        def impossible_is_marked(planted: bool, com_inside: bool) -> bool:
            ensure result
            return StudioOverlay::marked(StudioOverlay::state(planted, com_inside, true))

        # A balanced planted frame is never marked.
        def supported_is_clean() -> bool:
            ensure not result
            return StudioOverlay::marked(StudioOverlay::state(true, true, false))

        # Flight alone is never marked.
        def airborne_is_clean(com_inside: bool) -> bool:
            ensure not result
            return StudioOverlay::marked(StudioOverlay::state(false, com_inside, false))

        # Merging a frame into a bin never hides an impossible frame.
        def bin_keeps_impossible(level: i64) -> i64:
            requires level >= StudioOverlay::AIRBORNE
            requires level <= StudioOverlay::IMPOSSIBLE
            ensure result == StudioOverlay::IMPOSSIBLE
            return StudioOverlay::worst(level, StudioOverlay::IMPOSSIBLE)

        # Merging an airborne frame leaves a bin unchanged.
        def airborne_merge_is_identity(level: i64) -> i64:
            requires level >= StudioOverlay::AIRBORNE
            requires level <= StudioOverlay::IMPOSSIBLE
            ensure result == level
            return StudioOverlay::worst(level, StudioOverlay::AIRBORNE)

        # Cycling the curve mode twice returns to the start.
        def mode_cycles(mode: i64) -> i64:
            requires mode >= StudioOverlay::ROTATION
            requires mode < StudioOverlay::CURVE_MODES
            ensure result == mode
            return StudioOverlay::next_mode(StudioOverlay::next_mode(mode))

        # A bone with only a position channel shows it in either mode.
        def position_only_falls_back(mode: i64, position: i64) -> i64:
            requires position >= 0
            ensure result == position
            return StudioOverlay::channel(mode, -1, position)

        # A bone with no channel shows nothing.
        def no_channel(mode: i64) -> i64:
            ensure result == -1
            return StudioOverlay::channel(mode, -1, -1)

        # No preview without a selected bone.
        def no_bone_no_preview(view: i64, dragging: bool) -> bool:
            ensure not result
            return StudioOverlay::preview(view, dragging, -1)

        # A step onto new support is never reported, however long.
        def step_never_reported(run: i64, min_run: i64) -> bool:
            ensure not result
            return Balance::reported(run, min_run, true)

        # A long enough run without a step is reported.
        def long_run_reported(run: i64, min_run: i64) -> bool:
            requires run >= min_run
            ensure result
            return Balance::reported(run, min_run, false)
