module StudioExportRecoveryBindingPolicy:
    public:
        # Native ownership and transaction facts are supplied by the caller;
        # successful parsing alone cannot establish either fact.
        def admitted(owned: bool, locked: bool, directory_matches: bool,
                     journal_matches: bool, output_snapshot_matches: bool,
                     output_matches: bool, json_matches: bool, text_matches: bool) -> bool:
            ensure result == (owned and locked and directory_matches and journal_matches and output_snapshot_matches and output_matches and json_matches and text_matches)
            owned and locked and directory_matches and journal_matches and output_snapshot_matches and output_matches and json_matches and text_matches
