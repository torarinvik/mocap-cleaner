# Conservative reserved-path comparison for ASCII control-file names.
#
# Apple documents that APFS uses Unicode 9 normalization and case-insensitive
# lookup on default case-insensitive volumes. This kernel folds only ASCII
# A-Z. It catches ASCII uppercase/mixed-case aliases but does not model Unicode
# case folds or canonical-equivalence aliases (for example, long-s U+017F in
# "ſtudio_storage_manifest.txt"). Complete macOS coverage needs a native
# volume-aware Unicode namespace comparison at the filesystem boundary.
module StudioStorageReservedPathPolicy:
    public:
        def fold_ascii_byte(value: u8) -> u8:
            ensure result == (value + 32 if value >= 65 and value <= 90 else value)
            return value + 32 if value >= 65 and value <= 90
            value

        def ascii_bytes_equal(a: u8, b: u8) -> bool:
            ensure result == (fold_ascii_byte(a) == fold_ascii_byte(b))
            fold_ascii_byte(a) == fold_ascii_byte(b)

        # Compare complete canonical-parent paths. The caller must supply paths
        # whose parent components have already been canonicalized. Folding the
        # full byte path is conservative on case-sensitive volumes.
        def ascii_casefold_path_equal(a: darray[u8]&, b: darray[u8]&) -> bool:
            ensure not result or a.count == b.count
            return false if a.count != b.count
            for index in 0..<a.count |a, b|:
                return false if not ascii_bytes_equal(a[index], b[index])
            true
