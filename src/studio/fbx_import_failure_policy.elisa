# Classify the native converter refusal without confusing staging/load -1.
module StudioFbxImportFailurePolicy:
    public:
        const enum Kind of i64:
            General = 0
            Memory = 1
            CacheWrite = 2
            NonFinite = 3
            UnsupportedSkin = 4

        def classify(status: i64) -> Kind:
            ensure status == -3 implies result == Kind.Memory
            ensure status == -4 implies result == Kind.CacheWrite
            ensure status == -5 implies result == Kind.NonFinite
            ensure status == -6 implies result == Kind.UnsupportedSkin
            ensure status != -3 and status != -4 and status != -5 and status != -6 implies result == Kind.General
            return Kind.Memory if status == -3
            return Kind.CacheWrite if status == -4
            return Kind.NonFinite if status == -5
            return Kind.UnsupportedSkin if status == -6
            Kind.General

        def message(status: i64) -> sview:
            kind: Kind = classify(status)
            return "FBX import ran out of memory. Try a smaller take. The current take is unchanged." if kind == Kind.Memory
            return "The converted FBX could not be published safely. Check workspace permissions and free space, then retry. The current take is unchanged." if kind == Kind.CacheWrite
            return "The FBX contains non-finite animation or mesh values. Correct the source in its authoring tool and retry. The current take is unchanged." if kind == Kind.NonFinite
            return "The FBX skin exceeds supported limits or has invalid skin data. Export a supported skinned GLB from your authoring tool. The current take is unchanged." if kind == Kind.UnsupportedSkin
            "FBX import failed or contained no usable animation. Check the source and workspace, then retry. The current take is unchanged."
