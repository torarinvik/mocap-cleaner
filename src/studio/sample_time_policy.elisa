module StudioSampleTimePolicy:
    public:
        const module Domain:
            MAX_FRAMES: i64 = 10000000
            MAX_TIME_US: i64 = 10000000000000
            MICROS: i64 = 1000000
            MICROS_PER_MILLI: i64 = 1000
            MAX_STEP_US: i64 = 250000

        def microseconds(millis: i64) -> i64:
            requires millis >= 0 and millis <= Domain::MAX_TIME_US / Domain::MICROS_PER_MILLI + 1
            ensure result >= 0 and result <= Domain::MAX_TIME_US + Domain::MICROS_PER_MILLI
            ensure result == millis * Domain::MICROS_PER_MILLI
            millis * Domain::MICROS_PER_MILLI

        def past_end(time: i64, last: i64) -> bool:
            requires time >= 0 and time <= Domain::MAX_TIME_US + Domain::MICROS_PER_MILLI
            requires last >= 0 and last <= Domain::MAX_TIME_US
            ensure result == (time > last)
            time > last

        # Include the final sample at its exact timestamp before stopping.
        def end_us(last: i64) -> i64:
            requires last >= 0 and last <= Domain::MAX_TIME_US
            ensure result >= 1 and result <= Domain::MAX_TIME_US + 1
            ensure result == last + 1
            last + 1

        def loop_phase(time: i64, duration: i64) -> i64:
            requires time >= 0 and time <= Domain::MAX_TIME_US + Domain::MAX_STEP_US + 1
            requires duration >= 1 and duration <= Domain::MAX_TIME_US + 1
            ensure result >= 0 and result < duration
            ensure time >= duration or result == time
            time % duration

        def timestamp_valid(time: i64, previous: i64, first: bool) -> bool:
            ensure result == (time >= 0 and time <= Domain::MAX_TIME_US and (first or previous >= 0 and previous < time))
            time >= 0 and time <= Domain::MAX_TIME_US and (first or previous >= 0 and previous < time)

        def relative_us(time: i64, origin: i64) -> i64:
            requires origin >= 0 and origin <= Domain::MAX_TIME_US
            requires time >= origin and time <= Domain::MAX_TIME_US
            ensure result >= 0 and result <= Domain::MAX_TIME_US
            ensure result == time - origin
            time - origin

        def aligned(expected: i64, observed: i64) -> bool:
            ensure result == (expected >= 0 and expected <= Domain::MAX_TIME_US and observed == expected)
            expected >= 0 and expected <= Domain::MAX_TIME_US and observed == expected

        def playback_allowed(playing: bool, ready: bool, count_matches: bool) -> bool:
            ensure result == (playing or ready and count_matches)
            playing or ready and count_matches
