module StudioSampleTimePolicy:
    public:
        const module Domain:
            MAX_FRAMES: i64 = 10000000
            MAX_TIME_US: i64 = 10000000000000
            MICROS: i64 = 1000000

        def timestamp_valid(time: i64, previous: i64, first: bool) -> bool:
            ensure result == (time >= 0 and time <= Domain::MAX_TIME_US and (first or previous >= 0 and previous < time))
            time >= 0 and time <= Domain::MAX_TIME_US and (first or previous >= 0 and previous < time)

        def relative_us(time: i64, origin: i64) -> i64:
            requires origin >= 0 and origin <= Domain::MAX_TIME_US
            requires time >= origin and time <= Domain::MAX_TIME_US
            ensure result >= 0 and result <= Domain::MAX_TIME_US
            ensure result == time - origin
            time - origin

        def aligned(expected: i64, observed: i64) -> bool:
            ensure result == (expected >= 0 and expected <= Domain::MAX_TIME_US and observed == expected)
            expected >= 0 and expected <= Domain::MAX_TIME_US and observed == expected
