module StudioFailureGuideLayoutPolicy:
    public:
        const module Layout:
            MAX_EXTENT: i64 = 16384
            HORIZONTAL_INSET: i64 = 80
            RESERVED_HEIGHT: i64 = 100
            LINE_PITCH: i64 = 20
            MAX_ROWS: i64 = 6

        def content_width(width: i64) -> i64:
            requires width >= -Layout::MAX_EXTENT and width <= Layout::MAX_EXTENT
            ensure result >= 0
            ensure result == 0 or result + Layout::HORIZONTAL_INSET == width
            0 if width <= Layout::HORIZONTAL_INSET else width - Layout::HORIZONTAL_INSET

        def rows(height: i64) -> i64:
            requires height >= -Layout::MAX_EXTENT and height <= Layout::MAX_EXTENT
            ensure result >= 0 and result <= Layout::MAX_ROWS
            ensure height < Layout::RESERVED_HEIGHT or result * Layout::LINE_PITCH + Layout::RESERVED_HEIGHT <= height
            return 0 if height <= Layout::RESERVED_HEIGHT
            count: i64 = (height - Layout::RESERVED_HEIGHT) / Layout::LINE_PITCH
            Layout::MAX_ROWS if count > Layout::MAX_ROWS else count
