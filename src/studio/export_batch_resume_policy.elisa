include "export_batch_queue_policy.elisa"

module StudioExportBatchResumePolicy:
    public:
        # Resume changes the cancellation latch only. Item retries revalidate
        # their destinations independently and never reset completed outputs.
        def admitted(cancel_requested: bool, active_workers: i64) -> bool:
            requires active_workers >= 0
            requires active_workers <= StudioExportBatchQueuePolicy::Capacity::MAX_WORKERS
            ensure result == (cancel_requested and active_workers == 0)
            cancel_requested and active_workers == 0

        def after_resume(cancel_requested: bool, active_workers: i64) -> bool:
            requires active_workers >= 0
            requires active_workers <= StudioExportBatchQueuePolicy::Capacity::MAX_WORKERS
            ensure result == (cancel_requested and active_workers > 0)
            return false if admitted(cancel_requested, active_workers)
            cancel_requested
