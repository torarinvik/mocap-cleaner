# Safe eligibility and review rules for removing Studio-managed artifacts.
# Filesystem identity and canonical-path checks belong to the caller; this
# kernel only accepts already-verified evidence and never performs I/O.
module StudioStorageCleanupPolicy:
    public:
        const RECOVERY: i64 = 0
        const TEMP_EXPORT: i64 = 1
        const GENERATED_REPORT: i64 = 2
        const KIND_COUNT: i64 = 3
        const MAX_AGE_DAYS: i64 = 365000
        const MAX_RETENTION_DAYS: i64 = 3650
        const MAX_ITEM_BYTES: i64 = 1000000000000000

        # Stable, UI-neutral reasons let inventory views explain why an
        # artifact is protected without duplicating the safety predicate.
        const PROTECT_NONE: i64 = 0
        const PROTECT_UNMANAGED: i64 = 1
        const PROTECT_OUTSIDE_BUILD: i64 = 2
        const PROTECT_SYMLINK: i64 = 3
        const PROTECT_SOURCE_TAKE: i64 = 4
        const PROTECT_OPEN_DOCUMENT: i64 = 5
        const PROTECT_SESSION_REFERENCE: i64 = 6
        const PROTECT_INVALID_FACTS: i64 = 7
        const PROTECT_RETENTION: i64 = 8
        const PROTECT_IDENTITY_CHANGED: i64 = 9
        const PROTECT_IDENTITY_UNVERIFIED: i64 = 10

        const IDENTITY_UNVERIFIED: i64 = 0
        const IDENTITY_MATCHES: i64 = 1
        const IDENTITY_CHANGED: i64 = 2

        struct Facts:
            kind: i64
            studio_managed: bool
            canonical_under_build: bool
            symlink: bool
            source_take: bool
            open_document: bool
            session_referenced: bool
            identity_state: i64
            age_days: i64
            retention_days: i64
            size_bytes: i64

        def kind_supported(kind: i64) -> bool:
            ensure result == (kind >= RECOVERY and kind < KIND_COUNT)
            kind >= RECOVERY and kind < KIND_COUNT

        def facts_valid(item: Facts) -> bool:
            ensure result == (item.kind >= RECOVERY and item.kind < KIND_COUNT and item.identity_state >= IDENTITY_UNVERIFIED and item.identity_state <= IDENTITY_CHANGED and item.age_days >= 0 and item.age_days <= MAX_AGE_DAYS and item.retention_days >= 0 and item.retention_days <= MAX_RETENTION_DAYS and item.size_bytes >= 0 and item.size_bytes <= MAX_ITEM_BYTES)
            item.kind >= RECOVERY and item.kind < KIND_COUNT and item.identity_state >= IDENTITY_UNVERIFIED and item.identity_state <= IDENTITY_CHANGED and item.age_days >= 0 and item.age_days <= MAX_AGE_DAYS and item.retention_days >= 0 and item.retention_days <= MAX_RETENTION_DAYS and item.size_bytes >= 0 and item.size_bytes <= MAX_ITEM_BYTES

        def retention_elapsed(age_days: i64, retention_days: i64) -> bool:
            ensure result == (age_days >= retention_days)
            age_days >= retention_days

        # Report one deterministic explanation for the first applicable
        # protection rule. The UI can map these stable codes to localized text.
        def protection_reason(item: Facts) -> i64:
            ensure result >= PROTECT_NONE and result <= PROTECT_IDENTITY_UNVERIFIED
            PROTECT_UNMANAGED if not item.studio_managed else PROTECT_OUTSIDE_BUILD if not item.canonical_under_build else PROTECT_SYMLINK if item.symlink else PROTECT_SOURCE_TAKE if item.source_take else PROTECT_OPEN_DOCUMENT if item.open_document else PROTECT_SESSION_REFERENCE if item.session_referenced else PROTECT_INVALID_FACTS if not facts_valid(item) else PROTECT_IDENTITY_CHANGED if item.identity_state == IDENTITY_CHANGED else PROTECT_IDENTITY_UNVERIFIED if item.identity_state != IDENTITY_MATCHES else PROTECT_RETENTION if item.age_days < item.retention_days else PROTECT_NONE

        # Safe candidates must be generated and inside the canonical build
        # root, unreferenced by the open document/session, and past retention.
        def eligible(item: Facts) -> bool:
            ensure not result or item.studio_managed
            ensure not result or item.canonical_under_build
            ensure not result or not item.symlink
            ensure not result or not item.source_take
            ensure not result or not item.open_document
            ensure not result or not item.session_referenced
            ensure not result or item.kind >= RECOVERY
            ensure not result or item.kind < KIND_COUNT
            ensure not result or item.identity_state == IDENTITY_MATCHES
            ensure not result or item.identity_state >= IDENTITY_UNVERIFIED
            ensure not result or item.identity_state <= IDENTITY_CHANGED
            ensure not result or item.age_days >= 0
            ensure not result or item.age_days <= MAX_AGE_DAYS
            ensure not result or item.retention_days >= 0
            ensure not result or item.retention_days <= MAX_RETENTION_DAYS
            ensure not result or item.size_bytes >= 0
            ensure not result or item.size_bytes <= MAX_ITEM_BYTES
            ensure not result or item.age_days >= item.retention_days
            if not item.studio_managed:
                return false
            if not item.canonical_under_build:
                return false
            if item.symlink:
                return false
            if item.source_take:
                return false
            if item.open_document:
                return false
            if item.session_referenced:
                return false
            if not facts_valid(item):
                return false
            if item.identity_state != IDENTITY_MATCHES:
                return false
            retention_elapsed(item.age_days, item.retention_days)

        # Moving one item to Trash requires a deliberate review and explicit
        # confirmation after the item has passed the safety filter.
        def may_trash(item: Facts, selected: bool, reviewed: bool, confirmed: bool) -> bool:
            ensure not result or item.studio_managed
            ensure not result or item.canonical_under_build
            ensure not result or not item.symlink
            ensure not result or not item.source_take
            ensure not result or not item.open_document
            ensure not result or not item.session_referenced
            ensure not result or item.kind >= RECOVERY
            ensure not result or item.kind < KIND_COUNT
            ensure not result or item.identity_state == IDENTITY_MATCHES
            ensure not result or item.identity_state >= IDENTITY_UNVERIFIED
            ensure not result or item.identity_state <= IDENTITY_CHANGED
            ensure not result or item.age_days >= 0
            ensure not result or item.age_days <= MAX_AGE_DAYS
            ensure not result or item.retention_days >= 0
            ensure not result or item.retention_days <= MAX_RETENTION_DAYS
            ensure not result or item.size_bytes >= 0
            ensure not result or item.size_bytes <= MAX_ITEM_BYTES
            ensure not result or item.age_days >= item.retention_days
            ensure not result or selected
            ensure not result or reviewed
            ensure not result or confirmed
            if not eligible(item):
                return false
            if not selected:
                return false
            if not reviewed:
                return false
            if not confirmed:
                return false
            true

        # Keep the displayed reclaimable-space total bounded. An overflow or
        # malformed item is rejected without changing the prior total.
        def next_total_bytes(current: i64, item: Facts) -> i64:
            requires current >= 0
            requires current <= MAX_ITEM_BYTES
            ensure result >= 0
            ensure result <= MAX_ITEM_BYTES
            if eligible(item):
                if item.size_bytes >= 0:
                    if item.size_bytes <= MAX_ITEM_BYTES:
                        if item.size_bytes <= MAX_ITEM_BYTES - current:
                            return current + item.size_bytes
            current
