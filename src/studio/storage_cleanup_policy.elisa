# Safe eligibility and review rules for removing Studio-managed artifacts.
# Filesystem identity and canonical-path checks belong to the caller; this
# kernel only accepts already-verified evidence and never performs I/O.
module StudioStorageCleanupPolicy:
    public:
        const enum Kind of i64:
            Recovery = 0
            TempExport = 1
            GeneratedReport = 2

        const module Capacity:
            KIND_COUNT: i64 = 3

        const module Limit:
            MAX_AGE_DAYS: i64 = 365000
            MAX_RETENTION_DAYS: i64 = 3650
            MAX_ITEM_BYTES: i64 = 1000000000000000

        const enum ProtectionReason of i64:
            # Stable UI-neutral reasons; UserExemption is an additional app gate.
            None = 0
            Unmanaged = 1
            OutsideBuild = 2
            Symlink = 3
            SourceTake = 4
            OpenDocument = 5
            SessionReference = 6
            InvalidFacts = 7
            Retention = 8
            IdentityChanged = 9
            IdentityUnverified = 10
            UserExemption = 11

        const enum IdentityState of i64:
            Unverified = 0
            Matches = 1
            Changed = 2

        struct Facts:
            kind: i64
            studio_managed: bool
            canonical_under_build: bool
            symlink: bool
            source_take: bool
            open_document: bool
            session_referenced: bool
            identity_state: i64
            age_days: i64
            retention_days: i64
            size_bytes: i64

        def kind_supported(kind: i64) -> bool:
            ensure result == (kind >= Kind.Recovery.i64() and kind < Capacity::KIND_COUNT)
            kind >= Kind.Recovery.i64() and kind < Capacity::KIND_COUNT

        def facts_valid(item: Facts) -> bool:
            ensure result == (item.kind >= Kind.Recovery.i64() and item.kind < Capacity::KIND_COUNT and item.identity_state >= IdentityState.Unverified.i64() and item.identity_state <= IdentityState.Changed.i64() and item.age_days >= 0 and item.age_days <= Limit::MAX_AGE_DAYS and item.retention_days >= 0 and item.retention_days <= Limit::MAX_RETENTION_DAYS and item.size_bytes >= 0 and item.size_bytes <= Limit::MAX_ITEM_BYTES)
            item.kind >= Kind.Recovery.i64() and item.kind < Capacity::KIND_COUNT and item.identity_state >= IdentityState.Unverified.i64() and item.identity_state <= IdentityState.Changed.i64() and item.age_days >= 0 and item.age_days <= Limit::MAX_AGE_DAYS and item.retention_days >= 0 and item.retention_days <= Limit::MAX_RETENTION_DAYS and item.size_bytes >= 0 and item.size_bytes <= Limit::MAX_ITEM_BYTES

        def retention_elapsed(age_days: i64, retention_days: i64) -> bool:
            ensure result == (age_days >= retention_days)
            age_days >= retention_days

        # Report one deterministic explanation for the first applicable
        # protection rule. The UI can map these stable codes to localized text.
        def protection_reason(item: Facts) -> i64:
            ensure result >= ProtectionReason.None.i64() and result <= ProtectionReason.IdentityUnverified.i64()
            ensure item.studio_managed or result == ProtectionReason.Unmanaged.i64()
            ensure not item.studio_managed or item.canonical_under_build or result == ProtectionReason.OutsideBuild.i64()
            ensure not item.studio_managed or not item.canonical_under_build or item.symlink or not item.source_take or result == ProtectionReason.SourceTake.i64()
            if not item.studio_managed:
                return ProtectionReason.Unmanaged.i64()
            if not item.canonical_under_build:
                return ProtectionReason.OutsideBuild.i64()
            if item.symlink:
                return ProtectionReason.Symlink.i64()
            if item.source_take:
                return ProtectionReason.SourceTake.i64()
            if item.open_document:
                return ProtectionReason.OpenDocument.i64()
            if item.session_referenced:
                return ProtectionReason.SessionReference.i64()
            if not facts_valid(item):
                return ProtectionReason.InvalidFacts.i64()
            if item.identity_state == IdentityState.Changed.i64():
                return ProtectionReason.IdentityChanged.i64()
            if item.identity_state != IdentityState.Matches.i64():
                return ProtectionReason.IdentityUnverified.i64()
            if not retention_elapsed(item.age_days, item.retention_days):
                return ProtectionReason.Retention.i64()
            ProtectionReason.None.i64()

        # Safe candidates must be generated and inside the canonical build
        # root, unreferenced by the open document/session, and past retention.
        def eligible(item: Facts) -> bool:
            ensure not result or item.studio_managed
            ensure not result or item.canonical_under_build
            ensure not result or not item.symlink
            ensure not result or not item.source_take
            ensure not result or not item.open_document
            ensure not result or not item.session_referenced
            ensure not result or item.kind >= Kind.Recovery.i64()
            ensure not result or item.kind < Capacity::KIND_COUNT
            ensure not result or item.identity_state == IdentityState.Matches.i64()
            ensure not result or item.identity_state >= IdentityState.Unverified.i64()
            ensure not result or item.identity_state <= IdentityState.Changed.i64()
            ensure not result or item.age_days >= 0
            ensure not result or item.age_days <= Limit::MAX_AGE_DAYS
            ensure not result or item.retention_days >= 0
            ensure not result or item.retention_days <= Limit::MAX_RETENTION_DAYS
            ensure not result or item.size_bytes >= 0
            ensure not result or item.size_bytes <= Limit::MAX_ITEM_BYTES
            ensure not result or item.age_days >= item.retention_days
            if not item.studio_managed:
                return false
            if not item.canonical_under_build:
                return false
            if item.symlink:
                return false
            if item.source_take:
                return false
            if item.open_document:
                return false
            if item.session_referenced:
                return false
            if not facts_valid(item):
                return false
            if item.identity_state != IdentityState.Matches.i64():
                return false
            retention_elapsed(item.age_days, item.retention_days)

        # Moving one item to Trash requires a deliberate review and explicit
        # confirmation after the item has passed the safety filter.
        def may_trash(item: Facts, selected: bool, reviewed: bool, confirmed: bool) -> bool:
            ensure not result or item.studio_managed
            ensure not result or item.canonical_under_build
            ensure not result or not item.symlink
            ensure not result or not item.source_take
            ensure not result or not item.open_document
            ensure not result or not item.session_referenced
            ensure not result or item.kind >= Kind.Recovery.i64()
            ensure not result or item.kind < Capacity::KIND_COUNT
            ensure not result or item.identity_state == IdentityState.Matches.i64()
            ensure not result or item.identity_state >= IdentityState.Unverified.i64()
            ensure not result or item.identity_state <= IdentityState.Changed.i64()
            ensure not result or item.age_days >= 0
            ensure not result or item.age_days <= Limit::MAX_AGE_DAYS
            ensure not result or item.retention_days >= 0
            ensure not result or item.retention_days <= Limit::MAX_RETENTION_DAYS
            ensure not result or item.size_bytes >= 0
            ensure not result or item.size_bytes <= Limit::MAX_ITEM_BYTES
            ensure not result or item.age_days >= item.retention_days
            ensure not result or selected
            ensure not result or reviewed
            ensure not result or confirmed
            if not eligible(item):
                return false
            if not selected:
                return false
            if not reviewed:
                return false
            if not confirmed:
                return false
            true

        # Keep the displayed reclaimable-space total bounded. An overflow or
        # malformed item is rejected without changing the prior total.
        def next_total_bytes(current: i64, item: Facts) -> i64:
            requires current >= 0
            requires current <= Limit::MAX_ITEM_BYTES
            ensure result >= 0
            ensure result <= Limit::MAX_ITEM_BYTES
            if eligible(item):
                if item.size_bytes >= 0:
                    if item.size_bytes <= Limit::MAX_ITEM_BYTES:
                        if item.size_bytes <= Limit::MAX_ITEM_BYTES - current:
                            return current + item.size_bytes
            current
