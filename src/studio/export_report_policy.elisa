# Small proof-oriented constraints shared by the Studio export report writer.
module StudioExportReportPolicy:
    public:
        const module Schema:
            VERSION: i64 = 2
            UNAVAILABLE_FIELD_COUNT: i64 = 6
            UNAVAILABLE_WITH_TIME_MAP: i64 = 5
            METRIC_FIELD_COUNT: i64 = 10

        const module Timing:
            MAX_FRAMES: i64 = 10000000
            MAX_RATE: i64 = 1000

        const enum Severity of i64:
            INFO = 0
            WARNING = 1
            ERROR = 2

        def frame_count_ok(frames: i64) -> bool:
            ensure result == (frames >= 0 and frames <= Timing::MAX_FRAMES)
            frames >= 0 and frames <= Timing::MAX_FRAMES

        def frame_rate_ok(fps: i64) -> bool:
            ensure result == (fps > 0 and fps <= Timing::MAX_RATE)
            fps > 0 and fps <= Timing::MAX_RATE

        def residue_ok(value: i64, modulus: i64) -> bool:
            requires modulus > 1
            ensure result == (value >= 0 and value < modulus)
            value >= 0 and value < modulus

        # Report timing uses floor-to-millisecond arithmetic on integer fps.
        def duration_ms(frames: i64, fps: i64) -> i64:
            requires frames >= 0 and frames <= Timing::MAX_FRAMES
            requires fps > 0 and fps <= Timing::MAX_RATE
            ensure result >= 0
            ensure result <= Timing::MAX_FRAMES * 1000
            ensure result == (frames * 1000) / fps
            (frames * 1000) / fps

        def warning_severity_ok(level: i64) -> bool:
            ensure result == (level >= 0 and level <= 2)
            level >= 0 and level <= 2

        def schema_version() -> i64:
            ensure result == 2
            Schema::VERSION

        # These values are absent from the current Studio export snapshot.
        # Keep the count tied to the fixed schema entries emitted by the
        # formatter so additions require an explicit schema review.
        def unavailable_field_count() -> i64:
            ensure result == 6
            Schema::UNAVAILABLE_FIELD_COUNT

        def unavailable_field_count_for(has_time_map: bool) -> i64:
            ensure has_time_map implies result == 5
            ensure not has_time_map implies result == 6
            return Schema::UNAVAILABLE_WITH_TIME_MAP if has_time_map
            Schema::UNAVAILABLE_FIELD_COUNT

        def metric_field_count() -> i64:
            ensure result == 10
            Schema::METRIC_FIELD_COUNT
