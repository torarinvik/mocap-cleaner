# Small proof-oriented constraints shared by the Studio export report writer.
module StudioExportReportPolicy:
    public:
        const SCHEMA_VERSION: i64 = 2
        const UNAVAILABLE_FIELD_COUNT: i64 = 5
        const MAX_FRAMES: i64 = 10000000
        const MAX_RATE: i64 = 1000
        const METRIC_FIELD_COUNT: i64 = 10
        const INFO: i64 = 0
        const WARNING: i64 = 1
        const ERROR: i64 = 2

        def frame_count_ok(frames: i64) -> bool:
            ensure result == (frames >= 0 and frames <= MAX_FRAMES)
            frames >= 0 and frames <= MAX_FRAMES

        def frame_rate_ok(fps: i64) -> bool:
            ensure result == (fps > 0 and fps <= MAX_RATE)
            fps > 0 and fps <= MAX_RATE

        def residue_ok(value: i64, modulus: i64) -> bool:
            requires modulus > 1
            ensure result == (value >= 0 and value < modulus)
            value >= 0 and value < modulus

        # Report timing uses floor-to-millisecond arithmetic on integer fps.
        def duration_ms(frames: i64, fps: i64) -> i64:
            requires frames >= 0 and frames <= MAX_FRAMES
            requires fps > 0 and fps <= MAX_RATE
            ensure result >= 0
            ensure result == (frames * 1000) / fps
            (frames * 1000) / fps

        def warning_severity_ok(level: i64) -> bool:
            ensure result == (level >= INFO and level <= ERROR)
            level >= INFO and level <= ERROR

        def schema_version() -> i64:
            ensure result == 2
            SCHEMA_VERSION

        # These values are absent from the current Studio export snapshot.
        # Keep the count tied to the fixed schema entries emitted by the
        # formatter so additions require an explicit schema review.
        def unavailable_field_count() -> i64:
            ensure result == 5
            UNAVAILABLE_FIELD_COUNT

        def metric_field_count() -> i64:
            ensure result == 10
            METRIC_FIELD_COUNT
