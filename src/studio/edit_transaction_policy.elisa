# A staged edit may publish only against the committed state it captured.
module StudioEditTransactionPolicy:
    public:
        const enum Intent of i64:
            Record = 0
            Undo = 1
            Redo = 2

        struct Base:
            take: i64
            result_generation: i64
            stack_generation: i64
            cursor: i64
            count: i64

        def valid(base: Base) -> bool:
            ensure result == (base.take >= 0 and base.result_generation >= 0 and base.stack_generation >= 0 and base.count >= 1 and base.cursor >= 0 and base.cursor < base.count)
            base.take >= 0 and base.result_generation >= 0 and base.stack_generation >= 0 and base.count >= 1 and base.cursor >= 0 and base.cursor < base.count

        def current(captured: Base, observed: Base) -> bool:
            ensure result == (valid(captured) and valid(observed) and captured.take == observed.take and captured.result_generation == observed.result_generation and captured.stack_generation == observed.stack_generation and captured.cursor == observed.cursor and captured.count == observed.count)
            valid(captured) and valid(observed) and captured.take == observed.take and captured.result_generation == observed.result_generation and captured.stack_generation == observed.stack_generation and captured.cursor == observed.cursor and captured.count == observed.count

        def stage_admitted(existing_draft: bool, captured: Base, observed: Base) -> bool:
            ensure result == (valid(observed) and (not existing_draft or current(captured, observed)))
            valid(observed) and (not existing_draft or current(captured, observed))
