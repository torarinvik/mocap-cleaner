module StudioWorkspaceDerivedPathPolicy:
    public:
        const module Limit:
            CAPACITY: usize = 4096
            MAX_LEAF_BYTES: usize = 254
            BUILD_PREFIX_BYTES: usize = 6

        def admitted(root_bytes: usize, leaf_bytes: usize, root_has_slash: bool,
                     leaf_valid: bool) -> bool:
            ensure result implies root_bytes > 0 and root_bytes < Limit::CAPACITY
            ensure result implies leaf_bytes > 0 and leaf_bytes <= Limit::MAX_LEAF_BYTES
            ensure result implies leaf_valid
            return false if not leaf_valid or root_bytes == 0 or root_bytes >= Limit::CAPACITY
            return false if leaf_bytes == 0 or leaf_bytes > Limit::MAX_LEAF_BYTES
            separator: usize = 0 if root_has_slash else 1
            # Subtract only bounded values, before adding any path lengths.
            root_bytes <= Limit::CAPACITY - 1 - Limit::BUILD_PREFIX_BYTES - separator - leaf_bytes
