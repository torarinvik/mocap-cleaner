# Read-only validation facts for one proposed batch item. The native owner
# must establish these facts from exact paths, animation and recipe identity.
# Ready is permission to enqueue, never evidence that publication completed.
module StudioExportBatchPreflightPolicy:
    public:
        const enum Outcome of i64:
            Ready = 0
            SourceUnavailable = 1
            AnimationUnavailable = 2
            DestinationOutsideBuild = 3
            SourceCollision = 4
            DuplicateDestination = 5
            OutputOccupied = 6
            ReportOccupied = 7
            UnsupportedRecipe = 8
            IncompatibleRig = 9

        def evaluate(source_readable: bool, animation_available: bool, destinations_inside_build: bool, destinations_distinct_from_sources: bool, destinations_unique: bool, output_absent: bool, reports_absent: bool, recipe_supported: bool, rig_compatible: bool) -> Outcome:
            ensure (result == Outcome.Ready) == (source_readable and animation_available and destinations_inside_build and destinations_distinct_from_sources and destinations_unique and output_absent and reports_absent and recipe_supported and rig_compatible)
            ensure not source_readable implies result == Outcome.SourceUnavailable
            return Outcome.SourceUnavailable if not source_readable
            return Outcome.AnimationUnavailable if not animation_available
            return Outcome.DestinationOutsideBuild if not destinations_inside_build
            return Outcome.SourceCollision if not destinations_distinct_from_sources
            return Outcome.DuplicateDestination if not destinations_unique
            return Outcome.OutputOccupied if not output_absent
            return Outcome.ReportOccupied if not reports_absent
            return Outcome.UnsupportedRecipe if not recipe_supported
            return Outcome.IncompatibleRig if not rig_compatible
            Outcome.Ready

        def admitted(outcome: Outcome) -> bool:
            ensure result == (outcome == Outcome.Ready)
            outcome == Outcome.Ready
