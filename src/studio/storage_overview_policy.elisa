# Mutually exclusive scalar categories for the Storage inventory overview.
# Facts are established by the caller from one fresh inventory snapshot.
include "storage_totals_kernel.elisa"

module StudioStorageOverviewPolicy:
    public:
        const module Category:
            ELIGIBLE: i64 = 0
            PROTECTED: i64 = 1
            RECOVERY: i64 = 2
            TRASH: i64 = 3
            UNKNOWN: i64 = -1
            COUNT: i64 = 4

        const module Capacity:
            MAX_ITEMS: i64 = StudioStorageTotalsKernel::Capacity::MAX_ITEMS

        def valid_category(category: i64) -> bool:
            ensure result == (category >= Category::ELIGIBLE and category < Category::COUNT)
            category >= Category::ELIGIBLE and category < Category::COUNT

        # Verified Trash takes its own bucket. Unknown present facts are not
        # assigned bytes; present recovery is separate and always protected.
        def category(verified_present: bool, verified_trash: bool,
                     recovery: bool, eligible: bool) -> i64:
            ensure result == (Category::TRASH if verified_trash else Category::UNKNOWN if not verified_present else Category::RECOVERY if recovery else Category::ELIGIBLE if eligible else Category::PROTECTED)
            Category::TRASH if verified_trash else Category::UNKNOWN if not verified_present else Category::RECOVERY if recovery else Category::ELIGIBLE if eligible else Category::PROTECTED

        def is_present(category_id: i64) -> bool:
            ensure result == (category_id == Category::ELIGIBLE or category_id == Category::PROTECTED or category_id == Category::RECOVERY)
            category_id == Category::ELIGIBLE or category_id == Category::PROTECTED or category_id == Category::RECOVERY

        def is_protected(category_id: i64) -> bool:
            ensure result == (category_id == Category::PROTECTED or category_id == Category::RECOVERY)
            category_id == Category::PROTECTED or category_id == Category::RECOVERY

        def may_cleanup(category_id: i64) -> bool:
            ensure result == (category_id == Category::ELIGIBLE)
            category_id == Category::ELIGIBLE

        def known_bytes(category_id: i64) -> bool:
            ensure result == (category_id >= Category::ELIGIBLE and category_id < Category::COUNT)
            category_id >= Category::ELIGIBLE and category_id < Category::COUNT

        def unknown_bytes(category_id: i64) -> bool:
            ensure result == (category_id == Category::UNKNOWN)
            category_id == Category::UNKNOWN
