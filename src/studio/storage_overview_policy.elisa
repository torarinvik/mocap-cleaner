# Mutually exclusive scalar categories for the Storage inventory overview.
# Facts are established by the caller from one fresh inventory snapshot.
include "storage_totals_kernel.elisa"

module StudioStorageOverviewPolicy:
    public:
        const CATEGORY_ELIGIBLE: i64 = 0
        const CATEGORY_PROTECTED: i64 = 1
        const CATEGORY_RECOVERY: i64 = 2
        const CATEGORY_TRASH: i64 = 3
        const CATEGORY_UNKNOWN: i64 = -1
        const CATEGORY_COUNT: i64 = 4
        const MAX_ITEMS: i64 = StudioStorageTotalsKernel::Capacity::MAX_ITEMS

        def valid_category(category: i64) -> bool:
            ensure result == (category >= CATEGORY_ELIGIBLE and category < CATEGORY_COUNT)
            category >= CATEGORY_ELIGIBLE and category < CATEGORY_COUNT

        # Verified Trash takes its own bucket. Unknown present facts are not
        # assigned bytes; present recovery is separate and always protected.
        def category(verified_present: bool, verified_trash: bool,
                     recovery: bool, eligible: bool) -> i64:
            ensure result == (CATEGORY_TRASH if verified_trash else CATEGORY_UNKNOWN if not verified_present else CATEGORY_RECOVERY if recovery else CATEGORY_ELIGIBLE if eligible else CATEGORY_PROTECTED)
            CATEGORY_TRASH if verified_trash else CATEGORY_UNKNOWN if not verified_present else CATEGORY_RECOVERY if recovery else CATEGORY_ELIGIBLE if eligible else CATEGORY_PROTECTED

        def is_present(category_id: i64) -> bool:
            ensure result == (category_id == CATEGORY_ELIGIBLE or category_id == CATEGORY_PROTECTED or category_id == CATEGORY_RECOVERY)
            category_id == CATEGORY_ELIGIBLE or category_id == CATEGORY_PROTECTED or category_id == CATEGORY_RECOVERY

        def is_protected(category_id: i64) -> bool:
            ensure result == (category_id == CATEGORY_PROTECTED or category_id == CATEGORY_RECOVERY)
            category_id == CATEGORY_PROTECTED or category_id == CATEGORY_RECOVERY

        def may_cleanup(category_id: i64) -> bool:
            ensure result == (category_id == CATEGORY_ELIGIBLE)
            category_id == CATEGORY_ELIGIBLE

        def known_bytes(category_id: i64) -> bool:
            ensure result == (category_id >= CATEGORY_ELIGIBLE and category_id < CATEGORY_COUNT)
            category_id >= CATEGORY_ELIGIBLE and category_id < CATEGORY_COUNT

        def unknown_bytes(category_id: i64) -> bool:
            ensure result == (category_id == CATEGORY_UNKNOWN)
            category_id == CATEGORY_UNKNOWN
