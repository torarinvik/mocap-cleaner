# Pure comparison for a persisted filesystem identity and a fresh receipt.
# Scalar arguments keep the proof boundary within Elisa Proof's supported
# symbolic terms. The caller supplies the exact path comparison result.
module StudioStorageIdentityPolicy:
    public:
        def matches(expected_device: i64, current_device: i64,
                    expected_inode: i64, current_inode: i64,
                    expected_size_bytes: i64, current_size_bytes: i64,
                    expected_modified_seconds: i64, current_modified_seconds: i64,
                    expected_modified_nanoseconds: i64, current_modified_nanoseconds: i64,
                    path_matches: bool) -> bool:
            ensure result == (expected_device == current_device and expected_inode == current_inode and expected_size_bytes == current_size_bytes and expected_modified_seconds == current_modified_seconds and expected_modified_nanoseconds == current_modified_nanoseconds and path_matches)
            expected_device == current_device and expected_inode == current_inode and expected_size_bytes == current_size_bytes and expected_modified_seconds == current_modified_seconds and expected_modified_nanoseconds == current_modified_nanoseconds and path_matches
