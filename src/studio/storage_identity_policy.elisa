# Pure comparison for a persisted filesystem identity and a fresh receipt.
# Path equality is computed by the caller so this kernel has no filesystem or
# dynamic byte-array dependency.
module StudioStorageIdentityPolicy:
    public:
        struct Identity:
            device: i64
            inode: i64
            size_bytes: i64
            modified_seconds: i64
            modified_nanoseconds: i64

        def matches(expected: Identity, current: Identity, path_matches: bool) -> bool:
            ensure result == (expected.device == current.device and expected.inode == current.inode and expected.size_bytes == current.size_bytes and expected.modified_seconds == current.modified_seconds and expected.modified_nanoseconds == current.modified_nanoseconds and path_matches)
            return false if expected.device != current.device
            return false if expected.inode != current.inode
            return false if expected.size_bytes != current.size_bytes
            return false if expected.modified_seconds != current.modified_seconds
            return false if expected.modified_nanoseconds != current.modified_nanoseconds
            path_matches
