# Counts for selection feedback in a filtered Storage view. Invalid facts are
# rejected before subtraction; callers must display unknown rather than zero.
include "storage_totals_kernel.elisa"

module StudioStorageFilterSelectionPolicy:
    public:
        def valid_counts(complete: i64, visible: i64, selected: i64, selected_visible: i64) -> bool:
            ensure result == (complete >= 0 and complete <= StudioStorageTotalsKernel::MAX_ITEMS and visible >= 0 and visible <= complete and selected >= 0 and selected <= complete and selected_visible >= 0 and selected_visible <= visible and selected_visible <= selected and selected - selected_visible <= complete - visible)
            complete >= 0 and complete <= StudioStorageTotalsKernel::MAX_ITEMS and visible >= 0 and visible <= complete and selected >= 0 and selected <= complete and selected_visible >= 0 and selected_visible <= visible and selected_visible <= selected and selected - selected_visible <= complete - visible

        def hidden_selected(complete: i64, visible: i64, selected: i64, selected_visible: i64) -> i64:
            requires complete >= 0 and complete <= StudioStorageTotalsKernel::MAX_ITEMS
            requires visible >= 0 and visible <= complete
            requires selected >= 0 and selected <= complete
            requires selected_visible >= 0 and selected_visible <= visible and selected_visible <= selected
            requires selected - selected_visible <= complete - visible
            ensure result == selected - selected_visible
            ensure result >= 0 and result <= selected
            ensure result <= complete - visible
            selected - selected_visible
