# Page and focus policy for the full export-destination inspector.
module StudioExportPathReview:
    public:
        const enum Control of i64:
            Previous = 0
            Next = 1
            Done = 2

        const module Limit:
            ACTION_COUNT: i64 = 3
            MAX_PAGES: i64 = 32

        def has_previous(page: i64) -> bool:
            requires page >= 0 and page < Limit::MAX_PAGES
            ensure result == (page > 0)
            page > 0

        def has_next(page: i64, pages: i64) -> bool:
            requires pages >= 1 and pages <= Limit::MAX_PAGES
            requires page >= 0 and page < pages
            ensure result == (page + 1 < pages)
            page + 1 < pages

        def enabled(action: i64, page: i64, pages: i64) -> bool:
            requires action >= Control.Previous.i64() and action < Limit::ACTION_COUNT
            requires pages >= 1 and pages <= Limit::MAX_PAGES
            requires page >= 0 and page < pages
            return has_previous(page) if action == Control.Previous.i64()
            return has_next(page, pages) if action == Control.Next.i64()
            true

        def initial_focus(page: i64, pages: i64) -> i64:
            requires pages >= 1 and pages <= Limit::MAX_PAGES
            requires page >= 0 and page < pages
            ensure result >= Control.Previous.i64()
            ensure result < Limit::ACTION_COUNT
            return Control.Next.i64() if page + 1 < pages
            return Control.Previous.i64() if page > 0
            Control.Done.i64()

        def move_focus(current: i64, direction: i64, page: i64, pages: i64) -> i64:
            requires current >= Control.Previous.i64() and current < Limit::ACTION_COUNT
            requires direction == -1 or direction == 1
            requires pages >= 1 and pages <= Limit::MAX_PAGES
            requires page >= 0 and page < pages
            requires current == Control.Done.i64() or (current == Control.Previous.i64() and page > 0) or (current == Control.Next.i64() and page + 1 < pages)
            ensure result >= Control.Previous.i64()
            ensure result < Limit::ACTION_COUNT
            return Control.Done.i64() if pages == 1
            if page == 0:
                return Control.Done.i64() if current == Control.Next.i64()
                Control.Next.i64()
            elif page + 1 == pages:
                return Control.Done.i64() if current == Control.Previous.i64()
                Control.Previous.i64()
            elif direction == 1:
                return Control.Next.i64() if current == Control.Previous.i64()
                return Control.Done.i64() if current == Control.Next.i64()
                Control.Previous.i64()
            else:
                return Control.Done.i64() if current == Control.Previous.i64()
                return Control.Previous.i64() if current == Control.Next.i64()
                Control.Next.i64()

        def move_page(page: i64, direction: i64, pages: i64) -> i64:
            requires pages >= 1 and pages <= Limit::MAX_PAGES
            requires page >= 0 and page < pages
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < pages
            return page - 1 if direction == -1 and page > 0
            return page + 1 if direction == 1 and page + 1 < pages
            page
