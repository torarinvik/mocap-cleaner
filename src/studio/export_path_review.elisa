# Page and focus policy for the full export-destination inspector.
module StudioExportPathReview:
    public:
        const PREVIOUS: i64 = 0
        const NEXT: i64 = 1
        const DONE: i64 = 2
        const ACTION_COUNT: i64 = 3
        const MAX_PAGES: i64 = 32

        def has_previous(page: i64) -> bool:
            requires page >= 0 and page < MAX_PAGES
            ensure result == (page > 0)
            page > 0

        def has_next(page: i64, pages: i64) -> bool:
            requires pages >= 1 and pages <= MAX_PAGES
            requires page >= 0 and page < pages
            ensure result == (page + 1 < pages)
            page + 1 < pages

        def enabled(action: i64, page: i64, pages: i64) -> bool:
            requires action >= PREVIOUS and action < ACTION_COUNT
            requires pages >= 1 and pages <= MAX_PAGES
            requires page >= 0 and page < pages
            return has_previous(page) if action == PREVIOUS
            return has_next(page, pages) if action == NEXT
            true

        def initial_focus(page: i64, pages: i64) -> i64:
            requires pages >= 1 and pages <= MAX_PAGES
            requires page >= 0 and page < pages
            ensure result >= PREVIOUS
            ensure result < ACTION_COUNT
            return NEXT if page + 1 < pages
            return PREVIOUS if page > 0
            DONE

        def move_focus(current: i64, direction: i64, page: i64, pages: i64) -> i64:
            requires current >= PREVIOUS and current < ACTION_COUNT
            requires direction == -1 or direction == 1
            requires pages >= 1 and pages <= MAX_PAGES
            requires page >= 0 and page < pages
            requires current == DONE or (current == PREVIOUS and page > 0) or (current == NEXT and page + 1 < pages)
            ensure result >= PREVIOUS
            ensure result < ACTION_COUNT
            return DONE if pages == 1
            if page == 0:
                return DONE if current == NEXT
                NEXT
            elif page + 1 == pages:
                return DONE if current == PREVIOUS
                PREVIOUS
            elif direction == 1:
                return NEXT if current == PREVIOUS
                return DONE if current == NEXT
                PREVIOUS
            else:
                return DONE if current == PREVIOUS
                return PREVIOUS if current == NEXT
                NEXT

        def move_page(page: i64, direction: i64, pages: i64) -> i64:
            requires pages >= 1 and pages <= MAX_PAGES
            requires page >= 0 and page < pages
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < pages
            return page - 1 if direction == -1 and page > 0
            return page + 1 if direction == 1 and page + 1 < pages
            page
