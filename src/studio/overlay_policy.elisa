# Decisions behind the studio's balance overlay, curve view and gizmo
# preview, as small proved kernels:
#   - the balance state of a frame (airborne, supported, outside support but
#     recovering, impossible), which picks the centre-of-mass colour and the
#     timeline's balance markers;
#   - a timeline bin shows the worst state of its frames;
#   - which channel the curve view plots (rotation or position) and how the
#     mode cycles;
#   - when the gizmo's live drag preview is drawn.
module StudioOverlay:
    public:
        const enum BalanceState of i64:
            Airborne = 0
            Supported = 1
            Outside = 2
            Impossible = 3

        const enum CurveMode of i64:
            Rotation = 0
            Position = 1

        const module Count:
            CURVE_MODES: i64 = 2

        # Balance state of one frame. `impossible` comes from the detector
        # (a reported run) and wins; otherwise a frame with no planted foot is
        # airborne, and a planted one is supported when the centre of mass is
        # over the support region.
        def state(planted: bool, com_inside: bool, impossible: bool) -> i64:
            ensure result >= BalanceState.Airborne.i64()
            ensure result <= BalanceState.Impossible.i64()
            ensure not impossible or result == BalanceState.Impossible.i64()
            ensure impossible or result != BalanceState.Impossible.i64()
            ensure impossible or planted or result == BalanceState.Airborne.i64()
            ensure impossible or not planted or not com_inside or result == BalanceState.Supported.i64()
            ensure impossible or not planted or com_inside or result == BalanceState.Outside.i64()
            return BalanceState.Impossible.i64() if impossible
            return BalanceState.Airborne.i64() if not planted
            return BalanceState.Supported.i64() if com_inside
            return BalanceState.Outside.i64()

        # Whether the timeline marks a frame in this state.
        def marked(s: i64) -> bool:
            ensure not result or s == BalanceState.Impossible.i64()
            ensure s != BalanceState.Impossible.i64() or result
            return s == BalanceState.Impossible.i64()

        # A timeline bin keeps the worst state seen so far (0 for an empty bin).
        def worst(level: i64, s: i64) -> i64:
            requires level >= BalanceState.Airborne.i64()
            requires level <= BalanceState.Impossible.i64()
            requires s >= BalanceState.Airborne.i64()
            requires s <= BalanceState.Impossible.i64()
            ensure result >= level
            ensure result >= s
            ensure result == level or result == s
            ensure result <= BalanceState.Impossible.i64()
            return s if s > level
            return level

        # The next curve mode (rotation, position, rotation, ...).
        def next_mode(mode: i64) -> i64:
            ensure result >= CurveMode.Rotation.i64()
            ensure result < Count::CURVE_MODES
            ensure mode != CurveMode.Rotation.i64() or result == CurveMode.Position.i64()
            ensure mode == CurveMode.Rotation.i64() or result == CurveMode.Rotation.i64()
            return CurveMode.Position.i64() if mode == CurveMode.Rotation.i64()
            return CurveMode.Rotation.i64()

        # The channel the curve view plots: the one `mode` asks for when the
        # bone has it, else the other one, else -1. Channels are indices
        # (-1 when the bone has none).
        def channel(mode: i64, rotation: i64, position: i64) -> i64:
            requires rotation >= -1
            requires position >= -1
            ensure result >= -1
            ensure result == rotation or result == position or result == -1
            ensure mode == CurveMode.Position.i64() or rotation < 0 or result == rotation
            ensure mode != CurveMode.Position.i64() or position < 0 or result == position
            ensure rotation >= 0 or position >= 0 or result == -1
            ensure rotation < 0 and position < 0 or result >= 0
            if mode == CurveMode.Position.i64():
                return position if position >= 0
                return rotation if rotation >= 0
                return -1
            return rotation if rotation >= 0
            return position if position >= 0
            return -1

        # The live drag preview shows while a gizmo drag runs in a view and
        # a bone is selected.
        def preview(drag_view: i64, dragging: bool, bone: i64) -> bool:
            ensure not result or drag_view >= 0
            ensure not result or dragging
            ensure not result or bone >= 0
            ensure drag_view < 0 or not dragging or bone < 0 or result
            return false if drag_view < 0
            return false if not dragging
            return bone >= 0
