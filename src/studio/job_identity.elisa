# Exact scalar identity carried across an asynchronous studio job boundary.
# The worker adapter must copy this value into its result; hashes are not IDs.
module StudioJobIdentity:
    public:
        enum Kind:
            Load
            Analysis
            Rebuild
            Export

        struct Identity:
            kind: Kind
            document_revision: i64
            generation: i64
            take_serial: i64
            stack_generation: i64
            first_frame: i64
            last_frame: i64
            playhead_frame: i64

        def valid(identity: Identity&) -> bool:
            (identity.document_revision >= 0 and identity.generation > 0 and
                identity.take_serial >= 0 and identity.stack_generation >= 0 and
                identity.first_frame >= -1 and identity.last_frame >= -1 and
                (identity.first_frame == -1 and identity.last_frame == -1 or
                 identity.first_frame >= 0 and identity.last_frame >= identity.first_frame) and
                identity.playhead_frame >= -1)

        # Full field equality is required at result publication. In particular,
        # matching a document revision or generation alone is insufficient.
        def equal(left: Identity&, right: Identity&) -> bool:
            (left.kind == right.kind and
                left.document_revision == right.document_revision and
                left.generation == right.generation and
                left.take_serial == right.take_serial and
                left.stack_generation == right.stack_generation and
                left.first_frame == right.first_frame and
                left.last_frame == right.last_frame and
                left.playhead_frame == right.playhead_frame)

        # Memo restoration depends only on the exact loaded source generation;
        # stack/range/playhead supersession rejects the preview but does not
        # invalidate a cache owned by the same source revision.
        def same_source(left: Identity&, right: Identity&) -> bool:
            (left.document_revision == right.document_revision and
                left.take_serial == right.take_serial)

        def may_publish(active: Identity&, completed: Identity&, cancelled: bool) -> bool:
            ensure not cancelled implies result == (valid(active) and valid(completed) and equal(active, completed))
            ensure cancelled implies not result
            (not cancelled and valid(active) and valid(completed) and equal(active, completed))
