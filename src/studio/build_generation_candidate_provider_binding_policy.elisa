# Exact decoding rules for the bounded native candidate provider ABI.
module StudioBuildGenerationCandidateProviderBindingPolicy:
    public:
        const enum DecodeKind of i64:
            Valid = 0
            Unknown = 1

        struct DecodedInteger:
            kind: DecodeKind
            value: i64

        def decode_outcome(raw: i32) -> DecodedInteger:
            DecodedInteger{kind: DecodeKind.Valid if raw >= 0 and raw <= 2 else DecodeKind.Unknown, value: raw.i64()}

        def decode_artifact(raw: i32) -> DecodedInteger:
            DecodedInteger{kind: DecodeKind.Valid if raw >= 0 and raw <= 1 else DecodeKind.Unknown, value: raw.i64()}

        def decode_phase(raw: i32) -> DecodedInteger:
            DecodedInteger{kind: DecodeKind.Valid if raw >= 0 and raw <= 5 else DecodeKind.Unknown, value: raw.i64()}

        def decode_protection(raw: i32) -> DecodedInteger:
            DecodedInteger{kind: DecodeKind.Valid if raw >= 0 and raw <= 6 else DecodeKind.Unknown, value: raw.i64()}

        def decode_boolean(raw: i32) -> DecodeKind:
            ensure result == (DecodeKind.Valid if raw == 0 or raw == 1 else DecodeKind.Unknown)
            DecodeKind.Valid if raw == 0 or raw == 1 else DecodeKind.Unknown

        def row_output_admitted(status: i32, artifact: i32, phase: i32,
                                protection: i32, sealed_identity: i32,
                                device: i64, inode: i64, age_days: i64, age_known: i32,
                                retention_days: i64, size_bytes: i64,
                                size_known: i32, path_bytes: i64,
                                id_bytes: i64) -> bool:
            ensure result implies decode_artifact(artifact).kind == DecodeKind.Valid
            ensure result implies decode_phase(phase).kind == DecodeKind.Valid
            ensure result implies decode_protection(protection).kind == DecodeKind.Valid
            decode_boolean(sealed_identity) == DecodeKind.Valid and decode_boolean(age_known) == DecodeKind.Valid and decode_boolean(size_known) == DecodeKind.Valid and device >= 0 and inode >= 0 and (age_known == 0 or age_days >= 0) and retention_days >= 0 and (size_known == 0 or size_bytes >= 0 and size_bytes <= 1000000000000000) and path_bytes > 0 and path_bytes <= 4095 and id_bytes > 0 and id_bytes <= 96 and decode_artifact(artifact).kind == DecodeKind.Valid and decode_phase(phase).kind == DecodeKind.Valid and decode_protection(protection).kind == DecodeKind.Valid and status == 0
