# Pure report-row hit mapping shared by the warning report panel.
include "export_batch_report_view.elisa"
module StudioExportBatchReportPanelPolicy:
    public:
        const module Layout:
            PAGE_ROWS: i64 = StudioExportBatchReportView::Limit::SEGMENTS_PER_PAGE.i64()

        def line_at_offset(offset: i64, visible_count: i64) -> i64:
            requires visible_count >= 0 and visible_count <= Layout::PAGE_ROWS
            ensure result >= -1 and result < visible_count
            ensure offset >= 0 and offset < visible_count implies result == offset
            return -1 if offset < 0 or offset >= visible_count
            offset
