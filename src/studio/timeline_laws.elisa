# Timeline laws: stepping, wrapping, speed and pixel mapping.
include "timeline.elisa"

module TimelineLaws:
    public:
        # A zero step leaves the playhead where it is, looping or not.
        def step_zero_identity(frame: i64, count: i64, looping: bool) -> i64:
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            requires frame >= 0
            requires frame < count
            ensure result == frame
            return Timeline::step_looped(frame, 0, count) if looping
            return Timeline::step_clamped(frame, 0, count)

        # Clamping twice is clamping once.
        def clamp_idempotent(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            once: i64 = Timeline::clamp(frame, count)
            twice: i64 = Timeline::clamp(once, count)
            return twice - once

        # Stepping past the last frame holds the last frame.
        def step_holds_end(count: i64) -> i64:
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == count - 1
            return Timeline::step_clamped(count - 1, 1, count)

        # Stepping before the first frame holds frame 0.
        def step_holds_start(count: i64) -> i64:
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            return Timeline::step_clamped(0, -1, count)

        # Looping wraps the last frame forward onto the first.
        def loop_wraps_end(count: i64) -> i64:
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            return Timeline::step_looped(count - 1, 1, count)

        # Half speed never advances further than real time.
        def half_not_faster(elapsed: i64) -> bool:
            requires elapsed >= 0
            requires elapsed <= Timeline::MAX_STEP_US
            ensure result
            return Timeline::advance_us(elapsed, Timeline::HALF) <= elapsed

        # Quarter speed never advances further than real time.
        def quarter_not_faster(elapsed: i64) -> bool:
            requires elapsed >= 0
            requires elapsed <= Timeline::MAX_STEP_US
            ensure result
            return Timeline::advance_us(elapsed, Timeline::QUARTER) <= elapsed

        # Full speed is real time inside the step cap.
        def full_is_real_time(elapsed: i64) -> i64:
            requires elapsed >= 0
            requires elapsed <= Timeline::MAX_STEP_US
            ensure result == elapsed
            return Timeline::advance_us(elapsed, Timeline::FULL)

        # Time never runs backwards.
        def never_backwards(elapsed: i64, d: i64) -> i64:
            requires d >= 1
            requires d <= 4
            ensure result >= 0
            return Timeline::advance_us(elapsed, d)

        # The left edge of the strip is frame 0, and frame 0 sits at x = 0.
        def left_edge_is_first(width: i64, count: i64) -> i64:
            requires width >= 1
            requires width <= Timeline::MAX_PIXELS
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            return Timeline::frame_at_x(0, width, count)

        def first_at_left(width: i64, count: i64) -> i64:
            requires width >= 1
            requires width <= Timeline::MAX_PIXELS
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            return Timeline::x_of_frame(0, width, count)

        # Clicks left of the strip land on frame 0.
        def left_of_strip(x: i64, width: i64, count: i64) -> i64:
            requires x < 0
            requires width >= 1
            requires width <= Timeline::MAX_PIXELS
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            return Timeline::frame_at_x(x, width, count)

        # Time zero shows frame 0.
        def zero_time_first_frame(count: i64) -> i64:
            requires count >= 1
            requires count <= Timeline::MAX_FRAMES
            ensure result == 0
            return Timeline::frame_at_time(0, count)
