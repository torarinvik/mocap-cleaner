include "timeline_goto_kernel.elisa"

module StudioTimelineGotoDraftPolicy:
    public:
        struct Target:
            take: i64
            document: i64
            stack: i64
            frames: i64

        def current(target: Target, take: i64, document: i64, stack: i64, frames: i64) -> bool:
            ensure result == (target.take >= 0 and target.take == take and target.document >= 0 and target.document == document and target.stack >= 0 and target.stack == stack and target.frames >= 1 and target.frames <= StudioTimelineGotoKernel::MAX_FRAMES and target.frames == frames)
            target.take >= 0 and target.take == take and target.document >= 0 and target.document == document and target.stack >= 0 and target.stack == stack and target.frames >= 1 and target.frames <= StudioTimelineGotoKernel::MAX_FRAMES and target.frames == frames
