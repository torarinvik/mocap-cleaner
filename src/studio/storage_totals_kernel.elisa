# Scalar arithmetic boundary for Storage totals. All arguments are plain
# integers so the safety and display facts can be established independently
# of the mutable UI adapter.
module StudioStorageTotalsKernel:
    public:
        # Kept equal to StudioStorageManifest::Capacity::MAX_ENTRIES and
        # StudioStorageReceiptPolicy::Limit::MAX_ITEM_BYTES; runtime tests pin this.
        const module Capacity:
            MAX_ITEMS: i64 = 256
            MAX_ITEM_BYTES: i64 = 1000000000000000
            MAX_TOTAL_BYTES: i64 = 256000000000000000

        const module Unit:
            BYTES: i64 = 0
            KIB: i64 = 1
            MIB: i64 = 2
            GIB: i64 = 3
            TIB: i64 = 4

        def add_allowed(count: i64, total: i64, size_bytes: i64) -> bool:
            ensure result implies (count >= 0 and count < Capacity::MAX_ITEMS and total >= 0 and total <= Capacity::MAX_TOTAL_BYTES and size_bytes >= 0 and size_bytes <= Capacity::MAX_ITEM_BYTES and total <= Capacity::MAX_TOTAL_BYTES - size_bytes)
            ensure (count >= 0 and count < Capacity::MAX_ITEMS and total >= 0 and total <= Capacity::MAX_TOTAL_BYTES and size_bytes >= 0 and size_bytes <= Capacity::MAX_ITEM_BYTES and total <= Capacity::MAX_TOTAL_BYTES - size_bytes) implies result
            return false if count < 0 or count >= Capacity::MAX_ITEMS
            return false if total < 0 or total > Capacity::MAX_TOTAL_BYTES
            return false if size_bytes < 0 or size_bytes > Capacity::MAX_ITEM_BYTES
            total <= Capacity::MAX_TOTAL_BYTES - size_bytes

        def next_total(total: i64, size_bytes: i64) -> i64:
            requires total >= 0 and total <= Capacity::MAX_TOTAL_BYTES
            requires size_bytes >= 0 and size_bytes <= Capacity::MAX_ITEM_BYTES
            requires total <= Capacity::MAX_TOTAL_BYTES - size_bytes
            ensure result == total + size_bytes
            total + size_bytes

        def next_count(count: i64) -> i64:
            requires count >= 0 and count < Capacity::MAX_ITEMS
            ensure result == count + 1
            count + 1

        # IEC display unit selected by thresholds, without a symbolic loop.
        def display_unit(bytes: i64) -> i64:
            requires bytes >= 0 and bytes <= Capacity::MAX_TOTAL_BYTES
            ensure result >= Unit::BYTES and result <= Unit::TIB
            ensure bytes >= 1099511627776 implies result == Unit::TIB
            ensure (bytes >= 1073741824 and bytes < 1099511627776) implies result == Unit::GIB
            ensure (bytes >= 1048576 and bytes < 1073741824) implies result == Unit::MIB
            ensure (bytes >= 1024 and bytes < 1048576) implies result == Unit::KIB
            ensure bytes < 1024 implies result == Unit::BYTES
            if bytes >= 1099511627776:
                return Unit::TIB
            if bytes >= 1073741824:
                return Unit::GIB
            if bytes >= 1048576:
                return Unit::MIB
            if bytes >= 1024:
                return Unit::KIB
            Unit::BYTES

        def nonnegative_quotient(value: i64, divisor: i64) -> i64:
            requires value >= 0 and divisor > 0
            ensure result >= 0 and result <= value
            ensure result == value / divisor
            value / divisor

        def display_divisor(unit: i64) -> i64:
            requires unit >= Unit::BYTES and unit <= Unit::TIB
            ensure result >= 1 and result <= 1099511627776
            1099511627776 if unit >= Unit::TIB else 1073741824 if unit >= Unit::GIB else 1048576 if unit >= Unit::MIB else 1024 if unit >= Unit::KIB else 1

        # Whole units are truncated, keeping exact bytes in the total while
        # the display carries a compact IEC magnitude and unit.
        def display_magnitude(bytes: i64, unit: i64) -> i64:
            requires bytes >= 0 and bytes <= Capacity::MAX_TOTAL_BYTES
            requires unit >= Unit::BYTES and unit <= Unit::TIB
            ensure result >= 0
            ensure result <= bytes
            divisor: i64 = display_divisor(unit)
            nonnegative_quotient(bytes, divisor)
