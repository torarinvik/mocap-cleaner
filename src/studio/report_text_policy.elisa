# Bounds for report-only formatting slots; independent of per-frame UI text.
module StudioReportTextPolicy:
    public:
        const module Buffer:
            SLOTS: i64 = 160
            WIDTH: i64 = 512
            CAPACITY: i64 = 81920

        def stack_counts_admitted(operations: i64, bands: i64, contacts: i64, corrections: i64) -> bool:
            ensure result == (operations >= 0 and operations <= 16 and bands >= 0 and bands <= 8 and contacts >= 0 and contacts <= 32 and corrections >= 0 and corrections <= 16)
            ensure result implies 2 + 2 * (operations + bands + contacts + corrections) <= Buffer::SLOTS
            operations >= 0 and operations <= 16 and bands >= 0 and bands <= 8 and contacts >= 0 and contacts <= 32 and corrections >= 0 and corrections <= 16

        def offset(slot: i64) -> i64:
            requires slot >= 0 and slot < Buffer::SLOTS
            ensure result == slot * Buffer::WIDTH
            ensure result >= 0 and result + Buffer::WIDTH <= Buffer::CAPACITY
            slot * Buffer::WIDTH

        def next_slot(slot: i64) -> i64:
            requires slot >= 0 and slot < Buffer::SLOTS
            ensure result >= 0 and result < Buffer::SLOTS
            ensure slot == Buffer::SLOTS - 1 or result == slot + 1
            ensure slot != Buffer::SLOTS - 1 or result == 0
            return 0 if slot == Buffer::SLOTS - 1
            slot + 1
