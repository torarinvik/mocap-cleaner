# Admission consumes verified recovery facts. It cannot establish those facts:
# output_matches must mean exact bytes or a qualified digest, not a residue.
module StudioExportRecoveryPolicy:
    public:
        def retry_admitted(output_exists: bool, output_matches: bool,
                           snapshot_valid: bool, workspace_matches: bool,
                           report_missing: bool, operation_idle: bool) -> bool:
            ensure result implies output_exists
            ensure result implies output_matches
            ensure result implies snapshot_valid
            ensure result implies workspace_matches
            ensure result implies report_missing
            ensure result implies operation_idle
            ensure output_exists and output_matches and snapshot_valid and workspace_matches and report_missing and operation_idle implies result
            output_exists and output_matches and snapshot_valid and workspace_matches and report_missing and operation_idle
