include "export_recovery_capacity_policy.elisa"

module StudioExportRecoveryInventoryPolicy:
    public:
        def add_admitted(total: i64, bytes: i64) -> bool:
            ensure result == (total >= 0 and total <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES and bytes >= 0 and bytes <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES - total)
            total >= 0 and total <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES and bytes >= 0 and bytes <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES - total

        def next_total(total: i64, bytes: i64) -> i64:
            requires total >= 0 and total <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES
            requires bytes >= 0 and bytes <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES - total
            requires bytes <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES
            ensure result == total + bytes
            ensure result >= 0 and result <= StudioExportRecoveryCapacityPolicy::Capacity::RETAINED_BYTES
            total + bytes
