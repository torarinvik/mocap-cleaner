# Integer pixel geometry after the renderer bounds platform dimensions.
module StudioTooltipLayoutPolicy:
    public:
        const module Limit:
            EXTENT: i64 = 16384

        def extent(available: i64, requested: i64) -> i64:
            requires available >= 0 and available <= Limit::EXTENT
            requires requested >= 0 and requested <= Limit::EXTENT
            ensure result >= 0 and result <= available
            ensure result <= requested
            ensure requested <= available or result == available
            requested if requested <= available else available

        def origin(available: i64, size: i64, preferred: i64) -> i64:
            requires available >= 0 and available <= Limit::EXTENT
            requires size >= 0 and size <= available
            requires preferred >= -Limit::EXTENT and preferred <= Limit::EXTENT
            ensure result >= 0 and result + size <= available
            ensure preferred < 0 or preferred + size > available or result == preferred
            return 0 if preferred < 0
            available - size if preferred > available - size else preferred
