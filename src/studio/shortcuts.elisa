# Keyboard shortcut decoding for the studio: a held-modifier mask kept from
# key down/up events, and the undo/redo chord rule (Cmd-Z undoes, Cmd-Shift-Z
# redoes; Ctrl stands in for Cmd). Keys pressed with Cmd or Ctrl held never
# reach the plain single-key bindings.
module StudioShortcuts:
    public:
        const module Modifiers:
            COMMAND: i64 = 1
            SHIFT: i64 = 2
            ALL: i64 = 3

        # What a key press does.
        const enum KeyAction of i64:
            Plain = 0
            Undo = 1
            Redo = 2
            Swallow = 3

        # Cmd (or Ctrl) is held: the odd masks.
        def command(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == (mask == 1 or mask == 3)
            return mask == 1 or mask == 3

        # Shift is held.
        def shift(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == (mask >= 2)
            return mask >= 2

        # `mask` after Cmd (or Ctrl) went down / up, and Shift down / up.
        def command_down(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 1 or result == 3
            ensure mask >= 2 or result == 1
            ensure mask < 2 or result == 3
            return 1 if mask < 2
            return 3

        def command_up(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 0 or result == 2
            ensure mask >= 2 or result == 0
            ensure mask < 2 or result == 2
            return 0 if mask < 2
            return 2

        def shift_down(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 2 or result == 3
            ensure mask == 1 or mask == 3 or result == 2
            ensure mask == 0 or mask == 2 or result == 3
            return 2 if mask == 0 or mask == 2
            return 3

        def shift_up(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 0 or result == 1
            ensure mask == 1 or mask == 3 or result == 0
            ensure mask == 0 or mask == 2 or result == 1
            return 0 if mask == 0 or mask == 2
            return 1

        # Action of Z pressed with `mask` held.
        def z_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == KeyAction.Plain.i64() or result == KeyAction.Undo.i64() or result == KeyAction.Redo.i64()
            ensure mask == 1 or mask == 3 or result == KeyAction.Plain.i64()
            ensure mask != 1 or result == KeyAction.Undo.i64()
            ensure mask != 3 or result == KeyAction.Redo.i64()
            return KeyAction.Undo.i64() if mask == 1
            return KeyAction.Redo.i64() if mask == 3
            return KeyAction.Plain.i64()

        # Action of any other key pressed with `mask` held.
        def other_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == KeyAction.Plain.i64() or result == KeyAction.Swallow.i64()
            ensure mask == 1 or mask == 3 or result == KeyAction.Plain.i64()
            ensure mask == 0 or mask == 2 or result == KeyAction.Swallow.i64()
            return KeyAction.Swallow.i64() if mask == 1 or mask == 3
            return KeyAction.Plain.i64()

        # A focused text/numeric draft owns its key stream. The event layer
        # still handles the field's local Enter/Backspace/Escape behavior,
        # but routes global plain-key and command actions through this gate.
        def text_key_route(typing: bool, action: i64) -> i64:
            requires action >= KeyAction.Plain.i64()
            requires action <= KeyAction.Swallow.i64()
            ensure result >= KeyAction.Plain.i64()
            ensure result <= KeyAction.Swallow.i64()
            ensure not typing or result == KeyAction.Swallow.i64()
            ensure typing or result == action
            return KeyAction.Swallow.i64() if typing
            action

        # File actions are decoded before the plain-key bindings, so they
        # need the same text-entry guard as undo/redo and other shortcuts.
        def text_file_route(typing: bool, action: i64) -> i64:
            requires action >= FileAction.None.i64()
            requires action <= FileAction.ExportAs.i64()
            ensure result >= FileAction.None.i64()
            ensure result <= FileAction.ExportAs.i64()
            ensure not typing or result == FileAction.None.i64()
            ensure typing or result == action
            return FileAction.None.i64() if typing
            action

        # File chords: what O, S and E do with `mask` held. Without Cmd they
        # give FILE_NONE, so the plain keys keep their single-key bindings.
        const enum FileAction of i64:
            None = 0
            OpenTake = 1
            OpenSession = 2
            Save = 3
            SaveAs = 4
            ExportAs = 5

        def o_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == FileAction.None.i64() or result == FileAction.OpenTake.i64() or result == FileAction.OpenSession.i64()
            ensure mask == 1 or mask == 3 or result == FileAction.None.i64()
            ensure mask != 1 or result == FileAction.OpenTake.i64()
            ensure mask != 3 or result == FileAction.OpenSession.i64()
            return FileAction.OpenTake.i64() if mask == 1
            return FileAction.OpenSession.i64() if mask == 3
            return FileAction.None.i64()

        def s_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == FileAction.None.i64() or result == FileAction.Save.i64() or result == FileAction.SaveAs.i64()
            ensure mask == 1 or mask == 3 or result == FileAction.None.i64()
            ensure mask != 1 or result == FileAction.Save.i64()
            ensure mask != 3 or result == FileAction.SaveAs.i64()
            return FileAction.Save.i64() if mask == 1
            return FileAction.SaveAs.i64() if mask == 3
            return FileAction.None.i64()

        def e_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == FileAction.None.i64() or result == FileAction.ExportAs.i64()
            ensure mask == 1 or mask == 3 or result == FileAction.None.i64()
            ensure mask != 1 or result == FileAction.ExportAs.i64()
            ensure mask != 3 or result == FileAction.ExportAs.i64()
            return FileAction.ExportAs.i64() if mask == 1 or mask == 3
            return FileAction.None.i64()
