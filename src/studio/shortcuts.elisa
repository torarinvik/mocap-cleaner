# Keyboard shortcut decoding for the studio: a held-modifier mask kept from
# key down/up events, and the undo/redo chord rule (Cmd-Z undoes, Cmd-Shift-Z
# redoes; Ctrl stands in for Cmd). Keys pressed with Cmd or Ctrl held never
# reach the plain single-key bindings.
module StudioShortcuts:
    public:
        const module Modifiers:
            COMMAND: i64 = 1
            SHIFT: i64 = 2
            ALL: i64 = 3

        # What a key press does.
        const PLAIN: i64 = 0      # the single-key binding
        const UNDO: i64 = 1
        const REDO: i64 = 2
        const SWALLOW: i64 = 3    # a chord with no binding

        # Cmd (or Ctrl) is held: the odd masks.
        def command(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == (mask == 1 or mask == 3)
            return mask == 1 or mask == 3

        # Shift is held.
        def shift(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == (mask >= 2)
            return mask >= 2

        # `mask` after Cmd (or Ctrl) went down / up, and Shift down / up.
        def command_down(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 1 or result == 3
            ensure mask >= 2 or result == 1
            ensure mask < 2 or result == 3
            return 1 if mask < 2
            return 3

        def command_up(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 0 or result == 2
            ensure mask >= 2 or result == 0
            ensure mask < 2 or result == 2
            return 0 if mask < 2
            return 2

        def shift_down(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 2 or result == 3
            ensure mask == 1 or mask == 3 or result == 2
            ensure mask == 0 or mask == 2 or result == 3
            return 2 if mask == 0 or mask == 2
            return 3

        def shift_up(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == 0 or result == 1
            ensure mask == 1 or mask == 3 or result == 0
            ensure mask == 0 or mask == 2 or result == 1
            return 0 if mask == 0 or mask == 2
            return 1

        # Action of Z pressed with `mask` held.
        def z_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == PLAIN or result == UNDO or result == REDO
            ensure mask == 1 or mask == 3 or result == PLAIN
            ensure mask != 1 or result == UNDO
            ensure mask != 3 or result == REDO
            return UNDO if mask == 1
            return REDO if mask == 3
            return PLAIN

        # Action of any other key pressed with `mask` held.
        def other_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == PLAIN or result == SWALLOW
            ensure mask == 1 or mask == 3 or result == PLAIN
            ensure mask == 0 or mask == 2 or result == SWALLOW
            return SWALLOW if mask == 1 or mask == 3
            return PLAIN

        # A focused text/numeric draft owns its key stream. The event layer
        # still handles the field's local Enter/Backspace/Escape behavior,
        # but routes global plain-key and command actions through this gate.
        def text_key_route(typing: bool, action: i64) -> i64:
            requires action >= PLAIN
            requires action <= SWALLOW
            ensure result >= PLAIN
            ensure result <= SWALLOW
            ensure not typing or result == SWALLOW
            ensure typing or result == action
            return SWALLOW if typing
            action

        # File actions are decoded before the plain-key bindings, so they
        # need the same text-entry guard as undo/redo and other shortcuts.
        def text_file_route(typing: bool, action: i64) -> i64:
            requires action >= FILE_NONE
            requires action <= EXPORT_AS
            ensure result >= FILE_NONE
            ensure result <= EXPORT_AS
            ensure not typing or result == FILE_NONE
            ensure typing or result == action
            return FILE_NONE if typing
            action

        # File chords: what O, S and E do with `mask` held. Without Cmd they
        # give FILE_NONE, so the plain keys keep their single-key bindings.
        const FILE_NONE: i64 = 0
        const OPEN_TAKE: i64 = 1      # Cmd-O
        const OPEN_SESSION: i64 = 2   # Cmd-Shift-O
        const SAVE: i64 = 3           # Cmd-S
        const SAVE_AS: i64 = 4        # Cmd-Shift-S
        const EXPORT_AS: i64 = 5      # Cmd-E or Cmd-Shift-E

        def o_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == FILE_NONE or result == OPEN_TAKE or result == OPEN_SESSION
            ensure mask == 1 or mask == 3 or result == FILE_NONE
            ensure mask != 1 or result == OPEN_TAKE
            ensure mask != 3 or result == OPEN_SESSION
            return OPEN_TAKE if mask == 1
            return OPEN_SESSION if mask == 3
            return FILE_NONE

        def s_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == FILE_NONE or result == SAVE or result == SAVE_AS
            ensure mask == 1 or mask == 3 or result == FILE_NONE
            ensure mask != 1 or result == SAVE
            ensure mask != 3 or result == SAVE_AS
            return SAVE if mask == 1
            return SAVE_AS if mask == 3
            return FILE_NONE

        def e_chord(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= Modifiers::ALL
            ensure result == FILE_NONE or result == EXPORT_AS
            ensure mask == 1 or mask == 3 or result == FILE_NONE
            ensure mask != 1 or result == EXPORT_AS
            ensure mask != 3 or result == EXPORT_AS
            return EXPORT_AS if mask == 1 or mask == 3
            return FILE_NONE
