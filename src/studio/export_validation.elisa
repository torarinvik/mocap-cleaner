# Export preparation diagnostics distinguish file creation from validation.
module StudioExportValidation:
    public:
        const module Result:
            READY: i64 = 0
            WRITE_FAILED: i64 = 1
            RELOAD_FAILED: i64 = 2
            CONTENT_MISMATCH: i64 = 3

        def valid_result(code: i64) -> bool:
            code >= Result::READY and code <= Result::CONTENT_MISMATCH

        def message(code: i64) -> sview:
            return "export failed validation: reloaded GLB could not be read" if code == Result::RELOAD_FAILED
            return "export failed validation: reloaded GLB differs from the reviewed result" if code == Result::CONTENT_MISMATCH
            return "export failed: cleaned GLB could not be written" if code == Result::WRITE_FAILED
            return "export validated" if code == Result::READY
            "export status unavailable: unknown validation result"

        def is_ready(code: i64) -> bool:
            ensure result == (code == Result::READY)
            code == Result::READY
