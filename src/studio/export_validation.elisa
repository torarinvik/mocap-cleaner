# Export preparation diagnostics distinguish file creation from validation.
module StudioExportValidation:
    public:
        const READY: i64 = 0
        const WRITE_FAILED: i64 = 1
        const RELOAD_FAILED: i64 = 2
        const CONTENT_MISMATCH: i64 = 3

        def valid_result(code: i64) -> bool:
            code >= READY and code <= CONTENT_MISMATCH

        def message(code: i64) -> sview:
            return "export failed validation: reloaded GLB could not be read" if code == RELOAD_FAILED
            return "export failed validation: reloaded GLB differs from the reviewed result" if code == CONTENT_MISMATCH
            return "export failed: cleaned GLB could not be written" if code == WRITE_FAILED
            return "export validated"

        def is_ready(code: i64) -> bool:
            ensure result == (code == READY)
            code == READY
