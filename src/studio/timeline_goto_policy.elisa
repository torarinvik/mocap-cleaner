# Pure policy for the Studio timeline's user-facing Go to frame field.
# Input is a positive, 1-based decimal frame; output is a 0-based playhead.
module StudioTimelineGotoPolicy:
    public:
        const EMPTY: i64 = -2
        const INVALID: i64 = -1
        const EXACT: i64 = 0
        const CLAMPED: i64 = 1
        const MAX_FRAMES: i64 = 10000000

        struct Result:
            status: mutable i64
            frame: mutable i64

        # Convert a validated 1-based frame number into the clip's 0-based
        # frame, clamping only values beyond the clip.
        def bounded_frame(one_based: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= MAX_FRAMES
            requires one_based >= 1
            ensure result >= 0
            ensure result < count
            return count - 1 if one_based > count
            one_based - 1

        # Parse a frame number. Empty and malformed input do not move the
        # playhead; valid numbers above the clip length select its final frame.
        def parse(text: sview, count: i64) -> Result:
            requires count >= 1
            requires count <= MAX_FRAMES
            return Result{status: EMPTY, frame: -1} if text.len <= 0 or text.data == null
            mutable value: i64 = 0
            for i in 0..<text.len.usize() |i, text, value, count|:
                c: u8 = text.data[i]
                return Result{status: INVALID, frame: -1} if c < 48 or c > 57
                digit: i64 = (c - 48).i64()
                # Keep the accumulator bounded while retaining enough
                # information to know the input is beyond the clip.
                value <- count + 1 if value >= count + 1 or value > count / 10 or value == count / 10 and digit > count % 10 else value * 10 + digit
            return Result{status: INVALID, frame: -1} if value == 0
            return Result{status: CLAMPED, frame: bounded_frame(value, count)} if value > count
            Result{status: EXACT, frame: bounded_frame(value, count)}
