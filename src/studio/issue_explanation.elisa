# Plain-language, unit-preserving explanation derived from a finding row.
include "issues.elisa"
module StudioIssueExplanation:
    public:
        const MOTION_SPIKE: i64 = 0
        const CATEGORY_MOTION_SPIKE: i64 = 0
        const CATEGORY_OTHER_MOTION: i64 = 1
        const LEVEL_MILD: i64 = 0
        const LEVEL_CLEAR: i64 = 1
        const LEVEL_STRONG: i64 = 2

        struct Explanation:
            category: i64
            level: i64
            peak_frame: i64
            first_frame: i64
            last_frame: i64
            severity_permille: i64
            peak_value: i64
            threshold: i64
            excess: i64
            subject_id: i64

        def valid_issue(issue: StudioIssues::Issue) -> bool:
            return issue.first_frame >= 0 and issue.last_frame >= issue.first_frame and issue.peak_frame >= issue.first_frame and issue.peak_frame <= issue.last_frame and issue.issue_type >= 0 and issue.subject_id >= -1 and issue.severity >= 0 and issue.severity <= StudioIssues::MAX_SEVERITY and issue.peak_value >= 0 and issue.threshold >= 0

        def category(issue_type: i64) -> i64:
            ensure issue_type == MOTION_SPIKE or result == CATEGORY_OTHER_MOTION
            ensure issue_type != MOTION_SPIKE or result == CATEGORY_MOTION_SPIKE
            return CATEGORY_MOTION_SPIKE if issue_type == MOTION_SPIKE
            return CATEGORY_OTHER_MOTION

        # Severity is the peak-to-threshold ratio in permille, capped by the
        # issue collector. Labels describe detector strength, not repair priority.
        def level(severity_permille: i64) -> i64:
            requires severity_permille >= 0 and severity_permille <= StudioIssues::MAX_SEVERITY
            ensure severity_permille < 500 or result != LEVEL_MILD
            ensure severity_permille < 500 or severity_permille >= StudioIssues::MAX_SEVERITY or result == LEVEL_CLEAR
            return LEVEL_MILD if severity_permille < 500
            return LEVEL_CLEAR if severity_permille < StudioIssues::MAX_SEVERITY
            return LEVEL_STRONG

        def explain(issue: StudioIssues::Issue) -> Explanation:
            requires valid_issue(issue)
            ensure result.peak_frame == issue.peak_frame
            ensure result.excess == issue.peak_value - issue.threshold
            ensure result.category == category(issue.issue_type)
            return Explanation{category: category(issue.issue_type), level: level(issue.severity), peak_frame: issue.peak_frame, first_frame: issue.first_frame, last_frame: issue.last_frame, severity_permille: issue.severity, peak_value: issue.peak_value, threshold: issue.threshold, excess: issue.peak_value - issue.threshold, subject_id: issue.subject_id}
