# Plain-language, unit-preserving explanation derived from a finding row.
include "issues.elisa"
include "issue_explanation_policy.elisa"
module StudioIssueExplanation:
    public:
        struct Explanation:
            category: i64
            level: i64
            peak_frame: i64
            first_frame: i64
            last_frame: i64
            severity_permille: i64
            peak_value: i64
            threshold: i64
            excess: i64
            subject_id: i64

        def valid_issue(issue: StudioIssues::Issue) -> bool:
            return issue.first_frame >= 0 and issue.last_frame >= issue.first_frame and issue.peak_frame >= issue.first_frame and issue.peak_frame <= issue.last_frame and issue.issue_type >= 0 and issue.subject_id >= -1 and issue.severity >= 0 and issue.severity <= StudioIssues::MAX_SEVERITY and issue.peak_value >= 0 and issue.threshold >= 0

        # Carries exact detector units and peak location through to review.
        # The record assembly uses aggregate field construction, which the
        # current prover does not model; focused runtime coverage lives in test/.
        def explain(issue: StudioIssues::Issue) -> Explanation:
            requires valid_issue(issue)
            return Explanation{category: StudioIssueExplanationPolicy::category(issue.issue_type), level: StudioIssueExplanationPolicy::level(issue.severity), peak_frame: issue.peak_frame, first_frame: issue.first_frame, last_frame: issue.last_frame, severity_permille: issue.severity, peak_value: issue.peak_value, threshold: issue.threshold, excess: issue.peak_value - issue.threshold, subject_id: issue.subject_id}
