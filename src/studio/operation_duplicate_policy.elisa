# Pure index and capacity rules for exact stack-operation duplication.
module StudioOperationDuplicatePolicy:
    public:
        const MAX_OPS: i64 = 16

        def available(count: i64, selected: i64) -> bool:
            ensure result == (count >= 1 and count < MAX_OPS and selected >= 0 and selected < count)
            count >= 1 and count < MAX_OPS and selected >= 0 and selected < count

        # Place the copy directly after its selected source operation.
        def target(selected: i64, count: i64) -> i64:
            requires count >= 1 and count < MAX_OPS
            requires selected >= 0 and selected < count
            ensure result == selected + 1
            ensure result >= 1 and result < count + 1
            selected + 1

        # The old stack slot supplying each slot in the result array. The
        # duplicate slot reuses `selected`; later entries shift one to the
        # right. `i` ranges from zero through the new last index, `count`.
        def source(i: i64, selected: i64, count: i64) -> i64:
            requires count >= 1 and count < MAX_OPS
            requires selected >= 0 and selected < count
            requires i >= 0 and i <= count
            ensure result >= 0 and result < count
            ensure i <= selected or i >= selected + 2 or result == selected
            ensure i <= selected or i == selected + 1 or result == i - 1
            return selected if i == selected + 1
            return i if i <= selected
            i - 1
