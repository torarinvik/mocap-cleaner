# Copy every nested byte array into the caller-selected allocation region.
# A Clip must not retain the Memo's source-reference buffer descriptors.
include "take_source_ref_policy.elisa"

module StudioTakeSourceRefCopy:
    public:
        def copy[@r](source: StudioTakeSourceRefPolicy::TakeSourceRef&) -> StudioTakeSourceRefPolicy::TakeSourceRef @r can Memory.Allocate:
            ensure result.format == source.format
            ensure result.original_path.count == source.original_path.count
            ensure result.original_sha256.count == source.original_sha256.count
            ensure result.runtime_glb_path.count == source.runtime_glb_path.count
            ensure result.runtime_glb_sha256.count == source.runtime_glb_sha256.count
            ensure result.importer_revision.count == source.importer_revision.count
            ensure result.options_sha256.count == source.options_sha256.count
            ensure StudioTakeSourceRefPolicy::bytes_equal(result.original_path, source.original_path)
            ensure StudioTakeSourceRefPolicy::bytes_equal(result.original_sha256, source.original_sha256)
            ensure StudioTakeSourceRefPolicy::bytes_equal(result.runtime_glb_path, source.runtime_glb_path)
            ensure StudioTakeSourceRefPolicy::bytes_equal(result.runtime_glb_sha256, source.runtime_glb_sha256)
            ensure StudioTakeSourceRefPolicy::bytes_equal(result.importer_revision, source.importer_revision)
            ensure StudioTakeSourceRefPolicy::bytes_equal(result.options_sha256, source.options_sha256)
            return StudioTakeSourceRefPolicy::TakeSourceRef{format: source.format,
                original_path: bytes(source.original_path), original_sha256: bytes(source.original_sha256),
                runtime_glb_path: bytes(source.runtime_glb_path), runtime_glb_sha256: bytes(source.runtime_glb_sha256),
                importer_revision: bytes(source.importer_revision), options_sha256: bytes(source.options_sha256)}

    private:
        def bytes[@r](source: darray[u8]&) -> darray[u8] @r can Memory.Allocate:
            ensure result.count == source.count
            ensure StudioTakeSourceRefPolicy::bytes_equal(result, source)
            mutable output: darray[u8] @r = []
            output.extend(source)
            return move output
