# Scalar limits and admission rules for exact output-to-source time maps.
include "export_recovery_budget_policy.elisa"

module StudioExportTimeMapPolicy:
    public:
        const module Unit:
            MILLI_SOURCE_FRAMES: i64 = 1000
        const module Capacity:
            MAX_SOURCE_FRAMES: i64 = 10000000
            # Retime advances by at least MIN_RATE milli-frames per output
            # step. This conservative ceiling covers all valid generated maps.
            MAX_OUTPUT_FRAMES: i64 = 100000000
            MAX_SOURCE_TIME: i64 = 9999999000
        def counts_admitted(source_frames: i64, output_frames: i64) -> bool:
            ensure result == (source_frames >= 1 and source_frames <= Capacity::MAX_SOURCE_FRAMES and output_frames >= 1 and output_frames <= Capacity::MAX_OUTPUT_FRAMES)
            source_frames >= 1 and source_frames <= Capacity::MAX_SOURCE_FRAMES and output_frames >= 1 and output_frames <= Capacity::MAX_OUTPUT_FRAMES

        def source_time_admitted(value: i64, source_frames: i64) -> bool:
            requires source_frames >= 1 and source_frames <= Capacity::MAX_SOURCE_FRAMES
            ensure result == (value >= 0 and value <= (source_frames - 1) * Unit::MILLI_SOURCE_FRAMES)
            value >= 0 and value <= (source_frames - 1) * Unit::MILLI_SOURCE_FRAMES

        def next_time_ordered(previous: i64, current: i64, source_frames: i64) -> bool:
            requires source_frames >= 1 and source_frames <= Capacity::MAX_SOURCE_FRAMES
            ensure result == (previous >= 0 and previous < current and current <= (source_frames - 1) * Unit::MILLI_SOURCE_FRAMES)
            previous >= 0 and previous < current and current <= (source_frames - 1) * Unit::MILLI_SOURCE_FRAMES

        def budget_add_admitted(current: i64, incoming: i64) -> bool:
            ensure result == (current >= 0 and current <= StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES and incoming >= 0 and incoming <= StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES - current)
            current >= 0 and current <= StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES and incoming >= 0 and incoming <= StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES - current
