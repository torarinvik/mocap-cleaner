# Admission for snapshots of the bounded per-frame status formatter.
module StudioStatusTextExtentPolicy:
    public:
        const module Limit:
            BYTES: i64 = 128

        def admitted(count: i64, readable: bool) -> bool:
            ensure result implies count >= 0 and count <= Limit::BYTES
            ensure result and count > 0 implies readable
            count >= 0 and count <= Limit::BYTES and (count == 0 or readable)
