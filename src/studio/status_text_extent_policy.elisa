# Count and non-null admission for bounded per-frame status snapshots.
# The caller must supply a valid borrowed view; presence is not a span proof.
module StudioStatusTextExtentPolicy:
    public:
        const module Limit:
            BYTES: i64 = 128

        def admitted(count: i64, has_data: bool) -> bool:
            ensure result implies count >= 0 and count <= Limit::BYTES
            ensure result and count > 0 implies has_data
            count >= 0 and count <= Limit::BYTES and (count == 0 or has_data)
