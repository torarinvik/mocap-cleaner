# Proofable, fixed point categories for issue explanations.
module StudioIssueExplanationPolicy:
    public:
        const module Detector:
            MOTION_SPIKE: i64 = 0

        const enum Category of i64:
            MotionSpike = 0
            OtherMotion = 1

        const enum Level of i64:
            Mild = 0
            Clear = 1
            Strong = 2

        def category(issue_type: i64) -> Category:
            ensure issue_type == Detector::MOTION_SPIKE or result == Category.OtherMotion
            ensure issue_type != Detector::MOTION_SPIKE or result == Category.MotionSpike
            return Category.MotionSpike if issue_type == Detector::MOTION_SPIKE
            return Category.OtherMotion

        def displayed_peak_exceeds(peak_value: i64, threshold: i64) -> bool:
            ensure result == (peak_value > threshold)
            peak_value > threshold

        # Severity is the peak-to-threshold ratio in permille, capped by the
        # issue collector. Labels describe detector strength, not repair priority.
        def level(severity_permille: i64) -> Level:
            ensure result.i64() >= Level.Mild.i64()
            ensure result.i64() <= Level.Strong.i64()
            return Level.Strong if severity_permille >= 1000
            return Level.Clear if severity_permille >= 500
            return Level.Mild
