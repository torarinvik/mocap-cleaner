# Proofable, fixed point categories for issue explanations.
module StudioIssueExplanationPolicy:
    public:
        const module Detector:
            MOTION_SPIKE: i64 = 0

        const module Category:
            MOTION_SPIKE: i64 = 0
            OTHER_MOTION: i64 = 1

        const module Level:
            MILD: i64 = 0
            CLEAR: i64 = 1
            STRONG: i64 = 2

        def category(issue_type: i64) -> i64:
            ensure issue_type == Detector::MOTION_SPIKE or result == Category::OTHER_MOTION
            ensure issue_type != Detector::MOTION_SPIKE or result == Category::MOTION_SPIKE
            return Category::MOTION_SPIKE if issue_type == Detector::MOTION_SPIKE
            return Category::OTHER_MOTION

        # Severity is the peak-to-threshold ratio in permille, capped by the
        # issue collector. Labels describe detector strength, not repair priority.
        def level(severity_permille: i64) -> i64:
            ensure result >= Level::MILD
            ensure result <= Level::STRONG
            return Level::STRONG if severity_permille >= 1000
            return Level::CLEAR if severity_permille >= 500
            return Level::MILD
