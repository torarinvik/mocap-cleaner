# A completed background result is usable only for the displayed document
# revision and the currently requested job generation. Cancellation is sticky
# for that request. Publication is functional: a rejected result returns the
# prior valid value unchanged.
module StudioJobPolicy:
    public:
        const enum Decision of i64:
            Reject = 0
            Apply = 1

        # At most one owned worker runs at a time. While it runs, callers keep
        # only the latest scalar request identity; a new worker starts after
        # the old result has been joined and its memo ownership reclaimed.
        def may_start_worker(running: bool, request_pending: bool,
                             memo_available: bool) -> bool:
            ensure result == (not running and request_pending and memo_available)
            ensure running implies not result
            ensure not request_pending implies not result
            ensure not memo_available implies not result
            not running and request_pending and memo_available

        # Cancellation is sticky for the lifetime of a request, including
        # when supersession arrives after the worker has begun executing.
        def sticky_cancel(previously_cancelled: bool, superseded: bool) -> bool:
            ensure previously_cancelled implies result
            ensure superseded implies result
            ensure result == (previously_cancelled or superseded)
            previously_cancelled or superseded

        # A close approval belongs to one precise saved/edit state. A worker
        # drain may take many frames, during which the user can still edit.
        def close_approval_matches(approved_take: i64, current_take: i64,
                                   approved_document: i64, current_document: i64,
                                   approved_stack: i64, current_stack: i64,
                                   approved_cursor: i64, current_cursor: i64,
                                   approved_saved_cursor: i64, current_saved_cursor: i64,
                                   approved_saved_valid: bool, current_saved_valid: bool) -> bool:
            (approved_take == current_take and
                approved_document == current_document and
                approved_stack == current_stack and
                approved_cursor == current_cursor and
                approved_saved_cursor == current_saved_cursor and
                approved_saved_valid == current_saved_valid)

        # The expanded form is used by async callers that retain a cancellation
        # bit while a worker is finishing. Generation zero means no request.
        def lifecycle_decision(displayed_revision: i64, requested_generation: i64,
                               result_revision: i64, result_generation: i64,
                               cancelled: bool) -> Decision:
            requires displayed_revision >= 0
            requires requested_generation >= 0
            requires result_revision >= 0
            requires result_generation >= 0
            ensure result == Decision.Reject or result == Decision.Apply
            ensure result == Decision.Apply or cancelled or requested_generation == 0 or displayed_revision != result_revision or requested_generation != result_generation
            ensure result == Decision.Reject or not cancelled
            ensure result == Decision.Reject or displayed_revision == result_revision
            ensure result == Decision.Reject or requested_generation == result_generation
            ensure result == Decision.Reject or requested_generation > 0
            return Decision.Reject if cancelled
            return Decision.Reject if requested_generation == 0
            return Decision.Reject if displayed_revision != result_revision
            return Decision.Reject if requested_generation != result_generation
            Decision.Apply

        # Preserve a previously published valid value when an async result is
        # stale, superseded, inactive, or cancelled. Values are opaque integers
        # here so the gate remains independent of evaluator result shape.
        def publish_value(last_valid: i64, result_value: i64, decision: Decision) -> i64:
            requires decision == Decision.Reject or decision == Decision.Apply
            ensure result == (result_value if decision == Decision.Apply else last_valid)
            return result_value if decision == Decision.Apply
            last_valid

        # Generations are positive and must be freshly assigned to each job;
        # zero means there is no active job. Revisions identify document content.
        def decision(displayed_revision: i64, active_generation: i64,
                     result_revision: i64, result_generation: i64) -> Decision:
            requires displayed_revision >= 0
            requires active_generation >= 0
            requires result_revision >= 0
            requires result_generation >= 0
            ensure result == Decision.Reject or result == Decision.Apply
            ensure result == Decision.Apply or displayed_revision != result_revision or active_generation == 0 or active_generation != result_generation
            ensure result == Decision.Reject or displayed_revision == result_revision
            ensure result == Decision.Reject or active_generation == result_generation
            ensure result == Decision.Reject or active_generation > 0
            return Decision.Reject if active_generation == 0
            return Decision.Reject if displayed_revision != result_revision
            return Decision.Reject if active_generation != result_generation
            Decision.Apply
