# Scalar state policy for the durable reviewed-identity -> Trash receipt
# transaction. A successful move means StudioFileTrash returned a valid receipt.
module StudioStorageMovePolicy:
    public:
        const enum MoveState of i64:
            NotAttempted = 0
            Verified = 1
            # Use only when a fresh exact-identity snapshot confirms the file is
            # back at its original path; the native return code alone is not proof.
            FailedOriginalKnown = 2
            UnknownAfterFailure = 3

        const enum WriteState of i64:
            NotAttempted = 0
            Succeeded = 1
            Failed = 2
            Unknown = 3

        const enum RollbackState of i64:
            NotAttempted = 0
            Succeeded = 1
            Failed = 2
            Unknown = 3

        const enum Outcome of i64:
            Invalid = 0
            NotStarted = 1
            MoveFailedOriginal = 2
            MoveUnknown = 3
            ReceiptPending = 4
            DurabilityUnknown = 5
            Recorded = 6
            RollbackRequired = 7
            OriginalRestored = 8
            RecoveryReceiptRetained = 9
            RollbackUnknownReceiptRetained = 10

        const module Capacity:
            OUTCOME_COUNT: i64 = 11

        # Only resolved states permit another move. Even if a caller loses the
        # retained-receipt flag, unresolved or unknown transaction facts block.
        def may_start_new_move(retained_receipt_present: bool,
                               move_outcome: i64) -> bool:
            ensure result == (not retained_receipt_present and (move_outcome == Outcome.NotStarted.i64() or move_outcome == Outcome.MoveFailedOriginal.i64() or move_outcome == Outcome.Recorded.i64() or move_outcome == Outcome.OriginalRestored.i64()))
            not retained_receipt_present and (move_outcome == Outcome.NotStarted.i64() or move_outcome == Outcome.MoveFailedOriginal.i64() or move_outcome == Outcome.Recorded.i64() or move_outcome == Outcome.OriginalRestored.i64())

        # The native checked move may run only after a durable, valid identity
        # has been freshly matched, freshly deemed eligible, and confirmed.
        def may_move(durable_reviewed_identity: bool,
                    reviewed_identity_valid: bool,
                    fresh_identity_matches: bool,
                    fresh_eligible: bool,
                    review_confirmed: bool) -> bool:
            ensure result == (durable_reviewed_identity and reviewed_identity_valid and fresh_identity_matches and fresh_eligible and review_confirmed)
            durable_reviewed_identity and reviewed_identity_valid and fresh_identity_matches and fresh_eligible and review_confirmed

        def pre_move_outcome(move_state: i64, write_state: i64,
                             rollback_state: i64) -> i64:
            ensure result >= Outcome.Invalid.i64()
            ensure result <= Outcome.MoveUnknown.i64()
            ensure result == (Outcome.Invalid.i64() if move_state < MoveState.NotAttempted.i64() or move_state > MoveState.UnknownAfterFailure.i64() or move_state == MoveState.Verified.i64() or write_state != WriteState.NotAttempted.i64() or rollback_state != RollbackState.NotAttempted.i64() else Outcome.NotStarted.i64() if move_state == MoveState.NotAttempted.i64() else Outcome.MoveFailedOriginal.i64() if move_state == MoveState.FailedOriginalKnown.i64() else Outcome.MoveUnknown.i64())
            return Outcome.Invalid.i64() if move_state < MoveState.NotAttempted.i64() or move_state > MoveState.UnknownAfterFailure.i64() or move_state == MoveState.Verified.i64()
            return Outcome.Invalid.i64() if write_state != WriteState.NotAttempted.i64() or rollback_state != RollbackState.NotAttempted.i64()
            return Outcome.NotStarted.i64() if move_state == MoveState.NotAttempted.i64()
            return Outcome.MoveFailedOriginal.i64() if move_state == MoveState.FailedOriginalKnown.i64()
            Outcome.MoveUnknown.i64()

        def failed_write_outcome(rollback_state: i64) -> i64:
            ensure result >= Outcome.Invalid.i64()
            ensure result <= Outcome.RollbackUnknownReceiptRetained.i64()
            ensure result == (Outcome.Invalid.i64() if rollback_state < RollbackState.NotAttempted.i64() or rollback_state > RollbackState.Unknown.i64() else Outcome.RollbackRequired.i64() if rollback_state == RollbackState.NotAttempted.i64() else Outcome.OriginalRestored.i64() if rollback_state == RollbackState.Succeeded.i64() else Outcome.RecoveryReceiptRetained.i64() if rollback_state == RollbackState.Failed.i64() else Outcome.RollbackUnknownReceiptRetained.i64())
            return Outcome.Invalid.i64() if rollback_state < RollbackState.NotAttempted.i64() or rollback_state > RollbackState.Unknown.i64()
            if rollback_state == RollbackState.NotAttempted.i64():
                return Outcome.RollbackRequired.i64()
            if rollback_state == RollbackState.Succeeded.i64():
                return Outcome.OriginalRestored.i64()
            if rollback_state == RollbackState.Failed.i64():
                return Outcome.RecoveryReceiptRetained.i64()
            Outcome.RollbackUnknownReceiptRetained.i64()

        def verified_move_outcome(write_state: i64, rollback_state: i64) -> i64:
            ensure result >= Outcome.Invalid.i64()
            ensure result <= Outcome.RollbackUnknownReceiptRetained.i64()
            return Outcome.Invalid.i64() if write_state < WriteState.NotAttempted.i64() or write_state > WriteState.Unknown.i64()
            return Outcome.Invalid.i64() if rollback_state < RollbackState.NotAttempted.i64() or rollback_state > RollbackState.Unknown.i64()
            if write_state == WriteState.NotAttempted.i64():
                return Outcome.ReceiptPending.i64() if rollback_state == RollbackState.NotAttempted.i64()
                return Outcome.Invalid.i64()
            if write_state == WriteState.Unknown.i64():
                return Outcome.DurabilityUnknown.i64() if rollback_state == RollbackState.NotAttempted.i64()
                return Outcome.Invalid.i64()
            if write_state == WriteState.Succeeded.i64():
                return Outcome.Recorded.i64() if rollback_state == RollbackState.NotAttempted.i64()
                return Outcome.Invalid.i64()
            failed_write_outcome(rollback_state)

        # Inputs describe known operation facts. UNKNOWN remains separate from
        # NOT_ATTEMPTED: in particular, failed manifest persistence with no
        # rollback yet requires rollback; it does not imply either outcome.
        def outcome(move_state: i64, write_state: i64, rollback_state: i64) -> i64:
            ensure result >= Outcome.Invalid.i64()
            ensure result <= Outcome.RollbackUnknownReceiptRetained.i64()
            return Outcome.Invalid.i64() if move_state < MoveState.NotAttempted.i64() or move_state > MoveState.UnknownAfterFailure.i64()
            return Outcome.Invalid.i64() if write_state < WriteState.NotAttempted.i64() or write_state > WriteState.Unknown.i64()
            return Outcome.Invalid.i64() if rollback_state < RollbackState.NotAttempted.i64() or rollback_state > RollbackState.Unknown.i64()
            if move_state != MoveState.Verified.i64():
                return Outcome.Invalid.i64() if write_state != WriteState.NotAttempted.i64() or rollback_state != RollbackState.NotAttempted.i64()
                return pre_move_outcome(move_state, write_state, rollback_state)
            verified_move_outcome(write_state, rollback_state)
