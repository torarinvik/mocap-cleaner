# Scalar state policy for the durable reviewed-identity -> Trash receipt
# transaction. A successful move means StudioFileTrash returned a valid receipt.
module StudioStorageMovePolicy:
    public:
        const MOVE_NOT_ATTEMPTED: i64 = 0
        const MOVE_VERIFIED: i64 = 1
        # Use only when a fresh exact-identity snapshot confirms the file is
        # back at its original path; the native return code alone is not proof.
        const MOVE_FAILED_ORIGINAL_KNOWN: i64 = 2
        const MOVE_UNKNOWN_AFTER_FAILURE: i64 = 3

        const WRITE_NOT_ATTEMPTED: i64 = 0
        const WRITE_SUCCEEDED: i64 = 1
        const WRITE_FAILED: i64 = 2
        const WRITE_UNKNOWN: i64 = 3

        const ROLLBACK_NOT_ATTEMPTED: i64 = 0
        const ROLLBACK_SUCCEEDED: i64 = 1
        const ROLLBACK_FAILED: i64 = 2
        const ROLLBACK_UNKNOWN: i64 = 3

        const OUTCOME_INVALID: i64 = 0
        const OUTCOME_NOT_STARTED: i64 = 1
        const OUTCOME_MOVE_FAILED_ORIGINAL: i64 = 2
        const OUTCOME_MOVE_UNKNOWN: i64 = 3
        const OUTCOME_RECEIPT_PENDING: i64 = 4
        const OUTCOME_DURABILITY_UNKNOWN: i64 = 5
        const OUTCOME_RECORDED: i64 = 6
        const OUTCOME_ROLLBACK_REQUIRED: i64 = 7
        const OUTCOME_ORIGINAL_RESTORED: i64 = 8
        const OUTCOME_RECOVERY_RECEIPT_RETAINED: i64 = 9
        const OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED: i64 = 10
        const OUTCOME_COUNT: i64 = 11

        # A new move cannot replace an unresolved native move or an in-memory
        # recovery receipt. Outcomes outside the declared state range are also
        # rejected conservatively.
        def may_start_new_move(retained_receipt_present: bool,
                               move_outcome: i64) -> bool:
            ensure result == (not retained_receipt_present and move_outcome > OUTCOME_INVALID and move_outcome < OUTCOME_COUNT and move_outcome != OUTCOME_MOVE_UNKNOWN and move_outcome != OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED)
            not retained_receipt_present and move_outcome > OUTCOME_INVALID and move_outcome < OUTCOME_COUNT and move_outcome != OUTCOME_MOVE_UNKNOWN and move_outcome != OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED

        # The native checked move may run only after a durable, valid identity
        # has been freshly matched, freshly deemed eligible, and confirmed.
        def may_move(durable_reviewed_identity: bool,
                    reviewed_identity_valid: bool,
                    fresh_identity_matches: bool,
                    fresh_eligible: bool,
                    review_confirmed: bool) -> bool:
            ensure result == (durable_reviewed_identity and reviewed_identity_valid and fresh_identity_matches and fresh_eligible and review_confirmed)
            durable_reviewed_identity and reviewed_identity_valid and fresh_identity_matches and fresh_eligible and review_confirmed

        def pre_move_outcome(move_state: i64, write_state: i64,
                             rollback_state: i64) -> i64:
            ensure result >= OUTCOME_INVALID
            ensure result <= OUTCOME_MOVE_UNKNOWN
            ensure result == (OUTCOME_INVALID if move_state < MOVE_NOT_ATTEMPTED or move_state > MOVE_UNKNOWN_AFTER_FAILURE or move_state == MOVE_VERIFIED or write_state != WRITE_NOT_ATTEMPTED or rollback_state != ROLLBACK_NOT_ATTEMPTED else OUTCOME_NOT_STARTED if move_state == MOVE_NOT_ATTEMPTED else OUTCOME_MOVE_FAILED_ORIGINAL if move_state == MOVE_FAILED_ORIGINAL_KNOWN else OUTCOME_MOVE_UNKNOWN)
            return OUTCOME_INVALID if move_state < MOVE_NOT_ATTEMPTED or move_state > MOVE_UNKNOWN_AFTER_FAILURE or move_state == MOVE_VERIFIED
            return OUTCOME_INVALID if write_state != WRITE_NOT_ATTEMPTED or rollback_state != ROLLBACK_NOT_ATTEMPTED
            return OUTCOME_NOT_STARTED if move_state == MOVE_NOT_ATTEMPTED
            return OUTCOME_MOVE_FAILED_ORIGINAL if move_state == MOVE_FAILED_ORIGINAL_KNOWN
            OUTCOME_MOVE_UNKNOWN

        def failed_write_outcome(rollback_state: i64) -> i64:
            ensure result >= OUTCOME_INVALID
            ensure result <= OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED
            ensure result == (OUTCOME_INVALID if rollback_state < ROLLBACK_NOT_ATTEMPTED or rollback_state > ROLLBACK_UNKNOWN else OUTCOME_ROLLBACK_REQUIRED if rollback_state == ROLLBACK_NOT_ATTEMPTED else OUTCOME_ORIGINAL_RESTORED if rollback_state == ROLLBACK_SUCCEEDED else OUTCOME_RECOVERY_RECEIPT_RETAINED if rollback_state == ROLLBACK_FAILED else OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED)
            return OUTCOME_INVALID if rollback_state < ROLLBACK_NOT_ATTEMPTED or rollback_state > ROLLBACK_UNKNOWN
            if rollback_state == ROLLBACK_NOT_ATTEMPTED:
                return OUTCOME_ROLLBACK_REQUIRED
            if rollback_state == ROLLBACK_SUCCEEDED:
                return OUTCOME_ORIGINAL_RESTORED
            if rollback_state == ROLLBACK_FAILED:
                return OUTCOME_RECOVERY_RECEIPT_RETAINED
            OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED

        def verified_move_outcome(write_state: i64, rollback_state: i64) -> i64:
            ensure result >= OUTCOME_INVALID
            ensure result <= OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED
            return OUTCOME_INVALID if write_state < WRITE_NOT_ATTEMPTED or write_state > WRITE_UNKNOWN
            return OUTCOME_INVALID if rollback_state < ROLLBACK_NOT_ATTEMPTED or rollback_state > ROLLBACK_UNKNOWN
            if write_state == WRITE_NOT_ATTEMPTED:
                return OUTCOME_RECEIPT_PENDING if rollback_state == ROLLBACK_NOT_ATTEMPTED
                return OUTCOME_INVALID
            if write_state == WRITE_UNKNOWN:
                return OUTCOME_DURABILITY_UNKNOWN if rollback_state == ROLLBACK_NOT_ATTEMPTED
                return OUTCOME_INVALID
            if write_state == WRITE_SUCCEEDED:
                return OUTCOME_RECORDED if rollback_state == ROLLBACK_NOT_ATTEMPTED
                return OUTCOME_INVALID
            failed_write_outcome(rollback_state)

        # Inputs describe known operation facts. UNKNOWN remains separate from
        # NOT_ATTEMPTED: in particular, failed manifest persistence with no
        # rollback yet requires rollback; it does not imply either outcome.
        def outcome(move_state: i64, write_state: i64, rollback_state: i64) -> i64:
            ensure result >= OUTCOME_INVALID
            ensure result <= OUTCOME_ROLLBACK_UNKNOWN_RECEIPT_RETAINED
            return OUTCOME_INVALID if move_state < MOVE_NOT_ATTEMPTED or move_state > MOVE_UNKNOWN_AFTER_FAILURE
            return OUTCOME_INVALID if write_state < WRITE_NOT_ATTEMPTED or write_state > WRITE_UNKNOWN
            return OUTCOME_INVALID if rollback_state < ROLLBACK_NOT_ATTEMPTED or rollback_state > ROLLBACK_UNKNOWN
            if move_state != MOVE_VERIFIED:
                return OUTCOME_INVALID if write_state != WRITE_NOT_ATTEMPTED or rollback_state != ROLLBACK_NOT_ATTEMPTED
                return pre_move_outcome(move_state, write_state, rollback_state)
            verified_move_outcome(write_state, rollback_state)
