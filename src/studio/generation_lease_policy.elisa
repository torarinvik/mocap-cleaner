# A Studio window may start only after the native adapter has acquired a
# process-lifetime shared lease on the exact running artifact.
module StudioGenerationLeasePolicy:
    public:
        const enum AcquireStatus of i64:
            Acquired = 0
            MetadataUnavailable = 1
            LeaseBusy = 2
            ArtifactChanged = 3
            NativeFailure = 4

        def admitted(status: AcquireStatus) -> bool:
            ensure result == (status == AcquireStatus.Acquired)
            status == AcquireStatus.Acquired

        def refusal_is_closed(status: AcquireStatus) -> bool:
            requires status != AcquireStatus.Acquired
            ensure not result
            not admitted(status)
