# These facts come from completed native writes and directory synchronization.
# Admission does not turn a successful write into evidence of crash durability.
module StudioExportRecoveryPreparePolicy:
    public:
        def publication_admitted(owned_directory: bool, capacity_reserved: bool,
                                 output_snapshot_synced: bool, json_snapshot_synced: bool,
                                 text_snapshot_synced: bool, journal_synced: bool,
                                 directory_synced: bool) -> bool:
            ensure result implies owned_directory
            ensure result implies capacity_reserved
            ensure result implies output_snapshot_synced
            ensure result implies json_snapshot_synced
            ensure result implies text_snapshot_synced
            ensure result implies journal_synced
            ensure result implies directory_synced
            ensure owned_directory and capacity_reserved and output_snapshot_synced and json_snapshot_synced and text_snapshot_synced and journal_synced and directory_synced implies result
            owned_directory and capacity_reserved and output_snapshot_synced and json_snapshot_synced and text_snapshot_synced and journal_synced and directory_synced
