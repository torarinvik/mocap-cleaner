include "export_batch_queue_policy.elisa"

module StudioExportBatchItemPolicy:
    public:
        def valid(state: StudioExportBatchQueuePolicy::ItemState, warning_count: i64, approved: bool) -> bool:
            ensure result == (state >= StudioExportBatchQueuePolicy::ItemState.Queued and state <= StudioExportBatchQueuePolicy::ItemState.Recoverable and warning_count >= 0 and (not approved or state == StudioExportBatchQueuePolicy::ItemState.Warning or state == StudioExportBatchQueuePolicy::ItemState.AwaitingReview) and (state != StudioExportBatchQueuePolicy::ItemState.Warning and state != StudioExportBatchQueuePolicy::ItemState.AwaitingReview or warning_count > 0) and (state == StudioExportBatchQueuePolicy::ItemState.Failed or state == StudioExportBatchQueuePolicy::ItemState.Warning or state == StudioExportBatchQueuePolicy::ItemState.AwaitingReview or state == StudioExportBatchQueuePolicy::ItemState.Recoverable or warning_count == 0))
            return false if state < StudioExportBatchQueuePolicy::ItemState.Queued or state > StudioExportBatchQueuePolicy::ItemState.Recoverable
            return false if warning_count < 0
            return false if approved and state != StudioExportBatchQueuePolicy::ItemState.Warning and state != StudioExportBatchQueuePolicy::ItemState.AwaitingReview
            return false if (state == StudioExportBatchQueuePolicy::ItemState.Warning or state == StudioExportBatchQueuePolicy::ItemState.AwaitingReview) and warning_count == 0
            return false if state != StudioExportBatchQueuePolicy::ItemState.Failed and state != StudioExportBatchQueuePolicy::ItemState.Warning and state != StudioExportBatchQueuePolicy::ItemState.AwaitingReview and state != StudioExportBatchQueuePolicy::ItemState.Recoverable and warning_count != 0
            true
