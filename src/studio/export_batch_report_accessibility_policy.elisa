include "accessibility.elisa"
include "export_batch_warning_review_policy.elisa"
include "export_batch_report_view.elisa"

# Stable identities for the prepared-export report review dialog. The block
# begins immediately after the highest existing Studio ID in this domain.
module StudioExportBatchReportAccessibilityPolicy:
    public:
        const module Node:
            DIALOG: usize = 274
            STATUS: usize = 275
            LINE_FIRST: usize = 276
            LINE_COUNT: i64 = StudioExportBatchReportView::Limit::SEGMENTS_PER_PAGE.i64()
            CONTROL_FIRST: usize = LINE_FIRST + LINE_COUNT.usize()
            CONTROL_COUNT: i64 = 4
            LAST: usize = CONTROL_FIRST + CONTROL_COUNT.usize() - 1

        def is_node(id: usize) -> bool:
            id == Node::DIALOG or id == Node::STATUS or (id >= Node::LINE_FIRST and id < Node::CONTROL_FIRST) or (id >= Node::CONTROL_FIRST and id <= Node::LAST)

        def line_id(row: i64) -> usize:
            requires row >= 0 and row < Node::LINE_COUNT
            ensure result == Node::LINE_FIRST + row.usize()
            Node::LINE_FIRST + row.usize()

        def control_id(control: StudioExportBatchWarningReviewPolicy::Control) -> usize:
            ensure result >= Node::CONTROL_FIRST and result <= Node::LAST and result < StudioAccessibility::SemanticId::NO_NODE
            Node::CONTROL_FIRST + control.i64().usize()

        def control_for_slot(slot: i64) -> StudioExportBatchWarningReviewPolicy::Control:
            requires slot >= 0 and slot < Node::CONTROL_COUNT
            return StudioExportBatchWarningReviewPolicy::Control.Previous if slot == 0
            return StudioExportBatchWarningReviewPolicy::Control.Next if slot == 1
            return StudioExportBatchWarningReviewPolicy::Control.Acknowledge if slot == 2
            StudioExportBatchWarningReviewPolicy::Control.Back

        def control_for_id(id: usize) -> StudioExportBatchWarningReviewPolicy::Control?:
            return StudioExportBatchWarningReviewPolicy::Control.Previous if id == control_id(StudioExportBatchWarningReviewPolicy::Control.Previous)
            return StudioExportBatchWarningReviewPolicy::Control.Next if id == control_id(StudioExportBatchWarningReviewPolicy::Control.Next)
            return StudioExportBatchWarningReviewPolicy::Control.Acknowledge if id == control_id(StudioExportBatchWarningReviewPolicy::Control.Acknowledge)
            return StudioExportBatchWarningReviewPolicy::Control.Back if id == control_id(StudioExportBatchWarningReviewPolicy::Control.Back)
            null

        def parent_id(id: usize) -> usize:
            return StudioAccessibility::SemanticId::NO_NODE if id == Node::DIALOG
            return Node::DIALOG if is_node(id)
            StudioAccessibility::SemanticId::NO_NODE

        def first_child_id() -> usize:
            Node::STATUS

        def next_sibling_id(id: usize, visible_lines: i64) -> usize:
            requires visible_lines >= 0 and visible_lines <= Node::LINE_COUNT
            return Node::LINE_FIRST if id == Node::STATUS and visible_lines > 0
            return Node::CONTROL_FIRST if id == Node::STATUS
            row: i64 = (id - Node::LINE_FIRST).i64() if id >= Node::LINE_FIRST and id < Node::CONTROL_FIRST else -1
            return id + 1 if row >= 0 and row + 1 < visible_lines
            return Node::CONTROL_FIRST if row >= 0 and row < visible_lines
            return id + 1 if id >= Node::CONTROL_FIRST and id < Node::LAST
            StudioAccessibility::SemanticId::NO_NODE

        def ids_fit_and_follow_studio_namespace() -> bool:
            ensure result
            Node::DIALOG > StudioAccessibility::Goto::CANCEL and Node::LAST < StudioAccessibility::SemanticId::NO_NODE and Node::LINE_COUNT == StudioExportBatchReportView::Limit::SEGMENTS_PER_PAGE.i64() and Node::LINE_FIRST + Node::LINE_COUNT.usize() == Node::CONTROL_FIRST and Node::CONTROL_FIRST + Node::CONTROL_COUNT.usize() - 1 == Node::LAST
