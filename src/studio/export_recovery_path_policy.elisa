# Reserve room for record names, staging suffixes and the final NUL byte.
module StudioExportRecoveryPathPolicy:
    public:
        const module Capacity:
            PATH_BYTES: i64 = 4096
            DIRECTORY_SUFFIX_BYTES: i64 = 30
            LEAF_BYTES: i64 = 32
            STAGING_SUFFIX_BYTES: i64 = 20
            MAX_BUILD_BYTES: i64 = 4012
            MAX_DIRECTORY_BYTES: i64 = 4042

        def build_path_admitted(bytes: i64) -> bool:
            ensure result == (bytes > 0 and bytes <= Capacity::MAX_BUILD_BYTES)
            ensure result implies bytes + Capacity::DIRECTORY_SUFFIX_BYTES + 1 + Capacity::LEAF_BYTES + Capacity::STAGING_SUFFIX_BYTES + 1 <= Capacity::PATH_BYTES
            bytes > 0 and bytes <= Capacity::MAX_BUILD_BYTES

        def child_path_admitted(directory_bytes: i64, leaf_bytes: i64) -> bool:
            ensure result == (directory_bytes > 0 and directory_bytes <= Capacity::MAX_DIRECTORY_BYTES and leaf_bytes > 0 and leaf_bytes <= Capacity::LEAF_BYTES)
            ensure result implies directory_bytes + 1 + leaf_bytes + Capacity::STAGING_SUFFIX_BYTES + 1 <= Capacity::PATH_BYTES
            directory_bytes > 0 and directory_bytes <= Capacity::MAX_DIRECTORY_BYTES and leaf_bytes > 0 and leaf_bytes <= Capacity::LEAF_BYTES

