include "export_batch_review_binding.elisa"
include "export_batch_destination_projection.elisa"

# Read-only inspection of captured locations. This does not check live disk
# facts, issue review authority or authorize publication.
extend StudioExportBatchReviewBinding:
    public:
        def destination_projection(queue: BoundQueue&, index: i64) -> StudioExportBatchDestinationProjection::Snapshot?:
            ensure not valid(queue) implies result == null
            ensure index < 0 implies result == null
            ensure valid(queue) and index >= item_count(queue).i64() implies result == null
            return null if not valid(queue)
            return null if index < 0 or index >= queue.identities.count.i64()
            slot: usize = index.usize()
            # Borrow the captured path fields directly; copying an Identity
            # here would also copy its potentially large result/report payloads.
            return null if not StudioExportBatchDestinationProjection::path_admitted(queue.identities[slot].source_path)
            return null if not StudioExportBatchDestinationProjection::path_admitted(queue.identities[slot].output_path)
            return null if not StudioExportBatchDestinationProjection::path_admitted(queue.identities[slot].report_json_path)
            return null if not StudioExportBatchDestinationProjection::path_admitted(queue.identities[slot].report_text_path)
            StudioExportBatchDestinationProjection::project(queue.identities[slot].source_path,
                queue.identities[slot].output_path, queue.identities[slot].report_json_path,
                queue.identities[slot].report_text_path)
