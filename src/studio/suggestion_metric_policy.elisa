# Integer comparison rules for suggested-cleanup preservation measurements.
module StudioSuggestionMetricPolicy:
    public:
        # These are independent measurements with different units, rather than
        # mutually exclusive states. Keep their values in a const module.
        const module Tolerance:
            ANGLE_MILLI_DEGREES: i64 = 15000
            BOUNDARY_MICROMETERS: i64 = 10000
            VELOCITY_MICROMETERS_PER_SECOND: i64 = 50000

        # Keep the rounded binary64 input inside its exact integer range and
        # far below signed integer overflow. This is an adapter bound, not a
        # preservation tolerance. Unsupported measurements remain unavailable.
        const module Conversion:
            MAX_SCALED: f64 = 4503599627370495.0
            MAX_INTEGER: i64 = 4503599627370495

        def scaled_admitted(value: f64) -> bool:
            ensure result == (value - value == 0.0 and value >= 0.0 and value <= Conversion::MAX_SCALED)
            value - value == 0.0 and value >= 0.0 and value <= Conversion::MAX_SCALED

        # Call only after the computed distance and unit scaling are admitted.
        # Checking finite source coordinates is insufficient for this cast.
        def rounded_scaled(value: f64) -> i64:
            requires scaled_admitted(value)
            ensure result >= 0 and result <= Conversion::MAX_INTEGER
            (value + 0.5).i64()

        # The app converts each real pose sample to an integer delta before it
        # reaches this decision. Negative values are invalid adapter output.
        def exceeds(difference: i64, tolerance: i64) -> bool:
            requires difference >= 0
            requires tolerance >= 0
            ensure result == (difference > tolerance)
            difference > tolerance
