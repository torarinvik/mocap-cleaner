# Integer comparison rules for suggested-cleanup preservation measurements.
module StudioSuggestionMetricPolicy:
    public:
        const ANGLE_TOLERANCE_MILLI_DEGREES: i64 = 15000
        const BOUNDARY_TOLERANCE_MICROMETERS: i64 = 10000
        const VELOCITY_TOLERANCE_MICROMETERS_PER_SECOND: i64 = 50000

        # The app converts each real pose sample to an integer delta before it
        # reaches this decision. Negative values are invalid adapter output.
        def exceeds(difference: i64, tolerance: i64) -> bool:
            requires difference >= 0
            requires tolerance >= 0
            ensure result == (difference > tolerance)
            difference > tolerance
