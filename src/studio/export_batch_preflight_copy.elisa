include "export_batch_preflight_policy.elisa"

module StudioExportBatchPreflightCopy:
    public:
        def label(outcome: StudioExportBatchPreflightPolicy::Outcome) -> sview:
            match outcome:
                StudioExportBatchPreflightPolicy::Outcome.Ready: "Ready to queue"
                StudioExportBatchPreflightPolicy::Outcome.SourceUnavailable: "Source unavailable"
                StudioExportBatchPreflightPolicy::Outcome.AnimationUnavailable: "Animation unavailable"
                StudioExportBatchPreflightPolicy::Outcome.DestinationOutsideBuild: "Choose a build destination"
                StudioExportBatchPreflightPolicy::Outcome.SourceCollision: "Destination matches a source"
                StudioExportBatchPreflightPolicy::Outcome.DuplicateDestination: "Duplicate output destination"
                StudioExportBatchPreflightPolicy::Outcome.OutputOccupied: "Output already exists"
                StudioExportBatchPreflightPolicy::Outcome.ReportOccupied: "Report already exists"
                StudioExportBatchPreflightPolicy::Outcome.UnsupportedRecipe: "Recipe needs review"
                StudioExportBatchPreflightPolicy::Outcome.IncompatibleRig: "Rig mapping needs review"

        def help(outcome: StudioExportBatchPreflightPolicy::Outcome) -> sview:
            match outcome:
                StudioExportBatchPreflightPolicy::Outcome.Ready: "Dry-run checks passed. Review this input and recipe before starting the queue; publication rechecks destinations."
                StudioExportBatchPreflightPolicy::Outcome.SourceUnavailable: "Locate a readable source take and retry validation. Check that its folder is available and accessible."
                StudioExportBatchPreflightPolicy::Outcome.AnimationUnavailable: "Select an animation that exists in this take, then retry validation."
                StudioExportBatchPreflightPolicy::Outcome.DestinationOutsideBuild: "Choose an output folder inside build/ for the GLB and both reports."
                StudioExportBatchPreflightPolicy::Outcome.SourceCollision: "Choose new destinations for the GLB and reports. Every source take must remain intact."
                StudioExportBatchPreflightPolicy::Outcome.DuplicateDestination: "Give each queued GLB and report a unique destination. Review the naming recipe and retry validation."
                StudioExportBatchPreflightPolicy::Outcome.OutputOccupied: "Choose a new output filename. The queue creates new outputs and keeps existing files."
                StudioExportBatchPreflightPolicy::Outcome.ReportOccupied: "Choose a new output basename so both report filenames are available. Existing reports are kept."
                StudioExportBatchPreflightPolicy::Outcome.UnsupportedRecipe: "Review the recipe's operations and settings for this take. Resolve unsupported settings before queueing."
                StudioExportBatchPreflightPolicy::Outcome.IncompatibleRig: "Review and confirm the rig mapping for this take. Bone indices from another rig require an explicit compatible mapping."
