# Strict character policy for the Studio's immediate-mode numeric drafts.
module StudioTextEntryPolicy:
    public:
        const module Capacity:
            const MAX_CHARACTERS: i64 = 8

        def can_append(length: i64) -> bool:
            ensure result == (length >= 0 and length < Capacity::MAX_CHARACTERS)
            length >= 0 and length < Capacity::MAX_CHARACTERS

        const REJECT: i64 = -1
        const ASCII_ZERO: i64 = 48
        const ASCII_NINE: i64 = 57
        const ASCII_DOT: i64 = 46
        const ASCII_LOWER_X: i64 = 120
        const ASCII_UPPER_X: i64 = 88
        const ASCII_SPACE: i64 = 32

        # Contact endpoints are whole 1-based frame numbers. Retiming speeds
        # also accept a decimal point and the conventional x suffix.
        def route(typing: bool, character: i64, contact_frame: bool) -> i64:
            requires character >= 0
            requires character <= 255
            ensure not typing or character < ASCII_ZERO or character > ASCII_NINE or result == character
            ensure not typing or contact_frame or character != ASCII_DOT or result == character
            ensure not typing or contact_frame or character != ASCII_LOWER_X or result == character
            ensure not typing or contact_frame or character != ASCII_UPPER_X or result == character
            ensure not typing or contact_frame or character != ASCII_SPACE or result == character
            ensure typing or result == REJECT
            ensure not typing or not contact_frame or character >= ASCII_ZERO and character <= ASCII_NINE or result == REJECT
            ensure not typing or not contact_frame or character != ASCII_DOT or result == REJECT
            ensure not typing or not contact_frame or character != ASCII_LOWER_X or result == REJECT
            ensure not typing or not contact_frame or character != ASCII_UPPER_X or result == REJECT
            ensure not typing or not contact_frame or character != ASCII_SPACE or result == REJECT
            ensure typing and (character >= ASCII_ZERO and character <= ASCII_NINE or (not contact_frame and (character == ASCII_DOT or character == ASCII_LOWER_X or character == ASCII_UPPER_X or character == ASCII_SPACE))) or result == REJECT
            if not typing:
                return REJECT
            if character >= ASCII_ZERO and character <= ASCII_NINE:
                return character
            if contact_frame:
                return REJECT
            if character == ASCII_DOT or character == ASCII_LOWER_X or character == ASCII_UPPER_X or character == ASCII_SPACE:
                return character
            REJECT
