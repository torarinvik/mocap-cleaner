include "export_batch_identity.elisa"

# Retained display and accessibility ranges for one exact destination path.
# Callers supply grapheme-boundary units and a metric backed by UiTextMetrics;
# units scalar-split only when one grapheme exceeds the semantic byte cap.
module StudioExportBatchDestinationPathLineModel:
    public:
        const module Limit:
            MAX_PATH_BYTES: usize = StudioExportBatchIdentity::Limit::MAX_PATH_BYTES
            MAX_SEGMENT_BYTES: usize = 128
            LINES_PER_PAGE: usize = 5

        const enum Status of i64:
            Empty = 0
            InvalidInput = 1
            Ready = 2

        struct Unit:
            start: usize
            byte_count: usize
            split_grapheme: bool

        struct Segment:
            start: usize
            byte_count: usize
            measured_width: f32
            overflowed: bool
            measurement_unavailable: bool
            split_grapheme: bool

        struct Model:
            status: Status
            path_length: usize
            available_width: f32
            segments: darray[Segment]

        type WidthMeasure = fn(darray[u8]&, usize, usize) -> f32

        def units_cover_path(path_length: usize, units: darray[Unit]&) -> bool:
            return false if path_length == 0 or path_length > Limit::MAX_PATH_BYTES
            return false if units.count == 0 or units.count > path_length
            mutable next: usize = 0
            for index in 0..<units.count |index, next, units|:
                unit: Unit = units[index]
                return false if unit.start != next or unit.byte_count == 0 or unit.byte_count > Limit::MAX_SEGMENT_BYTES
                next <- next + unit.byte_count
                return false if next > path_length
            next == path_length

        def valid(model: Model&) -> bool:
            return false if model.path_length > Limit::MAX_PATH_BYTES or not finite(model.available_width) or model.available_width < 0.0
            if model.status == Status.Empty:
                return model.path_length == 0 and model.segments.count == 0
            if model.status == Status.InvalidInput:
                return model.segments.count == 0
            return false if model.status != Status.Ready or model.available_width <= 0.0 or model.path_length == 0 or model.segments.count == 0
            return false if model.segments.count > model.path_length
            mutable next: usize = 0
            for index in 0..<model.segments.count |index, next, model|:
                segment: Segment = model.segments[index]
                return false if segment.start != next or segment.byte_count == 0 or segment.byte_count > Limit::MAX_SEGMENT_BYTES
                return false if not segment.measurement_unavailable and (not finite(segment.measured_width) or segment.measured_width < 0.0)
                return false if segment.measurement_unavailable and segment.measured_width != -1.0
                return false if segment.measurement_unavailable and not segment.overflowed
                return false if (segment.measured_width > model.available_width or segment.measurement_unavailable) != segment.overflowed
                next <- next + segment.byte_count
                return false if next > model.path_length
            next == model.path_length

        def page_count(model: Model&) -> usize:
            requires valid(model) and model.status == Status.Ready
            ensure result > 0
            ensure result <= model.segments.count
            (model.segments.count + Limit::LINES_PER_PAGE - 1) / Limit::LINES_PER_PAGE

        def page_line_count(model: Model&, page: usize) -> usize:
            requires valid(model) and model.status == Status.Ready
            requires page < page_count(model)
            ensure result > 0 and result <= Limit::LINES_PER_PAGE
            ensure page * Limit::LINES_PER_PAGE + result <= model.segments.count
            start: usize = page * Limit::LINES_PER_PAGE
            remaining: usize = model.segments.count - start
            Limit::LINES_PER_PAGE if remaining > Limit::LINES_PER_PAGE else remaining

        def segment_at(model: Model&, page: usize, row: usize) -> Segment:
            requires valid(model) and model.status == Status.Ready
            requires page < page_count(model)
            requires row < page_line_count(model, page)
            ensure result.byte_count > 0 and result.byte_count <= Limit::MAX_SEGMENT_BYTES
            ensure result.start <= model.path_length
            ensure result.byte_count <= model.path_length - result.start
            index: usize = page * Limit::LINES_PER_PAGE + row
            model.segments[index]

        # Units are complete extended graphemes except explicitly marked
        # fallback pieces. A too-wide single unit is kept intact and marked;
        # every output segment remains byte-capped for accessibility.
        def pack(path: darray[u8]&, units: darray[Unit]&, row_width: f32,
                horizontal_inset: f32, safety_margin: f32,
                measure: WidthMeasure) -> Model can Memory.Allocate:
            requires path.count <= Limit::MAX_PATH_BYTES
            ensure valid(result)
            ensure result.path_length == path.count
            mutable geometry_valid: bool = finite(row_width) and finite(horizontal_inset) and finite(safety_margin) and row_width >= 0.0 and horizontal_inset >= 0.0 and safety_margin >= 0.0
            available_candidate: f32 = row_width - 2.0 * horizontal_inset - safety_margin if geometry_valid else 0.0
            geometry_valid <- geometry_valid and finite(available_candidate)
            available: f32 = available_candidate if geometry_valid and available_candidate > 0.0 else 0.0
            mutable segments: darray[Segment] = []
            return Model{status: Status.InvalidInput, path_length: path.count,
                available_width: 0.0, segments: segments} if not geometry_valid
            if path.count == 0:
                return Model{status: Status.Empty, path_length: 0, available_width: available, segments: segments}
            if available <= 0.0 or not units_cover_path(path.count, units):
                return Model{status: Status.InvalidInput, path_length: path.count,
                    available_width: available, segments: segments}
            mutable line_start: usize = 0
            mutable line_bytes: usize = 0
            mutable line_split: bool = false
            mutable line_width: f32 = 0.0
            for index in 0..<units.count |index, path, units, available, measure, segments, line_start, line_bytes, line_split, line_width|:
                unit: Unit = units[index]
                mutable candidate_bytes: usize = line_bytes + unit.byte_count
                mutable candidate_width: f32 = -1.0
                mutable must_flush: bool = candidate_bytes > Limit::MAX_SEGMENT_BYTES
                if line_bytes > 0 and not must_flush:
                    candidate_width <- measure(path, line_start, candidate_bytes)
                    must_flush <- not finite(candidate_width) or candidate_width < 0.0 or candidate_width > available
                if line_bytes > 0 and must_flush:
                    segments.push(Segment{start: line_start, byte_count: line_bytes,
                        measured_width: line_width, overflowed: false,
                        measurement_unavailable: false, split_grapheme: line_split})
                    line_start <- unit.start
                    line_bytes <- 0
                    line_split <- false
                    candidate_bytes <- unit.byte_count
                    candidate_width <- measure(path, unit.start, unit.byte_count)
                elif line_bytes == 0:
                    candidate_width <- measure(path, unit.start, unit.byte_count)
                unavailable: bool = not finite(candidate_width) or candidate_width < 0.0
                if unavailable:
                    segments.push(Segment{start: unit.start, byte_count: unit.byte_count,
                        measured_width: -1.0, overflowed: true,
                        measurement_unavailable: true, split_grapheme: unit.split_grapheme})
                    line_start <- unit.start + unit.byte_count
                    line_bytes <- 0
                    line_split <- false
                    line_width <- 0.0
                    continue
                line_bytes <- line_bytes + unit.byte_count
                line_split <- line_split or unit.split_grapheme
                line_width <- candidate_width
                if line_width > available:
                    segments.push(Segment{start: line_start, byte_count: line_bytes,
                        measured_width: line_width, overflowed: true,
                        measurement_unavailable: false, split_grapheme: line_split})
                    line_start <- unit.start + unit.byte_count
                    line_bytes <- 0
                    line_split <- false
                    line_width <- 0.0
            if line_bytes > 0:
                segments.push(Segment{start: line_start, byte_count: line_bytes,
                    measured_width: line_width, overflowed: false,
                    measurement_unavailable: false, split_grapheme: line_split})
            result: Model = Model{status: Status.Ready, path_length: path.count,
                available_width: available, segments: segments}
            result

    private:
        def finite(value: f32) -> bool:
            difference: f32 = value - value
            difference == difference
