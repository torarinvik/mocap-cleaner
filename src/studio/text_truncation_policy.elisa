module StudioTextTruncationPolicy:
    public:
        const module Limit:
            ELLIPSIS_BYTES: usize = 3

        def prefix_capacity(slot_width: usize) -> usize:
            ensure result <= slot_width
            ensure slot_width < Limit::ELLIPSIS_BYTES or result == slot_width - Limit::ELLIPSIS_BYTES
            return 0 if slot_width < Limit::ELLIPSIS_BYTES
            slot_width - Limit::ELLIPSIS_BYTES

        def copy_count(input_count: usize, slot_width: usize) -> usize:
            ensure result <= input_count and result <= slot_width
            ensure input_count > slot_width or result == input_count
            ensure input_count <= slot_width or result == slot_width
            slot_width if input_count > slot_width else input_count
