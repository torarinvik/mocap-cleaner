module StudioTextTruncationPolicy:
    public:
        const module Limit:
            ELLIPSIS_BYTES: usize = 3

        def prefix_capacity(slot_width: usize) -> usize:
            ensure result <= slot_width
            ensure slot_width < Limit::ELLIPSIS_BYTES or result == slot_width - Limit::ELLIPSIS_BYTES
            return 0 if slot_width < Limit::ELLIPSIS_BYTES
            slot_width - Limit::ELLIPSIS_BYTES
