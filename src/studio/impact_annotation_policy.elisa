# Source-scoped event annotations entered during suggestion review.
module StudioImpactAnnotationPolicy:
    public:
        const MAX_ANNOTATIONS: i64 = 512

        const enum ReviewState of i64:
            Unreviewed = 0
            EventsMarked = 1
            NoEventsReviewed = 2

        struct Annotation:
            source_first: i64
            source_second: i64
            source_frame: i64

        def source_matches(annotation: Annotation, first: i64, second: i64) -> bool:
            ensure result == (annotation.source_first == first and annotation.source_second == second)
            annotation.source_first == first and annotation.source_second == second

        def source_frame_valid(frame: i64, frame_count: i64) -> bool:
            ensure result == (frame >= 0 and frame < frame_count)
            frame >= 0 and frame < frame_count

        def may_mark(state: ReviewState, source_matches: bool,
                     frame_valid: bool, count: i64) -> bool:
            ensure result == (source_matches and frame_valid and count >= 0 and count < MAX_ANNOTATIONS)
            source_matches and frame_valid and count >= 0 and count < MAX_ANNOTATIONS

        def may_confirm_no_events(state: ReviewState, source_matches: bool,
                                  annotation_count: i64) -> bool:
            ensure result == (source_matches and annotation_count == 0)
            source_matches and annotation_count == 0

        def mapping_preserved(current_output: i64, candidate_output: i64) -> bool:
            requires current_output >= 0
            requires candidate_output >= 0
            ensure result == (current_output == candidate_output)
            current_output == candidate_output
