# Decode the raw native transaction ABI without treating unknown integers or
# malformed boolean outputs as filesystem facts. The app controller will use
# these results around the native calls; policy remains the authority for every
# mutation admission.
include "build_generation_trash_policy.elisa"
include "io/build_generation_trash_native.elisa"

module StudioBuildGenerationTrashBindingPolicy:
    public:
        const enum DecodeStatus of i64:
            Known = 0
            Unknown = 1

        struct DecodedStatus:
            status: StudioBuildGenerationTrashNative::Status
            known: bool

        struct DecodedPhase:
            phase: StudioBuildGenerationTrashPolicy::Phase
            known: bool

        struct DecodedLocation:
            location: StudioBuildGenerationTrashPolicy::Location
            known: bool

        struct DecodedBoolean:
            value: bool
            valid: bool

        struct BeginEvidence:
            call_acquired: bool
            handle_valid: bool
            build_root_verified: bool
            source_verified: bool
            manifest_verified: bool
            product_verified: bool
            lease_verified: bool
            lease_exclusive: bool
            descendants_verified: bool
            current_fact_valid: bool
            artifact_is_current: bool
            lease_protocol: i64
            lease_receipt_bytes: i64
            inventory_receipt_bytes: i64

        def decode_status(raw: i32) -> DecodedStatus:
            if raw == 0:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Acquired, true)
            if raw == 1:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Busy, true)
            if raw == 2:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Invalid, true)
            if raw == 3:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Changed, true)
            if raw == 4:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Unsupported, true)
            if raw == 5:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Failed, true)
            if raw == 6:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.DurabilityUnknown, true)
            if raw == 7:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Moved, true)
            if raw == 8:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.NotMoved, true)
            if raw == 9:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Restored, true)
            if raw == 10:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.LocationUnknown, true)
            if raw == 11:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.Conflict, true)
            if raw == 12:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.StaleHandle, true)
            if raw == 13:
                return DecodedStatus(StudioBuildGenerationTrashNative::Status.ReleaseUncertain, true)
            DecodedStatus(StudioBuildGenerationTrashNative::Status.Failed, false)

        def decode_phase(raw: i32) -> DecodedPhase:
            if raw == 0:
                return DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.Intent, true)
            if raw == 1:
                return DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.Quarantined, true)
            if raw == 2:
                return DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.RestoreIntent, true)
            if raw == 3:
                return DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.Restored, true)
            if raw == 4:
                return DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.Unknown, true)
            if raw == 5:
                return DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.NotMoved, true)
            DecodedPhase(StudioBuildGenerationTrashPolicy::Phase.Unknown, false)

        def decode_location(raw: i32) -> DecodedLocation:
            if raw == 0:
                return DecodedLocation(StudioBuildGenerationTrashPolicy::Location.NotMoved, true)
            if raw == 1:
                return DecodedLocation(StudioBuildGenerationTrashPolicy::Location.InQuarantine, true)
            if raw == 2:
                return DecodedLocation(StudioBuildGenerationTrashPolicy::Location.BackAtOriginal, true)
            if raw == 3:
                return DecodedLocation(StudioBuildGenerationTrashPolicy::Location.Conflict, true)
            if raw == 4:
                return DecodedLocation(StudioBuildGenerationTrashPolicy::Location.Unknown, true)
            DecodedLocation(StudioBuildGenerationTrashPolicy::Location.Unknown, false)

        def decode_boolean(raw: i32) -> DecodedBoolean:
            if raw == 0:
                return DecodedBoolean(false, true)
            if raw == 1:
                return DecodedBoolean(true, true)
            DecodedBoolean(false, false)

        def decode_begin_evidence(status_raw: i32, handle: i64,
                                  root_verified_raw: i32,
                                  source_verified_raw: i32,
                                  manifest_verified_raw: i32,
                                  product_verified_raw: i32,
                                  lease_verified_raw: i32,
                                  lease_exclusive_raw: i32,
                                  descendants_verified_raw: i32,
                                  is_current_raw: i32,
                                  lease_protocol: i64,
                                  lease_receipt_bytes: i64,
                                  inventory_receipt_bytes: i64) -> BeginEvidence:
            let status = decode_status(status_raw)
            let root_verified = decode_boolean(root_verified_raw)
            let source_verified = decode_boolean(source_verified_raw)
            let manifest_verified = decode_boolean(manifest_verified_raw)
            let product_verified = decode_boolean(product_verified_raw)
            let lease_verified = decode_boolean(lease_verified_raw)
            let lease_exclusive = decode_boolean(lease_exclusive_raw)
            let descendants_verified = decode_boolean(descendants_verified_raw)
            let is_current = decode_boolean(is_current_raw)
            BeginEvidence(
                status.known and status.status == StudioBuildGenerationTrashNative::Status.Acquired,
                handle > 0, root_verified.valid and root_verified.value,
                source_verified.valid and source_verified.value,
                manifest_verified.valid and manifest_verified.value,
                product_verified.valid and product_verified.value,
                lease_verified.valid and lease_verified.value,
                lease_exclusive.valid and lease_exclusive.value,
                descendants_verified.valid and descendants_verified.value,
                is_current.valid, is_current.value, lease_protocol,
                lease_receipt_bytes, inventory_receipt_bytes)

        def begin_evidence_admitted(evidence: BeginEvidence) -> bool:
            ensure result == (evidence.call_acquired and evidence.handle_valid and
                evidence.build_root_verified and evidence.source_verified and
                evidence.manifest_verified and evidence.product_verified and
                evidence.lease_verified and evidence.lease_exclusive and
                evidence.descendants_verified and evidence.current_fact_valid and
                not evidence.artifact_is_current and
                evidence.lease_protocol == StudioBuildGenerationTrashPolicy::Protocol::LEASE_VERSION and
                evidence.lease_receipt_bytes > 0 and evidence.lease_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and
                evidence.inventory_receipt_bytes > 0 and evidence.inventory_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES)
            (evidence.call_acquired and evidence.handle_valid and
                evidence.build_root_verified and evidence.source_verified and
                evidence.manifest_verified and evidence.product_verified and
                evidence.lease_verified and evidence.lease_exclusive and
                evidence.descendants_verified and evidence.current_fact_valid and
                not evidence.artifact_is_current and
                evidence.lease_protocol == StudioBuildGenerationTrashPolicy::Protocol::LEASE_VERSION and
                evidence.lease_receipt_bytes > 0 and evidence.lease_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and
                evidence.inventory_receipt_bytes > 0 and evidence.inventory_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES)
