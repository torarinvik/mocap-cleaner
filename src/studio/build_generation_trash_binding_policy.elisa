# Decode the raw native transaction ABI without treating unknown integers or
# malformed boolean outputs as filesystem facts. The app controller will use
# these results around the native calls; policy remains the authority for every
# mutation admission.
include "build_generation_trash_policy.elisa"
include "io/build_generation_trash_native.elisa"

module StudioBuildGenerationTrashBindingPolicy:
    public:
        const enum DecodeStatus of i64:
            Known = 0
            Unknown = 1

        const enum RecoveryOutcome of i64:
            Quarantined = 0
            RestorePending = 1
            NotMoved = 2
            Restored = 3
            Busy = 4
            Changed = 5
            DurabilityUnknown = 6
            Conflict = 7
            Unknown = 8
            Failed = 9

        struct DecodedStatus:
            status: StudioBuildGenerationTrashNative::Status
            known: bool

        struct DecodedPhase:
            phase: StudioBuildGenerationTrashPolicy::Phase
            known: bool

        struct DecodedLocation:
            location: StudioBuildGenerationTrashPolicy::Location
            known: bool

        struct DecodedBoolean:
            value: bool
            valid: bool

        struct BeginEvidence:
            call_acquired: bool
            handle_valid: bool
            build_root_verified: bool
            source_verified: bool
            manifest_verified: bool
            product_verified: bool
            lease_verified: bool
            lease_exclusive: bool
            descendants_verified: bool
            current_fact_valid: bool
            artifact_is_current: bool
            lease_protocol: i64
            lease_receipt_bytes: i64
            inventory_receipt_bytes: i64

        struct RestoreEvidence:
            call_acquired: bool
            handle_valid: bool
            identity_outputs_valid: bool
            phase_known: bool
            phase: StudioBuildGenerationTrashPolicy::Phase
            journal_durable: bool
            artifact_id_bytes: i64
            relative_path_bytes: i64

        def decode_status(raw: i32) -> DecodedStatus:
            if raw == 0:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Acquired, known: true}
            if raw == 1:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Busy, known: true}
            if raw == 2:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Invalid, known: true}
            if raw == 3:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Changed, known: true}
            if raw == 4:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Unsupported, known: true}
            if raw == 5:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Failed, known: true}
            if raw == 6:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.DurabilityUnknown, known: true}
            if raw == 7:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Moved, known: true}
            if raw == 8:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.NotMoved, known: true}
            if raw == 9:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Restored, known: true}
            if raw == 10:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.LocationUnknown, known: true}
            if raw == 11:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Conflict, known: true}
            if raw == 12:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.StaleHandle, known: true}
            if raw == 13:
                return DecodedStatus{status: StudioBuildGenerationTrashNative::Status.ReleaseUncertain, known: true}
            DecodedStatus{status: StudioBuildGenerationTrashNative::Status.Failed, known: false}

        def decode_phase(raw: i32) -> DecodedPhase:
            if raw == 0:
                return DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.Intent, known: true}
            if raw == 1:
                return DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.Quarantined, known: true}
            if raw == 2:
                return DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.RestoreIntent, known: true}
            if raw == 3:
                return DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.Restored, known: true}
            if raw == 4:
                return DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.Unknown, known: true}
            if raw == 5:
                return DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.NotMoved, known: true}
            DecodedPhase{phase: StudioBuildGenerationTrashPolicy::Phase.Unknown, known: false}

        def decode_location(raw: i32) -> DecodedLocation:
            if raw == 0:
                return DecodedLocation{location: StudioBuildGenerationTrashPolicy::Location.NotMoved, known: true}
            if raw == 1:
                return DecodedLocation{location: StudioBuildGenerationTrashPolicy::Location.InQuarantine, known: true}
            if raw == 2:
                return DecodedLocation{location: StudioBuildGenerationTrashPolicy::Location.BackAtOriginal, known: true}
            if raw == 3:
                return DecodedLocation{location: StudioBuildGenerationTrashPolicy::Location.Conflict, known: true}
            if raw == 4:
                return DecodedLocation{location: StudioBuildGenerationTrashPolicy::Location.Unknown, known: true}
            DecodedLocation{location: StudioBuildGenerationTrashPolicy::Location.Unknown, known: false}

        def decode_boolean(raw: i32) -> DecodedBoolean:
            if raw == 0:
                return DecodedBoolean{value: false, valid: true}
            if raw == 1:
                return DecodedBoolean{value: true, valid: true}
            DecodedBoolean{value: false, valid: false}

        def decode_begin_evidence(status_raw: i32, handle: i64,
                                  root_verified_raw: i32,
                                  source_verified_raw: i32,
                                  manifest_verified_raw: i32,
                                  product_verified_raw: i32,
                                  lease_verified_raw: i32,
                                  lease_exclusive_raw: i32,
                                  descendants_verified_raw: i32,
                                  is_current_raw: i32,
                                  lease_protocol: i64,
                                  lease_receipt_bytes: i64,
                                  inventory_receipt_bytes: i64) -> BeginEvidence:
            status: DecodedStatus = decode_status(status_raw)
            root_verified: DecodedBoolean = decode_boolean(root_verified_raw)
            source_verified: DecodedBoolean = decode_boolean(source_verified_raw)
            manifest_verified: DecodedBoolean = decode_boolean(manifest_verified_raw)
            product_verified: DecodedBoolean = decode_boolean(product_verified_raw)
            lease_verified: DecodedBoolean = decode_boolean(lease_verified_raw)
            lease_exclusive: DecodedBoolean = decode_boolean(lease_exclusive_raw)
            descendants_verified: DecodedBoolean = decode_boolean(descendants_verified_raw)
            is_current: DecodedBoolean = decode_boolean(is_current_raw)
            BeginEvidence{call_acquired: status.known and status.status == StudioBuildGenerationTrashNative::Status.Acquired, handle_valid: handle > 0, build_root_verified: root_verified.valid and root_verified.value, source_verified: source_verified.valid and source_verified.value, manifest_verified: manifest_verified.valid and manifest_verified.value, product_verified: product_verified.valid and product_verified.value, lease_verified: lease_verified.valid and lease_verified.value, lease_exclusive: lease_exclusive.valid and lease_exclusive.value, descendants_verified: descendants_verified.valid and descendants_verified.value, current_fact_valid: is_current.valid, artifact_is_current: is_current.value, lease_protocol: lease_protocol, lease_receipt_bytes: lease_receipt_bytes, inventory_receipt_bytes: inventory_receipt_bytes}

        def begin_evidence_admitted(evidence: BeginEvidence) -> bool:
            ensure result == (evidence.call_acquired and evidence.handle_valid and evidence.build_root_verified and evidence.source_verified and evidence.manifest_verified and evidence.product_verified and evidence.lease_verified and evidence.lease_exclusive and evidence.descendants_verified and evidence.current_fact_valid and not evidence.artifact_is_current and evidence.lease_protocol == StudioBuildGenerationTrashPolicy::Protocol::LEASE_VERSION and evidence.lease_receipt_bytes > 0 and evidence.lease_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and evidence.inventory_receipt_bytes > 0 and evidence.inventory_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES)
            evidence.call_acquired and evidence.handle_valid and evidence.build_root_verified and evidence.source_verified and evidence.manifest_verified and evidence.product_verified and evidence.lease_verified and evidence.lease_exclusive and evidence.descendants_verified and evidence.current_fact_valid and not evidence.artifact_is_current and evidence.lease_protocol == StudioBuildGenerationTrashPolicy::Protocol::LEASE_VERSION and evidence.lease_receipt_bytes > 0 and evidence.lease_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES and evidence.inventory_receipt_bytes > 0 and evidence.inventory_receipt_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_RECEIPT_BYTES

        def decode_restore_evidence(status_raw: i32, handle: i64,
                                    phase_raw: i32, durable_raw: i32,
                                    identity_outputs_valid: bool,
                                    artifact_id_bytes: i64,
                                    relative_path_bytes: i64) -> RestoreEvidence:
            status: DecodedStatus = decode_status(status_raw)
            phase: DecodedPhase = decode_phase(phase_raw)
            durable: DecodedBoolean = decode_boolean(durable_raw)
            RestoreEvidence{call_acquired: status.known and status.status == StudioBuildGenerationTrashNative::Status.Acquired, handle_valid: handle > 0, identity_outputs_valid: identity_outputs_valid, phase_known: phase.known, phase: phase.phase, journal_durable: durable.valid and durable.value, artifact_id_bytes: artifact_id_bytes, relative_path_bytes: relative_path_bytes}

        def restore_evidence_admitted(evidence: RestoreEvidence) -> bool:
            ensure result == (evidence.call_acquired and evidence.handle_valid and evidence.identity_outputs_valid and evidence.phase_known and evidence.phase == StudioBuildGenerationTrashPolicy::Phase.Quarantined and evidence.journal_durable and evidence.artifact_id_bytes > 0 and evidence.artifact_id_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_ARTIFACT_ID_BYTES and evidence.relative_path_bytes > 0 and evidence.relative_path_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES)
            evidence.call_acquired and evidence.handle_valid and evidence.identity_outputs_valid and evidence.phase_known and evidence.phase == StudioBuildGenerationTrashPolicy::Phase.Quarantined and evidence.journal_durable and evidence.artifact_id_bytes > 0 and evidence.artifact_id_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_ARTIFACT_ID_BYTES and evidence.relative_path_bytes > 0 and evidence.relative_path_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES

        def recovery_outcome(status: DecodedStatus, phase: DecodedPhase,
                             location: DecodedLocation) -> RecoveryOutcome:
            if not status.known or not phase.known or not location.known:
                return RecoveryOutcome.Unknown
            if status.status == StudioBuildGenerationTrashNative::Status.ReleaseUncertain:
                return RecoveryOutcome.DurabilityUnknown
            if status.status == StudioBuildGenerationTrashNative::Status.DurabilityUnknown:
                return RecoveryOutcome.DurabilityUnknown
            if status.status == StudioBuildGenerationTrashNative::Status.Busy:
                return RecoveryOutcome.Busy
            if status.status == StudioBuildGenerationTrashNative::Status.Changed:
                return RecoveryOutcome.Changed
            if (status.status == StudioBuildGenerationTrashNative::Status.Conflict or
                location.location == StudioBuildGenerationTrashPolicy::Location.Conflict):
                return RecoveryOutcome.Conflict
            if (location.location == StudioBuildGenerationTrashPolicy::Location.Unknown or
                phase.phase == StudioBuildGenerationTrashPolicy::Phase.Unknown):
                return RecoveryOutcome.Unknown
            if (status.status == StudioBuildGenerationTrashNative::Status.Acquired and
                phase.phase == StudioBuildGenerationTrashPolicy::Phase.Quarantined and
                location.location == StudioBuildGenerationTrashPolicy::Location.InQuarantine):
                return RecoveryOutcome.Quarantined
            if (status.status == StudioBuildGenerationTrashNative::Status.Acquired and
                phase.phase == StudioBuildGenerationTrashPolicy::Phase.RestoreIntent and
                location.location == StudioBuildGenerationTrashPolicy::Location.InQuarantine):
                return RecoveryOutcome.RestorePending
            if (status.status == StudioBuildGenerationTrashNative::Status.NotMoved and
                phase.phase == StudioBuildGenerationTrashPolicy::Phase.NotMoved and
                location.location == StudioBuildGenerationTrashPolicy::Location.NotMoved):
                return RecoveryOutcome.NotMoved
            if (status.status == StudioBuildGenerationTrashNative::Status.Restored and
                phase.phase == StudioBuildGenerationTrashPolicy::Phase.Restored and
                location.location == StudioBuildGenerationTrashPolicy::Location.BackAtOriginal):
                return RecoveryOutcome.Restored
            RecoveryOutcome.Failed
