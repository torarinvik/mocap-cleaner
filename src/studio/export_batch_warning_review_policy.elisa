include "export_batch_queue_policy.elisa"

# UI review context only. Binding-owned source/journal checks authorize IO.
module StudioExportBatchWarningReviewPolicy:
    public:
        const module Domain:
            MAX_EPOCH: i64 = 1000000000000

        struct Ticket:
            epoch: i64
            index: i64
            attempt: i64

        def next_epoch(current: i64) -> i64:
            requires current >= -1 and current <= Domain::MAX_EPOCH
            ensure result >= -1 and result <= Domain::MAX_EPOCH
            ensure current < 0 or current >= Domain::MAX_EPOCH or result == current + 1
            ensure current >= 0 and current < Domain::MAX_EPOCH or result == -1
            -1 if current < 0 or current >= Domain::MAX_EPOCH else current + 1

        def ticket_valid(ticket: Ticket) -> bool:
            ensure result == (ticket.epoch >= 0 and ticket.epoch <= Domain::MAX_EPOCH and ticket.index >= 0 and ticket.index < StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and ticket.attempt > 0)
            ticket.epoch >= 0 and ticket.epoch <= Domain::MAX_EPOCH and ticket.index >= 0 and ticket.index < StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and ticket.attempt > 0

        def current(captured: Ticket, observed: Ticket) -> bool:
            ensure result == (ticket_valid(captured) and ticket_valid(observed) and captured.epoch == observed.epoch and captured.index == observed.index and captured.attempt == observed.attempt)
            ticket_valid(captured) and ticket_valid(observed) and captured.epoch == observed.epoch and captured.index == observed.index and captured.attempt == observed.attempt

        def acknowledge_admitted(captured: Ticket, observed: Ticket,
                exact_report: bool, complete_layout: bool,
                warning_count: i64, explicit_review: bool) -> bool:
            ensure result == (current(captured, observed) and exact_report and complete_layout and warning_count > 0 and explicit_review)
            current(captured, observed) and exact_report and complete_layout and warning_count > 0 and explicit_review
