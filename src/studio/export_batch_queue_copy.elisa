include "export_batch_queue_policy.elisa"

module StudioExportBatchQueueCopy:
    public:
        def item_label(state: StudioExportBatchQueuePolicy::ItemState) -> sview:
            match state:
                StudioExportBatchQueuePolicy::ItemState.Queued: "Queued"
                StudioExportBatchQueuePolicy::ItemState.Running: "Processing"
                StudioExportBatchQueuePolicy::ItemState.Staged: "Ready to publish"
                StudioExportBatchQueuePolicy::ItemState.AwaitingReview: "Review required"
                StudioExportBatchQueuePolicy::ItemState.Passed: "Published"
                StudioExportBatchQueuePolicy::ItemState.Warning: "Published with reviewed warnings"
                StudioExportBatchQueuePolicy::ItemState.Failed: "Needs attention"
                StudioExportBatchQueuePolicy::ItemState.Cancelled: "Cancelled before processing"

        def item_help(state: StudioExportBatchQueuePolicy::ItemState) -> sview:
            match state:
                StudioExportBatchQueuePolicy::ItemState.Queued: "Waiting for a worker. Cancel stops this input from starting."
                StudioExportBatchQueuePolicy::ItemState.Running: "Processing this input. Cancel stops new work; this worker finishes before the queue can resume."
                StudioExportBatchQueuePolicy::ItemState.Staged: "Processing finished. The GLB and required reports still need publication to their validated destinations."
                StudioExportBatchQueuePolicy::ItemState.AwaitingReview: "Compare the source and staged result, review the warnings, then approve this exact result before publication."
                StudioExportBatchQueuePolicy::ItemState.Passed: "The GLB and required reports were published. This input is retained when other inputs are retried."
                StudioExportBatchQueuePolicy::ItemState.Warning: "The reviewed result and required reports were published with warnings. This input is retained when other inputs are retried."
                StudioExportBatchQueuePolicy::ItemState.Failed: "Open the failure details. Check any partial outputs and revalidate destinations before retrying this input."
                StudioExportBatchQueuePolicy::ItemState.Cancelled: "This input did not start. After active workers finish, revalidate this input and resume to retry it."

        def aggregate_label(state: StudioExportBatchQueuePolicy::Aggregate) -> sview:
            match state:
                StudioExportBatchQueuePolicy::Aggregate.Incomplete: "Queue incomplete"
                StudioExportBatchQueuePolicy::Aggregate.Complete: "Queue complete"
                StudioExportBatchQueuePolicy::Aggregate.CompleteWithWarnings: "Queue complete with reviewed warnings"
                StudioExportBatchQueuePolicy::Aggregate.Invalid: "Queue state unavailable"

        def aggregate_help(state: StudioExportBatchQueuePolicy::Aggregate) -> sview:
            match state:
                StudioExportBatchQueuePolicy::Aggregate.Incomplete: "Some inputs still need processing, review, publication or recovery. Check each input's status before using the manifest as complete."
                StudioExportBatchQueuePolicy::Aggregate.Complete: "Every queued input and its required reports reached publication."
                StudioExportBatchQueuePolicy::Aggregate.CompleteWithWarnings: "Every queued input and its required reports reached publication; warning results were reviewed."
                StudioExportBatchQueuePolicy::Aggregate.Invalid: "The queue counts disagree. Preserve completed outputs and inspect the queue record before continuing."
