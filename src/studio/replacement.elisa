# Focus and choice rules for confirming a take replacement with unsaved
# session edits. Saving/discarding the document remains app-owned work.
module StudioReplacement:
    public:
        const NONE: i64 = 0
        const SAVE: i64 = 1
        const DISCARD: i64 = 2
        const CANCEL: i64 = 3
        const CHOICES: i64 = 3
        const FOCUS_SAVE: i64 = 0
        const FOCUS_DISCARD: i64 = 1
        const FOCUS_CANCEL: i64 = 2

        def initial_focus() -> i64:
            ensure result == FOCUS_SAVE
            FOCUS_SAVE

        def move_focus(focus: i64, direction: i64) -> i64:
            requires focus >= 0
            requires focus < CHOICES
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < CHOICES
            ensure direction != 1 or focus != FOCUS_CANCEL or result == FOCUS_SAVE
            ensure direction != -1 or focus != FOCUS_SAVE or result == FOCUS_CANCEL
            return FOCUS_SAVE if direction == 1 and focus == FOCUS_CANCEL
            return focus + 1 if direction == 1
            return FOCUS_CANCEL if focus == FOCUS_SAVE
            focus - 1

        def resolve(is_open: bool, choice: i64) -> i64:
            requires choice >= SAVE
            requires choice <= CANCEL
            ensure result == NONE or result == choice
            ensure is_open or result == NONE
            ensure not is_open or result == choice
            return choice if is_open
            NONE
