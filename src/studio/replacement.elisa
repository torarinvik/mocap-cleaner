# Focus and choice rules for confirming a take replacement with unsaved
# session edits. Saving/discarding the document remains app-owned work.
module StudioReplacement:
    public:
        const enum Choice of i64:
            None = 0
            Save = 1
            Discard = 2
            Cancel = 3

        const enum Focus of i64:
            Save = 0
            Discard = 1
            Cancel = 2

        const module Count:
            CHOICES: i64 = 3

        def initial_focus() -> i64:
            ensure result == Focus.Save.i64()
            Focus.Save.i64()

        def needs_prompt(has_take: bool, dirty: bool) -> bool:
            ensure not has_take or not dirty or result
            ensure has_take and dirty or not result
            has_take and dirty

        def move_focus(focus: i64, direction: i64) -> i64:
            requires focus >= 0
            requires focus < Count::CHOICES
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < Count::CHOICES
            ensure direction != 1 or focus != Focus.Cancel.i64() or result == Focus.Save.i64()
            ensure direction != -1 or focus != Focus.Save.i64() or result == Focus.Cancel.i64()
            return Focus.Save.i64() if direction == 1 and focus == Focus.Cancel.i64()
            return focus + 1 if direction == 1
            return Focus.Cancel.i64() if focus == Focus.Save.i64()
            focus - 1

        def resolve(is_open: bool, choice: i64) -> i64:
            requires choice >= Choice.Save.i64()
            requires choice <= Choice.Cancel.i64()
            ensure result == Choice.None.i64() or result == choice
            ensure is_open or result == Choice.None.i64()
            ensure not is_open or result == choice
            return choice if is_open
            Choice.None.i64()
