# The compact File menu previews a bounded root prefix; callers must mark a
# longer canonical path as abbreviated instead of making it look complete.
module StudioWorkspacePathDisplayPolicy:
    public:
        const module Limit:
            ROOT_PREVIEW_BYTES: i64 = 96
            MAX_PATH_BYTES: i64 = 4095

        def needs_ellipsis(path_bytes: i64) -> bool:
            requires path_bytes >= 0 and path_bytes <= Limit::MAX_PATH_BYTES
            ensure result == (path_bytes > Limit::ROOT_PREVIEW_BYTES)
            path_bytes > Limit::ROOT_PREVIEW_BYTES
