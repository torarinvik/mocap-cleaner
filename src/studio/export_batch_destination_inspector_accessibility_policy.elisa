include "export_batch_destination_inspector_policy.elisa"
include "storage_accessibility_policy.elisa"

module StudioExportBatchDestinationInspectorAccessibilityPolicy:
    public:
        const module Node:
            DIALOG: usize = 100
            STATUS: usize = 101
            LOCATION_FIRST: usize = 102
            LINE_FIRST: usize = 106
            LINE_COUNT: usize = StudioExportBatchDestinationInspectorPolicy::Limit::LINES_PER_PAGE.usize()
            PREVIOUS: usize = 111
            NEXT: usize = 112
            DONE: usize = 113
            COPY_PATH: usize = 114

        def location_id(location: StudioExportBatchDestinationInspectorPolicy::Location) -> usize:
            requires StudioExportBatchDestinationInspectorPolicy::location_valid(location)
            ensure result >= Node::LOCATION_FIRST and result < Node::LINE_FIRST
            Node::LOCATION_FIRST + location.i64().usize()

        def focus_id(focus: StudioExportBatchDestinationInspectorPolicy::Focus) -> usize:
            return location_id(StudioExportBatchDestinationInspectorPolicy::Location.Source) if focus == StudioExportBatchDestinationInspectorPolicy::Focus.Source
            return location_id(StudioExportBatchDestinationInspectorPolicy::Location.Glb) if focus == StudioExportBatchDestinationInspectorPolicy::Focus.Glb
            return location_id(StudioExportBatchDestinationInspectorPolicy::Location.JsonReport) if focus == StudioExportBatchDestinationInspectorPolicy::Focus.JsonReport
            return location_id(StudioExportBatchDestinationInspectorPolicy::Location.TextReport) if focus == StudioExportBatchDestinationInspectorPolicy::Focus.TextReport
            return Node::PREVIOUS if focus == StudioExportBatchDestinationInspectorPolicy::Focus.Previous
            return Node::NEXT if focus == StudioExportBatchDestinationInspectorPolicy::Focus.Next
            return Node::DONE if focus == StudioExportBatchDestinationInspectorPolicy::Focus.Done
            Node::COPY_PATH

        def focus_for_id(id: usize) -> StudioExportBatchDestinationInspectorPolicy::Focus?:
            return StudioExportBatchDestinationInspectorPolicy::Focus.Source if id == location_id(StudioExportBatchDestinationInspectorPolicy::Location.Source)
            return StudioExportBatchDestinationInspectorPolicy::Focus.Glb if id == location_id(StudioExportBatchDestinationInspectorPolicy::Location.Glb)
            return StudioExportBatchDestinationInspectorPolicy::Focus.JsonReport if id == location_id(StudioExportBatchDestinationInspectorPolicy::Location.JsonReport)
            return StudioExportBatchDestinationInspectorPolicy::Focus.TextReport if id == location_id(StudioExportBatchDestinationInspectorPolicy::Location.TextReport)
            return StudioExportBatchDestinationInspectorPolicy::Focus.Previous if id == Node::PREVIOUS
            return StudioExportBatchDestinationInspectorPolicy::Focus.Next if id == Node::NEXT
            return StudioExportBatchDestinationInspectorPolicy::Focus.Done if id == Node::DONE
            return StudioExportBatchDestinationInspectorPolicy::Focus.CopyPath if id == Node::COPY_PATH
            null

        def is_node(id: usize) -> bool:
            id == Node::DIALOG or id == Node::STATUS or id >= Node::LOCATION_FIRST and id <= Node::LOCATION_FIRST + 3 or id >= Node::LINE_FIRST and id < Node::LINE_FIRST + Node::LINE_COUNT or id == Node::PREVIOUS or id == Node::NEXT or id == Node::DONE or id == Node::COPY_PATH

        def parent_id(id: usize) -> usize:
            return StudioStorageAccessibilityPolicy::Node::NO_NODE if id == Node::DIALOG
            return Node::DIALOG if is_node(id)
            StudioStorageAccessibilityPolicy::Node::NO_NODE

        def first_child_id() -> usize:
            Node::STATUS

        def line_id(row: i64) -> usize:
            requires row >= 0 and row < Node::LINE_COUNT.i64()
            ensure result == Node::LINE_FIRST + row.usize()
            Node::LINE_FIRST + row.usize()

        def next_sibling_id(id: usize, visible_lines: i64) -> usize:
            requires visible_lines >= 0 and visible_lines <= Node::LINE_COUNT.i64()
            return Node::LOCATION_FIRST if id == Node::STATUS
            return id + 1 if id >= Node::LOCATION_FIRST and id < Node::LOCATION_FIRST + 3
            return Node::LINE_FIRST if id == Node::LOCATION_FIRST + 3 and visible_lines > 0
            return Node::PREVIOUS if id == Node::LOCATION_FIRST + 3
            line: i64 = (id - Node::LINE_FIRST).i64() if id >= Node::LINE_FIRST and id < Node::LINE_FIRST + Node::LINE_COUNT else -1
            return id + 1 if line >= 0 and line + 1 < visible_lines
            return Node::PREVIOUS if line >= 0 and line < visible_lines
            return Node::NEXT if id == Node::PREVIOUS
            return Node::COPY_PATH if id == Node::NEXT
            return Node::DONE if id == Node::COPY_PATH
            return StudioStorageAccessibilityPolicy::Node::NO_NODE if id == Node::DONE
            StudioStorageAccessibilityPolicy::Node::NO_NODE

        def ids_fit_reserved_range() -> bool:
            ensure result
            Node::DIALOG + 1 == Node::STATUS and Node::STATUS + 1 == Node::LOCATION_FIRST and Node::LOCATION_FIRST + 4 == Node::LINE_FIRST and Node::LINE_FIRST + Node::LINE_COUNT == Node::PREVIOUS and Node::PREVIOUS + 1 == Node::NEXT and Node::NEXT + 1 == Node::DONE and Node::DONE + 1 == Node::COPY_PATH and Node::COPY_PATH < StudioStorageAccessibilityPolicy::Node::DIALOG and Node::COPY_PATH < StudioStorageAccessibilityPolicy::Node::NO_NODE
