# Job buffers are inline: copying the argument copies all request bytes.
# Staging owns an exclusive input snapshot/output path under the build root.
# The controller publishes only a current, uncancelled, fully loaded result.
include "app/model.elisa"
include "fbx_import_policy.elisa"
include "take_source_ref_policy.elisa"
include "fbx_import_reference.elisa"
include "fbx_import_native.elisa"
include "fbx_import_worker_status.elisa"
include "../../build/generated/studio_runtime.elisa"

extend StudioFbxImportWorker:
    private:
        def path_copy(bytes: u8[4096]&) -> darray[u8]:
            mutable out: darray[u8] = []
            for index in 0..<4096 |index, bytes, out|:
                out.push(bytes[index])
                return move out if bytes[index] == 0
            []

        def animation_copy(bytes: u8[1024]&) -> darray[u8]:
            mutable out: darray[u8] = []
            for index in 0..<1024 |index, bytes, out|:
                out.push(bytes[index])
                return move out if bytes[index] == 0
            []

    public:
        struct RequestBuffers:
            source: u8[4096]
            build_root: u8[4096]
            animation: u8[1024]

        affine struct Job:
            ticket: i64
            buffers: RequestBuffers
            rate: i64

        affine struct Result:
            ticket: i64
            status: i64
            source: darray[u8]
            destination: darray[u8]
            source_sha256: darray[u8]
            runtime_sha256: darray[u8]
            memo: StudioModel::Memo?

        def load(job: Job) -> Result can[Unsafe.PointerCast, Unsafe.RawExtern, Blocking.IO, Memory.Allocate, Memory.Release]:
            ticket: i64 = job.ticket
            rate: i64 = job.rate
            mutable source: darray[u8] = path_copy(&job.buffers.source)
            mutable build_root: darray[u8] = path_copy(&job.buffers.build_root)
            mutable destination: darray[u8] = []
            mutable source_digest: darray[u8] = []
            mutable runtime_digest: darray[u8] = []
            mutable animation: darray[u8] = animation_copy(&job.buffers.animation)
            mutable status: i64 = Status.InvalidJob.i64()
            mutable memo: StudioModel::Memo? = null
            if ticket > 0 and StudioFbxImportPolicy::rate_valid(rate) and StudioFbxImportPolicy::terminated(&source, StudioFbxImportPolicy::Limit::PATH_BYTES) and StudioFbxImportPolicy::terminated(&build_root, StudioFbxImportPolicy::Limit::PATH_BYTES) and StudioFbxImportPolicy::terminated(&animation, StudioFbxImportPolicy::Limit::ANIMATION_BYTES):
                mutable snapshot_owned: darray[u8] = []
                match StudioFbxImportNative::stage(&build_root, &source):
                    StudioFbxImportNative::StagingResult{status: staged_status, snapshot: staged_snapshot, destination: staged_destination, source_sha256: staged_digest}:
                        status <- staged_status
                        destination <- move staged_destination
                        source_digest <- move staged_digest
                        snapshot_owned <- move staged_snapshot
                if status == 0:
                    status <- Status.InvalidJob.i64()
                    if StudioFbxImportNativePolicy::staging_output_valid(&source, &snapshot_owned, &destination, &source_digest):
                        status <- StudioFbxImportNative::convert(&snapshot_owned, &destination, rate)
                    if status == 0:
                        current_source: StudioFbxImportNative::DigestResult = StudioFbxImportNative::digest(&source)
                        current_runtime: StudioFbxImportNative::DigestResult = StudioFbxImportNative::digest(&destination)
                        if current_source.status != 0 or current_runtime.status != 0:
                            status <- Status.DigestUnavailable.i64()
                        else:
                            status <- Status.SourceChanged.i64() if not StudioFbxImportPolicy::same_path(&current_source.bytes, &source_digest)
                            runtime_digest <- move current_runtime.bytes
                    if status == 0:
                        can Unsafe.PointerCast:
                            memo <- StudioModel::load((&destination[0]).cast[cstr], (&animation[0]).cast[cstr])
                        status <- Status.UnreadableAnimation.i64() if memo == null else 0
                        if memo is held:
                            mutable owned: StudioModel::Memo = move held
                            memo <- null
                            reference_result: StudioFbxImportReference::Result = StudioFbxImportReference::make(&source, &destination, &source_digest, &runtime_digest, rate)
                            if reference_result.value is reference:
                                if StudioModel::attach_source_reference(&owned, reference):
                                    memo <- move owned
                                else:
                                    status <- Status.InvalidJob.i64()
                            else:
                                status <- Status.InvalidJob.i64()
            Result{ticket: ticket, status: status, source: move source, destination: move destination, source_sha256: move source_digest, runtime_sha256: move runtime_digest, memo: move memo}

def load_fbx_import_job(job: StudioFbxImportWorker::Job) -> StudioFbxImportWorker::Result can[Unsafe.PointerCast, Unsafe.RawExtern, Blocking.IO, Memory.Allocate, Memory.Release]:
    StudioFbxImportWorker::load(move job)
