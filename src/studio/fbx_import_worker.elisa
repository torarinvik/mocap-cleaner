# Job paths own their NUL-terminated bytes across asynchronous conversion.
# Staging owns an exclusive input snapshot/output path under the build root.
# The controller publishes only a current, uncancelled, fully loaded result.
include "app/model.elisa"
include "fbx_import_policy.elisa"
include "take_source_ref_policy.elisa"
include "fbx_import_reference.elisa"
include "../../build/generated/studio_runtime.elisa"

module StudioFbxImportWorker:
    private:
        @link_name("elisa_fbx_to_glb")
        extern convert(source: cstr, destination: cstr, rate: f64) -> i64 can Blocking.IO
        @link_name("elisa_studio_fbx_file_digest")
        extern file_digest(path: cstr, digest: mutable u8&, maximum: u64) -> i64 can Blocking.IO

        @link_name("elisa_studio_fbx_stage")
        extern stage(build_root: cstr, source: cstr, snapshot: mutable u8&, destination: mutable u8&, digest: mutable u8&, capacity: u32) -> i64 can Blocking.IO

        def path_copy(bytes: u8[4096]&) -> darray[u8]:
            mutable out: darray[u8] = []
            for index in 0..<4096 |index, bytes, out|:
                out.push(bytes[index])
                return move out if bytes[index] == 0
            []

    public:
        const enum Status of i64:
            InvalidJob = -100
            UnreadableAnimation = -101
            SourceChanged = -102
            DigestUnavailable = -103

        affine struct Job:
            ticket: i64
            source: darray[u8]
            build_root: darray[u8]
            animation: darray[u8]
            rate: i64

        affine struct Result:
            ticket: i64
            status: i64
            source: darray[u8]
            destination: darray[u8]
            source_sha256: darray[u8]
            runtime_sha256: darray[u8]
            memo: StudioModel::Memo?

        def load(job: Job) -> Result can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            ticket: i64 = job.ticket
            rate: i64 = job.rate
            mutable source: darray[u8] = job.source
            mutable build_root: darray[u8] = job.build_root
            mutable destination: darray[u8] = []
            mutable source_digest: darray[u8] = []
            mutable runtime_digest: darray[u8] = []
            mutable animation: darray[u8] = move job.animation
            mutable status: i64 = Status.InvalidJob.i64()
            mutable memo: StudioModel::Memo? = null
            if ticket > 0 and StudioFbxImportPolicy::rate_valid(rate) and StudioFbxImportPolicy::terminated(&source, StudioFbxImportPolicy::Limit::PATH_BYTES) and StudioFbxImportPolicy::terminated(&build_root, StudioFbxImportPolicy::Limit::PATH_BYTES) and StudioFbxImportPolicy::terminated(&animation, StudioFbxImportPolicy::Limit::ANIMATION_BYTES):
                source_path: cstr = (&source[0]).cast[cstr]
                root_path: cstr = (&build_root[0]).cast[cstr]
                mutable snapshot_bytes: u8[4096] = zeroed
                mutable output_bytes: u8[4096] = zeroed
                mutable digest_bytes: u8[65] = zeroed
                status <- stage(root_path, source_path, &snapshot_bytes[0], &output_bytes[0], &digest_bytes[0], 4096.u32())
                if status == 0:
                    destination <- path_copy(&output_bytes)
                    snapshot: cstr = (&snapshot_bytes[0]).cast[cstr]
                    destination_path: cstr = (&output_bytes[0]).cast[cstr]
                    animation_name: cstr = (&animation[0]).cast[cstr]
                    for index in 0..<64 |index, source_digest, digest_bytes|:
                        source_digest.push(digest_bytes[index])
                    snapshot_owned: darray[u8] = path_copy(&snapshot_bytes)
                    status <- Status.InvalidJob.i64()
                    if StudioFbxImportPolicy::terminated(&snapshot_owned, StudioFbxImportPolicy::Limit::PATH_BYTES) and StudioFbxImportPolicy::terminated(&destination, StudioFbxImportPolicy::Limit::PATH_BYTES) and StudioTakeSourceRefPolicy::sha256_valid(&source_digest) and not StudioFbxImportPolicy::same_path(&source, &destination) and not StudioFbxImportPolicy::same_path(&snapshot_owned, &destination):
                        status <- convert(snapshot, destination_path, rate.f64())
                    if status == 0:
                        mutable current_source: u8[65] = zeroed
                        mutable current_runtime: u8[65] = zeroed
                        if file_digest(source_path, &current_source[0], 536870912.u64()) != 0 or file_digest(destination_path, &current_runtime[0], 536870912.u64()) != 0:
                            status <- Status.DigestUnavailable.i64()
                        else:
                            for index in 0..<64 |index, current_source, current_runtime, source_digest, runtime_digest, status|:
                                status <- Status.SourceChanged.i64() if current_source[index] != source_digest[index]
                                runtime_digest.push(current_runtime[index])
                            status <- Status.DigestUnavailable.i64() if not StudioTakeSourceRefPolicy::sha256_valid(&runtime_digest)
                    if status == 0:
                        memo <- StudioModel::load(destination_path, animation_name)
                        status <- Status.UnreadableAnimation.i64() if memo == null else 0
                        if memo is held:
                            mutable owned: StudioModel::Memo = move held
                            memo <- null
                            reference_result: StudioFbxImportReference::Result = StudioFbxImportReference::make(&source, &destination, &source_digest, &runtime_digest, rate)
                            if reference_result.value is reference:
                                if StudioModel::attach_source_reference(&owned, reference):
                                    memo <- move owned
                                else:
                                    status <- Status.InvalidJob.i64()
                            else:
                                status <- Status.InvalidJob.i64()
            Result{ticket: ticket, status: status, source: move source, destination: move destination, source_sha256: move source_digest, runtime_sha256: move runtime_digest, memo: move memo}

def load_fbx_import_job(job: StudioFbxImportWorker::Job) -> StudioFbxImportWorker::Result can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
    StudioFbxImportWorker::load(move job)
