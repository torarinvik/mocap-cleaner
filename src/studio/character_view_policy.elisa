# Character display falls back to the skeleton when no surface was drawn.
module StudioCharacterViewPolicy:
    public:
        def surface_available(take_mesh: bool, loaded_character: bool) -> bool:
            ensure not take_mesh and not loaded_character implies not result
            ensure take_mesh or loaded_character implies result
            take_mesh or loaded_character

        def mesh_toggle_enabled(take_mesh: bool, loaded_character: bool) -> bool:
            ensure result == surface_available(take_mesh, loaded_character)
            surface_available(take_mesh, loaded_character)

        def draw_skeleton(character_requested: bool, drawn_triangles: i64) -> bool:
            requires drawn_triangles >= 0
            ensure not character_requested implies result
            ensure drawn_triangles == 0 implies result
            ensure character_requested and drawn_triangles > 0 implies not result
            not character_requested or drawn_triangles == 0
