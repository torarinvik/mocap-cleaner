include "export_batch_queue_policy.elisa"

# Inspection is read-only and remains available when workspace writes are
# refused. Opening requires one visible, selected item in a valid queue.
module StudioExportBatchDestinationInspectorEntryPolicy:
    public:
        def admitted(sheet_open: bool, report_open: bool, inspector_open: bool,
                queue_valid: bool, count: i64, selected: i64) -> bool:
            ensure result == (sheet_open and not report_open and not inspector_open and queue_valid and count > 0 and count <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and selected >= 0 and selected < count)
            sheet_open and not report_open and not inspector_open and queue_valid and count > 0 and count <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and selected >= 0 and selected < count

        def label() -> sview:
            "Inspect locations"

        def help() -> sview:
            "Read the exact source, GLB, JSON report and text report paths for the selected item. Inspection cannot change or publish files."
