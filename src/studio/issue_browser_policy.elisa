# Deterministic navigation and accessibility identity policy for ranked
# motion findings. Geometry and text presentation remain in StudioPanels.
module StudioIssueBrowserPolicy:
    public:
        const ROWS: i64 = 2
        const PREVIOUS: i64 = 0
        const NEXT: i64 = 1
        const WORST: i64 = 2
        const GROUP_ID: usize = 180
        const PREVIOUS_ID: usize = 181
        const NEXT_ID: usize = 182
        const WORST_ID: usize = 183
        const ROW_ID_FIRST: usize = 184

        def row_id(index: i64) -> usize:
            requires index >= 0 and index < ROWS
            ROW_ID_FIRST + index.usize()

        def node_parent(id: usize, sidebar_id: usize, no_node_id: usize) -> usize:
            return sidebar_id if id == GROUP_ID
            return GROUP_ID if id == PREVIOUS_ID or id == NEXT_ID or id == WORST_ID or (id >= ROW_ID_FIRST and id < ROW_ID_FIRST + ROWS.usize())
            no_node_id

        def node_first_child() -> usize:
            PREVIOUS_ID

        def node_next_sibling(id: usize, visible_rows: i64, no_node_id: usize) -> usize:
            requires visible_rows >= 0 and visible_rows <= ROWS
            return NEXT_ID if id == PREVIOUS_ID
            return WORST_ID if id == NEXT_ID
            return ROW_ID_FIRST if id == WORST_ID and visible_rows > 0
            row: i64 = (id - ROW_ID_FIRST).i64() if id >= ROW_ID_FIRST and id < ROW_ID_FIRST + ROWS.usize() else -1
            return id + 1 if row >= 0 and row + 1 < visible_rows
            no_node_id

        # Keep the selected rank in the two-row viewport. Near the start,
        # anchor at zero; near the end, the selection occupies the last row.
        def window_start(selected: i64, count: i64) -> i64:
            requires selected >= 0
            requires count >= 0
            ensure result >= 0
            ensure result + ROWS <= count or count <= ROWS
            ensure selected >= count or (result <= selected and selected < result + ROWS)
            ensure selected < count or result == 0
            return 0 if count <= ROWS or selected >= count or selected < ROWS
            selected - ROWS + 1

        def navigation_target(current: i64, count: i64, action: i64) -> i64:
            requires current >= 0
            requires count > 0
            requires current < count
            requires action >= PREVIOUS and action <= WORST
            ensure result >= 0
            ensure result < count
            return 0 if action == WORST
            return (current + count - 1) % count if action == PREVIOUS
            (current + 1) % count

        def row_route_enabled(index: i64, visible_rows: i64, fresh: bool) -> bool:
            requires visible_rows >= 0
            requires visible_rows <= ROWS
            ensure not result or fresh
            ensure not result or index >= 0 and index < visible_rows
            fresh and index >= 0 and index < visible_rows
