# Deterministic navigation and accessibility identity policy for ranked
# motion findings. Geometry and text presentation remain in StudioPanels.
module StudioIssueBrowserPolicy:
    public:
        const enum Action of i64:
            Previous = 0
            Next = 1
            Worst = 2

        const module Capacity:
            VISIBLE_ROWS: i64 = 2
            MAX_FINDINGS: i64 = 10000000

        const module Accessibility:
            GROUP_ID: usize = 180
            FILTER_GROUP_ID: usize = 160
            FILTER_DETECTOR_ID: usize = 161
            FILTER_SUBJECT_ID: usize = 162
            FILTER_SEVERITY_ID: usize = 163
            FILTER_STATUS_ID: usize = 164
            FILTER_RESET_ID: usize = 165
            FINDING_INTENT_ID: usize = 166
            PREVIOUS_ID: usize = 181
            NEXT_ID: usize = 182
            WORST_ID: usize = 183
            ROW_ID_FIRST: usize = 184

        def is_filter_control(id: usize) -> bool:
            ensure result == (id == Accessibility::FILTER_DETECTOR_ID or id == Accessibility::FILTER_SUBJECT_ID or id == Accessibility::FILTER_SEVERITY_ID or id == Accessibility::FILTER_STATUS_ID or id == Accessibility::FILTER_RESET_ID or id == Accessibility::FINDING_INTENT_ID)
            id == Accessibility::FILTER_DETECTOR_ID or id == Accessibility::FILTER_SUBJECT_ID or id == Accessibility::FILTER_SEVERITY_ID or id == Accessibility::FILTER_STATUS_ID or id == Accessibility::FILTER_RESET_ID or id == Accessibility::FINDING_INTENT_ID

        def is_issue_node(id: usize) -> bool:
            ensure result == (id == Accessibility::GROUP_ID or id == Accessibility::FILTER_GROUP_ID or is_filter_control(id) or id == Accessibility::PREVIOUS_ID or id == Accessibility::NEXT_ID or id == Accessibility::WORST_ID or (id >= Accessibility::ROW_ID_FIRST and id < Accessibility::ROW_ID_FIRST + Capacity::VISIBLE_ROWS.usize()))
            id == Accessibility::GROUP_ID or id == Accessibility::FILTER_GROUP_ID or is_filter_control(id) or id == Accessibility::PREVIOUS_ID or id == Accessibility::NEXT_ID or id == Accessibility::WORST_ID or (id >= Accessibility::ROW_ID_FIRST and id < Accessibility::ROW_ID_FIRST + Capacity::VISIBLE_ROWS.usize())

        def row_id(index: i64) -> usize:
            requires index >= 0 and index < Capacity::VISIBLE_ROWS
            ensure result == Accessibility::ROW_ID_FIRST + index.usize()
            Accessibility::ROW_ID_FIRST + index.usize()

        def filter_parent(id: usize, no_node_id: usize) -> usize:
            ensure id != Accessibility::FILTER_DETECTOR_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_SUBJECT_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_SEVERITY_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_STATUS_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_RESET_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FINDING_INTENT_ID or result == Accessibility::FILTER_GROUP_ID
            return Accessibility::FILTER_GROUP_ID if id == Accessibility::FILTER_DETECTOR_ID
            return Accessibility::FILTER_GROUP_ID if id == Accessibility::FILTER_SUBJECT_ID
            return Accessibility::FILTER_GROUP_ID if id == Accessibility::FILTER_SEVERITY_ID
            return Accessibility::FILTER_GROUP_ID if id == Accessibility::FILTER_STATUS_ID
            return Accessibility::FILTER_GROUP_ID if id == Accessibility::FILTER_RESET_ID
            return Accessibility::FILTER_GROUP_ID if id == Accessibility::FINDING_INTENT_ID
            no_node_id

        def group_child_parent(id: usize, no_node_id: usize) -> usize:
            ensure id != Accessibility::FILTER_GROUP_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::PREVIOUS_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::NEXT_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::WORST_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::ROW_ID_FIRST or result == Accessibility::GROUP_ID
            ensure id != Accessibility::ROW_ID_FIRST + 1 or result == Accessibility::GROUP_ID
            return Accessibility::GROUP_ID if id == Accessibility::FILTER_GROUP_ID
            return Accessibility::GROUP_ID if id == Accessibility::PREVIOUS_ID
            return Accessibility::GROUP_ID if id == Accessibility::NEXT_ID
            return Accessibility::GROUP_ID if id == Accessibility::WORST_ID
            return Accessibility::GROUP_ID if id == Accessibility::ROW_ID_FIRST
            return Accessibility::GROUP_ID if id == Accessibility::ROW_ID_FIRST + 1
            no_node_id

        def parent_for_id(id: usize, sidebar_id: usize, no_node_id: usize) -> usize:
            ensure id != Accessibility::GROUP_ID or result == sidebar_id
            ensure id != Accessibility::FILTER_GROUP_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::PREVIOUS_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::NEXT_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::WORST_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::ROW_ID_FIRST or result == Accessibility::GROUP_ID
            ensure id != Accessibility::ROW_ID_FIRST + 1 or result == Accessibility::GROUP_ID
            ensure id != Accessibility::FILTER_DETECTOR_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_SUBJECT_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_SEVERITY_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_STATUS_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_RESET_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FINDING_INTENT_ID or result == Accessibility::FILTER_GROUP_ID
            if id == Accessibility::GROUP_ID:
                return sidebar_id
            if id == Accessibility::FILTER_DETECTOR_ID:
                return filter_parent(id, no_node_id)
            if id == Accessibility::FILTER_SUBJECT_ID:
                return filter_parent(id, no_node_id)
            if id == Accessibility::FILTER_SEVERITY_ID:
                return filter_parent(id, no_node_id)
            if id == Accessibility::FILTER_STATUS_ID:
                return filter_parent(id, no_node_id)
            if id == Accessibility::FILTER_RESET_ID:
                return filter_parent(id, no_node_id)
            if id == Accessibility::FINDING_INTENT_ID:
                return filter_parent(id, no_node_id)
            group_child_parent(id, no_node_id)

        def node_parent(id: usize, sidebar_id: usize, no_node_id: usize) -> usize:
            ensure result == parent_for_id(id, sidebar_id, no_node_id)
            ensure id != Accessibility::GROUP_ID or result == sidebar_id
            ensure id != Accessibility::FILTER_GROUP_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::PREVIOUS_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::NEXT_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::WORST_ID or result == Accessibility::GROUP_ID
            ensure id != Accessibility::ROW_ID_FIRST or result == Accessibility::GROUP_ID
            ensure id != Accessibility::ROW_ID_FIRST + 1 or result == Accessibility::GROUP_ID
            ensure id != Accessibility::FILTER_DETECTOR_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_SUBJECT_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_SEVERITY_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_STATUS_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FILTER_RESET_ID or result == Accessibility::FILTER_GROUP_ID
            ensure id != Accessibility::FINDING_INTENT_ID or result == Accessibility::FILTER_GROUP_ID
            parent_for_id(id, sidebar_id, no_node_id)

        def node_first_child() -> usize:
            ensure result == Accessibility::FILTER_GROUP_ID
            Accessibility::FILTER_GROUP_ID

        def filter_first_child() -> usize:
            ensure result == Accessibility::FILTER_DETECTOR_ID
            Accessibility::FILTER_DETECTOR_ID

        def filter_next_sibling(id: usize, no_node_id: usize) -> usize:
            return Accessibility::FILTER_SUBJECT_ID if id == Accessibility::FILTER_DETECTOR_ID
            return Accessibility::FILTER_SEVERITY_ID if id == Accessibility::FILTER_SUBJECT_ID
            return Accessibility::FILTER_STATUS_ID if id == Accessibility::FILTER_SEVERITY_ID
            return Accessibility::FILTER_RESET_ID if id == Accessibility::FILTER_STATUS_ID
            return Accessibility::FINDING_INTENT_ID if id == Accessibility::FILTER_RESET_ID
            no_node_id

        def node_next_sibling(id: usize, visible_rows: i64, no_node_id: usize) -> usize:
            requires visible_rows >= 0 and visible_rows <= Capacity::VISIBLE_ROWS
            return Accessibility::PREVIOUS_ID if id == Accessibility::FILTER_GROUP_ID
            return Accessibility::NEXT_ID if id == Accessibility::PREVIOUS_ID
            return Accessibility::WORST_ID if id == Accessibility::NEXT_ID
            return Accessibility::ROW_ID_FIRST if id == Accessibility::WORST_ID and visible_rows > 0
            row: i64 = (id - Accessibility::ROW_ID_FIRST).i64() if id >= Accessibility::ROW_ID_FIRST and id < Accessibility::ROW_ID_FIRST + Capacity::VISIBLE_ROWS.usize() else -1
            return id + 1 if row >= 0 and row + 1 < visible_rows
            no_node_id

        # Keep the selected rank in the two-row viewport. Near the start,
        # anchor at zero; near the end, the selection occupies the last row.
        def window_start(selected: i64, count: i64) -> i64:
            requires selected >= 0
            requires count >= 0
            ensure result >= 0
            ensure result + Capacity::VISIBLE_ROWS <= count or count <= Capacity::VISIBLE_ROWS
            ensure selected >= count or (result <= selected and selected < result + Capacity::VISIBLE_ROWS)
            ensure selected < count or result == 0
            return 0 if count <= Capacity::VISIBLE_ROWS or selected >= count or selected < Capacity::VISIBLE_ROWS
            selected - Capacity::VISIBLE_ROWS + 1

        def previous_target(current: i64, count: i64) -> i64:
            requires current >= 0
            requires count > 0
            requires count <= Capacity::MAX_FINDINGS
            requires current < count
            ensure result >= 0
            ensure result < count
            ensure result == (count - 1 if current == 0 else current - 1)
            return count - 1 if current == 0
            current - 1

        def next_target(current: i64, count: i64) -> i64:
            requires current >= 0
            requires count > 0
            requires count <= Capacity::MAX_FINDINGS
            requires current < count
            ensure result >= 0
            ensure result < count
            ensure result == (0 if current + 1 >= count else current + 1)
            return 0 if current + 1 >= count
            current + 1

        def navigation_enabled(count: i64, fresh: bool, action: i64) -> bool:
            ensure result == (fresh and count > 0 and count <= Capacity::MAX_FINDINGS and action >= Action.Previous.i64() and action <= Action.Worst.i64())
            fresh and count > 0 and count <= Capacity::MAX_FINDINGS and action >= Action.Previous.i64() and action <= Action.Worst.i64()

        def navigation_frame_admitted(frame: i64, frames: i64) -> bool:
            ensure result == (frames > 0 and frame >= 0 and frame < frames)
            frames > 0 and frame >= 0 and frame < frames

        def navigation_target(current: i64, count: i64, action: i64) -> i64:
            requires current >= 0
            requires count > 0
            requires count <= Capacity::MAX_FINDINGS
            requires current < count
            requires action >= Action.Previous.i64() and action <= Action.Worst.i64()
            ensure result >= 0
            ensure result < count
            if action == Action.Previous.i64():
                return count - 1 if current == 0
                return current - 1
            return 0 if action == Action.Worst.i64()
            return 0 if current + 1 >= count
            current + 1

        def row_route_enabled(index: i64, visible_rows: i64, fresh: bool) -> bool:
            requires visible_rows >= 0
            requires visible_rows <= Capacity::VISIBLE_ROWS
            ensure not result or fresh
            ensure not result or index >= 0 and index < visible_rows
            fresh and index >= 0 and index < visible_rows
