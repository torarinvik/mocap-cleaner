# Bounded redraw and semantic revision counter. Rollover is explicit so the
# application can invalidate every cache that uses the revision as a stamp.
module StudioRedrawRevisionPolicy:
    public:
        const module Domain:
            MAX: i64 = 9223372036854775807

        struct Step:
            value: i64
            wrapped: bool

        def valid(value: i64) -> bool:
            value >= 0 and value <= Domain::MAX

        def next(value: i64) -> Step:
            requires valid(value)
            ensure valid(result.value)
            ensure result.wrapped == (value == Domain::MAX)
            ensure result.wrapped or result.value == value + 1
            ensure not result.wrapped or result.value == 0
            if value == Domain::MAX:
                return Step{value: 0, wrapped: true}
            Step{value: value + 1, wrapped: false}
