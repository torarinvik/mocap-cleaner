# Focus loss cancels live input state while preserving completed choices.
include "focus.elisa"

module StudioFocusLaws:
    public:
        def slider_draft_rolls_back(s: StudioFocus::Interaction) -> bool:
            requires s.slider_drag
            ensure result
            out: StudioFocus::Interaction = StudioFocus::after_focus_lost(s)
            return out.retime_speed == s.slider_start_speed

        def idle_slider_value_stays(s: StudioFocus::Interaction) -> bool:
            requires not s.slider_drag
            ensure result
            out: StudioFocus::Interaction = StudioFocus::after_focus_lost(s)
            return out.retime_speed == s.retime_speed

        def completed_range_is_kept(s: StudioFocus::Interaction) -> bool:
            requires not s.selecting
            ensure result == s.selection_active
            out: StudioFocus::Interaction = StudioFocus::after_focus_lost(s)
            return out.selection_active

        def gizmo_tool_is_kept(s: StudioFocus::Interaction) -> i64:
            ensure result == s.gizmo_mode
            out: StudioFocus::Interaction = StudioFocus::after_focus_lost(s)
            return out.gizmo_mode
