# Restore is enabled only for a selected, valid Trash receipt whose durable
# manifest state and current filesystem identity have both been verified.
# The caller performs persistence and filesystem checks; this kernel does no I/O.
module StudioStorageRestorePolicy:
    public:
        const IN_TRASH: i64 = 1
        # `durable_receipt` means the receipt was read from the persisted
        # manifest after its durable write boundary. `identity_verified` means
        # the current Trash file matched every recorded identity field.
        def eligible(state: i64, receipt_valid: bool,
                     durable_receipt: bool, identity_verified: bool,
                     selection_valid: bool, operation_active: bool) -> bool:
            ensure not result or durable_receipt
            ensure not result or identity_verified
            ensure not result or selection_valid
            ensure not result or not operation_active
            ensure not result or state == IN_TRASH
            ensure not result or receipt_valid
            if not durable_receipt:
                return false
            if not identity_verified:
                return false
            if not selection_valid:
                return false
            if operation_active:
                return false
            if not receipt_valid:
                return false
            state == IN_TRASH
