# Laws of the studio's shortcut decoding.
include "shortcuts.elisa"

module StudioShortcutsLaws:
    public:
        # Cmd-Z undoes.
        def command_z_undoes(mask: i64) -> i64:
            requires mask == StudioShortcuts::COMMAND
            ensure result == StudioShortcuts::UNDO
            a: i64 = StudioShortcuts::z_chord(mask)
            return a

        # Cmd-Shift-Z redoes.
        def command_shift_z_redoes(mask: i64) -> i64:
            requires mask == StudioShortcuts::ALL
            ensure result == StudioShortcuts::REDO
            a: i64 = StudioShortcuts::z_chord(mask)
            return a

        # Plain Z and Shift-Z stay single-key bindings.
        def bare_z_plain(mask: i64) -> i64:
            requires mask == 0 or mask == StudioShortcuts::SHIFT
            ensure result == StudioShortcuts::PLAIN
            a: i64 = StudioShortcuts::z_chord(mask)
            return a

        # Releasing Cmd after a chord leaves only Shift (or nothing) held.
        def release_command(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result == StudioShortcuts::PLAIN
            released: i64 = StudioShortcuts::command_up(mask)
            return StudioShortcuts::z_chord(released)

        # With Cmd held, no other key reaches its single-key binding.
        def command_swallows(mask: i64) -> i64:
            requires mask == 1 or mask == 3
            ensure result == StudioShortcuts::SWALLOW
            a: i64 = StudioShortcuts::other_chord(mask)
            return a

        # Pressing a held modifier again changes nothing.
        def repeat_down(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result
            once: i64 = StudioShortcuts::shift_down(mask)
            twice: i64 = StudioShortcuts::shift_down(once)
            same: bool = once == twice
            return same

        # Native key repeat can repeat modifier-down events. Repeating Cmd
        # must preserve the combined Cmd/Shift mask rather than toggle it.
        def repeat_command_down(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result
            once: i64 = StudioShortcuts::command_down(mask)
            twice: i64 = StudioShortcuts::command_down(once)
            return once == twice

        # Duplicate modifier-up notifications are harmless as well, including
        # when the other modifier remains held.
        def repeat_command_up(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result
            once: i64 = StudioShortcuts::command_up(mask)
            twice: i64 = StudioShortcuts::command_up(once)
            return once == twice

        def repeat_shift_up(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result
            once: i64 = StudioShortcuts::shift_up(mask)
            twice: i64 = StudioShortcuts::shift_up(once)
            return once == twice

        # Cmd-O opens a take; Cmd-Shift-O opens a session.
        def command_o_opens_take(mask: i64) -> i64:
            requires mask == StudioShortcuts::COMMAND
            ensure result == StudioShortcuts::OPEN_TAKE
            a: i64 = StudioShortcuts::o_chord(mask)
            return a

        def command_shift_o_opens_session(mask: i64) -> i64:
            requires mask == StudioShortcuts::ALL
            ensure result == StudioShortcuts::OPEN_SESSION
            a: i64 = StudioShortcuts::o_chord(mask)
            return a

        # Cmd-S saves in place; Cmd-Shift-S asks where.
        def command_s_saves(mask: i64) -> i64:
            requires mask == StudioShortcuts::COMMAND
            ensure result == StudioShortcuts::SAVE
            a: i64 = StudioShortcuts::s_chord(mask)
            return a

        def command_shift_s_saves_as(mask: i64) -> i64:
            requires mask == StudioShortcuts::ALL
            ensure result == StudioShortcuts::SAVE_AS
            a: i64 = StudioShortcuts::s_chord(mask)
            return a

        # Cmd-E, with or without Shift, exports to a chosen file.
        def command_e_exports_as(mask: i64) -> i64:
            requires mask == 1 or mask == 3
            ensure result == StudioShortcuts::EXPORT_AS
            a: i64 = StudioShortcuts::e_chord(mask)
            return a

        # Without Cmd, O, S and E open no file panel.
        def plain_o_opens_nothing(mask: i64) -> i64:
            requires mask == 0 or mask == StudioShortcuts::SHIFT
            ensure result == StudioShortcuts::FILE_NONE
            a: i64 = StudioShortcuts::o_chord(mask)
            return a

        def plain_s_opens_nothing(mask: i64) -> i64:
            requires mask == 0 or mask == StudioShortcuts::SHIFT
            ensure result == StudioShortcuts::FILE_NONE
            a: i64 = StudioShortcuts::s_chord(mask)
            return a

        def plain_e_opens_nothing(mask: i64) -> i64:
            requires mask == 0 or mask == StudioShortcuts::SHIFT
            ensure result == StudioShortcuts::FILE_NONE
            a: i64 = StudioShortcuts::e_chord(mask)
            return a
