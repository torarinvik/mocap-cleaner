# Laws of the studio's shortcut decoding.
include "shortcuts.elisa"

module StudioShortcutsLaws:
    public:
        # Cmd-Z undoes.
        def command_z_undoes(mask: i64) -> i64:
            requires mask == StudioShortcuts::COMMAND
            ensure result == StudioShortcuts::UNDO
            a: i64 = StudioShortcuts::z_chord(mask)
            return a

        # Cmd-Shift-Z redoes.
        def command_shift_z_redoes(mask: i64) -> i64:
            requires mask == StudioShortcuts::ALL
            ensure result == StudioShortcuts::REDO
            a: i64 = StudioShortcuts::z_chord(mask)
            return a

        # Plain Z and Shift-Z stay single-key bindings.
        def bare_z_plain(mask: i64) -> i64:
            requires mask == 0 or mask == StudioShortcuts::SHIFT
            ensure result == StudioShortcuts::PLAIN
            a: i64 = StudioShortcuts::z_chord(mask)
            return a

        # Releasing Cmd after a chord leaves only Shift (or nothing) held.
        def release_command(mask: i64) -> i64:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result == StudioShortcuts::PLAIN
            released: i64 = StudioShortcuts::command_up(mask)
            return StudioShortcuts::z_chord(released)

        # With Cmd held, no other key reaches its single-key binding.
        def command_swallows(mask: i64) -> i64:
            requires mask == 1 or mask == 3
            ensure result == StudioShortcuts::SWALLOW
            a: i64 = StudioShortcuts::other_chord(mask)
            return a

        # Pressing a held modifier again changes nothing.
        def repeat_down(mask: i64) -> bool:
            requires mask >= 0
            requires mask <= StudioShortcuts::ALL
            ensure result
            once: i64 = StudioShortcuts::shift_down(mask)
            twice: i64 = StudioShortcuts::shift_down(once)
            same: bool = once == twice
            return same
