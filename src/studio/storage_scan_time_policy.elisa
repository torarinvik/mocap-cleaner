# Bounded integer conversion from Unix seconds to an explicit UTC calendar
# timestamp for Storage copy. The supported range covers years 1970 through
# 9999 and keeps every intermediate in signed i64.
module StudioStorageScanTimePolicy:
    public:
        const SECONDS_PER_DAY: i64 = 86400
        const MAX_UNIX_SECONDS: i64 = 253402300799

        struct UtcParts:
            year: i64
            month: i64
            day: i64
            hour: i64
            minute: i64
            second: i64

        def supported(timestamp: i64) -> bool:
            ensure result == (timestamp >= 0 and timestamp <= MAX_UNIX_SECONDS)
            timestamp >= 0 and timestamp <= MAX_UNIX_SECONDS

        def hour_of_day(timestamp: i64) -> i64:
            requires timestamp >= 0
            requires timestamp <= MAX_UNIX_SECONDS
            ensure result >= 0 and result <= 23
            ((timestamp % SECONDS_PER_DAY) / 3600)

        def minute_of_hour(timestamp: i64) -> i64:
            requires timestamp >= 0
            requires timestamp <= MAX_UNIX_SECONDS
            ensure result >= 0 and result <= 59
            (((timestamp % SECONDS_PER_DAY) % 3600) / 60)

        def second_of_minute(timestamp: i64) -> i64:
            requires timestamp >= 0
            requires timestamp <= MAX_UNIX_SECONDS
            ensure result >= 0 and result <= 59
            ((timestamp % SECONDS_PER_DAY) % 60)

        def utc_parts(timestamp: i64) -> UtcParts:
            requires timestamp >= 0
            requires timestamp <= MAX_UNIX_SECONDS
            ensure result.hour >= 0 and result.hour <= 23
            ensure result.minute >= 0 and result.minute <= 59
            ensure result.second >= 0 and result.second <= 59
            days: i64 = timestamp / SECONDS_PER_DAY
            z: i64 = days + 719468
            era: i64 = z / 146097
            day_of_era: i64 = z - era * 146097
            year_of_era: i64 = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
            year_base: i64 = year_of_era + era * 400
            day_of_year: i64 = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
            month_prime: i64 = (5 * day_of_year + 2) / 153
            day: i64 = day_of_year - (153 * month_prime + 2) / 5 + 1
            month: i64 = month_prime + 3 if month_prime < 10 else month_prime - 9
            year: i64 = year_base + 1 if month <= 2 else year_base
            hour: i64 = hour_of_day(timestamp)
            minute: i64 = minute_of_hour(timestamp)
            second: i64 = second_of_minute(timestamp)
            UtcParts{
                year: year,
                month: month,
                day: day,
                hour: hour,
                minute: minute,
                second: second
            }
