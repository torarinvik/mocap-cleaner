# Pure scalar bounds for persisted Trash receipts. Keep artifact kind values
# and the size limit aligned with StudioStorageCleanupPolicy; the codec test
# pins that shared schema boundary.
module StudioStorageReceiptPolicy:
    public:
        const RECOVERY: i64 = 0
        const TEMP_EXPORT: i64 = 1
        const GENERATED_REPORT: i64 = 2
        const KIND_COUNT: i64 = 3
        const MAX_ITEM_BYTES: i64 = 1000000000000000
        const MAX_IDENTITY_VALUE: i64 = 9000000000000000000
        const MAX_MODIFIED_NANOSECONDS: i64 = 999999999

        # A valid receipt is only written after the engine has moved a regular
        # file and captured a complete filesystem identity.
        def scalar_valid(kind: i64, device: i64, inode: i64, size_bytes: i64,
                         modified_seconds: i64, modified_nanoseconds: i64) -> bool:
            ensure result == (kind >= RECOVERY and kind < KIND_COUNT and device >= 0 and device <= MAX_IDENTITY_VALUE and inode >= 0 and inode <= MAX_IDENTITY_VALUE and size_bytes >= 0 and size_bytes <= MAX_ITEM_BYTES and modified_seconds >= 0 - MAX_IDENTITY_VALUE and modified_seconds <= MAX_IDENTITY_VALUE and modified_nanoseconds >= 0 and modified_nanoseconds <= MAX_MODIFIED_NANOSECONDS)
            return false if kind < RECOVERY or kind >= KIND_COUNT
            return false if device < 0 or device > MAX_IDENTITY_VALUE
            return false if inode < 0 or inode > MAX_IDENTITY_VALUE
            return false if size_bytes < 0 or size_bytes > MAX_ITEM_BYTES
            return false if modified_seconds < 0 - MAX_IDENTITY_VALUE or modified_seconds > MAX_IDENTITY_VALUE
            return false if modified_nanoseconds < 0 or modified_nanoseconds > MAX_MODIFIED_NANOSECONDS
            true
