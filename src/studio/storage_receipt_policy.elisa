# Pure scalar bounds for persisted Trash receipts. Keep artifact kind values
# and the size limit aligned with StudioStorageCleanupPolicy; the codec test
# pins that shared schema boundary.
module StudioStorageReceiptPolicy:
    public:
        const enum Kind of i64:
            Recovery = 0
            TemporaryExport = 1
            GeneratedReport = 2

        const module Limit:
            KIND_COUNT: i64 = 3
            MAX_ITEM_BYTES: i64 = 1000000000000
            MAX_IDENTITY_VALUE: i64 = 9000000000000000000
            MAX_MODIFIED_NANOSECONDS: i64 = 999999999

        # A valid receipt is only written after the engine has moved a regular
        # file and captured a complete filesystem identity.
        def scalar_valid(kind: i64, device: i64, inode: i64, size_bytes: i64,
                         modified_seconds: i64, modified_nanoseconds: i64) -> bool:
            ensure result == (kind >= Kind.Recovery.i64() and kind < Limit::KIND_COUNT and device >= 0 and device <= Limit::MAX_IDENTITY_VALUE and inode >= 0 and inode <= Limit::MAX_IDENTITY_VALUE and size_bytes >= 0 and size_bytes <= Limit::MAX_ITEM_BYTES and modified_seconds >= 0 - Limit::MAX_IDENTITY_VALUE and modified_seconds <= Limit::MAX_IDENTITY_VALUE and modified_nanoseconds >= 0 and modified_nanoseconds <= Limit::MAX_MODIFIED_NANOSECONDS)
            return false if kind < Kind.Recovery.i64() or kind >= Limit::KIND_COUNT
            return false if device < 0 or device > Limit::MAX_IDENTITY_VALUE
            return false if inode < 0 or inode > Limit::MAX_IDENTITY_VALUE
            return false if size_bytes < 0 or size_bytes > Limit::MAX_ITEM_BYTES
            return false if modified_seconds < 0 - Limit::MAX_IDENTITY_VALUE or modified_seconds > Limit::MAX_IDENTITY_VALUE
            return false if modified_nanoseconds < 0 or modified_nanoseconds > Limit::MAX_MODIFIED_NANOSECONDS
            true
