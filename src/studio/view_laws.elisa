# Laws of the studio's 2D pixel mapping.
include "view.elisa"

module StudioViewLaws:
    public:
        # The top of the range draws on the top row.
        def high_on_top(lo: i64, hi: i64, top: i64, height: i64) -> i64:
            requires lo >= -StudioView::Curve::MAX_VALUE
            requires hi <= StudioView::Curve::MAX_VALUE
            requires lo < hi
            requires height >= 1
            requires height <= StudioView::Coordinate::MAX_PIXELS
            requires top >= 0
            requires top <= StudioView::Coordinate::MAX_PIXELS
            ensure result == top
            return StudioView::value_y(hi, lo, hi, top, height)

        # The bottom of the range draws on the bottom row.
        def low_on_bottom(lo: i64, hi: i64, top: i64, height: i64) -> i64:
            requires lo >= -StudioView::Curve::MAX_VALUE
            requires hi <= StudioView::Curve::MAX_VALUE
            requires lo < hi
            requires height >= 1
            requires height <= StudioView::Coordinate::MAX_PIXELS
            requires top >= 0
            requires top <= StudioView::Coordinate::MAX_PIXELS
            ensure result == top + height
            return StudioView::value_y(lo, lo, hi, top, height)

        # Values outside the range are pinned to the box.
        def above_range_pinned(value: i64, lo: i64, hi: i64, top: i64, height: i64) -> i64:
            requires lo >= -StudioView::Curve::MAX_VALUE
            requires hi <= StudioView::Curve::MAX_VALUE
            requires lo < hi
            requires value > hi
            requires height >= 1
            requires height <= StudioView::Coordinate::MAX_PIXELS
            requires top >= 0
            requires top <= StudioView::Coordinate::MAX_PIXELS
            ensure result == top
            return StudioView::value_y(value, lo, hi, top, height)

        # Below the threshold is never a problem marker.
        def quiet_is_clean(accel: i64, threshold: i64) -> i64:
            requires threshold >= 1
            requires threshold <= StudioView::Curve::MAX_VALUE
            requires accel >= 0
            requires accel < threshold
            ensure result == 0
            return StudioView::severity(accel, threshold)

        # At the threshold a marker always shows.
        def threshold_marks(threshold: i64) -> bool:
            requires threshold >= 1
            requires threshold <= StudioView::Curve::MAX_VALUE
            ensure result
            return StudioView::severity(threshold, threshold) >= 1

        # An empty rectangle is never hit.
        def empty_never_hit(px: i64, py: i64, x: i64, y: i64) -> bool:
            ensure not result
            return StudioView::inside(px, py, x, y, 0, 0)

        # The first part starts at the left edge.
        def first_part_at_zero(total: i64, parts: i64) -> i64:
            requires total >= 0
            requires total <= StudioView::Coordinate::MAX_PIXELS
            requires parts >= 1
            requires parts <= 16
            ensure result == 0
            return StudioView::part_start(total, parts, 0)
