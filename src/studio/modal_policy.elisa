# Modal canvas overlays need the hosted 3D layers hidden so their text and
# controls are not covered by viewport surfaces.
module StudioModalPolicy:
    public:
        def hides_viewports(help_open: bool, replacement_open: bool,
                            legacy_session_open: bool, export_review_open: bool,
                            export_warning_open: bool, export_path_open: bool,
                            export_result_open: bool) -> bool:
            ensure result == (help_open or replacement_open or legacy_session_open or export_review_open or export_warning_open or export_path_open or export_result_open)
            help_open or replacement_open or legacy_session_open or export_review_open or export_warning_open or export_path_open or export_result_open
