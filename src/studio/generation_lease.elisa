# The native adapter resolves and leases the running binary's actual artifact
# before Studio creates its window. Its file descriptor remains live until
# release or process termination.
include "generation_lease_policy.elisa"

module StudioGenerationLease:
    private:
        @link_name("elisa_studio_generation_lease_acquire")
        extern native_acquire() -> i32 can[Blocking.IO, Unsafe.RawExtern]
        @link_name("elisa_studio_generation_lease_release")
        extern native_release() -> i32 can[Blocking.IO, Unsafe.RawExtern]

    public:
        def acquire() -> StudioGenerationLeasePolicy::AcquireStatus can[Blocking.IO, Unsafe.RawExtern]:
            code: i32 = native_acquire()
            return StudioGenerationLeasePolicy::AcquireStatus.Acquired if code == 0
            return StudioGenerationLeasePolicy::AcquireStatus.MetadataUnavailable if code == 1
            return StudioGenerationLeasePolicy::AcquireStatus.LeaseBusy if code == 2
            return StudioGenerationLeasePolicy::AcquireStatus.ArtifactChanged if code == 3
            StudioGenerationLeasePolicy::AcquireStatus.NativeFailure

        def release() -> bool can[Blocking.IO, Unsafe.RawExtern]:
            native_release() == 0
