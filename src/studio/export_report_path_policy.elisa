module StudioExportReportPathPolicy:
    public:
        const module Capacity:
            PATH_BYTES: i64 = 4096
            JSON_SUFFIX_BYTES: i64 = 12
            TEXT_SUFFIX_BYTES: i64 = 11

        # Includes the trailing NUL required by the native path APIs.
        def admitted(destination_bytes: i64) -> bool:
            ensure result == (destination_bytes > 0 and destination_bytes <= Capacity::PATH_BYTES - 1 - Capacity::JSON_SUFFIX_BYTES and destination_bytes <= Capacity::PATH_BYTES - 1 - Capacity::TEXT_SUFFIX_BYTES)
            destination_bytes > 0 and destination_bytes <= Capacity::PATH_BYTES - 1 - Capacity::JSON_SUFFIX_BYTES and destination_bytes <= Capacity::PATH_BYTES - 1 - Capacity::TEXT_SUFFIX_BYTES
