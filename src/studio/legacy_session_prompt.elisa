# Focus and choice policy for explicitly restoring a session without source
# identity. The safe default is Cancel; loading requires a deliberate choice.
module StudioLegacyPrompt:
    public:
        const NONE: i64 = 0
        const LOAD: i64 = 1
        const CANCEL: i64 = 2
        const CHOICES: i64 = 2
        const FOCUS_LOAD: i64 = 0
        const FOCUS_CANCEL: i64 = 1

        def initial_focus() -> i64:
            ensure result == FOCUS_CANCEL
            FOCUS_CANCEL

        def move_focus(focus: i64, direction: i64) -> i64:
            requires focus >= 0
            requires focus < CHOICES
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < CHOICES
            ensure direction != 1 or focus != FOCUS_CANCEL or result == FOCUS_LOAD
            ensure direction != -1 or focus != FOCUS_LOAD or result == FOCUS_CANCEL
            return FOCUS_LOAD if direction == 1 and focus == FOCUS_CANCEL
            return FOCUS_CANCEL if direction == -1 and focus == FOCUS_LOAD
            focus

        def resolve(is_open: bool, choice: i64) -> i64:
            requires choice == LOAD or choice == CANCEL
            ensure result == NONE or result == choice
            ensure is_open or result == NONE
            ensure not is_open or result == choice
            return choice if is_open
            NONE
