# Focus and choice policy for explicitly restoring a session without source
# identity. The safe default is Cancel; loading requires a deliberate choice.
module StudioLegacyPrompt:
    public:
        const enum Choice of i64:
            None = 0
            Load = 1
            Cancel = 2

        const enum Focus of i64:
            Load = 0
            Cancel = 1

        const module Count:
            CHOICES: i64 = 2

        def initial_focus() -> i64:
            ensure result == Focus.Cancel.i64()
            Focus.Cancel.i64()

        def move_focus(focus: i64, direction: i64) -> i64:
            requires focus >= 0
            requires focus < Count::CHOICES
            requires direction == -1 or direction == 1
            ensure result >= 0
            ensure result < Count::CHOICES
            ensure direction != 1 or focus != Focus.Cancel.i64() or result == Focus.Load.i64()
            ensure direction != -1 or focus != Focus.Load.i64() or result == Focus.Cancel.i64()
            return Focus.Load.i64() if direction == 1 and focus == Focus.Cancel.i64()
            return Focus.Cancel.i64() if direction == -1 and focus == Focus.Load.i64()
            focus

        def resolve(is_open: bool, choice: i64) -> i64:
            requires choice == Choice.Load.i64() or choice == Choice.Cancel.i64()
            ensure result == Choice.None.i64() or result == choice
            ensure is_open or result == Choice.None.i64()
            ensure not is_open or result == choice
            return choice if is_open
            Choice.None.i64()
