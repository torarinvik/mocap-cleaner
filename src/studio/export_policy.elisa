# Pure authorization rules for publishing a cleaned take. Filesystem facts
# (canonical paths, links and file identity) come from the host adapter; this
# kernel decides whether those facts permit an export.
module StudioExportPolicy:
    public:
        const enum Reason of i64:
            ALLOW = 0
            PATH_UNRESOLVED = 1
            OUTSIDE_BUILD = 2
            SOURCE_COLLISION = 3
            SYMBOLIC_LINK = 4
            NOT_REGULAR_FILE = 5
            OVERWRITE_UNCONFIRMED = 6

        # Canonical paths must be absolute and `root` must not end in a slash.
        # The separator check prevents `/project/build-old` from being treated
        # as a child of `/project/build`.
        def inside_build(root: darray[u8]&, target: darray[u8]&) -> bool:
            return false if root.count <= 1 or target.count <= root.count
            return false if root[root.count - 1] == 47
            for index in 0..<root.count |root, target, index|:
                return false if root[index] != target[index]
            target[root.count] == 47

        # Reject by reason, in order of most useful recovery guidance. An
        # existing target is replaceable only after the caller has obtained an
        # explicit overwrite confirmation (for example, from NSSavePanel).
        def decision(path_resolved: bool, target_inside_build: bool,
                     same_as_source: bool, target_exists: bool,
                     target_is_symlink: bool, target_is_regular: bool,
                     overwrite_confirmed: bool) -> i64:
            requires target_exists or not target_is_symlink
            requires target_exists or not target_is_regular
            ensure result >= Reason.ALLOW.i64()
            ensure result <= Reason.OVERWRITE_UNCONFIRMED.i64()
            ensure result != Reason.ALLOW.i64() or (path_resolved and target_inside_build and not same_as_source and not target_is_symlink and (not target_exists or (target_is_regular and overwrite_confirmed)))
            return Reason.PATH_UNRESOLVED.i64() if not path_resolved
            return Reason.OUTSIDE_BUILD.i64() if not target_inside_build
            return Reason.SOURCE_COLLISION.i64() if same_as_source
            return Reason.SYMBOLIC_LINK.i64() if target_is_symlink
            return Reason.NOT_REGULAR_FILE.i64() if target_exists and not target_is_regular
            return Reason.OVERWRITE_UNCONFIRMED.i64() if target_exists and not overwrite_confirmed
            Reason.ALLOW.i64()

        # Material review warnings are remaining impossible balance frames or
        # a cleanup result that worsens a source metric. Count categories, not
        # frame totals, so the acknowledgement remains understandable.
        def warning_flag(condition: bool) -> i64:
            ensure result >= 0
            ensure result <= 1
            return 1 if condition else 0

        def warning_count(impossible_frames: i64,
                          spikes_before: i64, spikes_after: i64,
                          slide_before: i64, slide_after: i64,
                          sink_before: i64, sink_after: i64,
                          hand_slide_before: i64, hand_slide_after: i64) -> i64:
            requires impossible_frames >= 0
            requires spikes_before >= 0 and spikes_after >= 0
            requires slide_before >= 0 and slide_after >= 0
            requires sink_before >= 0 and sink_after >= 0
            requires hand_slide_before >= 0 and hand_slide_after >= 0
            ensure result >= 0
            ensure result <= 5
            warning_flag(impossible_frames > 0) + warning_flag(spikes_after > spikes_before) + warning_flag(slide_after > slide_before) + warning_flag(sink_after > sink_before) + warning_flag(hand_slide_after > hand_slide_before)
