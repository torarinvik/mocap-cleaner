module StudioFbxImportPolicy:
    public:
        const module Limit:
            PATH_BYTES: i64 = 4096
            ANIMATION_BYTES: i64 = 1024
            MAX_RATE: i64 = 120
            DEFAULT_RATE: i64 = 30

        const enum Admission of i64:
            Accepted = 0
            StaleRequest = 1
            Cancelled = 2
            WorkerFailed = 3
            MissingAnimation = 4
            SourceMismatch = 5
            InvalidDestination = 6
            InvalidDigests = 7

        def admission(ticket: i64, current_ticket: i64, cancelled: bool,
                      conversion_status: i64, has_memo: bool,
                      source_matches: bool, destination_valid: bool,
                      digests_valid: bool) -> Admission:
            ensure (result == Admission.Accepted) == may_commit(ticket, current_ticket, cancelled, conversion_status, has_memo, source_matches, destination_valid, digests_valid)
            return Admission.StaleRequest if ticket <= 0 or ticket != current_ticket
            return Admission.Cancelled if cancelled
            return Admission.WorkerFailed if conversion_status != 0
            return Admission.MissingAnimation if not has_memo
            return Admission.SourceMismatch if not source_matches
            return Admission.InvalidDestination if not destination_valid
            return Admission.InvalidDigests if not digests_valid
            Admission.Accepted

        def admission_message(reason: Admission) -> sview:
            return "FBX result belongs to an earlier request and was discarded. Open the take again." if reason == Admission.StaleRequest
            return "FBX import cancelled. The current take is unchanged." if reason == Admission.Cancelled
            return "The FBX worker returned no usable animation. The current take is unchanged." if reason == Admission.MissingAnimation
            return "FBX result does not match the requested source path. The current take is unchanged." if reason == Admission.SourceMismatch
            return "FBX result has an invalid derived-file path. The current take is unchanged." if reason == Admission.InvalidDestination
            return "FBX result has incomplete source or derived-file digests. The current take is unchanged." if reason == Admission.InvalidDigests
            "FBX import failed. The current take is unchanged."

        def may_publish(ticket: i64, current_ticket: i64, cancelled: bool,
                        conversion_status: i64, has_memo: bool) -> bool:
            ensure result implies ticket > 0 and ticket == current_ticket
            ensure result implies not cancelled and conversion_status == 0 and has_memo
            ticket > 0 and ticket == current_ticket and not cancelled and conversion_status == 0 and has_memo

        def may_commit(ticket: i64, current_ticket: i64, cancelled: bool,
                       conversion_status: i64, has_memo: bool,
                       source_matches: bool, destination_valid: bool,
                       digests_valid: bool) -> bool:
            ensure result implies ticket > 0 and ticket == current_ticket
            ensure result implies not cancelled and conversion_status == 0 and has_memo
            ensure result implies source_matches and destination_valid and digests_valid
            (may_publish(ticket, current_ticket, cancelled, conversion_status, has_memo) and
                source_matches and destination_valid and digests_valid)

        def rate_valid(rate: i64) -> bool:
            ensure result implies rate > 0 and rate <= Limit::MAX_RATE
            rate > 0 and rate <= Limit::MAX_RATE

        def terminated(bytes: darray[u8]&, maximum: i64) -> bool:
            requires maximum > 0
            ensure result implies bytes.count > 1 and bytes.count.i64() <= maximum
            return false if bytes.count <= 1 or bytes.count.i64() > maximum
            return false if bytes[bytes.count - 1] != 0
            for index in 0..<(bytes.count - 1) |index, bytes|:
                return false if bytes[index] == 0
            true

        def same_path(first: darray[u8]&, second: darray[u8]&) -> bool:
            return false if first.count != second.count
            for index in 0..<first.count |index, first, second|:
                return false if first[index] != second[index]
            true

        def extension_is_fbx(dot: u8, f: u8, b: u8, x: u8) -> bool:
            lower_f: bool = f == 102 or f == 70
            lower_b: bool = b == 98 or b == 66
            lower_x: bool = x == 120 or x == 88
            dot == 46 and lower_f and lower_b and lower_x
