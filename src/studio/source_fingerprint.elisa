# Compact residues for detecting source changes in legacy studio sessions.
# Equality does not establish exact bytes or semantic rig identity; these
# fingerprints are not intended for authentication.
module StudioSourceFingerprint:
    public:
        const module Residue:
            FIRST_MODULUS: i64 = 2147483647
            SECOND_MODULUS: i64 = 2147483629

        struct Fingerprint:
            first: i64
            second: i64

        # Legal inputs return a canonical residue. The largest intermediate
        # is below 2^40 and therefore fits signed i64.
        def first_step(value: i64, byte: i64) -> i64:
            requires value >= 0
            requires value < Residue::FIRST_MODULUS
            requires byte >= 0
            requires byte <= 255
            ensure result >= 0
            ensure result < Residue::FIRST_MODULUS
            return (value * 257 + byte + 1) % Residue::FIRST_MODULUS

        def second_step(value: i64, byte: i64) -> i64:
            requires value >= 0
            requires value < Residue::SECOND_MODULUS
            requires byte >= 0
            requires byte <= 255
            ensure result >= 0
            ensure result < Residue::SECOND_MODULUS
            return (value * 263 + byte + 1) % Residue::SECOND_MODULUS
