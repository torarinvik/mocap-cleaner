# Worker-owned contact preview input and output. The memo is moved across the
# thread boundary; no mutable Studio state or Clip buffers are borrowed.
include "../../build/generated/studio_runtime.elisa"

module StudioContactPreviewWorker:
    public:
        affine struct Job:
            identity: StudioJobIdentity::Identity
            memo: StudioModel::Memo
            stack_snapshot: StackState::Stack
            source_revision: i64

        affine struct Result:
            identity: StudioJobIdentity::Identity
            memo: StudioModel::Memo
            candidate: StudioModel::Clip?

        def evaluate(job: Job) -> Result can[Global{Read, Write}]:
            identity: StudioJobIdentity::Identity = job.identity
            stack_snapshot: StackState::Stack = job.stack_snapshot
            source_revision: i64 = job.source_revision
            mutable memo: StudioModel::Memo = move job.memo
            # Empty previous arrays with a full window force every frame to be
            # recomputed, matching the synchronous preview's full rebuild while
            # avoiding any shared read of the currently displayed Clip.
            no_points: darray[Geometry::Vec3] = []
            no_frames: darray[i64] = []
            window: StudioPerf::Window = StudioPerf::full(memo.frames)
            candidate: StudioModel::Clip? = StudioModel::build_with(&memo,
                stack_snapshot, no_points, no_frames, no_frames, window,
                source_revision)
            Result{identity: identity, memo: move memo, candidate: move candidate}

# The task runtime currently lowers bare top-level function values; module-
# qualified function values decline in that path. Keep the module worker API
# while handing task a typed top-level trampoline.
def evaluate_contact_preview_job(job: StudioContactPreviewWorker::Job) -> StudioContactPreviewWorker::Result can[Global{Read, Write}]:
    return StudioContactPreviewWorker::evaluate(move job)
