# Shared vertical layout policy for the Studio sidebar. Keep the quality
# readout, finding navigator, and cleanup stack in separate hit/draw regions.
module StudioSidebarLayout:
    public:
        const METRIC_FIRST_BASELINE: i64 = 96
        const METRIC_LINE_STEP: i64 = 14
        const METRIC_LINE_COUNT: i64 = 6
        const METRIC_BOTTOM: i64 = 174

        const ISSUE_TOP: i64 = 178
        const ISSUE_HEIGHT: i64 = 132
        const ISSUE_BOTTOM: i64 = 310
        const ISSUE_HEADING_TOP: i64 = ISSUE_TOP + 5
        const ISSUE_FILTER_TOP: i64 = ISSUE_TOP + 37
        const ISSUE_NAV_TOP: i64 = ISSUE_FILTER_TOP + 21
        const ISSUE_ROW_TOP: i64 = ISSUE_NAV_TOP + 25
        const ISSUE_ROW_HEIGHT: i64 = 31
        const ISSUE_ROW_STEP: i64 = 34
        const ISSUE_ROWS: i64 = 1
        const ISSUE_ROW_LAST_TOP: i64 = ISSUE_ROW_TOP
        const ISSUE_ROW_FIRST_BOTTOM: i64 = ISSUE_ROW_TOP + ISSUE_ROW_HEIGHT
        const ISSUE_ROW_LAST_BOTTOM: i64 = ISSUE_ROW_TOP + ISSUE_ROW_HEIGHT

        const STACK_HEADING_TOP: i64 = 316
        const STACK_HEADING_HEIGHT: i64 = 20
        const STACK_HEADING_BOTTOM: i64 = 336
        const ADD_TOP: i64 = 348
        const ADD_ROW_STEP: i64 = 28
        const ADD_ROW_HEIGHT: i64 = 24
        const ADD_ROWS: i64 = 2
        const ADD_LAST_BOTTOM: i64 = 400
        const OPERATION_ROW_TOP: i64 = 410
        const OPERATION_ROW_HEIGHT: i64 = 58
        const OPERATION_ROW_STEP: i64 = 62

        def sections_do_not_overlap() -> bool:
            ensure result
            METRIC_BOTTOM <= ISSUE_TOP and ISSUE_ROW_TOP >= ISSUE_TOP and ISSUE_ROW_LAST_TOP >= ISSUE_TOP and ISSUE_ROW_FIRST_BOTTOM <= ISSUE_BOTTOM and ISSUE_ROW_LAST_BOTTOM <= ISSUE_BOTTOM and ISSUE_BOTTOM <= STACK_HEADING_TOP and STACK_HEADING_BOTTOM <= ADD_TOP and ADD_LAST_BOTTOM <= OPERATION_ROW_TOP
