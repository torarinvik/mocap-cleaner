# Shared vertical layout policy for the Studio sidebar. Keep the quality
# readout, finding navigator, and cleanup stack in separate hit/draw regions.
module StudioSidebarLayout:
    public:
        const module Geometry:
            METRIC_FIRST_BASELINE: i64 = 96
            METRIC_LINE_STEP: i64 = 14
            METRIC_LINE_COUNT: i64 = 6
            METRIC_BOTTOM: i64 = 174

            ISSUE_TOP: i64 = 178
            ISSUE_HEIGHT: i64 = 132
            ISSUE_BOTTOM: i64 = 310
            ISSUE_HEADING_TOP: i64 = 183
            ISSUE_FILTER_TOP: i64 = 215
            ISSUE_NAV_TOP: i64 = 236
            ISSUE_ROW_TOP: i64 = 261
            ISSUE_ROW_HEIGHT: i64 = 31
            ISSUE_ROW_STEP: i64 = 34
            ISSUE_ROWS: i64 = 1
            ISSUE_ROW_LAST_TOP: i64 = 261
            ISSUE_ROW_FIRST_BOTTOM: i64 = 292
            ISSUE_ROW_LAST_BOTTOM: i64 = 292

            STACK_HEADING_TOP: i64 = 316
            STACK_HEADING_HEIGHT: i64 = 20
            STACK_HEADING_BOTTOM: i64 = 336
            ADD_TOP: i64 = 348
            ADD_ROW_STEP: i64 = 28
            ADD_ROW_HEIGHT: i64 = 24
            ADD_ROWS: i64 = 2
            ADD_LAST_BOTTOM: i64 = 400
            OPERATION_ROW_TOP: i64 = 410
            OPERATION_ROW_HEIGHT: i64 = 58
            OPERATION_ROW_STEP: i64 = 62


        def sections_do_not_overlap() -> bool:
            ensure result
            StudioSidebarLayout::Geometry::METRIC_BOTTOM <= StudioSidebarLayout::Geometry::ISSUE_TOP and StudioSidebarLayout::Geometry::ISSUE_ROW_TOP >= StudioSidebarLayout::Geometry::ISSUE_TOP and StudioSidebarLayout::Geometry::ISSUE_ROW_LAST_TOP >= StudioSidebarLayout::Geometry::ISSUE_TOP and StudioSidebarLayout::Geometry::ISSUE_ROW_FIRST_BOTTOM <= StudioSidebarLayout::Geometry::ISSUE_BOTTOM and StudioSidebarLayout::Geometry::ISSUE_ROW_LAST_BOTTOM <= StudioSidebarLayout::Geometry::ISSUE_BOTTOM and StudioSidebarLayout::Geometry::ISSUE_BOTTOM <= StudioSidebarLayout::Geometry::STACK_HEADING_TOP and StudioSidebarLayout::Geometry::STACK_HEADING_BOTTOM <= StudioSidebarLayout::Geometry::ADD_TOP and StudioSidebarLayout::Geometry::ADD_LAST_BOTTOM <= StudioSidebarLayout::Geometry::OPERATION_ROW_TOP
