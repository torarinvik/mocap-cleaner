# Native rename and directory-sync results are trusted boundary facts.
module StudioPublicationDurabilityPolicy:
    public:
        const enum Result of i64:
            NotPublished = 0
            PublishedDurabilityUnknown = 1
            PublishedDirectorySynced = 2

        def outcome(renamed: bool, directory_synced: bool) -> Result:
            ensure not renamed implies result == Result.NotPublished
            ensure renamed and not directory_synced implies result == Result.PublishedDurabilityUnknown
            ensure renamed and directory_synced implies result == Result.PublishedDirectorySynced
            return Result.NotPublished if not renamed
            Result.PublishedDirectorySynced if directory_synced else Result.PublishedDurabilityUnknown

        def published(value: Result) -> bool:
            ensure result == (value != Result.NotPublished)
            value != Result.NotPublished
