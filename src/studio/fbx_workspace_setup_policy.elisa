module StudioFbxWorkspaceSetupPolicy:
    public:
        const enum Choice of i64:
            Ready = 5
            NeedsBuild = 2
            Cancelled = 1
            Refused = 0

        const enum Next of i64:
            StartImport = 0
            WaitForBuildConsent = 1
            CancelImport = 2
            KeepPending = 3

        # Workspace selection never creates build/; only the explicit action
        # may authorize that separate operation.
        def after_choice(pending: bool, choice: Choice) -> Next:
            ensure not pending implies result == Next.KeepPending
            ensure pending and choice == Choice.Ready implies result == Next.StartImport
            ensure pending and choice == Choice.NeedsBuild implies result == Next.WaitForBuildConsent
            ensure pending and choice == Choice.Cancelled implies result == Next.CancelImport
            ensure pending and choice == Choice.Refused implies result == Next.KeepPending
            return Next.KeepPending if not pending
            return Next.StartImport if choice.i64() == Choice.Ready.i64()
            return Next.WaitForBuildConsent if choice.i64() == Choice.NeedsBuild.i64()
            return Next.CancelImport if choice.i64() == Choice.Cancelled.i64()
            Next.KeepPending

        def after_build(pending: bool, explicit_create: bool,
                        created: bool, workspace_ready: bool) -> bool:
            ensure result implies pending and explicit_create and created and workspace_ready
            pending and explicit_create and created and workspace_ready
