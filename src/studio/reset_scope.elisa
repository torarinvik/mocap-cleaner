# Explicit cleanup reset scopes. Each accepted action maps to one complete
# stack snapshot, so the caller can make it a single undoable transaction.
module StudioResetScope:
    public:
        const enum Action of i64:
            REMOVE_OPERATION = 0
            CLEAR_CONTACTS = 1
            CLEAR_CORRECTIONS = 2
            RESTORE_SOURCE = 3

        def known(action: i64) -> bool:
            ensure result == (action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64())
            action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64()

        def enabled(action: i64, selected_operation: bool, contact_count: i64,
                    correction_count: i64, has_cleanup: bool) -> bool:
            requires contact_count >= 0
            requires correction_count >= 0
            ensure not result or known(action)
            return false if not known(action)
            return false if action == Action.REMOVE_OPERATION.i64() and not selected_operation
            return selected_operation if action == Action.REMOVE_OPERATION.i64()
            return contact_count > 0 if action == Action.CLEAR_CONTACTS.i64()
            return correction_count > 0 if action == Action.CLEAR_CORRECTIONS.i64()
            return has_cleanup if action == Action.RESTORE_SOURCE.i64()
            false

        # Every accepted reset is recorded once by the caller, regardless of
        # how many individual items its scope removes.
        def history_entries(action: i64) -> i64:
            requires action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64()
            ensure result == 1
            1

        def affects_operations(action: i64) -> bool:
            requires action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64()
            action == Action.REMOVE_OPERATION.i64() or action == Action.RESTORE_SOURCE.i64()

        def affects_contacts(action: i64) -> bool:
            requires action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64()
            action == Action.CLEAR_CONTACTS.i64() or action == Action.RESTORE_SOURCE.i64()

        def affects_corrections(action: i64) -> bool:
            requires action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64()
            action == Action.CLEAR_CORRECTIONS.i64() or action == Action.RESTORE_SOURCE.i64()

        def affects_all_cleanup(action: i64) -> bool:
            requires action >= Action.REMOVE_OPERATION.i64() and action <= Action.RESTORE_SOURCE.i64()
            action == Action.RESTORE_SOURCE.i64()
