# Explicit cleanup reset scopes. Each accepted action maps to one complete
# stack snapshot, so the caller can make it a single undoable transaction.
module StudioResetScope:
    public:
        const REMOVE_OPERATION: i64 = 0
        const CLEAR_CONTACTS: i64 = 1
        const CLEAR_CORRECTIONS: i64 = 2
        const RESTORE_SOURCE: i64 = 3

        def known(action: i64) -> bool:
            ensure result == (action >= REMOVE_OPERATION and action <= RESTORE_SOURCE)
            action >= REMOVE_OPERATION and action <= RESTORE_SOURCE

        def enabled(action: i64, selected_operation: bool, contact_count: i64,
                    correction_count: i64, has_cleanup: bool) -> bool:
            requires contact_count >= 0
            requires correction_count >= 0
            ensure not result or known(action)
            return false if not known(action)
            return false if action == REMOVE_OPERATION and not selected_operation
            return selected_operation if action == REMOVE_OPERATION
            return contact_count > 0 if action == CLEAR_CONTACTS
            return correction_count > 0 if action == CLEAR_CORRECTIONS
            return has_cleanup if action == RESTORE_SOURCE
            false

        # Every accepted reset is recorded once by the caller, regardless of
        # how many individual items its scope removes.
        def history_entries(action: i64) -> i64:
            requires action >= REMOVE_OPERATION and action <= RESTORE_SOURCE
            ensure result == 1
            1

        def affects_operations(action: i64) -> bool:
            requires action >= REMOVE_OPERATION and action <= RESTORE_SOURCE
            action == REMOVE_OPERATION or action == RESTORE_SOURCE

        def affects_contacts(action: i64) -> bool:
            requires action >= REMOVE_OPERATION and action <= RESTORE_SOURCE
            action == CLEAR_CONTACTS or action == RESTORE_SOURCE

        def affects_corrections(action: i64) -> bool:
            requires action >= REMOVE_OPERATION and action <= RESTORE_SOURCE
            action == CLEAR_CORRECTIONS or action == RESTORE_SOURCE

        def affects_all_cleanup(action: i64) -> bool:
            requires action >= REMOVE_OPERATION and action <= RESTORE_SOURCE
            action == RESTORE_SOURCE
