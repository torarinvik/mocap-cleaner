# Thin bounded ABI for the native descriptor-relative generation trash adapter.
# Policy and review admission live in StudioBuildGenerationTrashPolicy; this
# module only crosses the filesystem boundary while the native handle is held.
module StudioBuildGenerationTrashNative:
    public:
        const enum Status of i64:
            Acquired = 0
            Busy = 1
            Invalid = 2
            Changed = 3
            Unsupported = 4
            Failed = 5
            DurabilityUnknown = 6
            Moved = 7
            NotMoved = 8
            Restored = 9
            LocationUnknown = 10
            Conflict = 11
            StaleHandle = 12
            ReleaseUncertain = 13

        const enum Phase of i64:
            Intent = 0
            Quarantined = 1
            RestoreIntent = 2
            Restored = 3
            Unknown = 4
            NotMoved = 5

        const enum Location of i64:
            NotMoved = 0
            InQuarantine = 1
            BackAtOriginal = 2
            Conflict = 3
            Unknown = 4

        const module Limit:
            PATH_CAPACITY: i32 = 4096
            ID_CAPACITY: i32 = 97
            DIGEST_CAPACITY: i32 = 65
            ERROR_CAPACITY: i32 = 512

@link_name("elisa_studio_build_trash_begin_move")
extern studio_build_trash_begin_move(
    build_root: cstr, relative_path: cstr, artifact_kind: i32,
    artifact_id: cstr, expected_device: u64, expected_inode: u64,
    expected_product_sha256: cstr, handle: mutable i64&,
    root_identity_verified: mutable i32&, source_identity_verified: mutable i32&,
    manifest_verified: mutable i32&, product_verified: mutable i32&,
    lease_identity_verified: mutable i32&, lease_exclusive: mutable i32&,
    descendant_inventory_verified: mutable i32&, is_current: mutable i32&,
    lease_protocol: mutable i64&, lease_receipt_bytes: mutable i64&,
    inventory_receipt_bytes: mutable i64&, error: mutable u8&,
    error_capacity: u32) -> i32 can[Blocking.IO]

@link_name("elisa_studio_build_trash_persist_move_intent")
extern studio_build_trash_persist_move_intent(
    handle: i64, operation_id: mutable u8&, operation_id_capacity: u32,
    receipt_bytes: mutable i64&, phase: mutable i32&,
    journal_durable: mutable i32&, operation_id_reserved: mutable i32&,
    error: mutable u8&, error_capacity: u32) -> i32 can[Blocking.IO]

@link_name("elisa_studio_build_trash_commit_move")
extern studio_build_trash_commit_move(
    handle: i64, error: mutable u8&, error_capacity: u32) -> i32 can[Blocking.IO]

@link_name("elisa_studio_build_trash_abort_move")
extern studio_build_trash_abort_move(
    handle: i64, error: mutable u8&, error_capacity: u32) -> i32 can[Blocking.IO]

