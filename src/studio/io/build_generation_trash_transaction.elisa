# Owning Elisa adapter for the native generation-trash transaction calls.
# Every output starts empty/unknown and is decoded only after the native call;
# the caller still applies StudioBuildGenerationTrashPolicy at each boundary.
include "../build_generation_trash_binding_policy.elisa"
include "../state/generation_handle_policy.elisa"
include "../state/generation_receipt_control_policy.elisa"
include "../state/generation_operation_identity_policy.elisa"
include "../state/generation_reconcile_identity_policy.elisa"

module StudioBuildGenerationTrashTransaction:
    public:
        struct MoveIntentResult:
            status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            operation_id_valid: bool
            operation_id_bytes: i64
            phase: StudioBuildGenerationTrashBindingPolicy::DecodedPhase
            journal_durable: StudioBuildGenerationTrashBindingPolicy::DecodedBoolean
            operation_id_reserved: StudioBuildGenerationTrashBindingPolicy::DecodedBoolean
            receipt_bytes: i64

        struct RestoreStartResult:
            status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            evidence: StudioBuildGenerationTrashBindingPolicy::RestoreEvidence
            output_details_valid: bool
            receipt_scope: StudioGenerationReceiptControlPolicy::Evidence
            artifact_id: darray[u8]
            relative_path: darray[u8]

        struct ReconcileResult:
            status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            phase: StudioBuildGenerationTrashBindingPolicy::DecodedPhase
            location: StudioBuildGenerationTrashBindingPolicy::DecodedLocation
            outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome
            artifact_id: darray[u8]
            relative_path: darray[u8]
            output_details_valid: bool

        affine struct ReconcileIdentityResult:
            observation: ReconcileResult
            identity_state: StudioGenerationReconcileIdentityPolicy::State
            identity_details: StudioGenerationReconcileIdentityPolicy::Details

        struct BeginMoveResult:
            status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus
            evidence: StudioBuildGenerationTrashBindingPolicy::BeginEvidence

    private:
        def collect_error(buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()]&, output: mutable darray[u8]&) -> void can[Memory.Allocate]:
            ensure true
            output.clear()
            mutable index: usize = 0
            while index < StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize() and buffer[index] != 0:
                output.push(buffer[index])
                index <- index + 1

        def collect_id(buffer: u8[StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize()]&, output: mutable darray[u8]&) -> bool can[Memory.Allocate]:
            ensure not result or (output.count > 0 and output.count <= StudioBuildGenerationTrashPolicy::Protocol::MAX_ARTIFACT_ID_BYTES.usize())
            output.clear()
            mutable index: usize = 0
            while index < StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize() and buffer[index] != 0:
                output.push(buffer[index])
                index <- index + 1
            mutable valid: bool = index < StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize() and output.count > 0 and output.count <= StudioBuildGenerationTrashPolicy::Protocol::MAX_ARTIFACT_ID_BYTES.usize()
            valid

        def collect_operation_id(buffer: u8[StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize()]&, output: mutable darray[u8]&) -> bool can[Memory.Allocate]:
            ensure not result or (output.count > 0 and output.count <= StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES.usize())
            ensure not result or StudioGenerationOperationIdentityPolicy::valid(output)
            output.clear()
            mutable index: usize = 0
            while index < StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize() and buffer[index] != 0:
                output.push(buffer[index])
                index <- index + 1
            mutable valid: bool = index < StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize() and StudioGenerationOperationIdentityPolicy::valid(output)
            valid

        def collect_path(buffer: u8[StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize()]&, output: mutable darray[u8]&) -> bool can[Memory.Allocate]:
            ensure not result or (output.count > 0 and output.count <= StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES.usize())
            output.clear()
            mutable index: usize = 0
            while index < StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize() and buffer[index] != 0:
                output.push(buffer[index])
                index <- index + 1
            mutable valid: bool = index < StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize() and output.count > 0 and output.count <= StudioBuildGenerationTrashPolicy::Protocol::MAX_PATH_BYTES.usize()
            valid

        def status(raw: i32) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus:
            StudioBuildGenerationTrashBindingPolicy::decode_status(raw)

        def reconcile_identity_outputs_zero(root_device: u64, root_inode: u64,
            receipt_device: u64, receipt_inode: u64, receipt_bytes: i64,
            digest: u8[StudioBuildGenerationTrashNative::Limit::DIGEST_CAPACITY.usize()]&) -> bool:
            return false if root_device != 0 or root_inode != 0 or receipt_device != 0 or receipt_inode != 0 or receipt_bytes != 0
            for byte in digest:
                return false if byte != 0
            true

        def reconcile_identity_status_valid(status_value: StudioBuildGenerationTrashBindingPolicy::DecodedStatus,
            phase_value: StudioBuildGenerationTrashBindingPolicy::DecodedPhase,
            location_value: StudioBuildGenerationTrashBindingPolicy::DecodedLocation,
            output_details_valid: bool) -> bool:
            status_value.known and (status_value.status == StudioBuildGenerationTrashNative::Status.Acquired or status_value.status == StudioBuildGenerationTrashNative::Status.NotMoved or status_value.status == StudioBuildGenerationTrashNative::Status.Restored) and phase_value.known and phase_value.phase != StudioBuildGenerationTrashPolicy::Phase.Unknown and location_value.known and location_value.location != StudioBuildGenerationTrashPolicy::Location.Unknown and output_details_valid

    public:
        def begin_move(build_root: cstr, relative_path: cstr,
                       artifact_kind: i32, artifact_id: cstr,
                       expected_device: u64, expected_inode: u64,
                       expected_product_sha256: cstr, handle: mutable i64&,
                       error_bytes: mutable darray[u8]&) -> BeginMoveResult can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            handle <- 0
            error_bytes.clear()
            mutable native_handle: i64 = 0
            mutable root_verified: i32 = -1
            mutable source_verified: i32 = -1
            mutable manifest_verified: i32 = -1
            mutable product_verified: i32 = -1
            mutable lease_verified: i32 = -1
            mutable lease_exclusive: i32 = -1
            mutable descendants_verified: i32 = -1
            mutable is_current: i32 = -1
            mutable lease_protocol: i64 = -1
            mutable lease_receipt_bytes: i64 = -1
            mutable inventory_receipt_bytes: i64 = -1
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_begin_move(build_root, relative_path,
                    artifact_kind, artifact_id, expected_device, expected_inode,
                    expected_product_sha256, &native_handle, &root_verified,
                    &source_verified, &manifest_verified, &product_verified,
                    &lease_verified, &lease_exclusive, &descendants_verified,
                    &is_current, &lease_protocol, &lease_receipt_bytes,
                    &inventory_receipt_bytes, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            collect_error(error_buffer, error_bytes)
            handle <- native_handle
            evidence: StudioBuildGenerationTrashBindingPolicy::BeginEvidence =
                StudioBuildGenerationTrashBindingPolicy::decode_begin_evidence(
                    code, native_handle, root_verified, source_verified,
                    manifest_verified, product_verified, lease_verified,
                    lease_exclusive, descendants_verified, is_current,
                    lease_protocol, lease_receipt_bytes,
                    inventory_receipt_bytes)
            BeginMoveResult{status: status(code), evidence: evidence}

        def persist_move_intent(handle: i64, operation_id: mutable darray[u8]&,
                                error_bytes: mutable darray[u8]&) -> MoveIntentResult can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            ensure not result.operation_id_valid or (result.operation_id_bytes > 0 and
                result.operation_id_bytes <= StudioBuildGenerationTrashPolicy::Protocol::MAX_OPERATION_ID_BYTES)
            operation_id.clear()
            error_bytes.clear()
            mutable id_buffer: u8[StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize()] = zeroed
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            mutable receipt_bytes: i64 = 0
            mutable phase_raw: i32 = StudioBuildGenerationTrashNative::Phase.Unknown.i32()
            mutable durable_raw: i32 = 0
            mutable reserved_raw: i32 = 0
            id_ptr: mutable u8& = (&id_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_persist_move_intent(handle, id_ptr,
                    StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.u32(),
                    &receipt_bytes, &phase_raw, &durable_raw, &reserved_raw,
                    error_ptr, StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            operation_valid: bool = collect_operation_id(id_buffer, operation_id)
            collect_error(error_buffer, error_bytes)
            mutable decoded_status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = status(code)
            if code == StudioBuildGenerationTrashNative::Status.Acquired.i32() and not operation_valid:
                decoded_status <- status(-1)
            MoveIntentResult{status: decoded_status, operation_id_valid: operation_valid, operation_id_bytes: operation_id.count.i64(), phase: StudioBuildGenerationTrashBindingPolicy::decode_phase(phase_raw), journal_durable: StudioBuildGenerationTrashBindingPolicy::decode_boolean(durable_raw), operation_id_reserved: StudioBuildGenerationTrashBindingPolicy::decode_boolean(reserved_raw), receipt_bytes: receipt_bytes}

        def commit_move(handle: i64, error_bytes: mutable darray[u8]&) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            error_bytes.clear()
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_commit_move(handle, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            collect_error(error_buffer, error_bytes)
            status(code)

        def abort_move(handle: i64, error_bytes: mutable darray[u8]&) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            error_bytes.clear()
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_abort_move(handle, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            collect_error(error_buffer, error_bytes)
            status(code)

        def begin_restore(build_root: cstr, operation_id: cstr,
                          handle: mutable i64&, error_bytes: mutable darray[u8]&) -> RestoreStartResult can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            ensure not StudioBuildGenerationTrashBindingPolicy::restore_evidence_admitted(result.evidence) or (result.status.known and result.status.status == StudioBuildGenerationTrashNative::Status.Acquired and result.output_details_valid)
            handle <- 0
            error_bytes.clear()
            mutable native_handle: i64 = 0
            mutable phase_raw: i32 = StudioBuildGenerationTrashNative::Phase.Unknown.i32()
            mutable durable_raw: i32 = 0
            mutable artifact_id_buffer: u8[StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize()] = zeroed
            mutable path_buffer: u8[StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize()] = zeroed
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            artifact_id_ptr: mutable u8& = (&artifact_id_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            path_ptr: mutable u8& = (&path_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_begin_restore(build_root, operation_id,
                    &native_handle, &phase_raw, &durable_raw, artifact_id_ptr,
                    StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.u32(),
                    path_ptr, StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.u32(),
                    error_ptr, StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            mutable artifact_id: darray[u8] = []
            mutable relative_path: darray[u8] = []
            mutable id_valid: bool = collect_id(artifact_id_buffer, artifact_id)
            mutable path_valid: bool = collect_path(path_buffer, relative_path)
            collect_error(error_buffer, error_bytes)
            mutable decoded_status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = status(code)
            mutable receipt_scope: StudioGenerationReceiptControlPolicy::Evidence = StudioGenerationReceiptControlPolicy::Evidence.Unknown
            if code == StudioBuildGenerationTrashNative::Status.Acquired.i32() and native_handle > 0:
                receipt_scope <- query_receipt_scope(native_handle)
            if code == StudioBuildGenerationTrashNative::Status.Acquired.i32() and not (id_valid and path_valid):
                decoded_status <- status(-1)
            if code == StudioBuildGenerationTrashNative::Status.Acquired.i32() and receipt_scope == StudioGenerationReceiptControlPolicy::Evidence.Unknown:
                decoded_status <- status(-1)
            handle <- native_handle
            evidence: StudioBuildGenerationTrashBindingPolicy::RestoreEvidence =
                StudioBuildGenerationTrashBindingPolicy::decode_restore_evidence(
                    code if receipt_scope != StudioGenerationReceiptControlPolicy::Evidence.Unknown else -1, native_handle, phase_raw, durable_raw, id_valid and path_valid,
                    artifact_id.count.i64(), relative_path.count.i64())
            RestoreStartResult{status: decoded_status, evidence: evidence, output_details_valid: id_valid and path_valid, receipt_scope: receipt_scope, artifact_id: artifact_id, relative_path: relative_path}

        def persist_restore_intent(handle: i64,
                                   receipt_bytes: mutable i64&,
                                   error_bytes: mutable darray[u8]&) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            receipt_bytes <- 0
            error_bytes.clear()
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_persist_restore_intent(handle,
                    receipt_bytes, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            collect_error(error_buffer, error_bytes)
            status(code)

        def commit_restore(handle: i64,
                           error_bytes: mutable darray[u8]&) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            error_bytes.clear()
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_commit_restore(handle, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            collect_error(error_buffer, error_bytes)
            status(code)

        def reconcile(build_root: cstr, operation_id: cstr,
                      error_bytes: mutable darray[u8]&) -> ReconcileResult can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            ensure ((result.outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Quarantined or result.outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.RestorePending or result.outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.NotMoved or result.outcome == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Restored) implies result.output_details_valid)
            error_bytes.clear()
            mutable location_raw: i32 = StudioBuildGenerationTrashNative::Location.Unknown.i32()
            mutable phase_raw: i32 = StudioBuildGenerationTrashNative::Phase.Unknown.i32()
            mutable artifact_id_buffer: u8[StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize()] = zeroed
            mutable path_buffer: u8[StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize()] = zeroed
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            artifact_id_ptr: mutable u8& = (&artifact_id_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            path_ptr: mutable u8& = (&path_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_reconcile(build_root, operation_id,
                    &location_raw, &phase_raw, artifact_id_ptr,
                    StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.u32(),
                    path_ptr, StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.u32(),
                    error_ptr, StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            mutable artifact_id: darray[u8] = []
            mutable relative_path: darray[u8] = []
            id_valid: bool = collect_id(artifact_id_buffer, artifact_id)
            path_valid: bool = collect_path(path_buffer, relative_path)
            collect_error(error_buffer, error_bytes)
            decoded_status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = status(code)
            decoded_phase: StudioBuildGenerationTrashBindingPolicy::DecodedPhase =
                StudioBuildGenerationTrashBindingPolicy::decode_phase(phase_raw)
            decoded_location: StudioBuildGenerationTrashBindingPolicy::DecodedLocation =
                StudioBuildGenerationTrashBindingPolicy::decode_location(location_raw)
            mutable outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome =
                StudioBuildGenerationTrashBindingPolicy::recovery_outcome(
                    decoded_status, decoded_phase, decoded_location)
            if not (id_valid and path_valid):
                outcome <- StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown
            ReconcileResult{status: decoded_status, phase: decoded_phase, location: decoded_location, outcome: outcome, artifact_id: artifact_id, relative_path: relative_path, output_details_valid: id_valid and path_valid}

        # Additive identity-bearing entry point. The native facts are accepted
        # only with exact bounded output extents and valid reconciliation rows.
        def reconcile_with_identity[@r](build_root: cstr, operation_id: cstr,
                                    error_bytes: mutable darray[u8]& @r) -> ReconcileIdentityResult @r can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            ensure result.identity_state != StudioGenerationReconcileIdentityPolicy::State.Verified or (result.observation.output_details_valid and reconcile_identity_status_valid(result.observation.status, result.observation.phase, result.observation.location, result.observation.output_details_valid))
            ensure result.observation.status.status != StudioBuildGenerationTrashNative::Status.ReleaseUncertain or result.identity_state != StudioGenerationReconcileIdentityPolicy::State.Verified
            error_bytes.clear()
            mutable location_raw: i32 = StudioBuildGenerationTrashNative::Location.Unknown.i32()
            mutable phase_raw: i32 = StudioBuildGenerationTrashNative::Phase.Unknown.i32()
            mutable artifact_id_buffer: u8[StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.usize()] = zeroed
            mutable path_buffer: u8[StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.usize()] = zeroed
            mutable root_device: u64 = 0
            mutable root_inode: u64 = 0
            mutable receipt_device: u64 = 0
            mutable receipt_inode: u64 = 0
            mutable receipt_bytes: i64 = 0
            mutable receipt_digest_buffer: u8[StudioBuildGenerationTrashNative::Limit::DIGEST_CAPACITY.usize()] = zeroed
            mutable identity_valid_raw: i32 = -1
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            artifact_id_ptr: mutable u8& = (&artifact_id_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            path_ptr: mutable u8& = (&path_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            digest_ptr: mutable u8& = (&receipt_digest_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_reconcile_identity_v1(build_root,
                    operation_id, &location_raw, &phase_raw, artifact_id_ptr,
                    StudioBuildGenerationTrashNative::Limit::ID_CAPACITY.u32(),
                    path_ptr, StudioBuildGenerationTrashNative::Limit::PATH_CAPACITY.u32(),
                    &root_device, &root_inode, &receipt_device, &receipt_inode,
                    &receipt_bytes, digest_ptr,
                    StudioBuildGenerationTrashNative::Limit::DIGEST_CAPACITY.u32(),
                    &identity_valid_raw, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            mutable artifact_id: darray[u8] @r = []
            mutable relative_path: darray[u8] @r = []
            id_valid: bool = collect_id(artifact_id_buffer, artifact_id)
            path_valid: bool = collect_path(path_buffer, relative_path)
            collect_error(error_buffer, error_bytes)
            decoded_status: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = status(code)
            decoded_phase: StudioBuildGenerationTrashBindingPolicy::DecodedPhase = StudioBuildGenerationTrashBindingPolicy::decode_phase(phase_raw)
            decoded_location: StudioBuildGenerationTrashBindingPolicy::DecodedLocation = StudioBuildGenerationTrashBindingPolicy::decode_location(location_raw)
            mutable outcome: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome = StudioBuildGenerationTrashBindingPolicy::recovery_outcome(decoded_status, decoded_phase, decoded_location)
            if not (id_valid and path_valid):
                outcome <- StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown
            observation: ReconcileResult = ReconcileResult{status: decoded_status, phase: decoded_phase, location: decoded_location, outcome: outcome, artifact_id: artifact_id, relative_path: relative_path, output_details_valid: id_valid and path_valid}
            mutable digest_extent_valid: bool = receipt_digest_buffer[StudioBuildGenerationTrashNative::Limit::DIGEST_CAPACITY.usize() - 1] == 0
            mutable digest_index: usize = 0
            while digest_index < StudioGenerationReconcileIdentityPolicy::Limit::SHA256_BYTES.usize() and receipt_digest_buffer[digest_index] != 0:
                digest_index <- digest_index + 1
            digest_extent_valid <- digest_extent_valid and digest_index == StudioGenerationReconcileIdentityPolicy::Limit::SHA256_BYTES.usize()
            context_valid: bool = reconcile_identity_status_valid(observation.status, observation.phase, observation.location, observation.output_details_valid)
            details_valid: bool = digest_extent_valid and StudioGenerationReconcileIdentityPolicy::verified(root_device, root_inode, receipt_device, receipt_inode, receipt_bytes, receipt_digest_buffer)
            identity_state: StudioGenerationReconcileIdentityPolicy::State = StudioGenerationReconcileIdentityPolicy::decode_state(identity_valid_raw, reconcile_identity_outputs_zero(root_device, root_inode, receipt_device, receipt_inode, receipt_bytes, receipt_digest_buffer), context_valid, details_valid)
            identity_details: StudioGenerationReconcileIdentityPolicy::Details = StudioGenerationReconcileIdentityPolicy::decode_details(identity_state, root_device, root_inode, receipt_device, receipt_inode, receipt_bytes, receipt_digest_buffer)
            ReconcileIdentityResult{observation: move observation, identity_state: identity_state, identity_details: identity_details}

        def query_receipt_scope(handle: i64) -> StudioGenerationReceiptControlPolicy::Evidence can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
            mutable raw_scope: i32 = 0
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_receipt_scope(handle, &raw_scope)
            StudioGenerationReceiptControlPolicy::decode_scope(raw_scope, code == StudioBuildGenerationTrashNative::Status.Acquired.i32())

        def close(handle: i64) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_close(handle)
            status(code)

        # This compares exact reviewed controls under the handle's locks.
        # Successful admission is rechecked by native intent/move operations.
        def validate_reviewed(handle: i64, manifest_sha256: cstr,
                              input_record_sha256: cstr, inventory_sha256: cstr,
                              lease_sha256: cstr, error_bytes: mutable darray[u8]&) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Memory.Allocate, Unsafe{PointerCast, RawExtern}, Global{Read, Write}]:
            error_bytes.clear()
            mutable error_buffer: u8[StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.usize()] = zeroed
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            can Unsafe.RawExtern:
                code <- studio_build_trash_validate_reviewed(handle, manifest_sha256,
                    input_record_sha256, inventory_sha256, lease_sha256, error_ptr,
                    StudioBuildGenerationTrashNative::Limit::ERROR_CAPACITY.u32())
            collect_error(error_buffer, error_bytes)
            status(code)

        # UI/background owners use this entry point and retain the token when
        # native close refuses admission. ReleaseUncertain consumes the token
        # but still requires recovery before another mutation.
        def close_owned(handle: mutable i64&) -> StudioBuildGenerationTrashBindingPolicy::DecodedStatus can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
            requires handle >= 0
            ensure handle >= 0
            decoded: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = close(handle)
            handle <- StudioGenerationHandlePolicy::remaining(handle, decoded)
            decoded
