# Bounded native scan ABI. Snapshot handles are generation-tagged and must be closed.
module StudioBuildGenerationCandidateProviderNative:
    public:
        const module Limit:
            ID_CAPACITY: i32 = 97
            PATH_CAPACITY: i32 = 4096
            DIGEST_CAPACITY: i32 = 65
            ERROR_CAPACITY: i32 = 512
            MAX_ROWS: i32 = 512
            MAX_RETENTION_DAYS: i64 = 36500

@link_name("elisa_studio_build_candidates_open")
@callconv(c)
extern build_candidates_open(root: cstr, retention_days: i64, snapshot: mutable i64&,
    outcome: mutable i32&, row_count: mutable i64&, refusal_code: mutable i64&,
    error_buffer: mutable u8&, error_capacity: u32) -> i32 can[Blocking.IO, Memory.Allocate]

@link_name("elisa_studio_build_candidates_row")
@callconv(c)
extern build_candidates_row(snapshot: i64, index: i64, artifact: mutable i32&,
    phase: mutable i32&, protection: mutable i32&, device: mutable i64&,
    inode: mutable i64&, build_device: mutable i64&, build_inode: mutable i64&,
    revision: mutable i64&, creation_kind: mutable i32&, age_days: mutable i64&,
    age_known: mutable i32&,
    retention_days: mutable i64&, size_bytes: mutable i64&, size_known: mutable i32&,
    product_kind: mutable i32&, artifact_id: mutable u8&, id_capacity: u32,
    relative_path: mutable u8&, path_capacity: u32, creation_digest: mutable u8&,
    latest_digest: mutable u8&, observed_digest: mutable u8&, manifest_digest: mutable u8&,
    input_record_digest: mutable u8&, product_digest: mutable u8&, inventory_digest: mutable u8&,
    lease_digest: mutable u8&, error_capacity: u32) -> i32 can Blocking.IO

# Facts are returned from the exact same immutable row token. Kind 1 is an
# aggregate native attestation of the verified failed creation chain; mutation
# still needs its own retained-lock admission.
@link_name("elisa_studio_build_candidates_incomplete")
@callconv(c)
extern build_candidates_incomplete(snapshot: i64, index: i64, evidence_kind: mutable i32&,
    failure_exit_status: mutable i32&, lease_device: mutable i64&, lease_inode: mutable i64&,
    builder_inactive_verified: mutable i32&, observed_tree_verified: mutable i32&) -> i32 can Blocking.IO

@link_name("elisa_studio_build_candidates_close")
@callconv(c)
extern build_candidates_close(snapshot: i64) -> i32 can[Blocking.IO, Memory.Release]
