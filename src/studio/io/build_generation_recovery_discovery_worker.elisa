# Bounded disk discovery runs off the UI thread. Names are candidates only;
# each selected operation still requires a separate native reconciliation.
include "../../../build/generated/studio_runtime.elisa"
include "../worker_path_capture.elisa"
include "build_generation_recovery_discovery.elisa"

module StudioBuildGenerationRecoveryDiscoveryWorker:
    public:
        affine struct Job:
            ticket: i64
            root: StudioWorkerPathCapture::Path

        affine struct Result:
            ticket: i64
            root: darray[u8]
            snapshot: StudioBuildGenerationRecoveryDiscovery::Snapshot

        def scan(job: Job) -> Result can[Blocking.IO, Memory.Allocate, Unsafe.PointerCast]:
            ticket: i64 = job.ticket
            mutable root: darray[u8] = StudioWorkerPathCapture::restore(&job.root)
            mutable returned_root: darray[u8] = []
            returned_root.extend(root)
            snapshot: StudioBuildGenerationRecoveryDiscovery::Snapshot = StudioBuildGenerationRecoveryDiscovery::scan(root)
            Result{ticket: ticket, root: returned_root, snapshot: snapshot}

def generation_recovery_discovery_job(job: StudioBuildGenerationRecoveryDiscoveryWorker::Job) -> StudioBuildGenerationRecoveryDiscoveryWorker::Result can[Blocking.IO, Memory.Allocate, Unsafe.PointerCast]:
    StudioBuildGenerationRecoveryDiscoveryWorker::scan(move job)
