# Deterministic complete manifest documents are review version tokens.
# Tokens include every persisted field and record order, not just selected rows.
include "storage_manifest.elisa"

module StudioStorageManifestVersion:
    public:
        def capture(entries: darray[StudioStorageManifest::Entry]&, verified: bool) -> darray[u8] can Memory.Allocate:
            return [] if not verified
            mutable version: darray[u8] = []
            return [] if not StudioStorageManifest::encode(entries, &version)
            version

        def matches(expected: darray[u8]&, entries: darray[StudioStorageManifest::Entry]&, verified: bool) -> bool can Memory.Allocate:
            return false if expected.count == 0
            current: darray[u8] = capture(entries, verified)
            return false if current.count == 0
            # The manifest's byte comparator has no path-format precondition.
            StudioStorageManifest::same_path(expected, current)
