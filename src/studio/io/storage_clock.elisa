# macOS time_t is signed 64-bit. Using an output reference avoids nullable
# pointer ABI assumptions. Eligibility treats failed or invalid time as unknown.
@link_name("time")
extern studio_storage_time(seconds: mutable i64&) -> i64 can[Blocking.IO]

module StudioStorageClock:
    public:
        def unix_seconds() -> i64 can Blocking.IO:
            mutable seconds: i64 = -1
            returned: i64 = studio_storage_time(&seconds)
            return -1 if returned < 0 or returned != seconds
            seconds
