include "../export_recovery_path_policy.elisa"
include "export_recovery_bytes.elisa"
include "export_recovery_journal.elisa"
include "../app/export_publisher.elisa"

# Native directory creation is trusted host IO. Callers supply the selected,
# canonical build directory; derived recovery files never belong beside sources.
module StudioExportRecoveryStore:
    public:
        const enum Failure of i64:
            InvalidBuildPath = 0
            AllocationFailed = 1
            CreationFailed = 2

        enum Creation:
            Rejected(reason: Failure)
            Created(path: cstr)

        # Closed names prevent traversal and accidental writes to unrelated
        # files. Each returned path is separately owned by the caller.
        const enum Record of i64:
            JsonReport = 0
            TextReport = 1
            Journal = 2
            OutputSnapshot = 3

        # Use only a directory returned by create. Existing record files are
        # never replaced. The caller must retain this directory on any failure
        # and distinguish published bytes from directory durability.
        def write_record(directory: cstr, record: Record, bytes: darray[u8]&) -> StudioPublicationDurabilityPolicy::Result:
            limit: i64 = record_byte_limit(record)
            return StudioPublicationDurabilityPolicy::Result.NotPublished if not StudioExportRecoveryBudgetPolicy::append_admitted(0, bytes.count.i64(), limit)
            if record_path(directory, record) is destination:
                status: StudioPublicationDurabilityPolicy::Result = StudioExportPublisher::write_new_sidecar_with_status(destination, bytes)
                release_path(destination)
                return status
            StudioPublicationDurabilityPolicy::Result.NotPublished

        # Reads the private staging file without parsing or reserializing it.
        # This establishes a stored byte snapshot, not yet a checked binding
        # between that snapshot and a subsequently published destination.
        def snapshot_output(directory: cstr, staging: cstr) -> StudioPublicationDurabilityPolicy::Result:
            mutable bytes: darray[u8] = []
            return StudioPublicationDurabilityPolicy::Result.NotPublished if not StudioExportRecoveryBytes::read(staging, StudioExportRecoveryBudgetPolicy::Capacity::OUTPUT_BYTES, &bytes)
            return StudioPublicationDurabilityPolicy::Result.NotPublished if bytes.count == 0
            write_record(directory, Record.OutputSnapshot, bytes)

        def write_prepared_journal(directory: cstr, record: StudioExportRecoveryJournal::Record&) -> StudioPublicationDurabilityPolicy::Result:
            return StudioPublicationDurabilityPolicy::Result.NotPublished if record.observed != StudioExportRecoveryStagePolicy::Stage.Prepared or record.durable != StudioExportRecoveryStagePolicy::Stage.Prepared
            mutable bytes: darray[u8] = []
            return StudioPublicationDurabilityPolicy::Result.NotPublished if not StudioExportRecoveryJournal::encode(record, &bytes)
            write_record(directory, Record.Journal, bytes)

        # Only advances a strictly decoded journal of the same export. Never
        # adopt an unknown/corrupt file or downgrade published stages. Caller
        # provides observed native facts and guards owned-directory races.
        def update_journal(directory: cstr, record: StudioExportRecoveryJournal::Record&) -> StudioPublicationDurabilityPolicy::Result:
            mutable bytes: darray[u8] = []
            return StudioPublicationDurabilityPolicy::Result.NotPublished if not StudioExportRecoveryJournal::encode(record, &bytes)
            if record_path(directory, Record.Journal) is destination:
                mutable previous_bytes: darray[u8] = []
                mutable previous: StudioExportRecoveryJournal::Record = record
                mutable admitted: bool = StudioExportRecoveryBytes::read(destination, StudioExportRecoveryBudgetPolicy::Capacity::JOURNAL_BYTES, &previous_bytes)
                if admitted:
                    admitted <- StudioExportRecoveryJournal::decode(previous_bytes, &previous)
                if admitted:
                    admitted <- StudioExportRecoveryJournal::same_binding(&previous, record) and StudioExportRecoveryStagePolicy::transition_admitted(previous.observed.i64(), record.observed.i64()) and StudioExportRecoveryStagePolicy::transition_admitted(previous.durable.i64(), record.durable.i64())
                mutable status: StudioPublicationDurabilityPolicy::Result = StudioPublicationDurabilityPolicy::Result.NotPublished
                if admitted:
                    status <- StudioExportPublisher::write_sidecar_with_status(destination, bytes)
                release_path(destination)
                return status
            StudioPublicationDurabilityPolicy::Result.NotPublished

        def record_path(directory: cstr, record: Record) -> cstr? can[Memory.Allocate, Unsafe.PointerCast]:
            leaf: cstr = record_name(record)
            mutable directory_length: usize = 0
            while directory_length < StudioExportRecoveryPathPolicy::Capacity::PATH_BYTES.usize() and directory[directory_length] != 0:
                directory_length <- directory_length + 1
            mutable leaf_length: usize = 0
            while leaf[leaf_length] != 0:
                leaf_length <- leaf_length + 1
            return null if not StudioExportRecoveryPathPolicy::child_path_admitted(directory_length.i64(), leaf_length.i64())
            mutable buffer: u8[4096] = zeroed
            for index in 0..<directory_length |buffer, directory, index|:
                buffer[index] <- directory[index]
            buffer[directory_length] <- 47
            for index in 0..<leaf_length |buffer, leaf, index, directory_length|:
                buffer[directory_length + 1 + index] <- leaf[index]
            recovery_strdup((&buffer[0]).cast[cstr])

        # mkdtemp creates a private, unique directory. On success the caller owns
        # path and releases only its memory with release_path; releasing the
        # handle never removes recovery evidence from disk.
        def create(build_directory: cstr) -> Creation can[Blocking.IO, Memory.Allocate, Memory.Release, Unsafe.PointerCast]:
            mutable length: usize = 0
            while length < StudioExportRecoveryPathPolicy::Capacity::PATH_BYTES.usize() and build_directory[length] != 0:
                length <- length + 1
            return Creation.Rejected(Failure.InvalidBuildPath) if not StudioExportRecoveryPathPolicy::build_path_admitted(length.i64())
            mutable template: u8[4096] = zeroed
            for index in 0..<length |template, build_directory, index|:
                template[index] <- build_directory[index]
            suffix: cstr = "/.mocap-export-recovery-XXXXXX"
            for index in 0..<StudioExportRecoveryPathPolicy::Capacity::DIRECTORY_SUFFIX_BYTES.usize() |template, suffix, index, length|:
                template[length + index] <- suffix[index]
            if recovery_strdup((&template[0]).cast[cstr]) is retained:
                if recovery_mkdtemp(retained.cast[u8&]) is created:
                    return Creation.Created(retained)
                recovery_free(retained)
                return Creation.Rejected(Failure.CreationFailed)
            Creation.Rejected(Failure.AllocationFailed)

        def release_path(path: cstr) -> void can Memory.Release:
            recovery_free(path)

    private:
        def record_byte_limit(record: Record) -> i64:
            return StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES if record == Record.JsonReport or record == Record.TextReport
            return StudioExportRecoveryBudgetPolicy::Capacity::JOURNAL_BYTES if record == Record.Journal
            return StudioExportRecoveryBudgetPolicy::Capacity::OUTPUT_BYTES if record == Record.OutputSnapshot
            0

        def record_name(record: Record) -> cstr:
            return "report.json" if record == Record.JsonReport
            return "report.txt" if record == Record.TextReport
            return "journal.txt" if record == Record.Journal
            return "output.glb" if record == Record.OutputSnapshot
            ""

        @link_name("strdup")
        extern recovery_strdup(path: cstr) -> cstr? can[Memory.Allocate]
        @link_name("mkdtemp")
        extern recovery_mkdtemp(template: u8&) -> cstr? can[Blocking.IO]
        @link_name("free")
        extern recovery_free(path: cstr) -> void can[Memory.Release]
