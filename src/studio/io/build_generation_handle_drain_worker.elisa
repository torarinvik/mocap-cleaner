include "build_generation_move_worker.elisa"
include "build_generation_restore_worker.elisa"

# Transfer the entire reply into cleanup, not a copied native token. Releasing
# ownership does not establish a recovery location or authorize another move.
module StudioBuildGenerationHandleDrainWorker:
    public:
        affine struct MoveJob:
            reply: StudioBuildGenerationMoveWorker::Result

        affine struct RestoreJob:
            reply: StudioBuildGenerationRestoreWorker::Result

        def drain_move(job: MoveJob) -> StudioBuildGenerationMoveWorker::Result can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
            ensure not result.recoverable and result.recovery == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown
            mutable reply: StudioBuildGenerationMoveWorker::Result = move job.reply
            mutable handle: i64 = reply.remaining_handle
            mutable release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = reply.release_status
            if handle > 0:
                release <- StudioBuildGenerationTrashTransaction::close_owned(&handle)
            StudioBuildGenerationMoveWorker::Result{ticket: reply.ticket, recoverable: false, remaining_handle: handle, commit_status: reply.commit_status, release_status: release, recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown, operation_id: reply.operation_id, operation_id_bytes: reply.operation_id_bytes, explanation: reply.explanation, explanation_bytes: reply.explanation_bytes, explanation_truncated: reply.explanation_truncated}

        def drain_restore(job: RestoreJob) -> StudioBuildGenerationRestoreWorker::Result can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
            ensure not result.restored and result.recovery == StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown
            mutable reply: StudioBuildGenerationRestoreWorker::Result = move job.reply
            mutable handle: i64 = reply.remaining_handle
            mutable release: StudioBuildGenerationTrashBindingPolicy::DecodedStatus = reply.release_status
            if handle > 0:
                release <- StudioBuildGenerationTrashTransaction::close_owned(&handle)
            StudioBuildGenerationRestoreWorker::Result{ticket: reply.ticket, restored: false, receipt_scope: reply.receipt_scope, remaining_handle: handle, commit_status: reply.commit_status, release_status: release, recovery: StudioBuildGenerationTrashBindingPolicy::RecoveryOutcome.Unknown, explanation: reply.explanation, explanation_bytes: reply.explanation_bytes, explanation_truncated: reply.explanation_truncated}

def generation_move_handle_drain_job(job: StudioBuildGenerationHandleDrainWorker::MoveJob) -> StudioBuildGenerationMoveWorker::Result can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
    StudioBuildGenerationHandleDrainWorker::drain_move(move job)

def generation_restore_handle_drain_job(job: StudioBuildGenerationHandleDrainWorker::RestoreJob) -> StudioBuildGenerationRestoreWorker::Result can[Blocking.IO, Unsafe.RawExtern, Global{Read, Write}]:
    StudioBuildGenerationHandleDrainWorker::drain_restore(move job)
