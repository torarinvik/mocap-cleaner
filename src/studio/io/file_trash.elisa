# Field-based macOS Trash ABI. The native adapter owns filesystem identity
# checks; this wrapper converts its bounded C strings into Elisa receipt data.
include "storage_manifest.elisa"

const STUDIO_TRASH_PATH_CAPACITY: usize = 4096
const STUDIO_TRASH_ERROR_CAPACITY: usize = 512

@link_name("elisa_file_trash_move_fields")
extern studio_trash_move_fields(build_root: cstr, candidate: cstr,
    original_path: mutable u8&, trashed_path: mutable u8&, path_capacity: i32,
    device: mutable i64&, inode: mutable i64&, size_bytes: mutable i64&,
    modified_seconds: mutable i64&, modified_nanoseconds: mutable i64&,
    output_error: mutable u8&, error_capacity: i32) -> i32 can[Blocking.IO]

@link_name("elisa_file_trash_move_checked_fields")
extern studio_trash_move_checked_fields(build_root: cstr, candidate: cstr,
    expected_original_path: cstr, expected_device: i64, expected_inode: i64,
    expected_size_bytes: i64, expected_modified_seconds: i64,
    expected_modified_nanoseconds: i64,
    original_path: mutable u8&, trashed_path: mutable u8&, path_capacity: i32,
    device: mutable i64&, inode: mutable i64&, size_bytes: mutable i64&,
    modified_seconds: mutable i64&, modified_nanoseconds: mutable i64&,
    output_error: mutable u8&, error_capacity: i32) -> i32 can[Blocking.IO]

@link_name("elisa_file_trash_restore_fields")
extern studio_trash_restore_fields(build_root: cstr, original_path: cstr,
    trashed_path: cstr, device: i64, inode: i64, size_bytes: i64,
    modified_seconds: i64, modified_nanoseconds: i64,
    output_error: mutable u8&, error_capacity: i32) -> i32 can[Blocking.IO]

@link_name("elisa_file_trash_identity_fields")
extern studio_trash_identity_fields(build_root: cstr, candidate: cstr,
    canonical_path: mutable u8&, path_capacity: i32, device: mutable i64&,
    inode: mutable i64&, size_bytes: mutable i64&,
    modified_seconds: mutable i64&, modified_nanoseconds: mutable i64&,
    output_error: mutable u8&, error_capacity: i32) -> i32 can[Blocking.IO]

@link_name("elisa_file_trash_reconcile_fields")
extern studio_trash_reconcile_fields(build_root: cstr, original_path: cstr,
    device: i64, inode: i64, size_bytes: i64,
    modified_seconds: i64, modified_nanoseconds: i64,
    trashed_path: mutable u8&, path_capacity: i32,
    output_error: mutable u8&, error_capacity: i32) -> i32 can[Blocking.IO]

module StudioFileTrash:
    public:
        # Register only artifacts whose creation was completed by Studio.
        # This function captures their canonical path and current identity;
        # callers must persist the result before offering it for cleanup.
        def snapshot(build_root: cstr, candidate: cstr, kind: i64,
                     entry: mutable StudioStorageManifest::Entry&,
                     message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            if kind < StudioStorageReceiptPolicy::Kind.Recovery.i64() or kind >= StudioStorageReceiptPolicy::Limit::KIND_COUNT:
                explanation: sview = "Studio cannot manage this artifact type."
                for byte in explanation:
                    message.push(byte)
                return false
            mutable canonical: u8[4096] = zeroed
            mutable error_buffer: u8[512] = zeroed
            mutable device: i64 = 0
            mutable inode: i64 = 0
            mutable size_bytes: i64 = 0
            mutable modified_seconds: i64 = 0
            mutable modified_nanoseconds: i64 = 0
            canonical_ptr: mutable u8& = (&canonical[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            code: i32 = studio_trash_identity_fields(build_root, candidate,
                canonical_ptr, STUDIO_TRASH_PATH_CAPACITY.i32(), &device, &inode,
                &size_bytes, &modified_seconds, &modified_nanoseconds,
                error_ptr, STUDIO_TRASH_ERROR_CAPACITY.i32())
            mutable error_index: usize = 0
            while error_index < STUDIO_TRASH_ERROR_CAPACITY and error_buffer[error_index] != 0:
                message.push(error_buffer[error_index])
                error_index <- error_index + 1
            return false if code != 0
            mutable path: darray[u8] = []
            mutable path_index: usize = 0
            while path_index < STUDIO_TRASH_PATH_CAPACITY and canonical[path_index] != 0:
                path.push(canonical[path_index])
                path_index <- path_index + 1
            next: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
                state: StudioStorageManifest::REGISTERED, kind: kind,
                device: device, inode: inode, size_bytes: size_bytes,
                modified_seconds: modified_seconds,
                modified_nanoseconds: modified_nanoseconds,
                original_path: path, trashed_path: []}
            if not StudioStorageManifest::valid(next):
                explanation: sview = "The file identity is outside the supported storage range."
                message.clear()
                for byte in explanation:
                    message.push(byte)
                return false
            entry <- next
            true

        # Byte-path form used by the manifest inventory. Its local C string
        # never escapes this call, and embedded NUL/oversized paths fail closed.
        def snapshot_path(build_root: cstr, candidate: darray[u8]&, kind: i64,
                          entry: mutable StudioStorageManifest::Entry&,
                          message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            return false if candidate.count == 0 or candidate.count >= STUDIO_TRASH_PATH_CAPACITY
            for byte in candidate:
                return false if byte == 0
            mutable path: u8[4096] = zeroed
            for index in 0..<candidate.count |candidate, path|:
                path[index] <- candidate[index]
            pointer: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
            snapshot(build_root, pointer, kind, entry, message)

        # Recover a move receipt after a process interruption between the OS
        # Trash move and manifest receipt persistence. The engine only searches
        # native Trash for this exact saved identity; it never scans build/.
        def reconcile(build_root: cstr, record: StudioStorageManifest::Entry,
                      recovered: mutable StudioStorageManifest::Entry&,
                      message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            return false if not StudioStorageManifest::valid(record)
            return false if record.original_path.count >= STUDIO_TRASH_PATH_CAPACITY
            mutable original: u8[4096] = zeroed
            mutable trashed: u8[4096] = zeroed
            mutable error_buffer: u8[512] = zeroed
            for index in 0..<record.original_path.count |record, original|:
                original[index] <- record.original_path[index]
            original_path: cstr = (&original[0]).cast[cstr] can Unsafe.PointerCast
            trashed_ptr: mutable u8& = (&trashed[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            code: i32 = studio_trash_reconcile_fields(build_root, original_path,
                record.device, record.inode, record.size_bytes,
                record.modified_seconds, record.modified_nanoseconds,
                trashed_ptr, STUDIO_TRASH_PATH_CAPACITY.i32(),
                error_ptr, STUDIO_TRASH_ERROR_CAPACITY.i32())
            mutable error_index: usize = 0
            while error_index < STUDIO_TRASH_ERROR_CAPACITY and error_buffer[error_index] != 0:
                message.push(error_buffer[error_index])
                error_index <- error_index + 1
            return false if code != 0
            mutable trash_path: darray[u8] = []
            mutable path_index: usize = 0
            while path_index < STUDIO_TRASH_PATH_CAPACITY and trashed[path_index] != 0:
                trash_path.push(trashed[path_index])
                path_index <- path_index + 1
            next: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
                state: StudioStorageManifest::IN_TRASH, kind: record.kind,
                device: record.device, inode: record.inode,
                size_bytes: record.size_bytes,
                modified_seconds: record.modified_seconds,
                modified_nanoseconds: record.modified_nanoseconds,
                original_path: record.original_path, trashed_path: trash_path}
            if not StudioStorageManifest::valid(next):
                message.clear()
                explanation: sview = "The Trash location could not be represented safely."
                for byte in explanation:
                    message.push(byte)
                return false
            recovered <- next
            true

        # Legacy callers capture the identity during the native operation.
        def move(build_root: cstr, candidate: cstr, kind: i64,
                 record: mutable StudioStorageManifest::Entry&,
                 message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            move_record(build_root, candidate, kind, null, record, message)

        # Cleanup binds the native operation to the durable identity reviewed
        # by the user. A stale review is rejected before the file is moved.
        def move_checked(build_root: cstr, candidate: cstr,
                         expected: StudioStorageManifest::Entry,
                         record: mutable StudioStorageManifest::Entry&,
                         message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            if expected.state != StudioStorageManifest::REGISTERED or not StudioStorageManifest::valid(expected):
                explanation: sview = "The reviewed file identity is incomplete or invalid."
                for byte in explanation:
                    message.push(byte)
                return false
            move_record(build_root, candidate, expected.kind, expected, record, message)

        # Inventory actions use the canonical path in the reviewed entry,
        # avoiding an independent candidate string that could name another file.
        def move_entry(build_root: cstr, expected: StudioStorageManifest::Entry,
                       record: mutable StudioStorageManifest::Entry&,
                       message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            if expected.state != StudioStorageManifest::REGISTERED or not StudioStorageManifest::valid(expected):
                explanation: sview = "The reviewed inventory entry is incomplete or invalid."
                for byte in explanation:
                    message.push(byte)
                return false
            mutable candidate: u8[4096] = zeroed
            for index in 0..<expected.original_path.count |expected, candidate|:
                candidate[index] <- expected.original_path[index]
            candidate[expected.original_path.count] <- 0
            candidate_ptr: cstr = (&candidate[0]).cast[cstr] can Unsafe.PointerCast
            move_checked(build_root, candidate_ptr, expected, record, message)

    private:
        # `record` is updated only after the engine returns a complete receipt.
        # Errors are copied into `message` and remain available to the UI.
        def move_record(build_root: cstr, candidate: cstr, kind: i64,
                        reviewed: StudioStorageManifest::Entry?,
                        record: mutable StudioStorageManifest::Entry&,
                        message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            if kind < StudioStorageReceiptPolicy::Kind.Recovery.i64() or kind >= StudioStorageReceiptPolicy::Limit::KIND_COUNT:
                explanation: sview = "Studio cannot manage this artifact type."
                for byte in explanation:
                    message.push(byte)
                return false
            mutable original: u8[4096] = zeroed
            mutable trashed: u8[4096] = zeroed
            mutable error_buffer: u8[512] = zeroed
            mutable device: i64 = 0
            mutable inode: i64 = 0
            mutable size_bytes: i64 = 0
            mutable modified_seconds: i64 = 0
            mutable modified_nanoseconds: i64 = 0
            original_ptr: mutable u8& = (&original[0]).cast[mutable u8&] can Unsafe.PointerCast
            trashed_ptr: mutable u8& = (&trashed[0]).cast[mutable u8&] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            mutable code: i32 = -1
            if reviewed is expected:
                mutable expected_path: u8[4096] = zeroed
                for index in 0..<expected.original_path.count |expected, expected_path|:
                    expected_path[index] <- expected.original_path[index]
                expected_path[expected.original_path.count] <- 0
                expected_ptr: cstr = (&expected_path[0]).cast[cstr] can Unsafe.PointerCast
                code <- studio_trash_move_checked_fields(build_root, candidate,
                    expected_ptr, expected.device, expected.inode, expected.size_bytes,
                    expected.modified_seconds, expected.modified_nanoseconds,
                    original_ptr, trashed_ptr, STUDIO_TRASH_PATH_CAPACITY.i32(),
                    &device, &inode, &size_bytes, &modified_seconds,
                    &modified_nanoseconds, error_ptr, STUDIO_TRASH_ERROR_CAPACITY.i32())
            else:
                code <- studio_trash_move_fields(build_root, candidate,
                    original_ptr, trashed_ptr, STUDIO_TRASH_PATH_CAPACITY.i32(),
                    &device, &inode, &size_bytes, &modified_seconds,
                    &modified_nanoseconds, error_ptr, STUDIO_TRASH_ERROR_CAPACITY.i32())
            message.clear()
            mutable error_index: usize = 0
            while error_index < STUDIO_TRASH_ERROR_CAPACITY and error_buffer[error_index] != 0:
                message.push(error_buffer[error_index])
                error_index <- error_index + 1
            return false if code != 0
            mutable original_bytes: darray[u8] = []
            mutable trashed_bytes: darray[u8] = []
            mutable original_index: usize = 0
            mutable trashed_index: usize = 0
            while original_index < STUDIO_TRASH_PATH_CAPACITY and original[original_index] != 0:
                original_bytes.push(original[original_index])
                original_index <- original_index + 1
            while trashed_index < STUDIO_TRASH_PATH_CAPACITY and trashed[trashed_index] != 0:
                trashed_bytes.push(trashed[trashed_index])
                trashed_index <- trashed_index + 1
            next: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
                state: StudioStorageManifest::IN_TRASH,
                kind: kind, device: device, inode: inode, size_bytes: size_bytes,
                modified_seconds: modified_seconds,
                modified_nanoseconds: modified_nanoseconds,
                original_path: original_bytes, trashed_path: trashed_bytes}
            if not StudioStorageManifest::valid(next):
                message.clear()
                explanation: sview = "The file moved, but its receipt data was outside the supported range."
                for byte in explanation:
                    message.push(byte)
                # Roll back immediately when a host identity cannot be
                # represented safely by the versioned manifest.
                _ = restore_fields(build_root, next, message)
                return false
            record <- next
            true

    public:
        # The receipt remains unchanged on failure and is cleared by the UI
        # only after this function confirms that the engine restored the file.
        def restore(build_root: cstr, record: StudioStorageManifest::Entry,
                    message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            message.clear()
            if record.state != StudioStorageManifest::IN_TRASH or not StudioStorageManifest::valid(record):
                explanation: sview = "This restore receipt is incomplete or invalid."
                for byte in explanation:
                    message.push(byte)
                return false
            restore_fields(build_root, record, message)

    private:
        def restore_fields(build_root: cstr, record: StudioStorageManifest::Entry,
                           message: mutable darray[u8]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate]:
            mutable original: u8[4096] = zeroed
            mutable trashed: u8[4096] = zeroed
            mutable error_buffer: u8[512] = zeroed
            for index in 0..<record.original_path.count |record, original|:
                original[index] <- record.original_path[index]
            original[record.original_path.count] <- 0
            for index in 0..<record.trashed_path.count |record, trashed|:
                trashed[index] <- record.trashed_path[index]
            trashed[record.trashed_path.count] <- 0
            original_ptr: cstr = (&original[0]).cast[cstr] can Unsafe.PointerCast
            trashed_ptr: cstr = (&trashed[0]).cast[cstr] can Unsafe.PointerCast
            error_ptr: mutable u8& = (&error_buffer[0]).cast[mutable u8&] can Unsafe.PointerCast
            code: i32 = studio_trash_restore_fields(build_root,
                original_ptr, trashed_ptr,
                record.device, record.inode, record.size_bytes,
                record.modified_seconds, record.modified_nanoseconds,
                error_ptr,
                STUDIO_TRASH_ERROR_CAPACITY.i32())
            message.clear()
            mutable error_index: usize = 0
            while error_index < STUDIO_TRASH_ERROR_CAPACITY and error_buffer[error_index] != 0:
                message.push(error_buffer[error_index])
                error_index <- error_index + 1
            code == 0
