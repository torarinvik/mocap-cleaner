# Native canonical Unicode/case-folded path comparison for protected metadata.
# Unknown resolution or UTF-8 decoding must be treated as blocked by callers.
@link_name("elisa_file_path_namespace_match")
extern storage_path_namespace_match(candidate: cstr, reserved: cstr) -> i32 can[Blocking.IO, Memory.Allocate]

module StudioStorageReservedNamespace:
    public:
        const UNKNOWN: i64 = -1
        const DIFFERENT: i64 = 0
        const MATCH: i64 = 1

        def compare(candidate: cstr, reserved: cstr) -> i64 can[Blocking.IO, Memory.Allocate]:
            outcome: i32 = storage_path_namespace_match(candidate, reserved)
            return UNKNOWN if outcome == UNKNOWN
            return DIFFERENT if outcome == DIFFERENT
            return MATCH if outcome == MATCH
            UNKNOWN
