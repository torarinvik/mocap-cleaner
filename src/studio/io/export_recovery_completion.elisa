include "export_recovery_binding.elisa"
include "../export_recovery_report_stage_policy.elisa"

module StudioExportRecoveryCompletion:
    public:
        const enum Report of i64:
            Json = 0
            Text = 1

        const enum Failure of i64:
            InvalidReport = 0
            BindingUnavailable = 1
            NotPublished = 2
            OwnershipUnavailable = 3
            WorkspaceBusy = 4

        enum Outcome:
            Rejected(reason: StudioExportRecoveryCompletion::Failure)
            ExistingMatching(journal_status: StudioPublicationDurabilityPolicy::Result)
            Published(status: StudioPublicationDurabilityPolicy::Result, journal_status: StudioPublicationDurabilityPolicy::Result)

        # Caller supplies captured bytes and native ownership/transaction facts.
        # An unreadable/conflicting existing destination cannot be overwritten:
        # create-only publication refuses it. No GLB write occurs here.
        def complete(directory: cstr, expected: StudioExportRecoveryJournal::Record&,
                     output: darray[u8]&, json: darray[u8]&, text: darray[u8]&,
                     owned: bool, locked: bool, report: Report) -> Outcome can[Blocking.IO, Memory{Allocate, Release}, Unsafe.PointerCast]:
            return Outcome.Rejected(Failure.InvalidReport) if report != Report.Json and report != Report.Text
            return Outcome.Rejected(Failure.OwnershipUnavailable) if not owned
            return Outcome.Rejected(Failure.WorkspaceBusy) if not locked
            mutable journal: StudioExportRecoveryJournal::Record = expected
            return Outcome.Rejected(Failure.BindingUnavailable) if not StudioExportRecoveryBinding::load(directory, expected, output, json, text, owned, locked, &journal)
            mutable destination: u8[4096] = zeroed
            if report == Report.Json:
                for index in 0..<expected.json_destination.count |destination, expected, index|:
                    destination[index] <- expected.json_destination[index]
                return publish(directory, &journal, (&destination[0]).cast[cstr], json, true)
            for index in 0..<expected.text_destination.count |destination, expected, index|:
                destination[index] <- expected.text_destination[index]
            publish(directory, &journal, (&destination[0]).cast[cstr], text, false)

        def message(outcome: Outcome) -> sview:
            match outcome:
                Outcome.Rejected(reason):
                    return "Choose a JSON or text report to complete." if reason == Failure.InvalidReport
                    return "Recovery files could not be verified as owned by this workspace. Keep them and inspect the recovery record." if reason == Failure.OwnershipUnavailable
                    return "Workspace transaction is unavailable. Wait for other workspace operations to finish, then retry." if reason == Failure.WorkspaceBusy
                    return "Recovery bytes no longer match the captured export, or could not be read. Keep the recovery files and review the export." if reason == Failure.BindingUnavailable
                    return "Report was not published. Check folder access and any existing report; retry will not replace an existing file. Keep recovery files."
                Outcome.ExistingMatching(journal_status):
                    return "The existing report matches. Recovery tracking could not be saved; keep recovery files." if journal_status == StudioPublicationDurabilityPolicy::Result.NotPublished
                    return "The existing report matches. Recovery tracking was written, but its directory durability is unconfirmed; keep recovery files." if journal_status == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown
                    return "The existing report matches and recovery tracking was saved. Other report files still require their own check."
                Outcome.Published(status, journal_status):
                    if status == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown:
                        return "Report published; report durability and recovery tracking are unconfirmed. Keep recovery files." if journal_status != StudioPublicationDurabilityPolicy::Result.PublishedDirectorySynced
                        return "Report published; its directory durability is unconfirmed. Recovery tracking was saved. Keep recovery files."
                    return "Report published and directory synced. Recovery tracking could not be saved; keep recovery files." if journal_status == StudioPublicationDurabilityPolicy::Result.NotPublished
                    return "Report published and directory synced. Recovery tracking durability is unconfirmed; keep recovery files." if journal_status == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown
                    "Report published and directory synced; recovery tracking saved. Other reports still require their own check."

    private:
        def publish(directory: cstr, journal: mutable StudioExportRecoveryJournal::Record&,
                    destination: cstr, bytes: darray[u8]&, json: bool) -> Outcome:
            matched: bool = StudioExportRecoveryBytes::matches(destination, bytes, StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES)
            if matched:
                advance_observed(journal, json)
                journal_status: StudioPublicationDurabilityPolicy::Result = StudioExportRecoveryStore::update_journal(directory, journal)
                return Outcome.ExistingMatching(journal_status)
            status: StudioPublicationDurabilityPolicy::Result = StudioExportPublisher::write_new_sidecar_with_status(destination, bytes)
            return Outcome.Rejected(Failure.NotPublished) if not StudioPublicationDurabilityPolicy::published(status)
            advance_observed(journal, json)
            # Reading a matching GLB does not prove its crash durability. Extend
            # durable stages only when GLB durability was already recorded.
            if status == StudioPublicationDurabilityPolicy::Result.PublishedDirectorySynced and journal.durable != StudioExportRecoveryStagePolicy::Stage.Prepared:
                journal.durable <- StudioExportRecoveryReportStagePolicy::with_report(journal.durable.i64(), json).cast[StudioExportRecoveryStagePolicy::Stage]
            journal_status: StudioPublicationDurabilityPolicy::Result = StudioExportRecoveryStore::update_journal(directory, journal)
            # Publication remains visible even when the later journal update
            # fails. The retained record permits another conservative attempt.
            Outcome.Published(status, journal_status)

        def advance_observed(journal: mutable StudioExportRecoveryJournal::Record&, json: bool):
            mutable observed: i64 = journal.observed.i64()
            if observed == 0:
                observed <- 1
            journal.observed <- StudioExportRecoveryReportStagePolicy::with_report(observed, json).cast[StudioExportRecoveryStagePolicy::Stage]
