# Strict byte codec for the versioned, bounded Storage retention preferences.
include "../storage_preferences_policy.elisa"

module StudioStoragePreferencesCodec:
    public:
        const MAX_FILE_BYTES: usize = 128
        const FILE_BYTES: usize = 48

        def header_matches(text: darray[u8]&) -> bool:
            requires text.count == FILE_BYTES
            ensure result == (
                text[0] == 109 and
                text[1] == 111 and
                text[2] == 99 and
                text[3] == 97 and
                text[4] == 112 and
                text[5] == 45 and
                text[6] == 115 and
                text[7] == 116 and
                text[8] == 111 and
                text[9] == 114 and
                text[10] == 97 and
                text[11] == 103 and
                text[12] == 101 and
                text[13] == 45 and
                text[14] == 112 and
                text[15] == 114 and
                text[16] == 101 and
                text[17] == 102 and
                text[18] == 101 and
                text[19] == 114 and
                text[20] == 101 and
                text[21] == 110 and
                text[22] == 99 and
                text[23] == 101 and
                text[24] == 115 and
                text[25] == 45 and
                text[26] == 118 and
                text[27] == 49 and
                text[28] == 10 and
                text[29] == 114 and
                text[30] == 101 and
                text[31] == 116 and
                text[32] == 101 and
                text[33] == 110 and
                text[34] == 116 and
                text[35] == 105 and
                text[36] == 111 and
                text[37] == 110 and
                text[38] == 45 and
                text[39] == 112 and
                text[40] == 114 and
                text[41] == 101 and
                text[42] == 115 and
                text[43] == 101 and
                text[44] == 116 and
                text[45] == 61)
            text[0] == 109 and text[1] == 111 and text[2] == 99 and text[3] == 97 and text[4] == 112 and text[5] == 45 and text[6] == 115 and text[7] == 116 and text[8] == 111 and text[9] == 114 and text[10] == 97 and text[11] == 103 and text[12] == 101 and text[13] == 45 and text[14] == 112 and text[15] == 114 and text[16] == 101 and text[17] == 102 and text[18] == 101 and text[19] == 114 and text[20] == 101 and text[21] == 110 and text[22] == 99 and text[23] == 101 and text[24] == 115 and text[25] == 45 and text[26] == 118 and text[27] == 49 and text[28] == 10 and text[29] == 114 and text[30] == 101 and text[31] == 116 and text[32] == 101 and text[33] == 110 and text[34] == 116 and text[35] == 105 and text[36] == 111 and text[37] == 110 and text[38] == 45 and text[39] == 112 and text[40] == 114 and text[41] == 101 and text[42] == 115 and text[43] == 101 and text[44] == 116 and text[45] == 61

        def decode(text: darray[u8]&, out: mutable i64&) -> bool:
            requires text.count == FILE_BYTES
            return false if not header_matches(text)
            return false if text[47] != 10
            preset: i64 = StudioStoragePreferencesPolicy::decode_digit(text[46].i64())
            return false if not StudioStoragePreferencesPolicy::valid_preset(preset)
            out <- preset
            true

        def append_header_first(out: mutable darray[u8]&) -> void can Memory.Allocate:
            out.clear()
            out.extend([109, 111, 99, 97, 112, 45, 115, 116, 111, 114, 97, 103, 101, 45, 112, 114, 101, 102, 101, 114, 101, 110, 99])
            return

        def append_header_second(out: mutable darray[u8]&) -> void can Memory.Allocate:
            out.extend([101, 115, 45, 118, 49, 10, 114, 101, 116, 101, 110, 116, 105, 111, 110, 45, 112, 114, 101, 115, 101, 116, 61])
            return

        def encode(preset: i64, out: mutable darray[u8]&) -> bool can Memory.Allocate:
            requires preset >= 0 and preset <= 3
            can Memory.Allocate:
                append_header_first(out)
                append_header_second(out)
                out.extend([(48 + preset).u8(), 10u8])
            true
