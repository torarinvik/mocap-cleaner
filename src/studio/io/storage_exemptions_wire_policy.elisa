# Pure exact header predicate for the dedicated Storage exemptions file.
module StudioStorageExemptionsWirePolicy:
    public:
        const HEADER_BYTES: usize = 27
        const PREFIX_BYTES: usize = 28

        def header_matches(text: darray[u8]&) -> bool:
            requires text.count >= PREFIX_BYTES
            ensure result == (text[0] == 109 and text[1] == 111 and text[2] == 99 and text[3] == 97 and text[4] == 112 and text[5] == 45 and text[6] == 115 and text[7] == 116 and text[8] == 111 and text[9] == 114 and text[10] == 97 and text[11] == 103 and text[12] == 101 and text[13] == 45 and text[14] == 101 and text[15] == 120 and text[16] == 101 and text[17] == 109 and text[18] == 112 and text[19] == 116 and text[20] == 105 and text[21] == 111 and text[22] == 110 and text[23] == 115 and text[24] == 45 and text[25] == 118 and text[26] == 49 and text[27] == 10)
            text[0] == 109 and text[1] == 111 and text[2] == 99 and text[3] == 97 and text[4] == 112 and text[5] == 45 and text[6] == 115 and text[7] == 116 and text[8] == 111 and text[9] == 114 and text[10] == 97 and text[11] == 103 and text[12] == 101 and text[13] == 45 and text[14] == 101 and text[15] == 120 and text[16] == 101 and text[17] == 109 and text[18] == 112 and text[19] == 116 and text[20] == 105 and text[21] == 111 and text[22] == 110 and text[23] == 115 and text[24] == 45 and text[25] == 118 and text[26] == 49 and text[27] == 10
