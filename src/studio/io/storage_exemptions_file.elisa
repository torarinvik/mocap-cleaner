# Strict versioned exemption wrapper around the existing Storage manifest
# record codec. The app owns same-directory atomic publication.
include "storage_manifest.elisa"
include "storage_exemptions_wire_policy.elisa"
include "../storage_exemption_policy.elisa"

@link_name("fopen")
extern storage_exemptions_fopen(path: u8&, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("fgetc")
extern storage_exemptions_fgetc(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("ferror")
extern storage_exemptions_ferror(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fclose")
extern storage_exemptions_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]

module StudioStorageExemptionsCodec:
    public:
        const module Wire:
            HEADER_BYTES: usize = StudioStorageExemptionsWirePolicy::Wire::HEADER_BYTES
            MAX_FILE_BYTES: usize = StudioStorageManifest::MAX_ENTRIES.usize() * StudioStorageManifest::MAX_LINE_BYTES + 64 + StudioStorageExemptionsWirePolicy::Wire::PREFIX_BYTES

        def entry_valid(entry: StudioStorageManifest::Entry) -> bool:
            ensure result implies entry.state == StudioStorageManifest::REGISTERED
            ensure result implies entry.kind != StudioStorageReceiptPolicy::Kind.Recovery.i64()
            ensure result implies StudioStorageExemptionPolicy::identity_valid(entry.device, entry.inode, entry.size_bytes, entry.modified_seconds, entry.modified_nanoseconds)
            entry.state == StudioStorageManifest::REGISTERED and entry.kind != StudioStorageReceiptPolicy::Kind.Recovery.i64() and StudioStorageExemptionPolicy::identity_valid(entry.device, entry.inode, entry.size_bytes, entry.modified_seconds, entry.modified_nanoseconds)

        # Input is a dedicated header followed by an ordinary manifest document.
        # The manifest parser retains responsibility for record parsing,
        # identity scalar bounds, path validation, count limits, and duplicates.
        def decode(text: darray[u8]&, out: mutable darray[StudioStorageManifest::Entry]&) -> bool can Memory.Allocate:
            return false if text.count > Wire::MAX_FILE_BYTES
            return false if text.count < Wire::HEADER_BYTES + 1
            return false if not StudioStorageExemptionsWirePolicy::header_matches(text)
            mutable body: darray[u8] = []
            for index in (Wire::HEADER_BYTES + 1)..<text.count |text, body|:
                body.push(text[index])
            mutable parsed: darray[StudioStorageManifest::Entry] = []
            return false if not StudioStorageManifest::decode(body, &parsed)
            return false if parsed.count.i64() > StudioStorageExemptionPolicy::Limit::MAX_EXEMPTIONS
            for entry in parsed:
                return false if not entry_valid(entry)
            out.clear()
            for entry in parsed:
                out.push(entry)
            true

        # The output changes only after all records pass exemption-specific
        # validation and the shared manifest encoder rejects no duplicates.
        def encode(entries: darray[StudioStorageManifest::Entry]&, out: mutable darray[u8]&) -> bool can Memory.Allocate:
            return false if not StudioStorageExemptionPolicy::count_valid(entries.count.i64())
            for entry in entries:
                return false if not entry_valid(entry)
            mutable manifest_bytes: darray[u8] = []
            return false if not StudioStorageManifest::encode(entries, &manifest_bytes)
            mutable wrapped: darray[u8] = []
            can Memory.Allocate:
                wrapped.extend([109, 111, 99, 97, 112, 45, 115, 116, 111, 114, 97, 103, 101, 45, 101, 120, 101, 109, 112, 116, 105, 111, 110, 115, 45, 118, 49, 10])
                wrapped.extend(manifest_bytes)
            return false if wrapped.count > Wire::MAX_FILE_BYTES
            can Memory.Allocate:
                out.clear()
                out.extend(wrapped)
            true

module StudioStorageExemptionsFile:
    public:
        const enum LoadStatus of i64:
            Ok = 0
            OpenFailed = 1
            ReadFailed = 2
            TooLarge = 3
            CloseFailed = 4
            InvalidFormat = 5

        def load_status(path: cstr, out: mutable darray[StudioStorageManifest::Entry]&) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release]:
            mutable bytes: darray[u8] = []
            mutable file: mutable heap void&? = null
            can Blocking.IO, Memory.Allocate, Memory.Release:
                file <- storage_exemptions_fopen(path.cast[u8&], "rb".cast[u8&])
                if file is opened:
                    mutable reading: bool = true
                    mutable read_failed: bool = false
                    mutable too_large: bool = false
                    while reading:
                        byte: i32 = storage_exemptions_fgetc(opened)
                        if byte < 0:
                            reading <- false
                            read_failed <- storage_exemptions_ferror(opened) != 0
                        else:
                            if bytes.count >= StudioStorageExemptionsCodec::Wire::MAX_FILE_BYTES:
                                too_large <- true
                                reading <- false
                            else:
                                bytes.push(byte.u8())
                    close_status: i32 = storage_exemptions_fclose(opened)
                    return LoadStatus.ReadFailed.i64() if read_failed
                    return LoadStatus.TooLarge.i64() if too_large
                    return LoadStatus.CloseFailed.i64() if close_status != 0
                else:
                    return LoadStatus.OpenFailed.i64()
            mutable parsed: darray[StudioStorageManifest::Entry] = []
            return LoadStatus.InvalidFormat.i64() if not StudioStorageExemptionsCodec::decode(bytes, &parsed)
            out.clear()
            for entry in parsed:
                out.push(entry)
            LoadStatus.Ok.i64()

        def load(path: cstr, out: mutable darray[StudioStorageManifest::Entry]&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release]:
            load_status(path, out) == LoadStatus.Ok.i64()
