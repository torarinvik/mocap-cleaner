# Artifact output cannot replace Storage's reserved metadata or lock inode.
include "file_trash.elisa"
include "storage_reserved_namespace.elisa"
include "../storage_control_destination_policy.elisa"
include "../../../../elisa-engine-mocap/src/ui/file_panel.elisa"

module StudioStorageArtifactDestination:
    private:
        const enum Fact of i64:
            Safe = 0
            ReservedPath = 1
            ReservedIdentity = 2
            Unverified = 3

        def bytes(path: cstr) -> darray[u8] can Unsafe.PointerCast:
            mutable out: darray[u8] = []
            for index in 0..<4096 |path, out|:
                return out if path[index] == 0
                out.push(path[index])
            []

        def control_fact(build_root: cstr, target: cstr, target_exists: bool,
                            device: i64, inode: i64, control: cstr) -> Fact can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}]:
            comparison: i64 = StudioStorageReservedNamespace::compare(target, control)
            return Fact.Unverified if comparison == StudioStorageReservedNamespace::Outcome.Unknown.i64()
            return Fact.ReservedPath if comparison == StudioStorageReservedNamespace::Outcome.Match.i64()
            facts: i64 = FilePanel::path_facts(control)
            return Fact.Unverified if facts < 0 or (facts & FilePanel::PATH_SYMLINK) != 0
            return Fact.Safe if (facts & FilePanel::PATH_EXISTS) == 0
            mutable identity: StudioStorageManifest::Entry = zeroed
            mutable explanation: darray[u8] = []
            return Fact.Unverified if not StudioFileTrash::snapshot(build_root, control, StudioStorageReceiptPolicy::Kind.Recovery.i64(), &identity, &explanation)
            Fact.ReservedIdentity if target_exists and device == identity.device and inode == identity.inode else Fact.Safe

    public:
        def allowed(build_root: cstr, destination: cstr, manifest: cstr, preferences: cstr,
                    exemptions: cstr, lock: cstr) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}]:
            mutable admitted: bool = false
            if FilePanel::resolve_path(destination) is resolved:
                target: darray[u8] = bytes(resolved)
                facts: i64 = FilePanel::path_facts(destination)
                mutable identity: StudioStorageManifest::Entry = zeroed
                mutable explanation: darray[u8] = []
                exists: bool = facts >= 0 and (facts & FilePanel::PATH_EXISTS) != 0
                mutable verified: bool = facts >= 0 and target.count > 0
                if exists:
                    verified <- verified and StudioFileTrash::snapshot(build_root, destination, StudioStorageReceiptPolicy::Kind.Recovery.i64(), &identity, &explanation)
                if verified:
                    manifest_fact: Fact = control_fact(build_root, resolved, exists, identity.device, identity.inode, manifest)
                    preferences_fact: Fact = control_fact(build_root, resolved, exists, identity.device, identity.inode, preferences)
                    exemptions_fact: Fact = control_fact(build_root, resolved, exists, identity.device, identity.inode, exemptions)
                    lock_fact: Fact = control_fact(build_root, resolved, exists, identity.device, identity.inode, lock)
                    path_match: bool = manifest_fact == Fact.ReservedPath or preferences_fact == Fact.ReservedPath or exemptions_fact == Fact.ReservedPath or lock_fact == Fact.ReservedPath
                    alias: bool = manifest_fact == Fact.ReservedIdentity or preferences_fact == Fact.ReservedIdentity or exemptions_fact == Fact.ReservedIdentity or lock_fact == Fact.ReservedIdentity
                    unknown: bool = manifest_fact == Fact.Unverified or preferences_fact == Fact.Unverified or exemptions_fact == Fact.Unverified or lock_fact == Fact.Unverified
                    admitted <- StudioStorageControlDestinationPolicy::may_write_artifact(true, path_match, alias, unknown)
                FilePanel::release_path(resolved)
            admitted
