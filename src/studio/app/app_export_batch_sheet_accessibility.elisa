include "panels_export_batch.elisa"
include "../export_batch_sheet_accessibility_policy.elisa"

# Standalone publisher for the prepared-export queue sheet. Row labels and
# output values borrow the controller's retained immutable snapshots.
extend Studio:
    public:
        def publish_export_batch_sheet_accessibility(w: f32, h: f32,
                rows: darray[StudioExportBatchPanelPolicy::Row]&, row_details: darray[sview]&, first_row: i64,
                total: i64, selected: i64, focus: StudioExportBatchPanelPolicy::Focus,
                controls: StudioExportBatchPanelPolicy::Controls, status: sview,
                row_widgets: darray[usize]&, action_widgets: darray[usize]&,
                semantic_revision: usize) -> void:
            requires total >= 0 and total <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            requires first_row >= 0 and first_row <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            requires rows.count.i64() >= total and row_details.count.i64() >= total
            requires row_widgets.count == StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT.usize()
            requires action_widgets.count == StudioExportBatchSheetAccessibilityPolicy::Node::ACTION_COUNT.usize()
            requires selected >= -1 and (selected < 0 or selected < total)
            requires row_widgets[0] != UiFlat::NONE and row_widgets[1] != UiFlat::NONE and row_widgets[2] != UiFlat::NONE and row_widgets[3] != UiFlat::NONE and row_widgets[4] != UiFlat::NONE and row_widgets[5] != UiFlat::NONE and row_widgets[6] != UiFlat::NONE
            requires action_widgets[0] != UiFlat::NONE and action_widgets[1] != UiFlat::NONE and action_widgets[2] != UiFlat::NONE and action_widgets[3] != UiFlat::NONE and action_widgets[4] != UiFlat::NONE and action_widgets[5] != UiFlat::NONE and action_widgets[6] != UiFlat::NONE and action_widgets[7] != UiFlat::NONE and action_widgets[8] != UiFlat::NONE and action_widgets[9] != UiFlat::NONE and action_widgets[10] != UiFlat::NONE and action_widgets[11] != UiFlat::NONE and action_widgets[12] != UiFlat::NONE
            visible: i64 = StudioExportBatchPanelPolicy::visible_count(first_row, total)
            none: usize = StudioAccessibility::NO_NODE
            dialog: StudioPanels::Box = StudioPanels::export_batch_bounds(w, h)
            StudioText::begin()
            StudioText::put("Prepared exports. Showing ")
            StudioText::put_i(visible)
            StudioText::put(" of ")
            StudioText::put_i(total)
            StudioText::put(" visible queue items.")
            UiCore::accessibility_with_metadata(UiCore::AccessibilityRole.Dialog,
                "Prepared export queue",
                "Queue of captured, reviewed take exports. Source path is the node label; exact selected output path is its value. Select an item before using enabled actions. Closing the sheet retains queue and recovery files.",
                UiCore::Rect(dialog.x, dialog.y, dialog.w, dialog.h),
                StudioExportBatchSheetAccessibilityPolicy::Node::DIALOG, none,
                true, false, false, 0.0, StudioText::view(), "", semantic_revision, 0, 0,
                none, StudioExportBatchSheetAccessibilityPolicy::first_child_id(), none,
                0.0, 1.0, false)
            status_box: StudioPanels::Box = StudioPanels::box(dialog.x + 22.0, dialog.y + 78.0, dialog.w - 44.0, 24.0)
            UiCore::accessibility_with_metadata(UiCore::AccessibilityRole.Status,
                "Queue status", "Current queue and workspace action status.",
                UiCore::Rect(status_box.x, status_box.y, status_box.w, status_box.h),
                StudioExportBatchSheetAccessibilityPolicy::Node::STATUS, none,
                true, false, false, 0.0, status, "", semantic_revision, 0, 0,
                StudioExportBatchSheetAccessibilityPolicy::Node::DIALOG, none,
                StudioExportBatchSheetAccessibilityPolicy::next_sibling_id(
                    StudioExportBatchSheetAccessibilityPolicy::Node::STATUS, visible),
                0.0, 1.0, false)
            for offset in 0..<StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT |offset, rows, row_details, row_widgets, visible, first_row, selected, w, h, semantic_revision|:
                if offset < visible:
                    index: i64 = first_row + offset
                    row: StudioExportBatchPanelPolicy::Row = rows[index.usize()]
                    widget: usize = row_widgets[offset.usize()]
                    row_id: usize = StudioExportBatchSheetAccessibilityPolicy::row_id(offset)
                    row_box: StudioPanels::Box = StudioPanels::export_batch_row_box(w, h, offset)
                    UiCore::accessibility_with_metadata(UiCore::AccessibilityRole.ListItem,
                        row.label, row_details[index.usize()],
                        UiCore::Rect(row_box.x, row_box.y, row_box.w, row_box.h),
                        row_id, widget, true, index == selected, false, 0.0,
                        row.output_label, "", semantic_revision, 0, 0,
                        StudioExportBatchSheetAccessibilityPolicy::Node::DIALOG, none,
                        StudioExportBatchSheetAccessibilityPolicy::next_sibling_id(row_id, visible),
                        0.0, 1.0, false)
            for code in 0..<StudioExportBatchSheetAccessibilityPolicy::Node::ACTION_COUNT |code, action_widgets, controls, focus, w, h, semantic_revision|:
                if StudioExportBatchPanelPolicy::focus_from_code(code) is action:
                    widget: usize = action_widgets[code.usize()]
                    enabled: bool = StudioExportBatchPanelPolicy::action_enabled(action, controls)
                    UiFlat::set_enabled(widget, enabled)
                    action_box: StudioPanels::Box = StudioPanels::export_batch_action_bounds(w, h, action)
                    UiCore::accessibility_with_metadata(UiCore::AccessibilityRole.Button,
                        StudioExportBatchPanelPolicy::action_label(action),
                        "Action is available for the current selected item and workspace state." if enabled else "Action is unavailable for the current queue, selection, or workspace state.",
                        UiCore::Rect(action_box.x, action_box.y, action_box.w, action_box.h),
                        StudioExportBatchSheetAccessibilityPolicy::action_id(action), widget,
                        enabled, focus == action, false, 0.0, "", "", semantic_revision, 0, 0,
                        StudioExportBatchSheetAccessibilityPolicy::Node::DIALOG, none,
                        StudioExportBatchSheetAccessibilityPolicy::next_sibling_id(
                            StudioExportBatchSheetAccessibilityPolicy::action_id(action), visible),
                        0.0, 1.0, false)

        # Returns only an enabled typed action; the caller routes it through
        # the retained queue controller, which revalidates all authority.
        def export_batch_sheet_accessibility_action(widget: usize, event: i32,
                widgets: darray[usize]&, controls: StudioExportBatchPanelPolicy::Controls) -> StudioExportBatchPanelPolicy::Focus?:
            requires widgets.count == StudioExportBatchSheetAccessibilityPolicy::Node::ACTION_COUNT.usize()
            return null if widget == UiFlat::NONE or event != UiConst::WidgetEvent.Click.i32()
            for slot in 0..<StudioExportBatchSheetAccessibilityPolicy::Node::ACTION_COUNT |slot, widgets, widget, controls|:
                if widgets[slot.usize()] == widget:
                    if StudioExportBatchPanelPolicy::focus_from_code(slot) is focus:
                        return focus if StudioExportBatchPanelPolicy::action_enabled(focus, controls)
                        return null
            null

        # Returns the absolute queue index only when a live visible row widget
        # was clicked. Invalid and stale widgets cannot select an item.
        def export_batch_sheet_accessibility_row(widget: usize, event: i32,
                widgets: darray[usize]&, first_row: i64, visible_count: i64) -> i64:
            requires widgets.count == StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT.usize()
            requires first_row >= 0 and first_row <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            requires visible_count >= 0 and visible_count <= StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT
            ensure result == -1 or (result >= first_row and result < first_row + visible_count)
            return -1 if widget == UiFlat::NONE or event != UiConst::WidgetEvent.Click.i32()
            for offset in 0..<StudioExportBatchSheetAccessibilityPolicy::Node::ROW_COUNT |offset, widgets, widget, visible_count, first_row|:
                if offset < visible_count and widgets[offset.usize()] == widget:
                    return StudioExportBatchSheetAccessibilityPolicy::row_index(
                        StudioExportBatchSheetAccessibilityPolicy::row_id(offset), first_row, visible_count)
            -1
