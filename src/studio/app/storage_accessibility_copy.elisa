# Accessible names, help, and live result copy for Storage & Recovery.
# Dynamic filenames remain caller-provided and should precede these fields.
module StudioStorageAccessibilityCopy:
    public:
        const STATUS_PRESENT: i64 = 0
        const STATUS_IN_TRASH: i64 = 1
        const STATUS_CHANGED: i64 = 2
        const STATUS_UNVERIFIED: i64 = 3
        const KIND_RECOVERY: i64 = 0
        const KIND_TEMP_EXPORT: i64 = 1
        const KIND_REPORT: i64 = 2

        struct RowCopy:
            kind: mutable sview
            status: mutable sview
            selection: mutable sview
            help: mutable sview

        def dialog_name(reviewing_restore: bool) -> sview:
            return "Confirm restore" if reviewing_restore
            "Storage & Recovery"

        def dialog_help(reviewing_restore: bool) -> sview:
            return "Confirm restoring the selected recovery receipt after a fresh identity check. The file returns to its original build location and will not overwrite an existing file." if reviewing_restore
            "Studio-managed reports and recovery receipts. Source takes are protected. Select an inventory row, refresh to check file identities, or choose Done to close."

        # The caller appends an ISO calendar value and the explicit UTC zone.
        def last_scan_prefix() -> sview:
            "Last scan (UTC): "

        def last_scan_unknown() -> sview:
            "Last scan time unavailable. Refresh to retry."

        def file_trigger_name() -> sview:
            "File"

        def file_menu_name() -> sview:
            "File menu"

        def file_command_name(row: i64) -> sview:
            return "Open Take..." if row == 0
            return "Open Session..." if row == 1
            return "Save Session" if row == 2
            return "Save Session As..." if row == 3
            return "Export Cleaned GLB" if row == 4
            return "Export As..." if row == 5
            return "Storage & Recovery" if row == 6
            return "Locate or create workspace" if row == 7
            "Unavailable command"

        def file_command_help(row: i64, has_take: bool) -> sview:
            return "Open Storage & Recovery to review Studio-managed files. Available without a loaded take." if row == 6
            return "Choose a workspace with a writable build folder, or explicitly create build/ there." if row == 7
            return "Available whenever the Studio window is open." if row == 0
            return "Requires a loaded take." if not has_take
            ""

        def kind_name(kind: i64) -> sview:
            return "Recovery" if kind == KIND_RECOVERY
            return "Temporary export" if kind == KIND_TEMP_EXPORT
            return "Quality report" if kind == KIND_REPORT
            "Unknown type"

        def status_name(status: i64) -> sview:
            return "Verified in build" if status == STATUS_PRESENT
            return "Verified in Trash" if status == STATUS_IN_TRASH
            return "Changed identity" if status == STATUS_CHANGED
            "Could not verify"

        def status_help(status: i64) -> sview:
            return "The registered file identity matches the file in build/." if status == STATUS_PRESENT
            return "The registered recovery receipt matches the file in Trash. Restore is available after review." if status == STATUS_IN_TRASH
            return "Protected: the file identity changed since registration. Restore is unavailable." if status == STATUS_CHANGED
            "Protected: the file identity could not be verified. Restore is unavailable."

        def selection_value(selected: bool) -> sview:
            return "Selected" if selected
            "Not selected"

        # Caller supplies the filename as the accessible row label. These
        # fields fill its value, selected state, and explanatory help.
        def row_copy(kind: i64, status: i64, selected: bool) -> RowCopy:
            return RowCopy{
                kind: kind_name(kind),
                status: status_name(status),
                selection: selection_value(selected),
                help: status_help(status)
            }

        def protected_summary(unverified: i64, hidden_protected: i64) -> sview:
            return "Unverified or changed records are protected; Restore is unavailable for them." if unverified > 0
            return "Protected records are hidden when they are outside build/ or match the active source take." if hidden_protected > 0
            "No additional protected records."

        def action_name(action: i64, reviewing_restore: bool) -> sview:
            return "Refresh" if action == 0
            return "Done" if action == 1
            return "Confirm restore" if action == 2 and reviewing_restore
            return "Restore" if action == 2
            return "Move to Trash" if action == 3
            return "Retention" if action == 4
            return "Select eligible" if action == 5
            return "Clear selection" if action == 6
            return "Keep this file" if action == 7
            "Unavailable action"

        def action_name_with_reviews(action: i64, reviewing_restore: bool,
                                     reviewing_trash: bool) -> sview:
            return "Confirm move to Trash" if action == 3 and reviewing_trash
            action_name(action, reviewing_restore)

        def exemption_action_name(removing_exemption: bool, remove_name: sview) -> sview:
            return remove_name if removing_exemption
            "Keep this file"

        def action_help(action: i64, restore_available: bool, reviewing_restore: bool) -> sview:
            return "Reread the inventory and verify file identities. This does not delete files." if action == 0
            return "Close Storage & Recovery." if action == 1
            return "Confirm only after the selected receipt remains verified. The original file is never overwritten." if action == 2 and reviewing_restore and restore_available
            return "Restore the selected verified Trash receipt to its original build location. Review is required first." if action == 2 and restore_available
            return "Restore is unavailable because no selected, verified Trash receipt can be restored." if action == 2
            return "Move selected eligible Studio files to Finder Trash after a fresh review. Trash may continue to use disk space." if action == 3
            return "Choose how long generated files are retained before cleanup eligibility. Changing this setting does not move files." if action == 4
            return "Select eligible files from the current verified inventory. Protected and recovery-required records stay unselected." if action == 5
            return "Clear every selected row in the current inventory." if action == 6
            ""

        def action_help_with_cleanup(action: i64, restore_available: bool,
                                     reviewing_restore: bool, trash_available: bool,
                                     reviewing_trash: bool) -> sview:
            return "Confirm only after the selected eligible files remain verified. Trash may continue to use disk space." if action == 3 and reviewing_trash and trash_available
            return "Move to Trash is unavailable because no selected eligible files passed a fresh check." if action == 3 and not trash_available
            action_help(action, restore_available, reviewing_restore)

        def action_help_with_exemption(action: i64, exemption_available: bool,
                                       reviewing_exemption: bool,
                                       removing_exemption: bool) -> sview:
            return "The exemption cannot be changed until its saved list is verified and the selected file is eligible." if action == 7 and not exemption_available
            return "Confirm removal of this file's cleanup exemption. The file may become eligible for cleanup; movement still requires review and confirmation." if action == 7 and reviewing_exemption and removing_exemption
            return "Confirm keeping this file out of automatic cleanup." if action == 7 and reviewing_exemption
            return "Remove the saved cleanup exemption. The file may become eligible for cleanup; movement still requires review and confirmation." if action == 7 and removing_exemption
            return "Save a cleanup exemption for this file. It remains available in the inventory." if action == 7
            ""

        def retention_value(days: i64) -> sview:
            return "Retain 7 days" if days == 7
            return "Retain 30 days" if days == 30
            return "Retain 90 days" if days == 90
            return "Retain 365 days" if days == 365
            "Unsupported retention"

        def result_announcement(message: i64) -> sview:
            return "Storage is busy or its lock could not be acquired. This attempt did not move files. Refresh and retry." if message == 21
            return "The storage lock could not be released with certainty. Further moves are blocked. Check recovery receipts before restarting." if message == 22
            return "The cleanup exemption could not be saved. Refresh to verify the current state before retrying." if message == 19
            return "Cleanup exemption change saved. Changing protection does not move files; cleanup still requires review and confirmation." if message == 20
            return "Saved exemptions could not be read. Cleanup is blocked. Repair build/studio_storage_exemptions.txt, then Refresh." if message == 18
            return "Retention settings could not be read. Cleanup is blocked. Repair build/studio_storage_preferences.txt, then Refresh." if message == 16
            return "Retention settings could not be saved. The previous retention remains active. Refresh before retrying." if message == 17
            return "The storage inventory could not be read. No cleanup action is available." if message == 1
            return "The build folder could not be verified. No inventory paths are shown." if message == 2
            return "Inventory refreshed; all visible file identities are verified." if message == 3
            return "Inventory refreshed; one or more file identities could not be verified. Those records are protected." if message == 4
            return "Recovery changes could not be saved. Refresh to retry before taking action." if message == 5
            return "File restored to its original location. The inventory is updated." if message == 6
            return "Restore failed: the item is unavailable, changed, or its destination is occupied. Refresh to retry." if message == 7
            return "File restored, but the inventory could not be saved. Refresh to finish recovery." if message == 8
            return "The reviewed inventory changed. Review the refreshed inventory before taking action." if message == 9
            return "Selected files were moved to Finder Trash and recorded for recovery. Trash may still use disk space." if message == 10
            return "Move to Trash failed. A fresh identity check confirmed the original file remains in build/." if message == 11
            return "The Trash receipt could not be saved. A fresh identity check confirmed the file was restored to build/." if message == 12
            return "The Trash receipt could not be saved and rollback failed. The verified recovery receipt is retained for retry or manual recovery." if message == 13
            return "The move result is uncertain. Refresh to verify the item's location; check Finder Trash manually if it is not in build/." if message == 15
            ""
