# Accessible names, help, and live result copy for Storage & Recovery.
# Dynamic filenames remain caller-provided and should precede these fields.
module StudioStorageAccessibilityCopy:
    public:
        const STATUS_PRESENT: i64 = 0
        const STATUS_IN_TRASH: i64 = 1
        const STATUS_CHANGED: i64 = 2
        const STATUS_UNVERIFIED: i64 = 3
        const KIND_RECOVERY: i64 = 0
        const KIND_TEMP_EXPORT: i64 = 1
        const KIND_REPORT: i64 = 2

        struct RowCopy:
            kind: mutable sview
            status: mutable sview
            selection: mutable sview
            help: mutable sview

        def dialog_name(reviewing_restore: bool) -> sview:
            return "Confirm restore" if reviewing_restore
            "Storage & Recovery"

        def dialog_help(reviewing_restore: bool) -> sview:
            return "Confirm restoring the selected recovery receipt after a fresh identity check. The file returns to its original build location and will not overwrite an existing file." if reviewing_restore
            "Studio-managed reports and recovery receipts. Source takes are protected. Select an inventory row, refresh to check file identities, or choose Done to close."

        def kind_name(kind: i64) -> sview:
            return "Recovery" if kind == KIND_RECOVERY
            return "Temporary export" if kind == KIND_TEMP_EXPORT
            return "Quality report" if kind == KIND_REPORT
            "Unknown type"

        def status_name(status: i64) -> sview:
            return "Verified in build" if status == STATUS_PRESENT
            return "Verified in Trash" if status == STATUS_IN_TRASH
            return "Changed identity" if status == STATUS_CHANGED
            "Could not verify"

        def status_help(status: i64) -> sview:
            return "The registered file identity matches the file in build/." if status == STATUS_PRESENT
            return "The registered recovery receipt matches the file in Trash. Restore is available after review." if status == STATUS_IN_TRASH
            return "Protected: the file identity changed since registration. Restore is unavailable." if status == STATUS_CHANGED
            "Protected: the file identity could not be verified. Restore is unavailable."

        def selection_value(selected: bool) -> sview:
            return "Selected" if selected
            "Not selected"

        # Caller supplies the filename as the accessible row label. These
        # fields fill its value, selected state, and explanatory help.
        def row_copy(kind: i64, status: i64, selected: bool) -> RowCopy:
            return RowCopy{
                kind: kind_name(kind),
                status: status_name(status),
                selection: selection_value(selected),
                help: status_help(status)
            }

        def protected_summary(unverified: i64, hidden_protected: i64) -> sview:
            return "Unverified or changed records are protected; Restore is unavailable for them." if unverified > 0
            return "Protected records are hidden when they are outside build/ or match the active source take." if hidden_protected > 0
            "No additional protected records."

        def action_name(action: i64, reviewing_restore: bool) -> sview:
            return "Refresh" if action == 0
            return "Done" if action == 1
            return "Confirm restore" if action == 2 and reviewing_restore
            return "Restore" if action == 2
            "Unavailable action"

        def action_help(action: i64, restore_available: bool, reviewing_restore: bool) -> sview:
            return "Reread the inventory and verify file identities. This does not delete files." if action == 0
            return "Close Storage & Recovery." if action == 1
            return "Confirm only after the selected receipt remains verified. The original file is never overwritten." if action == 2 and reviewing_restore and restore_available
            return "Restore the selected verified Trash receipt to its original build location. Review is required first." if action == 2 and restore_available
            return "Restore is unavailable because no selected, verified Trash receipt can be restored." if action == 2
            ""

        def result_announcement(message: i64) -> sview:
            return "The storage inventory could not be read. No cleanup action is available." if message == 1
            return "The build folder could not be verified. No inventory paths are shown." if message == 2
            return "Inventory refreshed; all visible file identities are verified." if message == 3
            return "Inventory refreshed; one or more file identities could not be verified. Those records are protected." if message == 4
            return "Recovery changes could not be saved. Refresh to retry before taking action." if message == 5
            return "File restored to its original location. The inventory is updated." if message == 6
            return "Restore failed: the item is unavailable, changed, or its destination is occupied. Refresh to retry." if message == 7
            return "File restored, but the inventory could not be saved. Refresh to finish recovery." if message == 8
            return "The recovery item changed. Review the refreshed inventory before restoring." if message == 9
            ""
