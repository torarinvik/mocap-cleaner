# Keep original FBX identity with the editable GLB through evaluation/rebuild.
include "model.elisa"

extend StudioModel:
    public:
        def attach_source_reference(memo: mutable Memo&, reference: StudioTakeSourceRefPolicy::TakeSourceRef) -> bool:
            ensure result implies StudioTakeSourceRefPolicy::valid(reference)
            return false if not StudioTakeSourceRefPolicy::valid(reference)
            memo.source_reference <- reference
            true
