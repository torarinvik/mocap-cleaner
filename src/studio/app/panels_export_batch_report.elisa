include "panels_geometry.elisa"
include "../export_batch_warning_review_policy.elisa"
include "../export_batch_report_panel_policy.elisa"

# Uncomposed renderer for the durable prepared-export warning report. The
# caller supplies line views backed by its stable report-line cache; this
# immediate-mode panel does not retain or copy those views.
extend StudioPanels:
    private:
        const module BatchReportLayout:
            WIDTH: f32 = 960.0
            HEIGHT: f32 = 640.0
            INSET: f32 = 24.0
            LINE_TOP: f32 = 134.0
            LINE_HEIGHT: f32 = 22.0
            LINE_ROWS: i64 = StudioExportBatchReportPanelPolicy::Layout::PAGE_ROWS
            BUTTON_WIDTH: f32 = 190.0
            BUTTON_HEIGHT: f32 = 36.0
            BUTTON_GAP: f32 = 12.0
            BUTTON_BOTTOM: f32 = 72.0

    public:
        def export_batch_report_bounds(w: f32, h: f32) -> Box:
            box((w - BatchReportLayout::WIDTH) / 2.0,
                (h - BatchReportLayout::HEIGHT) / 2.0,
                BatchReportLayout::WIDTH, BatchReportLayout::HEIGHT)

        def export_batch_report_line_box(w: f32, h: f32, row: i64) -> Box:
            requires row >= 0 and row < BatchReportLayout::LINE_ROWS
            d: Box = export_batch_report_bounds(w, h)
            box(d.x + BatchReportLayout::INSET,
                d.y + BatchReportLayout::LINE_TOP + row.f32() * BatchReportLayout::LINE_HEIGHT,
                d.w - 2.0 * BatchReportLayout::INSET,
                BatchReportLayout::LINE_HEIGHT)

        def export_batch_report_line_hit(w: f32, h: f32, x: f32, y: f32,
                visible_count: i64) -> i64:
            requires visible_count >= 0 and visible_count <= BatchReportLayout::LINE_ROWS
            d: Box = export_batch_report_bounds(w, h)
            area: Box = box(d.x + BatchReportLayout::INSET, d.y + BatchReportLayout::LINE_TOP,
                d.w - 2.0 * BatchReportLayout::INSET,
                BatchReportLayout::LINE_HEIGHT * BatchReportLayout::LINE_ROWS.f32())
            return -1 if not inside(area, x, y)
            offset: i64 = ((y - area.y) / BatchReportLayout::LINE_HEIGHT).i64()
            StudioExportBatchReportPanelPolicy::line_at_offset(offset, visible_count)

        def export_batch_report_control_box(w: f32, h: f32,
                control: StudioExportBatchWarningReviewPolicy::Control) -> Box:
            d: Box = export_batch_report_bounds(w, h)
            slot: i64 = control.i64()
            total_width: f32 = BatchReportLayout::BUTTON_WIDTH * 4.0 + BatchReportLayout::BUTTON_GAP * 3.0
            start_x: f32 = d.x + (d.w - total_width) / 2.0
            box(start_x + slot.f32() * (BatchReportLayout::BUTTON_WIDTH + BatchReportLayout::BUTTON_GAP),
                d.y + d.h - BatchReportLayout::BUTTON_BOTTOM,
                BatchReportLayout::BUTTON_WIDTH, BatchReportLayout::BUTTON_HEIGHT)

        def export_batch_report_control_hit(w: f32, h: f32, x: f32, y: f32) -> StudioExportBatchWarningReviewPolicy::Control?:
            for code in 0..<4 |code, w, h, x, y|:
                control: StudioExportBatchWarningReviewPolicy::Control = report_control(code)
                return control if inside(export_batch_report_control_box(w, h, control), x, y)
            null

        def export_batch_report_panel(w: f32, h: f32,
                lines: darray[sview]&, page: usize, page_count: usize,
                focus: StudioExportBatchWarningReviewPolicy::Control,
                controls: StudioExportBatchWarningReviewPolicy::Controls,
                status: sview) -> void:
            requires lines.count <= BatchReportLayout::LINE_ROWS.usize()
            requires page_count == 0 or page < page_count
            d: Box = export_batch_report_bounds(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + BatchReportLayout::INSET, d.y + 25.0, 19.0, "Captured warning report", StudioDraw::ink())
            StudioDraw::text(d.x + BatchReportLayout::INSET, d.y + 53.0, 11.0,
                "Use Previous and Next to inspect the report. Acknowledge accepts warnings for this captured result.", StudioDraw::muted())
            StudioDraw::text(d.x + BatchReportLayout::INSET, d.y + 82.0, 12.0, status, StudioDraw::color(232, 190, 116)) if status.len > 0
            for row in 0..<BatchReportLayout::LINE_ROWS |row, lines, d|:
                if row < lines.count.i64():
                    y: f32 = d.y + BatchReportLayout::LINE_TOP + row.f32() * BatchReportLayout::LINE_HEIGHT
                    StudioDraw::rect(d.x + BatchReportLayout::INSET, y, d.w - 2.0 * BatchReportLayout::INSET,
                        BatchReportLayout::LINE_HEIGHT - 1.0, StudioDraw::color(31, 36, 47))
                    StudioDraw::text(d.x + BatchReportLayout::INSET + 8.0, y + 5.0, 10.0, lines[row], StudioDraw::ink())
            if lines.count == 0:
                StudioDraw::text(d.x + BatchReportLayout::INSET + 8.0,
                    d.y + BatchReportLayout::LINE_TOP + 8.0, 12.0,
                    "No report lines are available. The refusal status is shown above.", StudioDraw::muted())
            StudioText::begin()
            StudioText::put("Page ")
            StudioText::put_i(0 if page_count == 0 else page.i64() + 1)
            StudioText::put(" of ")
            StudioText::put_i(page_count.i64())
            StudioText::put(" · 16 wrapped lines per page")
            StudioDraw::text(d.x + BatchReportLayout::INSET, d.y + d.h - 104.0,
                10.0, StudioText::view(), StudioDraw::muted())
            for code in 0..<4 |code, w, h, focus, controls|:
                control: StudioExportBatchWarningReviewPolicy::Control = report_control(code)
                enabled: bool = StudioExportBatchWarningReviewPolicy::control_enabled(control, controls)
                b: Box = export_batch_report_control_box(w, h, control)
                StudioDraw::rect(b.x, b.y, b.w, b.h,
                    StudioDraw::color(65, 78, 102) if focus == control and enabled else StudioDraw::color(39, 45, 57))
                StudioDraw::segment(b.x, b.y, b.x + b.w, b.y, 1.0, StudioDraw::accent()) if focus == control and enabled
                StudioDraw::text(b.x + 12.0, b.y + 12.0, 10.0, StudioExportBatchWarningReviewPolicy::control_label(control),
                    StudioDraw::ink() if enabled else StudioDraw::color(95, 99, 108))
            StudioDraw::text(d.x + BatchReportLayout::INSET, d.y + d.h - 14.0, 9.0,
                "Tab moves enabled controls   ←/→ changes page   Enter activates   Esc returns to the queue", StudioDraw::muted())

    private:
        def report_control(code: i64) -> StudioExportBatchWarningReviewPolicy::Control:
            return StudioExportBatchWarningReviewPolicy::Control.Previous if code == 0
            return StudioExportBatchWarningReviewPolicy::Control.Next if code == 1
            return StudioExportBatchWarningReviewPolicy::Control.Acknowledge if code == 2
            StudioExportBatchWarningReviewPolicy::Control.Back
