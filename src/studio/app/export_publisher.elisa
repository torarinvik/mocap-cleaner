include "../publication_durability_policy.elisa"
# Prepare an exported GLB beside its destination, validate the bytes by
# reloading them, and publish with one same-filesystem rename. The destination
# remains untouched until commit succeeds.
include "../../../../elisa-engine-mocap/src/assets/glb_document.elisa"
include "../export_validation.elisa"

@link_name("mkstemp")
extern export_mkstemp(path_template: u8&) -> i32 can[Blocking.IO]
@link_name("close")
extern export_close(descriptor: i32) -> i32 can[Blocking.IO]
@link_name("open")
extern export_open(path: u8&, flags: i32) -> i32 can[Blocking.IO]
@link_name("fsync")
extern export_fsync(descriptor: i32) -> i32 can[Blocking.IO]
@link_name("unlink")
extern export_unlink(path: u8&) -> i32 can[Blocking.IO]
@link_name("link")
extern export_link(source: u8&, destination: u8&) -> i32 can[Blocking.IO]
@link_name("rename")
extern export_rename(source: u8&, destination: u8&) -> i32 can[Blocking.IO]
@link_name("strdup")
extern export_strdup(path: cstr) -> cstr? can[Memory.Allocate]
@link_name("fdopen")
extern export_fdopen(descriptor: i32, mode: u8&) -> mutable heap void&? can[Blocking.IO, Memory.Allocate]
@link_name("fwrite")
extern export_fwrite(bytes: u8&, size: usize, count: usize, file: mutable heap void&) -> usize can[Blocking.IO]
@link_name("fflush")
extern export_fflush(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fileno")
extern export_fileno(file: mutable heap void&) -> i32 can[Blocking.IO]
@link_name("fclose")
extern export_fclose(file: mutable heap void&) -> i32 can[Blocking.IO, Memory.Release]

module StudioExportPublisher:
    private:
        const module Capacity:
            PATH: usize = 4096
            TEMPORARY: usize = 4128

    public:
        # Creates and validates a private sibling temporary. The caller owns
        # the returned path and must either commit or discard it, then release
        # the path string with FilePanel::release_path.
        def prepare(doc: GlbDocument::Document&, destination: cstr, failure_code: mutable StudioExportValidation::Result&) -> cstr? can[Global{Read, Write}]:
            failure_code <- StudioExportValidation::Result.WRITE_FAILED
            mutable destination_length: usize = 0
            while destination_length < Capacity::PATH and destination[destination_length] != 0:
                destination_length <- destination_length + 1
            return null if destination_length == 0 or destination_length >= Capacity::PATH

            mutable temporary: u8[Capacity::TEMPORARY] = zeroed
            for index in 0..<destination_length |destination, temporary|:
                temporary[index] <- destination[index]
            suffix: cstr = ".mocap-export-XXXXXX"
            mutable suffix_length: usize = 0
            while suffix[suffix_length] != 0:
                temporary[destination_length + suffix_length] <- suffix[suffix_length]
                suffix_length <- suffix_length + 1
            temporary[destination_length + suffix_length] <- 0

            descriptor: i32 = export_mkstemp(&temporary[0])
            return null if descriptor < 0
            if export_close(descriptor) != 0:
                _ = export_unlink(&temporary[0])
                return null

            temporary_path: cstr = (&temporary[0]).cast[cstr] can Unsafe.PointerCast
            if not save_document(doc, temporary_path):
                _ = export_unlink(&temporary[0])
                return null

            # O_RDWR (2) lets fsync flush the file on both Darwin and Linux.
            read_descriptor: i32 = export_open(&temporary[0], 2)
            if read_descriptor < 0:
                _ = export_unlink(&temporary[0])
                return null
            synced: i32 = export_fsync(read_descriptor)
            closed: i32 = export_close(read_descriptor)
            if synced != 0 or closed != 0:
                _ = export_unlink(&temporary[0])
                return null

            can Global{Read, Write}:
                validation: StudioExportValidation::Result = validate_after_reload(doc, temporary_path)
                if validation != StudioExportValidation::Result.READY:
                    failure_code <- validation
                    _ = export_unlink(&temporary[0])
                    return null

                if export_strdup(temporary_path) is retained_path:
                    failure_code <- StudioExportValidation::Result.READY
                    return retained_path
                _ = export_unlink(&temporary[0])
                return null

        # Compatibility result reports publication, not crash durability.
        def commit(temporary: cstr, destination: cstr) -> bool:
            StudioPublicationDurabilityPolicy::published(commit_with_status(temporary, destination))

        def commit_with_status(temporary: cstr, destination: cstr) -> StudioPublicationDurabilityPolicy::Result:
            return StudioPublicationDurabilityPolicy::Result.NotPublished if export_rename(temporary.cast[u8&], destination.cast[u8&]) != 0
            StudioPublicationDurabilityPolicy::outcome(true, sync_parent(destination))

        struct ExclusiveCommit:
            status: StudioPublicationDurabilityPolicy::Result
            staging_removed: bool

        # New output publication cannot replace a destination created after
        # preflight. A successful link remains published if staging cleanup
        # fails; callers retain the owned temporary path for later resolution.
        def commit_new_with_status(temporary: cstr, destination: cstr) -> ExclusiveCommit:
            if export_link(temporary.cast[u8&], destination.cast[u8&]) != 0:
                return ExclusiveCommit{status: StudioPublicationDurabilityPolicy::Result.NotPublished, staging_removed: false}
            removed: bool = export_unlink(temporary.cast[u8&]) == 0
            status: StudioPublicationDurabilityPolicy::Result = StudioPublicationDurabilityPolicy::outcome(true, sync_parent(destination))
            ExclusiveCommit{status: status, staging_removed: removed}

        # Removes an uncommitted temporary; harmless after a successful rename.
        def discard(temporary: cstr) -> void:
            _ = export_unlink(temporary.cast[u8&])

        # Atomically writes a sidecar in the same directory. A failed report
        # write never changes the already-published GLB.
        def write_sidecar(path: cstr, bytes: darray[u8]&) -> bool:
            StudioPublicationDurabilityPolicy::published(write_sidecar_with_status(path, bytes))

        def write_sidecar_with_status(path: cstr, bytes: darray[u8]&) -> StudioPublicationDurabilityPolicy::Result:
            write_sidecar_mode(path, bytes, true)

        # Recovery uses atomic create-only publication. Existing sidecars are
        # never replaced, including when a file appears after preflight.
        def write_new_sidecar_with_status(path: cstr, bytes: darray[u8]&) -> StudioPublicationDurabilityPolicy::Result:
            write_sidecar_mode(path, bytes, false)

    private:
        def write_sidecar_mode(path: cstr, bytes: darray[u8]&, replace_existing: bool) -> StudioPublicationDurabilityPolicy::Result:
            mutable length: usize = 0
            while length < Capacity::PATH and path[length] != 0:
                length <- length + 1
            return StudioPublicationDurabilityPolicy::Result.NotPublished if length == 0 or length >= Capacity::PATH
            mutable temporary: u8[Capacity::TEMPORARY] = zeroed
            for index in 0..<length |path, temporary|:
                temporary[index] <- path[index]
            suffix: cstr = ".mocap-report-XXXXXX"
            mutable suffix_length: usize = 0
            while suffix[suffix_length] != 0:
                temporary[length + suffix_length] <- suffix[suffix_length]
                suffix_length <- suffix_length + 1
            temporary[length + suffix_length] <- 0
            descriptor: i32 = export_mkstemp(&temporary[0])
            return StudioPublicationDurabilityPolicy::Result.NotPublished if descriptor < 0
            file: mutable heap void&? = export_fdopen(descriptor, "wb".cast[u8&])
            if file == null:
                _ = export_close(descriptor)
                _ = export_unlink(&temporary[0])
                return StudioPublicationDurabilityPolicy::Result.NotPublished
            handle: mutable heap void& = file
            mutable wrote: usize = 0
            if bytes.count > 0:
                wrote <- export_fwrite(&bytes[0], 1, bytes.count, handle)
            flushed: i32 = export_fflush(handle)
            file_descriptor: i32 = export_fileno(handle)
            mutable synced: i32 = -1
            if file_descriptor >= 0:
                synced <- export_fsync(file_descriptor)
            closed: i32 = export_fclose(handle)
            if wrote != bytes.count or flushed != 0 or synced != 0 or closed != 0:
                _ = export_unlink(&temporary[0])
                return StudioPublicationDurabilityPolicy::Result.NotPublished
            mutable committed: bool = false
            if replace_existing:
                committed <- export_rename(&temporary[0], path.cast[u8&]) == 0
            else:
                committed <- export_link(&temporary[0], path.cast[u8&]) == 0
            if not committed:
                _ = export_unlink(&temporary[0])
                return StudioPublicationDurabilityPolicy::Result.NotPublished
            # A failed unlink can leave an owned staging hard link; publication
            # has already succeeded. Recovery inventory must account for it.
            if not replace_existing:
                _ = export_unlink(&temporary[0])
            StudioPublicationDurabilityPolicy::outcome(true, sync_parent(path))

    private:
        # A successful rename stays published even if directory fsync fails.
        def sync_parent(path: cstr) -> bool:
            mutable length: usize = 0
            mutable slash: usize = 0
            mutable found: bool = false
            while length < Capacity::PATH and path[length] != 0:
                if path[length] == 47:
                    slash <- length
                    found <- true
                length <- length + 1
            return false if length == 0 or length >= Capacity::PATH
            mutable parent: u8[Capacity::PATH] = zeroed
            if found:
                parent_length: usize = 1 if slash == 0 else slash
                for index in 0..<parent_length |parent, path, index|:
                    parent[index] <- path[index]
            else:
                parent[0] <- 46
            # O_RDONLY is zero on the supported POSIX hosts.
            descriptor: i32 = export_open(&parent[0], 0)
            return false if descriptor < 0
            synced: i32 = export_fsync(descriptor)
            closed: i32 = export_close(descriptor)
            synced == 0 and closed == 0

        def save_document(doc: GlbDocument::Document&, path: cstr) -> bool:
            wrote: usize = catch GlbDocument::save(doc, path):
                value: value
                error failure: return false
            wrote == GlbDocument::byte_count(doc)

        def validate_after_reload(doc: GlbDocument::Document&, path: cstr) -> StudioExportValidation::Result can[Global{Read, Write}]:
            written: GlbDocument::Document = catch GlbDocument::load(path):
                value: value
                error failure: return StudioExportValidation::Result.RELOAD_FAILED
            return StudioExportValidation::Result.CONTENT_MISMATCH if GlbDocument::first_difference(doc, written) != -1
            StudioExportValidation::Result.READY
