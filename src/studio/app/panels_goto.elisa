include "panels_geometry.elisa"
include "../timeline_goto_focus.elisa"

extend StudioPanels:
    private:
        const module GotoLayout:
            const WIDTH: f32 = 420.0
            const HEIGHT: f32 = 190.0
            const APPLY_X: f32 = 218.0
            const CANCEL_X: f32 = 70.0
            const ACTION_Y: f32 = 132.0
            const ACTION_WIDTH: f32 = 132.0
            const ACTION_HEIGHT: f32 = 36.0
            const INSET: f32 = 22.0
            const TITLE_Y: f32 = 22.0
            const TITLE_SIZE: f32 = 17.0
            const HELP_Y: f32 = 53.0
            const HELP_SECOND_Y: f32 = 68.0
            const HELP_SIZE: f32 = 12.0
            const FIELD_Y: f32 = 82.0
            const FIELD_HEIGHT: f32 = 34.0
            const FIELD_TEXT_X: f32 = 32.0
            const FIELD_TEXT_Y: f32 = 90.0
            const FIELD_TEXT_SIZE: f32 = 14.0
            const WARNING_Y: f32 = 119.0
            const WARNING_SIZE: f32 = 11.0
            const ACTION_TEXT_Y: f32 = 10.0
            const CANCEL_TEXT_X: f32 = 40.0
            const APPLY_TEXT_X: f32 = 46.0
            const BORDER_WIDTH: f32 = 1.2

        def goto_dialog_box(w: f32, h: f32) -> Box:
            box((w - GotoLayout::WIDTH) / 2.0, (h - GotoLayout::HEIGHT) / 2.0, GotoLayout::WIDTH, GotoLayout::HEIGHT)

        def goto_action_box(w: f32, h: f32, apply: bool) -> Box:
            d: Box = goto_dialog_box(w, h)
            box(d.x + (GotoLayout::APPLY_X if apply else GotoLayout::CANCEL_X), d.y + GotoLayout::ACTION_Y, GotoLayout::ACTION_WIDTH, GotoLayout::ACTION_HEIGHT)

        def goto_field_box(w: f32, h: f32) -> Box:
            d: Box = goto_dialog_box(w, h)
            box(d.x + GotoLayout::INSET, d.y + GotoLayout::FIELD_Y,
                d.w - 2.0 * GotoLayout::INSET, GotoLayout::FIELD_HEIGHT)

        def goto_focus_ring(b: Box) -> void can[Global{Read, Write}]:
            c: UiCore::Color = StudioDraw::accent()
            StudioDraw::segment(b.x, b.y, b.x + b.w, b.y, GotoLayout::BORDER_WIDTH, c)
            StudioDraw::segment(b.x, b.y + b.h, b.x + b.w, b.y + b.h, GotoLayout::BORDER_WIDTH, c)
            StudioDraw::segment(b.x, b.y, b.x, b.y + b.h, GotoLayout::BORDER_WIDTH, c)
            StudioDraw::segment(b.x + b.w, b.y, b.x + b.w, b.y + b.h, GotoLayout::BORDER_WIDTH, c)

    public:
        # Accessibility and painting use the same geometry without exposing
        # the private layout constants.
        def goto_dialog_bounds(w: f32, h: f32) -> Box:
            goto_dialog_box(w, h)

        def goto_field_bounds(w: f32, h: f32) -> Box:
            goto_field_box(w, h)

        def goto_action_bounds(w: f32, h: f32, apply: bool) -> Box:
            goto_action_box(w, h, apply)

        def goto_hit(w: f32, h: f32, x: f32, y: f32) -> StudioTimelineGotoFocus::Hit:
            return StudioTimelineGotoFocus::Hit.Apply if inside(goto_action_box(w, h, true), x, y)
            return StudioTimelineGotoFocus::Hit.Cancel if inside(goto_action_box(w, h, false), x, y)
            return StudioTimelineGotoFocus::Hit.Field if inside(goto_field_box(w, h), x, y)
            StudioTimelineGotoFocus::Hit.None

        def goto_dialog(w: f32, h: f32, value: sview, valid: bool, stale: bool) -> void can[Global{Read, Write}]:
            goto_dialog_focused(w, h, value, valid, stale, StudioTimelineGotoFocus::Control.Field)

        def goto_dialog_focused(w: f32, h: f32, value: sview, valid: bool, stale: bool, focus: StudioTimelineGotoFocus::Control) -> void can[Global{Read, Write}]:
            goto_entry_focused(w, h, value, valid, stale, focus, false)

        def goto_entry_focused(w: f32, h: f32, value: sview, valid: bool, stale: bool, focus: StudioTimelineGotoFocus::Control, time: bool) -> void can[Global{Read, Write}]:
            d: Box = goto_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, GotoLayout::BORDER_WIDTH, StudioDraw::color(104, 115, 134))
            StudioDraw::text(d.x + GotoLayout::INSET, d.y + GotoLayout::TITLE_Y, GotoLayout::TITLE_SIZE, "Go to time" if time else "Go to frame", StudioDraw::ink())
            StudioDraw::text(d.x + GotoLayout::INSET, d.y + GotoLayout::HELP_Y, GotoLayout::HELP_SIZE, "Enter seconds, e.g. 2.125 (up to 6 decimal places)." if time else "Enter a 1-based frame number.", StudioDraw::muted())
            StudioDraw::text(d.x + GotoLayout::INSET, d.y + GotoLayout::HELP_SECOND_Y, GotoLayout::HELP_SIZE, "Values past the take select its last frame.", StudioDraw::muted())
            StudioDraw::rect(d.x + GotoLayout::INSET, d.y + GotoLayout::FIELD_Y, d.w - 2.0 * GotoLayout::INSET, GotoLayout::FIELD_HEIGHT, StudioDraw::color(14, 17, 23))
            StudioDraw::text(d.x + GotoLayout::FIELD_TEXT_X, d.y + GotoLayout::FIELD_TEXT_Y, GotoLayout::FIELD_TEXT_SIZE, value, StudioDraw::ink())
            StudioDraw::text(d.x + GotoLayout::INSET, d.y + GotoLayout::WARNING_Y, GotoLayout::WARNING_SIZE, "Take changed; cancel and reopen." if stale else ("Enter valid seconds to apply." if time else "Enter a valid frame to apply."), StudioDraw::color(244, 174, 100)) if stale or not valid
            StudioDraw::rect(goto_action_box(w, h, false).x, goto_action_box(w, h, false).y, GotoLayout::ACTION_WIDTH, GotoLayout::ACTION_HEIGHT, StudioDraw::color(47, 55, 70))
            StudioDraw::rect(goto_action_box(w, h, true).x, goto_action_box(w, h, true).y, GotoLayout::ACTION_WIDTH, GotoLayout::ACTION_HEIGHT, StudioDraw::accent() if valid and not stale else StudioDraw::color(65, 69, 78))
            StudioDraw::text(goto_action_box(w, h, false).x + GotoLayout::CANCEL_TEXT_X, goto_action_box(w, h, false).y + GotoLayout::ACTION_TEXT_Y, GotoLayout::HELP_SIZE, "Cancel", StudioDraw::ink())
            StudioDraw::text(goto_action_box(w, h, true).x + GotoLayout::APPLY_TEXT_X, goto_action_box(w, h, true).y + GotoLayout::ACTION_TEXT_Y, GotoLayout::HELP_SIZE, "Apply", StudioDraw::ink())
            if focus == StudioTimelineGotoFocus::Control.Field:
                goto_focus_ring(goto_field_box(w, h))
            else:
                goto_focus_ring(goto_action_box(w, h, focus == StudioTimelineGotoFocus::Control.Apply))
