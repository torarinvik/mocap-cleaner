include "panels_geometry.elisa"

extend StudioPanels:
    private:
        def goto_dialog_box(w: f32, h: f32) -> Box:
            box((w - 420.0) / 2.0, (h - 190.0) / 2.0, 420.0, 190.0)

        def goto_action_box(w: f32, h: f32, apply: bool) -> Box:
            d: Box = goto_dialog_box(w, h)
            box(d.x + (if apply then 218.0 else 70.0), d.y + 132.0, 132.0, 36.0)

    public:
        def goto_hit(w: f32, h: f32, x: f32, y: f32) -> i64:
            return 0 if inside(goto_action_box(w, h, true), x, y)
            return 1 if inside(goto_action_box(w, h, false), x, y)
            -1

        def goto_dialog(w: f32, h: f32, value: sview, valid: bool, stale: bool) -> void:
            d: Box = goto_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::text(d.x + 22.0, d.y + 22.0, 17.0, "Go to frame", StudioDraw::ink())
            StudioDraw::text(d.x + 22.0, d.y + 53.0, 12.0, "Enter a 1-based frame number. Values past the take are clamped.", StudioDraw::muted())
            StudioDraw::rect(d.x + 22.0, d.y + 82.0, d.w - 44.0, 34.0, StudioDraw::color(14, 17, 23))
            StudioDraw::text(d.x + 32.0, d.y + 90.0, 14.0, value, StudioDraw::ink())
            StudioDraw::text(d.x + 22.0, d.y + 119.0, 11.0, "Take changed; cancel and reopen." if stale else ("Enter a valid frame to apply." if not valid else ""), StudioDraw::color(244, 174, 100)) if stale or not valid
            StudioDraw::rect(goto_action_box(w, h, false).x, goto_action_box(w, h, false).y, 132.0, 36.0, StudioDraw::color(47, 55, 70))
            StudioDraw::rect(goto_action_box(w, h, true).x, goto_action_box(w, h, true).y, 132.0, 36.0, StudioDraw::accent() if valid and not stale else StudioDraw::color(65, 69, 78))
            StudioDraw::text(goto_action_box(w, h, false).x + 40.0, goto_action_box(w, h, false).y + 10.0, 12.0, "Cancel", StudioDraw::ink())
            StudioDraw::text(goto_action_box(w, h, true).x + 46.0, goto_action_box(w, h, true).y + 10.0, 12.0, "Apply", StudioDraw::ink())
