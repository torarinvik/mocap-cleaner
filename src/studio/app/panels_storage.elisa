include "panels_geometry.elisa"
include "../storage_accessibility_policy.elisa"
include "../storage_footer_layout_policy.elisa"

extend StudioPanels:
    public:
        const module StorageAction:
            REFRESH: i64 = 0
            DONE: i64 = 1
            RESTORE: i64 = 2
            TRASH: i64 = 3
            RETENTION: i64 = 4
            SELECT_ELIGIBLE: i64 = 5
            CLEAR_SELECTION: i64 = 6
            EXEMPTION: i64 = 7
            INSPECT_PATH: i64 = 8
            FILTER: i64 = 9
            COUNT: i64 = 10
    public:
        const module StorageStatus:
            PRESENT: i64 = 0
            IN_TRASH: i64 = 1
            CHANGED: i64 = 2
            UNVERIFIED: i64 = 3
    private:
        const module StorageLayout:
            ROW_HEIGHT: f32 = 32.0
            VISIBLE_ROWS: i64 = 6

    public:
        def storage_dialog_box(w: f32, h: f32) -> Box:
            dialog_width: f32 = 760.0 if w >= 792.0 else w - 32.0
            dialog_height: f32 = 520.0 if h >= 552.0 else h - 32.0
            box((w - dialog_width) / 2.0, (h - dialog_height) / 2.0,
                dialog_width, dialog_height)

        def storage_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = storage_dialog_box(w, h)
            header: f32 = StudioStorageFooterLayoutPolicy::header_height(d.w.i64()).f32()
            content: f32 = StudioStorageFooterLayoutPolicy::content_height(d.w.i64()).f32()
            if header > 0.0:
                half_width: f32 = (d.w - 56.0) / 2.0
                return box(d.x + 24.0, d.y + 52.0, half_width, 30.0) if action == StorageAction::INSPECT_PATH
                return box(d.x + 32.0 + half_width, d.y + 52.0, half_width, 30.0) if action == StorageAction::EXEMPTION
                return box(d.x + 24.0 + (action - StorageAction::SELECT_ELIGIBLE).f32() * (half_width + 8.0),
                    d.y + 158.0, half_width, 30.0) if action == StorageAction::SELECT_ELIGIBLE or action == StorageAction::CLEAR_SELECTION
            return box(d.x + 24.0, d.y + 184.0 + content, 180.0, 26.0) if action == StorageAction::FILTER
            return box(d.x + d.w - 386.0, d.y + 16.0, 178.0, 30.0) if action == StorageAction::INSPECT_PATH
            return box(d.x + d.w - 202.0, d.y + 16.0, 178.0, 30.0) if action == StorageAction::EXEMPTION
            return box(d.x + 430.0 + (action - StorageAction::SELECT_ELIGIBLE).f32() * 148.0, d.y + 95.0, 132.0, 30.0) if action >= StorageAction::SELECT_ELIGIBLE
            columns: i64 = StudioStorageFooterLayoutPolicy::columns(d.w.i64())
            rows: i64 = StudioStorageFooterLayoutPolicy::rows(d.w.i64())
            column_width: f32 = (d.w - 48.0 - (columns - 1).f32() * 8.0) / columns.f32()
            box(d.x + 24.0 + (action % columns).f32() * (column_width + 8.0),
                d.y + d.h - 54.0 - (rows - 1 - action / columns).f32() * 42.0,
                column_width, 38.0)

        def storage_row_box(w: f32, h: f32, visible_row: i64) -> Box:
            d: Box = storage_dialog_box(w, h)
            box(d.x + 22.0, d.y + 216.0 + StudioStorageFooterLayoutPolicy::content_height(d.w.i64()).f32() + visible_row.f32() * StorageLayout::ROW_HEIGHT,
                d.w - 44.0, StorageLayout::ROW_HEIGHT - 2.0)

        def storage_visible_count(w: f32, h: f32, count: i64, selected: i64) -> i64:
            return 0 if count <= 0
            d: Box = storage_dialog_box(w, h)
            available: f32 = d.h - 342.0 - StudioStorageFooterLayoutPolicy::content_height(d.w.i64()).f32() - StudioStorageFooterLayoutPolicy::extra_height(d.w.i64()).f32()
            return 0 if available < StorageLayout::ROW_HEIGHT
            capacity: i64 = (available / StorageLayout::ROW_HEIGHT).i64()
            limit: i64 = StorageLayout::VISIBLE_ROWS if capacity > StorageLayout::VISIBLE_ROWS else capacity
            limit if count > limit else count

        def storage_first_visible(w: f32, h: f32, count: i64, selected: i64) -> i64:
            limit: i64 = storage_visible_count(w, h, count, selected)
            return 0 if limit <= 0 or count <= limit
            safe_selected: i64 = 0 if selected < 0 else count - 1 if selected >= count else selected
            StudioStorageWindowPolicy::first_visible(count, limit, safe_selected)

        def storage_row_hit(w: f32, h: f32, px: f32, py: f32,
                            count: i64, selected: i64) -> i64:
            first: i64 = storage_first_visible(w, h, count, selected)
            for visible_row in 0..<storage_visible_count(w, h, count, selected) |visible_row, first, w, h, px, py|:
                return first + visible_row if inside(storage_row_box(w, h, visible_row), px, py)
            -1

        def storage_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<StorageAction::COUNT |action, w, h, px, py|:
                return action if inside(storage_button_box(w, h, action), px, py)
            -1

        def storage_entry_name(entries: darray[StudioStorageManifest::Entry]&,
                               index: i64) -> sview:
            StudioText::begin()
            return StudioText::view() if index < 0 or index >= entries.count.i64()
            entry: StudioStorageManifest::Entry = entries[index]
            mutable first: usize = 0
            for byte_index in 0..<entry.original_path.count |entry|:
                first <- byte_index + 1 if entry.original_path[byte_index] == 47
            if first >= entry.original_path.count:
                StudioText::put("(unknown name)")
            else:
                remaining: usize = entry.original_path.count - first
                copied: usize = StudioTextTruncationPolicy::copy_count(remaining, StudioText::Buffer::WIDTH)
                for byte_index in first..<(first + copied) |entry|:
                    StudioText::byte(entry.original_path[byte_index])
                return StudioText::truncated_view() if entry.original_path.count - first > StudioText::Buffer::WIDTH
            StudioText::view()

    private:
        def storage_kind_label(kind: i64) -> sview:
            return "Recovery" if kind == StudioStorageCleanupPolicy::Kind.Recovery.i64()
            return "Temporary export" if kind == StudioStorageCleanupPolicy::Kind.TempExport.i64()
            return "Quality report" if kind == StudioStorageCleanupPolicy::Kind.GeneratedReport.i64()
            "Unknown type"

        def storage_entry_status(status: i64) -> sview:
            return "Verified in build" if status == StorageStatus::PRESENT
            return "Verified in Trash" if status == StorageStatus::IN_TRASH
            return "Changed identity" if status == StorageStatus::CHANGED
            "Could not verify"

    public:
        def storage_protection_label(reason: i64) -> sview:
            return "Kept by you: excluded from cleanup" if reason == StudioStorageCleanupPolicy::ProtectionReason.UserExemption.i64()
            return "Eligible after review" if reason == StudioStorageCleanupPolicy::ProtectionReason.None.i64()
            return "Protected: current document" if reason == StudioStorageCleanupPolicy::ProtectionReason.OpenDocument.i64()
            return "Protected: recovery needs verification" if reason == StudioStorageCleanupPolicy::ProtectionReason.SessionReference.i64()
            return "Protected: below retention age" if reason == StudioStorageCleanupPolicy::ProtectionReason.Retention.i64()
            return "Protected: source take" if reason == StudioStorageCleanupPolicy::ProtectionReason.SourceTake.i64()
            return "Protected: symbolic link" if reason == StudioStorageCleanupPolicy::ProtectionReason.Symlink.i64()
            return "Protected: identity changed" if reason == StudioStorageCleanupPolicy::ProtectionReason.IdentityChanged.i64()
            return "Protected: identity unverified" if reason == StudioStorageCleanupPolicy::ProtectionReason.IdentityUnverified.i64()
            "Protected: age or file facts unverified"

        def storage_batch_item_label(item: i64) -> sview:
            return "Not attempted" if item == StudioStorageBatchPolicy::ItemStatus.NotAttempted.i64()
            return "Moved to Trash" if item == StudioStorageBatchPolicy::ItemStatus.Recorded.i64()
            return "Move failed" if item == StudioStorageBatchPolicy::ItemStatus.KnownFailed.i64()
            return "Restored after error" if item == StudioStorageBatchPolicy::ItemStatus.Restored.i64()
            return "Recovery needed" if item == StudioStorageBatchPolicy::ItemStatus.RecoveryRequired.i64()
            return "Location uncertain" if item == StudioStorageBatchPolicy::ItemStatus.Unknown.i64()
            "Invalid result"

        def storage_batch_state_label(state: i64) -> sview:
            return "Cleanup running; Cancel stops before the next file" if state == StudioStorageBatchPolicy::State.Running.i64()
            return "Cleanup cancelled" if state == StudioStorageBatchPolicy::State.Cancelled.i64()
            return "Cleanup finished" if state == StudioStorageBatchPolicy::State.Complete.i64()
            return "Cleanup stopped; reviewed inventory changed" if state == StudioStorageBatchPolicy::State.StopReviewChanged.i64()
            return "Cleanup stopped for receipt recovery; inspect refreshed results" if state == StudioStorageBatchPolicy::State.StopRecoveryRequired.i64()
            return "Cleanup stopped after an uncertain move; Refresh verifies its location" if state == StudioStorageBatchPolicy::State.StopUnknown.i64()
            "Cleanup stopped; invalid state"

        def storage_batch_row_status(entry: StudioStorageManifest::Entry,
                                     reviewed: darray[StudioStorageManifest::Entry]&, items: darray[i64]&) -> i64:
            for index in 0..<reviewed.count |reviewed, items, entry|:
                previous: StudioStorageManifest::Entry = reviewed[index]
                if index < items.count and StudioStorageIdentityPolicy::matches(previous.device, entry.device, previous.inode, entry.inode, previous.size_bytes, entry.size_bytes, previous.modified_seconds, entry.modified_seconds, previous.modified_nanoseconds, entry.modified_nanoseconds, StudioStorageManifest::same_path(previous.original_path, entry.original_path)):
                    return items[index]
            -1

        def storage_overview_name(category: i64) -> sview:
            return "Eligible" if category == 0
            return "Protected" if category == 1
            return "Recovery" if category == 2
            return "In Trash" if category == 3
            "Unverified"

        def storage_panel(w: f32, h: f32, opened: bool,
                          entries: darray[StudioStorageManifest::Entry]&,
                          statuses: darray[i64]&, reasons: darray[i64]&, cleanup_selected: darray[StudioStorageManifest::Entry]&,
                          selected: i64, focus: i64, message: i64, complete_count: i64, filter_mode: i64, hidden_selected: i64,
                          protected_records: i64, unverified_records: i64,
                          restore_available: bool, restore_review: bool, trash_available: bool, trash_review: bool, exemption_available: bool, exemption_kept: bool, inspect_available: bool,
                          overview_counts: darray[i64]&, overview_bytes: darray[i64]&, scan_seconds: i64, retention_days: i64, selection_bytes: i64, selection_removed: i64, batch_state: i64, batch_completed: i64, batch_failed: i64,
                          batch_untouched: i64, batch_entries: darray[StudioStorageManifest::Entry]&, batch_items: darray[i64]&) -> void:
            return if not opened
            d: Box = storage_dialog_box(w, h)
            header: f32 = StudioStorageFooterLayoutPolicy::header_height(d.w.i64()).f32()
            content: f32 = StudioStorageFooterLayoutPolicy::content_height(d.w.i64()).f32()
            footer: f32 = d.y + d.h - 110.0 - StudioStorageFooterLayoutPolicy::extra_height(d.w.i64()).f32()
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 19.0, "Review Move to Trash" if trash_review else "Storage & Recovery", StudioDraw::ink())
            if trash_review and cleanup_selected.count == 1:
                StudioDraw::bold(d.x + 24.0, d.y + 52.0 + header, 12.0, storage_entry_name(cleanup_selected, 0), StudioDraw::ink())
                selected_entry: StudioStorageManifest::Entry = cleanup_selected[0]
                StudioText::begin()
                StudioText::put("Original: ")
                for byte in selected_entry.original_path:
                    StudioText::byte(byte)
                StudioDraw::text(d.x + 24.0, d.y + 72.0 + header, 10.0, StudioText::view(), StudioDraw::muted())
            else:
                StudioDraw::text(d.x + 24.0, d.y + 52.0 + header, 12.0,
                    "Studio records generated reports and recovery receipts under build/.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, d.y + 72.0 + header, 11.0,
                    "Source takes are protected. Retention changes eligibility; files move only after confirmation.", StudioDraw::muted())
            if not StudioStorageScanTimePolicy::supported(scan_seconds):
                StudioDraw::text(d.x + 24.0, d.y + 88.0 + header, 10.0,
                    StudioStorageAccessibilityCopy::last_scan_unknown(), StudioDraw::muted())
            else:
                StudioText::begin()
                StudioStorageScanTimeCopy::append(scan_seconds)
                StudioDraw::text(d.x + 24.0, d.y + 88.0 + header, 10.0, StudioText::view(), StudioDraw::muted())
            StudioText::begin()
            StudioStorageFilterCopy::append_selection(cleanup_selected.count.i64(), hidden_selected, selection_bytes)
            StudioDraw::text(d.x + 24.0, d.y + 106.0 + header, 12.0, StudioText::view(), StudioDraw::accent())
            for category in 0..<overview_counts.count |category, overview_counts, overview_bytes, d, content|:
                column: f32 = d.x + 24.0 + category.f32() * 178.0
                StudioText::begin()
                StudioText::put(storage_overview_name(category.i64()))
                StudioText::put(": ")
                StudioText::put_i(overview_counts[category])
                StudioDraw::text(column, d.y + 132.0 + content, 11.0, StudioText::view(), StudioDraw::ink())
                StudioText::begin()
                StudioText::put_i(overview_bytes[category])
                StudioText::put(" logical bytes")
                StudioDraw::text(column, d.y + 148.0 + content, 10.0, StudioText::view(), StudioDraw::muted())
            if selected >= 0 and selected < entries.count.i64():
                selected_entry: StudioStorageManifest::Entry = entries[selected]
                StudioText::begin()
                StudioText::put("Selected file: ")
                StudioText::put_i(selected_entry.size_bytes)
                StudioText::put(" bytes  |  Modified: ")
                age_status: i64 = StudioStorageAgePolicy::timestamp_status(selected_entry.modified_seconds, scan_seconds)
                if age_status == StudioStorageAgePolicy::Status::VALID:
                    StudioText::put_i(StudioStorageAgePolicy::completed_age_days(selected_entry.modified_seconds, scan_seconds))
                    StudioText::put(" completed days ago")
                elif age_status == StudioStorageAgePolicy::Status::FUTURE:
                    StudioText::put("future timestamp; age unverified")
                else:
                    StudioText::put("age unavailable; Refresh to retry")
                StudioDraw::text(d.x + 24.0, d.y + 168.0 + content, 11.0, StudioText::view(), StudioDraw::muted())
            else:
                StudioDraw::bold(d.x + 24.0, d.y + 168.0 + content, 11.0, "Logical sizes do not estimate disk space freed. Unverified sizes are excluded.", StudioDraw::muted())
            StudioText::begin()
            StudioText::put("Matching: ")
            StudioText::put_i(entries.count.i64())
            StudioText::put(" of ")
            StudioText::put_i(complete_count)
            StudioText::put(". Select eligible uses this filter.")
            StudioDraw::text(d.x + 216.0, d.y + 194.0 + content, 10.0, StudioText::view(), StudioDraw::muted())
            first: i64 = storage_first_visible(w, h, entries.count.i64(), selected)
            for visible_row in 0..<storage_visible_count(w, h, entries.count.i64(), selected) |visible_row, first, entries, statuses, selected, cleanup_selected, reasons, batch_entries, batch_items, batch_state, d|:
                index: i64 = first + visible_row
                row: Box = storage_row_box(w, h, visible_row)
                entry: StudioStorageManifest::Entry = entries[index]
                row_status: i64 = statuses[index] if index < statuses.count else StorageStatus::UNVERIFIED
                StudioDraw::rect(row.x, row.y, row.w, row.h,
                    StudioDraw::color(47, 55, 70) if index == selected else StudioDraw::panel())
                mutable checked: bool = false
                for picked in cleanup_selected |picked, entry, checked|:
                    checked <- true if StudioStorageIdentityPolicy::matches(picked.device, entry.device, picked.inode, entry.inode, picked.size_bytes, entry.size_bytes, picked.modified_seconds, entry.modified_seconds, picked.modified_nanoseconds, entry.modified_nanoseconds, StudioStorageManifest::same_path(picked.original_path, entry.original_path))
                StudioDraw::text(row.x + 8.0, row.y + 8.0, 12.0, "[x]" if checked else "[ ]" if index < reasons.count.i64() and reasons[index] == StudioStorageCleanupPolicy::ProtectionReason.None.i64() else "[-]", StudioDraw::accent() if checked else StudioDraw::muted())
                filename_width: f32 = StudioStorageFooterLayoutPolicy::filename_width(row.w.i64()).f32()
                # This top-level panel records each name with an isolated clip;
                # full path inspection and semantic row names remain available.
                if filename_width > 0.0:
                    filename: sview = storage_entry_name(entries, index)
                    measured: UiTextMetrics::WidthMeasurement = UiTextMetrics::width_checked(filename, 12.0, false)
                    marker: UiTextMetrics::WidthMeasurement = UiTextMetrics::width_checked("...", 12.0, false)
                    overflow: bool = measured.available and marker.available and measured.width > filename_width and marker.width + 4.0 < filename_width
                    text_width: f32 = filename_width - marker.width - 4.0 if overflow else filename_width
                    UiCore::set_clip(UiCore::Rect(row.x + 34.0, row.y, text_width, row.h))
                    StudioDraw::text(row.x + 34.0, row.y + 8.0, 12.0, filename, StudioDraw::ink())
                    UiCore::clear_clip()
                    StudioDraw::text(row.x + 34.0 + filename_width - marker.width, row.y + 8.0,
                        12.0, "...", StudioDraw::ink()) if overflow
                StudioDraw::text(row.x + row.w - 265.0, row.y + 8.0, 11.0,
                    storage_kind_label(entry.kind), StudioDraw::muted())
                batch_item: i64 = storage_batch_row_status(entry, batch_entries, batch_items)
                StudioDraw::text(row.x + row.w - 130.0, row.y + 8.0, 11.0,
                    storage_entry_status(row_status),
                    StudioDraw::accent() if row_status == StorageStatus::IN_TRASH else StudioDraw::severity_color(2) if row_status == StorageStatus::CHANGED or row_status == StorageStatus::UNVERIFIED else StudioDraw::muted())
                if batch_state != StudioStorageBatchPolicy::State.Idle.i64() and batch_item >= 0:
                    StudioText::begin()
                    StudioText::put("Batch: ")
                    StudioText::put(storage_batch_item_label(batch_item))
                    StudioDraw::text(row.x + row.w - 265.0, row.y + 21.0, 9.0, StudioText::view(), StudioDraw::color(240, 170, 110) if batch_item >= StudioStorageBatchPolicy::ItemStatus.RecoveryRequired.i64() else StudioDraw::muted())
            if entries.count == 0:
                StudioText::begin()
                StudioStorageFilterCopy::append_empty(complete_count, filter_mode)
                StudioDraw::text(d.x + 30.0, d.y + 230.0 + content, 12.0, StudioText::view(), StudioDraw::muted())
            if batch_state != StudioStorageBatchPolicy::State.Idle.i64():
                StudioText::begin()
                StudioText::put("Moved and recorded: ")
                StudioText::put_i(batch_completed)
                StudioText::put("   Failed/restored: ")
                StudioText::put_i(batch_failed)
                StudioText::put("   Untouched: ")
                StudioText::put_i(batch_untouched)
                StudioDraw::text(d.x + 24.0, footer, 11.0, StudioText::view(), StudioDraw::ink())
            elif not restore_review and not trash_review:
                selected_reason: i64 = reasons[selected] if selected >= 0 and selected < reasons.count.i64() else StudioStorageCleanupPolicy::ProtectionReason.IdentityUnverified.i64()
                StudioDraw::text(d.x + 24.0, footer, 11.0,
                    storage_protection_label(selected_reason) if selected >= 0 else "Choose an inventory row to inspect its cleanup protection.", StudioDraw::muted())
            if message == 21 or message == 22:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Storage busy/unavailable. Refresh and retry; this attempt moved no files." if message == 21 else "Lock release uncertain. Moves blocked; inspect receipts before restarting.", StudioDraw::color(240, 170, 110))
            elif trash_review:
                StudioDraw::text(d.x + 24.0, footer, 11.0,
                    "Move all selected files, including hidden selections, to Finder Trash?" if hidden_selected > 0 else "Move the selected files to Finder Trash? Original locations are recorded for Restore.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Trash still uses disk space until emptied in Finder. Confirm Trash proceeds; Esc cancels.", StudioDraw::accent())
            elif restore_review:
                StudioDraw::text(d.x + 24.0, footer, 11.0,
                    "Restore the selected file to its original build location? Existing files will not be overwritten.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Choose Confirm restore to proceed, or press Esc to cancel.", StudioDraw::accent())
            elif batch_state == StudioStorageBatchPolicy::State.Running.i64():
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup is running one file at a time. Cancel or Esc stops before the next file.", StudioDraw::accent())
            elif batch_state == StudioStorageBatchPolicy::State.Cancelled.i64():
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup cancelled. Completed receipts are saved; remaining files were left untouched.", StudioDraw::muted())
            elif batch_state == StudioStorageBatchPolicy::State.StopReviewChanged.i64():
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup stopped: the inventory changed or files became protected. Review the remaining selection.", StudioDraw::color(240, 170, 110))
            elif batch_state == StudioStorageBatchPolicy::State.StopUnknown.i64() or batch_state == StudioStorageBatchPolicy::State.StopRecoveryRequired.i64() or batch_state == StudioStorageBatchPolicy::State.StopInvalid.i64():
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, storage_batch_state_label(batch_state), StudioDraw::color(240, 170, 110))
            elif batch_state == StudioStorageBatchPolicy::State.Complete.i64():
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup finished. Recorded Trash files can be restored; Trash still uses disk space.", StudioDraw::color(150, 210, 160))
            elif message == 19:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Exemption save could not be confirmed. Refresh to inspect saved protection before retrying.", StudioDraw::color(240, 170, 110))
            elif message == 20:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Exemption saved. Eligibility refreshed; no files were moved. Move still requires review.", StudioDraw::color(150, 210, 160))
            elif message == 18:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Exemptions unreadable. Cleanup blocked; repair build/studio_storage_exemptions.txt and Refresh.", StudioDraw::color(240, 170, 110))
            elif message == 16:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Retention settings unreadable. Cleanup blocked; repair build/studio_storage_preferences.txt and Refresh.", StudioDraw::color(240, 170, 110))
            elif message == 17:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Retention could not be saved. Previous setting remains active; Refresh before retrying.", StudioDraw::color(240, 170, 110))
            elif message == 10:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File moved to Trash; its receipt is saved. Restore is available. Trash still uses disk space.", StudioDraw::color(150, 210, 160))
            elif message == 11:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Move failed. A fresh check confirmed the original file remains in build/. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 12:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Receipt save failed; a fresh check confirmed the file was restored. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 13:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Receipt save and rollback failed. Receipt retained; Refresh to retry or recover in Finder Trash.", StudioDraw::color(240, 170, 110))
            elif message == 15:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File location is uncertain. Refresh to verify; inspect build/ and Finder Trash before retrying.", StudioDraw::color(240, 170, 110))
            elif message == 6:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File restored to its original location. The inventory is updated.", StudioDraw::color(150, 210, 160))
            elif message == 7:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Restore failed: the item is unavailable, changed, or its destination is occupied. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 8:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File restored, but the inventory could not be saved. Refresh to finish recovery.", StudioDraw::color(240, 170, 110))
            elif message == 9:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "The reviewed inventory changed. Review the refreshed inventory before restoring.", StudioDraw::color(240, 170, 110))
            elif message == 1:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "The inventory could not be read. No cleanup action is available.", StudioDraw::color(240, 170, 110))
            elif message == 5:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Recovery changes could not be saved. Refresh to retry before taking action.", StudioDraw::color(240, 170, 110))
            elif message == 2:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "The build folder could not be verified. No inventory paths are shown.", StudioDraw::color(240, 170, 110))
            elif selection_removed > 0:
                StudioText::begin()
                StudioText::put_i(selection_removed)
                StudioText::put(" selected file(s) removed: identity changed, missing, or now protected. Review again.")
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif unverified_records > 0:
                StudioText::begin()
                StudioText::put_i(unverified_records)
                StudioText::put(" item(s) are protected: file identity changed or could not be checked.")
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif protected_records > 0:
                StudioText::begin()
                StudioText::put_i(protected_records)
                StudioText::put(" record(s) are hidden outside build/ or match the active take.")
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif message == 3:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "No records match this filter. Choose another filter; selected files stay selected." if entries.count == 0 and complete_count > 0 else "No registered files. Generated artifacts appear here; source takes stay protected." if complete_count == 0 else "No eligible files. Review protection reasons and retention; Refresh after changes." if overview_counts.count > 0 and overview_counts[0] == 0 else "Inventory refreshed; all visible file identities are verified.", StudioDraw::color(150, 210, 160))
            StudioDraw::text(d.x + 24.0, footer + 46.0, 10.0,
                "Up / Down chooses a row   Enter opens path   Space selects   Tab moves to buttons   Esc cancels", StudioDraw::muted())
            for action in 0..<StorageAction::COUNT |action, w, h, focus, restore_available, restore_review, trash_available, trash_review, retention_days, batch_state, exemption_available, exemption_kept, inspect_available, filter_mode|:
                b: Box = storage_button_box(w, h, action)
                StudioDraw::rect(b.x, b.y, b.w, b.h,
                    StudioDraw::color(58, 52, 40) if focus == action else StudioDraw::panel())
                StudioDraw::bold(b.x + 12.0, b.y + 11.0, 12.0,
                    StudioStorageFilterCopy::mode_name(filter_mode) if action == StorageAction::FILTER else "Inspect full path" if action == StorageAction::INSPECT_PATH else ("Remove exemption" if exemption_kept else "Keep this file") if action == StorageAction::EXEMPTION else "Select eligible" if action == StorageAction::SELECT_ELIGIBLE else "Clear selection" if action == StorageAction::CLEAR_SELECTION else "Refresh" if action == StorageAction::REFRESH else ("Cancel" if batch_state == StudioStorageBatchPolicy::State.Running.i64() else "Done") if action == StorageAction::DONE else ("Confirm restore" if restore_review else "Restore") if action == StorageAction::RESTORE else ("Confirm Trash" if trash_review else "Move to Trash") if action == StorageAction::TRASH else StudioStorageAccessibilityCopy::retention_value(retention_days),
                    StudioDraw::muted() if (batch_state == StudioStorageBatchPolicy::State.Running.i64() and action != StorageAction::DONE) or (action == StorageAction::RESTORE and not restore_available) or (action == StorageAction::TRASH and not trash_available) or (action == StorageAction::EXEMPTION and not exemption_available) or (action == StorageAction::INSPECT_PATH and not inspect_available) or (action == StorageAction::FILTER and not StudioStorageAccessibilityPolicy::filter_admitted(batch_state == StudioStorageBatchPolicy::State.Running.i64(), restore_review or trash_review)) else StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if focus == action

