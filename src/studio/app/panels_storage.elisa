include "panels_geometry.elisa"

extend StudioPanels:
    public:
        const STORAGE_REFRESH: i64 = 0
        const STORAGE_DONE: i64 = 1
        const STORAGE_RESTORE: i64 = 2
        const STORAGE_TRASH: i64 = 3
        const STORAGE_RETENTION: i64 = 4
        const STORAGE_SELECT_ELIGIBLE: i64 = 5
        const STORAGE_CLEAR_SELECTION: i64 = 6
        const STORAGE_EXEMPTION: i64 = 7
        const STORAGE_ACTION_COUNT: i64 = 8
        const STORAGE_STATUS_PRESENT: i64 = 0
        const STORAGE_STATUS_IN_TRASH: i64 = 1
        const STORAGE_STATUS_CHANGED: i64 = 2
        const STORAGE_STATUS_UNVERIFIED: i64 = 3
    private:
        const STORAGE_ROW_HEIGHT: f32 = 32.0
        const STORAGE_VISIBLE_ROWS: i64 = 6

    public:
        def storage_dialog_box(w: f32, h: f32) -> Box:
            dialog_width: f32 = 760.0 if w >= 792.0 else w - 32.0
            dialog_height: f32 = 520.0 if h >= 552.0 else h - 32.0
            box((w - dialog_width) / 2.0, (h - dialog_height) / 2.0,
                dialog_width, dialog_height)

        def storage_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = storage_dialog_box(w, h)
            return box(d.x + d.w - 202.0, d.y + 16.0, 178.0, 30.0) if action == STORAGE_EXEMPTION
            return box(d.x + 430.0 + (action - STORAGE_SELECT_ELIGIBLE).f32() * 148.0, d.y + 95.0, 132.0, 30.0) if action >= STORAGE_SELECT_ELIGIBLE
            box(d.x + 24.0 + action.f32() * 148.0, d.y + d.h - 54.0, 132.0, 38.0)

        def storage_row_box(w: f32, h: f32, visible_row: i64) -> Box:
            d: Box = storage_dialog_box(w, h)
            box(d.x + 22.0, d.y + 184.0 + visible_row.f32() * STORAGE_ROW_HEIGHT,
                d.w - 44.0, STORAGE_ROW_HEIGHT - 2.0)

        def storage_visible_count(w: f32, h: f32, count: i64, selected: i64) -> i64:
            return 0 if count <= 0
            d: Box = storage_dialog_box(w, h)
            available: f32 = d.h - 310.0
            return 0 if available < STORAGE_ROW_HEIGHT
            capacity: i64 = (available / STORAGE_ROW_HEIGHT).i64()
            limit: i64 = STORAGE_VISIBLE_ROWS if capacity > STORAGE_VISIBLE_ROWS else capacity
            limit if count > limit else count

        def storage_first_visible(w: f32, h: f32, count: i64, selected: i64) -> i64:
            limit: i64 = storage_visible_count(w, h, count, selected)
            return 0 if limit <= 0 or count <= limit
            safe_selected: i64 = 0 if selected < 0 else count - 1 if selected >= count else selected
            StudioStorageWindowPolicy::first_visible(count, limit, safe_selected)

        def storage_row_hit(w: f32, h: f32, px: f32, py: f32,
                            count: i64, selected: i64) -> i64:
            first: i64 = storage_first_visible(w, h, count, selected)
            for visible_row in 0..<storage_visible_count(w, h, count, selected) |visible_row, first, w, h, px, py|:
                return first + visible_row if inside(storage_row_box(w, h, visible_row), px, py)
            -1

        def storage_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<STORAGE_ACTION_COUNT |action, w, h, px, py|:
                return action if inside(storage_button_box(w, h, action), px, py)
            -1

        def storage_entry_name(entries: darray[StudioStorageManifest::Entry]&,
                               index: i64) -> sview:
            StudioText::begin()
            return StudioText::view() if index < 0 or index >= entries.count.i64()
            entry: StudioStorageManifest::Entry = entries[index]
            mutable first: usize = 0
            for byte_index in 0..<entry.original_path.count |entry|:
                first <- byte_index + 1 if entry.original_path[byte_index] == 47
            if first >= entry.original_path.count:
                StudioText::put("(unknown name)")
            else:
                for byte_index in first..<entry.original_path.count |entry|:
                    StudioText::byte(entry.original_path[byte_index])
            StudioText::view()

    private:
        def storage_kind_label(kind: i64) -> sview:
            return "Recovery" if kind == StudioStorageCleanupPolicy::RECOVERY
            return "Temporary export" if kind == StudioStorageCleanupPolicy::TEMP_EXPORT
            return "Quality report" if kind == StudioStorageCleanupPolicy::GENERATED_REPORT
            "Unknown type"

        def storage_entry_status(status: i64) -> sview:
            return "Verified in build" if status == STORAGE_STATUS_PRESENT
            return "Verified in Trash" if status == STORAGE_STATUS_IN_TRASH
            return "Changed identity" if status == STORAGE_STATUS_CHANGED
            "Could not verify"

    public:
        def storage_protection_label(reason: i64) -> sview:
            return "Kept by you: excluded from cleanup" if reason == StudioStorageCleanupPolicy::PROTECT_USER_EXEMPTION
            return "Eligible after review" if reason == StudioStorageCleanupPolicy::PROTECT_NONE
            return "Protected: current document" if reason == StudioStorageCleanupPolicy::PROTECT_OPEN_DOCUMENT
            return "Protected: recovery needs verification" if reason == StudioStorageCleanupPolicy::PROTECT_SESSION_REFERENCE
            return "Protected: below retention age" if reason == StudioStorageCleanupPolicy::PROTECT_RETENTION
            return "Protected: source take" if reason == StudioStorageCleanupPolicy::PROTECT_SOURCE_TAKE
            return "Protected: symbolic link" if reason == StudioStorageCleanupPolicy::PROTECT_SYMLINK
            return "Protected: identity changed" if reason == StudioStorageCleanupPolicy::PROTECT_IDENTITY_CHANGED
            return "Protected: identity unverified" if reason == StudioStorageCleanupPolicy::PROTECT_IDENTITY_UNVERIFIED
            "Protected: age or file facts unverified"

        def storage_batch_item_label(item: i64) -> sview:
            return "Not attempted" if item == StudioStorageBatchPolicy::ITEM_NOT_ATTEMPTED
            return "Moved to Trash" if item == StudioStorageBatchPolicy::ITEM_RECORDED
            return "Move failed" if item == StudioStorageBatchPolicy::ITEM_KNOWN_FAILED
            return "Restored after error" if item == StudioStorageBatchPolicy::ITEM_RESTORED
            return "Recovery needed" if item == StudioStorageBatchPolicy::ITEM_RECOVERY_REQUIRED
            return "Location uncertain" if item == StudioStorageBatchPolicy::ITEM_UNKNOWN
            "Invalid result"

        def storage_batch_state_label(state: i64) -> sview:
            return "Cleanup running; Cancel stops before the next file" if state == StudioStorageBatchPolicy::STATE_RUNNING
            return "Cleanup cancelled" if state == StudioStorageBatchPolicy::STATE_CANCELLED
            return "Cleanup finished" if state == StudioStorageBatchPolicy::STATE_COMPLETE
            return "Cleanup stopped; reviewed inventory changed" if state == StudioStorageBatchPolicy::STATE_STOP_REVIEW_CHANGED
            return "Cleanup stopped for receipt recovery; inspect refreshed results" if state == StudioStorageBatchPolicy::STATE_STOP_RECOVERY_REQUIRED
            return "Cleanup stopped after an uncertain move; Refresh verifies its location" if state == StudioStorageBatchPolicy::STATE_STOP_UNKNOWN
            "Cleanup stopped; invalid state"

        def storage_batch_row_status(entry: StudioStorageManifest::Entry,
                                     reviewed: darray[StudioStorageManifest::Entry]&, items: darray[i64]&) -> i64:
            for index in 0..<reviewed.count |reviewed, items, entry|:
                previous: StudioStorageManifest::Entry = reviewed[index]
                if index < items.count and StudioStorageIdentityPolicy::matches(previous.device, entry.device, previous.inode, entry.inode, previous.size_bytes, entry.size_bytes, previous.modified_seconds, entry.modified_seconds, previous.modified_nanoseconds, entry.modified_nanoseconds, StudioStorageManifest::same_path(previous.original_path, entry.original_path)):
                    return items[index]
            -1

        def storage_overview_name(category: i64) -> sview:
            return "Eligible" if category == 0
            return "Protected" if category == 1
            return "Recovery" if category == 2
            return "In Trash" if category == 3
            "Unverified"

        def storage_panel(w: f32, h: f32, opened: bool,
                          entries: darray[StudioStorageManifest::Entry]&,
                          statuses: darray[i64]&, reasons: darray[i64]&, cleanup_selected: darray[StudioStorageManifest::Entry]&,
                          selected: i64, focus: i64, message: i64,
                          protected_records: i64, unverified_records: i64,
                          restore_available: bool, restore_review: bool, trash_available: bool, trash_review: bool, exemption_available: bool, exemption_kept: bool,
                          overview_counts: darray[i64]&, overview_bytes: darray[i64]&, scan_seconds: i64, retention_days: i64, selection_bytes: i64, selection_removed: i64, batch_state: i64, batch_completed: i64, batch_failed: i64,
                          batch_untouched: i64, batch_entries: darray[StudioStorageManifest::Entry]&, batch_items: darray[i64]&) -> void:
            return if not opened
            d: Box = storage_dialog_box(w, h)
            footer: f32 = d.y + d.h - 110.0
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 19.0, "Review Move to Trash" if trash_review else "Storage & Recovery", StudioDraw::ink())
            if trash_review and cleanup_selected.count == 1:
                StudioDraw::bold(d.x + 24.0, d.y + 52.0, 12.0, storage_entry_name(cleanup_selected, 0), StudioDraw::ink())
                selected_entry: StudioStorageManifest::Entry = cleanup_selected[0]
                StudioText::begin()
                StudioText::put("Original: ")
                for byte in selected_entry.original_path:
                    StudioText::byte(byte)
                StudioDraw::text(d.x + 24.0, d.y + 72.0, 10.0, StudioText::view(), StudioDraw::muted())
            else:
                StudioDraw::text(d.x + 24.0, d.y + 52.0, 12.0,
                    "Studio records generated reports and recovery receipts under build/.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, d.y + 72.0, 11.0,
                    "Source takes are protected. Retention changes eligibility; files move only after confirmation.", StudioDraw::muted())
            if not StudioStorageScanTimePolicy::supported(scan_seconds):
                StudioDraw::text(d.x + 24.0, d.y + 88.0, 10.0,
                    StudioStorageAccessibilityCopy::last_scan_unknown(), StudioDraw::muted())
            else:
                StudioText::begin()
                StudioStorageScanTimeCopy::append(scan_seconds)
                StudioDraw::text(d.x + 24.0, d.y + 88.0, 10.0, StudioText::view(), StudioDraw::muted())
            StudioText::begin()
            StudioText::put("Selected: ")
            StudioText::put_i(cleanup_selected.count.i64())
            StudioText::put(" file(s), ")
            StudioText::put_i(selection_bytes)
            StudioText::put(" bytes")
            StudioDraw::text(d.x + 24.0, d.y + 106.0, 12.0, StudioText::view(), StudioDraw::accent())
            for category in 0..<overview_counts.count |category, overview_counts, overview_bytes, d|:
                column: f32 = d.x + 24.0 + category.f32() * 178.0
                StudioText::begin()
                StudioText::put(storage_overview_name(category.i64()))
                StudioText::put(": ")
                StudioText::put_i(overview_counts[category])
                StudioDraw::text(column, d.y + 132.0, 11.0, StudioText::view(), StudioDraw::ink())
                StudioText::begin()
                StudioText::put_i(overview_bytes[category])
                StudioText::put(" logical bytes")
                StudioDraw::text(column, d.y + 148.0, 10.0, StudioText::view(), StudioDraw::muted())
            if selected >= 0 and selected < entries.count.i64():
                selected_entry: StudioStorageManifest::Entry = entries[selected]
                StudioText::begin()
                StudioText::put("Selected file: ")
                StudioText::put_i(selected_entry.size_bytes)
                StudioText::put(" bytes  |  Modified: ")
                age_status: i64 = StudioStorageAgePolicy::timestamp_status(selected_entry.modified_seconds, scan_seconds)
                if age_status == StudioStorageAgePolicy::STATUS_VALID:
                    StudioText::put_i(StudioStorageAgePolicy::completed_age_days(selected_entry.modified_seconds, scan_seconds))
                    StudioText::put(" completed days ago")
                elif age_status == StudioStorageAgePolicy::STATUS_FUTURE:
                    StudioText::put("future timestamp; age unverified")
                else:
                    StudioText::put("age unavailable; Refresh to retry")
                StudioDraw::text(d.x + 24.0, d.y + 168.0, 11.0, StudioText::view(), StudioDraw::muted())
            else:
                StudioDraw::bold(d.x + 24.0, d.y + 168.0, 11.0, "Logical sizes do not estimate disk space freed. Unverified sizes are excluded.", StudioDraw::muted())
            first: i64 = storage_first_visible(w, h, entries.count.i64(), selected)
            for visible_row in 0..<storage_visible_count(w, h, entries.count.i64(), selected) |visible_row, first, entries, statuses, selected, cleanup_selected, reasons, batch_entries, batch_items, batch_state, d|:
                index: i64 = first + visible_row
                row: Box = storage_row_box(w, h, visible_row)
                entry: StudioStorageManifest::Entry = entries[index]
                row_status: i64 = statuses[index] if index < statuses.count else STORAGE_STATUS_UNVERIFIED
                StudioDraw::rect(row.x, row.y, row.w, row.h,
                    StudioDraw::color(47, 55, 70) if index == selected else StudioDraw::panel())
                mutable checked: bool = false
                for picked in cleanup_selected |picked, entry, checked|:
                    checked <- true if StudioStorageIdentityPolicy::matches(picked.device, entry.device, picked.inode, entry.inode, picked.size_bytes, entry.size_bytes, picked.modified_seconds, entry.modified_seconds, picked.modified_nanoseconds, entry.modified_nanoseconds, StudioStorageManifest::same_path(picked.original_path, entry.original_path))
                StudioDraw::text(row.x + 8.0, row.y + 8.0, 12.0, "[x]" if checked else "[ ]" if index < reasons.count.i64() and reasons[index] == StudioStorageCleanupPolicy::PROTECT_NONE else "[-]", StudioDraw::accent() if checked else StudioDraw::muted())
                StudioDraw::text(row.x + 34.0, row.y + 8.0, 12.0,
                    storage_entry_name(entries, index), StudioDraw::ink())
                StudioDraw::text(row.x + row.w - 265.0, row.y + 8.0, 11.0,
                    storage_kind_label(entry.kind), StudioDraw::muted())
                batch_item: i64 = storage_batch_row_status(entry, batch_entries, batch_items)
                StudioDraw::text(row.x + row.w - 130.0, row.y + 8.0, 11.0,
                    storage_entry_status(row_status),
                    StudioDraw::accent() if row_status == STORAGE_STATUS_IN_TRASH else StudioDraw::severity_color(2) if row_status == STORAGE_STATUS_CHANGED or row_status == STORAGE_STATUS_UNVERIFIED else StudioDraw::muted())
                if batch_state != StudioStorageBatchPolicy::STATE_IDLE and batch_item >= 0:
                    StudioText::begin()
                    StudioText::put("Batch: ")
                    StudioText::put(storage_batch_item_label(batch_item))
                    StudioDraw::text(row.x + row.w - 265.0, row.y + 21.0, 9.0, StudioText::view(), StudioDraw::color(240, 170, 110) if batch_item >= StudioStorageBatchPolicy::ITEM_RECOVERY_REQUIRED else StudioDraw::muted())
            if entries.count == 0:
                StudioDraw::text(d.x + 30.0, d.y + 198.0, 12.0,
                    "No Studio-managed files are registered yet.", StudioDraw::muted())
            if batch_state != StudioStorageBatchPolicy::STATE_IDLE:
                StudioText::begin()
                StudioText::put("Moved and recorded: ")
                StudioText::put_i(batch_completed)
                StudioText::put("   Failed/restored: ")
                StudioText::put_i(batch_failed)
                StudioText::put("   Untouched: ")
                StudioText::put_i(batch_untouched)
                StudioDraw::text(d.x + 24.0, footer, 11.0, StudioText::view(), StudioDraw::ink())
            elif not restore_review and not trash_review:
                selected_reason: i64 = reasons[selected] if selected >= 0 and selected < reasons.count.i64() else StudioStorageCleanupPolicy::PROTECT_IDENTITY_UNVERIFIED
                StudioDraw::text(d.x + 24.0, footer, 11.0,
                    storage_protection_label(selected_reason) if selected >= 0 else "Choose an inventory row to inspect its cleanup protection.", StudioDraw::muted())
            if message == 21 or message == 22:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Storage busy/unavailable. Refresh and retry; this attempt moved no files." if message == 21 else "Lock release uncertain. Moves blocked; inspect receipts before restarting.", StudioDraw::color(240, 170, 110))
            elif trash_review:
                StudioDraw::text(d.x + 24.0, footer, 11.0,
                    "Move the selected files to Finder Trash? Original locations are recorded for Restore.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Trash still uses disk space until emptied in Finder. Confirm Trash proceeds; Esc cancels.", StudioDraw::accent())
            elif restore_review:
                StudioDraw::text(d.x + 24.0, footer, 11.0,
                    "Restore the selected file to its original build location? Existing files will not be overwritten.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Choose Confirm restore to proceed, or press Esc to cancel.", StudioDraw::accent())
            elif batch_state == StudioStorageBatchPolicy::STATE_RUNNING:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup is running one file at a time. Cancel or Esc stops before the next file.", StudioDraw::accent())
            elif batch_state == StudioStorageBatchPolicy::STATE_CANCELLED:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup cancelled. Completed receipts are saved; remaining files were left untouched.", StudioDraw::muted())
            elif batch_state == StudioStorageBatchPolicy::STATE_STOP_REVIEW_CHANGED:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup stopped: the inventory changed or files became protected. Review the remaining selection.", StudioDraw::color(240, 170, 110))
            elif batch_state == StudioStorageBatchPolicy::STATE_STOP_UNKNOWN or batch_state == StudioStorageBatchPolicy::STATE_STOP_RECOVERY_REQUIRED or batch_state == StudioStorageBatchPolicy::STATE_STOP_INVALID:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, storage_batch_state_label(batch_state), StudioDraw::color(240, 170, 110))
            elif batch_state == StudioStorageBatchPolicy::STATE_COMPLETE:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Cleanup finished. Recorded Trash files can be restored; Trash still uses disk space.", StudioDraw::color(150, 210, 160))
            elif message == 19:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Exemption save could not be confirmed. Refresh to inspect saved protection before retrying.", StudioDraw::color(240, 170, 110))
            elif message == 20:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Exemption saved. Eligibility refreshed; no files were moved. Move still requires review.", StudioDraw::color(150, 210, 160))
            elif message == 18:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Exemptions unreadable. Cleanup blocked; repair build/studio_storage_exemptions.txt and Refresh.", StudioDraw::color(240, 170, 110))
            elif message == 16:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Retention settings unreadable. Cleanup blocked; repair build/studio_storage_preferences.txt and Refresh.", StudioDraw::color(240, 170, 110))
            elif message == 17:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Retention could not be saved. Previous setting remains active; Refresh before retrying.", StudioDraw::color(240, 170, 110))
            elif message == 10:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File moved to Trash; its receipt is saved. Restore is available. Trash still uses disk space.", StudioDraw::color(150, 210, 160))
            elif message == 11:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Move failed. A fresh check confirmed the original file remains in build/. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 12:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Receipt save failed; a fresh check confirmed the file was restored. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 13:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Receipt save and rollback failed. Receipt retained; Refresh to retry or recover in Finder Trash.", StudioDraw::color(240, 170, 110))
            elif message == 15:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File location is uncertain. Refresh to verify; inspect build/ and Finder Trash before retrying.", StudioDraw::color(240, 170, 110))
            elif message == 6:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File restored to its original location. The inventory is updated.", StudioDraw::color(150, 210, 160))
            elif message == 7:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Restore failed: the item is unavailable, changed, or its destination is occupied. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 8:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "File restored, but the inventory could not be saved. Refresh to finish recovery.", StudioDraw::color(240, 170, 110))
            elif message == 9:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "The reviewed inventory changed. Review the refreshed inventory before restoring.", StudioDraw::color(240, 170, 110))
            elif message == 1:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "The inventory could not be read. No cleanup action is available.", StudioDraw::color(240, 170, 110))
            elif message == 5:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "Recovery changes could not be saved. Refresh to retry before taking action.", StudioDraw::color(240, 170, 110))
            elif message == 2:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "The build folder could not be verified. No inventory paths are shown.", StudioDraw::color(240, 170, 110))
            elif selection_removed > 0:
                StudioText::begin()
                StudioText::put_i(selection_removed)
                StudioText::put(" selected file(s) removed: identity changed, missing, or now protected. Review again.")
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif unverified_records > 0:
                StudioText::begin()
                StudioText::put_i(unverified_records)
                StudioText::put(" item(s) are protected: file identity changed or could not be checked.")
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif protected_records > 0:
                StudioText::begin()
                StudioText::put_i(protected_records)
                StudioText::put(" record(s) are hidden outside build/ or match the active take.")
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif message == 3:
                StudioDraw::text(d.x + 24.0, footer + 20.0, 11.0,
                    "No registered files. Generated artifacts appear here; source takes stay protected." if entries.count == 0 else "No eligible files. Review protection reasons and retention; Refresh after changes." if overview_counts.count > 0 and overview_counts[0] == 0 else "Inventory refreshed; all visible file identities are verified.", StudioDraw::color(150, 210, 160))
            StudioDraw::text(d.x + 24.0, footer + 46.0, 10.0,
                "Up / Down inspects   Space toggles selection   Tab moves to buttons   Esc cancels", StudioDraw::muted())
            for action in 0..<STORAGE_ACTION_COUNT |action, w, h, focus, restore_available, restore_review, trash_available, trash_review, retention_days, batch_state, exemption_available, exemption_kept|:
                b: Box = storage_button_box(w, h, action)
                StudioDraw::rect(b.x, b.y, b.w, b.h,
                    StudioDraw::color(58, 52, 40) if focus == action else StudioDraw::panel())
                StudioDraw::bold(b.x + 12.0, b.y + 11.0, 12.0,
                    ("Remove exemption" if exemption_kept else "Keep this file") if action == STORAGE_EXEMPTION else "Select eligible" if action == STORAGE_SELECT_ELIGIBLE else "Clear selection" if action == STORAGE_CLEAR_SELECTION else "Refresh" if action == STORAGE_REFRESH else ("Cancel" if batch_state == StudioStorageBatchPolicy::STATE_RUNNING else "Done") if action == STORAGE_DONE else ("Confirm restore" if restore_review else "Restore") if action == STORAGE_RESTORE else ("Confirm Trash" if trash_review else "Move to Trash") if action == STORAGE_TRASH else StudioStorageAccessibilityCopy::retention_value(retention_days),
                    StudioDraw::muted() if (batch_state == StudioStorageBatchPolicy::STATE_RUNNING and action != STORAGE_DONE) or (action == STORAGE_RESTORE and not restore_available) or (action == STORAGE_TRASH and not trash_available) or (action == STORAGE_EXEMPTION and not exemption_available) else StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if focus == action

