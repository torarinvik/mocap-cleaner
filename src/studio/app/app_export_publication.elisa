include "../export_publication_policy.elisa"
include "app_state.elisa"
include "../export_snapshot_policy.elisa"
include "report_text.elisa"
include "../export_recovery_budget_policy.elisa"
include "../export_report_path_policy.elisa"

extend Studio:
    private:
        global mutable export_durability_unknown: bool = false
        global mutable export_publication_outcome: StudioExportPublicationPolicy::Outcome = StudioExportPublicationPolicy::Outcome.GlbOnly

        struct ExportReportSnapshot:
            json: darray[u8]
            summary: darray[u8]

        def perform_export(destination: cstr, overwrite_confirmed: bool) -> bool:
            if not export_report_paths_fit(destination):
                say_file("Export blocked: destination is too long for report filenames. Choose a shorter filename or folder.", destination)
                touch()
                return false
            if not artifact_destination_allowed(destination):
                say_file("Export blocked: reserved Storage metadata or identity could not be verified. Choose another file inside build/.", destination)
                touch()
                return false
            if clip is c:
                captured_generation: i64 = built
                mutable allows_overwrite: bool = overwrite_confirmed
                mutable reason: i64 = export_reason(destination, allows_overwrite)
                if reason == StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                    if FilePanel::confirm_replace(destination):
                        allows_overwrite <- true
                        reason <- export_reason(destination, true)
                    else:
                        say_file("Export cancelled; existing file kept", destination)
                        touch()
                        return false
                if reason != StudioExportPolicy::ALLOW:
                    say_file(export_error(reason), destination)
                    touch()
                    return false

                if not StudioExportSnapshotPolicy::current(captured_generation, built):
                    say_file("Export cancelled: displayed result changed; review it before exporting.", destination)
                    touch()
                    return false
                # Freeze settings before publication; fingerprint serialized
                # staging bytes while their private path still exists.
                mutable report_stack: StackState::Stack = current_stack()
                if built_stack is evaluated_stack:
                    if not StackState::same(report_stack, evaluated_stack) or load_failed:
                        say_file("Export blocked: current edits have not produced the displayed result. Resolve evaluation first.", destination)
                        touch()
                        return false
                    report_stack <- evaluated_stack
                else:
                    say_file("Export blocked: evaluated stack provenance is unavailable.", destination)
                    touch()
                    return false
                report_animation: sview = anim_name
                mutable prepare_error: StudioExportValidation::Result = StudioExportValidation::Result.WRITE_FAILED
                if StudioExportPublisher::prepare(c.cleaned, destination, &prepare_error) is temporary:
                    output_identity: StudioSourceFingerprint::Fingerprint? = export_staged_identity(temporary)
                    mutable report_snapshot: ExportReportSnapshot? = null
                    mutable identity_captured: bool = false
                    mutable reports_captured: bool = false
                    if output_identity is output_fp:
                        identity_captured <- true
                        report_snapshot <- prepare_export_report_for(c, report_stack, report_animation, output_fp)
                    if report_snapshot is frozen:
                        reports_captured <- frozen.json.count > 0 and frozen.summary.count > 0 and StudioExportRecoveryBudgetPolicy::append_admitted(0, frozen.json.count.i64(), StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES) and StudioExportRecoveryBudgetPolicy::append_admitted(0, frozen.summary.count.i64(), StudioExportRecoveryBudgetPolicy::Capacity::REPORT_BYTES)
                    if not StudioExportSnapshotPolicy::reports_ready(identity_captured, reports_captured):
                        StudioExportPublisher::discard(temporary)
                        FilePanel::release_path(temporary)
                        say_file("Export blocked: report snapshot could not be prepared within its size limit. Existing destination kept.", destination)
                        touch()
                        return false
                    # Recheck after writing and validating the temporary so a
                    # destination that changed during export cannot be silently
                    # replaced. Publication is a single same-directory rename.
                    reason <- export_reason(destination, allows_overwrite)
                    if reason == StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                        if FilePanel::confirm_replace(destination):
                            allows_overwrite <- true
                            reason <- export_reason(destination, true)
                        else:
                            StudioExportPublisher::discard(temporary)
                            FilePanel::release_path(temporary)
                            say_file("Export cancelled; existing file kept", destination)
                            touch()
                            return false
                    if reason != StudioExportPolicy::ALLOW:
                        StudioExportPublisher::discard(temporary)
                        FilePanel::release_path(temporary)
                        say_file(export_error(reason), destination)
                        touch()
                        return false
                    if not artifact_destination_allowed(destination):
                        StudioExportPublisher::discard(temporary)
                        FilePanel::release_path(temporary)
                        say_file("Export blocked: destination conflicts with Storage metadata or cannot be verified.", destination)
                        touch()
                        return false
                    if not StudioExportSnapshotPolicy::current(captured_generation, built):
                        StudioExportPublisher::discard(temporary)
                        FilePanel::release_path(temporary)
                        say_file("Export cancelled: displayed result changed; existing destination kept.", destination)
                        touch()
                        return false
                    publication: StudioPublicationDurabilityPolicy::Result = StudioExportPublisher::commit_with_status(temporary, destination)
                    if StudioPublicationDurabilityPolicy::published(publication):
                        export_durability_unknown <- publication == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown
                        storage_tracking_failed <- false
                        export_publication_outcome <- StudioExportPublicationPolicy::Outcome.GlbOnly
                        if report_snapshot is frozen_reports:
                            export_publication_outcome <- publish_export_reports(destination, frozen_reports)
                        report_saved: bool = StudioExportPublicationPolicy::reports_complete(export_publication_outcome)
                        FilePanel::release_path(temporary)
                        export_path <- destination
                        say_file("GLB exported and validated; report saved, but Storage tracking could not be saved", destination) if report_saved and storage_tracking_failed
                        say_file("GLB exported and validated; report sidecars and Storage tracking could not be saved", destination) if not report_saved and storage_tracking_failed
                        say_file("exported and validated; report saved", destination) if report_saved and not storage_tracking_failed
                        say_file(StudioExportPublicationPolicy::message(export_publication_outcome), destination) if not report_saved and not storage_tracking_failed
                        say_file("GLB published; directory durability is unconfirmed. The result exists; do not repeat export over it.", destination) if export_durability_unknown
                        FilePanel::note_recent(destination)
                        _ = puts(destination)
                        export_result_path <- destination
                        export_result_focus <- StudioExportResult::Action::OPEN
                        export_result_open <- true
                        touch()
                        return true
                    StudioExportPublisher::discard(temporary)
                    FilePanel::release_path(temporary)
                    say_file("export failed; destination kept", destination)
                else:
                    say_file(StudioExportValidation::message(prepare_error), destination)
                touch()
            false

        def export_report_paths_fit(destination: cstr) -> bool:
            mutable length: usize = 0
            while length < StudioExportReportPathPolicy::Capacity::PATH_BYTES.usize() and destination[length] != 0:
                length <- length + 1
            StudioExportReportPathPolicy::admitted(length.i64())

        def export_staged_identity(temporary: cstr) -> StudioSourceFingerprint::Fingerprint?:
            staged: GlbDocument::Document = catch GlbDocument::load(temporary):
                value: value
                error failure: return null
            StudioModel::fingerprint(&staged)

        def report_integer(value: i64) -> sview can Unsafe.PointerCast:
            StudioReportText::begin()
            StudioReportText::put_i(value)
            StudioReportText::view()

        def report_indexed_name(prefix: sview, index: i64) -> sview can Unsafe.PointerCast:
            StudioReportText::begin()
            StudioReportText::put(prefix)
            StudioReportText::put_i(index)
            StudioReportText::view()

        def report_operation(operation: Ops::Operation) -> sview can Unsafe.PointerCast:
            StudioReportText::begin()
            match operation.kind:
                Ops::Kind.Despike:
                    StudioReportText::put("despike")
                Ops::Kind.PinContacts:
                    StudioReportText::put("pin_contacts")
                Ops::Kind.CloseSeam:
                    StudioReportText::put("close_seam")
                Ops::Kind.SmoothPath:
                    StudioReportText::put("smooth_path")
                Ops::Kind.LimitWring:
                    StudioReportText::put("limit_wring")
                Ops::Kind.Median:
                    StudioReportText::put("median")
            StudioReportText::put(";enabled=")
            StudioReportText::put("true") if operation.enabled
            StudioReportText::put("false") if not operation.enabled
            StudioReportText::put(";frames=")
            StudioReportText::put_i(operation.first)
            StudioReportText::put("..")
            StudioReportText::put_i(operation.last)
            StudioReportText::put(";bones=")
            StudioReportText::put_i(operation.bones)
            StudioReportText::put(";strength=")
            StudioReportText::put_i(operation.strength)
            StudioReportText::put(";edge_frames=")
            StudioReportText::put_i(operation.edge)
            StudioReportText::view()

        def report_band(band: StackState::Band) -> sview can Unsafe.PointerCast:
            StudioReportText::begin()
            StudioReportText::put("enabled=")
            StudioReportText::put("true") if band.enabled
            StudioReportText::put("false") if not band.enabled
            StudioReportText::put(";source_frames=")
            StudioReportText::put_i(band.first)
            StudioReportText::put("..")
            StudioReportText::put_i(band.last)
            StudioReportText::put(";speed_permille=")
            StudioReportText::put_i(band.speed)
            StudioReportText::put(";blend_frames=")
            StudioReportText::put_i(band.blend)
            StudioReportText::view()

        # Reports are best-effort sidecars after the GLB's atomic commit. The
        # source label is a basename, and fingerprints remain explicitly
        # non-cryptographic residues. Values unavailable in the current export
        # snapshot (tool versions and detailed retime provenance) are omitted.
        # Serialize all report fields before publishing the GLB or opening
        # a second confirmation dialog. Later writes consume only these bytes.
        def prepare_export_report_for(c: StudioModel::Clip&, active_stack: StackState::Stack&, report_animation: sview, output_fp: StudioSourceFingerprint::Fingerprint) -> ExportReportSnapshot? can Unsafe.PointerCast:
            # Source and destination lengths are independent. Never index a
            # source path using offsets measured from the export destination.
            mutable source_end: usize = 0
            mutable source_start: usize = 0
            while source_end < 4096 and path[source_end] != 0:
                if path[source_end] == 47 or path[source_end] == 92:
                    source_start <- source_end + 1
                source_end <- source_end + 1
            return null if source_end == 0 or source_end >= 4096 or source_start >= source_end
            mutable source_label: u8[4096] = zeroed
            for index in source_start..<source_end |index, path, source_label, source_start|:
                source_label[index - source_start] <- path[index]
            source_name: sview = UiText::fixed_bytes_view_range[4096](source_label, 0, source_end - source_start)
            mutable settings: darray[StudioExportReport::Setting] = []
            settings.push(StudioExportReport::Setting{name: "spike_threshold_fixed_channel_units", value: report_integer(c.threshold)})
            settings.push(StudioExportReport::Setting{name: "spike_measure", value: "absolute second difference; rounded channel components scaled by 1000000; not physical acceleration"})
            settings.push(StudioExportReport::Setting{name: "foot_cleanup", value: "enabled"}) if active_stack.feet
            settings.push(StudioExportReport::Setting{name: "foot_cleanup", value: "disabled"}) if not active_stack.feet
            settings.push(StudioExportReport::Setting{name: "hand_cleanup", value: "enabled"}) if active_stack.hands
            settings.push(StudioExportReport::Setting{name: "hand_cleanup", value: "disabled"}) if not active_stack.hands
            settings.push(StudioExportReport::Setting{name: "cleanup_blend_frames", value: report_integer(active_stack.blend)})
            for index in 0..<active_stack.count |settings, active_stack|:
                operation: Ops::Operation = active_stack.ops[index]
                settings.push(StudioExportReport::Setting{name: report_indexed_name("operation_", index), value: report_operation(operation)})
            for index in 0..<active_stack.band_count |settings, active_stack|:
                band: StackState::Band = active_stack.bands[index]
                settings.push(StudioExportReport::Setting{name: report_indexed_name("retime_band_", index), value: report_band(band)})
            settings.push(StudioExportReport::Setting{name: "retime_applied", value: "true"}) if c.retimed
            settings.push(StudioExportReport::Setting{name: "retime_applied", value: "false"}) if not c.retimed
            assumptions: darray[sview] = [
                "Frame rate is an integer estimate; durations are floored to milliseconds.",
                "Fingerprints are non-cryptographic studio-residue-v1 values.",
                "Operation fields and retime bands are captured before GLB publication; detailed rig settings and per-frame source-time mapping are unavailable."]
            metrics: StudioExportReport::Metrics = StudioExportReport::Metrics{
                changed_channels: c.changed,
                spikes_before: c.spikes_before,
                spikes_after: c.spikes_after,
                foot_slide_before_um: c.slide_before,
                foot_slide_after_um: c.slide_after,
                foot_sink_before_um: c.sink_before,
                foot_sink_after_um: c.sink_after,
                hand_slide_before_um: c.hand_slide_before,
                hand_slide_after_um: c.hand_slide_after,
                balance_impossible_frames: c.impossible_frames}
            mutable warnings: darray[StudioExportReport::Warning] = []
            if c.impossible_frames > 0:
                warnings.push(StudioExportReport::Warning{category: "balance", severity: StudioExportReport::Severity::WARNING, message: "Frames marked impossible by the Studio balance detector."})
            if c.spikes_after > c.spikes_before:
                warnings.push(StudioExportReport::Warning{category: "spikes", severity: StudioExportReport::Severity::WARNING, message: "Detected spike frames increased after cleanup."})
            if c.slide_after > c.slide_before:
                warnings.push(StudioExportReport::Warning{category: "foot_slide", severity: StudioExportReport::Severity::WARNING, message: "Measured planted-foot slide increased after cleanup."})
            if c.sink_after > c.sink_before:
                warnings.push(StudioExportReport::Warning{category: "foot_sink", severity: StudioExportReport::Severity::WARNING, message: "Measured foot sink increased after cleanup."})
            if c.hand_slide_after > c.hand_slide_before:
                warnings.push(StudioExportReport::Warning{category: "hand_slide", severity: StudioExportReport::Severity::WARNING, message: "Measured hand slide increased after cleanup."})
            data: StudioExportReport::Data = StudioExportReport::Data{
                source_name: source_name,
                source_fingerprint_first: c.source_fingerprint.first,
                source_fingerprint_second: c.source_fingerprint.second,
                output_fingerprint_first: output_fp.first,
                output_fingerprint_second: output_fp.second,
                animation_name: report_animation, animation_index: c.anim.i64(),
                input_frames: c.source_frames, input_fps: c.rate,
                output_frames: c.frames, output_fps: c.rate,
                settings: settings, assumptions: assumptions, metrics: metrics,
                warnings: warnings}
            json: darray[u8] = StudioExportReport::json(&data)
            summary: darray[u8] = StudioExportReport::summary(&data)
            ExportReportSnapshot{json: json, summary: summary}

        def publish_export_reports(destination: cstr, snapshot: ExportReportSnapshot&) -> StudioExportPublicationPolicy::Outcome can Unsafe.PointerCast:
            mutable path_end: usize = 0
            while path_end < 4096 and destination[path_end] != 0:
                path_end <- path_end + 1
            return StudioExportPublicationPolicy::Outcome.GlbOnly if not StudioExportReportPathPolicy::admitted(path_end.i64())
            mutable json_path: u8[4128] = zeroed
            mutable text_path: u8[4128] = zeroed
            for index in 0..<path_end |destination, json_path, text_path|:
                json_path[index] <- destination[index]
                text_path[index] <- destination[index]
            suffix_json: cstr = ".report.json"
            suffix_text: cstr = ".report.txt"
            mutable a: usize = 0
            mutable b: usize = 0
            while suffix_json[a] != 0:
                json_path[path_end + a] <- suffix_json[a]
                a <- a + 1
            while suffix_text[b] != 0:
                text_path[path_end + b] <- suffix_text[b]
                b <- b + 1
            json_path[path_end + a] <- 0
            text_path[path_end + b] <- 0
            json_cstr: cstr = (&json_path[0]).cast[cstr] can Unsafe.PointerCast
            text_cstr: cstr = (&text_path[0]).cast[cstr] can Unsafe.PointerCast
            mutable json_result: StudioPublicationDurabilityPolicy::Result = StudioPublicationDurabilityPolicy::Result.NotPublished
            mutable text_result: StudioPublicationDurabilityPolicy::Result = StudioPublicationDurabilityPolicy::Result.NotPublished
            # GLB replacement consent does not authorize replacing separate
            # report files. Native create-only publication also closes the
            # check-to-write window for an existing report destination.
            if export_reason(json_cstr, false) == StudioExportPolicy::ALLOW and artifact_destination_allowed(json_cstr):
                json_result <- StudioExportPublisher::write_new_sidecar_with_status(json_cstr, snapshot.json)
            if export_reason(text_cstr, false) == StudioExportPolicy::ALLOW and artifact_destination_allowed(text_cstr):
                text_result <- StudioExportPublisher::write_new_sidecar_with_status(text_cstr, snapshot.summary)
            export_durability_unknown <- true if json_result == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown or text_result == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown
            json_ok: bool = StudioPublicationDurabilityPolicy::published(json_result)
            text_ok: bool = StudioPublicationDurabilityPolicy::published(text_result)
            storage_tracking_failed <- true if json_ok and not register_storage_artifact(json_cstr, StudioStorageCleanupPolicy::GENERATED_REPORT)
            storage_tracking_failed <- true if text_ok and not register_storage_artifact(text_cstr, StudioStorageCleanupPolicy::GENERATED_REPORT)
            StudioExportPublicationPolicy::sidecar_outcome(json_ok, text_ok)

        # ---- native file panels (modal) --------------------------------
