include "app_state.elisa"
include "../gizmo_target_policy.elisa"
include "../correction_result_policy.elisa"

extend Studio:
    private:
        global mutable gizmo_target: StudioGizmoTargetPolicy::Target = StudioGizmoTargetPolicy::Target{generation: -1, result_generation: -1, bone: -1, frame: -1, view: -1, mode: -1}
        global mutable gizmo_start_x: f32 = 0.0
        global mutable gizmo_start_y: f32 = 0.0

        def current_gizmo_target(i: i64) -> StudioGizmoTargetPolicy::Target:
            StudioGizmoTargetPolicy::Target{generation: stack_generation, result_generation: built, bone: bone, frame: frame_now(), view: i, mode: gizmo_mode}

        def gizmo_target_current(i: i64) -> bool:
            StudioGizmoTargetPolicy::current(gizmo_target, current_gizmo_target(i))

        def gizmo_target_refused() -> void:
            gizmo_cancel()
            status <- "Correction target changed. Select the intended bone and frame, then drag again. Existing edits kept."
            touch()

        def gizmo_transform_refused() -> void:
            clear_gizmo_draft()
            status <- "Correction cancelled: the requested transform is invalid. Existing edits kept."
            nudged_row <- -1
            status_file <- null
            touch()

        def active_handle() -> i64:
            return GizmoPolicy::NONE if not gizmo_target_current(gizmo_view)
            if gizmo_drag is d:
                return d.handle
            GizmoPolicy::NONE

        def clear_gizmo_draft() -> void:
            gizmo_view <- -1
            gizmo_drag <- null
            gizmo_goal <- null
            readout_angle <- -1
            readout_mm <- -1
            gizmo_target <- StudioGizmoTargetPolicy::none()
            gizmo_start_x <- 0.0
            gizmo_start_y <- 0.0

        def set_gizmo(mode: i64) -> void:
            gizmo_mode <- -1 if gizmo_mode == mode else mode
            clear_gizmo_draft()
            status <- ("gizmo: rotate (drag a ring)" if gizmo_mode == GizmoPolicy::ROTATE else "gizmo: translate (drag an arrow)") if gizmo_mode >= 0 else "gizmo off"
            nudged_row <- -1
            status_file <- null
            touch()

        # Pixel of window point (x, y) in view `i`.
        def view_px(i: i64, x: f32) -> f32:
            b: StudioPanels::Box = view_box(i)
            (x - b.x) * UiAppKitCanvas::backing_scale()

        def view_py(i: i64, y: f32) -> f32:
            b: StudioPanels::Box = view_box(i)
            (y - b.y) * UiAppKitCanvas::backing_scale()

        # Start a gizmo drag when (x, y) hits a handle of the selected bone.
        def gizmo_press(i: i64, x: f32, y: f32) -> bool:
            if view(i) is opened:
                if clip is c:
                    return false if bone < 0 or bone >= c.nodes.count.i64()
                    return false if frame_now() < 0 or frame_now() >= c.frames
                    if built_stack is evaluated:
                        current: StackState::Stack = current_stack()
                        if not StackState::same(evaluated, current):
                            status <- "Wait for the current result before editing a correction."
                            touch()
                            return false
                    else:
                        return false
                    g: ViewportGizmo::Gizmo = StudioScene::gizmo_for(c, frame_now(), bone, gizmo_mode)
                    handle: i64 = ViewportGizmo::pick(&opened.camera, &g, view_px(i, x), view_py(i, y))
                    return false if handle == GizmoPolicy::NONE
                    if not StudioModel::correction_channel_available(c, bone, frame_now(), gizmo_mode == GizmoPolicy::ROTATE):
                        status <- "Correction unavailable: this tool needs an aligned, non-cubic channel with one key per reviewed frame."
                        nudged_row <- -1
                        status_file <- null
                        touch()
                        return true
                    r: PoseOverride::Rig = StudioModel::rig(c)
                    held: PoseOverride::Overrides = PoseOverride::overrides(&r)
                    mutable d: ViewportGizmo::Drag = ViewportGizmo::idle()
                    ok: bool = catch ViewportGizmo::begin(&d, &opened.camera, &g, handle, view_px(i, x), view_py(i, y), &held, &r, bone.usize(), StudioScene::bone_model(c, frame_now(), bone)):
                        value: value
                        error failure: false
                    return false if not ok
                    if timeline is t:
                        mutable paused: TimelineState::State = t
                        paused.playing <- false
                        set_timeline(paused)
                    gizmo_drag <- d
                    gizmo_view <- i
                    gizmo_target <- current_gizmo_target(i)
                    gizmo_start_x <- x
                    gizmo_start_y <- y
                    status <- "gizmo drag"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return true
            false

        # Track the drag goal so the scene draws the live preview.
        def gizmo_preview(x: f32, y: f32) -> void:
            i: i64 = gizmo_view
            if gizmo_drag is d:
                if not gizmo_target_current(i):
                    gizmo_target_refused()
                    return
                if view(i) is opened:
                    goal: Geometry::Transform = ViewportGizmo::goal(d, &opened.camera, view_px(i, x), view_py(i, y))
                    if not Geometry::transform_is_valid(goal):
                        gizmo_transform_refused()
                        return
                    if clip is c:
                        r: PoseOverride::Rig = StudioModel::rig(c)
                        fix: Corrections::Correction = StudioModel::correction_for(c, r, bone, frame_now(), goal)
                        if not Corrections::transform_admitted(&fix):
                            gizmo_transform_refused()
                            return
                        gizmo_goal <- goal
                        readout_angle <- StudioReadout::angle_tenths(fix.rotation)
                        readout_mm <- StudioReadout::millimetres(fix.translation)
                    touch()

        # Key the dragged pose at the current frame as a correction.
        def gizmo_release(x: f32, y: f32) -> void:
            i: i64 = gizmo_view
            if gizmo_drag != null and not gizmo_target_current(i):
                gizmo_target_refused()
                return
            if gizmo_drag != null and not StudioGizmoTargetPolicy::can_commit(gizmo_target, current_gizmo_target(i), x != gizmo_start_x or y != gizmo_start_y):
                clear_gizmo_draft()
                status <- "Correction unchanged. No history entry added."
                nudged_row <- -1
                status_file <- null
                touch()
                return
            gizmo_view <- -1
            if gizmo_drag is d:
                if view(i) is opened:
                    if clip is c:
                        goal: Geometry::Transform = ViewportGizmo::goal(d, &opened.camera, view_px(i, x), view_py(i, y))
                        if not Geometry::transform_is_valid(goal):
                            gizmo_transform_refused()
                            return
                        r: PoseOverride::Rig = StudioModel::rig(c)
                        fix: Corrections::Correction = StudioModel::correction_for(c, r, bone, frame_now(), goal)
                        if not Corrections::transform_admitted(&fix):
                            gizmo_transform_refused()
                            return
                        mutable s: StackState::Stack = current_stack()
                        if Corrections::identity(&fix):
                            clear_gizmo_draft()
                            status <- "Correction unchanged. No history entry added."
                            nudged_row <- -1
                            status_file <- null
                            touch()
                            return
                        if StackState::add_fix(&s, fix):
                            commit(s, true)
                            outcome: StudioCorrectionResultPolicy::Outcome = StudioCorrectionResultPolicy::outcome(contact_preview_rebuild_pending, load_failed)
                            if outcome == StudioCorrectionResultPolicy::Outcome.Deferred:
                                status <- "Correction recorded. Rebuilding after the current preview finishes; the previous result remains visible."
                            elif outcome == StudioCorrectionResultPolicy::Outcome.Refused:
                                status <- "Correction recorded, but the result could not be rebuilt. The previous result remains visible. Use Undo to remove this edit."
                            else:
                                status <- "Correction keyed. Result updated."
                            nudged_row <- -1
                            status_file <- null
                        else:
                            status <- "Correction not added: invalid scope or transform, or 16-correction capacity reached. Existing corrections kept."
                            nudged_row <- -1
                            status_file <- null
            clear_gizmo_draft()
            touch()

        def gizmo_cancel() -> void:
            clear_gizmo_draft()
            status <- "gizmo drag cancelled"
            nudged_row <- -1
            status_file <- null
            touch()

        # A native focus loss may suppress the matching pointer-up. Cancel
        # every unfinished gesture so it cannot commit when focus returns.
        def focus_lost() -> void:
            contact_cancel_frame_draft() if contact_draft_target >= 0
            was_gizmo: bool = gizmo_view >= 0
            mutable f: StudioFocus::Interaction = StudioFocus::Interaction{
                modifiers: modifiers,
                drag_view: drag_view,
                drag_button: drag_button.i64(),
                scrubbing: scrubbing,
                selecting: selecting,
                slider_drag: slider_drag,
                retime_speed: retime_speed,
                slider_start_speed: slider_start_speed,
                edge_drag_band: edge_drag.band,
                contact_press: FootState::active(&foot_press),
                gizmo_view: gizmo_view,
                typing: typing,
                selection_active: selection.active,
                gizmo_mode: gizmo_mode
            }
            f <- StudioFocus::after_focus_lost(f)
            file_menu_open <- false
            file_menu_hover <- -1
            reset_menu_open <- false
            modifiers <- f.modifiers
            drag_view <- f.drag_view
            drag_button <- f.drag_button.i32()
            scrubbing <- f.scrubbing
            selecting <- f.selecting
            slider_drag <- f.slider_drag
            retime_speed <- f.retime_speed
            edge_drag <- RetimeState::no_drag()
            foot_press <- FootState::idle()
            contact_preview_active <- false
            gizmo_view <- f.gizmo_view
            typing <- f.typing
            typed_len <- 0
            goto_close() if goto_open
            selection <- RetimeState::none() if not f.selection_active else selection
            if was_gizmo:
                gizmo_cancel()
            else:
                clear_gizmo_draft()
            touch()

        # Escape peels one layer: the sheet, a drag, a contact press, the
        # gizmo, then the selection (StudioChrome::escape_layer).
