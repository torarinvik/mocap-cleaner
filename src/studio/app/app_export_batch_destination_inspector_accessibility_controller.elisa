include "app_export_batch_destination_inspector.elisa"
include "app_export_batch_destination_accessibility.elisa"

# Retained native action handles for the read-only inspector. Composition calls
# initialization once; allocation failure leaves keyboard/pointer paths usable.
extend Studio:
    private:
        global mutable prepared_destination_location_widgets: darray[usize] = []
        global mutable prepared_destination_control_widgets: darray[usize] = []
        global mutable prepared_destination_accessibility_ready: bool = false

    public:
        def release_prepared_destination_accessibility_text() -> void can Global{Read, Write}:
            # UiCore retains borrowed text until the next frame. Replace all
            # inspector text with static redacted values before paths are freed.
            for node in StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::DIALOG..<StudioExportBatchDestinationInspectorAccessibilityPolicy::Node::COPY_PATH + 1:
                UiCore::redact_accessibility(node)

        def sync_prepared_destination_focus() -> void can Global{Read, Write}:
            return if not prepared_destination_accessibility_ready or not prepared_destination_inspector_open()
            code: i64 = prepared_destination_inspector_state.focus.i64()
            location_count: i64 = StudioExportBatchDestinationInspectorPolicy::Limit::LOCATION_COUNT
            if code >= 0 and code < location_count:
                return if code.usize() >= prepared_destination_location_widgets.count
                _ = UiFlat::request_focus(prepared_destination_location_widgets[code.usize()])
            elif code >= location_count:
                slot: usize = (code - location_count).usize()
                return if slot >= prepared_destination_control_widgets.count
                _ = UiFlat::request_focus(prepared_destination_control_widgets[slot])

        def init_prepared_destination_accessibility() -> void can Global{Read, Write}:
            prepared_destination_accessibility_ready <- false
            prepared_destination_location_widgets <- []
            prepared_destination_control_widgets <- []
            transparent: UiCore::Color = UiCore::Color{r: 0, g: 0, b: 0, a: 0}
            for slot in 0..<StudioExportBatchDestinationInspectorPolicy::Limit::LOCATION_COUNT:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                return if widget == UiFlat::NONE
                prepared_destination_location_widgets.push(widget)
            for slot in 0..<4:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                return if widget == UiFlat::NONE
                prepared_destination_control_widgets.push(widget)
            prepared_destination_accessibility_ready <- true

        def publish_prepared_destination_accessibility(w: f32, h: f32) -> void can[Unsafe.PointerCast, Memory{Allocate, Release}, Global{Read, Write}]:
            return if not prepared_destination_inspector_open()
            if prepared_destination_inspector_stale():
                invalidate_prepared_destination_inspector()
                return
            return if not prepared_destination_accessibility_ready
            prepare_prepared_destination_path_lines(w, h)
            publish_export_batch_destination_accessibility(w, h,
                prepared_destination_inspector_state, prepared_destination_inspector_paths,
                prepared_destination_path_source, prepared_destination_path_model,
                prepared_destination_path_copy_status,
                prepared_destination_location_widgets, prepared_destination_control_widgets,
                revision.usize())

        def prepared_destination_accessibility_action(widget: usize, event: i32) -> bool can[Unsafe.PointerCast, Memory{Allocate, Release}, Global{Read, Write}]:
            return false if not prepared_destination_inspector_open()
            if prepared_destination_inspector_stale():
                invalidate_prepared_destination_inspector()
                return true
            if prepared_destination_accessibility_ready:
                if export_batch_destination_accessibility_event(widget, event,
                        prepared_destination_inspector_state, prepared_destination_inspector_paths,
                        prepared_destination_path_model,
                        prepared_destination_location_widgets, prepared_destination_control_widgets) is focus:
                    prepared_destination_inspector_state.focus <- focus
                    _ = UiFlat::request_focus(widget)
                    prepared_destination_inspector_activate(focus)
            # All background native actions are consumed while this modal is up.
            return true
