# The studio's 2D panels, drawn immediate-mode with elisa-ui primitives:
# window layout, the toolbar with code-drawn vector icons, the timeline
# (problem markers, contact bars, operation scope, playhead), the curve view
# (source vs cleaned per-bone curves) and the operation stack panel. Hit
# tests return action codes the app dispatches; all pixel mapping goes
# through the proved Timeline and StudioView kernels.
#
# elisa-ui records at most UiCore::MAX_COMMANDS (1024) draw commands a
# frame, so curves and markers are binned to a fixed number of segments.
include "text.elisa"
include "storage_accessibility_copy.elisa"
include "scene.elisa"
include "../chrome.elisa"
include "../contact_editor.elisa"
include "../file_policy.elisa"
include "../replacement.elisa"
include "../legacy_session_prompt.elisa"
include "../accessibility.elisa"
include "../issues.elisa"
include "../issue_browser_policy.elisa"
include "../issue_filter_policy.elisa"
include "../reset_scope.elisa"
include "../operation_duplicate_policy.elisa"
include "../sidebar_layout.elisa"
include "../export_review.elisa"
include "../export_path_review.elisa"
include "../export_result.elisa"
include "../io/storage_manifest.elisa"
include "../../../build/generated/studio_icon_paths.elisa"

module StudioDraw:
    public:
        def color(r: u8, g: u8, b: u8) -> UiCore::Color:
            UiCore::rgb(r, g, b)

        def rect(x: f32, y: f32, w: f32, h: f32, c: UiCore::Color) -> void can[Global{Read, Write}]:
            UiCore::fill(UiCore::Rect(x, y, w, h), c)

        def segment(x1: f32, y1: f32, x2: f32, y2: f32, width: f32, c: UiCore::Color) -> void can[Global{Read, Write}]:
            UiCore::fill_stroke(UiCore::Line{from_point: UiCore::Vec2(x1, y1), to_point: UiCore::Vec2(x2, y2)}, width, c)

        def tri(ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, c: UiCore::Color) -> void can[Global{Read, Write}]:
            UiCore::fill(UiCore::Triangle{a: UiCore::Vec2(ax, ay), b: UiCore::Vec2(bx, by), c: UiCore::Vec2(cx, cy)}, c)

        def disc(x: f32, y: f32, r: f32, c: UiCore::Color) -> void can[Global{Read, Write}]:
            UiCore::fill(UiCore::Circle{center: UiCore::Vec2(x, y), radius: r}, c)

        # Octagon outline (enough for 16-24 px icons).
        def ring(x: f32, y: f32, r: f32, width: f32, c: UiCore::Color) -> void can[Global{Read, Write}]:
            d: f32 = r * 0.7071
            StudioDraw::segment(x + r, y, x + d, y + d, width, c)
            StudioDraw::segment(x + d, y + d, x, y + r, width, c)
            StudioDraw::segment(x, y + r, x - d, y + d, width, c)
            StudioDraw::segment(x - d, y + d, x - r, y, width, c)
            StudioDraw::segment(x - r, y, x - d, y - d, width, c)
            StudioDraw::segment(x - d, y - d, x, y - r, width, c)
            StudioDraw::segment(x, y - r, x + d, y - d, width, c)
            StudioDraw::segment(x + d, y - d, x + r, y, width, c)

        def text(x: f32, y: f32, size: f32, body: sview, c: UiCore::Color) -> void can[Global{Read, Write}]:
            UiCore::draw(UiCore::TextRun(UiCore::Vec2(x, y), size, body), c)

        def bold(x: f32, y: f32, size: f32, body: sview, c: UiCore::Color) -> void can[Global{Read, Write}]:
            UiCore::draw(UiCore::TextRun(UiCore::Vec2(x, y), size, body, true), c)

        def ink() -> UiCore::Color:
            color(226, 230, 238)

        def muted() -> UiCore::Color:
            color(140, 148, 166)

        def accent() -> UiCore::Color:
            color(255, 170, 40)

        def panel() -> UiCore::Color:
            color(30, 34, 44)

        def severity_color(level: i64) -> UiCore::Color:
            return color(250, 210, 60) if level == 1
            return color(250, 130, 40) if level == 2
            color(240, 50, 50)

# Toolbar and stack icons: Lucide (ISC, assets/icons/lucide) plus custom
# mocap icons (assets/icons/custom), 24px 2px-stroke SVGs flattened to line
# segments by tools/svg_icons.py into build/generated/studio_icon_paths.elisa.
# Codes are StudioIconPaths' codes; each icon fills an s x s box at (x, y).
module StudioIcons:
    public:
        const enum Icon of i64:
            None = -1
            Play = 0
            Pause = 1
            Back = 2
            Forward = 3
            Loop = 4
            Undo = 5
            Redo = 6
            Trails = 7
            Contacts = 8
            Heat = 9
            Onion = 10
            Ghost = 11
            Xray = 12
            Mesh = 13
            Export = 14
            Frame = 15
            Eye = 16
            EyeOff = 17
            Up = 18
            Down = 19
            Trash = 20
            Plus = 21
            Balance = 22
            Clean = 23
            Open = 24
            Save = 25
            FootFix = 26
            Pivot = 27
            Spike = 28
            Retime = 29

        const module IconSize:
            REFERENCE_UNITS: f32 = 12.0
            MIN_STROKE: f32 = 1.2

        # Codes are the stable generated StudioIconPaths codes.
        def draw(icon: Icon, x: f32, y: f32, s: f32, c: UiCore::Color) -> void can[Global{Read, Write}]:
            w: f32 = s / IconSize::REFERENCE_UNITS
            StudioIconPaths::draw(icon.i64(), x, y, s, w if w > IconSize::MIN_STROKE else IconSize::MIN_STROKE, c)

module StudioPanels:
    public:
        const module Layout:
            public:
                TOOLBAR: f32 = 44.0
                GAP: f32 = 8.0
            private:
                SIDEBAR: f32 = StudioSidebarLayout::Geometry::SIDEBAR_WIDTH.f32()
                TIMELINE: f32 = 116.0
                CURVE: f32 = 150.0
                STATUS: f32 = 24.0
                BUTTON: f32 = 32.0
                ROW: f32 = StudioSidebarLayout::Geometry::OPERATION_ROW_HEIGHT.f32()
    private:
        const module Capacity:
            ADD_KINDS: i64 = 5
            CURVE_SEGMENTS: i64 = 40
            MARKER_BINS: i64 = 120
            ISSUE_ROWS: i64 = StudioIssueBrowserPolicy::Capacity::VISIBLE_ROWS

        const module Menu:
            FILE_ROW: f32 = 28.0
            FILE_WIDTH: f32 = 190.0
            RESET_WIDTH: f32 = 276.0
            RESET_HEIGHT: f32 = 148.0
    public:
        const module PanelLimit:
            BUTTONS: i64 = StudioAccessibility::Capacity::TOOLBAR_ACTION_COUNT
            ISSUE_FILTERED_ROWS: i64 = 1

    public:
        const module IssueAction:
            ISSUE_PREVIOUS: i64 = StudioIssueBrowserPolicy::Action.Previous.i64()
            ISSUE_NEXT: i64 = StudioIssueBrowserPolicy::Action.Next.i64()
            ISSUE_WORST: i64 = StudioIssueBrowserPolicy::Action.Worst.i64()

    private:
        const module ResetAction:
            RESET_CLEAR_CONTACTS: i64 = StudioResetScope::Action.CLEAR_CONTACTS.i64()
            RESET_CLEAR_CORRECTIONS: i64 = StudioResetScope::Action.CLEAR_CORRECTIONS.i64()
            RESET_RESTORE_SOURCE: i64 = StudioResetScope::Action.RESTORE_SOURCE.i64()

    public:
        const module IssueId:
            ISSUE_GROUP_ID: usize = StudioIssueBrowserPolicy::Accessibility::GROUP_ID
            ISSUE_PREVIOUS_ID: usize = StudioIssueBrowserPolicy::Accessibility::PREVIOUS_ID
            ISSUE_NEXT_ID: usize = StudioIssueBrowserPolicy::Accessibility::NEXT_ID
            ISSUE_WORST_ID: usize = StudioIssueBrowserPolicy::Accessibility::WORST_ID

    private:
        const module PrivateIssueId:
            ISSUE_ROW_ID_FIRST: usize = StudioIssueBrowserPolicy::Accessibility::ROW_ID_FIRST

    public:
        const enum IssueFilter of i64:
            Detector = 0
            Subject = 1
            Severity = 2
            Status = 3
            Reset = 4

    private:
        const module DispositionAction:
            ISSUE_DISPOSITION_TOGGLE: i64 = 5

    public:
        const enum ContactEndpointHit of i64:
            First = -2
            Last = -3

    public:
        const enum ToolbarAction of i64:
            Play = 0
            Back = 1
            Forward = 2
            Speed = 3
            Loop = 4
            Undo = 5
            Redo = 6
            Trails = 7
            Contacts = 8
            Heat = 9
            Onion = 10
            Ghost = 11
            Xray = 12
            Mesh = 13
            Frame = 14
            Open = 15
            Export = 16
            Balance = 17

    private:
        const module PrivateToolbarAction:
            Clean: i64 = 18

    public:
        const enum StackHit of i64:
            Select = 1
            Toggle = 2
            Up = 3
            Down = 4
            Remove = 5
            Add = 6
            Duplicate = 7

    public:
        struct Box:
            x: f32
            y: f32
            w: f32
            h: f32

        def box(x: f32, y: f32, w: f32, h: f32) -> Box:
            Box{x: x, y: y, w: w if w > 1.0 else 1.0, h: h if h > 1.0 else 1.0}

        def inside(b: Box, px: f32, py: f32) -> bool:
            return StudioView::inside(px.i64(), py.i64(), b.x.i64(), b.y.i64(), b.w.i64(), b.h.i64())

        # Window layout for a `w` x `h` point window.
        def main_width(w: f32) -> f32:
            v: f32 = w - Layout::SIDEBAR - 2.0 * Layout::GAP
            v if v > 200.0 else 200.0

        def views_height(h: f32) -> f32:
            v: f32 = h - Layout::TOOLBAR - Layout::CURVE - Layout::TIMELINE - Layout::STATUS - 3.0 * Layout::GAP
            v if v > 160.0 else 160.0

        def view_box(index: usize, w: f32, h: f32) -> Box:
            mw: f32 = main_width(w)
            vh: f32 = views_height(h)
            top: f32 = vh * 0.6
            return box(Layout::GAP, Layout::TOOLBAR, mw, top - Layout::GAP * 0.5) if index == 0
            half: f32 = (mw - Layout::GAP) * 0.5
            return box(Layout::GAP, Layout::TOOLBAR + top + Layout::GAP * 0.5, half, vh - top - Layout::GAP * 0.5) if index == 1
            box(Layout::GAP + half + Layout::GAP, Layout::TOOLBAR + top + Layout::GAP * 0.5, half, vh - top - Layout::GAP * 0.5)

        def curve_box(w: f32, h: f32) -> Box:
            box(Layout::GAP, Layout::TOOLBAR + views_height(h) + Layout::GAP, main_width(w), Layout::CURVE)

        def timeline_box(w: f32, h: f32) -> Box:
            box(Layout::GAP, Layout::TOOLBAR + views_height(h) + Layout::CURVE + 2.0 * Layout::GAP, main_width(w), Layout::TIMELINE)

        def status_box(w: f32, h: f32) -> Box:
            box(0.0, h - Layout::STATUS, w - Layout::SIDEBAR, Layout::STATUS)

        def sidebar_box(w: f32, h: f32) -> Box:
            box(w - Layout::SIDEBAR, 0.0, Layout::SIDEBAR, h)

        # Compact status badge in the sidebar header. It stays to the right
        # of the title and uses the same bounds for drawing and accessibility.
        def balance_status_box(sb: Box) -> Box:
            box(sb.x + StudioSidebarLayout::Geometry::BALANCE_BADGE_LEFT.f32(), sb.y + StudioSidebarLayout::Geometry::BALANCE_BADGE_TOP.f32(), StudioSidebarLayout::Geometry::BALANCE_BADGE_WIDTH.f32(), StudioSidebarLayout::Geometry::BALANCE_BADGE_HEIGHT.f32())

        # Inner strip of the timeline the frames map onto.
        def strip(t: Box) -> Box:
            box(t.x + 12.0, t.y, t.w - 196.0, t.h)

        def button_x(i: i64) -> f32:
            groups: i64 = (1 if i >= ToolbarAction.Undo.i64() else 0) + (1 if i >= ToolbarAction.Trails.i64() else 0) + (1 if i >= ToolbarAction.Frame.i64() else 0) + (1 if i >= PrivateToolbarAction::Clean else 0)
            Layout::GAP + i.f32() * (Layout::BUTTON + 4.0) + groups.f32() * 14.0

        def button_box(i: i64) -> Box:
            box(button_x(i), 6.0, Layout::BUTTON, Layout::BUTTON)

        def toolbar_hit(px: f32, py: f32) -> i64:
            for i in 0..<PanelLimit::BUTTONS |i, px, py|:
                return i if inside(button_box(i), px, py)
            return -1
