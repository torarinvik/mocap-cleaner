include "app_state.elisa"

extend Studio:
    private:
        def init_accessibility_toolbar() -> void:
            UiFlat::reset()
            transparent: UiCore::Color = UiCore::Color{r: 0, g: 0, b: 0, a: 0}
            for action in 0..<StudioPanels::BUTTONS:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0,
                    transparent, transparent, transparent)
                return if widget == UiFlat::NONE or widget != action.usize()
                accessibility_toolbar_widgets[action.usize()] <- widget
            accessibility_toolbar_ready <- true
            accessibility_file_trigger_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable file_widgets_ready: bool = accessibility_file_trigger_widget != UiFlat::NONE
            for row in 0..<StudioFilePolicy::ROWS |row, file_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_file_menu_widgets[row.usize()] <- widget
                file_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_file_ready <- file_widgets_ready
            mutable storage_widgets_ready: bool = true
            for action in 0..<StudioPanels::StorageAction::COUNT |action, storage_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_storage_action_widgets[action.usize()] <- widget
                storage_widgets_ready <- false if widget == UiFlat::NONE
            for row in 0..<StudioStorageAccessibilityPolicy::Node::ROW_COUNT |row, storage_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_storage_row_widgets[row.usize()] <- widget
                accessibility_storage_row_indices[row.usize()] <- -1
                storage_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_storage_ready <- storage_widgets_ready
            accessibility_review_ack_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_destination_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_cancel_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_export_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable warning_widgets_ready: bool = true
            for index in 0..<StudioExportReview::MAX_WARNINGS |index, warning_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_review_warning_widgets[index.usize()] <- widget
                warning_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_review_ready <- accessibility_review_ack_widget != UiFlat::NONE and accessibility_review_destination_widget != UiFlat::NONE and accessibility_review_cancel_widget != UiFlat::NONE and accessibility_review_export_widget != UiFlat::NONE and warning_widgets_ready
            accessibility_warning_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_ready <- accessibility_warning_previous_widget != UiFlat::NONE and accessibility_warning_next_widget != UiFlat::NONE and accessibility_warning_done_widget != UiFlat::NONE
            accessibility_path_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_ready <- accessibility_path_previous_widget != UiFlat::NONE and accessibility_path_next_widget != UiFlat::NONE and accessibility_path_done_widget != UiFlat::NONE
            accessibility_result_open_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_folder_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_ready <- accessibility_result_open_widget != UiFlat::NONE and accessibility_result_folder_widget != UiFlat::NONE and accessibility_result_done_widget != UiFlat::NONE
            accessibility_contact_plant_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_lift_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_reset_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_delete_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_merge_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_split_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_ready <- accessibility_contact_plant_widget != UiFlat::NONE and accessibility_contact_lift_widget != UiFlat::NONE and accessibility_contact_reset_widget != UiFlat::NONE and accessibility_contact_delete_widget != UiFlat::NONE and accessibility_contact_merge_widget != UiFlat::NONE and accessibility_contact_split_widget != UiFlat::NONE
            accessibility_reset_trigger_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_contacts_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_corrections_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_source_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_ready <- accessibility_reset_trigger_widget != UiFlat::NONE and accessibility_reset_contacts_widget != UiFlat::NONE and accessibility_reset_corrections_widget != UiFlat::NONE and accessibility_reset_source_widget != UiFlat::NONE
            accessibility_stack_duplicate_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_stack_ready <- accessibility_stack_duplicate_widget != UiFlat::NONE
            accessibility_issue_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_worst_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable issue_widgets_ready: bool = accessibility_issue_previous_widget != UiFlat::NONE and accessibility_issue_next_widget != UiFlat::NONE and accessibility_issue_worst_widget != UiFlat::NONE
            mutable issue_filter_widgets_ready: bool = true
            for index in 0..<4 |index, issue_filter_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_issue_filter_widgets[index.usize()] <- widget
                issue_filter_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_issue_filter_reset_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_intent_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_filter_ready <- issue_filter_widgets_ready and accessibility_issue_filter_reset_widget != UiFlat::NONE and accessibility_issue_intent_widget != UiFlat::NONE
            for index in 0..<StudioPanels::ISSUE_FILTERED_ROWS |index, issue_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_issue_row_widgets[index.usize()] <- widget
                issue_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_issue_ready <- issue_widgets_ready

        def toolbar_accessibility_role(action: i64) -> UiCore::AccessibilityRole:
            return UiCore::AccessibilityRole.CheckBox if action == StudioPanels::A_LOOP or action == StudioPanels::A_TRAILS or action == StudioPanels::A_CONTACTS or action == StudioPanels::A_HEAT or action == StudioPanels::A_ONION or action == StudioPanels::A_GHOST or action == StudioPanels::A_XRAY or action == StudioPanels::A_MESH or action == StudioPanels::A_BALANCE
            UiCore::AccessibilityRole.Button

        def toolbar_accessibility_enabled(action: i64, can_undo: bool, can_redo: bool) -> bool:
            return can_undo if action == StudioPanels::A_UNDO
            return can_redo if action == StudioPanels::A_REDO
            true

        def toolbar_accessibility_value(action: i64, t: TimelineState::State&) -> sview:
            return TimelineState::speed_label(t.divisor) if action == StudioPanels::A_SPEED
            return "Playing" if t.playing and action == StudioPanels::A_PLAY
            return "Paused" if action == StudioPanels::A_PLAY
            ""

        def toolbar_accessibility_selected(action: i64, flags: i64, t: TimelineState::State&) -> bool:
            return StudioPanels::lit(action, flags, t) if toolbar_accessibility_role(action) == UiCore::AccessibilityRole.CheckBox
            false

    public:
        def toolbar_accessibility_action(widget: usize, event: i32) -> void:
            if storage_path_inspector and export_path_inspector_open:
                if event == UiConst::WidgetEvent.Click.i32() and accessibility_path_ready:
                    activate_export_path_inspector(StudioExportPathReview::PREVIOUS) if widget == accessibility_path_previous_widget
                    activate_export_path_inspector(StudioExportPathReview::NEXT) if widget == accessibility_path_next_widget
                    activate_export_path_inspector(StudioExportPathReview::DONE) if widget == accessibility_path_done_widget
                return
            if event == UiConst::WidgetEvent.Click.i32() and accessibility_file_ready:
                if widget == accessibility_file_trigger_widget:
                    file_menu_open <- not file_menu_open
                    file_menu_focus <- 0 if file_menu_open
                    file_menu_hover <- -1
                    touch()
                    return
                if file_menu_open:
                    for row in 0..<StudioFilePolicy::ROWS |row, widget|:
                        if widget == accessibility_file_menu_widgets[row.usize()]:
                            activate_file_menu(row)
                            return
            if event == UiConst::WidgetEvent.Click.i32() and storage_screen_open and not storage_path_inspector and accessibility_storage_ready:
                for slot in 0..<StudioStorageAccessibilityPolicy::Node::ROW_COUNT |slot, widget, storage_selected, storage_focus|:
                    if widget == accessibility_storage_row_widgets[slot.usize()] and accessibility_storage_row_indices[slot.usize()] >= 0:
                        storage_selected <- accessibility_storage_row_indices[slot.usize()]
                        storage_restore_review <- false
                        storage_move_review <- false
                        storage_focus <- -1
                        toggle_storage_cleanup_row(storage_selected)
                        touch()
                        return
                for action in 0..<StudioPanels::StorageAction::COUNT |action, widget, storage_focus|:
                    if widget == accessibility_storage_action_widgets[action.usize()]:
                        storage_focus <- action
                        storage_action(action)
                        return
            if accessibility_stack_ready and event == UiConst::WidgetEvent.Click.i32() and widget == accessibility_stack_duplicate_widget:
                reset_menu_open <- false
                duplicate_selected()
                return
            if accessibility_reset_ready and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_reset_trigger_widget:
                    reset_menu_open <- not reset_menu_open
                    touch()
                    return
                if reset_menu_open:
                    reset_menu_open <- false
                    if widget == accessibility_reset_contacts_widget:
                        reset_cleanup(StudioResetScope::CLEAR_CONTACTS)
                    elif widget == accessibility_reset_corrections_widget:
                        reset_cleanup(StudioResetScope::CLEAR_CORRECTIONS)
                    elif widget == accessibility_reset_source_widget:
                        reset_cleanup(StudioResetScope::RESTORE_SOURCE)
                    else:
                        touch()
                    return
            if accessibility_issue_ready and event == UiConst::WidgetEvent.Click.i32():
                if accessibility_issue_filter_ready:
                    for field in 0..<4 |field, widget|:
                        if widget == accessibility_issue_filter_widgets[field.usize()]:
                            cycle_issue_filter(field)
                            return
                    if widget == accessibility_issue_filter_reset_widget:
                        reset_issue_filters()
                        return
                    elif widget == accessibility_issue_intent_widget:
                        toggle_issue_intent()
                        return
                if widget == accessibility_issue_previous_widget:
                    issue_navigation(StudioPanels::ISSUE_PREVIOUS)
                    return
                elif widget == accessibility_issue_next_widget:
                    issue_navigation(StudioPanels::ISSUE_NEXT)
                    return
                elif widget == accessibility_issue_worst_widget:
                    issue_navigation(StudioPanels::ISSUE_WORST)
                    return
                for index in 0..<StudioPanels::ISSUE_FILTERED_ROWS |index, widget|:
                    if widget == accessibility_issue_row_widgets[index.usize()] and StudioPanels::issue_row_route_enabled(index, StudioPanels::ISSUE_FILTERED_ROWS, issues_revision == built):
                        navigate_issue(visible_issue_first() + index)
                        return
            if accessibility_contact_ready and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_contact_plant_widget:
                    contact_apply(StudioContactEditor::PLANT)
                    return
                elif widget == accessibility_contact_lift_widget:
                    contact_apply(StudioContactEditor::LIFT)
                    return
                elif widget == accessibility_contact_reset_widget:
                    contact_apply(StudioContactEditor::RESET)
                    return
                elif widget == accessibility_contact_delete_widget:
                    contact_apply(StudioContactEditor::DELETE)
                    return
                elif widget == accessibility_contact_merge_widget:
                    contact_apply(StudioContactEditor::MERGE)
                    return
                elif widget == accessibility_contact_split_widget:
                    contact_apply(StudioContactEditor::SPLIT)
                    return
            if accessibility_warning_ready and export_warning_detail_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_warning_previous_widget:
                    activate_export_warning_detail(StudioExportPathReview::PREVIOUS)
                    return
                elif widget == accessibility_warning_next_widget:
                    activate_export_warning_detail(StudioExportPathReview::NEXT)
                    return
                elif widget == accessibility_warning_done_widget:
                    activate_export_warning_detail(StudioExportPathReview::DONE)
                    return
            if accessibility_path_ready and export_path_inspector_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_path_previous_widget:
                    activate_export_path_inspector(StudioExportPathReview::PREVIOUS)
                    return
                elif widget == accessibility_path_next_widget:
                    activate_export_path_inspector(StudioExportPathReview::NEXT)
                    return
                elif widget == accessibility_path_done_widget:
                    activate_export_path_inspector(StudioExportPathReview::DONE)
                    return
            if accessibility_result_ready and export_result_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_result_open_widget:
                    activate_export_result(StudioExportResult::OPEN)
                    return
                elif widget == accessibility_result_folder_widget:
                    activate_export_result(StudioExportResult::SHOW_IN_FOLDER)
                    return
                elif widget == accessibility_result_done_widget:
                    activate_export_result(StudioExportResult::DONE)
                    return
            if accessibility_review_ready and export_review_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_review_ack_widget:
                    activate_export_review(StudioExportReview::ACKNOWLEDGE)
                    return
                elif widget == accessibility_review_destination_widget:
                    activate_export_review(StudioExportReview::DESTINATION)
                    return
                elif widget == accessibility_review_cancel_widget:
                    activate_export_review(StudioExportReview::CANCEL)
                    return
                elif widget == accessibility_review_export_widget:
                    activate_export_review(StudioExportReview::EXPORT)
                    return
                for index in 0..<current_export_warnings() |index, widget|:
                    if widget == accessibility_review_warning_widgets[index.usize()]:
                        open_export_warning_detail(index)
                        return
            return if not accessibility_toolbar_ready or event != UiConst::WidgetEvent.Click.i32()
            action: i64 = StudioAccessibility::toolbar_action_for_widget(widget)
            toolbar_action(action) if action >= 0

        # Publish stable region landmarks and actionable toolbar controls.
