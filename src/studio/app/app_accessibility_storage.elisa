include "app_state.elisa"

extend Studio:
    private:
        def workspace_accessibility_status() -> sview can[Global.Read]:
            can Global.Read:
                return "Workspace available. Derived files are saved under its build folder." if workspace_available()
                return status

        def accessibility_node(role: UiCore::AccessibilityRole, label: sview, help_text: sview, b: StudioPanels::Box, id: usize, parent_id: usize, first_child_id: usize, next_sibling_id: usize, action: usize, enabled: bool, selected: bool, text_value: sview) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                selected_warning_node: bool = export_review_open and current_export_warnings() > 0 and id == StudioAccessibility::export_review_warning_id(export_review_warning_selected)
                detail_control_focused: bool = (id == StudioAccessibility::SemanticId::WARNING_DETAIL_PREVIOUS and export_warning_detail_focus == StudioExportPathReview::Control.Previous.i64()) or (id == StudioAccessibility::SemanticId::WARNING_DETAIL_NEXT and export_warning_detail_focus == StudioExportPathReview::Control.Next.i64()) or (id == StudioAccessibility::SemanticId::WARNING_DETAIL_DONE and export_warning_detail_focus == StudioExportPathReview::Control.Done.i64())
                file_menu_focused: bool = file_menu_open and file_menu_focus >= 0 and file_menu_focus < StudioFilePolicy::row_count(workspace_needs_build_confirmation()) and id == StudioStorageAccessibilityPolicy::file_command_id(file_menu_focus.usize())
                storage_action_focused: bool = storage_screen_open and storage_focus >= 0 and storage_focus < StudioPanels::StorageAction::COUNT and id == StudioStorageAccessibilityPolicy::action_id(storage_focus)
                batch_queue_entry_focused: bool = id == StudioAccessibility::SemanticId::QUEUE_ENTRY and UiFlat::focused() == accessibility_batch_queue_open_widget
                mutable storage_row_focused: bool = false
                if storage_screen_open and storage_focus < 0:
                    for row in 0..<StudioStorageAccessibilityPolicy::Node::ROW_COUNT |row, id, storage_selected, storage_row_focused|:
                        storage_row_focused <- true if id == StudioStorageAccessibilityPolicy::row_id(row.usize()) and accessibility_storage_row_indices[row.usize()] == storage_selected
                focused: bool = file_menu_focused or storage_action_focused or storage_row_focused or batch_queue_entry_focused or (id == 239 and export_recovery_entry_focused) or (export_review_open and ((id == StudioAccessibility::SemanticId::REVIEW_ACKNOWLEDGEMENT and export_review_focus == StudioExportReview::Control.ACKNOWLEDGE.i64()) or (id == StudioAccessibility::SemanticId::REVIEW_DESTINATION and export_review_focus == StudioExportReview::Control.DESTINATION.i64()) or (id == StudioAccessibility::SemanticId::REVIEW_CANCEL and export_review_focus == StudioExportReview::Control.CANCEL.i64()) or (id == StudioAccessibility::SemanticId::REVIEW_EXPORT and export_review_focus == StudioExportReview::Control.EXPORT.i64()) or (id == StudioAccessibility::SemanticId::REVIEW_QUEUE and export_review_focus == StudioExportReview::Control.QUEUE.i64()) or (selected_warning_node and export_review_focus == StudioExportReview::Control.INSPECT_WARNINGS.i64()))) or (export_warning_detail_open and detail_control_focused) or (export_path_inspector_open and ((id == StudioAccessibility::SemanticId::PATH_PREVIOUS and export_path_inspector_focus == StudioExportPathReview::Control.Previous.i64()) or (id == StudioAccessibility::SemanticId::PATH_NEXT and export_path_inspector_focus == StudioExportPathReview::Control.Next.i64()) or (id == StudioAccessibility::SemanticId::PATH_DONE and export_path_inspector_focus == StudioExportPathReview::Control.Done.i64()))) or (export_result_open and ((id == StudioAccessibility::SemanticId::RESULT_OPEN and export_result_focus == StudioExportResult::Action::OPEN) or (id == StudioAccessibility::SemanticId::RESULT_SHOW_IN_FOLDER and export_result_focus == StudioExportResult::Action::SHOW_IN_FOLDER) or (id == StudioAccessibility::SemanticId::RESULT_DONE and export_result_focus == StudioExportResult::Action::DONE)))
                UiCore::accessibility_with_metadata(role, label, help_text,
                    UiCore::Rect(b.x, b.y, b.w, b.h), id, action,
                    enabled, focused, selected, 0.0,
                    text_value, "", revision.usize(), 0, 0, parent_id,
                    first_child_id, next_sibling_id, 0.0, 1.0, false)

        def publish_file_accessibility(w: f32, h: f32, standalone: bool) -> void can[Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not accessibility_file_ready
                none: usize = StudioAccessibility::SemanticId::NO_NODE
                sidebar: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
                if standalone:
                    accessibility_node(UiCore::AccessibilityRole.Group,
                        "Mocap Studio workspace",
                        "Workspace status and File commands are available before a take is loaded.",
                        StudioPanels::box(0.0, 0.0, w, h), StudioAccessibility::SemanticId::WORKSPACE,
                        none, StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER, none,
                        none, true, false, "")
                UiFlat::set_enabled(accessibility_file_trigger_widget, true)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    StudioStorageAccessibilityCopy::file_trigger_name(),
                    "Open Workspace / File. Locate workspace, explicitly create build/, or open a take. Storage & Recovery is available without a loaded take.",
                    StudioPanels::file_button_box(sidebar),
                    StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER,
                    StudioAccessibility::SemanticId::WORKSPACE,
                    StudioStorageAccessibilityPolicy::file_first_child(StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER, workspace_needs_build_confirmation()) if file_menu_open else none,
                    StudioAccessibility::SemanticId::STATUS if standalone else none,
                    accessibility_file_trigger_widget, true, file_menu_open,
                    "Open" if not file_menu_open else "Close")
                if standalone:
                    accessibility_node(UiCore::AccessibilityRole.Status,
                        "Workspace status",
                        "Current workspace availability and setup result.",
                        StudioPanels::status_box(w, h), StudioAccessibility::SemanticId::STATUS,
                        StudioAccessibility::SemanticId::WORKSPACE, none, none, none, true, false,
                        workspace_accessibility_status())
                if file_menu_open:
                    accessibility_node(UiCore::AccessibilityRole.List,
                        StudioStorageAccessibilityCopy::file_menu_name(),
                        "Locate or replace a workspace at any time. Create build and Cancel setup appear while setup is pending.",
                        StudioPanels::file_popup_box(sidebar, workspace_needs_build_confirmation()),
                        StudioStorageAccessibilityPolicy::Node::FILE_MENU,
                        StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER,
                        StudioStorageAccessibilityPolicy::file_first_child(StudioStorageAccessibilityPolicy::Node::FILE_MENU, workspace_needs_build_confirmation()),
                        none, none, true, false, "")
                    if workspace_needs_build_confirmation():
                        accessibility_node(UiCore::AccessibilityRole.Label,
                            "Pending workspace path",
                            "Exact selected root for the pending setup. Create build/ applies to this folder; Cancel clears this setup.",
                            StudioPanels::file_menu_header_box(sidebar, true),
                            StudioStorageAccessibilityPolicy::Node::PENDING_WORKSPACE_PATH,
                            StudioStorageAccessibilityPolicy::Node::FILE_MENU, none,
                            StudioStorageAccessibilityPolicy::Node::FILE_COMMAND_FIRST,
                            none, true, false, workspace_pending_accessibility_path())
                    for row in 0..<StudioFilePolicy::row_count(workspace_needs_build_confirmation()) |row, w, h, clip, workspace_ready|:
                        id: usize = StudioStorageAccessibilityPolicy::file_command_id(row.usize())
                        widget: usize = accessibility_file_menu_widgets[row.usize()]
                        command: i64 = StudioFilePolicy::action_for(row, workspace_needs_build_confirmation())
                        enabled: bool = StudioFilePolicy::available(command, clip != null, workspace_ready)
                        UiFlat::set_enabled(widget, enabled)
                        accessibility_node(UiCore::AccessibilityRole.Button,
                            StudioStorageAccessibilityCopy::file_command_name(row),
                            StudioStorageAccessibilityCopy::file_command_help(row, clip != null, workspace_ready, workspace_needs_build_confirmation()),
                            StudioPanels::file_menu_row_box(sidebar, row, workspace_needs_build_confirmation()), id,
                            StudioStorageAccessibilityPolicy::Node::FILE_MENU, none,
                            StudioStorageAccessibilityPolicy::file_next_sibling(id, workspace_needs_build_confirmation()),
                            widget, enabled, row == file_menu_focus,
                            StudioPanels::file_menu_shortcut(row))
                UiFlat::set_enabled(accessibility_recovery_open_widget, export_recovery_entry_available())
                if export_recovery_entry_available():
                    accessibility_node(UiCore::AccessibilityRole.Button,
                        "Pending exports",
                        "Review session retained export recovery records. This entry is available before loading a take.",
                        StudioPanels::export_recovery_entry_box(w), 239,
                        StudioAccessibility::SemanticId::NO_NODE, StudioAccessibility::SemanticId::NO_NODE,
                        StudioAccessibility::SemanticId::NO_NODE, accessibility_recovery_open_widget,
                        true, false, "")
                queue_entry_enabled: bool = not standalone and accessibility_batch_queue_open_widget != UiFlat::NONE and prepared_queue_entry_available()
                if accessibility_batch_queue_open_widget != UiFlat::NONE:
                    UiFlat::set_enabled(accessibility_batch_queue_open_widget, queue_entry_enabled)
                    if queue_entry_enabled:
                        accessibility_node(UiCore::AccessibilityRole.Button,
                            "Export queue",
                            "Open the retained prepared-export queue. Available while a valid nonempty queue and the ordinary recovery entry are ready.",
                            StudioPanels::export_batch_entry_box(w), StudioAccessibility::SemanticId::QUEUE_ENTRY,
                            StudioAccessibility::SemanticId::WORKSPACE, none,
                            StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER,
                            accessibility_batch_queue_open_widget, true, false, "")

        def storage_batch_announcement() -> sview can[Global{Read, Write}]:
            can Global{Read, Write}:
                StudioText::begin()
                StudioText::put(StudioPanels::storage_batch_state_label(storage_batch_state))
                StudioText::put(". Moved and recorded: ")
                StudioText::put_i(storage_batch_completed)
                StudioText::put(". Failed or restored: ")
                StudioText::put_i(storage_batch_failed)
                StudioText::put(". Untouched: ")
                StudioText::put_i(storage_batch_untouched)
                StudioText::put(". Trash still uses disk space. Completed receipts are preserved.")
                if storage_message == 21 or storage_message == 22:
                    StudioText::put(" ")
                    StudioText::put(StudioStorageAccessibilityCopy::result_announcement(storage_message))
                return StudioText::view()

        def publish_storage_accessibility(w: f32, h: f32) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if not accessibility_storage_ready
                none: usize = StudioAccessibility::SemanticId::NO_NODE
                dialog: StudioPanels::Box = StudioPanels::storage_dialog_box(w, h)
                count: i64 = storage_visible_entries.count.i64()
                visible_count: i64 = StudioPanels::storage_visible_count(w, h, count, storage_selected)
                first: i64 = StudioPanels::storage_first_visible(w, h, count, storage_selected)
                UiFlat::set_enabled(accessibility_storage_action_widgets[StudioPanels::StorageAction::REFRESH.usize()], true)
                UiFlat::set_enabled(accessibility_storage_action_widgets[StudioPanels::StorageAction::DONE.usize()], true)
                UiFlat::set_enabled(accessibility_storage_action_widgets[StudioPanels::StorageAction::RESTORE.usize()], storage_restore_available())
                accessibility_node(UiCore::AccessibilityRole.Dialog,
                    "Review Move to Trash" if storage_move_review else StudioStorageAccessibilityCopy::dialog_name(storage_restore_review),
                    "Review every selected file, including selections hidden by the inventory filter. Confirm move to Trash after a fresh identity check, or press Escape to cancel. Trash continues to use disk space." if storage_move_review else StudioStorageAccessibilityCopy::dialog_help(storage_restore_review),
                    dialog, StudioStorageAccessibilityPolicy::Node::DIALOG, none,
                    StudioStorageAccessibilityPolicy::first_child(StudioStorageAccessibilityPolicy::Node::DIALOG, visible_count),
                    none, none, true, false, "")
                StudioText::begin()
                if count > 0:
                    StudioText::put("Visible records: ")
                    StudioText::put_i(visible_count)
                    StudioText::put(" of ")
                    StudioText::put_i(count)
                    StudioText::put(" matching records; ")
                    StudioText::put_i(storage_inventory_entries.count.i64())
                    StudioText::put(" total. Filter: ")
                    StudioText::put(StudioStorageFilterCopy::mode_name(storage_filter_mode))
                    StudioText::put(". ")
                    StudioStorageFilterCopy::append_selection(storage_cleanup_selection.count.i64(), storage_hidden_selection_count(), storage_selection_bytes)
                    StudioText::put(". Logical sizes, not estimated disk space freed. ")
                    overview_counts: darray[i64] = storage_overview_counts
                    overview_bytes: darray[i64] = storage_overview_bytes
                    for category in 0..<overview_counts.count |category, overview_counts, overview_bytes|:
                        StudioText::put(StudioPanels::storage_overview_name(category.i64()))
                        StudioText::put(": ")
                        StudioText::put_i(overview_counts[category])
                        StudioText::put(" files, ")
                        StudioText::put_i(overview_bytes[category])
                        StudioText::put(" bytes. ")
                    StudioText::put_i(storage_unverified_records)
                    StudioText::put(" unverified records; their sizes are not included in verified totals.")
                else:
                    StudioStorageFilterCopy::append_empty(storage_inventory_entries.count.i64(), storage_filter_mode)
                    StudioText::put(" ")
                    StudioStorageFilterCopy::append_selection(storage_cleanup_selection.count.i64(), storage_hidden_selection_count(), storage_selection_bytes)
                StudioText::put(" ")
                StudioStorageScanTimeCopy::append(storage_scan_seconds)
                total_value: sview = StudioText::view()
                list_box: StudioPanels::Box = StudioPanels::box(dialog.x + 22.0, dialog.y + 210.0,
                    dialog.w - 44.0, dialog.h - 332.0)
                accessibility_node(UiCore::AccessibilityRole.List,
                    "Studio-managed inventory",
                    "Select a file by name. Each row also reports its file kind, verification status, and protection reason.",
                    list_box, StudioStorageAccessibilityPolicy::Node::INVENTORY,
                    StudioStorageAccessibilityPolicy::Node::DIALOG,
                    StudioStorageAccessibilityPolicy::first_child(StudioStorageAccessibilityPolicy::Node::INVENTORY, visible_count),
                    StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::INVENTORY, visible_count),
                    none, true, false, total_value)
                mutable entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
                mutable statuses: darray[i64] = storage_visible_statuses
                reasons: darray[i64] = storage_visible_reasons
                for slot in 0..<StudioStorageAccessibilityPolicy::Node::ROW_COUNT |visible_count, first, entries, statuses, reasons, storage_selected, w, h|:
                    accessibility_storage_row_indices[slot.usize()] <- -1
                    if slot < visible_count:
                        index: i64 = first + slot
                        entry: StudioStorageManifest::Entry = entries[index]
                        status: i64 = statuses[index] if index < statuses.count.i64() else StudioPanels::StorageStatus::UNVERIFIED
                        copy: StudioStorageAccessibilityCopy::RowCopy = StudioStorageAccessibilityCopy::row_copy(entry.kind, status, storage_cleanup_is_selected(entry))
                        StudioText::begin()
                        StudioText::put(copy.kind)
                        StudioText::put(". ")
                        StudioText::put(copy.status)
                        StudioText::put(". ")
                        StudioText::put(copy.selection)
                        StudioText::put(". ")
                        StudioText::put(copy.help)
                        batch_status: i64 = StudioPanels::storage_batch_row_status(entry, storage_batch_entries, storage_batch_items)
                        if storage_batch_state != StudioStorageBatchPolicy::State.Idle.i64() and batch_status >= 0:
                            StudioText::put(". Batch result: ")
                            StudioText::put(StudioPanels::storage_batch_item_label(batch_status))
                        StudioText::put(". Size: ")
                        StudioText::put_i(entry.size_bytes)
                        StudioText::put(" bytes. Original location: ")
                        for byte in entry.original_path:
                            StudioText::byte(byte)
                        StudioText::put(". ")
                        if status == StudioPanels::StorageStatus::PRESENT:
                            StudioText::put(StudioPanels::storage_protection_label(reasons[index] if index < reasons.count.i64() else StudioStorageCleanupPolicy::ProtectionReason.IdentityUnverified.i64()))
                        id: usize = StudioStorageAccessibilityPolicy::row_id(slot.usize())
                        widget: usize = accessibility_storage_row_widgets[slot.usize()]
                        accessibility_storage_row_indices[slot.usize()] <- index
                        UiFlat::set_enabled(widget, storage_batch_state != StudioStorageBatchPolicy::State.Running.i64())
                        accessibility_node(UiCore::AccessibilityRole.CheckBox,
                            StudioPanels::storage_entry_name(entries, index), StudioText::view(),
                            StudioPanels::storage_row_box(w, h, slot), id,
                            StudioStorageAccessibilityPolicy::Node::INVENTORY, none,
                            StudioStorageAccessibilityPolicy::next_sibling(id, visible_count),
                            widget, storage_batch_state != StudioStorageBatchPolicy::State.Running.i64(), storage_cleanup_is_selected(entry), copy.selection)
                hidden_value: sview = StudioText::pair("Unverified: ", storage_unverified_records, " · hidden/protected: ", storage_protected_records)
                accessibility_node(UiCore::AccessibilityRole.Label,
                    "Protected records",
                    StudioStorageAccessibilityCopy::protected_summary(storage_unverified_records, storage_protected_records),
                    StudioPanels::box(dialog.x + 24.0, dialog.y + 72.0, dialog.w - 48.0, 22.0),
                    StudioStorageAccessibilityPolicy::Node::PROTECTED,
                    StudioStorageAccessibilityPolicy::Node::DIALOG, none,
                    StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::Node::PROTECTED, visible_count),
                    none, true, false, hidden_value)
                mutable restore_ready: bool = storage_restore_available()
                trash_ready: bool = storage_trash_available()
                for action in 0..<StudioPanels::StorageAction::COUNT |w, h, storage_restore_review, storage_move_review, restore_ready, trash_ready|:
                    id: usize = StudioStorageAccessibilityPolicy::action_id(action)
                    widget: usize = accessibility_storage_action_widgets[action.usize()]
                    enabled: bool = action == StudioPanels::StorageAction::DONE if storage_batch_state == StudioStorageBatchPolicy::State.Running.i64() else storage_filter_available() if action == StudioPanels::StorageAction::FILTER else storage_path_inspection_available() if action == StudioPanels::StorageAction::INSPECT_PATH else StudioStorageAccessibilityPolicy::action_enabled_with_exemption(action, restore_ready, trash_ready, storage_exemption_available())
                    UiFlat::set_enabled(widget, enabled)
                    accessibility_node(UiCore::AccessibilityRole.Button,
                        "Inventory filter" if action == StudioPanels::StorageAction::FILTER else "Inspect full recorded path" if action == StudioPanels::StorageAction::INSPECT_PATH else ("Remove exemption" if storage_inspected_exempt() else "Keep this file") if action == StudioPanels::StorageAction::EXEMPTION else "Cancel cleanup" if action == StudioPanels::StorageAction::DONE and storage_batch_state == StudioStorageBatchPolicy::State.Running.i64() else StudioStorageAccessibilityCopy::retention_value(StudioStorageSelectionPolicy::retention_days(storage_retention_preset)) if action == StudioPanels::StorageAction::RETENTION else StudioStorageAccessibilityCopy::action_name_with_reviews(action, storage_restore_review, storage_move_review),
                        "Cycle the inventory filter. Hidden selections stay selected; Select eligible replaces selection with eligible matching rows, and Clear selection clears every selection." if action == StudioPanels::StorageAction::FILTER else "Read the entire recorded original location. Does not change cleanup selection or confirm a move." if action == StudioPanels::StorageAction::INSPECT_PATH else "Keep this verified file version out of cleanup, or remove its saved exemption. Changing protection never moves files; removing it still requires a fresh Move review." if action == StudioPanels::StorageAction::EXEMPTION else "Stop cleanup before the next file. Completed receipts remain saved." if action == StudioPanels::StorageAction::DONE and storage_batch_state == StudioStorageBatchPolicy::State.Running.i64() else StudioStorageAccessibilityCopy::action_help_with_cleanup(action, restore_ready, storage_restore_review, trash_ready, storage_move_review),
                        StudioPanels::storage_button_box(w, h, action), id,
                        StudioStorageAccessibilityPolicy::Node::DIALOG, none,
                        StudioStorageAccessibilityPolicy::next_sibling(id, visible_count),
                        widget, enabled, false, StudioStorageFilterCopy::mode_name(storage_filter_mode) if action == StudioPanels::StorageAction::FILTER else "")
                mutable message_role: UiCore::AccessibilityRole = UiCore::AccessibilityRole.Status
                message_role <- UiCore::AccessibilityRole.Alert if StudioStorageAccessibilityPolicy::result_is_alert(storage_message) or storage_batch_state == StudioStorageBatchPolicy::State.StopUnknown.i64() or storage_batch_state == StudioStorageBatchPolicy::State.StopRecoveryRequired.i64() or storage_batch_state == StudioStorageBatchPolicy::State.StopInvalid.i64()
                accessibility_node(message_role,
                    "Storage result",
                    "The latest Storage & Recovery result.",
                    StudioPanels::box(dialog.x + 24.0, dialog.y + dialog.h - 90.0, dialog.w - 48.0, 24.0),
                    StudioStorageAccessibilityPolicy::Node::ANNOUNCEMENT,
                    StudioStorageAccessibilityPolicy::Node::DIALOG, none,
                    StudioGenerationReviewAccessibilityPolicy::Node::STORAGE_ENTRY,
                    none, true, false,
                    storage_batch_announcement() if storage_batch_state != StudioStorageBatchPolicy::State.Idle.i64() else "No eligible files. Review protection reasons and retention; Refresh after changes." if storage_message == 3 and storage_has_no_eligible() else StudioStorageAccessibilityCopy::result_announcement(storage_message))
