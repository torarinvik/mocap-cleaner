include "app_state.elisa"

extend Studio:
    private:
        def storage_cleanup_reason(entry: StudioStorageManifest::Entry, row_status: i64) -> i64 can Unsafe.PointerCast:
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if not storage_preferences_valid or not storage_exemptions_valid
            return StudioStorageCleanupPolicy::PROTECT_IDENTITY_CHANGED if row_status == StudioPanels::StorageStatus::CHANGED
            return StudioStorageCleanupPolicy::PROTECT_IDENTITY_UNVERIFIED if row_status != StudioPanels::StorageStatus::PRESENT
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if not StudioStorageManifest::valid(entry)
            if storage_path_is_source(entry.original_path):
                return StudioStorageCleanupPolicy::PROTECT_SOURCE_TAKE
            if storage_path_matches(entry.original_path, session_path) or storage_path_matches(entry.original_path, export_path) or storage_path_matches(entry.original_path, STORAGE_MANIFEST_PATH) or storage_path_matches(entry.original_path, STORAGE_PREFERENCES_PATH) or storage_path_matches(entry.original_path, STORAGE_EXEMPTIONS_PATH) or storage_path_matches(entry.original_path, STORAGE_LOCK_PATH):
                return StudioStorageCleanupPolicy::PROTECT_OPEN_DOCUMENT
            return StudioStorageCleanupPolicy::PROTECT_USER_EXEMPTION if storage_user_exempt(entry)
            for referenced in storage_current_reports |referenced, entry|:
                if storage_identity_matches(referenced, entry):
                    return StudioStorageCleanupPolicy::PROTECT_OPEN_DOCUMENT
            # Recovery ownership/reference metadata is not yet registered;
            # retain recovery points until that evidence exists.
            return StudioStorageCleanupPolicy::PROTECT_SESSION_REFERENCE if entry.kind == StudioStorageCleanupPolicy::RECOVERY
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if entry.original_path.count == 0 or entry.original_path.count >= PATH_CAPACITY
            mutable candidate: u8[4096] = zeroed
            for index in 0..<entry.original_path.count |entry, candidate|:
                candidate[index] <- entry.original_path[index]
            candidate[entry.original_path.count] <- 0
            candidate_path: cstr = (&candidate[0]).cast[cstr] can Unsafe.PointerCast
            path_facts: i64 = FilePanel::path_facts(candidate_path)
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if path_facts < 0
            return StudioStorageCleanupPolicy::PROTECT_SYMLINK if (path_facts & FilePanel::PATH_SYMLINK) != 0
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if (path_facts & FilePanel::PATH_REGULAR) == 0
            age_status: i64 = StudioStorageAgePolicy::timestamp_status(entry.modified_seconds, storage_scan_seconds)
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if age_status != StudioStorageAgePolicy::Status::VALID
            facts: StudioStorageCleanupPolicy::Facts = StudioStorageCleanupPolicy::Facts{
                kind: entry.kind, studio_managed: true, canonical_under_build: true,
                symlink: false, source_take: false, open_document: false,
                session_referenced: false, identity_state: StudioStorageCleanupPolicy::IDENTITY_MATCHES,
                age_days: StudioStorageAgePolicy::completed_age_days(entry.modified_seconds, storage_scan_seconds),
                retention_days: StudioStorageSelectionPolicy::retention_days(storage_retention_preset), size_bytes: entry.size_bytes}
            StudioStorageCleanupPolicy::protection_reason(facts)

        def storage_cleanup_is_selected(entry: StudioStorageManifest::Entry) -> bool:
            for selected in storage_cleanup_selection |selected, entry|:
                return true if storage_identity_matches(selected, entry)
            false

        def storage_entry_eligible(entry: StudioStorageManifest::Entry, reason: i64) -> bool:
            return false if storage_release_uncertain or storage_manifest_state != 1
            return false if not storage_preferences_valid or not storage_exemptions_valid
            return false if storage_message == 1 or storage_message == 2 or storage_message == 5
            StudioStorageSelectionPolicy::row_may_be_selected(entry.state == StudioStorageManifest::REGISTERED and reason == StudioStorageCleanupPolicy::PROTECT_NONE, entry.kind == StudioStorageCleanupPolicy::RECOVERY)

        def storage_row_eligible(index: i64) -> bool:
            return false if index < 0 or index >= storage_visible_entries.count.i64() or index >= storage_visible_reasons.count.i64()
            entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            reasons: darray[i64] = storage_visible_reasons
            storage_entry_eligible(entries[index], reasons[index])

        def storage_inventory_row_eligible(index: i64) -> bool:
            return false if index < 0 or index >= storage_inventory_entries.count.i64() or index >= storage_inventory_reasons.count.i64()
            entries: darray[StudioStorageManifest::Entry] = storage_inventory_entries
            reasons: darray[i64] = storage_inventory_reasons
            storage_entry_eligible(entries[index], reasons[index])

        def set_storage_cleanup_selection(requested: darray[StudioStorageManifest::Entry]&) -> void:
            mutable kept: darray[StudioStorageManifest::Entry] = []
            mutable total: i64 = 0
            entries: darray[StudioStorageManifest::Entry] = storage_inventory_entries
            for selected in requested |selected, entries, kept, total|:
                mutable found: bool = false
                for index in 0..<entries.count |index, entries, selected, found|:
                    found <- true if storage_identity_matches(selected, entries[index]) and storage_inventory_row_eligible(index.i64())
                if found and StudioStorageSelectionPolicy::can_add_selected(entries.count.i64(), kept.count.i64(), total, selected.size_bytes):
                    total <- StudioStorageSelectionPolicy::next_selected_bytes(total, selected.size_bytes)
                    kept.push(selected)
            storage_selection_removed <- requested.count.i64() - kept.count.i64()
            storage_cleanup_selection <- kept
            storage_selection_bytes <- total

        def toggle_storage_cleanup_row(index: i64) -> void:
            return if storage_batch_state == StudioStorageBatchPolicy::STATE_RUNNING
            return if index < 0 or index >= storage_visible_entries.count.i64()
            entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            entry: StudioStorageManifest::Entry = entries[index]
            already_selected: bool = storage_cleanup_is_selected(entry)
            if not StudioStorageSelectionPolicy::may_toggle(storage_inventory_entries.count.i64(), index, storage_row_eligible(index), entry.kind == StudioStorageCleanupPolicy::RECOVERY, already_selected, storage_cleanup_selection.count.i64()):
                return
            mutable requested: darray[StudioStorageManifest::Entry] = []
            for selected in storage_cleanup_selection |selected, entry, requested|:
                requested.push(selected) if not storage_identity_matches(selected, entry)
            requested.push(entry) if not already_selected
            set_storage_cleanup_selection(requested)
            storage_restore_review <- false
            storage_move_review <- false
            touch()

        def select_eligible_storage_rows() -> void:
            mutable requested: darray[StudioStorageManifest::Entry] = []
            entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            for index in 0..<entries.count |index, entries, requested|:
                requested.push(entries[index]) if storage_row_eligible(index.i64())
            set_storage_cleanup_selection(requested)
            storage_restore_review <- false
            storage_move_review <- false
            touch()

        # The inventory view names only records below verified build/. Each
        # refresh checks live filesystem identity and reconciles interrupted
        # Trash moves before displaying an entry as verified.
