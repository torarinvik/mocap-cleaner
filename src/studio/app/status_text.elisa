# Retained feedback must not borrow StudioText's rotating per-frame slots.
include "../status_text_extent_policy.elisa"
include "../../../../elisa-ui/src/core/ui_text.elisa"

module StudioStatusText:
    private:
        const CAPACITY: usize = 128
        global mutable bytes: u8[CAPACITY] = zeroed
    public:
        # The UI thread owns this fixed snapshot. Its view remains readable
        # until the next explicit capture; rendering does not mutate it.
        def capture(text: sview) -> sview can[Unsafe.PointerCast, Global{Read, Write}]:
            return "Status message unavailable." if not StudioStatusTextExtentPolicy::admitted(text.len, text.data != null)
            can Global{Read, Write}:
                for index in 0..<text.len.usize() |index, text|:
                    bytes[index] <- text.data[index]
                return UiText::fixed_bytes_view_range(bytes, 0, text.len.usize())
