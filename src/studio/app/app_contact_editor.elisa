include "app_state.elisa"

extend Studio:
    private:
        def contact_down(x: f32, y: f32) -> bool:
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            row: i64 = StudioPanels::contact_row(tb, y)
            return false if row < 0
            if clip is c:
                st: StudioPanels::Box = StudioPanels::strip(tb)
                mutable fl: darray[bool] = c.left_contact
                fl <- c.right_contact if row == StackState::RIGHT
                fl <- c.left_hand_contact if row == StackState::LEFT_HAND
                fl <- c.right_hand_contact if row == StackState::RIGHT_HAND
                foot_press <- FootState::press(fl, row, (x - st.x).i64(), st.w.i64())
                return true
            false

        def contact_up(x: f32) -> void:
            p: FootState::Press = foot_press
            foot_press <- FootState::idle()
            delta_x: i64 = (x - down_x).i64()
            if not StudioContactEditor::is_drag(delta_x):
                contact_selected_side <- p.side
                contact_selected_frame <- p.frame
                scrub_to(p.frame)
                selected: StackState::Stack = current_stack()
                authored: bool = StackState::edit_index_at(selected, p.side, p.frame) >= 0
                status <- "interval selected; First/Last: click, type a 1-based frame, Enter; Shift+Arrows nudge" if authored else "contact frame selected; choose Plant/Lift, Reset, Delete or Merge as available"
                nudged_row <- -1
                status_file <- null
                touch()
                return
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            if p.part != StudioFoot::FIRST and p.part != StudioFoot::LAST:
                contact_selected_side <- p.side
                contact_selected_frame <- p.frame
                scrub_to(p.frame)
                status <- "select a frame first or drag a run endpoint"
                touch()
                return
            mutable s: StackState::Stack = current_stack()
            if FootState::release(&s, &p, StudioPanels::timeline_frame(tb, x, frames()), frames()):
                commit(s, true)
                status <- "contact endpoint moved"
                nudged_row <- -1
                status_file <- null
            contact_selected_side <- p.side
            contact_selected_frame <- StudioPanels::timeline_frame(tb, x, frames())
            touch()

        # Shift+Arrow translates the selected authored interval. Shift+Up/Down
        # changes its last frame, while Shift+[/] changes its first frame.
        # All edits pass through the fixed-point contact policy and history.
        def contact_nudge(target: i64, delta: i64) -> void:
            if clip is c:
                return if not StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames)
                mutable s: StackState::Stack = current_stack()
                index: i64 = StackState::edit_index_at(s,
                    contact_selected_side, contact_selected_frame)
                if index < 0:
                    status <- "select an authored contact interval first"
                    touch()
                    return
                original: StackState::FootEdit = s.edits[index]
                plan: StudioContactEditor::NudgePlan =
                    StudioContactEditor::nudge_plan(original.first, original.last,
                        c.frames, target, delta)
                if not plan.valid:
                    status <- "contact interval cannot move past its boundary"
                    touch()
                    return
                s.edits[index] <- StackState::FootEdit{side: original.side,
                    first: plan.first, last: plan.last, planted: original.planted}
                commit(s, true)
                if target == StudioContactEditor::NUDGE_INTERVAL:
                    contact_selected_frame <- contact_selected_frame + delta
                elif contact_selected_frame < plan.first:
                    contact_selected_frame <- plan.first
                elif contact_selected_frame > plan.last:
                    contact_selected_frame <- plan.last
                StudioText::begin()
                StudioText::put("Moved " if target == StudioContactEditor::NUDGE_INTERVAL else "Adjusted ")
                StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                StudioText::put(" interval to frames ")
                StudioText::put_i(plan.first + 1)
                StudioText::put("–")
                StudioText::put_i(plan.last + 1)
                status <- StudioText::view()
                nudged_row <- -1
                status_file <- null
                touch()

        def contact_draft_value() -> i64:
            return -1 if typed_len <= 0
            mutable value: i64 = 0
            for i in 0..<typed_len.usize() |i, value|:
                value <- value * 10 + typed[i].i64() - 48
            value

        def contact_begin_frame_draft(target: i64) -> void:
            if clip is c:
                return if target != StudioContactEditor::NUDGE_FIRST and target != StudioContactEditor::NUDGE_LAST
                if not StudioContactEditor::selection_valid(contact_selected_side, contact_selected_frame, c.frames):
                    status <- "select a contact row and frame first"
                    touch()
                    return
                s: StackState::Stack = current_stack()
                if StackState::edit_index_at(s, contact_selected_side, contact_selected_frame) < 0:
                    status <- "select a frame inside an authored contact interval first"
                    touch()
                    return
                contact_draft_target <- target
                contact_draft_side <- contact_selected_side
                contact_draft_frame <- contact_selected_frame
                typing <- true
                typed_len <- 0
                status <- "type a 1-based frame; Enter applies, Escape cancels"
                touch()
            else:
                status <- "load a take and select an authored contact interval first"
                touch()

        def contact_cancel_frame_draft() -> void:
            contact_draft_target <- -1
            contact_draft_side <- StudioContactEditor::NO_SIDE
            contact_draft_frame <- -1
            typed_len <- 0
            typing <- false
            status <- "contact frame edit cancelled"
            touch()

        def contact_commit_frame_draft() -> void:
            return if contact_draft_target < 0
            if clip is c:
                if contact_selected_side != contact_draft_side or contact_selected_frame != contact_draft_frame:
                    contact_cancel_frame_draft()
                    status <- "selection changed; contact frame edit cancelled"
                    touch()
                    return
                requested: i64 = contact_draft_value()
                if requested < 1:
                    status <- "enter a frame number from 1 to the clip length"
                    touch()
                    return
                mutable s: StackState::Stack = current_stack()
                index: i64 = StackState::edit_index_at(s, contact_draft_side, contact_draft_frame)
                if index < 0:
                    contact_cancel_frame_draft()
                    status <- "authored contact interval no longer exists"
                    touch()
                    return
                original: StackState::FootEdit = s.edits[index]
                frame_target: i64 = StudioContactFramePolicy::FIRST if contact_draft_target == StudioContactEditor::NUDGE_FIRST else StudioContactFramePolicy::LAST
                plan: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(
                    original.first, original.last, c.frames, frame_target, requested)
                if not plan.valid:
                    status <- "frame is outside the clip or would invert the contact interval"
                    touch()
                    return
                s.edits[index] <- StackState::FootEdit{side: original.side,
                    first: plan.first, last: plan.last, planted: original.planted}
                edit_side: i64 = contact_draft_side
                contact_draft_target <- -1
                contact_draft_side <- StudioContactEditor::NO_SIDE
                contact_draft_frame <- -1
                typing <- false
                typed_len <- 0
                if contact_selected_frame < plan.first:
                    contact_selected_frame <- plan.first
                elif contact_selected_frame > plan.last:
                    contact_selected_frame <- plan.last
                commit(s, true)
                StudioText::begin()
                StudioText::put("Set ")
                StudioText::put(StudioPanels::contact_side_label(edit_side))
                StudioText::put(" interval to frames ")
                StudioText::put_i(plan.first + 1)
                StudioText::put("–")
                StudioText::put_i(plan.last + 1)
                status <- StudioText::view()
                nudged_row <- -1
                status_file <- null
                touch()

        # Apply an explicit Plant/Lift action to the selected output frame.
        def contact_apply(action: i64) -> void:
            return if not StudioContactEditor::action_valid(action)
            if clip is c:
                if not StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames):
                    status <- "select a contact row and frame first"
                    touch()
                    return
                mutable s: StackState::Stack = current_stack()
                if action == StudioContactEditor::DELETE:
                    index: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame)
                    if index >= 0:
                        removed: StackState::FootEdit = s.edits[index]
                        if StackState::delete_edit_at(&s, contact_selected_side, contact_selected_frame):
                            commit(s, true)
                            StudioText::begin()
                            StudioText::put("Deleted ")
                            StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                            StudioText::put(" interval frames ")
                            StudioText::put_i(removed.first + 1)
                            StudioText::put(" to ")
                            StudioText::put_i(removed.last + 1)
                            status <- StudioText::view()
                        else:
                            status <- "could not delete contact interval"
                    else:
                        status <- "no authored contact interval at this frame"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if action == StudioContactEditor::MERGE:
                    selected: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame)
                    neighbor: i64 = StackState::merge_neighbor_index(s, selected)
                    if neighbor >= 0:
                        keep: i64 = selected if selected < neighbor else neighbor
                        remove: i64 = neighbor if selected < neighbor else selected
                        a: StackState::FootEdit = s.edits[keep]
                        b: StackState::FootEdit = s.edits[remove]
                        first: i64 = a.first if a.first < b.first else b.first
                        last: i64 = a.last if a.last > b.last else b.last
                        if StackState::merge_edit_at(&s, contact_selected_side, contact_selected_frame):
                            commit(s, true)
                            StudioText::begin()
                            StudioText::put("Merged ")
                            StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                            StudioText::put(" intervals frames ")
                            StudioText::put_i(first + 1)
                            StudioText::put(" to ")
                            StudioText::put_i(last + 1)
                            status <- StudioText::view()
                        else:
                            status <- "could not merge contact intervals"
                    else:
                        status <- "no adjacent same-state contact interval to merge"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if action == StudioContactEditor::SPLIT:
                    selected: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame)
                    if selected >= 0:
                        original: StackState::FootEdit = s.edits[selected]
                        if StackState::split_edit_at(&s, contact_selected_side, contact_selected_frame):
                            commit(s, true)
                            StudioText::begin()
                            StudioText::put("Split ")
                            StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                            StudioText::put(" interval before frame ")
                            StudioText::put_i(contact_selected_frame + 1)
                            StudioText::put("; ranges ")
                            StudioText::put_i(original.first + 1)
                            StudioText::put("–")
                            StudioText::put_i(contact_selected_frame)
                            StudioText::put(" and ")
                            StudioText::put_i(contact_selected_frame + 1)
                            StudioText::put("–")
                            StudioText::put_i(original.last + 1)
                            status <- StudioText::view()
                        else:
                            status <- "could not split contact interval"
                    else:
                        status <- "no authored contact interval at this frame"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if action == StudioContactEditor::RESET:
                    if StackState::reset_edit_at(&s, contact_selected_side, contact_selected_frame):
                        commit(s, true)
                        StudioText::begin()
                        StudioText::put("Restored ")
                        StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                        StudioText::put(" frame ")
                        StudioText::put_i(contact_selected_frame + 1)
                        StudioText::put(" to automatic detection")
                        status <- StudioText::view()
                    elif StackState::has_edit_at(s, contact_selected_side, contact_selected_frame):
                        status <- "cannot reset this frame: contact edit capacity would be exceeded"
                    else:
                        status <- "this frame already follows automatic detection"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if StackState::add_edit(&s, contact_selected_side,
                    contact_selected_frame, contact_selected_frame,
                    StudioContactEditor::plants(action)):
                    commit(s, true)
                    StudioText::begin()
                    StudioText::put("Planted " if action == StudioContactEditor::PLANT else "Lifted ")
                    StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                    StudioText::put(" at frame ")
                    StudioText::put_i(contact_selected_frame + 1)
                    status <- StudioText::view()
                else:
                    status <- "contact edit limit reached; undo an edit before adding another"
                nudged_row <- -1
                status_file <- null
                touch()

