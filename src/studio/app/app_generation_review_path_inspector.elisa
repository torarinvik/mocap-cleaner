# Bounded, exact path paging for generated artifact and recovery review.
include "panels_geometry.elisa"
include "../state/generation_review_path_policy.elisa"

module StudioGenerationReviewPathInspector:
    public:
        def line(path: darray[u8]&, page: i64, row: i64) -> sview can Unsafe.PointerCast:
            requires page >= 0 and page < StudioGenerationReviewPathPolicy::page_count(path)
            requires row >= 0 and row < StudioGenerationReviewPathPolicy::visible_lines(path, page)
            return "" if row < 0 or row >= StudioGenerationReviewPathPolicy::visible_lines(path, page)
            start: usize = StudioGenerationReviewPathPolicy::line_start(path, (page * StudioGenerationReviewPathPolicy::Limit::LINES_PER_PAGE + row).usize())
            end: usize = StudioGenerationReviewPathPolicy::line_end(path, start)
            StudioText::begin()
            for index in start..<end |index, path|:
                StudioText::byte(path[index])
            StudioText::view()

        def button_box(w: f32, h: f32, action: i64) -> StudioPanels::Box:
            d: StudioPanels::Box = StudioPanels::box((w - 820.0) / 2.0, (h - 500.0) / 2.0, 820.0, 500.0)
            StudioPanels::box(d.x + 24.0 + action.f32() * 134.0, d.y + 420.0, 120.0, 38.0)

        def inspect_button_box(w: f32, h: f32) -> StudioPanels::Box:
            d: StudioPanels::Box = StudioPanels::box((w - 820.0) / 2.0, (h - 660.0) / 2.0, 820.0, 660.0)
            StudioPanels::box(d.x + d.w - 174.0, d.y + 14.0, 150.0, 32.0)

        def button_hit(w: f32, h: f32, x: f32, y: f32) -> i64:
            for action in 0..<3 |w, h, x, y, action|:
                return action if StudioPanels::inside(button_box(w, h, action), x, y)
            -1

    public:
        def drawing_panel(w: f32, h: f32, opened: bool, path: darray[u8]&,
                          page: i64, focus: i64) -> void can[Unsafe.PointerCast, Memory.Allocate]:
            return if not opened
            pages: i64 = StudioGenerationReviewPathPolicy::page_count(path)
            visible: i64 = StudioGenerationReviewPathPolicy::visible_lines(path, page)
            d: StudioPanels::Box = StudioPanels::box((w - 820.0) / 2.0, (h - 500.0) / 2.0, 820.0, 500.0)
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 19.0, "Build artifact path", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 51.0, 12.0, "Recorded build root plus artifact path; exact bytes continue across pages without omission.", StudioDraw::muted())
            for row in 0..<visible |row, d, page, path|:
                line_box: StudioPanels::Box = StudioPanels::box(d.x + 24.0, d.y + 76.0 + row.f32() * 49.0, d.w - 48.0, 38.0)
                StudioDraw::rect(line_box.x, line_box.y, line_box.w, line_box.h, StudioDraw::panel())
                StudioDraw::text(line_box.x + 12.0, line_box.y + 11.0, 12.0, line(path, page, row), StudioDraw::ink())
            StudioText::begin()
            StudioText::put("Page ")
            StudioText::put_i(page + 1)
            StudioText::put(" of ")
            StudioText::put_i(pages)
            StudioDraw::text(d.x + 24.0, d.y + 338.0, 12.0, StudioText::view(), StudioDraw::muted())
            for action in 0..<3 |action, w, h, focus, page, pages|:
                b: StudioPanels::Box = button_box(w, h, action)
                enabled: bool = action == 2 or (action == 0 and page > 0) or (action == 1 and page + 1 < pages)
                label: sview = "Previous" if action == 0 else "Next" if action == 1 else "Done"
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if focus == action else StudioDraw::panel())
                StudioDraw::text(b.x + 13.0, b.y + 11.0, 12.0, label, StudioDraw::ink() if enabled else StudioDraw::muted())

extend Studio:
    private:
        global mutable generation_path_open: bool = false
        global mutable generation_path_page: i64 = 0
        global mutable generation_path_focus: i64 = 2
        global mutable generation_path_bytes: darray[u8] = []

        def generation_path_copy(path: darray[u8]&) -> darray[u8] can Memory.Allocate:
            mutable copied: darray[u8] = []
            for byte in path |path, copied|:
                copied.push(byte)
            copied

        def generation_path_open_with(path: darray[u8]&) -> void can Memory.Allocate:
            return if not StudioGenerationReviewPathPolicy::path_valid(path)
            generation_path_bytes <- generation_path_copy(path)
            generation_path_page <- 0
            generation_path_focus <- 2
            generation_path_open <- true
            touch()

        def generation_path_close() -> void:
            generation_path_open <- false
            generation_path_page <- 0
            generation_path_bytes <- []
            touch()

        def generation_path_action(action: i64) -> void:
            pages: i64 = StudioGenerationReviewPathPolicy::page_count(generation_path_bytes)
            if action == 0:
                generation_path_page <- generation_path_page - 1 if generation_path_page > 0 else 0
            elif action == 1:
                generation_path_page <- generation_path_page + 1 if generation_path_page + 1 < pages else generation_path_page
            elif action == 2:
                generation_path_close()
                return
            generation_path_focus <- action
            touch()

        def generation_path_key(code: i64) -> bool:
            return false if not generation_path_open
            if code == UiCore::Key.Escape:
                generation_path_close()
            elif code == UiCore::Key.Left:
                generation_path_action(0)
            elif code == UiCore::Key.Right:
                generation_path_action(1)
            elif code == UiCore::Key.Tab:
                generation_path_focus <- (generation_path_focus + (2 if StudioShortcuts::shift(modifiers) else 1)) % 3
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                generation_path_action(generation_path_focus)
            true

        def generation_path_pointer(w: f32, h: f32, x: f32, y: f32, button: i32) -> bool:
            return false if not generation_path_open or button != 0
            action: i64 = StudioGenerationReviewPathInspector::button_hit(w, h, x, y)
            return true if action < 0
            generation_path_action(action)
            true

        def draw_generation_path_inspector(w: f32, h: f32) -> void can[Unsafe.PointerCast, Memory.Allocate]:
            StudioGenerationReviewPathInspector::drawing_panel(w, h, generation_path_open, generation_path_bytes, generation_path_page, generation_path_focus)
