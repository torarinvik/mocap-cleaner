# Shared visible and accessible copy for the filtered Storage inventory.
include "../storage_list_filter_policy.elisa"
include "text.elisa"

module StudioStorageFilterCopy:
    public:
        def mode_name(mode: i64) -> sview:
            return "All records" if mode == StudioStorageListFilterPolicy::Filter::ALL
            return "Eligible" if mode == StudioStorageListFilterPolicy::Filter::ELIGIBLE
            return "Protected" if mode == StudioStorageListFilterPolicy::Filter::PROTECTED
            return "Recovery" if mode == StudioStorageListFilterPolicy::Filter::RECOVERY
            return "Temporary exports" if mode == StudioStorageListFilterPolicy::Filter::TEMP_EXPORT
            return "Quality reports" if mode == StudioStorageListFilterPolicy::Filter::REPORT
            return "In Trash" if mode == StudioStorageListFilterPolicy::Filter::IN_TRASH
            "Unknown filter"

        # Caller owns begin/view so this can also be appended to a longer AX
        # announcement without invalidating an earlier view of the buffer.
        def append_selection(selected: i64, hidden: i64, bytes: i64) -> void:
            StudioText::put("Selected: ")
            StudioText::put_i(selected)
            StudioText::put(" (")
            if hidden >= 0:
                StudioText::put_i(hidden)
                StudioText::put(" hidden)")
            else:
                StudioText::put("hidden count unknown)")
            StudioText::put("; ")
            StudioText::put_i(bytes)
            StudioText::put(" bytes")

        def append_empty(complete: i64, mode: i64) -> void:
            if complete == 0:
                StudioText::put("No Studio-managed files are registered yet.")
            else:
                StudioText::put("No records match ")
                StudioText::put(mode_name(mode))
                StudioText::put(". Change the filter to see other records.")
