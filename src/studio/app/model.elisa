# The studio's loaded clip: the source document, the source cleaned by the
# current operation stack (the same GlbTracks::clean_animation the CLI exports
# with), the rig order, and everything the panels draw that is costly to
# recompute every frame (joint tracks, contacts, problem counts, peaks).
#
# A Clip is affine and built in one piece by `build`; the app keeps it in an
# optional module global and rebuilds it whenever the stack changes (live
# preview). Stage1 keeps darrays alive only when the owning struct is moved
# into the global, so nothing here is mutated in place.
include "../state/clip_state.elisa"
include "../state/suggestion_tracks.elisa"
include "../state/foot_state.elisa"
include "../state/history_state.elisa"
include "../state/timeline_state.elisa"
include "../state/retime_state.elisa"
include "../view.elisa"
include "../../ops/presets.elisa"
include "../../ops/rig_cache.elisa"
include "../../physics/rig_physics.elisa"
include "../overlay_policy.elisa"
include "../source_fingerprint.elisa"
include "../sample_clock.elisa"
include "../state/perf_state.elisa"
include "../../ops/retime_apply.elisa"

extern clock() -> i64

module StudioModel:
    public:
        affine struct Clip:
            source: mutable GlbDocument::Document
            source_fingerprint: StudioSourceFingerprint::Fingerprint
            cleaned: mutable GlbDocument::Document
            anim: usize
            frames: i64
            # Frames per second, from the key times (StudioClip::rate).
            rate: i64
            # Validated actual output timestamps; rate remains an estimate.
            sample_clock: StudioSampleClock::Clock
            nodes: mutable darray[i64]
            slot: mutable darray[i64]
            # Spike count and strongest acceleration per frame (cleaned and
            # source), for the timeline's markers.
            problems: mutable darray[i64]
            source_problems: mutable darray[i64]
            peaks: mutable darray[i64]
            # World tracks of the cleaned clip: hands, then feet.
            left_hand: mutable darray[Geometry::Vec3]
            right_hand: mutable darray[Geometry::Vec3]
            left_foot: mutable darray[Geometry::Vec3]
            right_foot: mutable darray[Geometry::Vec3]
            left_contact: mutable darray[bool]
            right_contact: mutable darray[bool]
            left_hand_contact: mutable darray[bool]
            right_hand_contact: mutable darray[bool]
            ground: mutable f32
            # Balance (Phase 4) of the cleaned clip, per frame: the centre of
            # mass, StudioOverlay state, and Support::CORNERS support points
            # (ankle and toe of each planted foot; NaN when absent).
            com: mutable darray[Geometry::Vec3]
            balance: mutable darray[i64]
            support: mutable darray[Geometry::Vec3]
            balance_ground: f32
            impossible_frames: i64
            source_impossible_frames: i64
            threshold: i64
            changed: i64
            spikes_before: i64
            spikes_after: i64
            # Joint tracks interleaved (frame * 4 + joint), kept so the next
            # edit recomputes only its frame window (StudioPerf).
            points: mutable darray[Geometry::Vec3]
            hinge_angles: mutable darray[i64]
            hinge_angles_valid: bool
            # Stage costs of the build that made this clip, in microseconds
            # (process CPU clock): clean (evaluate), tracks + detectors +
            # balance (detect); poses evaluated and ops rerun.
            evaluate_us: i64
            detect_us: i64
            poses: i64
            ops_run: i64
            # Foot cleanup (K): planted-foot slide and sink (micro-units)
            # before and after the fix, per-frame planted slide (worse foot)
            # for the timeline markers, and the worst frame and its foot.
            feet: bool
            hands: bool
            slide_before: i64
            slide_after: i64
            sink_before: i64
            sink_after: i64
            hand_slide_before: i64
            hand_slide_after: i64
            foot_slide: mutable darray[i64]
            worst_frame: i64
            worst_slide: i64
            worst_side: i64
            # Retime (applied last): source time (milli-frames) of every
            # output frame, the source's frame count, and the CLI's report.
            times: mutable darray[i64]
            source_frames: i64
            retimed: bool

        def open(path: cstr) -> GlbDocument::Document?:
            d: GlbDocument::Document = catch GlbDocument::load(path):
                value: value
                error failure: return null
            return move d

        def total(v: darray[i64]&) -> i64:
            mutable sum: i64 = 0
            for x in v |x, sum|:
                sum <- sum + x
            return sum

        def lowest(a: darray[Geometry::Vec3]&, b: darray[Geometry::Vec3]&) -> f32:
            mutable low: f32 = 1000000.0
            for p in a |p, low|:
                low <- p.y if p.y < low else low
            for p in b |p, low|:
                low <- p.y if p.y < low else low
            return 0.0 if low > 999999.0 else low

        # Index of the animation named `name` (C string), or -1.
        def find(doc: GlbDocument::Document&, name: cstr) -> i64:
            for a in 0..<GlbDocument::animation_count(doc) |a, doc, name|:
                text: mutable darray[u8] = []
                n: usize = GlbDocument::animation_name(doc, a, &text)
                mutable same: bool = true
                for i in 0..<n |i, text, name, same|:
                    same <- false if name[i] == 0 or name[i] != text[i]
                return a.i64() if same and name[n] == 0
            return -1

        # What survives stack edits: the source loaded once, its problem
        # markers, rig order and the per-channel op caches (Phase 6).
        affine struct Memo:
            pristine: mutable GlbDocument::Document
            source_fingerprint: StudioSourceFingerprint::Fingerprint
            anim: usize
            frames: i64
            nodes: mutable darray[i64]
            slot: mutable darray[i64]
            source_problems: mutable darray[i64]
            bank: mutable darray[Ops::Cache]
            rig_cache: mutable RigCache::Cache
            shortest: i64
            threshold: i64
            source_impossible_frames: i64

        struct Balanced:
            com: mutable darray[Geometry::Vec3]
            states: mutable darray[i64]
            support: mutable darray[Geometry::Vec3]
            ground: mutable f32
            impossible: mutable i64

        # Hash the original bytes already held by GlbDocument. A failure to
        # maintain the bounded accumulator refuses the take instead of saving
        # an identity that could accidentally match another source.
        def fingerprint(doc: GlbDocument::Document&) -> StudioSourceFingerprint::Fingerprint?:
            mutable first: i64 = 1
            mutable second: i64 = 7
            for at in 0..<GlbDocument::byte_count(doc) |doc, first, second|:
                byte: i64 = GlbDocument::byte_at(doc, at).i64()
                if first < 0 or first >= StudioSourceFingerprint::Residue::FIRST_MODULUS:
                    return null
                if second < 0 or second >= StudioSourceFingerprint::Residue::SECOND_MODULUS:
                    return null
                if byte < 0 or byte > 255:
                    return null
                first <- StudioSourceFingerprint::first_step(first, byte)
                second <- StudioSourceFingerprint::second_step(second, byte)
            StudioSourceFingerprint::Fingerprint{first: first, second: second}

        # Load `path` and find `anim_name` (the first animation when absent).
        # Null when the file or every animation is missing.
        def load(path: cstr, anim_name: cstr) -> Memo?:
            a: GlbDocument::Document? = open(path)
            if a is src:
                found: i64 = find(src, anim_name)
                found_any: i64 = found if found >= 0 else (0 if GlbDocument::animation_count(src) > 0 else -1)
                return null if found_any < 0
                anim: usize = found_any.usize()
                if fingerprint(&src) is source_fingerprint:
                    threshold: i64 = Presets::spike_threshold(Presets::Preset.Boxing)
                    frames: i64 = StudioClip::frame_count(src, anim)
                    nodes: darray[i64] = StudioClip::order(src)
                    slot: darray[i64] = StudioClip::slots(src, nodes)
                    sp: darray[i64] = StudioClip::problems(src, anim, frames, threshold)
                    shortest: i64 = StudioPerf::shortest_keys(src, anim)
                    mutable source_balance: Balanced = Balanced{com: [], states: [], support: [], ground: 0.0, impossible: 0}
                    balance_of(&src, anim, frames, &source_balance)
                    m: Memo = Memo{pristine: src, source_fingerprint: source_fingerprint, anim: anim, frames: frames, nodes: nodes, slot: slot, source_problems: sp, bank: [], rig_cache: RigCache::new_cache(), shortest: shortest, threshold: threshold, source_impossible_frames: source_balance.impossible}
                    return move m
            return null

        # Load `path`, find `anim_name`, clean a copy with `s` and sample
        # everything the studio draws (no reuse). Null when missing.
        def build(path: cstr, anim_name: cstr, s: StackState::Stack&) -> Clip?:
            loaded: Memo? = load(path, anim_name)
            if loaded is held:
                mutable m: Memo = held
                none_p: darray[Geometry::Vec3] = []
                none_i: darray[i64] = []
                return build_with(&m, s, none_p, none_i, none_i, StudioPerf::full(m.frames), 0)
            return null

        # Clean a copy of the memo's source with `s` (through the op caches)
        # and sample it. Tracks and detectors are recomputed only in `w`
        # (detectors in `w` widened by StudioPerf::DETECT_EDGE); every other
        # frame copies the previous clip's arrays (empty: recompute all).
        # Contacts and balance are non-local and always recomputed. Equal to
        # `build` for the same stack when `w` covers what changed.
        def build_with(m: mutable Memo&, s: StackState::Stack&, prev_points: darray[Geometry::Vec3]&, prev_problems: darray[i64]&, prev_peaks: darray[i64]&, w: StudioPerf::Window, source_revision: i64) -> Clip?:
            anim: usize = m.anim
            source_frames: i64 = m.frames
            threshold: i64 = m.threshold
            t0: i64 = clock()
            before_runs: i64 = GlbTracks::bank_evaluations(&m.bank)
            mutable cleaned: GlbDocument::Document = GlbDocument::copy(&m.pristine)
            ops: darray[Ops::Operation] = StackState::operations(s)
            result: (tracks: i64, changed: i64, before: i64, after: i64) = GlbTracks::clean_animation_cached(&cleaned, anim, ops, threshold, &m.bank)
            for i in 0..<s.fix_count |i, s, cleaned, anim|:
                fix: Corrections::Correction = s.fixes[i]
                _ = Corrections::apply(&cleaned, anim, &fix)
            edits: darray[RigOps::RigOp] = edit_ops(s)
            mutable foot: RigOps::Summary = RigOps::empty_summary()
            rops: darray[RigOps::RigOp] = cleanup_ops(s)
            mutable rig_clip: Rig::Clip = Rig::load(cleaned, anim)
            if rops.count > 0:
                foot <- RigCache::run_clip_cached(&rig_clip, rops, threshold, source_revision, &m.rig_cache)
                foot.changed <- Rig::store(&cleaned, &rig_clip)
            # Retime last: contacts and pins baked into the keys move with it.
            rt_ops: darray[RigOps::RigOp] = retime_ops(s)
            mutable rt: RetimeApply::Report = RetimeApply::empty_report()
            if rt_ops.count > 0:
                retimed_doc: GlbDocument::Document = RetimeApply::apply(&cleaned, anim, &rt_ops, &rt)
                cleaned <- move retimed_doc
            mutable ranges: darray[RetimeApply::Range] = []
            RetimeApply::ranges_of(&rt_ops, source_frames, &ranges) if rt.applied
            mutable times: darray[i64] = []
            RetimeApply::source_times(source_frames, &ranges, &times)
            frames: i64 = times.count.i64()
            win: StudioPerf::Window = StudioPerf::full(frames) if rt.applied else w
            t1: i64 = clock()
            ops_run: i64 = GlbTracks::bank_evaluations(&m.bank) - before_runs
            nodes: darray[i64] = copy_ints(&m.nodes)
            slot: darray[i64] = copy_ints(&m.slot)
            rig: PoseOverride::Rig = StudioClip::rig(cleaned, nodes, slot)
            bones: darray[i64] = [StudioClip::slot_of_role(cleaned, slot, Roles::Joint.LeftHand.i64()), StudioClip::slot_of_role(cleaned, slot, Roles::Joint.RightHand.i64()), StudioClip::slot_of_role(cleaned, slot, Roles::Joint.LeftFoot.i64()), StudioClip::slot_of_role(cleaned, slot, Roles::Joint.RightFoot.i64())]
            tracks: StudioPerf::Tracks = StudioPerf::joint_tracks(rig, cleaned, anim, frames, nodes, slot, bones, prev_points, win)
            hinge_tracks: StudioSuggestionTracks::HingeAngles = StudioSuggestionTracks::hinges(cleaned, anim, frames, nodes, slot)
            lh: darray[Geometry::Vec3] = StudioPerf::joint(&tracks, 0, frames)
            rh: darray[Geometry::Vec3] = StudioPerf::joint(&tracks, 1, frames)
            lf: darray[Geometry::Vec3] = StudioPerf::joint(&tracks, 2, frames)
            rf: darray[Geometry::Vec3] = StudioPerf::joint(&tracks, 3, frames)
            fps: i64 = StudioClip::rate(&m.pristine, anim)
            sample_clock: StudioSampleClock::Clock = StudioSampleClock::capture(cleaned, anim, frames)
            lc: darray[bool] = contacts_of(&rig_clip, 0, edits, source_frames, lf, fps, times)
            rc: darray[bool] = contacts_of(&rig_clip, 1, edits, source_frames, rf, fps, times)
            lhc: darray[bool] = hand_contacts_of(&rig_clip, 0, edits, source_frames, times)
            rhc: darray[bool] = hand_contacts_of(&rig_clip, 1, edits, source_frames, times)
            fs: darray[i64] = foot_slide(lf, rf, lc, rc)
            worst: (frame: i64, value: i64) = worst_of(fs)
            worst_side: i64 = side_at(lf, rf, lc, rc, worst.frame)
            edge: StudioPerf::Window = StudioPerf::margin(win, StudioPerf::DETECT_EDGE, frames)
            problems: darray[i64] = StudioPerf::problems(cleaned, anim, frames, threshold, prev_problems, edge)
            source_problems: darray[i64] = remap_ints(&m.source_problems, &times)
            peaks: darray[i64] = StudioPerf::peaks(cleaned, anim, frames, prev_peaks, edge)
            ground: f32 = lowest(lf, rf)
            before: i64 = total(source_problems)
            after: i64 = total(problems)
            mutable bal: Balanced = Balanced{com: [], states: [], support: [], ground: 0.0, impossible: 0}
            balance_of(&cleaned, anim, frames, &bal)
            t2: i64 = clock()
            src: GlbDocument::Document = GlbDocument::copy(&m.pristine)
            c: Clip = Clip{source: src, source_fingerprint: m.source_fingerprint, cleaned: cleaned, anim: anim, frames: frames, rate: fps, sample_clock: sample_clock, nodes: nodes, slot: slot, problems: problems, source_problems: source_problems, peaks: peaks, left_hand: lh, right_hand: rh, left_foot: lf, right_foot: rf, left_contact: lc, right_contact: rc, left_hand_contact: lhc, right_hand_contact: rhc, ground: ground, com: bal.com, balance: bal.states, support: bal.support, balance_ground: bal.ground, impossible_frames: bal.impossible, source_impossible_frames: m.source_impossible_frames, threshold: threshold, changed: result.changed, spikes_before: before, spikes_after: after, points: tracks.points, evaluate_us: t1 - t0, detect_us: t2 - t1, poses: tracks.evaluated, ops_run: ops_run, hinge_angles: move hinge_tracks.values, hinge_angles_valid: hinge_tracks.valid, feet: s.feet, hands: s.hands, slide_before: foot.slide_before, slide_after: foot.slide_after, sink_before: foot.sink_before, sink_after: foot.sink_after, hand_slide_before: foot.hand_before, hand_slide_after: foot.hand_after, foot_slide: fs, worst_frame: worst.frame, worst_slide: worst.value, worst_side: worst_side, times: times, source_frames: source_frames, retimed: rt.applied}
            return move c

        def copy_ints(v: darray[i64]&) -> darray[i64]:
            out: mutable darray[i64] = []
            for x in v |out|:
                out.push(x)
            return out

        # Per output frame, the value at its nearest source frame.
        def remap_ints(v: darray[i64]&, times: darray[i64]&) -> darray[i64]:
            out: mutable darray[i64] = []
            for k in 0..<times.count |k, out, v, times|:
                f: i64 = RetimeApply::source_frame_of(times, k.i64())
                out.push(v[f.usize()] if f >= 0 and f < v.count.i64() else 0)
            return out

        # The stack's enabled retime bands as RigOps.
        def retime_ops(s: StackState::Stack&) -> darray[RigOps::RigOp]:
            mutable out: darray[RigOps::RigOp] = []
            for i in 0..<s.band_count |i, s, out|:
                b: StackState::Band = s.bands[i]
                if b.enabled:
                    out.push(RigOps::retime(b.first, b.last, b.speed, b.blend))
            return out

        # Source frame shown at output frame `frame` (identity unretimed).
        def source_frame(c: Clip&, frame: i64) -> i64:
            return frame if not c.retimed
            return RetimeApply::source_frame_of(c.times, frame)

        # Output frame nearest source frame `frame`.
        def output_frame(c: Clip&, frame: i64) -> i64:
            return frame if not c.retimed
            return RetimeApply::output_frame_of(c.times, frame)

        # The stack's contact edits as RigOps (role per foot).
        def edit_ops(s: StackState::Stack&) -> darray[RigOps::RigOp]:
            mutable out: darray[RigOps::RigOp] = []
            for i in 0..<s.edit_count |i, s, out|:
                e: StackState::FootEdit = s.edits[i]
                mutable role: i64 = Roles::Joint.LeftFoot.i64()
                role <- Roles::Joint.RightFoot.i64() if e.side == StackState::ContactSide.RightFoot.i64()
                role <- Roles::Joint.LeftHand.i64() if e.side == StackState::ContactSide.LeftHand.i64()
                role <- Roles::Joint.RightHand.i64() if e.side == StackState::ContactSide.RightHand.i64()
                out.push(RigOps::contact_edit(role, e.first, e.last, e.planted))
            return out

        # Foot and hand locks share the contact edits but keep their own opt-in
        # switches. RigCache splits before the first lock that reads contacts.
        def cleanup_ops(s: StackState::Stack&) -> darray[RigOps::RigOp]:
            mutable out: darray[RigOps::RigOp] = []
            out.push(RigOps::foot_pivot(StudioFoot::blend(s.blend))) if s.feet
            out.push(RigOps::hand_lock(StudioFoot::blend(s.blend))) if s.hands
            for op in edit_ops(s) |op, out|:
                foot_edit: bool = op.role == Roles::Joint.LeftFoot.i64() or op.role == Roles::Joint.RightFoot.i64()
                hand_edit: bool = op.role == Roles::Joint.LeftHand.i64() or op.role == Roles::Joint.RightHand.i64()
                out.push(op) if (s.feet and foot_edit) or (s.hands and hand_edit)
            return out

        # Contacts of one foot after detector and hand edits, with a joint
        # track fallback for rigs without a recognized leg.
        def remap_contacts(flags: darray[bool]&, times: darray[i64]&) -> darray[bool]:
            mutable out: darray[bool] = []
            for k in 0..<times.count |k, flags, times, out|:
                f: i64 = RetimeApply::source_frame_of(times, k.i64())
                out.push(flags[f.usize()] if f >= 0 and f < flags.count.i64() else false)
            return out

        def contacts_of(rig: Rig::Clip&, side: i64, edits: darray[RigOps::RigOp]&, source_frames: i64, track: darray[Geometry::Vec3]&, fps: i64, times: darray[i64]&) -> darray[bool]:
            flags: darray[bool] = RigOps::foot_contacts(rig, side, edits)
            return remap_contacts(flags, times) if flags.count == source_frames.usize()
            return StudioClip::contacts(track, fps)

        def hand_contacts_of(rig: Rig::Clip&, side: i64, edits: darray[RigOps::RigOp]&, source_frames: i64, times: darray[i64]&) -> darray[bool]:
            mutable flags: darray[bool] = RigOps::hand_contacts(rig, side, edits)
            if flags.count != source_frames.usize():
                flags.clear()
                for k in 0..<source_frames:
                    flags.push(false)
            return remap_contacts(flags, times)

        # Horizontal slide (micro-units) of a planted foot from frame k-1 to k.
        def step_slide(track: darray[Geometry::Vec3]&, flags: darray[bool]&, k: usize) -> i64:
            return 0 if k == 0 or k >= track.count or k >= flags.count or not flags[k] or not flags[k - 1]
            dx: f64 = (track[k].x - track[k - 1].x).f64()
            dz: f64 = (track[k].z - track[k - 1].z).f64()
            return ((dx * dx + dz * dz).sqrt() * 1000000.0).round().i64()

        # Per-frame planted slide of the worse foot.
        def foot_slide(lf: darray[Geometry::Vec3]&, rf: darray[Geometry::Vec3]&, lc: darray[bool]&, rc: darray[bool]&) -> darray[i64]:
            mutable out: darray[i64] = []
            for k in 0..<lf.count |k, lf, rf, lc, rc, out|:
                a: i64 = step_slide(lf, lc, k)
                b: i64 = step_slide(rf, rc, k)
                out.push(StudioFoot::worst_value(a, b))
            return out

        # The frame with the most planted slide (earliest on ties), or 0.
        def worst_of(v: darray[i64]&) -> (frame: i64, value: i64):
            mutable best: i64 = 0
            mutable value: i64 = 0
            for k in 0..<v.count |k, v, best, value|:
                best <- StudioFoot::worst_frame(best, value, k.i64(), v[k])
                value <- StudioFoot::worst_value(value, v[k])
            return (frame: best, value: value)

        # The foot (StackState::ContactSide.LeftFoot.i64()/RIGHT) sliding more at `frame`.
        def side_at(lf: darray[Geometry::Vec3]&, rf: darray[Geometry::Vec3]&, lc: darray[bool]&, rc: darray[bool]&, frame: i64) -> i64:
            return StackState::ContactSide.LeftFoot.i64() if frame < 0
            k: usize = frame.usize()
            return StackState::ContactSide.RightFoot.i64() if step_slide(rf, rc, k) > step_slide(lf, lc, k)
            return StackState::ContactSide.LeftFoot.i64()

        const module Support:
            CORNERS: i64 = 4

        def vec(p: MotionQuat::V) -> Geometry::Vec3:
            Geometry::Vec3{x: p.x.f32(), y: p.y.f32(), z: p.z.f32()}

        # The Phase 4 balance detector (Physics::balance_frames, the same one
        # `--op balance` reports) over the cleaned document, per frame.
        # Always fills `frames` entries (Support::CORNERS per frame for the
        # support), so the overlay can index by frame.
        def balance_of(doc: GlbDocument::Document&, anim: usize, frames: i64, out: mutable Balanced&) -> void:
            nan: f32 = 0.0 / 0.0
            absent: Geometry::Vec3 = Geometry::Vec3{x: nan, y: nan, z: nan}
            rc: Rig::Clip = Rig::load(doc, anim)
            ok: bool = rc.frames == frames
            length: f64 = Physics::leg_length(&rc) if ok else 0.0
            floor: i64 = Physics::floor_of(&rc) if ok else 0
            left: darray[bool] = Physics::foot_flags(&rc, 0, floor, length) if ok else []
            right: darray[bool] = Physics::foot_flags(&rc, 1, floor, length) if ok else []
            coms: darray[MotionQuat::V] = Physics::com_track(&rc) if ok else []
            mutable findings: Physics::Findings = Physics::empty_findings()
            mutable inside: darray[bool] = []
            mutable impossible: darray[bool] = []
            if ok:
                Physics::balance_frames(&rc, &coms, &left, &right, floor, length, &findings, &inside, &impossible)
            out.ground <- Limb::unmicro(floor).f32()
            mutable w: Rig::World = Rig::empty_world()
            for f in 0..<frames |f, out, rc, ok, left, right, coms, inside, impossible, w, absent|:
                k: usize = f.usize()
                have: bool = ok and k < left.count and k < right.count and k < coms.count and k < inside.count and k < impossible.count
                planted_l: bool = have and left[k]
                planted_r: bool = have and right[k]
                gone: bool = have and impossible[k]
                st: i64 = StudioOverlay::state(planted_l or planted_r, have and inside[k], gone)
                out.states.push(st)
                out.impossible <- out.impossible + 1 if gone else out.impossible
                out.com.push(vec(coms[k]) if have else absent)
                if planted_l or planted_r:
                    Rig::solve_world(&rc, f, &w)
                for side in 0..<2 |side, out, rc, w, planted_l, planted_r, absent|:
                    on: bool = planted_l if side == 0 else planted_r
                    for role in [Roles::Joint.LeftFoot.i64() + side.i64() * 4, Roles::Joint.LeftToe.i64() + side.i64() * 4] |role, out, rc, w, on, absent|:
                        node: i64 = Rig::node_of(&rc, role)
                        if on and node >= 0 and node.usize() < w.pos.count:
                            out.support.push(vec(w.pos[node.usize()]))
                        else:
                            out.support.push(absent)

        # The support points of `frame` (empty when out of range).
        def support_at(c: Clip&, frame: i64) -> darray[Geometry::Vec3]:
            mutable out: darray[Geometry::Vec3] = []
            return out if frame < 0 or frame >= c.frames
            base: i64 = frame * Support::CORNERS
            return out if (base + Support::CORNERS).usize() > c.support.count
            for k in 0..<Support::CORNERS |k, out, c, base|:
                out.push(c.support[(base + k).usize()])
            return out

        def rig(c: Clip&) -> PoseOverride::Rig:
            return StudioClip::rig(c.cleaned, c.nodes, c.slot)

        # Model transforms of the cleaned (or, `source`, the raw) clip.
        def models(c: Clip&, r: PoseOverride::Rig&, frame: i64, source: bool) -> darray[Geometry::Transform]:
            return StudioClip::models_at(r, c.source, c.anim, source_frame(c, frame), c.nodes, c.slot) if source
            return StudioClip::models_at(r, c.cleaned, c.anim, frame, c.nodes, c.slot)

        # Rig slot of the default curve bone (hips; slot 0 when unmapped).
        def default_bone(c: Clip&) -> i64:
            hips: i64 = StudioClip::slot_of_role(c.cleaned, c.slot, Roles::Joint.Hips.i64())
            return hips if hips >= 0 else 0

        # The rotation channel of rig slot `bone` (translation when the bone
        # has no rotation channel), or -1.
        def curve_channel(c: Clip&, bone: i64) -> i64:
            return curve_channel_in(c, bone, StudioOverlay::CurveMode.Rotation.i64())

        # The channel the curve view plots in `mode` (StudioOverlay::CurveMode.Rotation.i64()
        # or POSITION), falling back to the other path, or -1.
        def curve_channel_in(c: Clip&, bone: i64, mode: i64) -> i64:
            return -1 if bone < 0 or bone >= c.nodes.count.i64()
            node: usize = c.nodes[bone.usize()].usize()
            rot: i64 = StudioClip::channel_of(c.source, c.anim, node, GlbDocument::TargetPath.Rotation)
            pos: i64 = StudioClip::channel_of(c.source, c.anim, node, GlbDocument::TargetPath.Translation)
            return StudioOverlay::channel(mode, rot if rot >= 0 else -1, pos if pos >= 0 else -1)

        # Whether `channel` animates a translation (else a rotation).
        def is_position(c: Clip&, channel: i64) -> bool:
            return false if channel < 0 or channel >= GlbDocument::channel_count(c.source, c.anim).i64()
            held: GlbDocument::Channel = GlbDocument::channel(c.source, c.anim, channel.usize())
            return held.path == GlbDocument::TargetPath.Translation

        # Frames each side of the key a gizmo correction fades over.
        const module Correction:
            REACH: i64 = 12

        # The current correction evaluator edits existing non-cubic keys;
        # it cannot create an absent channel or a new sample at this frame.
        def correction_channel_available(c: Clip&, bone: i64, frame: i64, rotation: bool) -> bool:
            return false if bone < 0 or bone >= c.nodes.count.i64() or frame < 0
            return false if not StudioSampleClock::ready(&c.sample_clock) or StudioSampleClock::count(&c.sample_clock) != c.frames
            node: i64 = c.nodes[bone.usize()]
            return false if node < 0 or node >= GlbDocument::node_count(&c.cleaned).i64()
            path: GlbDocument::TargetPath = GlbDocument::TargetPath.Rotation if rotation else GlbDocument::TargetPath.Translation
            at: i64 = StudioClip::channel_of(c.cleaned, c.anim, node.usize(), path)
            return false if at < 0 or at >= GlbDocument::channel_count(&c.cleaned, c.anim).i64()
            held: GlbDocument::Channel = GlbDocument::channel(&c.cleaned, c.anim, at.usize())
            # A single constant key cannot represent a scoped frame edit.
            return false if GlbDocument::key_count(&c.cleaned, held.output).i64() != c.frames
            CorrectionScopePolicy::channel_admitted(true,
                held.interpolation != GlbDocument::Interpolation.CubicSpline,
                frame.usize() < GlbDocument::key_count(&c.cleaned, held.output))

        # The correction that moves rig slot `bone` to model transform `goal`
        # at `frame`, faded over Correction::REACH frames each side.
        def correction_for(c: Clip&, r: PoseOverride::Rig&, bone: i64, frame: i64, goal: Geometry::Transform) -> Corrections::Correction:
            models: darray[Geometry::Transform] = models(c, r, frame, false)
            b: usize = bone.usize()
            parent: i64 = PoseOverride::rig_parent(r, b)
            current: Geometry::Transform = Geometry::transform_apply_inverse(models[parent.usize()], models[b]) if parent >= 0 else models[b]
            wanted: Geometry::Transform = Geometry::transform_apply_inverse(models[parent.usize()], goal) if parent >= 0 else goal
            last: i64 = c.frames - 1 if c.frames > 0 else 0
            first: i64 = frame - Correction::REACH if frame > Correction::REACH else 0
            end: i64 = frame + Correction::REACH if frame + Correction::REACH < last else last
            return Corrections::keyed(c.nodes[b], frame, first, end, current, wanted)

        # Default stack: the boxing preset.
        # Feet are fixed by default (blend StudioFoot::Blend::DEFAULT).
        def initial_stack() -> StackState::Stack:
            mutable s: StackState::Stack = StackState::from_list(Presets::operations(Presets::Preset.Boxing))
            s.feet <- true
            return s

        # One-click Fix all also enables the hand lock. Boxing clips have no
        # detected hand contacts; grounded and rope work gets every contact
        # cleanup in one reversible edit.
        def fix_all_stack() -> StackState::Stack:
            mutable s: StackState::Stack = initial_stack()
            s.hands <- true
            return s

        # A fresh operation of kind index `k` (0..4) over the whole clip.
        def new_operation(k: i64, frames: i64) -> Ops::Operation:
            last: i64 = frames - 1 if frames > 0 else 0
            return Ops::smooth_path(0, last, -1, 2) if k == 1
            return Ops::median(0, last, -1, 2) if k == 2
            return Ops::limit_wring(0, last, -1, Wring::DEFAULT) if k == 3
            return Ops::seam(8) if k == 4
            return Ops::despike(0, last, -1, 2)

        # Limit wring's strength is a fixed-point limit, not a pass count, so
        # it nudges in steps of Wring::STEP within [0, SCALE]; every other kind
        # goes through StackState::nudge_strength.
        const module Wring:
            DEFAULT: i64 = 200000
            STEP: i64 = 20000
            MAXIMUM: i64 = 1000000

        def nudge(s: mutable StackState::Stack&, at: i64, delta: i64) -> bool:
            return false if not StackState::valid(s, at)
            mutable op: Ops::Operation = s.ops[at]
            if op.kind == Ops::Kind.LimitWring:
                v: i64 = op.strength + delta * Wring::STEP
                op.strength <- 0 if v < 0 else (Wring::MAXIMUM if v > Wring::MAXIMUM else v)
                s.ops[at] <- op
                return true
            return StackState::nudge_strength(s, at, delta)
