include "app_state.elisa"
include "../session_save_target_policy.elisa"
include "../state/session_state_source_save.elisa"
include "../session_save_source_worker.elisa"
include "../session_save_source_job_policy.elisa"
include "../session_save_completion_policy.elisa"
include "../take_source_ref_copy.elisa"
include "../../core/bounded_path_policy.elisa"
include "../../core/generation_policy.elisa"

extend Studio:
    private:
        global mutable session_source_save_task: Thread[StudioSessionSaveSourceWorker::Result, Joinable]? = null
        global mutable session_source_save_ticket: i64 = 0
        global mutable session_source_save_take: i64 = -1
        global mutable session_source_save_stack: i64 = -1
        global mutable session_source_save_document: i64 = -1
        global mutable session_source_save_identity: SessionState::SourceIdentity = zeroed
        global mutable session_source_save_destination: u8[4096] = zeroed
        global mutable session_source_save_source: u8[4096] = zeroed
        global mutable session_source_save_runtime: u8[4096] = zeroed
        global mutable session_source_save_adopt: bool = false
        global mutable session_source_save_cancelled: bool = false
        global mutable session_source_save_replacement_pending: bool = false
        global mutable session_source_save_discard_pending: bool = false
        global mutable session_source_save_close_pending: bool = false
        global mutable session_source_save_reopen_close_prompt: bool = false

        const module SessionSaveLimit:
            PATH_BYTES: usize = 4096
            ANIMATION_BYTES: usize = 1024

        def session_save_copy_path(destination: mutable u8[4096]&, source: cstr) -> bool can Unsafe.PointerCast:
            # Refuse invalid input before mutating retained save staging.
            length: i64 = bounded_path_length(source)
            return false if not BoundedPathPolicy::nonempty_admitted(length, SessionSaveLimit::PATH_BYTES.i64())
            mutable index: usize = 0
            while index <= length.usize():
                destination[index] <- source[index]
                index <- index + 1
            true

        def session_save_source_current(ticket: i64) -> bool can[Unsafe.PointerCast, Global.Read]:
            can Global.Read:
                return false if ticket <= 0 or ticket != session_source_save_ticket or session_source_save_take != take_serial or session_source_save_stack != stack_generation or session_source_save_document != built
                if clip is current:
                    observed_identity: SessionState::SourceIdentity = session_identity(current)
                    return false if observed_identity.first != session_source_save_identity.first or observed_identity.second != session_source_save_identity.second or observed_identity.animation != session_source_save_identity.animation or observed_identity.frames != session_source_save_identity.frames or observed_identity.nodes != session_source_save_identity.nodes
                else:
                    return false
                return false if path == null
                mutable current: i64 = bounded_path_length(path)
                mutable expected: i64 = 0
                while expected < 4096 and session_source_save_source[expected.usize()] != 0:
                    expected <- expected + 1
                return false if current != expected
                for index in 0..<expected.usize() |index, path, session_source_save_source|:
                    return false if path[index] != session_source_save_source[index]
                current_runtime: cstr = runtime_take_path(path)
                current_runtime_length: i64 = bounded_path_length(current_runtime)
                mutable expected_runtime_length: i64 = 0
                while expected_runtime_length < 4096 and session_source_save_runtime[expected_runtime_length.usize()] != 0:
                    expected_runtime_length <- expected_runtime_length + 1
                return false if current_runtime_length != expected_runtime_length
                for runtime_index in 0..<expected_runtime_length.usize() |runtime_index, current_runtime, session_source_save_runtime|:
                    return false if current_runtime[runtime_index] != session_source_save_runtime[runtime_index]
                return not pending_edit_active()

        def session_save_start_capture(destination: cstr, adopt_destination: bool) -> bool can[Threads, Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                return false if session_source_save_task != null
                return false if not GenerationPolicy::can_advance(session_source_save_ticket)
                return false if not session_save_copy_path(&session_source_save_destination, destination)
                if clip is current:
                    source_path: darray[u8] = cstr_path_bytes(path)
                    runtime_path: darray[u8] = cstr_path_bytes(runtime_take_path(path))
                    return false if source_path.count < 2 or runtime_path.count < 2
                    mutable selected_animation: darray[u8] = []
                    selected_count: usize = GlbDocument::animation_name(&current.source, current.anim, &selected_animation)
                    return false if selected_count == 0 or selected_count >= SessionSaveLimit::ANIMATION_BYTES
                    mutable job: StudioSessionSaveSourceWorker::Job = zeroed
                    session_source_save_ticket <- GenerationPolicy::advance(session_source_save_ticket)
                    job.ticket <- session_source_save_ticket
                    for index in 0..<source_path.count |index, source_path, job|:
                        job.source_path[index] <- source_path[index]
                    for index in 0..<runtime_path.count |index, runtime_path, job|:
                        job.runtime_path[index] <- runtime_path[index]
                    job.animation_count <- selected_count.i64()
                    for index in 0..<selected_count |index, selected_animation, job|:
                        job.animation_name[index] <- selected_animation[index]
                    if current.source_reference is reference:
                        copied: StudioTakeSourceRefPolicy::TakeSourceRef = StudioTakeSourceRefCopy::copy(reference)
                        record: SessionSourceReferenceCodec::Record = SessionSourceReferenceCodec::Record{reference: move copied, animation_name: selected_animation}
                        mutable encoded: darray[u8] = []
                        return false if not SessionSourceReferenceCodec::encode(record, &encoded)
                        job.has_reference <- true
                        job.reference_count <- encoded.count.i64()
                        for index in 0..<encoded.count |index, encoded, job|:
                            job.reference_line[index] <- encoded[index]
                    elif fbx_path(path):
                        return false
                    session_source_save_take <- take_serial
                    session_source_save_stack <- stack_generation
                    session_source_save_document <- built
                    session_source_save_identity <- session_identity(current)
                    for index in 0..<source_path.count |index, source_path, session_source_save_source|:
                        session_source_save_source[index] <- source_path[index]
                    for index in 0..<runtime_path.count |index, runtime_path, session_source_save_runtime|:
                        session_source_save_runtime[index] <- runtime_path[index]
                    session_source_save_adopt <- adopt_destination
                    session_source_save_cancelled <- false
                    session_source_save_task <- task(capture_session_source_save_job, move job)
                    status <- "Verifying source and animation metadata before saving the session. The current take remains open."
                    status_file <- path
                    touch()
                    UiCore::request_frame_after(0.01)
                    return true
                status <- "Session save needs an open take so it can capture the source identity."
                status_file <- null
                touch()
                return false

        def session_impact_records_match_clip(records: darray[SessionImpactAnnotationPolicy::Stored]&,
                                              state: SessionImpactAnnotationPolicy::ReviewState,
                                              c: StudioModel::Clip&) -> bool:
            identity: SessionState::SourceIdentity = session_identity(c)
            SessionState::impact_records_valid(records, state, identity)

        def save_session_to_path(destination: cstr, adopt_destination: bool) -> bool can[Threads, Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                # Preflight before IO; a refused Save As never changes the active path.
                if adopt_destination and not BoundedPathPolicy::admitted(bounded_path_length(destination), PathCapacity::BYTES.i64()):
                    status <- "session path exceeds 4095 bytes"
                    status_file <- null
                    touch()
                    return false
                if pending_edit_active():
                    say_file("Session save blocked while an edit result is pending. Wait for it to finish or discard the pending edit.", destination)
                    touch()
                    return false
                mutable destination_reason: i64 = StudioExportPolicy::Reason.PATH_UNRESOLVED.i64()
                can Unsafe.PointerCast:
                    destination_reason <- export_reason(destination, true)
                if destination_reason != StudioExportPolicy::Reason.ALLOW.i64():
                    mutable explanation: sview = "Session save blocked: destination could not be verified. Choose a regular file inside build/."
                    explanation <- "Session save blocked: destination is the source take or its alias. Choose another file inside build/." if destination_reason == StudioExportPolicy::Reason.SOURCE_COLLISION.i64()
                    explanation <- "Session save blocked: choose a file inside build/." if destination_reason == StudioExportPolicy::Reason.OUTSIDE_BUILD.i64()
                    explanation <- "Session save blocked: destination is a symbolic link. Choose a regular file inside build/." if destination_reason == StudioExportPolicy::Reason.SYMBOLIC_LINK.i64()
                    say_file(explanation, destination)
                    touch()
                    return false
                mutable artifact_allowed: bool = false
                can Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}:
                    artifact_allowed <- artifact_destination_allowed(destination)
                if not artifact_allowed:
                    say_file("Session save blocked: reserved Storage metadata or identity could not be verified. Choose another file inside build/.", destination)
                    touch()
                    return false
                return false if session_source_save_task != null
                started: bool = session_save_start_capture(destination, adopt_destination)
                if not started:
                    say_file("Session source identity could not be captured safely; the session was not written.", destination)
                    touch()
                return started

        def finish_session_source_save(record: SessionSourceReferenceCodec::Record, destination: cstr, adopt_destination: bool) -> StudioSessionSaveCompletionPolicy::Outcome can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return StudioSessionSaveCompletionPolicy::Outcome.Refused if pending_edit_active()
                if clip is current:
                    return StudioSessionSaveCompletionPolicy::Outcome.Refused if not session_save_source_current(session_source_save_ticket)
                    mutable records: darray[SessionIssueAnnotationPolicy::Stored] = []
                    mutable impact_records: darray[SessionImpactAnnotationPolicy::Stored] = []
                    if issues_revision == built:
                        for issue in issues |issue, issue_annotations, records|:
                            if StudioIssueAnnotation::disposition(issue_annotations, issue) == StudioIssueAnnotation::Disposition.Ignored:
                                records.push(SessionIssueAnnotationPolicy::stored_from_issue(issue, frames()))
                    suggestion_impact_prepare(current)
                    return StudioSessionSaveCompletionPolicy::Outcome.Refused if not suggestion_impact_snapshot_valid(current)
                    impact_records <- suggestion_impact_session_records(current)
                    session_stack: StackState::Stack = current_stack()
                    identity: SessionState::SourceIdentity = session_identity(current)
                    impact_state: SessionImpactAnnotationPolicy::ReviewState = suggestion_impact_session_state()
                    outcome: SessionState::SourceSaveResult = SessionState::save_session_with_source_reference(session_stack, identity, record, records, impact_state, impact_records, destination)
                    return StudioSessionSaveCompletionPolicy::Outcome.Refused if outcome != SessionState::SourceSaveResult.Saved
                    mutable path_adopted: bool = not adopt_destination
                    if StudioSessionSaveTargetPolicy::may_adopt(true, adopt_destination):
                        path_adopted <- set_session_path(destination)
                    HistoryState::mark_saved(&history)
                    published_destination: cstr = session_path if adopt_destination and path_adopted else destination
                    mutable tracked: bool = false
                    can Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}:
                        tracked <- register_storage_artifact(published_destination, StudioStorageRegistrationPolicy::receipt_kind(StudioStorageRegistrationPolicy::Artifact.Session.i64()))
                    FilePanel::note_recent(published_destination)
                    return StudioSessionSaveCompletionPolicy::classify(true, adopt_destination, path_adopted, tracked)
                return StudioSessionSaveCompletionPolicy::Outcome.Refused

        def poll_session_source_save() -> void can[Threads, Ui.Window, Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                if session_source_save_task is active:
                    session_source_save_task <- null
                    readiness: ThreadReadiness[StudioSessionSaveSourceWorker::Result] = poll_ready(move active)
                    if not readiness.complete:
                        session_source_save_task <- move readiness.thread
                        UiCore::request_frame_after(0.01)
                        return
                    match join(move readiness.thread):
                        StudioSessionSaveSourceWorker::Result{ticket: completed_ticket, status: completed_status, line_count: line_count, line: line}:
                            mutable result_current: bool = session_save_source_current(completed_ticket)
                            same_take: bool = session_source_save_take == take_serial
                            same_stack: bool = session_source_save_stack == stack_generation
                            mutable same_document: bool = session_source_save_document == built
                            if clip is current:
                                observed_identity: SessionState::SourceIdentity = session_identity(current)
                                same_document <- same_document and observed_identity.first == session_source_save_identity.first and observed_identity.second == session_source_save_identity.second and observed_identity.animation == session_source_save_identity.animation and observed_identity.frames == session_source_save_identity.frames and observed_identity.nodes == session_source_save_identity.nodes
                            else:
                                same_document <- false
                            mutable same_path: bool = false
                            if path != null:
                                current_length: i64 = bounded_path_length(path)
                                mutable expected_length: i64 = 0
                                while expected_length < 4096 and session_source_save_source[expected_length.usize()] != 0:
                                    expected_length <- expected_length + 1
                                same_path <- current_length == expected_length
                                if same_path:
                                    for path_index in 0..<expected_length.usize() |path_index, path, session_source_save_source|:
                                        same_path <- false if path[path_index] != session_source_save_source[path_index]
                            mutable same_runtime: bool = false
                            if path != null:
                                current_runtime: cstr = runtime_take_path(path)
                                runtime_length: i64 = bounded_path_length(current_runtime)
                                mutable expected_runtime_length: i64 = 0
                                while expected_runtime_length < 4096 and session_source_save_runtime[expected_runtime_length.usize()] != 0:
                                    expected_runtime_length <- expected_runtime_length + 1
                                same_runtime <- runtime_length == expected_runtime_length
                                if same_runtime:
                                    for runtime_index in 0..<expected_runtime_length.usize() |runtime_index, current_runtime, session_source_save_runtime|:
                                        same_runtime <- false if current_runtime[runtime_index] != session_source_save_runtime[runtime_index]
                            reply_admission: StudioSessionSaveSourceJobPolicy::Reply = StudioSessionSaveSourceJobPolicy::reply(
                                completed_ticket, session_source_save_ticket, session_source_save_cancelled, same_take, same_stack, same_document, same_path,
                                same_runtime, not pending_edit_active(), completed_status == StudioSessionSaveSourceWorker::Status.Ready.i64())
                            result_current <- result_current and reply_admission == StudioSessionSaveSourceJobPolicy::Reply.Publish
                            mutable save_ok: bool = false
                            if result_current and completed_status == StudioSessionSaveSourceWorker::Status.Ready.i64() and line_count > 0 and line_count <= 20000:
                                mutable encoded: darray[u8] = []
                                for index in 0..<line_count.usize() |index, line, encoded|:
                                    encoded.push(line[index])
                                if SessionSourceReferenceCodec::decode(&encoded) is captured:
                                    completion: StudioSessionSaveCompletionPolicy::Outcome = finish_session_source_save(move captured, (&session_source_save_destination[0]).cast[cstr], session_source_save_adopt)
                                    save_ok <- completion != StudioSessionSaveCompletionPolicy::Outcome.Refused
                                    status <- "Session saved with verified source reference." if completion == StudioSessionSaveCompletionPolicy::Outcome.Saved
                                    status <- "Session saved with verified source reference, but Storage registration could not be saved; the file remains protected." if completion == StudioSessionSaveCompletionPolicy::Outcome.SavedUntracked
                                    status <- "Session saved at the selected destination, but the future Save target could not be updated." if completion == StudioSessionSaveCompletionPolicy::Outcome.SavedTargetUnchanged
                                    status <- "Session saved at the selected destination; Save target update and Storage registration both failed." if completion == StudioSessionSaveCompletionPolicy::Outcome.SavedUntrackedTargetUnchanged
                            if not save_ok:
                                status <- "Session source changed or could not be verified. No session was written; the current cleanup remains unsaved."
                            status_file <- null
                            touch()
                            if session_source_save_replacement_pending:
                                session_source_save_replacement_pending <- false
                                resume_replacement_after_session_save(save_ok)
                            if session_source_save_discard_pending:
                                session_source_save_discard_pending <- false
                                resume_replacement_after_session_discard()
                            if session_source_save_close_pending and (save_ok or session_source_save_cancelled):
                                session_source_save_close_pending <- false
                                finish_close()
                            session_source_save_close_pending <- false if not save_ok and not session_source_save_cancelled
                            if session_source_save_reopen_close_prompt:
                                session_source_save_reopen_close_prompt <- false
                                request_window_close()
                            session_source_save_adopt <- false
                            session_source_save_cancelled <- false
                            session_source_save_take <- -1
                            session_source_save_stack <- -1
                            session_source_save_document <- -1

        def save_session_to_current_path() -> bool can[Threads, Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return save_session_to_path(session_path, false)

        def save_session() -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                _ = save_session_to_current_path()

        def resume_replacement_after_session_save(saved: bool) -> void can[Ui.Window, Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not replacement_prompt_open or replacement_focus != StudioReplacement::Focus.Save
                if not saved:
                    replacement_save_failed <- true
                    status <- "Session source could not be verified or saved. The current take and replacement prompt remain open."
                    status_file <- null
                    touch()
                    return
                pending: cstr = pending_path()
                kind: i64 = pending_replacement
                allow_legacy: bool = pending_replacement_allows_legacy
                replacement_prompt_open <- false
                replacement_save_failed <- false
                if kind == Replacement.Close.i64():
                    capture_worker_close_approval() if contact_preview_task != null
                    finish_close()
                    return
                perform_replacement(kind, pending, allow_legacy)

        def resume_replacement_after_session_discard() -> void can[Ui.Window, Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not replacement_prompt_open
                pending: cstr = pending_path()
                kind: i64 = pending_replacement
                allow_legacy: bool = pending_replacement_allows_legacy
                replacement_prompt_open <- false
                replacement_save_failed <- false
                if kind == Replacement.Close.i64():
                    finish_close()
                    return
                perform_replacement(kind, pending, allow_legacy)

        def install_session(p: cstr, loaded: StackState::Stack, allow_legacy: bool) -> bool can[Global{Read, Write}]:
            can Global{Read, Write}:
                mutable accepted: bool = StackState::same(current_stack(), loaded)
                accepted <- commit(loaded, true) if not accepted
                return false if not accepted
                issue_annotations <- zeroed
                pending_session_annotation_restore <- true
                session_annotations_expired <- 0
                if clip is c:
                    suggestion_impact_prepare(c)
                    suggestion_impact_review_state <- StudioImpactAnnotationPolicy::ReviewState.Unreviewed
                    suggestion_impact_annotation_count <- 0
                    impact_valid: bool = session_impact_records_match_clip(pending_session_impact_annotations, pending_session_impact_state, c)
                    if impact_valid:
                        suggestion_impact_review_state <- StudioImpactAnnotationPolicy::ReviewState.EventsMarked if pending_session_impact_state == SessionImpactAnnotationPolicy::ReviewState.EventsMarked
                        suggestion_impact_review_state <- StudioImpactAnnotationPolicy::ReviewState.NoEventsReviewed if pending_session_impact_state == SessionImpactAnnotationPolicy::ReviewState.NoEventsReviewed
                        if pending_session_impact_state == SessionImpactAnnotationPolicy::ReviewState.EventsMarked:
                            for record in pending_session_impact_annotations |record|:
                                suggestion_impact_annotations[suggestion_impact_annotation_count.usize()] <- StudioImpactAnnotationPolicy::Annotation{source_first: record.source_first, source_second: record.source_second, source_frame: record.source_frame}
                                suggestion_impact_annotation_count <- suggestion_impact_annotation_count + 1
                if issues_revision == built:
                    reconcile_pending_session_annotations(issues)
                clear_pending_session_annotations()
                HistoryState::mark_saved(&history)
                # Opened paths are inputs. Keep the next Save target in the
                # selected workspace, and remember the imported file only as a
                # recent item; it must not rebind future writes outside that root.
                session_path <- SESSION_PATH
                status <- "session loaded (Cmd-Z to undo)"
                status <- "legacy session loaded; verify joints (Cmd-Z to undo)" if allow_legacy
                if session_annotations_expired > 0:
                    status <- "session loaded; finding annotations expired after analysis changed"
                status_file <- null
                FilePanel::note_recent(p)
                touch()
                return true

        def resolve_legacy_session(choice: i64) -> void can[Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                action: i64 = StudioLegacyPrompt::resolve(legacy_prompt_open, choice)
                return if action == StudioLegacyPrompt::Choice.None.i64()
                if action == StudioLegacyPrompt::Choice.Cancel.i64():
                    legacy_prompt_open <- false
                    pending_replacement <- 0
                    pending_replacement_allows_legacy <- false
                    pending_session_ready <- false
                    clear_pending_session_annotations()
                    say_file("legacy session cancelled; current cleanup unchanged", pending_path())
                    touch()
                    return
                p: cstr = pending_path()
                legacy_prompt_open <- false
                touch()
                request_replacement(p, Replacement.Session.i64(), true)
