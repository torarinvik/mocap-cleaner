        def clear_pending_session_annotations() -> void:
            pending_session_annotations <- zeroed
            pending_session_impact_state <- SessionImpactAnnotationPolicy::ReviewState.Unreviewed
            pending_session_impact_annotations <- zeroed
            pending_session_annotation_restore <- false
