include "app_generation_inventory.elisa"
include "generation_review_copy.elisa"
include "../state/generation_review_list_policy.elisa"
include "../state/generation_review_focus_policy.elisa"

extend Studio:
    private:
        global mutable generation_review_open: bool = false
        global mutable generation_review_page: i64 = 0
        global mutable generation_inspected_row: i64 = -1
        global mutable generation_review_focus: i64 = -1
        global mutable generation_review_recovery_mode: bool = false

        const enum GenerationReviewAction of i64:
            Previous = 0
            Next = 1
            Refresh = 2
            Back = 3
            Review = 4
            Restore = 5
            Operations = 6
            Path = 7

        const module GenerationReviewLimit:
            FOOTER_CONTROLS: i64 = 7
            FOCUS_COUNT: i64 = StudioGenerationReviewFocusPolicy::Limit::COUNT

        def generation_review_path_bytes() -> darray[u8] can[Unsafe.PointerCast, Memory.Allocate, Global.Read]:
            can Global.Read:
                mutable root: darray[u8] = []
                mutable relative: darray[u8] = []
                if generation_review_recovery_mode:
                    return [] if not generation_recovery_scan_current()
                    if generation_recovery_scan_reply is reply:
                        return [] if not reply.observation.output_details_valid
                        root.extend(reply.root)
                        relative.extend(reply.observation.relative_path)
                elif generation_inventory is snapshot:
                    return [] if generation_inspected_row < 0 or generation_inspected_row >= snapshot.rows.count.i64()
                    root.extend(generation_scan_root)
                    relative.extend(snapshot.rows[generation_inspected_row].relative_path)
                else:
                    return []
                return [] if root.count == 0 or relative.count == 0
                mutable path: darray[u8] = []
                path.extend(root)
                if root[root.count - 1] != 47:
                    path.push(47)
                path.extend(relative)
                return path

        def generation_review_open_path() -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                path: darray[u8] = generation_review_path_bytes()
                generation_path_open_with(path, GenerationReviewAction.Path.i64())

        def generation_review_focus_enabled(index: i64, pages: i64) -> bool can[Unsafe.PointerCast, Memory.Allocate, Global.Read]:
            can Global.Read:
                return pages > 0 if index == GenerationReviewAction.Previous.i64() and generation_review_page > 0
                return generation_review_page + 1 < pages if index == GenerationReviewAction.Next.i64()
                return true if index == GenerationReviewAction.Refresh.i64() or index == GenerationReviewAction.Back.i64() or index == GenerationReviewAction.Operations.i64()
                return generation_move_action_enabled() if index == GenerationReviewAction.Review.i64()
                return generation_restore_action_enabled() if index == GenerationReviewAction.Restore.i64()
                return StudioGenerationReviewPathPolicy::path_valid(generation_review_path_bytes()) if index == GenerationReviewAction.Path.i64()
                return false

        def generation_review_next_focus(reverse: bool, pages: i64) -> i64 can[Unsafe.PointerCast, Memory.Allocate, Global.Read]:
            can Global.Read:
                mutable enabled: darray[bool] = []
                for index in 0..<GenerationReviewLimit::FOCUS_COUNT |index, enabled, pages|:
                    enabled.push(generation_review_focus_enabled(index, pages))
                return StudioGenerationReviewFocusPolicy::next(generation_review_focus, reverse, enabled)

        def generation_review_box(w: f32, h: f32) -> StudioPanels::Box:
            width: f32 = 820.0 if w >= 852.0 else w - 32.0
            height: f32 = 660.0 if h >= 692.0 else h - 32.0
            StudioPanels::box((w - width) / 2.0, (h - height) / 2.0, width, height)

        def generation_review_control_box(w: f32, h: f32, action: i64) -> StudioPanels::Box:
            d: StudioPanels::Box = generation_review_box(w, h)
            width: f32 = (d.w - 48.0 - (GenerationReviewLimit::FOOTER_CONTROLS - 1).f32() * 8.0) / GenerationReviewLimit::FOOTER_CONTROLS.f32()
            StudioPanels::box(d.x + 24.0 + action.f32() * (width + 8.0), d.y + d.h - 48.0, width, 30.0)

        def generation_review_row_box(w: f32, h: f32, slot: i64) -> StudioPanels::Box:
            d: StudioPanels::Box = generation_review_box(w, h)
            StudioPanels::box(d.x + 20.0, d.y + 103.0 + slot.f32() * 26.0, d.w - 40.0, 24.0)

        def generation_review_action(action: i64) -> void can[Threads, Unsafe{PointerCast, RawExtern}, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                if action == GenerationReviewAction.Path.i64():
                    generation_review_open_path()
                    return
                if action == GenerationReviewAction.Review.i64():
                    generation_move_review_action() if generation_move_action_enabled()
                    return
                if action == GenerationReviewAction.Restore.i64():
                    generation_restore_action()
                    return
                if action == GenerationReviewAction.Operations.i64():
                    cancel_generation_move_review()
                    generation_recovery_browser_reset()
                    generation_review_recovery_mode <- not generation_review_recovery_mode
                    generation_recovery_browser_begin() if generation_review_recovery_mode
                    generation_review_page <- 0
                    generation_inspected_row <- -1
                    touch()
                    return
                cancel_generation_move_review()
                generation_restore_cancel_review()
                if action == GenerationReviewAction.Previous.i64():
                    generation_review_key(UiCore::Key.Left)
                elif action == GenerationReviewAction.Next.i64():
                    generation_review_key(UiCore::Key.Right)
                elif action == GenerationReviewAction.Refresh.i64():
                    generation_review_page <- 0
                    generation_inspected_row <- -1
                    if generation_review_recovery_mode:
                        generation_recovery_browser_refresh()
                    else:
                        request_generation_inventory()
                elif action == GenerationReviewAction.Back.i64():
                    generation_review_key(UiCore::Key.Escape)
                touch()

        def generation_review_pointer(w: f32, h: f32, x: f32, y: f32, button: i32) -> void can[Threads, Unsafe{PointerCast, RawExtern}, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return if generation_path_pointer(w, h, x, y, button)
                return if button != 0
                if StudioPanels::inside(StudioGenerationReviewPathInspector::inspect_button_box(w, h), x, y) and StudioGenerationReviewPathPolicy::path_valid(generation_review_path_bytes()):
                    generation_review_open_path()
                    return
                for action in 0..<GenerationReviewLimit::FOOTER_CONTROLS |w, h, x, y, action|:
                    if StudioPanels::inside(generation_review_control_box(w, h, action), x, y):
                        generation_review_focus <- action
                        generation_review_action(action)
                        return
                count: i64 = generation_review_count()
                for slot in 0..<StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page) |w, h, x, y, slot, count|:
                    if StudioPanels::inside(generation_review_row_box(w, h, slot), x, y):
                        cancel_generation_move_review()
                        generation_restore_cancel_review()
                        generation_inspected_row <- StudioGenerationReviewListPolicy::inspection_target(count, generation_review_page, slot)
                        generation_recovery_browser_select(generation_inspected_row) if generation_review_recovery_mode
                        generation_review_focus <- -1
                        touch()
                        return

        def generation_review_count() -> i64 can[Global.Read]:
            can Global.Read:
                return generation_recovery_browser_count() if generation_review_recovery_mode
                if generation_inventory is snapshot:
                    return snapshot.rows.count.i64() if snapshot.outcome == StudioBuildGenerationCandidateProvider::Outcome.Complete else 0
                return 0

        def open_generation_review() -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if not storage_screen_open or storage_batch_state == StudioStorageBatchPolicy::State.Running.i64() or storage_move_review or storage_restore_review
                generation_review_open <- true
                generation_review_page <- 0
                generation_inspected_row <- -1
                generation_review_focus <- -1
                touch()

        def generation_review_key(code: i64) -> void can[Threads, Unsafe{PointerCast, RawExtern}, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return if generation_path_key(code)
                if code == UiCore::Key.P and StudioGenerationReviewPathPolicy::path_valid(generation_review_path_bytes()):
                    generation_review_open_path()
                    return
                previous_inspected_row: i64 = generation_inspected_row
                if code == UiCore::Key.Escape or code == UiCore::Key.Left or code == UiCore::Key.Right or code == UiCore::Key.Up or code == UiCore::Key.Down:
                    cancel_generation_move_review()
                    generation_restore_cancel_review()
                count: i64 = generation_review_count()
                pages: i64 = StudioGenerationReviewListPolicy::page_count(count)
                if code == UiCore::Key.Escape:
                    generation_review_open <- false
                    generation_recovery_browser_unselect() if generation_review_recovery_mode
                elif code == UiCore::Key.Tab:
                    next_focus: i64 = generation_review_next_focus(StudioShortcuts::shift(modifiers), pages)
                    generation_review_focus <- next_focus if next_focus >= 0
                elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                    generation_review_action(generation_review_focus) if generation_review_focus >= 0
                elif code == UiCore::Key.Left:
                    generation_review_page <- generation_review_page - 1 if generation_review_page > 0 else 0
                    generation_inspected_row <- -1
                elif code == UiCore::Key.Right:
                    generation_review_page <- generation_review_page + 1 if generation_review_page + 1 < pages else generation_review_page
                    generation_inspected_row <- -1
                elif code == UiCore::Key.Up or code == UiCore::Key.Down:
                    first: i64 = StudioGenerationReviewListPolicy::first_row(count, generation_review_page)
                    visible: i64 = StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page)
                    if first >= 0 and visible > 0:
                        if generation_inspected_row < first or generation_inspected_row >= first + visible:
                            generation_inspected_row <- first
                        elif code == UiCore::Key.Down and generation_inspected_row < first + visible - 1:
                            generation_inspected_row <- generation_inspected_row + 1
                        elif code == UiCore::Key.Up and generation_inspected_row > first:
                            generation_inspected_row <- generation_inspected_row - 1
                if generation_review_recovery_mode and generation_inspected_row != previous_inspected_row:
                    generation_recovery_browser_select(generation_inspected_row) if generation_inspected_row >= 0
                    generation_recovery_browser_unselect() if generation_inspected_row < 0
                touch()

        def draw_generation_review(w: f32, h: f32) -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not generation_review_open or not storage_screen_open
                d: StudioPanels::Box = generation_review_box(w, h)
                width: f32 = d.w
                height: f32 = d.h
                x: f32 = d.x
                y: f32 = d.y
                StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
                StudioDraw::rect(x, y, width, height, StudioDraw::color(24, 28, 37))
                StudioDraw::bold(x + 24.0, y + 22.0, 19.0, "Generated builds", StudioDraw::ink())
                StudioDraw::text(x + 24.0, y + 52.0, 12.0, generation_review_status_message(), StudioDraw::muted())
                count: i64 = generation_review_count()
                pages: i64 = StudioGenerationReviewListPolicy::page_count(count)
                StudioText::begin()
                StudioText::put("Page ")
                StudioText::put_i(generation_review_page + 1 if pages > 0 else 0)
                StudioText::put(" of ")
                StudioText::put_i(pages)
                StudioText::put("   •   Left/Right: pages   Up/Down: inspect   Esc: back")
                StudioDraw::text(x + 24.0, y + 78.0, 11.0, StudioText::view(), StudioDraw::muted())
                if generation_review_recovery_mode:
                    for slot in 0..<StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page) |slot, count, x, y, width|:
                        index: i64 = StudioGenerationReviewListPolicy::inspection_target(count, generation_review_page, slot)
                        if index >= 0:
                            row_y: f32 = y + 108.0 + slot.f32() * 26.0
                            StudioDraw::rect(x + 20.0, row_y - 5.0, width - 40.0, 24.0, StudioDraw::color(47, 68, 92) if index == generation_inspected_row else StudioDraw::color(29, 34, 44))
                            StudioDraw::text(x + 28.0, row_y, 11.0, generation_recovery_row_name(index), StudioDraw::ink())
                    if generation_inspected_row >= 0 and generation_inspected_row < count:
                        StudioDraw::text(x + 24.0, y + height - 100.0, 10.0, generation_recovery_row_value(generation_inspected_row), StudioDraw::ink())
                elif generation_inventory is snapshot:
                    for slot in 0..<StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page) |snapshot, slot, count, x, y, width|:
                        index: i64 = StudioGenerationReviewListPolicy::inspection_target(count, generation_review_page, slot)
                        if index >= 0:
                            row: StudioBuildGenerationCandidateProvider::Row = snapshot.rows[index]
                            row_y: f32 = y + 108.0 + slot.f32() * 26.0
                            StudioDraw::rect(x + 20.0, row_y - 5.0, width - 40.0, 24.0, StudioDraw::color(47, 68, 92) if index == generation_inspected_row else StudioDraw::color(29, 34, 44))
                            StudioText::begin()
                            for byte in row.artifact_id:
                                StudioText::byte(byte)
                            StudioDraw::text(x + 28.0, row_y, 11.0, StudioText::view(), StudioDraw::ink())
                    if generation_inspected_row >= 0 and generation_inspected_row < count:
                        row: StudioBuildGenerationCandidateProvider::Row = snapshot.rows[generation_inspected_row]
                        StudioDraw::text(x + 24.0, y + height - 100.0, 12.0, StudioGenerationReviewCopy::protection(row), StudioDraw::ink())
                StudioDraw::text(x + 24.0, y + height - 72.0, 11.0, StudioGenerationReviewCopy::moved_bytes_explanation(), StudioDraw::muted())
                for action in 0..<GenerationReviewLimit::FOOTER_CONTROLS |w, h, action|:
                    control: StudioPanels::Box = generation_review_control_box(w, h, action)
                    StudioDraw::rect(control.x, control.y, control.w, control.h, StudioDraw::color(47, 68, 92) if generation_review_focus == action else StudioDraw::color(38, 44, 56))
                    label: sview = generation_move_action_label() if action == GenerationReviewAction.Review.i64() else generation_restore_action_label() if action == GenerationReviewAction.Restore.i64() else ("Generations" if generation_review_recovery_mode else "Operations") if action == GenerationReviewAction.Operations.i64() else "Previous" if action == 0 else "Next" if action == 1 else "Refresh" if action == 2 else "Back to Storage"
                    enabled: bool = generation_move_action_enabled() if action == GenerationReviewAction.Review.i64() else generation_restore_action_enabled() if action == GenerationReviewAction.Restore.i64() else true
                    StudioDraw::text(control.x + 12.0, control.y + 8.0, 12.0, label, StudioDraw::ink() if enabled else StudioDraw::muted())
                inspect_box: StudioPanels::Box = StudioGenerationReviewPathInspector::inspect_button_box(w, h)
                inspect_enabled: bool = StudioGenerationReviewPathPolicy::path_valid(generation_review_path_bytes())
                StudioDraw::rect(inspect_box.x, inspect_box.y, inspect_box.w, inspect_box.h, StudioDraw::color(47, 68, 92) if generation_review_focus == GenerationReviewAction.Path.i64() else StudioDraw::panel())
                StudioDraw::text(inspect_box.x + 9.0, inspect_box.y + 9.0, 11.0, StudioGenerationReviewPathInspector::inspect_button_label(inspect_box.w), StudioDraw::ink() if inspect_enabled else StudioDraw::muted())
                draw_generation_path_inspector(w, h)
