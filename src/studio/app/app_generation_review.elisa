include "app_generation_inventory.elisa"
include "generation_review_copy.elisa"
include "../state/generation_review_list_policy.elisa"

extend Studio:
    private:
        global mutable generation_review_open: bool = false
        global mutable generation_review_page: i64 = 0
        global mutable generation_inspected_row: i64 = -1
        global mutable generation_review_focus: i64 = -1

        const enum GenerationReviewAction of i64:
            Previous = 0
            Next = 1
            Refresh = 2
            Back = 3

        const module GenerationReviewLimit:
            CONTROLS: i64 = 4

        def generation_review_box(w: f32, h: f32) -> StudioPanels::Box:
            width: f32 = 820.0 if w >= 852.0 else w - 32.0
            height: f32 = 660.0 if h >= 692.0 else h - 32.0
            StudioPanels::box((w - width) / 2.0, (h - height) / 2.0, width, height)

        def generation_review_control_box(w: f32, h: f32, action: i64) -> StudioPanels::Box:
            d: StudioPanels::Box = generation_review_box(w, h)
            width: f32 = (d.w - 72.0) / 4.0
            StudioPanels::box(d.x + 24.0 + action.f32() * (width + 8.0), d.y + d.h - 48.0, width, 30.0)

        def generation_review_row_box(w: f32, h: f32, slot: i64) -> StudioPanels::Box:
            d: StudioPanels::Box = generation_review_box(w, h)
            StudioPanels::box(d.x + 20.0, d.y + 103.0 + slot.f32() * 26.0, d.w - 40.0, 24.0)

        def generation_review_action(action: i64) -> void:
            if action == GenerationReviewAction.Previous.i64():
                generation_review_key(UiCore::Key.Left)
            elif action == GenerationReviewAction.Next.i64():
                generation_review_key(UiCore::Key.Right)
            elif action == GenerationReviewAction.Refresh.i64():
                generation_review_page <- 0
                generation_inspected_row <- -1
                request_generation_inventory()
            elif action == GenerationReviewAction.Back.i64():
                generation_review_key(UiCore::Key.Escape)
            touch()

        def generation_review_pointer(w: f32, h: f32, x: f32, y: f32, button: i32) -> void:
            return if button != 0
            for action in 0..<GenerationReviewLimit::CONTROLS |w, h, x, y, action|:
                if StudioPanels::inside(generation_review_control_box(w, h, action), x, y):
                    generation_review_focus <- action
                    generation_review_action(action)
                    return
            count: i64 = generation_review_count()
            for slot in 0..<StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page) |w, h, x, y, slot, count|:
                if StudioPanels::inside(generation_review_row_box(w, h, slot), x, y):
                    generation_inspected_row <- StudioGenerationReviewListPolicy::inspection_target(count, generation_review_page, slot)
                    generation_review_focus <- -1
                    touch()
                    return

        def generation_review_count() -> i64:
            if generation_inventory is snapshot:
                return snapshot.rows.count.i64() if snapshot.outcome == StudioBuildGenerationCandidateProvider::Outcome.Complete else 0
            0

        def open_generation_review() -> void:
            return if not storage_screen_open or storage_batch_state == StudioStorageBatchPolicy::State.Running.i64() or storage_move_review or storage_restore_review
            generation_review_open <- true
            generation_review_page <- 0
            generation_inspected_row <- -1
            generation_review_focus <- -1
            touch()

        def generation_review_key(code: i64) -> void:
            count: i64 = generation_review_count()
            pages: i64 = StudioGenerationReviewListPolicy::page_count(count)
            if code == UiCore::Key.Escape:
                generation_review_open <- false
            elif code == UiCore::Key.Tab:
                generation_review_focus <- (GenerationReviewAction.Back.i64() if StudioShortcuts::shift(modifiers) else GenerationReviewAction.Previous.i64()) if generation_review_focus < 0 else (generation_review_focus + (GenerationReviewLimit::CONTROLS - 1 if StudioShortcuts::shift(modifiers) else 1)) % GenerationReviewLimit::CONTROLS
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                generation_review_action(generation_review_focus) if generation_review_focus >= 0
            elif code == UiCore::Key.Left:
                generation_review_page <- generation_review_page - 1 if generation_review_page > 0 else 0
                generation_inspected_row <- -1
            elif code == UiCore::Key.Right:
                generation_review_page <- generation_review_page + 1 if generation_review_page + 1 < pages else generation_review_page
                generation_inspected_row <- -1
            elif code == UiCore::Key.Up or code == UiCore::Key.Down:
                first: i64 = StudioGenerationReviewListPolicy::first_row(count, generation_review_page)
                visible: i64 = StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page)
                if first >= 0 and visible > 0:
                    if generation_inspected_row < first or generation_inspected_row >= first + visible:
                        generation_inspected_row <- first
                    elif code == UiCore::Key.Down and generation_inspected_row < first + visible - 1:
                        generation_inspected_row <- generation_inspected_row + 1
                    elif code == UiCore::Key.Up and generation_inspected_row > first:
                        generation_inspected_row <- generation_inspected_row - 1
            touch()

        def draw_generation_review(w: f32, h: f32) -> void:
            return if not generation_review_open or not storage_screen_open
            d: StudioPanels::Box = generation_review_box(w, h)
            width: f32 = d.w
            height: f32 = d.h
            x: f32 = d.x
            y: f32 = d.y
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(x, y, width, height, StudioDraw::color(24, 28, 37))
            StudioDraw::bold(x + 24.0, y + 22.0, 19.0, "Generated builds", StudioDraw::ink())
            StudioDraw::text(x + 24.0, y + 52.0, 12.0, generation_inventory_message(), StudioDraw::muted())
            count: i64 = generation_review_count()
            pages: i64 = StudioGenerationReviewListPolicy::page_count(count)
            StudioText::begin()
            StudioText::put("Page ")
            StudioText::put_i(generation_review_page + 1 if pages > 0 else 0)
            StudioText::put(" of ")
            StudioText::put_i(pages)
            StudioText::put("   •   Left/Right: pages   Up/Down: inspect   Esc: back")
            StudioDraw::text(x + 24.0, y + 78.0, 11.0, StudioText::view(), StudioDraw::muted())
            if generation_inventory is snapshot:
                for slot in 0..<StudioGenerationReviewListPolicy::visible_rows(count, generation_review_page) |snapshot, slot, count, x, y, width|:
                    index: i64 = StudioGenerationReviewListPolicy::inspection_target(count, generation_review_page, slot)
                    if index >= 0:
                        row: StudioBuildGenerationCandidateProvider::Row = snapshot.rows[index]
                        row_y: f32 = y + 108.0 + slot.f32() * 26.0
                        StudioDraw::rect(x + 20.0, row_y - 5.0, width - 40.0, 24.0, StudioDraw::color(47, 68, 92) if index == generation_inspected_row else StudioDraw::color(29, 34, 44))
                        StudioText::begin()
                        for byte in row.artifact_id:
                            StudioText::byte(byte)
                        StudioDraw::text(x + 28.0, row_y, 11.0, StudioText::view(), StudioDraw::ink())
                if generation_inspected_row >= 0 and generation_inspected_row < count:
                    row: StudioBuildGenerationCandidateProvider::Row = snapshot.rows[generation_inspected_row]
                    StudioDraw::text(x + 24.0, y + height - 100.0, 12.0, StudioGenerationReviewCopy::protection(row), StudioDraw::ink())
            StudioDraw::text(x + 24.0, y + height - 72.0, 11.0, StudioGenerationReviewCopy::moved_bytes_explanation(), StudioDraw::muted())
            for action in 0..<GenerationReviewLimit::CONTROLS |w, h, action|:
                control: StudioPanels::Box = generation_review_control_box(w, h, action)
                StudioDraw::rect(control.x, control.y, control.w, control.h, StudioDraw::color(47, 68, 92) if generation_review_focus == action else StudioDraw::color(38, 44, 56))
                StudioDraw::text(control.x + 12.0, control.y + 8.0, 12.0, "Previous" if action == 0 else "Next" if action == 1 else "Refresh" if action == 2 else "Back to Storage", StudioDraw::ink())
