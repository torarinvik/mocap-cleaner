# The studio's 2D panels, drawn immediate-mode with elisa-ui primitives:
# window layout, the toolbar with code-drawn vector icons, the timeline
# (problem markers, contact bars, operation scope, playhead), the curve view
# (source vs cleaned per-bone curves) and the operation stack panel. Hit
# tests return action codes the app dispatches; all pixel mapping goes
# through the proved Timeline and StudioView kernels.
#
# elisa-ui records at most UiCore::MAX_COMMANDS (1024) draw commands a
# frame, so curves and markers are binned to a fixed number of segments.
include "text.elisa"
include "scene.elisa"
include "../chrome.elisa"
include "../contact_editor.elisa"
include "../file_policy.elisa"
include "../replacement.elisa"
include "../legacy_session_prompt.elisa"
include "../accessibility.elisa"
include "../issues.elisa"
include "../issue_browser_policy.elisa"
include "../issue_filter_policy.elisa"
include "../reset_scope.elisa"
include "../operation_duplicate_policy.elisa"
include "../sidebar_layout.elisa"
include "../export_review.elisa"
include "../export_path_review.elisa"
include "../export_result.elisa"
include "../io/storage_manifest.elisa"
include "../../../build/generated/studio_icon_paths.elisa"

module StudioDraw:
    public:
        def color(r: u8, g: u8, b: u8) -> UiCore::Color:
            UiCore::rgb(r, g, b)

        def rect(x: f32, y: f32, w: f32, h: f32, c: UiCore::Color) -> void:
            UiCore::fill(UiCore::Rect(x, y, w, h), c)

        def segment(x1: f32, y1: f32, x2: f32, y2: f32, width: f32, c: UiCore::Color) -> void:
            UiCore::fill_stroke(UiCore::Line{from_point: UiCore::Vec2(x1, y1), to_point: UiCore::Vec2(x2, y2)}, width, c)

        def tri(ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, c: UiCore::Color) -> void:
            UiCore::fill(UiCore::Triangle{a: UiCore::Vec2(ax, ay), b: UiCore::Vec2(bx, by), c: UiCore::Vec2(cx, cy)}, c)

        def disc(x: f32, y: f32, r: f32, c: UiCore::Color) -> void:
            UiCore::fill(UiCore::Circle{center: UiCore::Vec2(x, y), radius: r}, c)

        # Octagon outline (enough for 16-24 px icons).
        def ring(x: f32, y: f32, r: f32, width: f32, c: UiCore::Color) -> void:
            d: f32 = r * 0.7071
            StudioDraw::segment(x + r, y, x + d, y + d, width, c)
            StudioDraw::segment(x + d, y + d, x, y + r, width, c)
            StudioDraw::segment(x, y + r, x - d, y + d, width, c)
            StudioDraw::segment(x - d, y + d, x - r, y, width, c)
            StudioDraw::segment(x - r, y, x - d, y - d, width, c)
            StudioDraw::segment(x - d, y - d, x, y - r, width, c)
            StudioDraw::segment(x, y - r, x + d, y - d, width, c)
            StudioDraw::segment(x + d, y - d, x + r, y, width, c)

        def text(x: f32, y: f32, size: f32, body: sview, c: UiCore::Color) -> void:
            UiCore::draw(UiCore::TextRun(UiCore::Vec2(x, y), size, body), c)

        def bold(x: f32, y: f32, size: f32, body: sview, c: UiCore::Color) -> void:
            UiCore::draw(UiCore::TextRun(UiCore::Vec2(x, y), size, body, true), c)

        def ink() -> UiCore::Color:
            color(226, 230, 238)

        def muted() -> UiCore::Color:
            color(140, 148, 166)

        def accent() -> UiCore::Color:
            color(255, 170, 40)

        def panel() -> UiCore::Color:
            color(30, 34, 44)

        def severity_color(level: i64) -> UiCore::Color:
            return color(250, 210, 60) if level == 1
            return color(250, 130, 40) if level == 2
            color(240, 50, 50)

# Toolbar and stack icons: Lucide (ISC, assets/icons/lucide) plus custom
# mocap icons (assets/icons/custom), 24px 2px-stroke SVGs flattened to line
# segments by tools/svg_icons.py into build/generated/studio_icon_paths.elisa.
# Codes are StudioIconPaths' codes; each icon fills an s x s box at (x, y).
module StudioIcons:
    public:
        const PLAY: i64 = StudioIconPaths::PLAY
        const PAUSE: i64 = StudioIconPaths::PAUSE
        const BACK: i64 = StudioIconPaths::BACK
        const FORWARD: i64 = StudioIconPaths::FORWARD
        const LOOP: i64 = StudioIconPaths::LOOP
        const UNDO: i64 = StudioIconPaths::UNDO
        const REDO: i64 = StudioIconPaths::REDO
        const TRAILS: i64 = StudioIconPaths::TRAILS
        const CONTACTS: i64 = StudioIconPaths::CONTACTS
        const HEAT: i64 = StudioIconPaths::HEAT
        const ONION: i64 = StudioIconPaths::ONION
        const GHOST: i64 = StudioIconPaths::GHOST
        const XRAY: i64 = StudioIconPaths::XRAY
        const MESH: i64 = StudioIconPaths::MESH
        const EXPORT: i64 = StudioIconPaths::EXPORT
        const FRAME: i64 = StudioIconPaths::FRAME
        const EYE: i64 = StudioIconPaths::EYE
        const EYE_OFF: i64 = StudioIconPaths::EYE_OFF
        const UP: i64 = StudioIconPaths::UP
        const DOWN: i64 = StudioIconPaths::DOWN
        const TRASH: i64 = StudioIconPaths::TRASH
        const PLUS: i64 = StudioIconPaths::PLUS
        const BALANCE: i64 = StudioIconPaths::BALANCE
        const CLEAN: i64 = StudioIconPaths::CLEAN
        const OPEN: i64 = StudioIconPaths::OPEN
        const SAVE: i64 = StudioIconPaths::SAVE
        const FOOT_FIX: i64 = StudioIconPaths::FOOT_FIX
        const PIVOT: i64 = StudioIconPaths::PIVOT
        const SPIKE: i64 = StudioIconPaths::SPIKE
        const RETIME: i64 = StudioIconPaths::RETIME

        # 2 SVG units of stroke, never thinner than 1.2 px.
        def draw(icon: i64, x: f32, y: f32, s: f32, c: UiCore::Color) -> void:
            w: f32 = s / 12.0
            StudioIconPaths::draw(icon, x, y, s, w if w > 1.2 else 1.2, c)

module StudioPanels:
    public:
        const SIDEBAR: f32 = 300.0
        const TOOLBAR: f32 = 44.0
        const TIMELINE: f32 = 116.0
        const CURVE: f32 = 150.0
        const STATUS: f32 = 24.0
        const GAP: f32 = 8.0
        const BUTTON: f32 = 32.0
        const BUTTONS: i64 = StudioAccessibility::TOOLBAR_ACTION_COUNT
        const ROW: f32 = StudioSidebarLayout::OPERATION_ROW_HEIGHT.f32()
        const ADD_KINDS: i64 = 5
        const CURVE_SEGMENTS: i64 = 40
        const MARKER_BINS: i64 = 120
        const FILE_MENU_ROW: f32 = 28.0
        const FILE_MENU_WIDTH: f32 = 190.0
        const RESET_MENU_WIDTH: f32 = 276.0
        const RESET_MENU_HEIGHT: f32 = 148.0
        const ISSUE_ROWS: i64 = StudioIssueBrowserPolicy::ROWS
        const ISSUE_FILTERED_ROWS: i64 = 1
        const ISSUE_PREVIOUS: i64 = StudioIssueBrowserPolicy::PREVIOUS
        const ISSUE_NEXT: i64 = StudioIssueBrowserPolicy::NEXT
        const ISSUE_WORST: i64 = StudioIssueBrowserPolicy::WORST
        const RESET_CLEAR_CONTACTS: i64 = StudioResetScope::CLEAR_CONTACTS
        const RESET_CLEAR_CORRECTIONS: i64 = StudioResetScope::CLEAR_CORRECTIONS
        const RESET_RESTORE_SOURCE: i64 = StudioResetScope::RESTORE_SOURCE
        const ISSUE_GROUP_ID: usize = StudioIssueBrowserPolicy::GROUP_ID
        const ISSUE_PREVIOUS_ID: usize = StudioIssueBrowserPolicy::PREVIOUS_ID
        const ISSUE_NEXT_ID: usize = StudioIssueBrowserPolicy::NEXT_ID
        const ISSUE_WORST_ID: usize = StudioIssueBrowserPolicy::WORST_ID
        const ISSUE_ROW_ID_FIRST: usize = StudioIssueBrowserPolicy::ROW_ID_FIRST

        # Filter controls return stable field actions for app-state wiring.
        const ISSUE_FILTER_DETECTOR: i64 = 0
        const ISSUE_FILTER_SUBJECT: i64 = 1
        const ISSUE_FILTER_SEVERITY: i64 = 2
        const ISSUE_FILTER_STATUS: i64 = 3
        const ISSUE_FILTER_RESET: i64 = 4
        const ISSUE_DISPOSITION_TOGGLE: i64 = 5
        const CONTACT_EDIT_FIRST: i64 = -2
        const CONTACT_EDIT_LAST: i64 = -3

        # Toolbar actions, in button order.
        const A_PLAY: i64 = 0
        const A_BACK: i64 = 1
        const A_FORWARD: i64 = 2
        const A_SPEED: i64 = 3
        const A_LOOP: i64 = 4
        const A_UNDO: i64 = 5
        const A_REDO: i64 = 6
        const A_TRAILS: i64 = 7
        const A_CONTACTS: i64 = 8
        const A_HEAT: i64 = 9
        const A_ONION: i64 = 10
        const A_GHOST: i64 = 11
        const A_XRAY: i64 = 12
        const A_MESH: i64 = 13
        const A_FRAME: i64 = 14
        const A_OPEN: i64 = 15
        const A_EXPORT: i64 = 16
        const A_BALANCE: i64 = 17
        const A_CLEAN: i64 = 18

        # Stack-panel hits: kind * 100 + row (kind 1 select, 2 toggle, 3 up,
        # 4 down, 5 remove), or 600 + k for "add kind k".
        const HIT_SELECT: i64 = 1
        const HIT_TOGGLE: i64 = 2
        const HIT_UP: i64 = 3
        const HIT_DOWN: i64 = 4
        const HIT_REMOVE: i64 = 5
        const HIT_ADD: i64 = 6
        const HIT_DUPLICATE: i64 = 7

        struct Box:
            x: f32
            y: f32
            w: f32
            h: f32

        def box(x: f32, y: f32, w: f32, h: f32) -> Box:
            Box{x: x, y: y, w: w if w > 1.0 else 1.0, h: h if h > 1.0 else 1.0}

        def inside(b: Box, px: f32, py: f32) -> bool:
            return StudioView::inside(px.i64(), py.i64(), b.x.i64(), b.y.i64(), b.w.i64(), b.h.i64())

        # Window layout for a `w` x `h` point window.
        def main_width(w: f32) -> f32:
            v: f32 = w - SIDEBAR - 2.0 * GAP
            v if v > 200.0 else 200.0

        def views_height(h: f32) -> f32:
            v: f32 = h - TOOLBAR - CURVE - TIMELINE - STATUS - 3.0 * GAP
            v if v > 160.0 else 160.0

        def view_box(index: usize, w: f32, h: f32) -> Box:
            mw: f32 = main_width(w)
            vh: f32 = views_height(h)
            top: f32 = vh * 0.6
            return box(GAP, TOOLBAR, mw, top - GAP * 0.5) if index == 0
            half: f32 = (mw - GAP) * 0.5
            return box(GAP, TOOLBAR + top + GAP * 0.5, half, vh - top - GAP * 0.5) if index == 1
            box(GAP + half + GAP, TOOLBAR + top + GAP * 0.5, half, vh - top - GAP * 0.5)

        def curve_box(w: f32, h: f32) -> Box:
            box(GAP, TOOLBAR + views_height(h) + GAP, main_width(w), CURVE)

        def timeline_box(w: f32, h: f32) -> Box:
            box(GAP, TOOLBAR + views_height(h) + CURVE + 2.0 * GAP, main_width(w), TIMELINE)

        def status_box(w: f32, h: f32) -> Box:
            box(0.0, h - STATUS, w - SIDEBAR, STATUS)

        def sidebar_box(w: f32, h: f32) -> Box:
            box(w - SIDEBAR, 0.0, SIDEBAR, h)

        # Inner strip of the timeline the frames map onto.
        def strip(t: Box) -> Box:
            box(t.x + 12.0, t.y, t.w - 196.0, t.h)

        def button_x(i: i64) -> f32:
            groups: i64 = (1 if i >= A_UNDO else 0) + (1 if i >= A_TRAILS else 0) + (1 if i >= A_FRAME else 0) + (1 if i >= A_CLEAN else 0)
            GAP + i.f32() * (BUTTON + 4.0) + groups.f32() * 14.0

        def button_box(i: i64) -> Box:
            box(button_x(i), 6.0, BUTTON, BUTTON)

        def toolbar_hit(px: f32, py: f32) -> i64:
            for i in 0..<BUTTONS |i, px, py|:
                return i if inside(button_box(i), px, py)
            return -1

        def icon_of(action: i64, playing: bool) -> i64:
            return (StudioIcons::PAUSE if playing else StudioIcons::PLAY) if action == A_PLAY
            return StudioIcons::BACK if action == A_BACK
            return StudioIcons::FORWARD if action == A_FORWARD
            return StudioIcons::LOOP if action == A_LOOP
            return StudioIcons::UNDO if action == A_UNDO
            return StudioIcons::REDO if action == A_REDO
            return StudioIcons::TRAILS if action == A_TRAILS
            return StudioIcons::CONTACTS if action == A_CONTACTS
            return StudioIcons::HEAT if action == A_HEAT
            return StudioIcons::ONION if action == A_ONION
            return StudioIcons::GHOST if action == A_GHOST
            return StudioIcons::XRAY if action == A_XRAY
            return StudioIcons::MESH if action == A_MESH
            return StudioIcons::FRAME if action == A_FRAME
            return StudioIcons::OPEN if action == A_OPEN
            return StudioIcons::EXPORT if action == A_EXPORT
            return StudioIcons::BALANCE if action == A_BALANCE
            return StudioIcons::CLEAN if action == A_CLEAN
            -1

        # Tooltip of a toolbar button: what it does, then its shortcut.
        def tip_of(action: i64) -> sview:
            return "Play / pause  (Space)" if action == A_PLAY
            return "Previous frame  (Left)" if action == A_BACK
            return "Next frame  (Right)" if action == A_FORWARD
            return "Playback speed  (S)" if action == A_SPEED
            return "Loop playback  (L)" if action == A_LOOP
            return "Undo  (Cmd-Z)" if action == A_UNDO
            return "Redo  (Cmd-Shift-Z)" if action == A_REDO
            return "Motion trails  (T)" if action == A_TRAILS
            return "Foot contacts  (C)" if action == A_CONTACTS
            return "Problem heat map  (H)" if action == A_HEAT
            return "Onion skin  (N)" if action == A_ONION
            return "Source ghost  (G)" if action == A_GHOST
            return "X-ray skeleton  (X)" if action == A_XRAY
            return "Skinned mesh  (M)" if action == A_MESH
            return "Frame the character  (F)" if action == A_FRAME
            return "Open a take  (Cmd-O)" if action == A_OPEN
            return "Export cleaned GLB  (E)" if action == A_EXPORT
            return "Balance overlay  (Q)" if action == A_BALANCE
            return "Fix all with boxing preset  (A)" if action == A_CLEAN
            ""

        def tooltip(action: i64) -> void:
            return if action < 0 or action >= BUTTONS
            b: Box = button_box(action)
            text: sview = tip_of(action)
            width: f32 = text.len.f32() * 6.6 + 16.0
            StudioDraw::rect(b.x, b.y + b.h + 4.0, width, 22.0, StudioDraw::color(240, 236, 220))
            StudioDraw::text(b.x + 8.0, b.y + b.h + 8.0, 12.0, text, StudioDraw::color(20, 22, 28))

        # Shortcut sheet ("?"): every binding, grouped.
        const HELP_LINES: i64 = 30
        def help_line(i: i64) -> sview:
            return "PLAYBACK" if i == 0
            return "Space  play / pause       Left / Right  step a frame" if i == 1
            return "S  speed (1, 1/2, 1/4)    L  loop" if i == 2
            return "EDITING" if i == 3
            return "A  Fix all with the boxing preset (undoable)" if i == 4
            return "1-5  add despike / smooth / median / limit joint rotation (wring) / seam" if i == 5
            return "Up / Down  select operation    D  enable / disable" if i == 6
            return "[ / ]  strength    B  bones    I / O  scope in / out at playhead" if i == 7
            return "PgUp / PgDn  move operation    Delete  remove" if i == 8
            return "K feet  J hands    , / . blend    W worst foot slide" if i == 9
            return "Contacts: select; Shift-P plant, Shift-L lift, Shift-U reset" if i == 10
            return "R / V  rotate / translate gizmo (drag to key a correction)" if i == 11
            return "Cmd-Z  undo    Cmd-Shift-Z (or Y)  redo" if i == 12
            return "FILE" if i == 13
            return "Cmd-S  save session    Cmd-Shift-S  save as    Cmd-Shift-O  open session" if i == 14
            return "Cmd-O  open take    E  export    Cmd-E  export as" if i == 15
            return "VIEW" if i == 16
            return "F  frame character    Shift-F  frame times    P  position / rotation curves" if i == 17
            return "T trails  C contacts  H heat  N onion  G ghost  X x-ray  M mesh  Shift-M model  Q balance" if i == 18
            return "Drag a view to orbit, right-drag to pan, scroll to zoom, click a bone to select" if i == 19
            return "Retime: Shift-drag the timeline, Shift-1..7 preset, = type a speed" if i == 20
            return "Escape cancels one thing at a time: this sheet, a drag, a contact" if i == 21
            return "press, the gizmo, then the selection." if i == 22
            return "Drag a speed band edge to move it, Delete removes the band" if i == 23
            return "?  show / hide this sheet" if i == 24
            return "Contact interval: Shift+Left/Right move; Shift+[/] first; Shift+Up/Down last" if i == 25
            return "Click First/Last, type a 1-based frame, Enter applies; Escape cancels" if i == 26
            return "Reset… clears contacts, local corrections, or restores source result" if i == 27
            return "Restore removes cleanup and retiming; each reset is one Cmd-Z step" if i == 28
            return "Cmd-D  duplicate the selected operation after itself" if i == 29
            ""

        def help_sheet(w: f32, h: f32) -> void:
            sw: f32 = 620.0
            sh: f32 = 60.0 + HELP_LINES.f32() * 19.0
            x: f32 = (w - sw) * 0.5
            y: f32 = (h - sh) * 0.5
            StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
            StudioDraw::rect(x, y, sw, sh, StudioDraw::color(30, 33, 41))
            StudioDraw::bold(x + 24.0, y + 18.0, 16.0, "Keyboard shortcuts", StudioDraw::ink())
            for i in 0..<HELP_LINES |i, x, y|:
                line: sview = help_line(i)
                heading: bool = i == 0 or i == 3 or i == 13 or i == 16
                if heading:
                    StudioDraw::bold(x + 24.0, y + 52.0 + i.f32() * 19.0, 11.0, line, StudioDraw::accent())
                else:
                    StudioDraw::text(x + 24.0, y + 52.0 + i.f32() * 19.0, 12.0, line, StudioDraw::ink())

        # First-run guide or load failure, drawn over the empty views.
        def guide(w: f32, h: f32, screen: i64) -> void:
            b: Box = view_box(0, w, h)
            x: f32 = b.x + 40.0
            y: f32 = b.y + 40.0
            if screen == StudioChrome::SCREEN_FAILED:
                StudioDraw::bold(x, y, 18.0, "Could not open the take", StudioDraw::severity_color(2))
                StudioDraw::text(x, y + 30.0, 13.0, "Check the GLB and animation name, then try opening another take.", StudioDraw::ink())
                StudioDraw::text(x, y + 52.0, 13.0, "Use the folder button, press Cmd-O, or drop a GLB here.", StudioDraw::muted())
            else:
                StudioDraw::bold(x, y, 18.0, "Open a take to start", StudioDraw::ink())
                StudioDraw::text(x, y + 30.0, 13.0, "Click the folder button, press Cmd-O, or drop a GLB here.", StudioDraw::ink())
            StudioDraw::text(x, y + 84.0, 13.0, "You can also start with: build/mocap_studio <take.glb> [animation]", StudioDraw::ink())
            StudioDraw::text(x, y + 106.0, 13.0, "A applies the boxing preset. Press ? for shortcuts and help.", StudioDraw::muted())

        # Status bar: frame, clip time, rate, selection and the last message.
        def status_bar(sb: Box, frame: i64, count: i64, rate: i64, selected: i64, slide: i64, spikes: i64, dirty: bool, message: sview) -> void:
            StudioDraw::rect(sb.x, sb.y, sb.w, sb.h, StudioDraw::color(24, 27, 34))
            StudioDraw::text(sb.x + 560.0, sb.y + 5.0, 12.0, message, StudioDraw::accent())
            StudioText::begin()
            StudioText::put("Frame ")
            StudioText::put_i(StudioChrome::shown_frame(frame, count) if frame >= 0 and frame < count and count >= 1 and count <= StudioChrome::CHROME_FRAMES else 0)
            StudioText::put(" / ")
            StudioText::put_i(count)
            StudioText::put("   ")
            StudioText::put_fixed3(StudioChrome::clip_millis(frame, rate) * 1000 if frame >= 0 and frame <= StudioChrome::CHROME_FRAMES and rate >= 1 and rate <= StudioChrome::CHROME_RATE_MAX else 0)
            StudioText::put(" s   ")
            StudioText::put_i(rate)
            StudioText::put(" fps   ")
            if selected >= 0:
                StudioText::put("operation ")
                StudioText::put_i(selected + 1)
            else:
                StudioText::put("no selection")
            if dirty:
                StudioText::put("   * Unsaved changes")
            if slide >= 0:
                StudioText::put("   clean: slide -")
                StudioText::put_i(slide / 10)
                StudioText::put("%, spikes -")
                StudioText::put_i(spikes / 10)
                StudioText::put("%")
            StudioDraw::text(sb.x + 12.0, sb.y + 5.0, 12.0, StudioText::view(), StudioDraw::ink())

        # Whether a toggle button is lit.
        def lit(action: i64, flags: i64, t: TimelineState::State&) -> bool:
            return t.looping if action == A_LOOP
            return StudioScene::on(flags, StudioScene::TRAILS) if action == A_TRAILS
            return StudioScene::on(flags, StudioScene::CONTACTS) if action == A_CONTACTS
            return StudioScene::on(flags, StudioScene::HEAT) if action == A_HEAT
            return StudioScene::on(flags, StudioScene::ONION) if action == A_ONION
            return StudioScene::on(flags, StudioScene::GHOST) if action == A_GHOST
            return StudioScene::on(flags, StudioScene::XRAY) if action == A_XRAY
            return StudioScene::on(flags, StudioScene::MESH) if action == A_MESH
            return StudioScene::on(flags, StudioScene::BALANCE) if action == A_BALANCE
            false

        def toolbar(t: TimelineState::State&, flags: i64, can_undo: bool, can_redo: bool) -> void:
            for i in 0..<BUTTONS |i, t, flags, can_undo, can_redo|:
                b: Box = button_box(i)
                on: bool = lit(i, flags, t)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(70, 60, 40) if on else StudioDraw::panel())
                dim: bool = (i == A_UNDO and not can_undo) or (i == A_REDO and not can_redo)
                c: UiCore::Color = StudioDraw::accent() if on else (StudioDraw::color(80, 86, 100) if dim else StudioDraw::ink())
                if i == A_SPEED:
                    StudioDraw::text(b.x + 3.0, b.y + 9.0, 12.0, TimelineState::speed_label(t.divisor), c)
                elif i == A_CLEAN:
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(52, 72, 60))
                    StudioIcons::draw(StudioIcons::CLEAN, b.x + 6.0, b.y + 6.0, 20.0, StudioDraw::ink())
                else:
                    StudioIcons::draw(icon_of(i, t.playing), b.x + 6.0, b.y + 6.0, 20.0, c)

        # Left edge of `frame`; frames at or past the end map to the strip's
        # right edge (x_of_frame requires 0 <= frame < count).
        def frame_x(s: Box, frame: i64, count: i64) -> f32:
            return s.x if frame <= 0 or count < 1
            return s.x + s.w if frame >= count
            return s.x + Timeline::x_of_frame(frame, s.w.i64(), count).f32()

        # Timeline: frame ruler, cleaned problem markers (source markers
        # faint above), left/right foot contact bars, the selected
        # operation's scope and the playhead.
        def timeline(tb: Box, c: StudioModel::Clip&, t: TimelineState::State&, scope_first: i64, scope_last: i64) -> void:
            StudioDraw::rect(tb.x, tb.y, tb.w, tb.h, StudioDraw::panel())
            s: Box = strip(tb)
            n: i64 = c.frames
            return if n < 1
            if scope_first >= 0:
                x0: f32 = frame_x(s, scope_first, n)
                x1: f32 = frame_x(s, scope_last, n)
                StudioDraw::rect(x0, s.y + 2.0, (x1 - x0) + 2.0, s.h - 4.0, StudioDraw::color(52, 58, 80))
            # Ruler every second (c.rate frames).
            r: i64 = c.rate if c.rate >= 1 else Timeline::RATE
            for k in 0..<(n / r + 1) |k, s, n, r|:
                x: f32 = frame_x(s, k * r, n)
                StudioDraw::segment(x, s.y + 2.0, x, s.y + 10.0, 1.0, StudioDraw::muted())
            bins: i64 = MARKER_BINS if n > MARKER_BINS else n
            for b in 0..<bins |b, bins, n, s, c|:
                first: i64 = b * n / bins
                last: i64 = (b + 1) * n / bins
                mutable worst: i64 = 0
                mutable raw: i64 = 0
                for f in first..<last |f, c, worst, raw|:
                    if c.problems[f.usize()] > 0:
                        peak: i64 = c.peaks[f.usize()]
                        accel: i64 = 0 if peak < 0 else (StudioView::MAX_VALUE if peak > StudioView::MAX_VALUE else peak)
                        level: i64 = StudioView::severity(accel, c.threshold) if c.threshold >= 1 and c.threshold <= StudioView::MAX_VALUE else 3
                        worst <- level if level > worst else worst
                        worst <- 1 if worst < 1 else worst
                    raw <- raw + c.source_problems[f.usize()]
                x0: f32 = frame_x(s, first, n)
                x1: f32 = frame_x(s, last, n)
                wide: f32 = x1 - x0 if x1 - x0 > 2.0 else 2.0
                if raw > 0:
                    StudioDraw::rect(x0, s.y + 14.0, wide, 6.0, StudioDraw::color(90, 70, 80))
                if worst > 0:
                    StudioDraw::rect(x0, s.y + 22.0, wide, 16.0, StudioDraw::severity_color(worst))
            balance_bar(s, c, s.y + 40.0)
            contact_bar(s, c.left_contact, s.y + 46.0, StudioDraw::color(110, 220, 130))
            contact_bar(s, c.right_contact, s.y + 58.0, StudioDraw::color(240, 220, 90))
            contact_bar(s, c.left_hand_contact, s.y + 70.0, StudioDraw::color(100, 190, 255))
            contact_bar(s, c.right_hand_contact, s.y + 82.0, StudioDraw::color(255, 150, 100))
            px: f32 = frame_x(s, t.frame, n)
            StudioDraw::segment(px, tb.y, px, tb.y + tb.h, 2.0, StudioDraw::accent())
            StudioDraw::text(tb.x + 12.0, tb.y + tb.h - 20.0, 12.0, StudioText::pair("frame ", t.frame, " / ", n - 1), StudioDraw::ink())
            StudioDraw::text(tb.x + 150.0, tb.y + tb.h - 20.0, 12.0, "L foot", StudioDraw::color(110, 220, 130))
            StudioDraw::text(tb.x + 200.0, tb.y + tb.h - 20.0, 12.0, "R foot", StudioDraw::color(240, 220, 90))
            StudioDraw::text(tb.x + 250.0, tb.y + tb.h - 20.0, 12.0, "L hand", StudioDraw::color(100, 190, 255))
            StudioDraw::text(tb.x + 300.0, tb.y + tb.h - 20.0, 12.0, "R hand", StudioDraw::color(255, 150, 100))

        # Frames the balance detector reports as impossible, binned like the
        # problem markers (a bin shows the worst state of its frames).
        def balance_bar(s: Box, c: StudioModel::Clip&, y: f32) -> void:
            n: i64 = c.balance.count.i64()
            return if n < 1
            bins: i64 = MARKER_BINS if n > MARKER_BINS else n
            for b in 0..<bins |b, bins, n, s, c, y|:
                first: i64 = b * n / bins
                last: i64 = (b + 1) * n / bins
                mutable level: i64 = StudioOverlay::AIRBORNE
                for f in first..<last |f, c, level|:
                    v: i64 = c.balance[f.usize()]
                    level <- StudioOverlay::worst(level, v) if v >= StudioOverlay::AIRBORNE and v <= StudioOverlay::IMPOSSIBLE else level
                if StudioOverlay::marked(level):
                    x0: f32 = frame_x(s, first, n)
                    x1: f32 = frame_x(s, last, n)
                    StudioDraw::rect(x0, y, x1 - x0 if x1 - x0 > 2.0 else 2.0, 5.0, StudioDraw::color(240, 50, 50))

        # Runs of planted frames as bars.
        def contact_bar(s: Box, flags: darray[bool]&, y: f32, col: UiCore::Color) -> void:
            n: i64 = flags.count.i64()
            mutable run: i64 = -1
            for f in 0..<(n + 1) |f, n, flags, run, s, y, col|:
                down: bool = f < n and flags[f.usize()]
                if down and run < 0:
                    run <- f
                if not down and run >= 0:
                    x0: f32 = frame_x(s, run, n)
                    x1: f32 = frame_x(s, f, n)
                    StudioDraw::rect(x0, y, (x1 - x0) if x1 - x0 > 1.0 else 1.0, 8.0, col)
                    run <- -1

        # Frame under x in the timeline strip.
        def timeline_frame(tb: Box, px: f32, count: i64) -> i64:
            s: Box = strip(tb)
            return Timeline::frame_at_x((px - s.x).i64(), s.w.i64(), count)

        def series_color(k: usize) -> UiCore::Color:
            return StudioDraw::color(240, 90, 90) if k == 0
            return StudioDraw::color(110, 220, 120) if k == 1
            return StudioDraw::color(90, 160, 255) if k == 2
            StudioDraw::color(220, 220, 220)

        # Curve view: every component of the selected bone's channel,
        # source dim and cleaned bright, on one shared value range.
        # The curve view draws from the per-(bone, mode) memo, refilled only
        # when the clip is rebuilt (`built`) or the selection changes.
        def curves(cb: Box, c: StudioModel::Clip&, bone: i64, frame: i64, mode: i64, memo: mutable StudioPerf::Curves&, built: i64) -> void:
            StudioDraw::rect(cb.x, cb.y, cb.w, cb.h, StudioDraw::panel())
            ch: i64 = StudioModel::curve_channel_in(c, bone, mode)
            if ch < 0:
                StudioDraw::text(cb.x + 10.0, cb.y + 4.0, 12.0, "no animated channel on this bone", StudioDraw::muted())
                StudioDraw::text(cb.x + 10.0, cb.y + 23.0, 11.0, StudioText::number("bone slot ", bone), StudioDraw::muted())
                return
            if not StudioPerf::curves_hit(memo, built, bone, mode) or memo.channel != ch:
                StudioPerf::fill_curves(memo, c.source, c.cleaned, c.anim, ch, built, bone, mode, StudioView::MAX_VALUE)
            mutable lo: i64 = memo.lo
            mutable hi: i64 = memo.hi
            lo <- (0 - StudioView::MAX_VALUE) if lo < 0 - StudioView::MAX_VALUE else lo
            hi <- StudioView::MAX_VALUE if hi > StudioView::MAX_VALUE else hi
            lo <- StudioView::MAX_VALUE - 1 if lo >= StudioView::MAX_VALUE else lo
            hi <- lo + 1 if hi <= lo else hi
            inner: Box = box(cb.x + 12.0, cb.y + 42.0, cb.w - 24.0, cb.h - 50.0)
            for k in 0..<memo.comps |k, memo, lo, hi, inner|:
                a: darray[i64] = StudioPerf::series(&memo.source, k, memo.length)
                b: darray[i64] = StudioPerf::series(&memo.cleaned, k, memo.length)
                col: UiCore::Color = series_color(k.usize())
                polyline(inner, a, lo, hi, UiCore::rgba(col.r, col.g, col.b, 90), 1.0)
                polyline(inner, b, lo, hi, col, 1.6)
            n: i64 = c.frames if c.frames > 0 else 1
            px: f32 = inner.x + Timeline::x_of_frame(frame, inner.w.i64(), n).f32()
            StudioDraw::segment(px, inner.y, px, inner.y + inner.h, 1.5, StudioDraw::accent())
            label: sview = "Position curves · source dim / result bright" if StudioModel::is_position(c, ch) else "Rotation curves · source dim / result bright"
            StudioDraw::text(cb.x + 10.0, cb.y + 4.0, 12.0, label, StudioDraw::muted())
            StudioDraw::text(cb.x + 10.0, cb.y + 23.0, 11.0, StudioText::number("bone slot ", bone), StudioDraw::ink())

        def polyline(inner: Box, v: darray[i64]&, lo: i64, hi: i64, col: UiCore::Color, width: f32) -> void:
            n: i64 = v.count.i64()
            return if n < 2
            segs: i64 = CURVE_SEGMENTS if n - 1 > CURVE_SEGMENTS else n - 1
            top: i64 = inner.y.i64()
            height: i64 = inner.h.i64()
            for s in 0..<segs |s, segs, n, v, lo, hi, inner, col, width, top, height|:
                f0: i64 = s * (n - 1) / segs
                f1: i64 = (s + 1) * (n - 1) / segs
                x0: f32 = inner.x + Timeline::x_of_frame(f0, inner.w.i64(), n).f32()
                x1: f32 = inner.x + Timeline::x_of_frame(f1, inner.w.i64(), n).f32()
                y0: f32 = StudioView::value_y(v[f0.usize()], lo, hi, top, height).f32()
                y1: f32 = StudioView::value_y(v[f1.usize()], lo, hi, top, height).f32()
                StudioDraw::segment(x0, y0, x1, y1, width, col)

        # Stack panel geometry.
        def add_box(sb: Box, k: i64) -> Box:
            w: f32 = (sb.w - 24.0) / 3.0
            col: i64 = k % 3
            row: i64 = k / 3
            box(sb.x + 12.0 + col.f32() * w, sb.y + StudioSidebarLayout::ADD_TOP.f32() + row.f32() * StudioSidebarLayout::ADD_ROW_STEP.f32(), w - 4.0, StudioSidebarLayout::ADD_ROW_HEIGHT.f32())

        def duplicate_button_box(sb: Box) -> Box:
            box(sb.x + 132.0, sb.y + StudioSidebarLayout::STACK_HEADING_TOP.f32() - 2.0, 76.0, 23.0)

        def row_box(sb: Box, i: i64) -> Box:
            box(sb.x + 8.0, sb.y + StudioSidebarLayout::OPERATION_ROW_TOP.f32() + i.f32() * StudioSidebarLayout::OPERATION_ROW_STEP.f32(), sb.w - 16.0, ROW)

        def reset_menu_button_box(sb: Box) -> Box:
            box(sb.x + sb.w - 88.0, sb.y + StudioSidebarLayout::STACK_HEADING_TOP.f32() - 2.0, 76.0, 23.0)

        def reset_menu_box(sb: Box) -> Box:
            box(sb.x + 12.0, sb.y + StudioSidebarLayout::STACK_HEADING_BOTTOM.f32() + 4.0, RESET_MENU_WIDTH, RESET_MENU_HEIGHT)

        def reset_menu_item_box(sb: Box, slot: i64) -> Box:
            box(reset_menu_box(sb).x + 6.0, reset_menu_box(sb).y + 25.0 + slot.f32() * 32.0, RESET_MENU_WIDTH - 12.0, 30.0)

        def reset_menu_contains(sb: Box, px: f32, py: f32) -> bool:
            inside(reset_menu_box(sb), px, py)

        def reset_menu_hit(sb: Box, s: StackState::Stack&, px: f32, py: f32) -> i64:
            return RESET_CLEAR_CONTACTS if inside(reset_menu_item_box(sb, 0), px, py) and StudioResetScope::enabled(RESET_CLEAR_CONTACTS, false, s.edit_count, s.fix_count, StackState::has_cleanup(s))
            return RESET_CLEAR_CORRECTIONS if inside(reset_menu_item_box(sb, 1), px, py) and StudioResetScope::enabled(RESET_CLEAR_CORRECTIONS, false, s.edit_count, s.fix_count, StackState::has_cleanup(s))
            return RESET_RESTORE_SOURCE if inside(reset_menu_item_box(sb, 2), px, py) and StudioResetScope::enabled(RESET_RESTORE_SOURCE, false, s.edit_count, s.fix_count, StackState::has_cleanup(s))
            -1

        def reset_menu_panel(sb: Box, s: StackState::Stack&, open: bool) -> void:
            trigger: Box = reset_menu_button_box(sb)
            StudioDraw::rect(trigger.x, trigger.y, trigger.w, trigger.h, StudioDraw::color(61, 52, 38) if open else StudioDraw::panel())
            StudioDraw::text(trigger.x + 8.0, trigger.y + 5.0, 10.0, "Reset…", StudioDraw::ink())
            return if not open
            menu: Box = reset_menu_box(sb)
            StudioDraw::rect(menu.x, menu.y, menu.w, menu.h, StudioDraw::color(18, 21, 28))
            StudioDraw::bold(menu.x + 8.0, menu.y + 6.0, 11.0, "Choose reset scope", StudioDraw::ink())
            for slot in 0..<3 |slot, sb, s, menu|:
                item: Box = reset_menu_item_box(sb, slot)
                action: i64 = StudioResetScope::CLEAR_CONTACTS + slot
                enabled: bool = StudioResetScope::enabled(action, false, s.edit_count, s.fix_count, StackState::has_cleanup(s))
                broad: bool = action == RESET_RESTORE_SOURCE
                col: UiCore::Color = StudioDraw::color(57, 47, 35) if broad and enabled else StudioDraw::color(42, 47, 58) if enabled else StudioDraw::color(31, 34, 41)
                StudioDraw::rect(item.x, item.y, item.w, item.h, col)
                label: sview = "Clear contact overrides" if slot == 0 else "Clear local corrections" if slot == 1 else "Restore source result"
                StudioDraw::text(item.x + 7.0, item.y + 3.0, 10.0, label, StudioDraw::ink() if enabled else StudioDraw::muted())
                detail: sview = "Return frames to automatic detection" if slot == 0 else "Keep operations and contact edits" if slot == 1 else "Remove operations, corrections, contacts, locks and retiming"
                StudioDraw::text(item.x + 7.0, item.y + 17.0, 8.0, detail, StudioDraw::muted())
            StudioDraw::text(menu.x + 8.0, menu.y + 127.0, 8.0, "Esc closes · row trash removes one operation", StudioDraw::muted())

        # Ranked issue browser occupies the sidebar above cleanup controls.
        # The filter, navigation and finding rows have separate hit regions;
        # navigation stays available when the ranked list is longer.
        def issue_nav_box(sb: Box, action: i64) -> Box:
            box(sb.x + 12.0 + action.f32() * 89.0, sb.y + StudioSidebarLayout::ISSUE_NAV_TOP.f32(), 82.0, 20.0)

        def issue_area_box(sb: Box) -> Box:
            box(sb.x + 6.0, sb.y + StudioSidebarLayout::ISSUE_TOP.f32(), sb.w - 12.0, StudioSidebarLayout::ISSUE_HEIGHT.f32())

        def issue_row_id(index: i64) -> usize:
            StudioIssueBrowserPolicy::row_id(index)

        def issue_node_parent(id: usize) -> usize:
            StudioIssueBrowserPolicy::node_parent(id, StudioAccessibility::SIDEBAR, StudioAccessibility::NO_NODE)

        def issue_node_first_child() -> usize:
            StudioIssueBrowserPolicy::node_first_child()

        def issue_node_next_sibling(id: usize, visible_rows: i64) -> usize:
            StudioIssueBrowserPolicy::node_next_sibling(id, visible_rows, StudioAccessibility::NO_NODE)

        def issue_window_start(selected: i64, count: i64) -> i64:
            StudioIssueBrowserPolicy::window_start(selected, count)

        def issue_row_box(sb: Box, index: i64) -> Box:
            box(sb.x + 8.0, sb.y + StudioSidebarLayout::ISSUE_ROW_TOP.f32() + index.f32() * StudioSidebarLayout::ISSUE_ROW_STEP.f32(), sb.w - 16.0, StudioSidebarLayout::ISSUE_ROW_HEIGHT.f32())

        # Four compact filter chips use equal widths so the sidebar remains
        # usable at its minimum supported width. Reset is shown only while an
        # active filter is present; the return action is still stable either way.
        def issue_filter_box(sb: Box, field: i64) -> Box:
            chip_w: f32 = (sb.w - 24.0) / 4.0
            return box(sb.x + 8.0 + field.f32() * chip_w, sb.y + StudioSidebarLayout::ISSUE_FILTER_TOP.f32(), chip_w - 3.0, 19.0) if field >= 0 and field < 4
            box(sb.x + sb.w - 58.0, sb.y + StudioSidebarLayout::ISSUE_HEADING_TOP.f32(), 48.0, 20.0)

        def issue_filter_hit(sb: Box, px: f32, py: f32) -> i64:
            if inside(issue_filter_box(sb, ISSUE_FILTER_RESET), px, py):
                return ISSUE_FILTER_RESET
            for field in 0..<4 |field, sb, px, py|:
                return field if inside(issue_filter_box(sb, field), px, py)
            -1

        def issue_filter_action(field: i64) -> i64:
            field if field >= ISSUE_FILTER_DETECTOR and field <= ISSUE_FILTER_RESET else -1

        def issue_disposition_box(sb: Box) -> Box:
            box(sb.x + 8.0, sb.y + 294.0, sb.w - 16.0, 15.0)

        def issue_disposition_hit(sb: Box, px: f32, py: f32, selection_valid: bool) -> i64:
            return ISSUE_DISPOSITION_TOGGLE if selection_valid and inside(issue_disposition_box(sb), px, py) else -1

        def issue_disposition_action(selection_valid: bool) -> i64:
            ISSUE_DISPOSITION_TOGGLE if selection_valid else -1

        def issue_disposition_label(ignored: bool) -> sview:
            "Restore finding" if ignored else "Ignore as intentional"

        def issue_disposition_control(sb: Box, selection_valid: bool, ignored: bool) -> void:
            b: Box = issue_disposition_box(sb)
            StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(48, 54, 66) if selection_valid else StudioDraw::color(36, 39, 46))
            StudioDraw::text(b.x + 5.0, b.y + 3.0, 8.0, issue_disposition_label(ignored), StudioDraw::ink() if selection_valid else StudioDraw::muted())

        def issue_filter_active(f: StudioIssueFilterPolicy::Filter) -> bool:
            f.detector != StudioIssueFilterPolicy::ANY_DETECTOR or f.subject != StudioIssueFilterPolicy::ANY_SUBJECT or f.minimum_severity > 0 or f.status != StudioIssueFilterPolicy::ANY_STATUS

        def issue_filter_controls(sb: Box, f: StudioIssueFilterPolicy::Filter) -> void:
            # Chips identify both the filter and its current value. Clicking
            # each chip advances that field's choice in the application.
            for field in 0..<4 |field, sb, f|:
                b: Box = issue_filter_box(sb, field)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(48, 54, 66))
                StudioText::begin()
                if field == ISSUE_FILTER_DETECTOR:
                    StudioText::put("Detector ")
                    if f.detector == StudioIssueFilterPolicy::ANY_DETECTOR:
                        StudioText::put("All")
                    elif f.detector == 0:
                        StudioText::put("Spike")
                    else:
                        StudioText::put_i(f.detector)
                elif field == ISSUE_FILTER_SUBJECT:
                    StudioText::put("Subject ")
                    if f.subject == StudioIssueFilterPolicy::ANY_SUBJECT:
                        StudioText::put("All")
                    elif f.subject == -1:
                        StudioText::put("Aggregate")
                    else:
                        StudioText::put_i(f.subject)
                elif field == ISSUE_FILTER_SEVERITY:
                    StudioText::put("Sev≥")
                    StudioText::put_i(f.minimum_severity)
                    StudioText::put("‰")
                else:
                    StudioText::put("Status ")
                    if f.status == StudioIssueFilterPolicy::ANY_STATUS:
                        StudioText::put("All")
                    elif f.status == StudioIssueFilterPolicy::UNRESOLVED:
                        StudioText::put("Open")
                    else:
                        StudioText::put("Ignored")
                label: sview = StudioText::view()
                StudioDraw::text(b.x + 3.0, b.y + 5.0, 8.0, label, StudioDraw::ink())
            reset: Box = issue_filter_box(sb, ISSUE_FILTER_RESET)
            active: bool = issue_filter_active(f)
            StudioDraw::rect(reset.x, reset.y, reset.w, reset.h,
                StudioDraw::color(74, 52, 38) if active else StudioDraw::panel())
            StudioDraw::text(reset.x + 5.0, reset.y + 5.0, 9.0,
                "Reset" if active else "Default", StudioDraw::ink() if active else StudioDraw::muted())

        def issue_nav_hit(sb: Box, px: f32, py: f32) -> i64:
            for action in 0..<3 |action, sb, px, py|:
                return action if inside(issue_nav_box(sb, action), px, py)
            -1

        def issue_row_hit(sb: Box, count: i64, px: f32, py: f32) -> i64:
            visible: i64 = count if count < ISSUE_FILTERED_ROWS else ISSUE_FILTERED_ROWS
            for index in 0..<visible |index, sb, px, py|:
                return index if inside(issue_row_box(sb, index), px, py)
            -1

        def issue_at(issues: darray[StudioIssues::Issue]&, index: i64) -> StudioIssues::Issue:
            mutable current: i64 = 0
            for issue in issues |current|:
                if current == index:
                    return issue
                current <- current + 1
            zeroed

        def issue_navigation_target(current: i64, count: i64, action: i64) -> i64:
            requires current >= 0
            requires count > 0 and count <= StudioIssueBrowserPolicy::MAX_FINDINGS
            requires current < count
            requires action >= ISSUE_PREVIOUS and action <= ISSUE_WORST
            StudioIssueBrowserPolicy::navigation_target(current, count, action)

        def issue_row_route_enabled(index: i64, visible_rows: i64, fresh: bool) -> bool:
            StudioIssueBrowserPolicy::row_route_enabled(index, visible_rows, fresh)

        def issue_row_text(issue: StudioIssues::Issue) -> sview can Unsafe.PointerCast:
            StudioText::begin()
            if issue.issue_type == 0:
                StudioText::put("Spike")
            else:
                StudioText::put("detector ")
                StudioText::put_i(issue.issue_type)
            StudioText::put(" · ")
            if issue.subject_id >= 0:
                StudioText::put("subject ")
                StudioText::put_i(issue.subject_id)
            else:
                StudioText::put("aggregate only")
            StudioText::put("  frame ")
            StudioText::put_i(issue.peak_frame + 1)
            StudioText::put("  value ")
            StudioText::put_i(issue.peak_value)
            StudioText::put(" / ")
            StudioText::put_i(issue.threshold)
            StudioText::view()

        def issue_browser(sb: Box, issues: darray[StudioIssues::Issue]&, first: i64, selected: i64, stale: bool, loading: bool, filter_active: bool) -> void:
            area: Box = issue_area_box(sb)
            StudioDraw::rect(area.x, area.y, area.w, area.h, StudioDraw::color(30, 34, 44))
            StudioDraw::bold(sb.x + 12.0, sb.y + StudioSidebarLayout::ISSUE_HEADING_TOP.f32(), 14.0, "Ranked findings", StudioDraw::ink())
            StudioDraw::text(sb.x + 134.0, sb.y + StudioSidebarLayout::ISSUE_HEADING_TOP.f32() + 3.0, 10.0,
                "Stale" if stale else "Updating" if loading else "Current",
                StudioDraw::color(255, 170, 40) if stale or loading else StudioDraw::muted())
            for action in 0..<3 |action, sb, selected|:
                b: Box = issue_nav_box(sb, action)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::panel())
                StudioDraw::text(b.x + 5.0, b.y + 5.0,
                    10.0, "Previous" if action == ISSUE_PREVIOUS else "Next" if action == ISSUE_NEXT else "Worst",
                    StudioDraw::ink())
            count: i64 = issues.count.i64() if issues.count.i64() < ISSUE_FILTERED_ROWS else ISSUE_FILTERED_ROWS
            if loading and issues.count == 0:
                StudioDraw::text(sb.x + 12.0, sb.y + StudioSidebarLayout::ISSUE_ROW_TOP.f32() + 6.0, 11.0, "Loading findings…", StudioDraw::muted())
            elif issues.count == 0:
                StudioDraw::text(sb.x + 12.0, sb.y + StudioSidebarLayout::ISSUE_ROW_TOP.f32() + 6.0, 11.0,
                    "No findings match these filters" if filter_active else "No motion findings", StudioDraw::muted())
            for index in 0..<count |index, sb, issues, selected, stale|:
                absolute: i64 = first + index
                issue: StudioIssues::Issue = issue_at(issues, absolute)
                b: Box = issue_row_box(sb, index)
                StudioDraw::rect(b.x, b.y, b.w, b.h,
                    StudioDraw::color(58, 52, 40) if absolute == selected else StudioDraw::panel())
                StudioDraw::text(b.x + 5.0, b.y + 9.0, 9.0,
                    issue_row_text(issue), StudioDraw::muted() if stale else StudioDraw::ink())

        def add_label(k: i64) -> sview:
            return "Smooth" if k == 1
            return "Median" if k == 2
            return "Wring" if k == 3
            return "Seam" if k == 4
            "Despike"

        def stack_hit(sb: Box, s: StackState::Stack&, px: f32, py: f32) -> i64:
            return HIT_DUPLICATE * 100 if inside(duplicate_button_box(sb), px, py)
            for k in 0..<ADD_KINDS |k, sb, px, py|:
                return HIT_ADD * 100 + k if inside(add_box(sb, k), px, py)
            for i in 0..<s.count |i, sb, px, py|:
                r: Box = row_box(sb, i)
                if inside(r, px, py):
                    return HIT_TOGGLE * 100 + i if px < r.x + 34.0
                    return HIT_REMOVE * 100 + i if px >= r.x + r.w - 30.0
                    return HIT_DOWN * 100 + i if px >= r.x + r.w - 58.0
                    return HIT_UP * 100 + i if px >= r.x + r.w - 86.0
                    return HIT_SELECT * 100 + i
            return -1

        # The labelled File control sits in the sidebar title row. Its popup
        # opens downwards over the panel so it remains reachable at any size.
        def file_button_box(sb: Box) -> Box:
            box(sb.x + sb.w - 76.0, sb.y + 8.0, 64.0, 28.0)

        def file_popup_box(sb: Box) -> Box:
            box(sb.x + sb.w - FILE_MENU_WIDTH - 8.0, sb.y + 38.0, FILE_MENU_WIDTH, FILE_MENU_ROW * StudioFilePolicy::ROWS.f32() + 8.0)

        def file_popup_contains(sb: Box, px: f32, py: f32) -> bool:
            inside(file_popup_box(sb), px, py)

        def file_popup_row(sb: Box, px: f32, py: f32) -> i64:
            p: Box = file_popup_box(sb)
            return -1 if not inside(p, px, py)
            row: i64 = ((py - p.y - 4.0) / FILE_MENU_ROW).i64()
            return row if row >= 0 and row < StudioFilePolicy::ROWS else -1

        def file_menu_label(row: i64) -> sview:
            return "Open Take..." if row == 0
            return "Open Session..." if row == 1
            return "Save Session" if row == 2
            return "Save Session As..." if row == 3
            return "Export Cleaned GLB" if row == 4
            return "Export As..." if row == 5
            "Storage & Recovery"

        def file_menu_shortcut(row: i64) -> sview:
            return "Cmd-O" if row == 0
            return "Cmd-Shift-O" if row == 1
            return "Cmd-S" if row == 2
            return "Cmd-Shift-S" if row == 3
            return "E" if row == 4
            return "Cmd-E" if row == 5
            ""

        def file_menu_panel(sb: Box, opened: bool, has_take: bool, focus: i64, hover: i64) -> void:
            button: Box = file_button_box(sb)
            StudioDraw::rect(button.x, button.y, button.w, button.h, StudioDraw::color(58, 52, 40) if opened else StudioDraw::panel())
            StudioDraw::bold(button.x + 10.0, button.y + 6.0, 13.0, "File", StudioDraw::ink())
            StudioDraw::tri(button.x + button.w - 17.0, button.y + 11.0, button.x + button.w - 7.0, button.y + 11.0, button.x + button.w - 12.0, button.y + 17.0, StudioDraw::muted())
            return if not opened
            popup: Box = file_popup_box(sb)
            StudioDraw::rect(popup.x, popup.y, popup.w, popup.h, StudioDraw::color(21, 24, 31))
            StudioDraw::segment(popup.x, popup.y, popup.x + popup.w, popup.y, 1.0, StudioDraw::color(82, 91, 108))
            StudioDraw::segment(popup.x + popup.w, popup.y, popup.x + popup.w, popup.y + popup.h, 1.0, StudioDraw::color(82, 91, 108))
            StudioDraw::segment(popup.x + popup.w, popup.y + popup.h, popup.x, popup.y + popup.h, 1.0, StudioDraw::color(82, 91, 108))
            StudioDraw::segment(popup.x, popup.y + popup.h, popup.x, popup.y, 1.0, StudioDraw::color(82, 91, 108))
            for row in 0..<StudioFilePolicy::ROWS |row, popup, focus, hover, has_take|:
                y: f32 = popup.y + 4.0 + row.f32() * FILE_MENU_ROW
                enabled: bool = StudioFilePolicy::enabled(StudioFilePolicy::action(row), has_take)
                col: UiCore::Color = StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117)
                if row == focus or row == hover:
                    StudioDraw::rect(popup.x + 4.0, y, popup.w - 8.0, FILE_MENU_ROW, StudioDraw::color(47, 55, 70))
                    StudioDraw::rect(popup.x + 4.0, y + 4.0, 2.0, FILE_MENU_ROW - 8.0, StudioDraw::accent()) if row == focus
                StudioDraw::text(popup.x + 14.0, y + 7.0, 12.0, file_menu_label(row), col)
                StudioDraw::text(popup.x + popup.w - 78.0, y + 7.0, 10.0, file_menu_shortcut(row), StudioDraw::muted() if enabled else StudioDraw::color(75, 80, 91))

        def replacement_dialog_box(w: f32, h: f32) -> Box:
            box((w - 500.0) / 2.0, (h - 210.0) / 2.0, 500.0, 210.0)

        def replacement_button_box(w: f32, h: f32, index: i64) -> Box:
            d: Box = replacement_dialog_box(w, h)
            box(d.x + 22.0 + index.f32() * 152.0, d.y + 150.0, 136.0, 38.0)

        def replacement_button_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for index in 0..<StudioReplacement::CHOICES |index, w, h, px, py|:
                return index if inside(replacement_button_box(w, h, index), px, py)
            -1

        def replacement_prompt_panel(w: f32, h: f32, opened: bool, focus: i64, save_failed: bool, closing: bool, quitting: bool) -> void:
            return if not opened
            d: Box = replacement_dialog_box(w, h)
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 22.0, d.y + 20.0, 18.0, "Unsaved session changes", StudioDraw::ink())
            mutable message: sview = "Opening another file replaces the current cleanup session."
            message <- "Closing the studio would discard the current cleanup session." if closing
            message <- "Quitting the studio would discard the current cleanup session." if quitting
            StudioDraw::text(d.x + 22.0, d.y + 58.0, 13.0, message, StudioDraw::ink())
            message <- "Save writes the current session before opening the selected file."
            message <- "Save writes the current session before closing the studio." if closing
            message <- "Save writes the current session before quitting the studio." if quitting
            StudioDraw::text(d.x + 22.0, d.y + 80.0, 12.0, message, StudioDraw::muted())
            StudioDraw::text(d.x + 22.0, d.y + 104.0, 12.0, "Save failed. Check the status bar, then retry, discard or cancel.", StudioDraw::color(245, 145, 100)) if save_failed
            StudioDraw::text(d.x + 22.0, d.y + 124.0, 11.0, "Left/Right choose   Enter select   S save   D discard   Esc cancel", StudioDraw::muted())
            for index in 0..<StudioReplacement::CHOICES |index, w, h, focus|:
                b: Box = replacement_button_box(w, h, index)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if index == focus else StudioDraw::panel())
                mutable label: sview = "Save and Open"
                label <- "Save and Close" if closing
                label <- "Save and Quit" if quitting
                label <- "Discard and Open" if index == StudioReplacement::FOCUS_DISCARD
                label <- "Discard and Close" if closing and index == StudioReplacement::FOCUS_DISCARD
                label <- "Discard and Quit" if quitting and index == StudioReplacement::FOCUS_DISCARD
                label <- "Cancel" if index == StudioReplacement::FOCUS_CANCEL
                StudioDraw::bold(b.x + 10.0, b.y + 11.0, 12.0, label, StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if index == focus

        def legacy_session_dialog_box(w: f32, h: f32) -> Box:
            box((w - 560.0) / 2.0, (h - 260.0) / 2.0, 560.0, 260.0)

        def legacy_session_button_box(w: f32, h: f32, index: i64) -> Box:
            d: Box = legacy_session_dialog_box(w, h)
            box(d.x + 74.0 + index.f32() * 250.0, d.y + 204.0, 162.0, 38.0)

        def legacy_session_button_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for index in 0..<StudioLegacyPrompt::CHOICES |index, w, h, px, py|:
                return index if inside(legacy_session_button_box(w, h, index), px, py)
            -1

        def legacy_session_prompt_panel(w: f32, h: f32, opened: bool, focus: i64) -> void:
            return if not opened
            d: Box = legacy_session_dialog_box(w, h)
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(245, 170, 92))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 18.0, "Older session has no source identity", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 62.0, 13.0, "This file cannot confirm which take, animation or rig it was saved for.", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 88.0, 12.0, "Its operations may fit another take; corrections may affect different joints.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 111.0, 12.0, "Load it only if you know it matches the open take and rig.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 139.0, 11.0, "Unsaved edits get a separate Save, Discard or Cancel choice.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 164.0, 11.0, "Left/Right choose   Enter select   L load   Esc cancel", StudioDraw::muted())
            for index in 0..<StudioLegacyPrompt::CHOICES |index, w, h, focus|:
                b: Box = legacy_session_button_box(w, h, index)
                selected: bool = index == focus
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                label: sview = "Load legacy session" if index == StudioLegacyPrompt::FOCUS_LOAD else "Cancel"
                StudioDraw::bold(b.x + 11.0, b.y + 11.0, 12.0, label, StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

        def export_review_dialog_box(w: f32, h: f32) -> Box:
            box((w - 700.0) / 2.0, (h - 620.0) / 2.0, 700.0, 620.0)

        def export_review_ack_box(w: f32, h: f32) -> Box:
            d: Box = export_review_dialog_box(w, h)
            box(d.x + 24.0, d.y + 529.0, d.w - 48.0, 28.0)

        def export_review_button_box(w: f32, h: f32, focus: i64) -> Box:
            d: Box = export_review_dialog_box(w, h)
            x: f32 = d.x + 360.0 if focus == StudioExportReview::CANCEL else d.x + 526.0
            box(x, d.y + 574.0, 150.0, 38.0)

        def export_review_destination_box(w: f32, h: f32) -> Box:
            d: Box = export_review_dialog_box(w, h)
            box(d.x + 510.0, d.y + 91.0, 160.0, 28.0)

        def export_review_warning_box(w: f32, h: f32, row: i64) -> Box:
            d: Box = export_review_dialog_box(w, h)
            box(d.x + 24.0, d.y + 445.0 + row.f32() * 16.0, d.w - 48.0, 15.0)

        def export_review_warning_index_at(w: f32, h: f32, px: f32, py: f32,
                                           warnings: i64) -> i64:
            for row in 0..<warnings |row, w, h, px, py|:
                return row if inside(export_review_warning_box(w, h, row), px, py)
            -1

        def export_review_hit(w: f32, h: f32, px: f32, py: f32, warnings: i64) -> i64:
            if inside(export_review_destination_box(w, h), px, py):
                return StudioExportReview::DESTINATION
            if export_review_warning_index_at(w, h, px, py, warnings) >= 0:
                return StudioExportReview::INSPECT_WARNINGS
            if warnings > 0 and inside(export_review_ack_box(w, h), px, py):
                return StudioExportReview::ACKNOWLEDGE
            return StudioExportReview::CANCEL if inside(export_review_button_box(w, h, StudioExportReview::CANCEL), px, py)
            return StudioExportReview::EXPORT if inside(export_review_button_box(w, h, StudioExportReview::EXPORT), px, py)
            -1

        def export_result_dialog_box(w: f32, h: f32) -> Box:
            box((w - 620.0) / 2.0, (h - 310.0) / 2.0, 620.0, 310.0)

        def export_result_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = export_result_dialog_box(w, h)
            box(d.x + 24.0 + action.f32() * 174.0, d.y + 244.0, 150.0, 38.0)

        def export_result_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<StudioExportResult::ACTION_COUNT |action, w, h, px, py|:
                return action if inside(export_result_button_box(w, h, action), px, py)
            -1

        const STORAGE_REFRESH: i64 = 0
        const STORAGE_DONE: i64 = 1
        const STORAGE_RESTORE: i64 = 2
        const STORAGE_ACTION_COUNT: i64 = 3
        const STORAGE_STATUS_PRESENT: i64 = 0
        const STORAGE_STATUS_IN_TRASH: i64 = 1
        const STORAGE_STATUS_CHANGED: i64 = 2
        const STORAGE_STATUS_UNVERIFIED: i64 = 3
        const STORAGE_ROW_HEIGHT: f32 = 32.0
        const STORAGE_VISIBLE_ROWS: i64 = 6

        def storage_dialog_box(w: f32, h: f32) -> Box:
            dialog_width: f32 = 760.0 if w >= 792.0 else w - 32.0
            dialog_height: f32 = 520.0 if h >= 552.0 else h - 32.0
            box((w - dialog_width) / 2.0, (h - dialog_height) / 2.0,
                dialog_width, dialog_height)

        def storage_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = storage_dialog_box(w, h)
            box(d.x + 24.0 + action.f32() * 148.0, d.y + d.h - 54.0, 132.0, 38.0)

        def storage_row_box(w: f32, h: f32, visible_row: i64) -> Box:
            d: Box = storage_dialog_box(w, h)
            box(d.x + 22.0, d.y + 184.0 + visible_row.f32() * STORAGE_ROW_HEIGHT,
                d.w - 44.0, STORAGE_ROW_HEIGHT - 2.0)

        def storage_visible_count(w: f32, h: f32, count: i64, selected: i64) -> i64:
            return 0 if count <= 0
            STORAGE_VISIBLE_ROWS if count > STORAGE_VISIBLE_ROWS else count

        def storage_first_visible(count: i64, selected: i64) -> i64:
            return 0 if count <= STORAGE_VISIBLE_ROWS
            return selected - STORAGE_VISIBLE_ROWS + 1 if selected >= count - 1
            return selected - STORAGE_VISIBLE_ROWS / 2 if selected >= STORAGE_VISIBLE_ROWS / 2
            0

        def storage_row_hit(w: f32, h: f32, px: f32, py: f32,
                            count: i64, selected: i64) -> i64:
            first: i64 = storage_first_visible(count, selected)
            for visible_row in 0..<storage_visible_count(w, h, count, selected) |visible_row, first, w, h, px, py|:
                return first + visible_row if inside(storage_row_box(w, h, visible_row), px, py)
            -1

        def storage_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<STORAGE_ACTION_COUNT |action, w, h, px, py|:
                return action if inside(storage_button_box(w, h, action), px, py)
            -1

        def storage_entry_name(entries: darray[StudioStorageManifest::Entry]&,
                               index: i64) -> sview:
            StudioText::begin()
            return StudioText::view() if index < 0 or index >= entries.count.i64()
            entry: StudioStorageManifest::Entry = entries[index]
            mutable first: usize = 0
            for byte_index in 0..<entry.original_path.count |entry|:
                first <- byte_index + 1 if entry.original_path[byte_index] == 47
            if first >= entry.original_path.count:
                StudioText::put("(unknown name)")
            else:
                for byte_index in first..<entry.original_path.count |entry|:
                    StudioText::byte(entry.original_path[byte_index])
            StudioText::view()

        def storage_kind_label(kind: i64) -> sview:
            return "Recovery" if kind == StudioStorageCleanupPolicy::RECOVERY
            return "Temporary export" if kind == StudioStorageCleanupPolicy::TEMP_EXPORT
            return "Quality report" if kind == StudioStorageCleanupPolicy::GENERATED_REPORT
            "Unknown type"

        def storage_entry_status(status: i64) -> sview:
            return "Verified in build" if status == STORAGE_STATUS_PRESENT
            return "Verified in Trash" if status == STORAGE_STATUS_IN_TRASH
            return "Changed identity" if status == STORAGE_STATUS_CHANGED
            "Could not verify"

        def storage_panel(w: f32, h: f32, opened: bool,
                          entries: darray[StudioStorageManifest::Entry]&,
                          statuses: darray[i64]&,
                          selected: i64, focus: i64, message: i64,
                          protected_records: i64, unverified_records: i64,
                          restore_available: bool, restore_review: bool) -> void:
            return if not opened
            d: Box = storage_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 19.0, "Storage & Recovery", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 52.0, 12.0,
                "Studio records generated reports and recovery receipts under build/.", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 72.0, 11.0,
                "Source takes are protected. Refresh rereads the inventory; it does not delete files.", StudioDraw::muted())
            mutable tracked: i64 = 0
            mutable receipts: i64 = 0
            for entry in entries:
                tracked <- tracked + 1 if entry.state == StudioStorageManifest::REGISTERED
                receipts <- receipts + 1 if entry.state == StudioStorageManifest::IN_TRASH
            StudioText::begin()
            StudioText::put("Tracked records  ")
            StudioText::put_i(tracked)
            StudioText::put("     Trash recovery receipts  ")
            StudioText::put_i(receipts)
            StudioDraw::text(d.x + 24.0, d.y + 106.0, 12.0, StudioText::view(), StudioDraw::accent())
            StudioDraw::bold(d.x + 24.0, d.y + 142.0, 11.0, "STUDIO-MANAGED INVENTORY", StudioDraw::muted())
            first: i64 = storage_first_visible(entries.count.i64(), selected)
            for visible_row in 0..<storage_visible_count(w, h, entries.count.i64(), selected) |visible_row, first, entries, statuses, selected, d|:
                index: i64 = first + visible_row
                row: Box = storage_row_box(w, h, visible_row)
                entry: StudioStorageManifest::Entry = entries[index]
                row_status: i64 = statuses[index] if index < statuses.count else STORAGE_STATUS_UNVERIFIED
                StudioDraw::rect(row.x, row.y, row.w, row.h,
                    StudioDraw::color(47, 55, 70) if index == selected else StudioDraw::panel())
                StudioDraw::text(row.x + 10.0, row.y + 8.0, 12.0,
                    storage_entry_name(entries, index), StudioDraw::ink())
                StudioDraw::text(row.x + row.w - 265.0, row.y + 8.0, 11.0,
                    storage_kind_label(entry.kind), StudioDraw::muted())
                StudioDraw::text(row.x + row.w - 130.0, row.y + 8.0, 11.0,
                    storage_entry_status(row_status),
                    StudioDraw::accent() if row_status == STORAGE_STATUS_IN_TRASH else StudioDraw::severity_color(2) if row_status == STORAGE_STATUS_CHANGED or row_status == STORAGE_STATUS_UNVERIFIED else StudioDraw::muted())
            if entries.count == 0:
                StudioDraw::text(d.x + 30.0, d.y + 198.0, 12.0,
                    "No Studio-managed files are registered yet.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 410.0, 11.0,
                "Refresh checks file identities. Cleanup requires additional safety checks.", StudioDraw::muted()) if not restore_review
            if restore_review:
                StudioDraw::text(d.x + 24.0, d.y + 410.0, 11.0,
                    "Restore the selected file to its original build location? Existing files will not be overwritten.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "Choose Confirm restore to proceed, or press Esc to cancel.", StudioDraw::accent())
            elif message == 6:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "File restored to its original location. The inventory is updated.", StudioDraw::color(150, 210, 160))
            elif message == 7:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "Restore failed: the item is unavailable, changed, or its destination is occupied. Refresh to retry.", StudioDraw::color(240, 170, 110))
            elif message == 8:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "File restored, but the inventory could not be saved. Refresh to finish recovery.", StudioDraw::color(240, 170, 110))
            elif message == 9:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "The recovery item changed. Review the refreshed inventory before restoring.", StudioDraw::color(240, 170, 110))
            elif message == 1:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "The inventory could not be read. No cleanup action is available.", StudioDraw::color(240, 170, 110))
            elif message == 5:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "Recovery changes could not be saved. Refresh to retry before taking action.", StudioDraw::color(240, 170, 110))
            elif message == 2:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "The build folder could not be verified. No inventory paths are shown.", StudioDraw::color(240, 170, 110))
            elif unverified_records > 0:
                StudioText::begin()
                StudioText::put_i(unverified_records)
                StudioText::put(" item(s) are protected: file identity changed or could not be checked.")
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif protected_records > 0:
                StudioText::begin()
                StudioText::put_i(protected_records)
                StudioText::put(" record(s) are hidden outside build/ or match the active take.")
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0, StudioText::view(), StudioDraw::color(240, 170, 110))
            elif message == 3:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0,
                    "Inventory refreshed; all visible file identities are verified.", StudioDraw::color(150, 210, 160))
            StudioDraw::text(d.x + 24.0, d.y + 456.0, 10.0,
                "Up / Down selects   Tab moves to a button   Enter activates   Esc closes", StudioDraw::muted())
            for action in 0..<STORAGE_ACTION_COUNT |action, w, h, focus, restore_available, restore_review|:
                b: Box = storage_button_box(w, h, action)
                StudioDraw::rect(b.x, b.y, b.w, b.h,
                    StudioDraw::color(58, 52, 40) if focus == action else StudioDraw::panel())
                StudioDraw::bold(b.x + 12.0, b.y + 11.0, 12.0,
                    "Refresh" if action == STORAGE_REFRESH else "Done" if action == STORAGE_DONE else "Confirm restore" if restore_review else "Restore",
                    StudioDraw::muted() if action == STORAGE_RESTORE and not restore_available else StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if focus == action

        def export_path_inspector_dialog_box(w: f32, h: f32) -> Box:
            box((w - 820.0) / 2.0, (h - 500.0) / 2.0, 820.0, 500.0)

        def export_path_inspector_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = export_path_inspector_dialog_box(w, h)
            box(d.x + 24.0 + action.f32() * 134.0, d.y + 420.0, 120.0, 38.0)

        def export_path_inspector_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<StudioExportPathReview::ACTION_COUNT |action, w, h, px, py|:
                return action if inside(export_path_inspector_button_box(w, h, action), px, py)
            -1

        def export_warning_detail_dialog_box(w: f32, h: f32) -> Box:
            box((w - 620.0) / 2.0, (h - 300.0) / 2.0, 620.0, 300.0)

        def export_warning_detail_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = export_warning_detail_dialog_box(w, h)
            box(d.x + 24.0 + action.f32() * 134.0, d.y + 240.0, 120.0, 38.0)

        def export_warning_detail_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<StudioExportPathReview::ACTION_COUNT |action, w, h, px, py|:
                return action if inside(export_warning_detail_button_box(w, h, action), px, py)
            -1

        def path_preview(path: cstr) -> sview can Unsafe.PointerCast:
            mutable length: usize = 0
            while length < 4096 and path[length] != 0:
                length <- length + 1
            mutable prefix_end: usize = length
            mutable suffix_start: usize = length
            if length > 48:
                prefix_end <- 8
                # Do not leave a partial UTF-8 character at either edge.
                while prefix_end > 0 and path[prefix_end] >= 128 and path[prefix_end] <= 191:
                    prefix_end <- prefix_end - 1
                suffix_start <- length - 37
                while suffix_start < length and path[suffix_start] >= 128 and path[suffix_start] <= 191:
                    suffix_start <- suffix_start + 1
            StudioText::begin()
            for index in 0..<prefix_end |index, path|:
                StudioText::byte(path[index])
            StudioText::put("…") if suffix_start > prefix_end
            for index in suffix_start..<length |index, path|:
                StudioText::byte(path[index])
            StudioText::view()

        def export_path_length(path: cstr) -> usize:
            mutable length: usize = 0
            while length < 4096 and path[length] != 0:
                length <- length + 1
            length

        def export_path_line_end(path: cstr, start: usize, length: usize) -> usize:
            mutable end: usize = start + 44
            end <- length if end > length
            while end > start and end < length and path[end] >= 128 and path[end] <= 191:
                end <- end - 1
            return start + 44 if end == start and start + 44 <= length
            return length if end == start
            end

        def export_path_line_start(path: cstr, line: usize, length: usize) -> usize:
            mutable offset: usize = 0
            for index in 0..<line |index, path, offset, length|:
                offset <- export_path_line_end(path, offset, length)
            offset

        def export_path_pages(path: cstr) -> i64:
            length: usize = export_path_length(path)
            return 1 if length == 0
            mutable offset: usize = 0
            mutable pages: i64 = 0
            while offset < length:
                for row in 0..<5 |row, path, offset, length|:
                    offset <- export_path_line_end(path, offset, length) if offset < length
                pages <- pages + 1
            pages

        def export_path_visible_lines(path: cstr, page: i64) -> i64:
            length: usize = export_path_length(path)
            line: usize = (page * 5).usize()
            mutable offset: usize = export_path_line_start(path, line, length)
            mutable count: i64 = 0
            while count < 5 and offset < length:
                offset <- export_path_line_end(path, offset, length)
                count <- count + 1
            count

        def export_path_line(path: cstr, page: i64, row: i64) -> sview can Unsafe.PointerCast:
            length: usize = export_path_length(path)
            line: usize = (page * 5 + row).usize()
            start: usize = export_path_line_start(path, line, length)
            end: usize = export_path_line_end(path, start, length)
            StudioText::begin()
            for index in start..<end |index, path|:
                StudioText::byte(path[index])
            StudioText::view()

        def export_path_inspector_panel(w: f32, h: f32, opened: bool,
                                        destination: cstr, page: i64,
                                        focus: i64) -> void:
            return if not opened
            pages: i64 = export_path_pages(destination)
            visible_lines: i64 = export_path_visible_lines(destination, page)
            d: Box = export_path_inspector_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 19.0, "Full export destination", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 51.0, 12.0, "Read the complete destination path. Long paths continue on the next page.", StudioDraw::muted())
            for row in 0..<visible_lines |row, d, page, destination|:
                line: Box = box(d.x + 24.0, d.y + 76.0 + row.f32() * 49.0, d.w - 48.0, 38.0)
                StudioDraw::rect(line.x, line.y, line.w, line.h, StudioDraw::panel())
                StudioDraw::text(line.x + 12.0, line.y + 11.0, 12.0,
                    export_path_line(destination, page, row), StudioDraw::ink())
            StudioText::begin()
            StudioText::put("Page ")
            StudioText::put_i(page + 1)
            StudioText::put(" of ")
            StudioText::put_i(pages)
            StudioDraw::text(d.x + 24.0, d.y + 338.0, 12.0, StudioText::view(), StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 367.0, 11.0,
                "Left/Right changes page · Tab moves · Enter selects · Esc returns", StudioDraw::muted())
            for action in 0..<StudioExportPathReview::ACTION_COUNT |action, w, h, page, pages, focus|:
                b: Box = export_path_inspector_button_box(w, h, action)
                enabled: bool = StudioExportPathReview::enabled(action, page, pages)
                selected: bool = focus == action
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                mutable label: sview = "Previous"
                label <- "Next" if action == StudioExportPathReview::NEXT
                label <- "Done" if action == StudioExportPathReview::DONE
                StudioDraw::text(b.x + 13.0, b.y + 11.0, 12.0, label,
                    StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117))
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

        def active_operation_count(s: StackState::Stack&) -> i64:
            mutable count: i64 = 0
            for index in 0..<s.count |index, s|:
                count <- count + 1 if s.ops[index].enabled
            count

        def export_warning_row(w: f32, h: f32, row: i64, focused: bool,
                               value: sview) -> void:
            b: Box = export_review_warning_box(w, h, row)
            StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(47, 55, 70)) if focused
            StudioDraw::rect(b.x + 4.0, b.y + 3.0, 2.0, b.h - 6.0, StudioDraw::accent()) if focused
            StudioText::begin()
            StudioText::put(value)
            d: Box = export_review_dialog_box(UiCore::viewport_width(), UiCore::viewport_height())
            StudioDraw::text(d.x + 36.0, b.y + 4.0, 11.0, StudioText::view(), StudioDraw::color(245, 145, 100))
            StudioDraw::text(d.x + d.w - 82.0, b.y + 4.0, 9.0, "Inspect", StudioDraw::muted())

        def export_warning_metric_row(label: sview, before: i64, after: i64) -> sview:
            StudioText::begin()
            StudioText::put(label)
            mm_put(before)
            StudioText::put(" -> ")
            mm_put(after)
            StudioText::view()

        def export_warning_detail_title(kind: i64) -> sview:
            return "Unresolved balance frames" if kind == StudioExportReview::BALANCE_WARNING
            return "Spikes increased" if kind == StudioExportReview::SPIKE_WARNING
            return "Foot slide increased" if kind == StudioExportReview::FOOT_SLIDE_WARNING
            return "Foot sink increased" if kind == StudioExportReview::FOOT_SINK_WARNING
            return "Hand slide increased" if kind == StudioExportReview::HAND_SLIDE_WARNING
            "Quality warning"

        def export_warning_detail_metric(c: StudioModel::Clip&, kind: i64) -> sview:
            if kind == StudioExportReview::BALANCE_WARNING:
                return StudioText::number("Unresolved output frames: ", c.impossible_frames)
            elif kind == StudioExportReview::SPIKE_WARNING:
                return StudioText::pair("Source spikes: ", c.spikes_before, "  Cleaned spikes: ", c.spikes_after)
            elif kind == StudioExportReview::FOOT_SLIDE_WARNING:
                StudioText::begin()
                StudioText::put("Foot slide: ")
                mm_put(c.slide_before)
                StudioText::put(" -> ")
                mm_put(c.slide_after)
                return StudioText::view()
            elif kind == StudioExportReview::FOOT_SINK_WARNING:
                StudioText::begin()
                StudioText::put("Foot sink: ")
                mm_put(c.sink_before)
                StudioText::put(" -> ")
                mm_put(c.sink_after)
                return StudioText::view()
            elif kind == StudioExportReview::HAND_SLIDE_WARNING:
                StudioText::begin()
                StudioText::put("Hand slide: ")
                mm_put(c.hand_slide_before)
                StudioText::put(" -> ")
                mm_put(c.hand_slide_after)
                return StudioText::view()
            "No metric is available for this warning."

        def export_warning_detail_evidence(c: StudioModel::Clip&, kind: i64) -> sview:
            if kind == StudioExportReview::BALANCE_WARNING:
                mutable frame: i64 = -1
                for index in 0..<c.balance.count |index, c, frame|:
                    frame <- index.i64() if frame < 0 and c.balance[index] == StudioOverlay::IMPOSSIBLE
                return StudioText::number("First affected output frame: ", frame) if frame >= 0
                return "No per-frame balance marker is available."
            elif kind == StudioExportReview::SPIKE_WARNING:
                mutable frame: i64 = -1
                limit: usize = c.problems.count if c.problems.count < c.source_problems.count else c.source_problems.count
                for index in 0..<limit |index, c, frame|:
                    frame <- index.i64() if frame < 0 and c.problems[index] > c.source_problems[index]
                return StudioText::number("First output frame with more spikes: ", frame) if frame >= 0
                return "The category total increased; no matching per-frame comparison is retained."
            elif kind == StudioExportReview::FOOT_SLIDE_WARNING:
                if c.foot_slide.count > 0 and c.worst_frame >= 0:
                    StudioText::begin()
                    StudioText::put("Largest cleaned per-frame slide: frame ")
                    StudioText::put_i(c.worst_frame)
                    StudioText::put(" at ")
                    mm_put(c.worst_slide)
                    return StudioText::view()
                return "No per-frame foot-slide sample is available."
            elif kind == StudioExportReview::FOOT_SINK_WARNING:
                return "This is a take-level before/after metric; no per-frame sink samples are retained."
            elif kind == StudioExportReview::HAND_SLIDE_WARNING:
                return "This is a take-level before/after metric; no per-frame hand-slide samples are retained."
            "No additional frame evidence is available."

        def export_warning_detail_panel(w: f32, h: f32, opened: bool,
                                        c: StudioModel::Clip&, kind: i64,
                                        index: i64, warnings: i64,
                                        focus: i64) -> void:
            return if not opened
            d: Box = export_warning_detail_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 24.0, 18.0, export_warning_detail_title(kind), StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 46.0, 10.0,
                StudioText::pair("Warning ", index + 1, " of ", warnings), StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 68.0, 12.0,
                export_warning_detail_metric(c, kind), StudioDraw::color(245, 145, 100))
            StudioDraw::text(d.x + 24.0, d.y + 108.0, 12.0,
                export_warning_detail_evidence(c, kind), StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 167.0, 11.0,
                "Frame references are zero-based output frames. Aggregate-only metrics do not identify a jump target.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 193.0, 10.0,
                "Done returns to the same export review and keeps its destination and acknowledgement.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 224.0, 10.0,
                "Tab changes control   arrows change warning   Esc returns", StudioDraw::muted())
            for action in 0..<StudioExportPathReview::ACTION_COUNT |action, w, h, focus, index, warnings|:
                b: Box = export_warning_detail_button_box(w, h, action)
                enabled: bool = StudioExportPathReview::enabled(action, index, warnings)
                selected: bool = action == focus
                mutable label: sview = "Previous"
                label <- "Next" if action == StudioExportPathReview::NEXT
                label <- "Done" if action == StudioExportPathReview::DONE
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                StudioDraw::text(b.x + 13.0, b.y + 11.0, 12.0, label,
                    StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117))
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

        def export_review_panel(w: f32, h: f32, opened: bool, destination: cstr,
                                animation: cstr, c: StudioModel::Clip&,
                                s: StackState::Stack&, warnings: i64,
                                acknowledged: bool, focus: i64,
                                selected_warning: i64) -> void:
            return if not opened
            d: Box = export_review_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 22.0, 19.0, "Review cleaned export", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 50.0, 12.0, "Check the output details and quality notes before publishing.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 80.0, 11.0, "Destination (must be inside build):", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 99.0, 12.0, path_preview(destination), StudioDraw::ink())
            path_button: Box = export_review_destination_box(w, h)
            StudioDraw::rect(path_button.x, path_button.y, path_button.w, path_button.h,
                StudioDraw::color(58, 52, 40) if focus == StudioExportReview::DESTINATION else StudioDraw::panel())
            StudioDraw::text(path_button.x + 10.0, path_button.y + 8.0, 11.0,
                "Inspect full path", StudioDraw::ink())
            StudioDraw::rect(path_button.x + 4.0, path_button.y + 4.0, 2.0, path_button.h - 8.0,
                StudioDraw::accent()) if focus == StudioExportReview::DESTINATION

            StudioText::begin()
            StudioText::put("Selected animation: ")
            StudioPanels::file_name_put(animation)
            StudioText::put(" #")
            StudioText::put_i(c.anim + 1)
            StudioText::put(" (cleaned)  ·  ")
            StudioText::put_i(GlbDocument::animation_count(c.cleaned).i64())
            StudioText::put(" animations included; other clips unchanged")
            StudioDraw::text(d.x + 24.0, d.y + 135.0, 12.0, StudioText::view(), StudioDraw::ink())
            StudioText::begin()
            StudioText::put("Timing: ")
            StudioText::put_i(c.frames)
            StudioText::put(" output frames from ")
            StudioText::put_i(c.source_frames)
            StudioText::put(" source frames at ")
            StudioText::put_i(c.rate)
            StudioText::put(" fps")
            StudioText::put(" (retimed)") if c.retimed
            StudioDraw::text(d.x + 24.0, d.y + 158.0, 12.0, StudioText::view(), StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 178.0, 11.0, "Rig profile: none saved; source hierarchy retained; no retargeting", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 198.0, 11.0, "Root motion: no extraction or in-place conversion", StudioDraw::muted())
            StudioText::begin()
            StudioText::put("Cleanup: ")
            StudioText::put_i(active_operation_count(s))
            StudioText::put(" active steps, ")
            StudioText::put_i(s.fix_count)
            StudioText::put(" corrections, feet ")
            StudioText::put("on" if s.feet else "off")
            StudioText::put(", hands ")
            StudioText::put("on" if s.hands else "off")
            StudioDraw::text(d.x + 24.0, d.y + 218.0, 11.0, StudioText::view(), StudioDraw::muted())

            StudioDraw::bold(d.x + 24.0, d.y + 242.0, 12.0, "Active operation steps and settings", StudioDraw::ink())
            mutable operation_slot: i64 = 0
            for index in 0..<s.count |index, s, d, operation_slot|:
                op: Ops::Operation = s.ops[index]
                if op.enabled:
                    column: i64 = 1 if operation_slot >= 8 else 0
                    row: i64 = operation_slot - 8 if column == 1 else operation_slot
                    x: f32 = d.x + 36.0 if column == 0 else d.x + 372.0
                    StudioText::begin()
                    StudioText::put(StackState::kind_label(op.kind))
                    StudioText::put(": ")
                    StudioPanels::param_put(op)
                    StudioDraw::text(x, d.y + 266.0 + row.f32() * 17.0, 10.0, StudioText::view(), StudioDraw::ink())
                    operation_slot <- operation_slot + 1
            StudioDraw::text(d.x + 36.0, d.y + 268.0, 10.0, "No operation steps are active.", StudioDraw::muted()) if operation_slot == 0

            StudioDraw::bold(d.x + 24.0, d.y + 406.0, 12.0, "Quality review", StudioDraw::ink())
            if warnings == 0:
                StudioDraw::text(d.x + 24.0, d.y + 432.0, 11.0, "No unresolved balance frames or worsened tracked metrics.", StudioDraw::color(150, 210, 160))
            else:
                StudioDraw::text(d.x + 24.0, d.y + 430.0, 11.0, StudioText::number("Review required · warning categories: ", warnings), StudioDraw::color(245, 175, 95))
                mutable warning_row: i64 = 0
                if c.impossible_frames > 0:
                    export_warning_row(w, h, warning_row, focus == StudioExportReview::INSPECT_WARNINGS and warning_row == selected_warning, StudioText::number("Unresolved balance frames: ", c.impossible_frames))
                    warning_row <- warning_row + 1
                if c.spikes_after > c.spikes_before:
                    export_warning_row(w, h, warning_row, focus == StudioExportReview::INSPECT_WARNINGS and warning_row == selected_warning, StudioText::pair("Spikes increased: ", c.spikes_before, " -> ", c.spikes_after))
                    warning_row <- warning_row + 1
                if c.slide_after > c.slide_before:
                    export_warning_row(w, h, warning_row, focus == StudioExportReview::INSPECT_WARNINGS and warning_row == selected_warning, export_warning_metric_row("Foot slide increased: ", c.slide_before, c.slide_after))
                    warning_row <- warning_row + 1
                if c.sink_after > c.sink_before:
                    export_warning_row(w, h, warning_row, focus == StudioExportReview::INSPECT_WARNINGS and warning_row == selected_warning, export_warning_metric_row("Foot sink increased: ", c.sink_before, c.sink_after))
                    warning_row <- warning_row + 1
                if c.hand_slide_after > c.hand_slide_before:
                    export_warning_row(w, h, warning_row, focus == StudioExportReview::INSPECT_WARNINGS and warning_row == selected_warning, export_warning_metric_row("Hand slide increased: ", c.hand_slide_before, c.hand_slide_after))

                ack: Box = export_review_ack_box(w, h)
                StudioDraw::rect(ack.x, ack.y, ack.w, ack.h, StudioDraw::color(47, 55, 70) if focus == StudioExportReview::ACKNOWLEDGE else StudioDraw::panel())
                StudioDraw::rect(ack.x + 8.0, ack.y + 6.0, 16.0, 16.0, StudioDraw::color(44, 49, 60))
                StudioDraw::rect(ack.x + 11.0, ack.y + 9.0, 10.0, 10.0, StudioDraw::accent()) if acknowledged
                StudioDraw::text(ack.x + 34.0, ack.y + 6.0, 11.0, "I reviewed these notes and want to export this result.", StudioDraw::ink())

            StudioDraw::text(d.x + 24.0, d.y + 564.0, 10.0, "Tab / arrows move   Space acknowledges   Enter selects   Esc cancels", StudioDraw::muted())
            for button_slot in 0..<2 |button_slot, w, h, focus, warnings, acknowledged|:
                option: i64 = StudioExportReview::CANCEL if button_slot == 0 else StudioExportReview::EXPORT
                b: Box = export_review_button_box(w, h, option)
                enabled: bool = option != StudioExportReview::EXPORT or StudioExportReview::export_enabled(warnings, acknowledged)
                selected: bool = option == focus
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                StudioDraw::text(b.x + 13.0, b.y + 11.0, 12.0, "Cancel" if option == StudioExportReview::CANCEL else "Export GLB", StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117))
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

        def export_result_panel(w: f32, h: f32, opened: bool, destination: cstr, focus: i64, report_saved: bool) -> void:
            return if not opened
            d: Box = export_result_dialog_box(w, h)
            StudioDraw::rect(0.0, 0.0, w, h, StudioDraw::color(8, 10, 14))
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.3, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 24.0, d.y + 24.0, 19.0, "Export complete", StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 58.0, 13.0, "The GLB was written, reopened and validated.", StudioDraw::color(150, 210, 160))
            StudioDraw::text(d.x + 24.0, d.y + 78.0, 11.0, "Quality report sidecars were saved beside the GLB.", StudioDraw::muted()) if report_saved
            StudioDraw::text(d.x + 24.0, d.y + 78.0, 11.0, "Quality report sidecars were not saved; retry export to create them.", StudioDraw::color(240, 170, 110)) if not report_saved
            StudioDraw::text(d.x + 24.0, d.y + 96.0, 11.0, "Saved result:", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 116.0, 12.0, path_preview(destination), StudioDraw::ink())
            StudioDraw::text(d.x + 24.0, d.y + 158.0, 11.0, "Open Result uses your default GLB application; Show in Folder opens Finder.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 180.0, 11.0, "This export is separate from the editable session. Cmd-S saves that session.", StudioDraw::muted())
            StudioDraw::text(d.x + 24.0, d.y + 218.0, 10.0, "Tab / arrows move   Enter selects   Esc closes", StudioDraw::muted())
            for action in 0..<StudioExportResult::ACTION_COUNT |action, w, h, focus|:
                b: Box = export_result_button_box(w, h, action)
                selected: bool = action == focus
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                mutable label: sview = "Open Result"
                label <- "Show in Folder" if action == StudioExportResult::SHOW_IN_FOLDER
                label <- "Done" if action == StudioExportResult::DONE
                StudioDraw::bold(b.x + 12.0, b.y + 11.0, 12.0, label, StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

        # Frame rate of the loaded clip, set by the app when a clip is built.
        global mutable shown_rate: i64 = Timeline::RATE

        def set_rate(r: i64) -> void:
            shown_rate <- r

        # "<n> fr (<ms> ms)" for a frame count at the clip rate.
        def frames_put(n: i64) -> void:
            StudioText::put_i(n)
            StudioText::put(" fr (")
            StudioText::put_i(StudioChrome::clip_millis(n, shown_rate) if n >= 0 and n <= StudioChrome::CHROME_FRAMES and shown_rate >= 1 and shown_rate <= StudioChrome::CHROME_RATE_MAX else 0)
            StudioText::put(" ms)")

        # An operation's strength with its unit (StudioChrome::param_unit).
        def param_put(op: Ops::Operation) -> void:
            unit: i64 = StudioChrome::param_unit(SessionState::kind_code(op.kind))
            if unit == StudioChrome::UNIT_PASSES:
                StudioText::put_i(op.strength)
                StudioText::put("\u00d7 passes")
            elif unit == StudioChrome::UNIT_FRAMES:
                StudioText::put("radius " if op.kind == Ops::Kind.Median else "window ")
                frames_put(op.strength)
            elif unit == StudioChrome::UNIT_DEGREES:
                StudioText::put("limit \u00b1")
                StudioText::put_i(StudioChrome::wring_degrees(op.strength) if op.strength >= 0 and op.strength <= StudioChrome::CHROME_REACH else 0)
                StudioText::put("\u00b0")
            else:
                StudioText::put("auto")

        def param_text(op: Ops::Operation) -> sview:
            StudioText::begin()
            param_put(op)
            return StudioText::view()

        # Micro-units (micrometres) as millimetres with three decimals.
        # Last path component of `path` (the status line has no room for
        # folders; StudioText cuts anything past its slot width).
        def file_name_put(path: cstr) -> void:
            mutable n: usize = 0
            mutable cut: usize = 0
            while path[n] != 0 and n < 4096:
                cut <- n + 1 if path[n] == 47 else cut
                n <- n + 1
            for i in cut..<n |i, path|:
                StudioText::byte(path[i])

        def mm_put(micro: i64) -> void:
            StudioText::put_fixed3(micro * 1000 if micro >= 0 - 1000000000 and micro <= 1000000000 else 0)
            StudioText::put(" mm")

        def scope_text(op: Ops::Operation, frames: i64) -> sview:
            last: i64 = op.last if op.last < frames else frames - 1
            return StudioText::pair("frames ", op.first, "-", last)

        def stack_panel(sb: Box, s: StackState::Stack&, c: StudioModel::Clip&, history_cursor: i64, history_count: i64) -> void:
            StudioDraw::rect(sb.x, sb.y, sb.w, sb.h, StudioDraw::color(24, 27, 35))
            StudioDraw::bold(sb.x + 12.0, sb.y + 12.0, 18.0, "Mocap Studio", StudioDraw::ink())
            StudioDraw::text(sb.x + 12.0, sb.y + 38.0, 12.0, StudioText::pair("frames ", c.frames, "   bones ", c.nodes.count.i64()), StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, sb.y + 56.0, 12.0, StudioText::pair("spikes source ", c.spikes_before, "  cleaned ", c.spikes_after), StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, sb.y + 74.0, 12.0, StudioText::pair("history ", history_cursor + 1, " / ", history_count), StudioDraw::muted())
            StudioDraw::bold(sb.x + 12.0, sb.y + StudioSidebarLayout::STACK_HEADING_TOP.f32(), 14.0, "Operation stack", StudioDraw::ink())
            duplicate: Box = duplicate_button_box(sb)
            duplicate_enabled: bool = StudioOperationDuplicatePolicy::available(s.count, s.selected)
            StudioDraw::rect(duplicate.x, duplicate.y, duplicate.w, duplicate.h, StudioDraw::color(48, 57, 70) if duplicate_enabled else StudioDraw::color(31, 34, 41))
            StudioDraw::text(duplicate.x + 8.0, duplicate.y + 5.0, 10.0, "Duplicate", StudioDraw::ink() if duplicate_enabled else StudioDraw::muted())
            for k in 0..<ADD_KINDS |k, sb|:
                b: Box = add_box(sb, k)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::panel())
                StudioIcons::draw(StudioIcons::PLUS, b.x + 2.0, b.y + 4.0, 16.0, StudioDraw::accent())
                StudioDraw::text(b.x + 20.0, b.y + 5.0, 12.0, add_label(k), StudioDraw::ink())
            for i in 0..<s.count |i, sb, s, c|:
                r: Box = row_box(sb, i)
                op: Ops::Operation = s.ops[i]
                selected: bool = i == s.selected
                StudioDraw::rect(r.x, r.y, r.w, r.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                col: UiCore::Color = StudioDraw::ink() if op.enabled else StudioDraw::color(96, 100, 112)
                # Title, then bones and scope, then the parameter: each
                # line stays left of the icon column (r.w - 90).
                StudioIcons::draw(StudioIcons::EYE if op.enabled else StudioIcons::EYE_OFF, r.x + 6.0, r.y + 19.0, 20.0, col)
                StudioDraw::bold(r.x + 36.0, r.y + 5.0, 13.0, StackState::kind_label(op.kind), col)
                StudioDraw::text(r.x + 36.0, r.y + 23.0, 11.0, StackState::bones_label(op.bones), StudioDraw::muted())
                StudioDraw::text(r.x + 100.0, r.y + 23.0, 11.0, scope_text(op, c.frames), StudioDraw::muted())
                StudioDraw::text(r.x + 36.0, r.y + 39.0, 11.0, param_text(op), StudioDraw::muted())
                StudioIcons::draw(StudioIcons::UP, r.x + r.w - 84.0, r.y + 19.0, 20.0, col)
                StudioIcons::draw(StudioIcons::DOWN, r.x + r.w - 56.0, r.y + 19.0, 20.0, col)
                StudioIcons::draw(StudioIcons::TRASH, r.x + r.w - 28.0, r.y + 19.0, 20.0, StudioDraw::color(230, 110, 100))

        # ---- foot cleanup ------------------------------------------------
        # Rows of the timeline strip a press on a contact bar lands in:
        # left/right foot, left/right hand, or -1.
        def contact_row(tb: Box, py: f32) -> i64:
            s: Box = strip(tb)
            return StackState::LEFT if py >= s.y + 44.0 and py < s.y + 56.0
            return StackState::RIGHT if py >= s.y + 56.0 and py < s.y + 68.0
            return StackState::LEFT_HAND if py >= s.y + 68.0 and py < s.y + 80.0
            return StackState::RIGHT_HAND if py >= s.y + 80.0 and py < s.y + 92.0
            -1

        def contact_side_label(side: i64) -> sview:
            return "Left foot" if side == StackState::LEFT
            return "Right foot" if side == StackState::RIGHT
            return "Left hand" if side == StackState::LEFT_HAND
            return "Right hand" if side == StackState::RIGHT_HAND
            "No contact selected"

        def contact_editor_button_box(tb: Box, action: i64) -> Box:
            x: f32 = tb.x + tb.w - 256.0 + 8.0 + 40.0 * action.f32()
            box(x, tb.y + 64.0, 36.0, 24.0)

        def contact_editor_frame_box(tb: Box, target: i64) -> Box:
            x: f32 = tb.x + tb.w - 256.0 + (8.0 if target == StudioContactEditor::NUDGE_FIRST else 128.0)
            box(x, tb.y + 43.0, 116.0, 17.0)

        def contact_editor_hit(tb: Box, px: f32, py: f32, authored: bool) -> i64:
            return CONTACT_EDIT_FIRST if authored and inside(contact_editor_frame_box(tb, StudioContactEditor::NUDGE_FIRST), px, py)
            return CONTACT_EDIT_LAST if authored and inside(contact_editor_frame_box(tb, StudioContactEditor::NUDGE_LAST), px, py)
            for action in 0..<StudioContactEditor::ACTION_COUNT |action, tb, px, py|:
                return action if inside(contact_editor_button_box(tb, action), px, py)
            -1

        def contact_editor_contains(tb: Box, px: f32, py: f32) -> bool:
            panel: Box = box(tb.x + tb.w - 264.0, tb.y + 2.0, 256.0, 90.0)
            inside(panel, px, py)

        def contact_editor_panel(tb: Box, side: i64, frame: i64, frames: i64, reset_available: bool, edit_first: i64, edit_last: i64, merge_available: bool, split_available: bool, draft_target: i64, draft_value: i64) -> void:
            valid: bool = StudioContactEditor::selection_valid(side, frame, frames)
            x: f32 = tb.x + tb.w - 264.0
            StudioDraw::rect(x, tb.y + 2.0, 256.0, 90.0, StudioDraw::color(31, 35, 44))
            StudioDraw::bold(x + 8.0, tb.y + 6.0, 11.0, "Contact edit", StudioDraw::ink())
            if valid:
                StudioText::begin()
                StudioText::put(contact_side_label(side))
                StudioText::put(" · frame ")
                StudioText::put_i(frame + 1)
                StudioDraw::text(x + 8.0, tb.y + 28.0, 10.0, StudioText::view(), StudioDraw::muted())
                StudioDraw::text(x + 8.0, tb.y + 43.0, 9.0, "edit the authored interval below" if reset_available else "follows detection", StudioDraw::muted())
            else:
                StudioDraw::text(x + 8.0, tb.y + 28.0, 9.0, "Click a row/frame first;", StudioDraw::muted())
                StudioDraw::text(x + 8.0, tb.y + 40.0, 9.0, "selection does not edit it.", StudioDraw::muted())
            if reset_available:
                for target in 0..<2 |target, tb, edit_first, edit_last, draft_target, draft_value|:
                    field_target: i64 = StudioContactEditor::NUDGE_FIRST if target == 0 else StudioContactEditor::NUDGE_LAST
                    b: Box = contact_editor_frame_box(tb, field_target)
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(48, 54, 66))
                    StudioText::begin()
                    StudioText::put("First: " if target == 0 else "Last: ")
                    if draft_target == field_target:
                        StudioText::put_i(draft_value) if draft_value >= 0 else StudioText::put("_")
                    else:
                        StudioText::put_i((edit_first if target == 0 else edit_last) + 1)
                    StudioDraw::text(b.x + 4.0, b.y + 3.0, 9.0, StudioText::view(), StudioDraw::ink())
            for action in 0..<StudioContactEditor::ACTION_COUNT |action, tb, valid|:
                b: Box = contact_editor_button_box(tb, action)
                label: sview = "Plant" if action == StudioContactEditor::PLANT else "Lift" if action == StudioContactEditor::LIFT else "Reset" if action == StudioContactEditor::RESET else "Delete" if action == StudioContactEditor::DELETE else "Merge" if action == StudioContactEditor::MERGE else "Split"
                mutable enabled: bool = valid
                enabled <- reset_available if action == StudioContactEditor::RESET or action == StudioContactEditor::DELETE
                enabled <- merge_available if action == StudioContactEditor::MERGE
                enabled <- split_available if action == StudioContactEditor::SPLIT
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::panel() if enabled else StudioDraw::color(34, 37, 44))
                StudioDraw::text(b.x + 7.0, b.y + 7.0, 10.0, label,
                    StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117))

        def contact_selection_marker(tb: Box, side: i64, frame: i64, frames: i64) -> void:
            return if not StudioContactEditor::selection_valid(side, frame, frames)
            s: Box = strip(tb)
            mutable y: f32 = s.y + 45.0
            if side == StackState::RIGHT:
                y <- s.y + 57.0
            elif side == StackState::LEFT_HAND:
                y <- s.y + 69.0
            elif side == StackState::RIGHT_HAND:
                y <- s.y + 81.0
            x: f32 = frame_x(s, frame, frames)
            StudioDraw::rect(x - 2.0, y - 2.0, 4.0, 12.0, StudioDraw::ink())

        def cue_color(cue: i64) -> UiCore::Color:
            return StudioDraw::color(110, 220, 130) if cue == StudioFoot::BETTER
            return StudioDraw::color(240, 80, 80) if cue == StudioFoot::WORSE
            StudioDraw::muted()

        # Timeline extras: red worst-slide ticks over frames whose planted
        # slide earns a marker, the worst frame ringed, and the hovered
        # contact row outlined.
        def foot_marks(tb: Box, c: StudioModel::Clip&, hover: i64) -> void:
            s: Box = strip(tb)
            n: i64 = c.foot_slide.count.i64()
            return if n < 1
            # Binned like the problem markers (draw-command budget).
            bins: i64 = MARKER_BINS if n > MARKER_BINS else n
            for b in 0..<bins |b, bins, n, s, c|:
                first: i64 = b * n / bins
                last: i64 = (b + 1) * n / bins
                mutable hit: bool = false
                for f in first..<last |f, c, hit|:
                    hit <- hit or StudioFoot::marked(c.foot_slide[f.usize()])
                if hit:
                    x0: f32 = frame_x(s, first, n)
                    x1: f32 = frame_x(s, last, n)
                    StudioDraw::rect(x0, s.y + 10.0, x1 - x0 if x1 - x0 > 2.0 else 2.0, 4.0, StudioDraw::color(240, 70, 70))
            if c.worst_frame >= 0 and c.worst_frame < n and StudioFoot::marked(c.worst_slide):
                StudioDraw::tri(frame_x(s, c.worst_frame, n) - 4.0, s.y + 2.0, frame_x(s, c.worst_frame, n) + 4.0, s.y + 2.0, frame_x(s, c.worst_frame, n), s.y + 10.0, StudioDraw::color(255, 90, 90))
            if hover >= StackState::LEFT and hover <= StackState::RIGHT_HAND:
                mutable y: f32 = s.y + 45.0
                y <- s.y + 57.0 if hover == StackState::RIGHT
                y <- s.y + 69.0 if hover == StackState::LEFT_HAND
                y <- s.y + 81.0 if hover == StackState::RIGHT_HAND
                mutable flags: darray[bool] = c.left_contact
                flags <- c.right_contact if hover == StackState::RIGHT
                flags <- c.left_hand_contact if hover == StackState::LEFT_HAND
                flags <- c.right_hand_contact if hover == StackState::RIGHT_HAND
                mutable col: UiCore::Color = StudioDraw::color(150, 255, 170)
                col <- StudioDraw::color(255, 240, 130) if hover == StackState::RIGHT
                col <- StudioDraw::color(140, 210, 255) if hover == StackState::LEFT_HAND
                col <- StudioDraw::color(255, 180, 130) if hover == StackState::RIGHT_HAND
                StudioDraw::rect(s.x, y, s.w, 10.0, StudioDraw::color(60, 66, 90))
                contact_bar(s, flags, y + 1.0, col)

        # Before/after metrics for each enabled detector. Distances use
        # micro-units and ease from the previous build's values.
        def cleanup_readout(sb: Box, c: StudioModel::Clip&, shown_slide: i64, shown_sink: i64, shown_hand_slide: i64, blend: i64) -> void:
            y: f32 = sb.y + 126.0
            StudioText::begin()
            StudioText::put("feet ")
            StudioText::put("on" if c.feet else "off")
            StudioText::put("  hands ")
            StudioText::put("on" if c.hands else "off")
            StudioText::put("  blend ")
            frames_put(blend)
            StudioDraw::text(sb.x + 12.0, y - 30.0, 10.0, StudioText::view(), StudioDraw::muted())
            StudioText::begin()
            StudioText::put("spikes ")
            StudioText::put_i(c.spikes_before)
            StudioText::put(" -> ")
            StudioText::put_i(c.spikes_after)
            StudioDraw::text(sb.x + 12.0, y - 16.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.spikes_before, c.spikes_after)))
            StudioText::begin()
            StudioText::put("balance impossible ")
            StudioText::put_i(c.source_impossible_frames)
            StudioText::put(" -> ")
            StudioText::put_i(c.impossible_frames)
            StudioDraw::text(sb.x + 12.0, y - 2.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.source_impossible_frames, c.impossible_frames)))
            StudioText::begin()
            StudioText::put("foot slide ")
            mm_put(c.slide_before)
            StudioText::put(" -> ")
            mm_put(shown_slide)
            StudioDraw::text(sb.x + 12.0, y + 12.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.slide_before, c.slide_after)))
            StudioText::begin()
            StudioText::put("foot sink ")
            mm_put(c.sink_before)
            StudioText::put(" -> ")
            mm_put(shown_sink)
            StudioDraw::text(sb.x + 12.0, y + 26.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.sink_before, c.sink_after)))
            StudioText::begin()
            StudioText::put("hand slide ")
            mm_put(c.hand_slide_before)
            StudioText::put(" -> ")
            mm_put(shown_hand_slide)
            StudioDraw::text(sb.x + 12.0, y + 40.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.hand_slide_before, c.hand_slide_after)))
