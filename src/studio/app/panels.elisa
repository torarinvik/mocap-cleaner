# The studio's 2D panels, drawn immediate-mode with elisa-ui primitives:
# window layout, the toolbar with code-drawn vector icons, the timeline
# (problem markers, contact bars, operation scope, playhead), the curve view
# (source vs cleaned per-bone curves) and the operation stack panel. Hit
# tests return action codes the app dispatches; all pixel mapping goes
# through the proved Timeline and StudioView kernels.
#
# elisa-ui records at most UiCore::MAX_COMMANDS (1024) draw commands a
# frame, so curves and markers are binned to a fixed number of segments.
include "text.elisa"
include "scene.elisa"
include "../chrome.elisa"
include "../file_policy.elisa"
include "../replacement.elisa"
include "../../../build/generated/studio_icon_paths.elisa"

module StudioDraw:
    public:
        def color(r: u8, g: u8, b: u8) -> UiCore::Color:
            UiCore::rgb(r, g, b)

        def rect(x: f32, y: f32, w: f32, h: f32, c: UiCore::Color) -> void:
            UiCore::fill(UiCore::Rect(x, y, w, h), c)

        def segment(x1: f32, y1: f32, x2: f32, y2: f32, width: f32, c: UiCore::Color) -> void:
            UiCore::fill_stroke(UiCore::Line{from_point: UiCore::Vec2(x1, y1), to_point: UiCore::Vec2(x2, y2)}, width, c)

        def tri(ax: f32, ay: f32, bx: f32, by: f32, cx: f32, cy: f32, c: UiCore::Color) -> void:
            UiCore::fill(UiCore::Triangle{a: UiCore::Vec2(ax, ay), b: UiCore::Vec2(bx, by), c: UiCore::Vec2(cx, cy)}, c)

        def disc(x: f32, y: f32, r: f32, c: UiCore::Color) -> void:
            UiCore::fill(UiCore::Circle{center: UiCore::Vec2(x, y), radius: r}, c)

        # Octagon outline (enough for 16-24 px icons).
        def ring(x: f32, y: f32, r: f32, width: f32, c: UiCore::Color) -> void:
            d: f32 = r * 0.7071
            StudioDraw::segment(x + r, y, x + d, y + d, width, c)
            StudioDraw::segment(x + d, y + d, x, y + r, width, c)
            StudioDraw::segment(x, y + r, x - d, y + d, width, c)
            StudioDraw::segment(x - d, y + d, x - r, y, width, c)
            StudioDraw::segment(x - r, y, x - d, y - d, width, c)
            StudioDraw::segment(x - d, y - d, x, y - r, width, c)
            StudioDraw::segment(x, y - r, x + d, y - d, width, c)
            StudioDraw::segment(x + d, y - d, x + r, y, width, c)

        def text(x: f32, y: f32, size: f32, body: sview, c: UiCore::Color) -> void:
            UiCore::draw(UiCore::TextRun(UiCore::Vec2(x, y), size, body), c)

        def bold(x: f32, y: f32, size: f32, body: sview, c: UiCore::Color) -> void:
            UiCore::draw(UiCore::TextRun(UiCore::Vec2(x, y), size, body, true), c)

        def ink() -> UiCore::Color:
            color(226, 230, 238)

        def muted() -> UiCore::Color:
            color(140, 148, 166)

        def accent() -> UiCore::Color:
            color(255, 170, 40)

        def panel() -> UiCore::Color:
            color(30, 34, 44)

        def severity_color(level: i64) -> UiCore::Color:
            return color(250, 210, 60) if level == 1
            return color(250, 130, 40) if level == 2
            color(240, 50, 50)

# Toolbar and stack icons: Lucide (ISC, assets/icons/lucide) plus custom
# mocap icons (assets/icons/custom), 24px 2px-stroke SVGs flattened to line
# segments by tools/svg_icons.py into build/generated/studio_icon_paths.elisa.
# Codes are StudioIconPaths' codes; each icon fills an s x s box at (x, y).
module StudioIcons:
    public:
        const PLAY: i64 = StudioIconPaths::PLAY
        const PAUSE: i64 = StudioIconPaths::PAUSE
        const BACK: i64 = StudioIconPaths::BACK
        const FORWARD: i64 = StudioIconPaths::FORWARD
        const LOOP: i64 = StudioIconPaths::LOOP
        const UNDO: i64 = StudioIconPaths::UNDO
        const REDO: i64 = StudioIconPaths::REDO
        const TRAILS: i64 = StudioIconPaths::TRAILS
        const CONTACTS: i64 = StudioIconPaths::CONTACTS
        const HEAT: i64 = StudioIconPaths::HEAT
        const ONION: i64 = StudioIconPaths::ONION
        const GHOST: i64 = StudioIconPaths::GHOST
        const XRAY: i64 = StudioIconPaths::XRAY
        const MESH: i64 = StudioIconPaths::MESH
        const EXPORT: i64 = StudioIconPaths::EXPORT
        const FRAME: i64 = StudioIconPaths::FRAME
        const EYE: i64 = StudioIconPaths::EYE
        const EYE_OFF: i64 = StudioIconPaths::EYE_OFF
        const UP: i64 = StudioIconPaths::UP
        const DOWN: i64 = StudioIconPaths::DOWN
        const TRASH: i64 = StudioIconPaths::TRASH
        const PLUS: i64 = StudioIconPaths::PLUS
        const BALANCE: i64 = StudioIconPaths::BALANCE
        const CLEAN: i64 = StudioIconPaths::CLEAN
        const OPEN: i64 = StudioIconPaths::OPEN
        const SAVE: i64 = StudioIconPaths::SAVE
        const FOOT_FIX: i64 = StudioIconPaths::FOOT_FIX
        const PIVOT: i64 = StudioIconPaths::PIVOT
        const SPIKE: i64 = StudioIconPaths::SPIKE
        const RETIME: i64 = StudioIconPaths::RETIME

        # 2 SVG units of stroke, never thinner than 1.2 px.
        def draw(icon: i64, x: f32, y: f32, s: f32, c: UiCore::Color) -> void:
            w: f32 = s / 12.0
            StudioIconPaths::draw(icon, x, y, s, w if w > 1.2 else 1.2, c)

module StudioPanels:
    public:
        const SIDEBAR: f32 = 300.0
        const TOOLBAR: f32 = 44.0
        const TIMELINE: f32 = 116.0
        const CURVE: f32 = 150.0
        const STATUS: f32 = 24.0
        const GAP: f32 = 8.0
        const BUTTON: f32 = 32.0
        const BUTTONS: i64 = 19
        const ROW: f32 = 58.0
        const ADD_KINDS: i64 = 5
        const CURVE_SEGMENTS: i64 = 40
        const MARKER_BINS: i64 = 120
        const FILE_MENU_ROW: f32 = 28.0
        const FILE_MENU_WIDTH: f32 = 190.0

        # Toolbar actions, in button order.
        const A_PLAY: i64 = 0
        const A_BACK: i64 = 1
        const A_FORWARD: i64 = 2
        const A_SPEED: i64 = 3
        const A_LOOP: i64 = 4
        const A_UNDO: i64 = 5
        const A_REDO: i64 = 6
        const A_TRAILS: i64 = 7
        const A_CONTACTS: i64 = 8
        const A_HEAT: i64 = 9
        const A_ONION: i64 = 10
        const A_GHOST: i64 = 11
        const A_XRAY: i64 = 12
        const A_MESH: i64 = 13
        const A_FRAME: i64 = 14
        const A_OPEN: i64 = 15
        const A_EXPORT: i64 = 16
        const A_BALANCE: i64 = 17
        const A_CLEAN: i64 = 18

        # Stack-panel hits: kind * 100 + row (kind 1 select, 2 toggle, 3 up,
        # 4 down, 5 remove), or 600 + k for "add kind k".
        const HIT_SELECT: i64 = 1
        const HIT_TOGGLE: i64 = 2
        const HIT_UP: i64 = 3
        const HIT_DOWN: i64 = 4
        const HIT_REMOVE: i64 = 5
        const HIT_ADD: i64 = 6

        struct Box:
            x: f32
            y: f32
            w: f32
            h: f32

        def box(x: f32, y: f32, w: f32, h: f32) -> Box:
            Box{x: x, y: y, w: w if w > 1.0 else 1.0, h: h if h > 1.0 else 1.0}

        def inside(b: Box, px: f32, py: f32) -> bool:
            return StudioView::inside(px.i64(), py.i64(), b.x.i64(), b.y.i64(), b.w.i64(), b.h.i64())

        # Window layout for a `w` x `h` point window.
        def main_width(w: f32) -> f32:
            v: f32 = w - SIDEBAR - 2.0 * GAP
            v if v > 200.0 else 200.0

        def views_height(h: f32) -> f32:
            v: f32 = h - TOOLBAR - CURVE - TIMELINE - STATUS - 3.0 * GAP
            v if v > 160.0 else 160.0

        def view_box(index: usize, w: f32, h: f32) -> Box:
            mw: f32 = main_width(w)
            vh: f32 = views_height(h)
            top: f32 = vh * 0.6
            return box(GAP, TOOLBAR, mw, top - GAP * 0.5) if index == 0
            half: f32 = (mw - GAP) * 0.5
            return box(GAP, TOOLBAR + top + GAP * 0.5, half, vh - top - GAP * 0.5) if index == 1
            box(GAP + half + GAP, TOOLBAR + top + GAP * 0.5, half, vh - top - GAP * 0.5)

        def curve_box(w: f32, h: f32) -> Box:
            box(GAP, TOOLBAR + views_height(h) + GAP, main_width(w), CURVE)

        def timeline_box(w: f32, h: f32) -> Box:
            box(GAP, TOOLBAR + views_height(h) + CURVE + 2.0 * GAP, main_width(w), TIMELINE)

        def status_box(w: f32, h: f32) -> Box:
            box(0.0, h - STATUS, w - SIDEBAR, STATUS)

        def sidebar_box(w: f32, h: f32) -> Box:
            box(w - SIDEBAR, 0.0, SIDEBAR, h)

        # Inner strip of the timeline the frames map onto.
        def strip(t: Box) -> Box:
            box(t.x + 12.0, t.y, t.w - 24.0, t.h)

        def button_x(i: i64) -> f32:
            groups: i64 = (1 if i >= A_UNDO else 0) + (1 if i >= A_TRAILS else 0) + (1 if i >= A_FRAME else 0) + (1 if i >= A_CLEAN else 0)
            GAP + i.f32() * (BUTTON + 4.0) + groups.f32() * 14.0

        def button_box(i: i64) -> Box:
            box(button_x(i), 6.0, BUTTON, BUTTON)

        def toolbar_hit(px: f32, py: f32) -> i64:
            for i in 0..<BUTTONS |i, px, py|:
                return i if inside(button_box(i), px, py)
            return -1

        def icon_of(action: i64, playing: bool) -> i64:
            return (StudioIcons::PAUSE if playing else StudioIcons::PLAY) if action == A_PLAY
            return StudioIcons::BACK if action == A_BACK
            return StudioIcons::FORWARD if action == A_FORWARD
            return StudioIcons::LOOP if action == A_LOOP
            return StudioIcons::UNDO if action == A_UNDO
            return StudioIcons::REDO if action == A_REDO
            return StudioIcons::TRAILS if action == A_TRAILS
            return StudioIcons::CONTACTS if action == A_CONTACTS
            return StudioIcons::HEAT if action == A_HEAT
            return StudioIcons::ONION if action == A_ONION
            return StudioIcons::GHOST if action == A_GHOST
            return StudioIcons::XRAY if action == A_XRAY
            return StudioIcons::MESH if action == A_MESH
            return StudioIcons::FRAME if action == A_FRAME
            return StudioIcons::OPEN if action == A_OPEN
            return StudioIcons::EXPORT if action == A_EXPORT
            return StudioIcons::BALANCE if action == A_BALANCE
            return StudioIcons::CLEAN if action == A_CLEAN
            -1

        # Tooltip of a toolbar button: what it does, then its shortcut.
        def tip_of(action: i64) -> sview:
            return "Play / pause  (Space)" if action == A_PLAY
            return "Previous frame  (Left)" if action == A_BACK
            return "Next frame  (Right)" if action == A_FORWARD
            return "Playback speed  (S)" if action == A_SPEED
            return "Loop playback  (L)" if action == A_LOOP
            return "Undo  (Cmd-Z)" if action == A_UNDO
            return "Redo  (Cmd-Shift-Z)" if action == A_REDO
            return "Motion trails  (T)" if action == A_TRAILS
            return "Foot contacts  (C)" if action == A_CONTACTS
            return "Problem heat map  (H)" if action == A_HEAT
            return "Onion skin  (N)" if action == A_ONION
            return "Source ghost  (G)" if action == A_GHOST
            return "X-ray skeleton  (X)" if action == A_XRAY
            return "Skinned mesh  (M)" if action == A_MESH
            return "Frame the character  (F)" if action == A_FRAME
            return "Open a take  (Cmd-O)" if action == A_OPEN
            return "Export cleaned GLB  (E)" if action == A_EXPORT
            return "Balance overlay  (Q)" if action == A_BALANCE
            return "Fix all with boxing preset  (A)" if action == A_CLEAN
            ""

        def tooltip(action: i64) -> void:
            return if action < 0 or action >= BUTTONS
            b: Box = button_box(action)
            text: sview = tip_of(action)
            width: f32 = text.len.f32() * 6.6 + 16.0
            StudioDraw::rect(b.x, b.y + b.h + 4.0, width, 22.0, StudioDraw::color(240, 236, 220))
            StudioDraw::text(b.x + 8.0, b.y + b.h + 8.0, 12.0, text, StudioDraw::color(20, 22, 28))

        # Shortcut sheet ("?"): every binding, grouped.
        const HELP_LINES: i64 = 26
        def help_line(i: i64) -> sview:
            return "PLAYBACK" if i == 0
            return "Space  play / pause       Left / Right  step a frame" if i == 1
            return "S  speed (1, 1/2, 1/4)    L  loop" if i == 2
            return "EDITING" if i == 3
            return "A  Fix all with the boxing preset (undoable)" if i == 4
            return "1-5  add despike / smooth / median / wring / seam" if i == 5
            return "Up / Down  select operation    D  enable / disable" if i == 6
            return "[ / ]  strength    B  bones    I / O  scope in / out at playhead" if i == 7
            return "PgUp / PgDn  move operation    Delete  remove" if i == 8
            return "K feet  J hands    , / . blend    W worst foot slide" if i == 9
            return "Drag a contact bar to edit a hand or foot span" if i == 10
            return "R / V  rotate / translate gizmo (drag to key a correction)" if i == 11
            return "Cmd-Z  undo    Cmd-Shift-Z (or Y)  redo" if i == 12
            return "FILE" if i == 13
            return "Cmd-S  save session    Cmd-Shift-S  save as    Cmd-Shift-O  open session" if i == 14
            return "Cmd-O  open take    E  export    Cmd-E  export as" if i == 15
            return "VIEW" if i == 16
            return "F  frame character    Shift-F  frame times    P  position / rotation curves" if i == 17
            return "T trails  C contacts  H heat  N onion  G ghost  X x-ray  M mesh  Q balance" if i == 18
            return "Drag a view to orbit, right-drag to pan, scroll to zoom, click a bone to select" if i == 19
            return "Retime: Shift-drag the timeline, Shift-1..7 preset, = type a speed" if i == 20
            return "Escape cancels one thing at a time: this sheet, a drag, a contact" if i == 21
            return "press, the gizmo, then the selection." if i == 22
            return "Drag a speed band edge to move it, Delete removes the band" if i == 23
            return "?  show / hide this sheet" if i == 24
            ""

        def help_sheet(w: f32, h: f32) -> void:
            sw: f32 = 620.0
            sh: f32 = 60.0 + HELP_LINES.f32() * 19.0
            x: f32 = (w - sw) * 0.5
            y: f32 = (h - sh) * 0.5
            StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
            StudioDraw::rect(x, y, sw, sh, StudioDraw::color(30, 33, 41))
            StudioDraw::bold(x + 24.0, y + 18.0, 16.0, "Keyboard shortcuts", StudioDraw::ink())
            for i in 0..<HELP_LINES |i, x, y|:
                line: sview = help_line(i)
                heading: bool = i == 0 or i == 3 or i == 13 or i == 16
                if heading:
                    StudioDraw::bold(x + 24.0, y + 52.0 + i.f32() * 19.0, 11.0, line, StudioDraw::accent())
                else:
                    StudioDraw::text(x + 24.0, y + 52.0 + i.f32() * 19.0, 12.0, line, StudioDraw::ink())

        # First-run guide or load failure, drawn over the empty views.
        def guide(w: f32, h: f32, screen: i64) -> void:
            b: Box = view_box(0, w, h)
            x: f32 = b.x + 40.0
            y: f32 = b.y + 40.0
            if screen == StudioChrome::SCREEN_FAILED:
                StudioDraw::bold(x, y, 18.0, "Could not open the take", StudioDraw::severity_color(2))
                StudioDraw::text(x, y + 30.0, 13.0, "Check the GLB and animation name, then try opening another take.", StudioDraw::ink())
                StudioDraw::text(x, y + 52.0, 13.0, "Use the folder button, press Cmd-O, or drop a GLB here.", StudioDraw::muted())
            else:
                StudioDraw::bold(x, y, 18.0, "Open a take to start", StudioDraw::ink())
                StudioDraw::text(x, y + 30.0, 13.0, "Click the folder button, press Cmd-O, or drop a GLB here.", StudioDraw::ink())
            StudioDraw::text(x, y + 84.0, 13.0, "You can also start with: build/mocap_studio <take.glb> [animation]", StudioDraw::ink())
            StudioDraw::text(x, y + 106.0, 13.0, "A applies the boxing preset. Press ? for shortcuts and help.", StudioDraw::muted())

        # Status bar: frame, clip time, rate, selection and the last message.
        def status_bar(sb: Box, frame: i64, count: i64, rate: i64, selected: i64, slide: i64, spikes: i64, dirty: bool, message: sview) -> void:
            StudioDraw::rect(sb.x, sb.y, sb.w, sb.h, StudioDraw::color(24, 27, 34))
            StudioDraw::text(sb.x + 560.0, sb.y + 5.0, 12.0, message, StudioDraw::accent())
            StudioText::begin()
            StudioText::put("Frame ")
            StudioText::put_i(StudioChrome::shown_frame(frame, count) if frame >= 0 and frame < count and count >= 1 and count <= StudioChrome::CHROME_FRAMES else 0)
            StudioText::put(" / ")
            StudioText::put_i(count)
            StudioText::put("   ")
            StudioText::put_fixed3(StudioChrome::clip_millis(frame, rate) * 1000 if frame >= 0 and frame <= StudioChrome::CHROME_FRAMES and rate >= 1 and rate <= StudioChrome::CHROME_RATE_MAX else 0)
            StudioText::put(" s   ")
            StudioText::put_i(rate)
            StudioText::put(" fps   ")
            if selected >= 0:
                StudioText::put("operation ")
                StudioText::put_i(selected + 1)
            else:
                StudioText::put("no selection")
            if dirty:
                StudioText::put("   * Unsaved changes")
            if slide >= 0:
                StudioText::put("   clean: slide -")
                StudioText::put_i(slide / 10)
                StudioText::put("%, spikes -")
                StudioText::put_i(spikes / 10)
                StudioText::put("%")
            StudioDraw::text(sb.x + 12.0, sb.y + 5.0, 12.0, StudioText::view(), StudioDraw::ink())

        # Whether a toggle button is lit.
        def lit(action: i64, flags: i64, t: TimelineState::State&) -> bool:
            return t.looping if action == A_LOOP
            return StudioScene::on(flags, StudioScene::TRAILS) if action == A_TRAILS
            return StudioScene::on(flags, StudioScene::CONTACTS) if action == A_CONTACTS
            return StudioScene::on(flags, StudioScene::HEAT) if action == A_HEAT
            return StudioScene::on(flags, StudioScene::ONION) if action == A_ONION
            return StudioScene::on(flags, StudioScene::GHOST) if action == A_GHOST
            return StudioScene::on(flags, StudioScene::XRAY) if action == A_XRAY
            return StudioScene::on(flags, StudioScene::MESH) if action == A_MESH
            return StudioScene::on(flags, StudioScene::BALANCE) if action == A_BALANCE
            false

        def toolbar(t: TimelineState::State&, flags: i64, can_undo: bool, can_redo: bool) -> void:
            for i in 0..<BUTTONS |i, t, flags, can_undo, can_redo|:
                b: Box = button_box(i)
                on: bool = lit(i, flags, t)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(70, 60, 40) if on else StudioDraw::panel())
                dim: bool = (i == A_UNDO and not can_undo) or (i == A_REDO and not can_redo)
                c: UiCore::Color = StudioDraw::accent() if on else (StudioDraw::color(80, 86, 100) if dim else StudioDraw::ink())
                if i == A_SPEED:
                    StudioDraw::text(b.x + 3.0, b.y + 9.0, 12.0, TimelineState::speed_label(t.divisor), c)
                elif i == A_CLEAN:
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(52, 72, 60))
                    StudioIcons::draw(StudioIcons::CLEAN, b.x + 6.0, b.y + 6.0, 20.0, StudioDraw::ink())
                else:
                    StudioIcons::draw(icon_of(i, t.playing), b.x + 6.0, b.y + 6.0, 20.0, c)

        # Left edge of `frame`; frames at or past the end map to the strip's
        # right edge (x_of_frame requires 0 <= frame < count).
        def frame_x(s: Box, frame: i64, count: i64) -> f32:
            return s.x if frame <= 0 or count < 1
            return s.x + s.w if frame >= count
            return s.x + Timeline::x_of_frame(frame, s.w.i64(), count).f32()

        # Timeline: frame ruler, cleaned problem markers (source markers
        # faint above), left/right foot contact bars, the selected
        # operation's scope and the playhead.
        def timeline(tb: Box, c: StudioModel::Clip&, t: TimelineState::State&, scope_first: i64, scope_last: i64) -> void:
            StudioDraw::rect(tb.x, tb.y, tb.w, tb.h, StudioDraw::panel())
            s: Box = strip(tb)
            n: i64 = c.frames
            return if n < 1
            if scope_first >= 0:
                x0: f32 = frame_x(s, scope_first, n)
                x1: f32 = frame_x(s, scope_last, n)
                StudioDraw::rect(x0, s.y + 2.0, (x1 - x0) + 2.0, s.h - 4.0, StudioDraw::color(52, 58, 80))
            # Ruler every second (c.rate frames).
            r: i64 = c.rate if c.rate >= 1 else Timeline::RATE
            for k in 0..<(n / r + 1) |k, s, n, r|:
                x: f32 = frame_x(s, k * r, n)
                StudioDraw::segment(x, s.y + 2.0, x, s.y + 10.0, 1.0, StudioDraw::muted())
            bins: i64 = MARKER_BINS if n > MARKER_BINS else n
            for b in 0..<bins |b, bins, n, s, c|:
                first: i64 = b * n / bins
                last: i64 = (b + 1) * n / bins
                mutable worst: i64 = 0
                mutable raw: i64 = 0
                for f in first..<last |f, c, worst, raw|:
                    if c.problems[f.usize()] > 0:
                        peak: i64 = c.peaks[f.usize()]
                        accel: i64 = 0 if peak < 0 else (StudioView::MAX_VALUE if peak > StudioView::MAX_VALUE else peak)
                        level: i64 = StudioView::severity(accel, c.threshold) if c.threshold >= 1 and c.threshold <= StudioView::MAX_VALUE else 3
                        worst <- level if level > worst else worst
                        worst <- 1 if worst < 1 else worst
                    raw <- raw + c.source_problems[f.usize()]
                x0: f32 = frame_x(s, first, n)
                x1: f32 = frame_x(s, last, n)
                wide: f32 = x1 - x0 if x1 - x0 > 2.0 else 2.0
                if raw > 0:
                    StudioDraw::rect(x0, s.y + 14.0, wide, 6.0, StudioDraw::color(90, 70, 80))
                if worst > 0:
                    StudioDraw::rect(x0, s.y + 22.0, wide, 16.0, StudioDraw::severity_color(worst))
            balance_bar(s, c, s.y + 40.0)
            contact_bar(s, c.left_contact, s.y + 46.0, StudioDraw::color(110, 220, 130))
            contact_bar(s, c.right_contact, s.y + 58.0, StudioDraw::color(240, 220, 90))
            contact_bar(s, c.left_hand_contact, s.y + 70.0, StudioDraw::color(100, 190, 255))
            contact_bar(s, c.right_hand_contact, s.y + 82.0, StudioDraw::color(255, 150, 100))
            px: f32 = frame_x(s, t.frame, n)
            StudioDraw::segment(px, tb.y, px, tb.y + tb.h, 2.0, StudioDraw::accent())
            StudioDraw::text(tb.x + 12.0, tb.y + tb.h - 20.0, 12.0, StudioText::pair("frame ", t.frame, " / ", n - 1), StudioDraw::ink())
            StudioDraw::text(tb.x + 150.0, tb.y + tb.h - 20.0, 12.0, "L foot", StudioDraw::color(110, 220, 130))
            StudioDraw::text(tb.x + 200.0, tb.y + tb.h - 20.0, 12.0, "R foot", StudioDraw::color(240, 220, 90))
            StudioDraw::text(tb.x + 250.0, tb.y + tb.h - 20.0, 12.0, "L hand", StudioDraw::color(100, 190, 255))
            StudioDraw::text(tb.x + 300.0, tb.y + tb.h - 20.0, 12.0, "R hand", StudioDraw::color(255, 150, 100))
            StudioDraw::text(tb.x + 360.0, tb.y + tb.h - 20.0, 12.0, StudioText::pair("spikes ", c.spikes_before, " -> ", c.spikes_after), StudioDraw::muted())
            StudioDraw::text(tb.x + 510.0, tb.y + tb.h - 20.0, 12.0, StudioText::number("balance impossible: ", c.impossible_frames), StudioDraw::color(240, 70, 70) if c.impossible_frames > 0 else StudioDraw::muted())

        # Frames the balance detector reports as impossible, binned like the
        # problem markers (a bin shows the worst state of its frames).
        def balance_bar(s: Box, c: StudioModel::Clip&, y: f32) -> void:
            n: i64 = c.balance.count.i64()
            return if n < 1
            bins: i64 = MARKER_BINS if n > MARKER_BINS else n
            for b in 0..<bins |b, bins, n, s, c, y|:
                first: i64 = b * n / bins
                last: i64 = (b + 1) * n / bins
                mutable level: i64 = StudioOverlay::AIRBORNE
                for f in first..<last |f, c, level|:
                    v: i64 = c.balance[f.usize()]
                    level <- StudioOverlay::worst(level, v) if v >= StudioOverlay::AIRBORNE and v <= StudioOverlay::IMPOSSIBLE else level
                if StudioOverlay::marked(level):
                    x0: f32 = frame_x(s, first, n)
                    x1: f32 = frame_x(s, last, n)
                    StudioDraw::rect(x0, y, x1 - x0 if x1 - x0 > 2.0 else 2.0, 5.0, StudioDraw::color(240, 50, 50))

        # Runs of planted frames as bars.
        def contact_bar(s: Box, flags: darray[bool]&, y: f32, col: UiCore::Color) -> void:
            n: i64 = flags.count.i64()
            mutable run: i64 = -1
            for f in 0..<(n + 1) |f, n, flags, run, s, y, col|:
                down: bool = f < n and flags[f.usize()]
                if down and run < 0:
                    run <- f
                if not down and run >= 0:
                    x0: f32 = frame_x(s, run, n)
                    x1: f32 = frame_x(s, f, n)
                    StudioDraw::rect(x0, y, (x1 - x0) if x1 - x0 > 1.0 else 1.0, 8.0, col)
                    run <- -1

        # Frame under x in the timeline strip.
        def timeline_frame(tb: Box, px: f32, count: i64) -> i64:
            s: Box = strip(tb)
            return Timeline::frame_at_x((px - s.x).i64(), s.w.i64(), count)

        def series_color(k: usize) -> UiCore::Color:
            return StudioDraw::color(240, 90, 90) if k == 0
            return StudioDraw::color(110, 220, 120) if k == 1
            return StudioDraw::color(90, 160, 255) if k == 2
            StudioDraw::color(220, 220, 220)

        # Curve view: every component of the selected bone's channel,
        # source dim and cleaned bright, on one shared value range.
        # The curve view draws from the per-(bone, mode) memo, refilled only
        # when the clip is rebuilt (`built`) or the selection changes.
        def curves(cb: Box, c: StudioModel::Clip&, bone: i64, frame: i64, mode: i64, memo: mutable StudioPerf::Curves&, built: i64) -> void:
            StudioDraw::rect(cb.x, cb.y, cb.w, cb.h, StudioDraw::panel())
            ch: i64 = StudioModel::curve_channel_in(c, bone, mode)
            if ch < 0:
                StudioDraw::text(cb.x + 10.0, cb.y + 8.0, 12.0, "no animated channel on this bone", StudioDraw::muted())
                return
            if not StudioPerf::curves_hit(memo, built, bone, mode) or memo.channel != ch:
                StudioPerf::fill_curves(memo, c.source, c.cleaned, c.anim, ch, built, bone, mode, StudioView::MAX_VALUE)
            mutable lo: i64 = memo.lo
            mutable hi: i64 = memo.hi
            lo <- (0 - StudioView::MAX_VALUE) if lo < 0 - StudioView::MAX_VALUE else lo
            hi <- StudioView::MAX_VALUE if hi > StudioView::MAX_VALUE else hi
            lo <- StudioView::MAX_VALUE - 1 if lo >= StudioView::MAX_VALUE else lo
            hi <- lo + 1 if hi <= lo else hi
            inner: Box = box(cb.x + 12.0, cb.y + 22.0, cb.w - 24.0, cb.h - 30.0)
            for k in 0..<memo.comps |k, memo, lo, hi, inner|:
                a: darray[i64] = StudioPerf::series(&memo.source, k, memo.length)
                b: darray[i64] = StudioPerf::series(&memo.cleaned, k, memo.length)
                col: UiCore::Color = series_color(k.usize())
                polyline(inner, a, lo, hi, UiCore::rgba(col.r, col.g, col.b, 90), 1.0)
                polyline(inner, b, lo, hi, col, 1.6)
            n: i64 = c.frames if c.frames > 0 else 1
            px: f32 = inner.x + Timeline::x_of_frame(frame, inner.w.i64(), n).f32()
            StudioDraw::segment(px, inner.y, px, inner.y + inner.h, 1.5, StudioDraw::accent())
            label: sview = "Position curves: dim = source, bright = cleaned (x y z)  P: rotation" if StudioModel::is_position(c, ch) else "Rotation curves: dim = source, bright = cleaned (x y z w)  P: position"
            StudioDraw::text(cb.x + 10.0, cb.y + 4.0, 12.0, label, StudioDraw::muted())
            StudioDraw::text(cb.x + cb.w - 150.0, cb.y + 4.0, 12.0, StudioText::number("bone slot ", bone), StudioDraw::ink())

        def polyline(inner: Box, v: darray[i64]&, lo: i64, hi: i64, col: UiCore::Color, width: f32) -> void:
            n: i64 = v.count.i64()
            return if n < 2
            segs: i64 = CURVE_SEGMENTS if n - 1 > CURVE_SEGMENTS else n - 1
            top: i64 = inner.y.i64()
            height: i64 = inner.h.i64()
            for s in 0..<segs |s, segs, n, v, lo, hi, inner, col, width, top, height|:
                f0: i64 = s * (n - 1) / segs
                f1: i64 = (s + 1) * (n - 1) / segs
                x0: f32 = inner.x + Timeline::x_of_frame(f0, inner.w.i64(), n).f32()
                x1: f32 = inner.x + Timeline::x_of_frame(f1, inner.w.i64(), n).f32()
                y0: f32 = StudioView::value_y(v[f0.usize()], lo, hi, top, height).f32()
                y1: f32 = StudioView::value_y(v[f1.usize()], lo, hi, top, height).f32()
                StudioDraw::segment(x0, y0, x1, y1, width, col)

        # Stack panel geometry.
        def add_box(sb: Box, k: i64) -> Box:
            w: f32 = (sb.w - 24.0) / 3.0
            col: i64 = k % 3
            row: i64 = k / 3
            box(sb.x + 12.0 + col.f32() * w, sb.y + 208.0 + row.f32() * 28.0, w - 4.0, 24.0)

        def row_box(sb: Box, i: i64) -> Box:
            box(sb.x + 8.0, sb.y + 272.0 + i.f32() * (ROW + 4.0), sb.w - 16.0, ROW)

        def add_label(k: i64) -> sview:
            return "Smooth" if k == 1
            return "Median" if k == 2
            return "Wring" if k == 3
            return "Seam" if k == 4
            "Despike"

        def stack_hit(sb: Box, s: StackState::Stack&, px: f32, py: f32) -> i64:
            for k in 0..<ADD_KINDS |k, sb, px, py|:
                return HIT_ADD * 100 + k if inside(add_box(sb, k), px, py)
            for i in 0..<s.count |i, sb, px, py|:
                r: Box = row_box(sb, i)
                if inside(r, px, py):
                    return HIT_TOGGLE * 100 + i if px < r.x + 34.0
                    return HIT_REMOVE * 100 + i if px >= r.x + r.w - 30.0
                    return HIT_DOWN * 100 + i if px >= r.x + r.w - 58.0
                    return HIT_UP * 100 + i if px >= r.x + r.w - 86.0
                    return HIT_SELECT * 100 + i
            return -1

        # The labelled File control sits in the sidebar title row. Its popup
        # opens downwards over the panel so it remains reachable at any size.
        def file_button_box(sb: Box) -> Box:
            box(sb.x + sb.w - 76.0, sb.y + 8.0, 64.0, 28.0)

        def file_popup_box(sb: Box) -> Box:
            box(sb.x + sb.w - FILE_MENU_WIDTH - 8.0, sb.y + 38.0, FILE_MENU_WIDTH, FILE_MENU_ROW * StudioFilePolicy::ROWS.f32() + 8.0)

        def file_popup_contains(sb: Box, px: f32, py: f32) -> bool:
            inside(file_popup_box(sb), px, py)

        def file_popup_row(sb: Box, px: f32, py: f32) -> i64:
            p: Box = file_popup_box(sb)
            return -1 if not inside(p, px, py)
            row: i64 = ((py - p.y - 4.0) / FILE_MENU_ROW).i64()
            return row if row >= 0 and row < StudioFilePolicy::ROWS else -1

        def file_menu_label(row: i64) -> sview:
            return "Open Take..." if row == 0
            return "Open Session..." if row == 1
            return "Save Session" if row == 2
            return "Save Session As..." if row == 3
            return "Export Cleaned GLB" if row == 4
            "Export As..."

        def file_menu_shortcut(row: i64) -> sview:
            return "Cmd-O" if row == 0
            return "Cmd-Shift-O" if row == 1
            return "Cmd-S" if row == 2
            return "Cmd-Shift-S" if row == 3
            return "E" if row == 4
            "Cmd-E"

        def file_menu_panel(sb: Box, opened: bool, has_take: bool, focus: i64, hover: i64) -> void:
            button: Box = file_button_box(sb)
            StudioDraw::rect(button.x, button.y, button.w, button.h, StudioDraw::color(58, 52, 40) if opened else StudioDraw::panel())
            StudioDraw::bold(button.x + 10.0, button.y + 6.0, 13.0, "File", StudioDraw::ink())
            StudioDraw::tri(button.x + button.w - 17.0, button.y + 11.0, button.x + button.w - 7.0, button.y + 11.0, button.x + button.w - 12.0, button.y + 17.0, StudioDraw::muted())
            return if not opened
            popup: Box = file_popup_box(sb)
            StudioDraw::rect(popup.x, popup.y, popup.w, popup.h, StudioDraw::color(21, 24, 31))
            StudioDraw::segment(popup.x, popup.y, popup.x + popup.w, popup.y, 1.0, StudioDraw::color(82, 91, 108))
            StudioDraw::segment(popup.x + popup.w, popup.y, popup.x + popup.w, popup.y + popup.h, 1.0, StudioDraw::color(82, 91, 108))
            StudioDraw::segment(popup.x + popup.w, popup.y + popup.h, popup.x, popup.y + popup.h, 1.0, StudioDraw::color(82, 91, 108))
            StudioDraw::segment(popup.x, popup.y + popup.h, popup.x, popup.y, 1.0, StudioDraw::color(82, 91, 108))
            for row in 0..<StudioFilePolicy::ROWS |row, popup, focus, hover, has_take|:
                y: f32 = popup.y + 4.0 + row.f32() * FILE_MENU_ROW
                enabled: bool = StudioFilePolicy::enabled(StudioFilePolicy::action(row), has_take)
                col: UiCore::Color = StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117)
                if row == focus or row == hover:
                    StudioDraw::rect(popup.x + 4.0, y, popup.w - 8.0, FILE_MENU_ROW, StudioDraw::color(47, 55, 70))
                    StudioDraw::rect(popup.x + 4.0, y + 4.0, 2.0, FILE_MENU_ROW - 8.0, StudioDraw::accent()) if row == focus
                StudioDraw::text(popup.x + 14.0, y + 7.0, 12.0, file_menu_label(row), col)
                StudioDraw::text(popup.x + popup.w - 78.0, y + 7.0, 10.0, file_menu_shortcut(row), StudioDraw::muted() if enabled else StudioDraw::color(75, 80, 91))

        def replacement_dialog_box(w: f32, h: f32) -> Box:
            box((w - 500.0) / 2.0, (h - 210.0) / 2.0, 500.0, 210.0)

        def replacement_button_box(w: f32, h: f32, index: i64) -> Box:
            d: Box = replacement_dialog_box(w, h)
            box(d.x + 22.0 + index.f32() * 152.0, d.y + 150.0, 136.0, 38.0)

        def replacement_button_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for index in 0..<StudioReplacement::CHOICES |index, w, h, px, py|:
                return index if inside(replacement_button_box(w, h, index), px, py)
            -1

        def replacement_prompt_panel(w: f32, h: f32, opened: bool, focus: i64, save_failed: bool, closing: bool) -> void:
            return if not opened
            d: Box = replacement_dialog_box(w, h)
            StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
            StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.2, StudioDraw::color(104, 115, 134))
            StudioDraw::bold(d.x + 22.0, d.y + 20.0, 18.0, "Unsaved session changes", StudioDraw::ink())
            mutable message: sview = "Opening another file replaces the current cleanup session."
            message <- "Closing the studio would discard the current cleanup session." if closing
            StudioDraw::text(d.x + 22.0, d.y + 58.0, 13.0, message, StudioDraw::ink())
            message <- "Save writes the current session before opening the selected file."
            message <- "Save writes the current session before closing the studio." if closing
            StudioDraw::text(d.x + 22.0, d.y + 80.0, 12.0, message, StudioDraw::muted())
            StudioDraw::text(d.x + 22.0, d.y + 104.0, 12.0, "Save failed. Check the status bar, then retry, discard or cancel.", StudioDraw::color(245, 145, 100)) if save_failed
            StudioDraw::text(d.x + 22.0, d.y + 124.0, 11.0, "Left/Right choose   Enter select   S save   D discard   Esc cancel", StudioDraw::muted())
            for index in 0..<StudioReplacement::CHOICES |index, w, h, focus|:
                b: Box = replacement_button_box(w, h, index)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if index == focus else StudioDraw::panel())
                mutable label: sview = "Save and Open"
                label <- "Save and Close" if closing
                label <- "Discard and Open" if index == StudioReplacement::FOCUS_DISCARD
                label <- "Discard and Close" if closing and index == StudioReplacement::FOCUS_DISCARD
                label <- "Cancel" if index == StudioReplacement::FOCUS_CANCEL
                StudioDraw::bold(b.x + 10.0, b.y + 11.0, 12.0, label, StudioDraw::ink())
                StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if index == focus

        # Frame rate of the loaded clip, set by the app when a clip is built.
        global mutable shown_rate: i64 = Timeline::RATE

        def set_rate(r: i64) -> void:
            shown_rate <- r

        # "<n> fr (<ms> ms)" for a frame count at the clip rate.
        def frames_put(n: i64) -> void:
            StudioText::put_i(n)
            StudioText::put(" fr (")
            StudioText::put_i(StudioChrome::clip_millis(n, shown_rate) if n >= 0 and n <= StudioChrome::CHROME_FRAMES and shown_rate >= 1 and shown_rate <= StudioChrome::CHROME_RATE_MAX else 0)
            StudioText::put(" ms)")

        # An operation's strength with its unit (StudioChrome::param_unit).
        def param_put(op: Ops::Operation) -> void:
            unit: i64 = StudioChrome::param_unit(SessionState::kind_code(op.kind))
            if unit == StudioChrome::UNIT_PASSES:
                StudioText::put_i(op.strength)
                StudioText::put("\u00d7 passes")
            elif unit == StudioChrome::UNIT_FRAMES:
                StudioText::put("radius " if op.kind == Ops::Kind.Median else "window ")
                frames_put(op.strength)
            elif unit == StudioChrome::UNIT_DEGREES:
                StudioText::put("limit \u00b1")
                StudioText::put_i(StudioChrome::wring_degrees(op.strength) if op.strength >= 0 and op.strength <= StudioChrome::CHROME_REACH else 0)
                StudioText::put("\u00b0")
            else:
                StudioText::put("auto")

        def param_text(op: Ops::Operation) -> sview:
            StudioText::begin()
            param_put(op)
            return StudioText::view()

        # Micro-units (micrometres) as millimetres with three decimals.
        # Last path component of `path` (the status line has no room for
        # folders; StudioText cuts anything past its slot width).
        def file_name_put(path: cstr) -> void:
            mutable n: usize = 0
            mutable cut: usize = 0
            while path[n] != 0 and n < 4096:
                cut <- n + 1 if path[n] == 47 else cut
                n <- n + 1
            for i in cut..<n |i, path|:
                StudioText::byte(path[i])

        def mm_put(micro: i64) -> void:
            StudioText::put_fixed3(micro * 1000 if micro >= 0 - 1000000000 and micro <= 1000000000 else 0)
            StudioText::put(" mm")

        def scope_text(op: Ops::Operation, frames: i64) -> sview:
            last: i64 = op.last if op.last < frames else frames - 1
            return StudioText::pair("frames ", op.first, "-", last)

        def stack_panel(sb: Box, s: StackState::Stack&, c: StudioModel::Clip&, history_cursor: i64, history_count: i64) -> void:
            StudioDraw::rect(sb.x, sb.y, sb.w, sb.h, StudioDraw::color(24, 27, 35))
            StudioDraw::bold(sb.x + 12.0, sb.y + 12.0, 18.0, "Mocap Studio", StudioDraw::ink())
            StudioDraw::text(sb.x + 12.0, sb.y + 38.0, 12.0, StudioText::pair("frames ", c.frames, "   bones ", c.nodes.count.i64()), StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, sb.y + 56.0, 12.0, StudioText::pair("spikes source ", c.spikes_before, "  cleaned ", c.spikes_after), StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, sb.y + 74.0, 12.0, StudioText::pair("history ", history_cursor + 1, " / ", history_count), StudioDraw::muted())
            StudioDraw::bold(sb.x + 12.0, sb.y + 180.0, 14.0, "Operation stack", StudioDraw::ink())
            for k in 0..<ADD_KINDS |k, sb|:
                b: Box = add_box(sb, k)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::panel())
                StudioIcons::draw(StudioIcons::PLUS, b.x + 2.0, b.y + 4.0, 16.0, StudioDraw::accent())
                StudioDraw::text(b.x + 20.0, b.y + 5.0, 12.0, add_label(k), StudioDraw::ink())
            for i in 0..<s.count |i, sb, s, c|:
                r: Box = row_box(sb, i)
                op: Ops::Operation = s.ops[i]
                selected: bool = i == s.selected
                StudioDraw::rect(r.x, r.y, r.w, r.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                col: UiCore::Color = StudioDraw::ink() if op.enabled else StudioDraw::color(96, 100, 112)
                # Title, then bones and scope, then the parameter: each
                # line stays left of the icon column (r.w - 90).
                StudioIcons::draw(StudioIcons::EYE if op.enabled else StudioIcons::EYE_OFF, r.x + 6.0, r.y + 19.0, 20.0, col)
                StudioDraw::bold(r.x + 36.0, r.y + 5.0, 13.0, StackState::kind_label(op.kind), col)
                StudioDraw::text(r.x + 36.0, r.y + 23.0, 11.0, StackState::bones_label(op.bones), StudioDraw::muted())
                StudioDraw::text(r.x + 100.0, r.y + 23.0, 11.0, scope_text(op, c.frames), StudioDraw::muted())
                StudioDraw::text(r.x + 36.0, r.y + 39.0, 11.0, param_text(op), StudioDraw::muted())
                StudioIcons::draw(StudioIcons::UP, r.x + r.w - 84.0, r.y + 19.0, 20.0, col)
                StudioIcons::draw(StudioIcons::DOWN, r.x + r.w - 56.0, r.y + 19.0, 20.0, col)
                StudioIcons::draw(StudioIcons::TRASH, r.x + r.w - 28.0, r.y + 19.0, 20.0, StudioDraw::color(230, 110, 100))
            help: f32 = sb.y + sb.h - 150.0
            StudioDraw::text(sb.x + 12.0, help, 11.0, "Space play  Left/Right step  S speed  L loop", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 16.0, 11.0, "Z undo  Y redo  D toggle op  Del remove", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 32.0, 11.0, "PgUp/PgDn move op  [ ] strength  B bones", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 48.0, 11.0, "I / O scope at playhead  1-5 add op", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 64.0, 11.0, "T trails C contacts H heat N onion G ghost", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 80.0, 11.0, "X x-ray M mesh F frame E export", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 96.0, 11.0, "Drag: orbit  right drag: pan  click: pick", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 112.0, 11.0, "Q balance overlay  P curve rotation/position", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help + 128.0, 11.0, "R rotate / V move gizmo (live preview)", StudioDraw::muted())
            StudioDraw::text(sb.x + 12.0, help - 96.0, 11.0, "Retime: Shift-drag timeline", StudioDraw::accent())
            StudioDraw::text(sb.x + 12.0, help - 80.0, 11.0, "Shift-1..7 preset  = type speed  Esc", StudioDraw::accent())
            StudioDraw::text(sb.x + 12.0, help - 64.0, 11.0, "Drag band edge  Del band", StudioDraw::accent())
            StudioDraw::text(sb.x + 12.0, help - 48.0, 11.0, "K feet  J hands  W worst slide  , . blend", StudioDraw::accent())
            StudioDraw::text(sb.x + 12.0, help - 32.0, 11.0, "Contact bars: drag ends,", StudioDraw::accent())
            StudioDraw::text(sb.x + 12.0, help - 16.0, 11.0, "click run lifts, click gap plants", StudioDraw::accent())

        # ---- foot cleanup ------------------------------------------------
        # Rows of the timeline strip a press on a contact bar lands in:
        # left/right foot, left/right hand, or -1.
        def contact_row(tb: Box, py: f32) -> i64:
            s: Box = strip(tb)
            return StackState::LEFT if py >= s.y + 44.0 and py < s.y + 56.0
            return StackState::RIGHT if py >= s.y + 56.0 and py < s.y + 68.0
            return StackState::LEFT_HAND if py >= s.y + 68.0 and py < s.y + 80.0
            return StackState::RIGHT_HAND if py >= s.y + 80.0 and py < s.y + 92.0
            -1

        def cue_color(cue: i64) -> UiCore::Color:
            return StudioDraw::color(110, 220, 130) if cue == StudioFoot::BETTER
            return StudioDraw::color(240, 80, 80) if cue == StudioFoot::WORSE
            StudioDraw::muted()

        # Timeline extras: red worst-slide ticks over frames whose planted
        # slide earns a marker, the worst frame ringed, and the hovered
        # contact row outlined.
        def foot_marks(tb: Box, c: StudioModel::Clip&, hover: i64) -> void:
            s: Box = strip(tb)
            n: i64 = c.foot_slide.count.i64()
            return if n < 1
            # Binned like the problem markers (draw-command budget).
            bins: i64 = MARKER_BINS if n > MARKER_BINS else n
            for b in 0..<bins |b, bins, n, s, c|:
                first: i64 = b * n / bins
                last: i64 = (b + 1) * n / bins
                mutable hit: bool = false
                for f in first..<last |f, c, hit|:
                    hit <- hit or StudioFoot::marked(c.foot_slide[f.usize()])
                if hit:
                    x0: f32 = frame_x(s, first, n)
                    x1: f32 = frame_x(s, last, n)
                    StudioDraw::rect(x0, s.y + 10.0, x1 - x0 if x1 - x0 > 2.0 else 2.0, 4.0, StudioDraw::color(240, 70, 70))
            if c.worst_frame >= 0 and c.worst_frame < n and StudioFoot::marked(c.worst_slide):
                StudioDraw::tri(frame_x(s, c.worst_frame, n) - 4.0, s.y + 2.0, frame_x(s, c.worst_frame, n) + 4.0, s.y + 2.0, frame_x(s, c.worst_frame, n), s.y + 10.0, StudioDraw::color(255, 90, 90))
            if hover >= StackState::LEFT and hover <= StackState::RIGHT_HAND:
                mutable y: f32 = s.y + 45.0
                y <- s.y + 57.0 if hover == StackState::RIGHT
                y <- s.y + 69.0 if hover == StackState::LEFT_HAND
                y <- s.y + 81.0 if hover == StackState::RIGHT_HAND
                mutable flags: darray[bool] = c.left_contact
                flags <- c.right_contact if hover == StackState::RIGHT
                flags <- c.left_hand_contact if hover == StackState::LEFT_HAND
                flags <- c.right_hand_contact if hover == StackState::RIGHT_HAND
                mutable col: UiCore::Color = StudioDraw::color(150, 255, 170)
                col <- StudioDraw::color(255, 240, 130) if hover == StackState::RIGHT
                col <- StudioDraw::color(140, 210, 255) if hover == StackState::LEFT_HAND
                col <- StudioDraw::color(255, 180, 130) if hover == StackState::RIGHT_HAND
                StudioDraw::rect(s.x, y, s.w, 10.0, StudioDraw::color(60, 66, 90))
                contact_bar(s, flags, y + 1.0, col)

        # Before/after metrics for each enabled detector. Distances use
        # micro-units and ease from the previous build's values.
        def cleanup_readout(sb: Box, c: StudioModel::Clip&, shown_slide: i64, shown_sink: i64, shown_hand_slide: i64, blend: i64) -> void:
            y: f32 = sb.y + 118.0
            StudioText::begin()
            StudioText::put("feet ")
            StudioText::put("on" if c.feet else "off")
            StudioText::put("  hands ")
            StudioText::put("on" if c.hands else "off")
            StudioText::put("  blend ")
            frames_put(blend)
            StudioDraw::text(sb.x + 12.0, y - 30.0, 10.0, StudioText::view(), StudioDraw::muted())
            StudioText::begin()
            StudioText::put("spikes ")
            StudioText::put_i(c.spikes_before)
            StudioText::put(" -> ")
            StudioText::put_i(c.spikes_after)
            StudioDraw::text(sb.x + 12.0, y - 16.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.spikes_before, c.spikes_after)))
            StudioText::begin()
            StudioText::put("balance impossible ")
            StudioText::put_i(c.source_impossible_frames)
            StudioText::put(" -> ")
            StudioText::put_i(c.impossible_frames)
            StudioDraw::text(sb.x + 12.0, y - 2.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.source_impossible_frames, c.impossible_frames)))
            StudioText::begin()
            StudioText::put("foot slide ")
            mm_put(c.slide_before)
            StudioText::put(" -> ")
            mm_put(shown_slide)
            StudioDraw::text(sb.x + 12.0, y + 12.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.slide_before, c.slide_after)))
            StudioText::begin()
            StudioText::put("foot sink ")
            mm_put(c.sink_before)
            StudioText::put(" -> ")
            mm_put(shown_sink)
            StudioDraw::text(sb.x + 12.0, y + 26.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.sink_before, c.sink_after)))
            StudioText::begin()
            StudioText::put("hand slide ")
            mm_put(c.hand_slide_before)
            StudioText::put(" -> ")
            mm_put(shown_hand_slide)
            StudioDraw::text(sb.x + 12.0, y + 40.0, 10.0, StudioText::view(), cue_color(StudioFoot::cue(c.hand_slide_before, c.hand_slide_after)))
