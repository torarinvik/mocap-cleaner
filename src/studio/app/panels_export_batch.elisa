include "panels_geometry.elisa"
include "../export_batch_panel_policy.elisa"

# Rendering and hit geometry for the durable export batch sheet. The caller
# supplies display snapshots; queue identities and review tokens stay private
# inside StudioExportBatchReviewBinding.
extend StudioPanels:
    private:
        const module BatchLayout:
            WIDTH: f32 = 960.0
            HEIGHT: f32 = 640.0
            HEADER: f32 = 60.0
            ROW_TOP: f32 = 144.0
            ROW_HEIGHT: f32 = 52.0
            ROW_VISIBLE: i64 = StudioExportBatchPanelPolicy::Page::ROWS
            ACTION_X: f32 = 22.0
            ACTION_Y: f32 = 530.0
            ACTION_W: f32 = 110.0
            ACTION_H: f32 = 34.0
            ACTION_GAP: f32 = 8.0
            ACTION_COLUMNS: i64 = 7
            SECOND_ROW_Y: f32 = 574.0
            INSET: f32 = 22.0

        const module BatchEntryLayout:
            RIGHT_OFFSET: f32 = 250.0
            TOP: f32 = 5.0
            WIDTH: f32 = 112.0
            HEIGHT: f32 = 28.0
            TEXT_X: f32 = 8.0
            TEXT_Y: f32 = 9.0
            FONT_SIZE: f32 = 11.0

    public:
        def export_batch_entry_box(w: f32) -> Box:
            box(w - BatchEntryLayout::RIGHT_OFFSET, BatchEntryLayout::TOP, BatchEntryLayout::WIDTH, BatchEntryLayout::HEIGHT)

        def export_batch_entry_hit(w: f32, x: f32, y: f32) -> bool:
            inside(export_batch_entry_box(w), x, y)

        def export_batch_entry(w: f32) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                b: Box = export_batch_entry_box(w)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(39, 45, 57))
                StudioDraw::text(b.x + BatchEntryLayout::TEXT_X, b.y + BatchEntryLayout::TEXT_Y, BatchEntryLayout::FONT_SIZE, "Export queue", StudioDraw::ink())

        def export_batch_bounds(w: f32, h: f32) -> Box:
            box((w - BatchLayout::WIDTH) / 2.0, (h - BatchLayout::HEIGHT) / 2.0, BatchLayout::WIDTH, BatchLayout::HEIGHT)

        def export_batch_row_box(w: f32, h: f32, visible_row: i64) -> Box:
            requires visible_row >= 0 and visible_row < BatchLayout::ROW_VISIBLE
            d: Box = export_batch_bounds(w, h)
            box(d.x + BatchLayout::INSET,
                d.y + BatchLayout::ROW_TOP + visible_row.f32() * BatchLayout::ROW_HEIGHT,
                d.w - 2.0 * BatchLayout::INSET, BatchLayout::ROW_HEIGHT - 3.0)

        def export_batch_row_hit(w: f32, h: f32, x: f32, y: f32,
                visible_count: i64, first_row: i64) -> i64:
            requires visible_count >= 0 and visible_count <= BatchLayout::ROW_VISIBLE
            requires first_row >= 0 and first_row <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            ensure result >= -1
            ensure result < 0 or result < first_row + visible_count
            d: Box = export_batch_bounds(w, h)
            return -1 if not inside(box(d.x + BatchLayout::INSET, d.y + BatchLayout::ROW_TOP,
                d.w - 2.0 * BatchLayout::INSET, BatchLayout::ROW_HEIGHT * BatchLayout::ROW_VISIBLE.f32()), x, y)
            offset: i64 = ((y - d.y - BatchLayout::ROW_TOP) / BatchLayout::ROW_HEIGHT).i64()
            StudioExportBatchPanelPolicy::visible_row(first_row, visible_count, offset)

        def export_batch_action_bounds(w: f32, h: f32, focus: StudioExportBatchPanelPolicy::Focus) -> Box:
            d: Box = export_batch_bounds(w, h)
            slot: i64 = focus.i64()
            row: i64 = slot / BatchLayout::ACTION_COLUMNS
            column: i64 = slot % BatchLayout::ACTION_COLUMNS
            box(d.x + BatchLayout::ACTION_X + column.f32() * (BatchLayout::ACTION_W + BatchLayout::ACTION_GAP),
                d.y + (BatchLayout::ACTION_Y if row == 0 else BatchLayout::SECOND_ROW_Y), BatchLayout::ACTION_W, BatchLayout::ACTION_H)

        def export_batch_action_hit(w: f32, h: f32, x: f32, y: f32) -> StudioExportBatchPanelPolicy::Action:
            for code in 0..<StudioExportBatchPanelPolicy::FocusDomain::COUNT |code, w, h, x, y|:
                if StudioExportBatchPanelPolicy::focus_from_code(code) is focus:
                    if inside(export_batch_action_bounds(w, h, focus), x, y):
                        return StudioExportBatchPanelPolicy::action_for_focus(focus)
            StudioExportBatchPanelPolicy::Action.None

        def export_batch_panel(w: f32, h: f32, rows: darray[StudioExportBatchPanelPolicy::Row]&, first_row: i64,
                selected: i64, focus: StudioExportBatchPanelPolicy::Focus, controls: StudioExportBatchPanelPolicy::Controls,
                message: sview) -> void can[Global{Read, Write}]:
            requires first_row >= 0 and first_row <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS and selected >= -1
            requires rows.count.i64() <= StudioExportBatchQueuePolicy::Capacity::MAX_ITEMS
            can Global{Read, Write}:
                d: Box = export_batch_bounds(w, h)
                StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
                StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
                StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.3, StudioDraw::color(104, 115, 134))
                StudioDraw::bold(d.x + BatchLayout::INSET, d.y + 20.0, 19.0, "Prepared exports", StudioDraw::ink())
                StudioDraw::text(d.x + BatchLayout::INSET, d.y + 48.0, 11.0,
                    "Queue reviewed take exports, inspect warning reports, and preserve recoverable outputs.", StudioDraw::muted())
                StudioDraw::text(d.x + BatchLayout::INSET, d.y + 78.0, 12.0, message, StudioDraw::color(232, 190, 116)) if message.len > 0
                if rows.count == 0:
                    StudioDraw::bold(d.x + BatchLayout::INSET + 10.0, d.y + BatchLayout::ROW_TOP + 20.0,
                        16.0, "No prepared exports", StudioDraw::ink())
                    StudioDraw::text(d.x + BatchLayout::INSET + 10.0, d.y + BatchLayout::ROW_TOP + 48.0,
                        12.0, "Review a take's export, then add its captured result to this queue.", StudioDraw::muted())
                    StudioDraw::text(d.x + BatchLayout::INSET + 10.0, d.y + BatchLayout::ROW_TOP + 70.0,
                        12.0, "An empty queue has no completed production result.", StudioDraw::muted())
                for visible in 0..<BatchLayout::ROW_VISIBLE |visible, rows, first_row, selected, d|:
                    index: i64 = first_row + visible
                    y: f32 = d.y + BatchLayout::ROW_TOP + visible.f32() * BatchLayout::ROW_HEIGHT
                    bg: UiCore::Color = StudioDraw::color(52, 60, 75) if index == selected else StudioDraw::color(31, 36, 47)
                    StudioDraw::rect(d.x + BatchLayout::INSET, y, d.w - 2.0 * BatchLayout::INSET, BatchLayout::ROW_HEIGHT - 3.0, bg) if index < rows.count.i64()
                    if index < rows.count.i64():
                        row: StudioExportBatchPanelPolicy::Row = rows[index.usize()]
                        StudioDraw::text(d.x + BatchLayout::INSET + 10.0, y + 8.0, 12.0, row.label, StudioDraw::ink())
                        StudioDraw::text(d.x + 360.0, y + 8.0, 11.0, StudioExportBatchPanelPolicy::row_state(row.state, row.approved), state_color(row.state))
                        StudioText::begin()
                        StudioText::put("Output: ")
                        StudioText::put(row.output_label)
                        StudioDraw::text(d.x + BatchLayout::INSET + 10.0, y + 23.0, 9.0, StudioText::view(), StudioDraw::muted())
                        StudioText::begin()
                        StudioText::put("Attempt ")
                        StudioText::put_i(row.attempt)
                        StudioText::put("   Warnings ")
                        StudioText::put_i(row.warning_count)
                        StudioText::put("   ")
                        StudioText::put(StudioExportBatchPanelPolicy::receipt_summary(row.receipt))
                        StudioDraw::text(d.x + BatchLayout::INSET + 10.0, y + 37.0, 9.0, StudioText::view(), StudioDraw::muted())
                for code in 0..<StudioExportBatchPanelPolicy::FocusDomain::COUNT |code, w, h, focus, controls|:
                    if StudioExportBatchPanelPolicy::focus_from_code(code) is control:
                        b: Box = export_batch_action_bounds(w, h, control)
                        enabled: bool = StudioExportBatchPanelPolicy::action_enabled(control, controls)
                        StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(65, 78, 102) if focus == control else StudioDraw::color(39, 45, 57))
                        StudioDraw::segment(b.x, b.y, b.x + b.w, b.y, 1.0, StudioDraw::accent()) if focus == control
                        StudioDraw::text(b.x + 10.0, b.y + 11.0, 10.0, StudioExportBatchPanelPolicy::action_label(control), StudioDraw::ink() if enabled else StudioDraw::color(95, 99, 108))
                StudioDraw::text(d.x + BatchLayout::INSET, d.y + d.h - 14.0, 9.0,
                    "Tab moves controls   Enter activates   Esc closes   Closing keeps prepared exports and recovery files.", StudioDraw::muted())

        def state_color(state: StudioExportBatchQueuePolicy::ItemState) -> UiCore::Color:
            return StudioDraw::color(128, 205, 154) if state == StudioExportBatchQueuePolicy::ItemState.Passed
            return StudioDraw::color(245, 180, 94) if state == StudioExportBatchQueuePolicy::ItemState.Warning or state == StudioExportBatchQueuePolicy::ItemState.AwaitingReview
            return StudioDraw::color(244, 145, 118) if state == StudioExportBatchQueuePolicy::ItemState.Failed or state == StudioExportBatchQueuePolicy::ItemState.Recoverable
            StudioDraw::ink()
