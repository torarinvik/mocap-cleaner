        global mutable file_menu_focus: i64 = 0
        global mutable file_menu_hover: i64 = -1
        global mutable reset_menu_open: bool = false
        global mutable export_review_open: bool = false
        global mutable export_review_acknowledged: bool = false
        global mutable export_review_focus: i64 = StudioExportReview::EXPORT
        global mutable export_review_path: cstr = ""
        global mutable export_review_overwrite: bool = false
        global mutable export_review_warning_selected: i64 = 0
        global mutable export_warning_detail_open: bool = false
        global mutable export_warning_detail_index: i64 = 0
        global mutable export_warning_detail_focus: i64 = StudioExportPathReview::DONE
        global mutable export_path_inspector_open: bool = false
        global mutable export_path_inspector_page: i64 = 0
        global mutable export_path_inspector_focus: i64 = StudioExportPathReview::DONE
        global mutable export_result_open: bool = false
        global mutable export_report_saved: bool = false
        global mutable export_result_path: cstr = ""
        global mutable export_result_focus: i64 = StudioExportResult::OPEN
        global mutable replacement_prompt_open: bool = false
        global mutable replacement_is_close: bool = false
        global mutable replacement_is_termination: bool = false
        global mutable replacement_focus: i64 = StudioReplacement::FOCUS_SAVE
        global mutable replacement_save_failed: bool = false
        global mutable legacy_prompt_open: bool = false
        global mutable legacy_prompt_focus: i64 = StudioLegacyPrompt::FOCUS_CANCEL
        # One-shot authorization consumed by the synchronous native close
        # callback after Save or Discard is chosen in the confirmation panel.
        global mutable close_authorized: bool = false
        global mutable termination_authorized: bool = false
        # Last one-click clean: permille of slide and spikes removed, or -1.
        global mutable gain_slide: i64 = -1
        global mutable gain_spikes: i64 = -1
        # Skinned mesh of the clip's character, loaded once, and its pose
        # cached per (frame, revision).
        global mutable mesh: GlbSkinMesh::Mesh? = null
        global mutable skinned: darray[Geometry::Vec3]? = null
        global mutable skinned_frame: i64 = -1
        global mutable skinned_revision: i64 = -1
        # A separate character model (Shift-M, or the third command-line
        # argument), bound to the take's rig by joint name; it is drawn
        # instead of the take's own mesh while its binding is drawable.
        # `take_serial` counts takes opened so the binding follows them.
        global mutable model_path: cstr = ""
        global mutable model_requested: bool = false
        global mutable character: StudioCharacter::Model? = null
        global mutable character_binding: StudioCharacter::Binding? = null
        global mutable character_take: i64 = -1
        global mutable take_serial: i64 = 0
        # Gizmo: GizmoPolicy mode, or -1 when hidden; the drag and its view.
        global mutable gizmo_mode: i64 = -1
        global mutable gizmo_drag: ViewportGizmo::Drag? = null
        global mutable gizmo_view: i64 = -1
        # Pose goal of the running gizmo drag, for the live preview.
        global mutable gizmo_goal: Geometry::Transform? = null
        # Curve view channel (StudioOverlay::ROTATION or POSITION).
        global mutable curve_mode: i64 = 0
        # Held modifiers (StudioShortcuts mask).
        global mutable modifiers: i64 = 0
        # Phase 6 caches: the loaded take and op caches, the stack the clip
        # was built from, a counter bumped per rebuild, the curve memo, the
        # drag preview's base pose (per frame and build), and the Shift-F
        # frame-time overlay with the last draw time.
        global mutable memo: StudioModel::Memo? = null
        global mutable built_stack: StackState::Stack? = null
        global mutable built: i64 = 0
        global mutable rig_source_revision: i64 = 0
        global mutable curve_memo: StudioPerf::Curves = zeroed
        global mutable base_models: darray[Geometry::Transform] = zeroed
        global mutable base_locals: darray[Geometry::Transform] = zeroed
        global mutable base_frame: i64 = -1
        global mutable base_built: i64 = -1
        global mutable perf_overlay: bool = false
        global mutable draw_us: i64 = 0
        global mutable preview_moved: i64 = 0

        global mutable view0: Viewport::Viewport? = null
        global mutable view1: Viewport::Viewport? = null
        global mutable view2: Viewport::Viewport? = null
        global mutable seen0: i64 = -1
        global mutable seen1: i64 = -1
        global mutable seen2: i64 = -1
        global mutable shown0: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable shown1: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable shown2: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable framed: bool = false
        global mutable accessibility_toolbar_widgets: usize[StudioPanels::BUTTONS.usize()] = zeroed
        global mutable accessibility_toolbar_ready: bool = false
        global mutable accessibility_file_trigger_widget: usize = 0
        global mutable accessibility_file_menu_widgets: usize[StudioFilePolicy::ROWS.usize()] = zeroed
        global mutable accessibility_file_ready: bool = false
        global mutable accessibility_storage_action_widgets: usize[StudioPanels::STORAGE_ACTION_COUNT.usize()] = zeroed
        global mutable accessibility_storage_row_widgets: usize[StudioStorageAccessibilityPolicy::ROW_COUNT.usize()] = zeroed
        global mutable accessibility_storage_row_indices: i64[StudioStorageAccessibilityPolicy::ROW_COUNT.usize()] = zeroed
        global mutable accessibility_storage_ready: bool = false
        global mutable accessibility_review_ack_widget: usize = 0
        global mutable accessibility_review_destination_widget: usize = 0
        global mutable accessibility_review_cancel_widget: usize = 0
        global mutable accessibility_review_export_widget: usize = 0
        global mutable accessibility_review_warning_widgets: usize[StudioExportReview::MAX_WARNINGS.usize()] = zeroed
        global mutable accessibility_review_ready: bool = false
        global mutable accessibility_warning_previous_widget: usize = 0
        global mutable accessibility_warning_next_widget: usize = 0
        global mutable accessibility_warning_done_widget: usize = 0
        global mutable accessibility_warning_ready: bool = false
        global mutable accessibility_path_previous_widget: usize = 0
        global mutable accessibility_path_next_widget: usize = 0
        global mutable accessibility_path_done_widget: usize = 0
        global mutable accessibility_path_ready: bool = false
        global mutable accessibility_result_open_widget: usize = 0
        global mutable accessibility_result_folder_widget: usize = 0
        global mutable accessibility_result_done_widget: usize = 0
        global mutable accessibility_result_ready: bool = false
        global mutable accessibility_contact_plant_widget: usize = 0
        global mutable accessibility_contact_lift_widget: usize = 0
        global mutable accessibility_contact_reset_widget: usize = 0
        global mutable accessibility_contact_delete_widget: usize = 0
        global mutable accessibility_contact_merge_widget: usize = 0
        global mutable accessibility_contact_split_widget: usize = 0
        global mutable accessibility_contact_ready: bool = false
        global mutable accessibility_reset_trigger_widget: usize = 0
        global mutable accessibility_reset_contacts_widget: usize = 0
        global mutable accessibility_reset_corrections_widget: usize = 0
        global mutable accessibility_reset_source_widget: usize = 0
        global mutable accessibility_reset_ready: bool = false
        global mutable accessibility_stack_duplicate_widget: usize = 0
        global mutable accessibility_stack_ready: bool = false
        global mutable accessibility_issue_previous_widget: usize = 0
        global mutable accessibility_issue_next_widget: usize = 0
        global mutable accessibility_issue_worst_widget: usize = 0
        global mutable accessibility_issue_filter_widgets: usize[4] = zeroed
        global mutable accessibility_issue_filter_reset_widget: usize = 0
        global mutable accessibility_issue_intent_widget: usize = 0
        global mutable accessibility_issue_filter_ready: bool = false
        global mutable accessibility_issue_row_widgets: usize[StudioPanels::ISSUE_FILTERED_ROWS.usize()] = zeroed
        global mutable accessibility_issue_ready: bool = false

        global mutable drag_view: i64 = -1
        global mutable drag_button: i32 = -1
        global mutable scrubbing: bool = false
        global mutable last_x: f32 = 0.0
        global mutable last_y: f32 = 0.0
        global mutable down_x: f32 = 0.0
        global mutable down_y: f32 = 0.0
        # Foot cleanup: the contact-bar press in progress, the hovered
        # contact row (StackState::LEFT/RIGHT or -1), and the readout
        # transition (values shown before the last rebuild, and its start).
        global mutable foot_press: FootState::Press = FootState::Press{side: -1, part: 0, first: -1, last: -1, frame: -1}
        global mutable contact_selected_side: i64 = StudioContactEditor::NO_SIDE
        global mutable contact_selected_frame: i64 = -1
        global mutable contact_draft_target: i64 = -1
        global mutable contact_draft_side: i64 = StudioContactEditor::NO_SIDE
        global mutable contact_draft_frame: i64 = -1
        global mutable hover_row: i64 = -1
        global mutable shown_slide: i64 = 0
        global mutable shown_sink: i64 = 0
        global mutable shown_hand_slide: i64 = 0
        global mutable readout_start: f64 = 0.0
        # Retiming: Shift-drag selection (output frames), band edge drag,
        # focused band (Delete removes it), slider and typed speed.
        global mutable selection: RetimeState::Selection = RetimeState::Selection{active: false, anchor: -1, head: -1}
        global mutable selecting: bool = false
        global mutable edge_drag: RetimeState::EdgeDrag = RetimeState::EdgeDrag{band: -1, last_edge: false}
        global mutable band_focus: i64 = -1
        global mutable slider_drag: bool = false
        global mutable retime_speed: i64 = 1000
        global mutable slider_start_speed: i64 = 1000
        global mutable typing: bool = false
        global mutable typed: u8[8] = zeroed
        global mutable typed_len: i64 = 0
        const READOUT_MS: i64 = 250

        def spare_path_slot() -> i64:
            return 0 if path_slot == 1
            1

        def copy_path(p: cstr, slot: i64) -> bool can Unsafe.PointerCast:
            return false if slot != 0 and slot != 1
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                if c == 0:
                    if slot == 0:
                        path_bytes0[i] <- 0
                    else:
                        path_bytes1[i] <- 0
                    return true
                return false if i == PATH_CAPACITY - 1
                if slot == 0:
                    path_bytes0[i] <- c
                else:
                    path_bytes1[i] <- c
                i <- i + 1
            false

        def stored_path(slot: i64) -> cstr can Unsafe.PointerCast:
            return (&path_bytes0[0]).cast[cstr] if slot == 0
            (&path_bytes1[0]).cast[cstr]

        def stage_pending_path(p: cstr) -> bool can Unsafe.PointerCast:
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                if c == 0:
                    pending_path_bytes[i] <- 0
                    return true
                return false if i == PATH_CAPACITY - 1
                pending_path_bytes[i] <- c
                i <- i + 1
            false

        def pending_path() -> cstr can Unsafe.PointerCast:
            (&pending_path_bytes[0]).cast[cstr]

        def set_session_path(p: cstr) -> bool can Unsafe.PointerCast:
            mutable i: usize = 0
            while i < PATH_CAPACITY and p[i] != 0:
                i <- i + 1
            return false if i == PATH_CAPACITY
            mutable copied: usize = 0
            while copied <= i:
                session_path_bytes[copied] <- p[copied]
                copied <- copied + 1
            session_path <- (&session_path_bytes[0]).cast[cstr]
            true

        def set_path(p: cstr) -> void can Unsafe.PointerCast:
            slot: i64 = spare_path_slot()
            if copy_path(p, slot):
                path_slot <- slot
                path <- stored_path(slot)
            else:
                status <- "take path exceeds 4095 bytes"
                status_file <- null

        def set_anim(a: cstr) -> void:
            anim_name <- a

        def set_model(p: cstr) -> void:
            model_path <- p
            model_requested <- true

        # Load the character model in `p`; the current one stays when `p`
        # holds no skinned mesh. Turns the mesh view on.
        def load_character(p: cstr) -> void:
            loaded: StudioCharacter::Model? = StudioCharacter::load(p)
            if loaded is m:
                character <- m
                character_binding <- null
                character_take <- -1
                skinned <- null
                skinned_frame <- -1
                skinned_revision <- -1
                if not StudioScene::on(flags, StudioScene::MESH):
                    flags <- StudioScene::toggle(flags, StudioScene::MESH)
                say_file("character model loaded from", p)
            else:
                say_file("no skinned mesh could be read from", p)
            touch()

        def open_character() -> void:
            if FilePanel::open("glb", "Open a character model") is chosen:
                load_character(chosen)

        # Bind the character to `c` once per opened take; the bound share
        # goes to the status line.
        def bind_character(c: StudioModel::Clip&) -> void:
            return if character_take == take_serial
            if character is m:
                b: StudioCharacter::Binding = StudioCharacter::bind(m, c)
                ok: bool = StudioCharacter::drawable(&b)
                status <- StudioText::number("character joints bound (permille): ", b.coverage) if ok else StudioText::number("character: too few joints match this rig (permille): ", b.coverage)
                nudged_row <- -1
                status_file <- null
                character_binding <- move b
                character_take <- take_serial
                skinned <- null
                skinned_frame <- -1

        # The character is bound well enough to draw.
        def character_ready() -> bool:
            if character_binding is b:
                return character != null and StudioCharacter::drawable(b)
            return false

        # ---- per-view globals ------------------------------------------
        def put_view(i: i64, vp: Viewport::Viewport) -> void:
            if i == 0:
                view0 <- vp
            elif i == 1:
                view1 <- vp
            else:
                view2 <- vp

        def view(i: i64) -> Viewport::Viewport?:
            return view0 if i == 0
            return view1 if i == 1
            view2

        def seen(i: i64) -> i64:
            return seen0 if i == 0
            return seen1 if i == 1
            seen2

        def put_seen(i: i64, r: i64) -> void:
            if i == 0:
                seen0 <- r
            elif i == 1:
                seen1 <- r
            else:
                seen2 <- r

        def open_view(i: i64) -> Viewport::Viewport?:
            mutable vp: Viewport::Viewport = catch Viewport::create(320, 240):
                value: value
                error failure: return null
            if i == 1:
                vp.camera <- ViewportCamera::create_ortho(320, 240, ViewportCamera::FRONT)
            if i == 2:
                vp.camera <- ViewportCamera::create_ortho(320, 240, ViewportCamera::SIDE)
            return move vp

        def rect_of(b: StudioPanels::Box) -> UiHostedSurface::Rect:
            UiHostedSurface::Rect{x: b.x, y: b.y, width: b.w, height: b.h}

        def view_box(i: i64) -> StudioPanels::Box:
            StudioPanels::view_box(i.usize(), UiCore::viewport_width(), UiCore::viewport_height())

        # ---- state helpers -----------------------------------------------
        def frame_now() -> i64:
            if timeline is t:
                return t.frame
            0

        def frames() -> i64:
            if clip is c:
                return c.frames
            1

        # Frames per second of the loaded clip, from its key times.
        def rate() -> i64:
            if clip is c:
                return c.rate if c.rate >= 1 else Timeline::RATE
            Timeline::RATE

        # Document nodes of the loaded take (gizmo corrections name them).
        def node_total() -> i64:
            if clip is c:
                return GlbDocument::node_count(&c.source).i64()
            0

        def current_stack() -> StackState::Stack:
            if history_ready:
                return HistoryState::current(&history)
            StackState::empty()

        def session_identity(c: StudioModel::Clip) -> SessionState::SourceIdentity:
            SessionState::SourceIdentity{first: c.source_fingerprint.first, second: c.source_fingerprint.second, animation: c.anim.i64(), frames: c.source_frames, nodes: GlbDocument::node_count(&c.source).i64()}

        def touch() -> void:
            revision <- revision + 1
            UiCore::request_frame_after(0.001)

        def ensure_issue_filter() -> void:
            if not issue_filter_ready:
                issue_filter <- StudioIssueFilterPolicy::Filter{
                    detector: StudioIssueFilterPolicy::ANY_DETECTOR,
                    subject: StudioIssueFilterPolicy::ANY_SUBJECT,
                    minimum_severity: 0,
                    status: StudioIssueFilterPolicy::ANY_STATUS}
                issue_filter_ready <- true

        def rebuild_filtered_issues() -> void:
            ensure_issue_filter()
            mutable filtered: darray[StudioIssues::Issue] = []
            for issue in issues |issue_filter, issue_annotations, filtered|:
                disposition: i64 = StudioIssueAnnotation::disposition(issue_annotations, issue)
                if StudioIssueFilterPolicy::matches(issue, issue_filter, disposition):
                    filtered.push(issue)
            filtered_issues <- move filtered
            issue_selected <- 0 if filtered_issues.count == 0 or issue_selected >= filtered_issues.count.i64()

        def reconcile_pending_session_annotations(fresh: darray[StudioIssues::Issue]&) -> void:
            return if not pending_session_annotation_restore
            mutable restored: i64 = 0
            for record in pending_session_annotations |record, fresh, issue_annotations, restored|:
                for issue in fresh |issue, record, issue_annotations, restored|:
                    if SessionIssueAnnotationPolicy::matches_issue(record, issue, frames()):
                        if StudioIssueAnnotation::ignore(&issue_annotations, issue):
                            restored <- restored + 1
            session_annotations_expired <- pending_session_annotations.count.i64() - restored
            pending_session_annotations <- zeroed
            pending_session_annotation_restore <- false

        def collect_issues(c: StudioModel::Clip&) -> void:
            mutable samples: darray[StudioIssues::Sample] = []
            for frame in 0..<c.frames |frame, c|:
                if frame < c.problems.count.i64() and c.problems[frame.usize()] > 0:
                    value: i64 = c.peaks[frame.usize()]
                    if value >= c.threshold and c.threshold > 0:
                        mutable severity: i64 = value * 1000 / c.threshold
                        severity <- StudioIssues::MAX_SEVERITY if severity > StudioIssues::MAX_SEVERITY else severity
                        samples.push(StudioIssues::Sample{frame: frame, issue_type: 0, subject_id: -1, source_revision: built, severity: severity, value: value, threshold: c.threshold})
            mutable ranked: darray[StudioIssues::Issue] = StudioIssues::group(&samples)
            # Stable descending severity, then descending peak excess. The
            # grouping kernel has already made each row's peak deterministic.
            if ranked.count > 1:
                for index in 1..<ranked.count |index, ranked|:
                    mutable cursor: usize = index
                    while cursor > 0:
                        current: StudioIssues::Issue = ranked[cursor]
                        previous: StudioIssues::Issue = ranked[cursor - 1]
                        current_margin: i64 = current.peak_value - current.threshold
                        previous_margin: i64 = previous.peak_value - previous.threshold
                        wins: bool = current.severity > previous.severity or (current.severity == previous.severity and current_margin > previous_margin)
                        if wins:
                            ranked[cursor] <- previous
                            ranked[cursor - 1] <- current
                            cursor <- cursor - 1
                        else:
                            break
            reconcile_pending_session_annotations(ranked)
            issues <- move ranked
            issues_revision <- built
            _ = StudioIssueAnnotation::prune_revisions(&issue_annotations, built)
            issue_selected <- 0
            rebuild_filtered_issues()

        def navigate_issue(index: i64) -> void:
            if issues_revision != built:
                status <- "findings updating; navigation unavailable"
                touch()
                return
            return if filtered_issues.count == 0 or index < 0 or index >= filtered_issues.count.i64()
            issue: StudioIssues::Issue = StudioPanels::issue_at(filtered_issues, index)
            if not issue.selectable or issue.source_revision != issues_revision:
                status <- "finding is stale; wait for update"
                touch()
                return
            issue_selected <- index
            if timeline is t and issue.peak_frame >= 0 and issue.peak_frame < t.count:
                timeline <- TimelineState::scrub(t, issue.peak_frame)
            if clip is c and issue.subject_id >= 0 and issue.subject_id < c.nodes.count.i64():
                bone <- issue.subject_id
            status <- "finding selected"
            touch()

        def issue_navigation(action: i64) -> void:
            return if filtered_issues.count == 0 or filtered_issues.count.i64() > StudioIssueBrowserPolicy::MAX_FINDINGS
            if action == StudioPanels::ISSUE_WORST:
                navigate_issue(0)
            else:
                navigate_issue(StudioPanels::issue_navigation_target(issue_selected,
                    filtered_issues.count.i64(), action))

        def visible_issue_first() -> i64:
            issue_selected if issue_selected >= 0 and issue_selected < filtered_issues.count.i64() else 0

        def next_issue_value(current: i64, detector: bool) -> i64:
            mutable next: i64 = 9223372036854775807
            for issue in issues |issue, current, detector, next|:
                value: i64 = issue.issue_type if detector else issue.subject_id
                next <- value if value > current and value < next
            return next if next < 9223372036854775807
            StudioIssueFilterPolicy::ANY_DETECTOR if detector else StudioIssueFilterPolicy::ANY_SUBJECT

        def reset_issue_filters() -> void:
            ensure_issue_filter()
            issue_filter <- StudioIssueFilterPolicy::Filter{
                detector: StudioIssueFilterPolicy::ANY_DETECTOR,
                subject: StudioIssueFilterPolicy::ANY_SUBJECT,
                minimum_severity: 0,
                status: StudioIssueFilterPolicy::ANY_STATUS}
            issue_selected <- 0
            rebuild_filtered_issues()
            status <- "finding filters cleared"
            touch()

        def cycle_issue_filter(field: i64) -> void:
            ensure_issue_filter()
            if field == StudioPanels::ISSUE_FILTER_DETECTOR:
                issue_filter.detector <- next_issue_value(issue_filter.detector, true)
            elif field == StudioPanels::ISSUE_FILTER_SUBJECT:
                issue_filter.subject <- next_issue_value(issue_filter.subject, false)
            elif field == StudioPanels::ISSUE_FILTER_SEVERITY:
                if issue_filter.minimum_severity == 0:
                    issue_filter.minimum_severity <- 250
                elif issue_filter.minimum_severity == 250:
                    issue_filter.minimum_severity <- 500
                elif issue_filter.minimum_severity == 500:
                    issue_filter.minimum_severity <- 750
                elif issue_filter.minimum_severity == 750:
                    issue_filter.minimum_severity <- 900
                else:
                    issue_filter.minimum_severity <- 0
            elif field == StudioPanels::ISSUE_FILTER_STATUS:
                if issue_filter.status == StudioIssueFilterPolicy::ANY_STATUS:
                    issue_filter.status <- StudioIssueFilterPolicy::UNRESOLVED
                elif issue_filter.status == StudioIssueFilterPolicy::UNRESOLVED:
                    issue_filter.status <- StudioIssueFilterPolicy::IGNORED
                else:
                    issue_filter.status <- StudioIssueFilterPolicy::ANY_STATUS
            else:
                return
            issue_selected <- 0
            rebuild_filtered_issues()
            status <- "finding filters updated"
            touch()

        def toggle_issue_intent() -> void:
            return if issues_revision != built
            return if filtered_issues.count == 0 or issue_selected < 0 or issue_selected >= filtered_issues.count.i64()
            issue: StudioIssues::Issue = StudioPanels::issue_at(filtered_issues, issue_selected)
            disposition: i64 = StudioIssueAnnotation::disposition(issue_annotations, issue)
            if disposition == StudioIssueAnnotation::IGNORED:
                if StudioIssueAnnotation::restore(&issue_annotations, issue):
                    status <- "finding restored for this analysis"
            elif StudioIssueAnnotation::ignore(&issue_annotations, issue):
                status <- "finding marked intentional for this analysis"
            else:
                status <- "intent list is full; restore a finding before adding another"
            rebuild_filtered_issues()
            touch()

        def draw_issue_browser(w: f32, h: f32, stale: bool, loading: bool) -> void:
            ensure_issue_filter()
            sb: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
            StudioPanels::issue_browser(sb, filtered_issues, visible_issue_first(),
                issue_selected, stale, loading,
                StudioPanels::issue_filter_active(issue_filter))
            StudioPanels::issue_filter_controls(sb, issue_filter)
            selection_valid: bool = not stale and filtered_issues.count > 0 and issue_selected >= 0 and issue_selected < filtered_issues.count.i64()
            mutable ignored: bool = false
            if selection_valid:
                selected_issue: StudioIssues::Issue = StudioPanels::issue_at(filtered_issues, issue_selected)
                ignored <- StudioIssueAnnotation::disposition(issue_annotations, selected_issue) == StudioIssueAnnotation::IGNORED
            StudioPanels::issue_disposition_control(sb, selection_valid, ignored)

        # Rebuild the cleaned clip from the current stack (live preview).
        def rebuild() -> void:
            if path_slot < 0:
                load_failed <- false
                return
            s: StackState::Stack = current_stack()
            if clip is old:
                shown_slide <- readout_value(shown_slide, old.slide_after)
                shown_sink <- readout_value(shown_sink, old.sink_after)
                shown_hand_slide <- readout_value(shown_hand_slide, old.hand_slide_after)
            readout_start <- UiAppKitCanvas::monotonic_time()
            if memo == null:
                memo <- StudioModel::load(path, anim_name)
            mutable result: StudioModel::Clip? = null
            if memo is held:
                mutable m: StudioModel::Memo = held
                memo <- null
                if built_stack is prior:
                    rig_source_revision <- rig_source_revision + 1 if not StackState::same_rig_source(prior, s)
                else:
                    rig_source_revision <- rig_source_revision + 1
                w: mutable StudioPerf::Window = StudioPerf::full(m.frames)
                if clip is c:
                    if built_stack is old:
                        w <- StudioPerf::edit_window(old, s, m.frames, m.shortest)
                    result <- StudioModel::build_with(&m, s, c.points, c.problems, c.peaks, w, rig_source_revision)
                else:
                    none_p: darray[Geometry::Vec3] = []
                    none_i: darray[i64] = []
                    result <- StudioModel::build_with(&m, s, none_p, none_i, none_i, w, rig_source_revision)
                memo <- move m
            if result == null:
                status <- "clip failed to load"
                nudged_row <- -1
                status_file <- null
                load_failed <- true
                return
            load_failed <- false
            clip <- move result
            StudioPanels::set_rate(rate())
            sync_count()
            built_stack <- s
            built <- built + 1
            if clip is c:
                collect_issues(c)
            touch()

        # A retime changes the clip length: keep the playhead on the same
        # source frame.
        def sync_count() -> void:
            if timeline is t:
                n: i64 = frames()
                if t.count != n:
                    mutable u: TimelineState::State = TimelineState::create(n)
                    u.looping <- t.looping
                    u.divisor <- t.divisor
                    set_timeline(TimelineState::scrub(u, t.frame * n / t.count))
                    contact_cancel_frame_draft() if contact_draft_target >= 0
                    contact_selected_side <- StudioContactEditor::NO_SIDE
                    contact_selected_frame <- -1

        # ---- retiming ------------------------------------------------------
        # Speed for the selection (a new band or the band under it), else for
        # the focused band.
        def retime_to(speed: i64) -> void:
            retime_speed <- Retime::clamp_speed(speed)
            if clip is c:
                mutable s: StackState::Stack = current_stack()
                mutable ok: bool = false
                if RetimeState::ready(&selection):
                    first: i64 = StudioModel::source_frame(c, RetimeState::lo(&selection))
                    last: i64 = StudioModel::source_frame(c, RetimeState::hi(&selection))
                    ok <- RetimeState::apply_speed(&s, first, last, retime_speed, c.source_frames)
                    band_focus <- StackState::band_at(&s, first)
                elif band_focus >= 0:
                    ok <- StackState::set_band_speed(&s, band_focus, retime_speed)
                if ok:
                    selection <- RetimeState::none()
                    commit(s, true)
                    status <- StudioText::number("retime permille ", retime_speed)
                else:
                    status <- "retime: Shift-drag a range (no overlap with a band)"
                touch()

        def typed_view() -> sview can Unsafe.PointerCast:
            StudioText::begin()
            StudioText::put("speed: ")
            for i in 0..<typed_len.usize():
                StudioText::byte(typed[i])
            StudioText::byte(95)
            return StudioText::view()

        def typed_speed() -> i64:
            StudioText::begin()
            for i in 0..<typed_len.usize():
                StudioText::byte(typed[i])
            return RetimeState::parse_speed(StudioText::view())

        def text_input(text: sview) -> void:
            return if not typing or text.len <= 0 or text.data == null
            for i in 0..<text.len.usize():
                append_typed_character(text.data[i].i64())

        # AppKit's immediate-mode numeric fields do not own a native text
        # widget. Their custom view receives physical key events, so accept
        # printable characters through the same whitelist as committed text.
        def append_typed_key(code: UiCore::Key) -> void:
            return if modifiers != 0
            mutable character: i64 = StudioTextEntryPolicy::REJECT
            character <- StudioTextEntryPolicy::ASCII_ZERO if code == UiCore::Key.Digit0
            character <- StudioTextEntryPolicy::ASCII_ZERO + 1 if code == UiCore::Key.Digit1
            character <- StudioTextEntryPolicy::ASCII_ZERO + 2 if code == UiCore::Key.Digit2
            character <- StudioTextEntryPolicy::ASCII_ZERO + 3 if code == UiCore::Key.Digit3
            character <- StudioTextEntryPolicy::ASCII_ZERO + 4 if code == UiCore::Key.Digit4
            character <- StudioTextEntryPolicy::ASCII_ZERO + 5 if code == UiCore::Key.Digit5
            character <- StudioTextEntryPolicy::ASCII_ZERO + 6 if code == UiCore::Key.Digit6
            character <- StudioTextEntryPolicy::ASCII_ZERO + 7 if code == UiCore::Key.Digit7
            character <- StudioTextEntryPolicy::ASCII_ZERO + 8 if code == UiCore::Key.Digit8
            character <- StudioTextEntryPolicy::ASCII_NINE if code == UiCore::Key.Digit9
            if contact_draft_target < 0:
                character <- StudioTextEntryPolicy::ASCII_DOT if code == UiCore::Key.Period
                character <- StudioTextEntryPolicy::ASCII_UPPER_X if code == UiCore::Key.X
                character <- StudioTextEntryPolicy::ASCII_SPACE if code == UiCore::Key.Space
            append_typed_character(character) if character != StudioTextEntryPolicy::REJECT

        def append_typed_character(character: i64) -> void:
            return if not typing or typed_len >= 8
            accepted: i64 = StudioTextEntryPolicy::route(true, character, contact_draft_target >= 0)
            return if accepted == StudioTextEntryPolicy::REJECT
            typed[typed_len.usize()] <- accepted.u8()
            typed_len <- typed_len + 1
            touch()

        # Shift-1..7: speed presets 0.5x .. 2x.
        def preset_key(code: UiCore::Key) -> i64:
            return 0 if code == UiCore::Key.Digit1
            return 1 if code == UiCore::Key.Digit2
            return 2 if code == UiCore::Key.Digit3
            return 3 if code == UiCore::Key.Digit4
            return 4 if code == UiCore::Key.Digit5
            return 5 if code == UiCore::Key.Digit6
            return 6 if code == UiCore::Key.Digit7
            return -1

        def remove_band() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::remove_band(&s, band_focus):
                band_focus <- -1
                commit(s, true)
                status <- "retime band removed"

        # Record an edited stack and preview it; selection-only edits are
        # recorded too so undo restores the row the user was on.
        def commit(s: StackState::Stack, preview: bool) -> void:
            if history_ready:
                changed: bool = HistoryState::record(&history, s)
                if changed and preview:
                    rebuild()
                touch()

        def undo() -> void:
            if history_ready:
                if HistoryState::undo(&history):
                    rebuild()
                    status <- "undo"
                    nudged_row <- -1
                    status_file <- null

        def redo() -> void:
            if history_ready:
                if HistoryState::redo(&history):
                    rebuild()
                    status <- "redo"
                    nudged_row <- -1
                    status_file <- null

        # ---- foot cleanup ------------------------------------------------
        # Readout transition progress (StudioFoot::FULL when settled).
        def readout_progress() -> i64:
            ms: f64 = (UiAppKitCanvas::monotonic_time() - readout_start) * 1000.0
            elapsed: i64 = 0 if ms < 0.0 else (READOUT_MS if ms > READOUT_MS.f64() else ms.i64())
            return StudioFoot::progress(elapsed, READOUT_MS)

        def readout_value(shown: i64, target: i64) -> i64:
            return target if target < -StudioFoot::LIMIT or target > StudioFoot::LIMIT
            return target if shown < -StudioFoot::LIMIT or shown > StudioFoot::LIMIT
            return StudioFoot::mix(shown, target, readout_progress())

        # K: foot cleanup on/off, recorded in history.
        def toggle_feet() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::set_feet(&s, not s.feet):
                commit(s, true)
                status <- "feet fixed" if s.feet else "feet off"
                nudged_row <- -1
                status_file <- null

        # J: opt-in hand contact cleanup, recorded in history.
        def toggle_hands() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::set_hands(&s, not s.hands):
                commit(s, true)
                status <- "hands fixed" if s.hands else "hands off"
                nudged_row <- -1
                status_file <- null

        # , and .: shorter or longer carry blend.
        def nudge_blend(up: bool) -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::nudge_blend(&s, up):
                commit(s, true)
                status <- "blend"
                nudged_row <- -2

        # W: scrub to the worst planted slide, select that foot and frame it.
        def jump_worst() -> void:
            if clip is c:
                return if c.worst_frame < 0 or c.worst_frame >= c.frames
                scrub_to(c.worst_frame)
                role: i64 = Roles::LEFT_FOOT if c.worst_side == StackState::LEFT else Roles::RIGHT_FOOT
                bone <- StudioClip::slot_of_role(c.cleaned, c.slot, role)
                track: darray[Geometry::Vec3] = c.left_foot if c.worst_side == StackState::LEFT else c.right_foot
                if c.worst_frame < track.count.i64():
                    p: Geometry::Vec3 = track[c.worst_frame.usize()]
                    pts: darray[Geometry::Vec3] = [Geometry::vec3_add(p, Geometry::Vec3{x: -0.25, y: -0.05, z: -0.25}), Geometry::vec3_add(p, Geometry::Vec3{x: 0.25, y: 0.35, z: 0.25})]
                    for i in 0..<3 |i, pts|:
                        if view(i) is opened:
                            mutable vp: Viewport::Viewport = opened
                            _ = ViewportCamera::frame_points(&vp.camera, &pts, 1.15)
                            Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                            put_view(i, vp)
                status <- "worst slide"
                nudged_row <- -1
                status_file <- null
                touch()

        # A press on a contact row; true when it was one.
        def contact_down(x: f32, y: f32) -> bool:
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            row: i64 = StudioPanels::contact_row(tb, y)
            return false if row < 0
            if clip is c:
                st: StudioPanels::Box = StudioPanels::strip(tb)
                mutable fl: darray[bool] = c.left_contact
                fl <- c.right_contact if row == StackState::RIGHT
                fl <- c.left_hand_contact if row == StackState::LEFT_HAND
                fl <- c.right_hand_contact if row == StackState::RIGHT_HAND
                foot_press <- FootState::press(fl, row, (x - st.x).i64(), st.w.i64())
                return true
            false

        def contact_up(x: f32) -> void:
            p: FootState::Press = foot_press
            foot_press <- FootState::idle()
            delta_x: i64 = (x - down_x).i64()
            if not StudioContactEditor::is_drag(delta_x):
                contact_selected_side <- p.side
                contact_selected_frame <- p.frame
                scrub_to(p.frame)
                selected: StackState::Stack = current_stack()
                authored: bool = StackState::edit_index_at(selected, p.side, p.frame) >= 0
                status <- "interval selected; First/Last: click, type a 1-based frame, Enter; Shift+Arrows nudge" if authored else "contact frame selected; choose Plant/Lift, Reset, Delete or Merge as available"
                nudged_row <- -1
                status_file <- null
                touch()
                return
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            if p.part != StudioFoot::FIRST and p.part != StudioFoot::LAST:
                contact_selected_side <- p.side
                contact_selected_frame <- p.frame
                scrub_to(p.frame)
                status <- "select a frame first or drag a run endpoint"
                touch()
                return
            mutable s: StackState::Stack = current_stack()
            if FootState::release(&s, &p, StudioPanels::timeline_frame(tb, x, frames()), frames()):
                commit(s, true)
                status <- "contact endpoint moved"
                nudged_row <- -1
                status_file <- null
            contact_selected_side <- p.side
            contact_selected_frame <- StudioPanels::timeline_frame(tb, x, frames())
            touch()

        # Shift+Arrow translates the selected authored interval. Shift+Up/Down
        # changes its last frame, while Shift+[/] changes its first frame.
        # All edits pass through the fixed-point contact policy and history.
        def contact_nudge(target: i64, delta: i64) -> void:
            if clip is c:
                return if not StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames)
                mutable s: StackState::Stack = current_stack()
                index: i64 = StackState::edit_index_at(s,
                    contact_selected_side, contact_selected_frame)
                if index < 0:
                    status <- "select an authored contact interval first"
                    touch()
                    return
                original: StackState::FootEdit = s.edits[index]
                plan: StudioContactEditor::NudgePlan =
                    StudioContactEditor::nudge_plan(original.first, original.last,
                        c.frames, target, delta)
                if not plan.valid:
                    status <- "contact interval cannot move past its boundary"
                    touch()
                    return
                s.edits[index] <- StackState::FootEdit{side: original.side,
                    first: plan.first, last: plan.last, planted: original.planted}
                commit(s, true)
                if target == StudioContactEditor::NUDGE_INTERVAL:
                    contact_selected_frame <- contact_selected_frame + delta
                elif contact_selected_frame < plan.first:
                    contact_selected_frame <- plan.first
                elif contact_selected_frame > plan.last:
                    contact_selected_frame <- plan.last
                StudioText::begin()
                StudioText::put("Moved " if target == StudioContactEditor::NUDGE_INTERVAL else "Adjusted ")
                StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                StudioText::put(" interval to frames ")
                StudioText::put_i(plan.first + 1)
                StudioText::put("–")
                StudioText::put_i(plan.last + 1)
                status <- StudioText::view()
                nudged_row <- -1
                status_file <- null
                touch()

        def contact_draft_value() -> i64:
            return -1 if typed_len <= 0
            mutable value: i64 = 0
            for i in 0..<typed_len.usize() |i, value|:
                value <- value * 10 + typed[i].i64() - 48
            value

        def contact_begin_frame_draft(target: i64) -> void:
            if clip is c:
                return if target != StudioContactEditor::NUDGE_FIRST and target != StudioContactEditor::NUDGE_LAST
                if not StudioContactEditor::selection_valid(contact_selected_side, contact_selected_frame, c.frames):
                    status <- "select a contact row and frame first"
                    touch()
                    return
                s: StackState::Stack = current_stack()
                if StackState::edit_index_at(s, contact_selected_side, contact_selected_frame) < 0:
                    status <- "select a frame inside an authored contact interval first"
                    touch()
                    return
                contact_draft_target <- target
                contact_draft_side <- contact_selected_side
                contact_draft_frame <- contact_selected_frame
                typing <- true
                typed_len <- 0
                status <- "type a 1-based frame; Enter applies, Escape cancels"
                touch()
            else:
                status <- "load a take and select an authored contact interval first"
                touch()

        def contact_cancel_frame_draft() -> void:
            contact_draft_target <- -1
            contact_draft_side <- StudioContactEditor::NO_SIDE
            contact_draft_frame <- -1
            typed_len <- 0
            typing <- false
            status <- "contact frame edit cancelled"
            touch()

        def contact_commit_frame_draft() -> void:
            return if contact_draft_target < 0
            if clip is c:
                if contact_selected_side != contact_draft_side or contact_selected_frame != contact_draft_frame:
                    contact_cancel_frame_draft()
                    status <- "selection changed; contact frame edit cancelled"
                    touch()
                    return
                requested: i64 = contact_draft_value()
                if requested < 1:
                    status <- "enter a frame number from 1 to the clip length"
                    touch()
                    return
                mutable s: StackState::Stack = current_stack()
                index: i64 = StackState::edit_index_at(s, contact_draft_side, contact_draft_frame)
                if index < 0:
                    contact_cancel_frame_draft()
                    status <- "authored contact interval no longer exists"
                    touch()
                    return
                original: StackState::FootEdit = s.edits[index]
                frame_target: i64 = StudioContactFramePolicy::FIRST if contact_draft_target == StudioContactEditor::NUDGE_FIRST else StudioContactFramePolicy::LAST
                plan: StudioContactFramePolicy::FramePlan = StudioContactFramePolicy::plan(
                    original.first, original.last, c.frames, frame_target, requested)
                if not plan.valid:
                    status <- "frame is outside the clip or would invert the contact interval"
                    touch()
                    return
                s.edits[index] <- StackState::FootEdit{side: original.side,
                    first: plan.first, last: plan.last, planted: original.planted}
                edit_side: i64 = contact_draft_side
                contact_draft_target <- -1
                contact_draft_side <- StudioContactEditor::NO_SIDE
                contact_draft_frame <- -1
                typing <- false
                typed_len <- 0
                if contact_selected_frame < plan.first:
                    contact_selected_frame <- plan.first
                elif contact_selected_frame > plan.last:
                    contact_selected_frame <- plan.last
                commit(s, true)
                StudioText::begin()
                StudioText::put("Set ")
                StudioText::put(StudioPanels::contact_side_label(edit_side))
                StudioText::put(" interval to frames ")
                StudioText::put_i(plan.first + 1)
                StudioText::put("–")
                StudioText::put_i(plan.last + 1)
                status <- StudioText::view()
                nudged_row <- -1
                status_file <- null
                touch()

        # Apply an explicit Plant/Lift action to the selected output frame.
        def contact_apply(action: i64) -> void:
            return if not StudioContactEditor::action_valid(action)
            if clip is c:
                if not StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames):
                    status <- "select a contact row and frame first"
                    touch()
                    return
                mutable s: StackState::Stack = current_stack()
                if action == StudioContactEditor::DELETE:
                    index: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame)
                    if index >= 0:
                        removed: StackState::FootEdit = s.edits[index]
                        if StackState::delete_edit_at(&s, contact_selected_side, contact_selected_frame):
                            commit(s, true)
                            StudioText::begin()
                            StudioText::put("Deleted ")
                            StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                            StudioText::put(" interval frames ")
                            StudioText::put_i(removed.first + 1)
                            StudioText::put(" to ")
                            StudioText::put_i(removed.last + 1)
                            status <- StudioText::view()
                        else:
                            status <- "could not delete contact interval"
                    else:
                        status <- "no authored contact interval at this frame"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if action == StudioContactEditor::MERGE:
                    selected: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame)
                    neighbor: i64 = StackState::merge_neighbor_index(s, selected)
                    if neighbor >= 0:
                        keep: i64 = selected if selected < neighbor else neighbor
                        remove: i64 = neighbor if selected < neighbor else selected
                        a: StackState::FootEdit = s.edits[keep]
                        b: StackState::FootEdit = s.edits[remove]
                        first: i64 = a.first if a.first < b.first else b.first
                        last: i64 = a.last if a.last > b.last else b.last
                        if StackState::merge_edit_at(&s, contact_selected_side, contact_selected_frame):
                            commit(s, true)
                            StudioText::begin()
                            StudioText::put("Merged ")
                            StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                            StudioText::put(" intervals frames ")
                            StudioText::put_i(first + 1)
                            StudioText::put(" to ")
                            StudioText::put_i(last + 1)
                            status <- StudioText::view()
                        else:
                            status <- "could not merge contact intervals"
                    else:
                        status <- "no adjacent same-state contact interval to merge"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if action == StudioContactEditor::SPLIT:
                    selected: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame)
                    if selected >= 0:
                        original: StackState::FootEdit = s.edits[selected]
                        if StackState::split_edit_at(&s, contact_selected_side, contact_selected_frame):
                            commit(s, true)
                            StudioText::begin()
                            StudioText::put("Split ")
                            StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                            StudioText::put(" interval before frame ")
                            StudioText::put_i(contact_selected_frame + 1)
                            StudioText::put("; ranges ")
                            StudioText::put_i(original.first + 1)
                            StudioText::put("–")
                            StudioText::put_i(contact_selected_frame)
                            StudioText::put(" and ")
                            StudioText::put_i(contact_selected_frame + 1)
                            StudioText::put("–")
                            StudioText::put_i(original.last + 1)
                            status <- StudioText::view()
                        else:
                            status <- "could not split contact interval"
                    else:
                        status <- "no authored contact interval at this frame"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if action == StudioContactEditor::RESET:
                    if StackState::reset_edit_at(&s, contact_selected_side, contact_selected_frame):
                        commit(s, true)
                        StudioText::begin()
                        StudioText::put("Restored ")
                        StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                        StudioText::put(" frame ")
                        StudioText::put_i(contact_selected_frame + 1)
                        StudioText::put(" to automatic detection")
                        status <- StudioText::view()
                    elif StackState::has_edit_at(s, contact_selected_side, contact_selected_frame):
                        status <- "cannot reset this frame: contact edit capacity would be exceeded"
                    else:
                        status <- "this frame already follows automatic detection"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if StackState::add_edit(&s, contact_selected_side,
                    contact_selected_frame, contact_selected_frame,
                    StudioContactEditor::plants(action)):
                    commit(s, true)
                    StudioText::begin()
                    StudioText::put("Planted " if action == StudioContactEditor::PLANT else "Lifted ")
                    StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                    StudioText::put(" at frame ")
                    StudioText::put_i(contact_selected_frame + 1)
                    status <- StudioText::view()
                else:
                    status <- "contact edit limit reached; undo an edit before adding another"
                nudged_row <- -1
                status_file <- null
                touch()

        def set_timeline(t: TimelineState::State) -> void:
            timeline <- t
            touch()

        def scrub_to(f: i64) -> void:
            if timeline is t:
                set_timeline(TimelineState::scrub(t, f))

        def step_frames(d: i64) -> void:
            if timeline is t:
                set_timeline(TimelineState::step_by(t, d))

        def toggle_play() -> void:
            if timeline is t:
                last_time <- UiAppKitCanvas::monotonic_time()
                set_timeline(TimelineState::toggle_play(t))

        def cycle_speed() -> void:
            if timeline is t:
                set_timeline(TimelineState::cycle_speed(t))

        def toggle_loop() -> void:
            if timeline is t:
                mutable n: TimelineState::State = t
                n.looping <- not n.looping
                set_timeline(n)

        def toggle_flag(bit: i64) -> void:
            flags <- StudioScene::toggle(flags, bit)
            touch()

        # ---- stack edits -----------------------------------------------
        def add_op(k: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::add(&s, StudioModel::new_operation(k, frames())):
                StackState::select(&s, s.count - 1)
                commit(s, true)
                status <- "operation added"
                nudged_row <- -1
                status_file <- null

        def reset_cleanup(action: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            return if not StudioResetScope::enabled(action, StackState::valid(s, s.selected), s.edit_count, s.fix_count, StackState::has_cleanup(s))
            mutable changed: bool = false
            if action == StudioResetScope::CLEAR_CONTACTS:
                changed <- StackState::clear_edits(&s)
            elif action == StudioResetScope::CLEAR_CORRECTIONS:
                changed <- StackState::clear_fixes(&s)
            elif action == StudioResetScope::RESTORE_SOURCE:
                changed <- StackState::reset_to_source(&s)
            return if not changed
            reset_menu_open <- false
            nudged_row <- -1
            status_file <- null
            status <- "All contact overrides cleared (Cmd-Z)" if action == StudioResetScope::CLEAR_CONTACTS
            status <- "All local corrections cleared (Cmd-Z)" if action == StudioResetScope::CLEAR_CORRECTIONS
            status <- "Source restored; all cleanup removed (Cmd-Z)" if action == StudioResetScope::RESTORE_SOURCE
            commit(s, true)

        def duplicate_selected() -> void:
            mutable s: StackState::Stack = current_stack()
            if not StudioOperationDuplicatePolicy::available(s.count, s.selected):
                status <- "Stack is full (16 of 16)" if s.count >= StudioOperationDuplicatePolicy::MAX_OPS else "Select an operation to duplicate"
                nudged_row <- -1
                status_file <- null
                touch()
                return
            if StackState::duplicate_selected(&s):
                status <- "Operation duplicated; copy selected (Cmd-Z to undo)"
                nudged_row <- -1
                status_file <- null
                commit(s, true)

        def edit_selected(kind: i64, amount: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            at: i64 = s.selected
            return if not StackState::valid(s, at)
            mutable ok: bool = false
            if kind == StudioPanels::HIT_TOGGLE:
                ok <- StackState::toggle(&s, at)
            elif kind == StudioPanels::HIT_REMOVE:
                ok <- StackState::remove(&s, at)
            elif kind == StudioPanels::HIT_UP:
                ok <- StackState::move(&s, at, -1)
            elif kind == StudioPanels::HIT_DOWN:
                ok <- StackState::move(&s, at, 1)
            elif kind == 7:
                ok <- StudioModel::nudge(&s, at, amount)
                nudged_row <- at if ok else -1
            elif kind == 8:
                ok <- StackState::cycle_bones(&s, at)
            elif kind == 9:
                op: Ops::Operation = s.ops[at]
                ok <- StackState::set_scope(&s, at, frame_now(), op.last, frames())
            elif kind == 10:
                op: Ops::Operation = s.ops[at]
                ok <- StackState::set_scope(&s, at, op.first, frame_now(), frames())
            if ok:
                commit(s, true)

        def select_row(i: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            StackState::select(&s, i)
            commit(s, false)

        def row_action(hit: i64) -> void:
            kind: i64 = hit / 100
            row: i64 = hit % 100
            if kind == StudioPanels::HIT_ADD:
                add_op(row)
                return
            if kind == StudioPanels::HIT_DUPLICATE:
                duplicate_selected()
                return
            select_row(row)
            edit_selected(kind, 0) if kind != StudioPanels::HIT_SELECT

        # One click Fix all: the boxing preset plus foot and hand locks as one
        # undoable edit; the sidebar shows every detector's before/after.
        def clean_with_preset() -> void:
            commit(StudioModel::fix_all_stack(), true)
            if clip is c:
                gain_slide <- gain(c.slide_before, c.slide_after)
                gain_spikes <- gain(c.spikes_before, c.spikes_after)
            status <- "Fix all applied (Cmd-Z to undo)"
            nudged_row <- -1
            status_file <- null
            touch()

        def gain(before: i64, after: i64) -> i64:
            return 0 if before < 0 or after < 0 or before > StudioChrome::CHROME_SIZE or after > StudioChrome::CHROME_SIZE
            StudioChrome::clean_gain(before, after)

        # Status line naming a file: "<s> <file name>".
        def say_file(s: sview, file: cstr) -> void:
            status <- s
            nudged_row <- -1
            status_file <- file

        def save_session_to_current_path() -> bool:
            mutable ok: bool = false
            if clip is c:
                mutable records: darray[SessionIssueAnnotationPolicy::Stored] = []
                if issues_revision == built:
                    for issue in issues |issue, issue_annotations, records|:
                        if StudioIssueAnnotation::disposition(issue_annotations, issue) == StudioIssueAnnotation::IGNORED:
                            records.push(SessionIssueAnnotationPolicy::stored_from_issue(issue, frames()))
                ok <- SessionState::save_session_with_annotations(current_stack(), session_identity(c), records, session_path)
            if ok:
                HistoryState::mark_saved(&history)
                say_file("session saved to", session_path)
                FilePanel::note_recent(session_path)
            else:
                mutable failure: sview = "session save failed; check path, permissions or disk space"
                failure <- "session save failed; too many or invalid finding annotations" if SessionState::save_error() == SessionState::SAVE_ERROR_ANNOTATIONS
                say_file(failure, session_path)
            touch()
            ok

        def save_session() -> void:
            _ = save_session_to_current_path()

        def install_session(p: cstr, loaded: StackState::Stack, allow_legacy: bool) -> void:
            issue_annotations <- zeroed
            pending_session_annotation_restore <- true
            session_annotations_expired <- 0
            commit(loaded, true)
            if issues_revision == built:
                reconcile_pending_session_annotations(issues)
            HistoryState::mark_saved(&history)
            _ = set_session_path(p)
            mutable loaded_message: sview = "session loaded (Cmd-Z to undo) from"
            loaded_message <- "legacy session loaded; verify joints (Cmd-Z to undo) from" if allow_legacy
            if session_annotations_expired > 0:
                loaded_message <- "session loaded; finding annotations expired after analysis changed from"
            say_file(loaded_message, session_path)
            FilePanel::note_recent(session_path)
            touch()

        def resolve_legacy_session(choice: i64) -> void can Unsafe.PointerCast:
            action: i64 = StudioLegacyPrompt::resolve(legacy_prompt_open, choice)
            return if action == StudioLegacyPrompt::NONE
            if action == StudioLegacyPrompt::CANCEL:
                legacy_prompt_open <- false
                pending_replacement <- 0
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                clear_pending_session_annotations()
                say_file("legacy session cancelled; current cleanup unchanged", pending_path())
                touch()
                return
            p: cstr = pending_path()
            legacy_prompt_open <- false
            touch()
            request_replacement(p, REPLACE_SESSION, true)

        def path_bytes(p: cstr) -> darray[u8] can Unsafe.PointerCast:
            mutable out: darray[u8] = []
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                return out if c == 0
                out.push(c)
                i <- i + 1
            []

        def export_reason(destination: cstr, overwrite_confirmed: bool) -> i64 can Unsafe.PointerCast:
            mutable reason: i64 = StudioExportPolicy::PATH_UNRESOLVED
            if FilePanel::resolve_path("build") is root_path:
                if FilePanel::resolve_path(destination) is target_path:
                    root_facts: i64 = FilePanel::path_facts(root_path)
                    target_facts: i64 = FilePanel::path_facts(target_path)
                    if root_facts >= 0 and target_facts >= 0:
                        if (root_facts & FilePanel::PATH_DIRECTORY) == 0:
                            reason <- StudioExportPolicy::OUTSIDE_BUILD
                        else:
                            root_bytes: darray[u8] = path_bytes(root_path)
                            target_bytes: darray[u8] = path_bytes(target_path)
                            if root_bytes.count > 0 and target_bytes.count > 0:
                                reason <- StudioExportPolicy::decision(
                                    true,
                                    StudioExportPolicy::inside_build(root_bytes, target_bytes),
                                    FilePanel::same_identity(path, target_path),
                                    (target_facts & FilePanel::PATH_EXISTS) != 0,
                                    (target_facts & FilePanel::PATH_SYMLINK) != 0,
                                    (target_facts & FilePanel::PATH_REGULAR) != 0,
                                    overwrite_confirmed)
                    FilePanel::release_path(target_path)
                FilePanel::release_path(root_path)
            reason

        def export_error(reason: i64) -> sview:
            return "Export blocked: destination could not be resolved" if reason == StudioExportPolicy::PATH_UNRESOLVED
            return "Export blocked: choose a file inside the build folder" if reason == StudioExportPolicy::OUTSIDE_BUILD
            return "Export blocked: destination is the source take" if reason == StudioExportPolicy::SOURCE_COLLISION
            return "Export blocked: destination is a symbolic link" if reason == StudioExportPolicy::SYMBOLIC_LINK
            return "Export blocked: destination is not a regular file" if reason == StudioExportPolicy::NOT_REGULAR_FILE
            return "Export blocked: replace confirmation is required"

        # Storage manifests are loaded once and fail closed on path, type,
        # permission, size or format errors. A missing manifest is a new empty
        # inventory; malformed data is never silently replaced.
        def storage_manifest_ready() -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            return true if storage_manifest_state == 1
            return false if storage_manifest_state == 2
            facts: i64 = FilePanel::path_facts(STORAGE_MANIFEST_PATH)
            if facts < 0:
                storage_manifest_state <- 2
                return false
            if facts == 0:
                storage_entries <- []
                storage_manifest_state <- 1
                return true
            if (facts & FilePanel::PATH_SYMLINK) != 0 or (facts & FilePanel::PATH_REGULAR) == 0:
                storage_manifest_state <- 2
                return false
            return false if export_reason(STORAGE_MANIFEST_PATH, true) != StudioExportPolicy::ALLOW
            mutable loaded: darray[StudioStorageManifest::Entry] = []
            if not StudioStorageManifestFile::load(STORAGE_MANIFEST_PATH, &loaded):
                storage_manifest_state <- 2
                return false
            storage_entries <- loaded
            storage_manifest_state <- 1
            true

        def persist_storage_manifest(entries: darray[StudioStorageManifest::Entry]&) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            mutable bytes: darray[u8] = []
            return false if not StudioStorageManifest::encode(entries, &bytes)
            return false if export_reason(STORAGE_MANIFEST_PATH, true) != StudioExportPolicy::ALLOW
            StudioExportPublisher::write_sidecar(STORAGE_MANIFEST_PATH, bytes)

        # Persist a just-created report only after taking fresh filesystem
        # identity under build/. A hard link already registered at another
        # path remains ineligible so the same file cannot appear twice.
        def register_storage_artifact(path: cstr, kind: i64) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            return false if not storage_manifest_ready()
            mutable entry: StudioStorageManifest::Entry = zeroed
            mutable message: darray[u8] = []
            return false if not StudioFileTrash::snapshot("build", path, kind, &entry, &message)
            mutable updated: darray[StudioStorageManifest::Entry] = []
            for previous in storage_entries:
                updated.push(previous)
            mutable found_path: bool = false
            for index in 0..<updated.count |updated, entry, found_path|:
                existing: StudioStorageManifest::Entry = updated[index]
                if existing.state == StudioStorageManifest::REGISTERED and StudioStorageManifest::same_path(existing.original_path, entry.original_path):
                    updated[index] <- entry
                    found_path <- true
                elif existing.state == StudioStorageManifest::REGISTERED and existing.device == entry.device and existing.inode == entry.inode:
                    return false
            if not found_path:
                return false if updated.count.i64() >= StudioStorageManifest::MAX_ENTRIES
                updated.push(entry)
            return false if not persist_storage_manifest(updated)
            storage_entries <- updated
            if kind == StudioStorageCleanupPolicy::GENERATED_REPORT:
                mutable referenced: darray[StudioStorageManifest::Entry] = []
                for previous in storage_current_reports |previous, referenced, entry|:
                    if not StudioStorageManifest::same_path(previous.original_path, entry.original_path):
                        referenced.push(previous)
                if referenced.count.i64() < StudioStorageManifest::MAX_ENTRIES:
                    referenced.push(entry)
                storage_current_reports <- referenced
            true

        def storage_identity_matches(expected: StudioStorageManifest::Entry,
                                     current: StudioStorageManifest::Entry) -> bool:
            StudioStorageIdentityPolicy::matches(expected.device, current.device,
                expected.inode, current.inode, expected.size_bytes, current.size_bytes,
                expected.modified_seconds, current.modified_seconds,
                expected.modified_nanoseconds, current.modified_nanoseconds,
                StudioStorageManifest::same_path(expected.original_path, current.original_path))

        # Native identity comparison also protects hard links and aliases of
        # the active source, whose canonical spelling may differ from a record.
        def storage_path_is_source(bytes: darray[u8]&) -> bool can Unsafe.PointerCast:
            storage_path_matches(bytes, path)

        def storage_path_matches(bytes: darray[u8]&, protected_path: cstr) -> bool can Unsafe.PointerCast:
            return false if bytes.count == 0 or bytes.count >= PATH_CAPACITY
            mutable candidate: u8[4096] = zeroed
            for index in 0..<bytes.count |bytes, candidate|:
                candidate[index] <- bytes[index]
            candidate[bytes.count] <- 0
            candidate_path: cstr = (&candidate[0]).cast[cstr] can Unsafe.PointerCast
            FilePanel::same_identity(protected_path, candidate_path)

        # Convert fresh filesystem evidence into the cleanup policy's stable
        # protection reasons. Unknown age or file facts never qualify an item.
        def storage_cleanup_reason(entry: StudioStorageManifest::Entry, row_status: i64) -> i64 can Unsafe.PointerCast:
            return StudioStorageCleanupPolicy::PROTECT_IDENTITY_CHANGED if row_status == StudioPanels::STORAGE_STATUS_CHANGED
            return StudioStorageCleanupPolicy::PROTECT_IDENTITY_UNVERIFIED if row_status != StudioPanels::STORAGE_STATUS_PRESENT
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if not StudioStorageManifest::valid(entry)
            if storage_path_is_source(entry.original_path):
                return StudioStorageCleanupPolicy::PROTECT_SOURCE_TAKE
            if storage_path_matches(entry.original_path, session_path) or storage_path_matches(entry.original_path, export_path) or storage_path_matches(entry.original_path, STORAGE_MANIFEST_PATH):
                return StudioStorageCleanupPolicy::PROTECT_OPEN_DOCUMENT
            for referenced in storage_current_reports |referenced, entry|:
                if storage_identity_matches(referenced, entry):
                    return StudioStorageCleanupPolicy::PROTECT_OPEN_DOCUMENT
            # Recovery ownership/reference metadata is not yet registered;
            # retain recovery points until that evidence exists.
            return StudioStorageCleanupPolicy::PROTECT_SESSION_REFERENCE if entry.kind == StudioStorageCleanupPolicy::RECOVERY
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if entry.original_path.count == 0 or entry.original_path.count >= PATH_CAPACITY
            mutable candidate: u8[4096] = zeroed
            for index in 0..<entry.original_path.count |entry, candidate|:
                candidate[index] <- entry.original_path[index]
            candidate[entry.original_path.count] <- 0
            candidate_path: cstr = (&candidate[0]).cast[cstr] can Unsafe.PointerCast
            path_facts: i64 = FilePanel::path_facts(candidate_path)
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if path_facts < 0
            return StudioStorageCleanupPolicy::PROTECT_SYMLINK if (path_facts & FilePanel::PATH_SYMLINK) != 0
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if (path_facts & FilePanel::PATH_REGULAR) == 0
            age_status: i64 = StudioStorageAgePolicy::timestamp_status(entry.modified_seconds, storage_scan_seconds)
            return StudioStorageCleanupPolicy::PROTECT_INVALID_FACTS if age_status != StudioStorageAgePolicy::STATUS_VALID
            facts: StudioStorageCleanupPolicy::Facts = StudioStorageCleanupPolicy::Facts{
                kind: entry.kind, studio_managed: true, canonical_under_build: true,
                symlink: false, source_take: false, open_document: false,
                session_referenced: false, identity_state: StudioStorageCleanupPolicy::IDENTITY_MATCHES,
                age_days: StudioStorageAgePolicy::completed_age_days(entry.modified_seconds, storage_scan_seconds),
                retention_days: 30, size_bytes: entry.size_bytes}
            StudioStorageCleanupPolicy::protection_reason(facts)

        # The inventory view names only records below verified build/. Each
        # refresh checks live filesystem identity and reconciles interrupted
        # Trash moves before displaying an entry as verified.
        def refresh_storage_inventory() -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            storage_scan_seconds <- StudioStorageClock::unix_seconds()
            mutable previous_selection: StudioStorageManifest::Entry? = null
            if storage_selected >= 0 and storage_selected < storage_visible_entries.count.i64():
                previous_entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
                previous_selection <- previous_entries[storage_selected]
            storage_restore_review <- false
            storage_selected <- -1
            storage_visible_entries <- []
            storage_visible_statuses <- []
            storage_visible_reasons <- []
            storage_protected_records <- 0
            storage_unverified_records <- 0
            storage_present_bytes <- 0
            storage_trash_bytes <- 0
            storage_manifest_state <- 0
            if not storage_manifest_ready():
                storage_message <- 1
                return
            if FilePanel::resolve_path("build") is root_path:
                facts: i64 = FilePanel::path_facts(root_path)
                if facts >= 0 and (facts & FilePanel::PATH_DIRECTORY) != 0:
                    root_bytes: darray[u8] = path_bytes(root_path)
                    if root_bytes.count > 0:
                        mutable active_source: darray[u8] = []
                        if FilePanel::resolve_path(path) is source_path:
                            active_source <- path_bytes(source_path)
                        mutable updated: darray[StudioStorageManifest::Entry] = []
                        mutable visible: darray[StudioStorageManifest::Entry] = []
                        mutable statuses: darray[i64] = []
                        mutable protected: i64 = 0
                        mutable unverified: i64 = 0
                        mutable manifest_changed: bool = false
                        for entry in storage_entries |entry, root_bytes, active_source, updated, visible, statuses, protected, unverified, manifest_changed|:
                            is_active_source: bool = (active_source.count > 0 and StudioStorageManifest::same_path(entry.original_path, active_source)) or storage_path_is_source(entry.original_path) or storage_path_is_source(entry.trashed_path)
                            if not StudioExportPolicy::inside_build(root_bytes, entry.original_path) or is_active_source:
                                updated.push(entry)
                                protected <- protected + 1
                            else:
                                mutable current: StudioStorageManifest::Entry = zeroed
                                mutable io_message: darray[u8] = []
                                current_exists: bool = StudioFileTrash::snapshot_path("build", entry.original_path, entry.kind, &current, &io_message)
                                if current_exists and storage_identity_matches(entry, current):
                                    if entry.state == StudioStorageManifest::IN_TRASH:
                                        restored: StudioStorageManifest::Entry = StudioStorageManifest::Entry{
                                            state: StudioStorageManifest::REGISTERED,
                                            kind: entry.kind, device: entry.device,
                                            inode: entry.inode, size_bytes: entry.size_bytes,
                                            modified_seconds: entry.modified_seconds,
                                            modified_nanoseconds: entry.modified_nanoseconds,
                                            original_path: entry.original_path, trashed_path: []}
                                        updated.push(restored)
                                        visible.push(restored)
                                        statuses.push(StudioPanels::STORAGE_STATUS_PRESENT)
                                        manifest_changed <- true
                                    else:
                                        updated.push(entry)
                                        visible.push(entry)
                                        statuses.push(StudioPanels::STORAGE_STATUS_PRESENT)
                                elif current_exists:
                                    updated.push(entry)
                                    visible.push(entry)
                                    statuses.push(StudioPanels::STORAGE_STATUS_CHANGED)
                                    unverified <- unverified + 1
                                else:
                                    mutable recovered: StudioStorageManifest::Entry = zeroed
                                    if StudioFileTrash::reconcile("build", entry, &recovered, &io_message):
                                        updated.push(recovered)
                                        visible.push(recovered)
                                        statuses.push(StudioPanels::STORAGE_STATUS_IN_TRASH)
                                        manifest_changed <- true
                                    else:
                                        updated.push(entry)
                                        visible.push(entry)
                                        statuses.push(StudioPanels::STORAGE_STATUS_UNVERIFIED)
                                        unverified <- unverified + 1
                        mutable manifest_ok: bool = true
                        if manifest_changed:
                            manifest_ok <- persist_storage_manifest(updated)
                            if manifest_ok:
                                storage_entries <- updated
                            else:
                                for index in 0..<statuses.count |statuses, unverified|:
                                    if statuses[index] == StudioPanels::STORAGE_STATUS_IN_TRASH:
                                        statuses[index] <- StudioPanels::STORAGE_STATUS_UNVERIFIED
                                        unverified <- unverified + 1
                        mutable present_bytes: i64 = 0
                        mutable trash_bytes: i64 = 0
                        for index in 0..<visible.count |visible, statuses, present_bytes, trash_bytes|:
                            entry: StudioStorageManifest::Entry = visible[index]
                            if statuses[index] == StudioPanels::STORAGE_STATUS_PRESENT:
                                if StudioStorageTotalsKernel::add_allowed(index.i64(), present_bytes, entry.size_bytes):
                                    present_bytes <- StudioStorageTotalsKernel::next_total(present_bytes, entry.size_bytes)
                            elif statuses[index] == StudioPanels::STORAGE_STATUS_IN_TRASH:
                                if StudioStorageTotalsKernel::add_allowed(index.i64(), trash_bytes, entry.size_bytes):
                                    trash_bytes <- StudioStorageTotalsKernel::next_total(trash_bytes, entry.size_bytes)
                        mutable reasons: darray[i64] = []
                        for index in 0..<visible.count |visible, statuses, reasons|:
                            reasons.push(storage_cleanup_reason(visible[index], statuses[index]))
                        storage_visible_reasons <- reasons
                        storage_present_bytes <- present_bytes
                        storage_trash_bytes <- trash_bytes
                        storage_visible_entries <- visible
                        storage_visible_statuses <- statuses
                        storage_protected_records <- protected
                        storage_unverified_records <- unverified
                        if previous_selection is previous:
                            for index in 0..<visible.count |visible, previous|:
                                if storage_identity_matches(previous, visible[index]):
                                    storage_selected <- index.i64()
                        elif visible.count > 0:
                            storage_selected <- 0
                        storage_message <- 5 if not manifest_ok else 4 if unverified > 0 else 3
                        return
            storage_message <- 2

        def open_storage_screen() -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            file_menu_open <- false
            file_menu_hover <- -1
            reset_menu_open <- false
            help_open <- false
            storage_screen_open <- true
            storage_focus <- -1
            storage_selected <- 0
            refresh_storage_inventory()
            touch()

        def close_storage_screen() -> void:
            return if not storage_screen_open
            storage_screen_open <- false
            storage_restore_review <- false
            storage_focus <- -1
            touch()

        def storage_restore_available() -> bool:
            return false if storage_message == 1 or storage_message == 2 or storage_message == 5
            return false if storage_selected < 0 or storage_selected >= storage_visible_entries.count.i64() or storage_selected >= storage_visible_statuses.count.i64()
            entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            statuses: darray[i64] = storage_visible_statuses
            entry: StudioStorageManifest::Entry = entries[storage_selected]
            StudioStorageRestorePolicy::eligible(entry.state,
                StudioStorageManifest::valid(entry), storage_manifest_state == 1,
                statuses[storage_selected] == StudioPanels::STORAGE_STATUS_IN_TRASH,
                true, false)

        def restore_storage_entry() -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            expected: StudioStorageManifest::Entry = storage_restore_entry
            refresh_storage_inventory()
            # Reload the manifest before mutating it, and require the reviewed
            # receipt to remain visible and durable after fresh source checks.
            mutable still_available: bool = false
            entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            statuses: darray[i64] = storage_visible_statuses
            if storage_message != 1 and storage_message != 2 and storage_message != 5:
                for index in 0..<entries.count |entries, statuses, expected, still_available|:
                    entry: StudioStorageManifest::Entry = entries[index]
                    if index < statuses.count and statuses[index] == StudioPanels::STORAGE_STATUS_IN_TRASH and storage_identity_matches(expected, entry) and StudioStorageManifest::same_path(expected.trashed_path, entry.trashed_path):
                        still_available <- true
            if not still_available:
                storage_message <- 9
                touch()
                return
            mutable recovered: StudioStorageManifest::Entry = zeroed
            mutable explanation: darray[u8] = []
            if not StudioFileTrash::reconcile("build", expected, &recovered, &explanation):
                refresh_storage_inventory()
                storage_message <- 7
                touch()
                return
            if not storage_identity_matches(expected, recovered) or not StudioStorageManifest::same_path(expected.trashed_path, recovered.trashed_path):
                refresh_storage_inventory()
                storage_message <- 9
                touch()
                return
            if not StudioFileTrash::restore("build", recovered, &explanation):
                refresh_storage_inventory()
                storage_message <- 7
                touch()
                return
            # Refresh recognizes the exact original identity and atomically
            # changes its receipt back to REGISTERED. A failed save retains
            # the on-disk receipt so another refresh can finish recovery.
            refresh_storage_inventory()
            storage_message <- 8 if storage_message == 5 or storage_message == 1 else 6
            touch()

        # The reviewed identity is already durable before the native move.
        # Engine reconciliation can recover it after a crash before receipt save.
        def move_storage_reviewed_entry(expected: StudioStorageManifest::Entry, confirmed: bool) -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            refresh_storage_inventory()
            mutable fresh_matches: bool = false
            mutable fresh_eligible: bool = false
            entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            reasons: darray[i64] = storage_visible_reasons
            for index in 0..<entries.count |entries, reasons, expected, fresh_matches, fresh_eligible|:
                entry: StudioStorageManifest::Entry = entries[index]
                if entry.state == StudioStorageManifest::REGISTERED and storage_identity_matches(expected, entry):
                    fresh_matches <- true
                    fresh_eligible <- index < reasons.count and reasons[index] == StudioStorageCleanupPolicy::PROTECT_NONE
            if not StudioStorageMovePolicy::may_move(storage_manifest_state == 1 and storage_message != 5,
                    StudioStorageManifest::valid(expected) and expected.state == StudioStorageManifest::REGISTERED,
                    fresh_matches, fresh_eligible, confirmed):
                storage_move_outcome <- StudioStorageMovePolicy::OUTCOME_NOT_STARTED
                storage_message <- 9
                touch()
                return
            mutable receipt: StudioStorageManifest::Entry = zeroed
            mutable explanation: darray[u8] = []
            mutable moved: bool = StudioFileTrash::move_entry("build", expected, &receipt, &explanation)
            if not moved:
                # A native failure can follow a move and failed internal rollback.
                # A verified recovery lookup is stronger evidence than its code.
                moved <- StudioFileTrash::reconcile("build", expected, &receipt, &explanation)
            if not moved:
                mutable original: StudioStorageManifest::Entry = zeroed
                original_known: bool = StudioFileTrash::snapshot_path("build", expected.original_path, expected.kind, &original, &explanation) and storage_identity_matches(expected, original)
                storage_move_outcome <- StudioStorageMovePolicy::outcome(
                    StudioStorageMovePolicy::MOVE_FAILED_ORIGINAL_KNOWN if original_known else StudioStorageMovePolicy::MOVE_UNKNOWN_AFTER_FAILURE,
                    StudioStorageMovePolicy::WRITE_NOT_ATTEMPTED, StudioStorageMovePolicy::ROLLBACK_NOT_ATTEMPTED)
                refresh_storage_inventory()
                storage_message <- 11 if original_known else 15
                touch()
                return
            storage_retained_receipt <- receipt
            mutable updated: darray[StudioStorageManifest::Entry] = []
            for entry in storage_entries |entry, updated, expected, receipt|:
                updated.push(receipt if storage_identity_matches(expected, entry) else entry)
            if persist_storage_manifest(updated):
                storage_entries <- updated
                storage_retained_receipt <- null
                storage_move_outcome <- StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MOVE_VERIFIED,
                    StudioStorageMovePolicy::WRITE_SUCCEEDED, StudioStorageMovePolicy::ROLLBACK_NOT_ATTEMPTED)
                refresh_storage_inventory()
                storage_message <- 10
                touch()
                return
            # Preserve the verified receipt until a fresh original snapshot
            # proves rollback, or an atomic save makes the receipt durable.
            _ = StudioFileTrash::restore("build", receipt, &explanation)
            mutable original: StudioStorageManifest::Entry = zeroed
            original_restored: bool = StudioFileTrash::snapshot_path("build", expected.original_path, expected.kind, &original, &explanation) and storage_identity_matches(expected, original)
            mutable rollback: i64 = StudioStorageMovePolicy::ROLLBACK_SUCCEEDED if original_restored else StudioStorageMovePolicy::ROLLBACK_UNKNOWN
            if not original_restored:
                mutable still_in_trash: StudioStorageManifest::Entry = zeroed
                if StudioFileTrash::reconcile("build", receipt, &still_in_trash, &explanation):
                    storage_retained_receipt <- still_in_trash
                    rollback <- StudioStorageMovePolicy::ROLLBACK_FAILED
            else:
                storage_retained_receipt <- null
            storage_move_outcome <- StudioStorageMovePolicy::outcome(StudioStorageMovePolicy::MOVE_VERIFIED,
                StudioStorageMovePolicy::WRITE_FAILED, rollback)
            refresh_storage_inventory()
            storage_message <- 12 if original_restored else 13 if rollback == StudioStorageMovePolicy::ROLLBACK_FAILED else 15
            touch()

        def storage_action(action: i64) -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            if action == StudioPanels::STORAGE_REFRESH:
                refresh_storage_inventory()
                touch()
            elif action == StudioPanels::STORAGE_DONE:
                close_storage_screen()
            elif action == StudioPanels::STORAGE_RESTORE and storage_restore_available():
                if storage_restore_review:
                    restore_storage_entry()
                else:
                    entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
                    storage_restore_entry <- entries[storage_selected]
                    storage_restore_review <- true
                    touch()

        def storage_key(code: UiCore::Key) -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            if code == UiCore::Key.Escape:
                if storage_restore_review:
                    storage_restore_review <- false
                    touch()
                else:
                    close_storage_screen()
            elif code == UiCore::Key.Up:
                if storage_focus < 0 and storage_visible_entries.count > 0:
                    storage_restore_review <- false
                    storage_selected <- storage_selected - 1 if storage_selected > 0
                    touch()
            elif code == UiCore::Key.Down:
                if storage_focus < 0 and storage_visible_entries.count > 0:
                    storage_restore_review <- false
                    storage_selected <- storage_selected + 1 if storage_selected + 1 < storage_visible_entries.count.i64()
                    touch()
            elif code == UiCore::Key.Tab:
                storage_focus <- (StudioPanels::STORAGE_DONE if StudioShortcuts::shift(modifiers) else StudioPanels::STORAGE_REFRESH) if storage_focus < 0 else (storage_focus + (StudioPanels::STORAGE_ACTION_COUNT - 1 if StudioShortcuts::shift(modifiers) else 1)) % StudioPanels::STORAGE_ACTION_COUNT
                touch()
            elif code == UiCore::Key.Left or code == UiCore::Key.Right:
                if storage_focus >= 0:
                    storage_focus <- (storage_focus + (StudioPanels::STORAGE_ACTION_COUNT - 1 if code == UiCore::Key.Left else 1)) % StudioPanels::STORAGE_ACTION_COUNT
                    touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                storage_action(storage_focus) if storage_focus >= 0

        def storage_pointer_down(w: f32, h: f32, x: f32, y: f32, button: i32) -> void can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            return if button != 0
            action: i64 = StudioPanels::storage_hit(w, h, x, y)
            if action >= 0:
                storage_focus <- action
                storage_action(action)
                return
            row: i64 = StudioPanels::storage_row_hit(w, h, x, y,
                storage_visible_entries.count.i64(), storage_selected)
            if row >= 0:
                storage_restore_review <- false
                storage_selected <- row
                storage_focus <- -1
                touch()

        def current_export_warnings() -> i64:
            if clip is c:
                return StudioExportPolicy::warning_count(
                    c.impossible_frames,
                    c.spikes_before, c.spikes_after,
                    c.slide_before, c.slide_after,
                    c.sink_before, c.sink_after,
                    c.hand_slide_before, c.hand_slide_after)
            0

        # Warning rows are ordered exactly as their presentation: balance,
        # spikes, foot slide, foot sink, then hand slide. Only present rows
        # occupy an index, keeping keyboard and pointer navigation compact.
        def export_warning_kind(index: i64, c: StudioModel::Clip&) -> i64:
            requires index >= 0 and index < StudioExportReview::MAX_WARNINGS
            mutable row: i64 = 0
            if c.impossible_frames > 0:
                return StudioExportReview::BALANCE_WARNING if row == index
                row <- row + 1
            if c.spikes_after > c.spikes_before:
                return StudioExportReview::SPIKE_WARNING if row == index
                row <- row + 1
            if c.slide_after > c.slide_before:
                return StudioExportReview::FOOT_SLIDE_WARNING if row == index
                row <- row + 1
            if c.sink_after > c.sink_before:
                return StudioExportReview::FOOT_SINK_WARNING if row == index
                row <- row + 1
            if c.hand_slide_after > c.hand_slide_before:
                return StudioExportReview::HAND_SLIDE_WARNING if row == index
            StudioExportReview::NO_WARNING

        def current_export_warning_kind(index: i64) -> i64:
            if clip is c and index >= 0 and index < current_export_warnings():
                return export_warning_kind(index, c)
            StudioExportReview::NO_WARNING

        def request_export(destination: cstr, overwrite_confirmed: bool) -> void:
            if clip is c:
                reason: i64 = export_reason(destination, overwrite_confirmed)
                if reason != StudioExportPolicy::ALLOW and reason != StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                    say_file(export_error(reason), destination)
                    touch()
                    return
                export_review_open <- true
                export_review_path <- destination
                export_review_overwrite <- overwrite_confirmed
                export_review_acknowledged <- false
                export_review_focus <- StudioExportReview::initial_focus(current_export_warnings())
                export_review_warning_selected <- 0
                export_warning_detail_open <- false
                export_warning_detail_index <- 0
                export_warning_detail_focus <- StudioExportPathReview::DONE
                help_open <- false
                file_menu_open <- false
                touch()

        def cancel_export_review() -> void:
            return if not export_review_open
            destination: cstr = export_review_path
            export_path_inspector_open <- false
            export_warning_detail_open <- false
            export_warning_detail_index <- 0
            export_warning_detail_focus <- StudioExportPathReview::DONE
            export_review_open <- false
            export_review_path <- ""
            export_review_acknowledged <- false
            say_file("Export cancelled; no file was written", destination)
            touch()

        def open_export_path_inspector() -> void:
            return if not export_review_open
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            return if pages < 1 or pages > StudioExportPathReview::MAX_PAGES
            export_path_inspector_page <- 0
            export_path_inspector_focus <- StudioExportPathReview::initial_focus(0, pages)
            export_path_inspector_open <- true
            touch()

        def close_export_path_inspector() -> void:
            return if not export_path_inspector_open
            export_path_inspector_open <- false
            touch()

        def close_export_warning_detail() -> void:
            return if not export_warning_detail_open
            export_warning_detail_open <- false
            export_review_warning_selected <- export_warning_detail_index
            touch()

        def open_export_warning_detail(index: i64) -> void:
            warnings: i64 = current_export_warnings()
            return if not export_review_open or index < 0 or index >= warnings
            export_review_warning_selected <- index
            export_review_focus <- StudioExportReview::INSPECT_WARNINGS
            export_warning_detail_index <- index
            export_warning_detail_focus <- StudioExportPathReview::initial_focus(index, warnings)
            export_warning_detail_open <- true
            touch()

        def activate_export_warning_detail(action: i64) -> void:
            return if not export_warning_detail_open
            warnings: i64 = current_export_warnings()
            return if warnings < 1 or warnings > StudioExportReview::MAX_WARNINGS
            if action == StudioExportPathReview::DONE:
                close_export_warning_detail()
                return
            return if not StudioExportPathReview::enabled(action, export_warning_detail_index, warnings)
            direction: i64 = -1 if action == StudioExportPathReview::PREVIOUS else 1
            export_warning_detail_index <- StudioExportPathReview::move_page(
                export_warning_detail_index, direction, warnings)
            export_review_warning_selected <- export_warning_detail_index
            export_warning_detail_focus <- action if StudioExportPathReview::enabled(
                action, export_warning_detail_index, warnings)
            export_warning_detail_focus <- StudioExportPathReview::initial_focus(
                export_warning_detail_index, warnings) if not StudioExportPathReview::enabled(
                action, export_warning_detail_index, warnings)
            touch()

        def export_warning_detail_key(code: UiCore::Key) -> void:
            warnings: i64 = current_export_warnings()
            if code == UiCore::Key.Escape:
                close_export_warning_detail()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                activate_export_warning_detail(StudioExportPathReview::PREVIOUS) if StudioExportPathReview::enabled(StudioExportPathReview::PREVIOUS, export_warning_detail_index, warnings)
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                activate_export_warning_detail(StudioExportPathReview::NEXT) if StudioExportPathReview::enabled(StudioExportPathReview::NEXT, export_warning_detail_index, warnings)
            elif code == UiCore::Key.Tab:
                export_warning_detail_focus <- StudioExportPathReview::move_focus(
                    export_warning_detail_focus,
                    -1 if StudioShortcuts::shift(modifiers) else 1,
                    export_warning_detail_index, warnings)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_warning_detail(export_warning_detail_focus)

        def activate_export_path_inspector(action: i64) -> void:
            return if not export_path_inspector_open
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            return if pages < 1 or pages > StudioExportPathReview::MAX_PAGES
            if action == StudioExportPathReview::DONE:
                close_export_path_inspector()
                return
            return if not StudioExportPathReview::enabled(action, export_path_inspector_page, pages)
            direction: i64 = -1 if action == StudioExportPathReview::PREVIOUS else 1
            export_path_inspector_page <- StudioExportPathReview::move_page(
                export_path_inspector_page, direction, pages)
            export_path_inspector_focus <- action if StudioExportPathReview::enabled(
                action, export_path_inspector_page, pages)
            export_path_inspector_focus <- StudioExportPathReview::initial_focus(
                export_path_inspector_page, pages) if not StudioExportPathReview::enabled(
                action, export_path_inspector_page, pages)
            touch()

        def export_path_inspector_key(code: UiCore::Key) -> void:
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            if code == UiCore::Key.Escape:
                close_export_path_inspector()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                activate_export_path_inspector(StudioExportPathReview::PREVIOUS) if StudioExportPathReview::enabled(StudioExportPathReview::PREVIOUS, export_path_inspector_page, pages)
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                activate_export_path_inspector(StudioExportPathReview::NEXT) if StudioExportPathReview::enabled(StudioExportPathReview::NEXT, export_path_inspector_page, pages)
            elif code == UiCore::Key.Tab:
                export_path_inspector_focus <- StudioExportPathReview::move_focus(
                    export_path_inspector_focus,
                    -1 if StudioShortcuts::shift(modifiers) else 1,
                    export_path_inspector_page, pages)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_path_inspector(export_path_inspector_focus)

        def activate_export_review(focus: i64) -> void:
            return if not export_review_open
            if focus == StudioExportReview::ACKNOWLEDGE:
                if current_export_warnings() > 0:
                    export_review_acknowledged <- not export_review_acknowledged
                    touch()
                return
            if focus == StudioExportReview::DESTINATION:
                open_export_path_inspector()
                return
            if focus == StudioExportReview::INSPECT_WARNINGS:
                open_export_warning_detail(export_review_warning_selected)
                return
            if focus == StudioExportReview::CANCEL:
                cancel_export_review()
                return
            warnings: i64 = current_export_warnings()
            if not StudioExportReview::export_enabled(warnings, export_review_acknowledged):
                export_review_focus <- StudioExportReview::ACKNOWLEDGE
                say_file("Review the quality notes before exporting", export_review_path)
                touch()
                return
            destination: cstr = export_review_path
            overwrite_confirmed: bool = export_review_overwrite
            export_path_inspector_open <- false
            export_warning_detail_open <- false
            export_warning_detail_index <- 0
            export_warning_detail_focus <- StudioExportPathReview::DONE
            export_review_open <- false
            export_review_path <- ""
            export_review_acknowledged <- false
            _ = perform_export(destination, overwrite_confirmed)

        def export_review_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                cancel_export_review()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                export_review_focus <- StudioExportReview::move_focus(export_review_focus, -1, current_export_warnings())
                touch()
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                export_review_focus <- StudioExportReview::move_focus(export_review_focus, 1, current_export_warnings())
                touch()
            elif code == UiCore::Key.Tab:
                export_review_focus <- StudioExportReview::move_focus(export_review_focus, -1 if StudioShortcuts::shift(modifiers) else 1, current_export_warnings())
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_review(export_review_focus)

        def cancel_export_result() -> void:
            return if not export_result_open
            export_result_open <- false
            export_result_path <- ""
            touch()

        def activate_export_result(action: i64) -> void:
            return if not export_result_open
            destination: cstr = export_result_path
            if action == StudioExportResult::DONE:
                cancel_export_result()
                return
            if action == StudioExportResult::OPEN:
                if FilePanel::open_file(destination):
                    cancel_export_result()
                    say_file("opened exported result", destination)
                else:
                    say_file("could not open the result in its default application", destination)
                    touch()
                return
            if action == StudioExportResult::SHOW_IN_FOLDER:
                if FilePanel::show_in_folder(destination):
                    cancel_export_result()
                    say_file("showing exported result in Finder", destination)
                else:
                    say_file("could not show the result in Finder", destination)
                    touch()

        def export_result_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                cancel_export_result()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                export_result_focus <- StudioExportResult::move_focus(export_result_focus, -1)
                touch()
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                export_result_focus <- StudioExportResult::move_focus(export_result_focus, 1)
                touch()
            elif code == UiCore::Key.Tab:
                export_result_focus <- StudioExportResult::move_focus(export_result_focus, -1 if StudioShortcuts::shift(modifiers) else 1)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_result(export_result_focus)

        def perform_export(destination: cstr, overwrite_confirmed: bool) -> bool:
            if clip is c:
                mutable allows_overwrite: bool = overwrite_confirmed
                mutable reason: i64 = export_reason(destination, allows_overwrite)
                if reason == StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                    if FilePanel::confirm_replace(destination):
                        allows_overwrite <- true
                        reason <- export_reason(destination, true)
                    else:
                        say_file("Export cancelled; existing file kept", destination)
                        touch()
                        return false
                if reason != StudioExportPolicy::ALLOW:
                    say_file(export_error(reason), destination)
                    touch()
                    return false

                mutable prepare_error: i64 = StudioExportValidation::WRITE_FAILED
                if StudioExportPublisher::prepare(c.cleaned, destination, &prepare_error) is temporary:
                    # Recheck after writing and validating the temporary so a
                    # destination that changed during export cannot be silently
                    # replaced. Publication is a single same-directory rename.
                    reason <- export_reason(destination, allows_overwrite)
                    if reason == StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                        if FilePanel::confirm_replace(destination):
                            allows_overwrite <- true
                            reason <- export_reason(destination, true)
                        else:
                            StudioExportPublisher::discard(temporary)
                            FilePanel::release_path(temporary)
                            say_file("Export cancelled; existing file kept", destination)
                            touch()
                            return false
                    if reason != StudioExportPolicy::ALLOW:
                        StudioExportPublisher::discard(temporary)
                        FilePanel::release_path(temporary)
                        say_file(export_error(reason), destination)
                        touch()
                        return false
                    if StudioExportPublisher::commit(temporary, destination):
                        storage_tracking_failed <- false
                        report_saved: bool = write_export_report(destination, temporary)
                        export_report_saved <- report_saved
                        FilePanel::release_path(temporary)
                        export_path <- destination
                        say_file("Export complete; report saved, but Storage tracking could not be saved", destination) if storage_tracking_failed
                        say_file("exported and validated; report saved", destination) if report_saved and not storage_tracking_failed
                        say_file("GLB exported and validated; report sidecars could not be saved beside destination", destination) if not report_saved and not storage_tracking_failed
                        FilePanel::note_recent(destination)
                        _ = puts(destination)
                        export_result_path <- destination
                        export_result_focus <- StudioExportResult::OPEN
                        export_result_open <- true
                        touch()
                        return true
                    StudioExportPublisher::discard(temporary)
                    FilePanel::release_path(temporary)
                    say_file("export failed; destination kept", destination)
                else:
                    say_file(StudioExportValidation::message(prepare_error), destination)
                touch()
            false

        def report_integer(value: i64) -> sview can Unsafe.PointerCast:
            StudioText::begin()
            StudioText::put_i(value)
            StudioText::view()

        def report_indexed_name(prefix: sview, index: i64) -> sview can Unsafe.PointerCast:
            StudioText::begin()
            StudioText::put(prefix)
            StudioText::put_i(index)
            StudioText::view()

        def report_operation(operation: Ops::Operation) -> sview can Unsafe.PointerCast:
            StudioText::begin()
            match operation.kind:
                Ops::Kind.Despike:
                    StudioText::put("despike")
                Ops::Kind.PinContacts:
                    StudioText::put("pin_contacts")
                Ops::Kind.CloseSeam:
                    StudioText::put("close_seam")
                Ops::Kind.SmoothPath:
                    StudioText::put("smooth_path")
                Ops::Kind.LimitWring:
                    StudioText::put("limit_wring")
                Ops::Kind.Median:
                    StudioText::put("median")
            StudioText::put(";enabled=")
            StudioText::put("true") if operation.enabled
            StudioText::put("false") if not operation.enabled
            StudioText::put(";frames=")
            StudioText::put_i(operation.first)
            StudioText::put("..")
            StudioText::put_i(operation.last)
            StudioText::put(";bones=")
            StudioText::put_i(operation.bones)
            StudioText::put(";strength=")
            StudioText::put_i(operation.strength)
            StudioText::put(";edge_frames=")
            StudioText::put_i(operation.edge)
            StudioText::view()

        def report_band(band: StackState::Band) -> sview can Unsafe.PointerCast:
            StudioText::begin()
            StudioText::put("enabled=")
            StudioText::put("true") if band.enabled
            StudioText::put("false") if not band.enabled
            StudioText::put(";source_frames=")
            StudioText::put_i(band.first)
            StudioText::put("..")
            StudioText::put_i(band.last)
            StudioText::put(";speed_permille=")
            StudioText::put_i(band.speed)
            StudioText::put(";blend_frames=")
            StudioText::put_i(band.blend)
            StudioText::view()

        # Reports are best-effort sidecars after the GLB's atomic commit. The
        # source label is a basename, and fingerprints remain explicitly
        # non-cryptographic residues. Values unavailable in the current export
        # snapshot (tool versions and detailed retime provenance) are omitted.
        def write_export_report(destination: cstr, validated_path: cstr) -> bool can Unsafe.PointerCast:
            if clip is c:
                return write_export_report_for(c, destination, validated_path)
            false

        def write_export_report_for(c: StudioModel::Clip&, destination: cstr, validated_path: cstr) -> bool can Unsafe.PointerCast:
            written: GlbDocument::Document = catch GlbDocument::load(validated_path):
                value: value
                error failure: return false
            output_identity: StudioSourceFingerprint::Fingerprint? = StudioModel::fingerprint(&written)
            mutable output_fp: StudioSourceFingerprint::Fingerprint = zeroed
            if output_identity is found_fp:
                output_fp <- found_fp
            else:
                return false
            mutable name_start: usize = 0
            mutable path_end: usize = 0
            while path_end < 4096 and destination[path_end] != 0:
                if destination[path_end] == 47 or destination[path_end] == 92:
                    name_start <- path_end + 1
                path_end <- path_end + 1
            return false if path_end == 0 or path_end >= 4096 or name_start >= path_end
            StudioText::begin()
            for index in name_start..<path_end |index, path|:
                StudioText::byte(path[index])
            source_name: sview = StudioText::view()
            active_stack: StackState::Stack = current_stack()
            mutable settings: darray[StudioExportReport::Setting] = []
            settings.push(StudioExportReport::Setting{name: "foot_cleanup", value: "enabled"}) if active_stack.feet
            settings.push(StudioExportReport::Setting{name: "foot_cleanup", value: "disabled"}) if not active_stack.feet
            settings.push(StudioExportReport::Setting{name: "hand_cleanup", value: "enabled"}) if active_stack.hands
            settings.push(StudioExportReport::Setting{name: "hand_cleanup", value: "disabled"}) if not active_stack.hands
            settings.push(StudioExportReport::Setting{name: "cleanup_blend_frames", value: report_integer(active_stack.blend)})
            for index in 0..<active_stack.count |settings, active_stack|:
                operation: Ops::Operation = active_stack.ops[index]
                settings.push(StudioExportReport::Setting{name: report_indexed_name("operation_", index), value: report_operation(operation)})
            for index in 0..<active_stack.band_count |settings, active_stack|:
                band: StackState::Band = active_stack.bands[index]
                settings.push(StudioExportReport::Setting{name: report_indexed_name("retime_band_", index), value: report_band(band)})
            settings.push(StudioExportReport::Setting{name: "retime_applied", value: "true"}) if c.retimed
            settings.push(StudioExportReport::Setting{name: "retime_applied", value: "false"}) if not c.retimed
            assumptions: darray[sview] = [
                "Frame rate is an integer estimate; durations are floored to milliseconds.",
                "Fingerprints are non-cryptographic studio-residue-v1 values.",
                "Operation fields and retime bands are reported from the active stack at export; detailed rig settings and per-frame source-time mapping are unavailable."]
            metrics: StudioExportReport::Metrics = StudioExportReport::Metrics{
                changed_channels: c.changed,
                spikes_before: c.spikes_before,
                spikes_after: c.spikes_after,
                foot_slide_before_um: c.slide_before,
                foot_slide_after_um: c.slide_after,
                foot_sink_before_um: c.sink_before,
                foot_sink_after_um: c.sink_after,
                hand_slide_before_um: c.hand_slide_before,
                hand_slide_after_um: c.hand_slide_after,
                balance_impossible_frames: c.impossible_frames}
            mutable warnings: darray[StudioExportReport::Warning] = []
            if c.impossible_frames > 0:
                warnings.push(StudioExportReport::Warning{category: "balance", severity: StudioExportReport::WARNING, message: "Frames marked impossible by the Studio balance detector."})
            if c.spikes_after > c.spikes_before:
                warnings.push(StudioExportReport::Warning{category: "spikes", severity: StudioExportReport::WARNING, message: "Detected spike frames increased after cleanup."})
            if c.slide_after > c.slide_before:
                warnings.push(StudioExportReport::Warning{category: "foot_slide", severity: StudioExportReport::WARNING, message: "Measured planted-foot slide increased after cleanup."})
            if c.sink_after > c.sink_before:
                warnings.push(StudioExportReport::Warning{category: "foot_sink", severity: StudioExportReport::WARNING, message: "Measured foot sink increased after cleanup."})
            if c.hand_slide_after > c.hand_slide_before:
                warnings.push(StudioExportReport::Warning{category: "hand_slide", severity: StudioExportReport::WARNING, message: "Measured hand slide increased after cleanup."})
            data: StudioExportReport::Data = StudioExportReport::Data{
                source_name: source_name,
                source_fingerprint_first: c.source_fingerprint.first,
                source_fingerprint_second: c.source_fingerprint.second,
                output_fingerprint_first: output_fp.first,
                output_fingerprint_second: output_fp.second,
                animation_name: anim_name, animation_index: c.anim.i64(),
                input_frames: c.source_frames, input_fps: c.rate,
                output_frames: c.frames, output_fps: c.rate,
                settings: settings, assumptions: assumptions, metrics: metrics,
                warnings: warnings}
            json: darray[u8] = StudioExportReport::json(&data)
            summary: darray[u8] = StudioExportReport::summary(&data)
            mutable json_path: u8[4128] = zeroed
            mutable text_path: u8[4128] = zeroed
            for index in 0..<path_end |destination, json_path, text_path|:
                json_path[index] <- destination[index]
                text_path[index] <- destination[index]
            suffix_json: cstr = ".report.json"
            suffix_text: cstr = ".report.txt"
            mutable a: usize = 0
            mutable b: usize = 0
            while suffix_json[a] != 0:
                json_path[path_end + a] <- suffix_json[a]
                a <- a + 1
            while suffix_text[b] != 0:
                text_path[path_end + b] <- suffix_text[b]
                b <- b + 1
            json_path[path_end + a] <- 0
            text_path[path_end + b] <- 0
            json_cstr: cstr = (&json_path[0]).cast[cstr] can Unsafe.PointerCast
            text_cstr: cstr = (&text_path[0]).cast[cstr] can Unsafe.PointerCast
            json_ok: bool = StudioExportPublisher::write_sidecar(json_cstr, json)
            text_ok: bool = StudioExportPublisher::write_sidecar(text_cstr, summary)
            storage_tracking_failed <- true if json_ok and not register_storage_artifact(json_cstr, StudioStorageCleanupPolicy::GENERATED_REPORT)
            storage_tracking_failed <- true if text_ok and not register_storage_artifact(text_cstr, StudioStorageCleanupPolicy::GENERATED_REPORT)
            json_ok and text_ok

        # ---- native file panels (modal) --------------------------------
        def save_session_as() -> void:
            if FilePanel::save("txt", session_path, "Save the operation stack and contacts as a session") is chosen:
                if set_session_path(chosen):
                    save_session()
                else:
                    say_file("session path exceeds 4095 bytes", chosen)
                    touch()

        def open_session() -> void:
            if clip == null:
                status <- "open a take before loading a session"
                status_file <- null
                touch()
                return
            if FilePanel::open("txt", "Open a saved session for this take") is chosen:
                request_replacement(chosen, REPLACE_SESSION, false)

        def export_as() -> void:
            return if clip == null
            if FilePanel::save("glb", export_path, "Export the cleaned take") is chosen:
                request_export(chosen, true)

        def dispatch_file_action(action: i64) -> void:
            if action == StudioFilePolicy::OPEN_TAKE:
                open_take()
            elif action == StudioFilePolicy::OPEN_SESSION:
                open_session()
            elif action == StudioFilePolicy::SAVE:
                save_session()
            elif action == StudioFilePolicy::SAVE_AS:
                save_session_as()
            elif action == StudioFilePolicy::EXPORT_CURRENT:
                request_export(export_path, false)
            elif action == StudioFilePolicy::EXPORT_AS:
                export_as()
            elif action == StudioFilePolicy::OPEN_STORAGE:
                open_storage_screen()

        def activate_file_menu(row: i64) -> void:
            return if row < 0 or row >= StudioFilePolicy::ROWS
            action: i64 = StudioFilePolicy::activate(row, clip != null)
            return if action == StudioFilePolicy::NONE
            file_menu_open <- false
            file_menu_hover <- -1
            touch()
            dispatch_file_action(action)

        def file_menu_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                file_menu_open <- false
                file_menu_hover <- -1
                touch()
            elif code == UiCore::Key.Up:
                file_menu_focus <- StudioFilePolicy::next_enabled(file_menu_focus, -1, clip != null)
                touch()
            elif code == UiCore::Key.Down:
                file_menu_focus <- StudioFilePolicy::next_enabled(file_menu_focus, 1, clip != null)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_file_menu(file_menu_focus)

        def replacement_action_for_focus() -> i64:
            return StudioReplacement::SAVE if replacement_focus == StudioReplacement::FOCUS_SAVE
            return StudioReplacement::DISCARD if replacement_focus == StudioReplacement::FOCUS_DISCARD
            StudioReplacement::CANCEL

        def finish_close() -> void can[Ui.Window]:
            replacement_prompt_open <- false
            replacement_is_close <- false
            replacement_save_failed <- false
            pending_replacement <- 0
            pending_replacement_allows_legacy <- false
            pending_session_ready <- false
            clear_pending_session_annotations()
            touch()
            if replacement_is_termination:
                termination_authorized <- true
                UiAppKitCanvas::terminate()
            else:
                close_authorized <- true
                UiAppKitCanvas::close()

        def perform_replacement(kind: i64, p: cstr, allow_legacy: bool) -> void can Unsafe.PointerCast:
            replacement_prompt_open <- false
            legacy_prompt_open <- false
            replacement_is_close <- false
            replacement_is_termination <- false
            replacement_save_failed <- false
            file_menu_open <- false
            pending_replacement <- 0
            pending_replacement_allows_legacy <- false
            touch()
            if kind == REPLACE_TAKE:
                pending_session_ready <- false
                clear_pending_session_annotations()
                load_take_now(p)
            elif kind == REPLACE_SESSION:
                if pending_session_ready:
                    loaded: StackState::Stack = pending_session_stack
                    pending_session_ready <- false
                    install_session(p, loaded, allow_legacy)
                else:
                    say_file("session validation expired; open it again", p)
                    touch()

        def request_replacement(p: cstr, kind: i64, allow_legacy: bool) -> void can Unsafe.PointerCast:
            return if kind != REPLACE_TAKE and kind != REPLACE_SESSION
            cancel_export_result() if export_result_open
            cancel_export_review() if export_review_open
            if replacement_prompt_open or legacy_prompt_open:
                status <- "finish or cancel the pending replacement first"
                status_file <- null
                touch()
                return
            if not stage_pending_path(p):
                status <- "file path exceeds 4095 bytes"
                status_file <- null
                touch()
                return
            pending_session_ready <- false
            clear_pending_session_annotations()
            if kind == REPLACE_SESSION:
                if clip is c:
                    mutable decoded_annotations: darray[SessionIssueAnnotationPolicy::Stored] = []
                    if SessionState::load_session_with_annotations(p, frames(), node_total(), session_identity(c), allow_legacy, &decoded_annotations) is prepared:
                        pending_session_stack <- prepared
                        pending_session_annotations <- move decoded_annotations
                        pending_session_ready <- true
                    else:
                        if not allow_legacy and SessionState::load_error() == SessionState::LOAD_ERROR_LEGACY:
                            legacy_prompt_open <- true
                            legacy_prompt_focus <- StudioLegacyPrompt::initial_focus()
                            file_menu_open <- false
                            help_open <- false
                            touch()
                            return
                        mutable failure: sview = "session cannot be read; it may be damaged or unsupported"
                        failure <- "session source, animation or rig does not match this take" if SessionState::load_error() == SessionState::LOAD_ERROR_SOURCE
                        failure <- "session file could not be read" if SessionState::load_error() == SessionState::LOAD_ERROR_READ
                        failure <- "session contains too many finding annotations" if SessionState::load_error() == SessionState::LOAD_ERROR_ANNOTATIONS
                        say_file(failure, p)
                        touch()
                        return
                else:
                    say_file("open a take before loading a session", p)
                    touch()
                    return
            pending_replacement <- kind
            pending_replacement_allows_legacy <- allow_legacy
            replacement_is_close <- false
            replacement_is_termination <- false
            mutable dirty: bool = false
            if history_ready:
                dirty <- HistoryState::dirty(&history)
            if StudioReplacement::needs_prompt(clip != null, dirty):
                replacement_prompt_open <- true
                replacement_focus <- StudioReplacement::initial_focus()
                replacement_save_failed <- false
                file_menu_open <- false
                help_open <- false
                touch()
                return
            perform_replacement(kind, pending_path(), allow_legacy)

        def resolve_replacement(choice: i64) -> void:
            action: i64 = StudioReplacement::resolve(replacement_prompt_open, choice)
            return if action == StudioReplacement::NONE
            if action == StudioReplacement::CANCEL:
                mutable cancelled: sview = "replacement cancelled; session unchanged"
                cancelled <- "close cancelled; session unchanged" if replacement_is_close
                cancelled <- "quit cancelled; session unchanged" if replacement_is_termination
                replacement_prompt_open <- false
                replacement_is_close <- false
                replacement_is_termination <- false
                replacement_save_failed <- false
                pending_replacement <- 0
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                clear_pending_session_annotations()
                say_file(cancelled, path)
                touch()
                return
            pending: cstr = pending_path()
            kind: i64 = pending_replacement
            allow_legacy: bool = pending_replacement_allows_legacy
            if action == StudioReplacement::SAVE:
                if not save_session_to_current_path():
                    replacement_save_failed <- true
                    touch()
                    return
            if kind == REPLACE_CLOSE:
                finish_close()
                return
            perform_replacement(kind, pending, allow_legacy)

        def request_window_close() -> void can[Ui.Window]:
            # AppKit may ask once for application termination and again for the
            # owned window close. Keep this authorization live through both.
            if termination_authorized:
                return
            # This bit is set only for the second, programmatic close request
            # made after the user chooses Save or Discard in the prompt.
            if close_authorized:
                close_authorized <- false
                return
            cancel_export_result() if export_result_open
            cancel_export_review() if export_review_open
            if legacy_prompt_open:
                legacy_prompt_open <- false
                pending_replacement <- 0
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                clear_pending_session_annotations()
                UiAppKitCanvas::veto_close()
                say_file("legacy session cancelled; current cleanup unchanged", pending_path())
                touch()
                return
            if replacement_prompt_open:
                pending_replacement <- REPLACE_CLOSE
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                clear_pending_session_annotations()
                replacement_is_close <- true
                replacement_is_termination <- UiAppKitCanvas::is_termination_request()
                UiAppKitCanvas::veto_close()
                touch()
                return
            mutable dirty: bool = false
            if history_ready:
                dirty <- HistoryState::dirty(&history)
            if StudioReplacement::needs_prompt(clip != null, dirty):
                pending_replacement <- REPLACE_CLOSE
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                clear_pending_session_annotations()
                replacement_prompt_open <- true
                replacement_is_close <- true
                replacement_is_termination <- UiAppKitCanvas::is_termination_request()
                replacement_focus <- StudioReplacement::initial_focus()
                replacement_save_failed <- false
                file_menu_open <- false
                help_open <- false
                UiAppKitCanvas::veto_close()
                touch()

        def replacement_prompt_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                resolve_replacement(StudioReplacement::CANCEL)
            elif code == UiCore::Key.S:
                resolve_replacement(StudioReplacement::SAVE)
            elif code == UiCore::Key.D:
                resolve_replacement(StudioReplacement::DISCARD)
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                replacement_focus <- StudioReplacement::move_focus(replacement_focus, -1)
                touch()
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                replacement_focus <- StudioReplacement::move_focus(replacement_focus, 1)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                resolve_replacement(replacement_action_for_focus())

        def open_take() -> void:
            if FilePanel::open("glb", "Open a motion-capture take") is chosen:
                load_take(chosen)

        # Swap in another take. The file is read first; if it holds no
        # usable animation the current take stays untouched. Otherwise every
        # per-take cache, the playhead, the gizmo and the undo history start
        # fresh (undo never reaches back into a different take).
        def load_take(p: cstr) -> void can Unsafe.PointerCast:
            request_replacement(p, REPLACE_TAKE, false)

        def load_take_now(p: cstr) -> void can Unsafe.PointerCast:
            candidate_slot: i64 = spare_path_slot()
            if not copy_path(p, candidate_slot):
                status <- "take path exceeds 4095 bytes"
                status_file <- null
                touch()
                return
            candidate_path: cstr = stored_path(candidate_slot)
            fresh: StudioModel::Memo? = StudioModel::load(candidate_path, anim_name)
            if fresh == null:
                say_file("no animation could be read from", candidate_path)
                touch()
                return
            path_slot <- candidate_slot
            path <- candidate_path
            memo <- move fresh
            contact_cancel_frame_draft() if contact_draft_target >= 0
            clip <- null
            contact_selected_side <- StudioContactEditor::NO_SIDE
            contact_selected_frame <- -1
            built_stack <- null
            shown_slide <- 0
            shown_sink <- 0
            shown_hand_slide <- 0
            built <- built + 1
            curve_memo <- zeroed
            base_frame <- -1
            base_built <- -1
            skinned <- null
            skinned_frame <- -1
            skinned_revision <- -1
            mesh <- null
            take_serial <- take_serial + 1
            if path_slot >= 0:
                loaded: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(path):
                    value: value
                    error failure: GlbSkinMesh::empty()
                if GlbSkinMesh::vertex_count(&loaded) > 0:
                    mesh <- loaded
            gizmo_drag <- null
            gizmo_goal <- null
            gizmo_view <- -1
            readout_angle <- -1
            readout_mm <- -1
            gain_slide <- -1
            gain_spikes <- -1
            drag_view <- -1
            drag_button <- -1
            scrubbing <- false
            foot_press <- FootState::Press{side: -1, part: 0, first: -1, last: -1, frame: -1}
            hover_row <- -1
            drawn_frame <- -1
            HistoryState::reset(&history, StudioModel::initial_stack())
            history_ready <- true
            rebuild()
            if clip is c:
                timeline <- TimelineState::create(c.frames)
                bone <- StudioModel::default_bone(c)
                framed <- false
                say_file("opened (undo history starts fresh)", path)
                FilePanel::note_recent(path)
            else:
                timeline <- TimelineState::create(1)
            touch()

        # ---- views -----------------------------------------------------
        def frame_all() -> void:
            if clip is c:
                pts: darray[Geometry::Vec3] = StudioScene::points(c, frame_now())
                for i in 0..<3 |i, pts|:
                    if view(i) is opened:
                        mutable vp: Viewport::Viewport = opened
                        _ = ViewportCamera::frame_points(&vp.camera, &pts, 1.15)
                        Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                        put_view(i, vp)
                touch()

        def view_at(x: f32, y: f32) -> i64:
            for i in 0..<3 |i, x, y|:
                return i if StudioPanels::inside(view_box(i), x, y)
            -1

        def modal_overlay_active() -> bool:
            StudioModalPolicy::hides_viewports(help_open, replacement_prompt_open,
                legacy_prompt_open, export_review_open, export_warning_detail_open,
                export_path_inspector_open, export_result_open) or storage_screen_open

        def sync_view(i: i64, scale: f32) -> void:
            if modal_overlay_active():
                # Native hosted surfaces render above canvas overlays. Remove
                # them while a blocking sheet is drawn; the next normal sync
                # presents them again after the sheet closes.
                if i == 0 and shown0.surface != 0:
                    UiAppKitCanvas::remove_hosted(&shown0, 0)
                elif i == 1 and shown1.surface != 0:
                    UiAppKitCanvas::remove_hosted(&shown1, 1)
                elif i == 2 and shown2.surface != 0:
                    UiAppKitCanvas::remove_hosted(&shown2, 2)
                return
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                rect: UiHostedSurface::Rect = rect_of(view_box(i))
                _ = catch Viewport::resize(&vp, UiHostedSurface::pixel_extent(rect.width, scale), UiHostedSurface::pixel_extent(rect.height, scale)):
                    value: value
                    error failure: false
                if seen(i) != revision:
                    Viewport::invalidate(&vp, ViewportPolicy::DIRTY_SCENE)
                    put_seen(i, revision)
                if clip is c:
                    refresh_skin(c)
                    empty_mesh: GlbSkinMesh::Mesh = GlbSkinMesh::empty()
                    no_points: darray[Geometry::Vec3] = []
                    mutable list: ViewportDraw::List = draw_list(&vp.camera, c, &empty_mesh, &no_points)
                    if gizmo_mode >= 0 and bone >= 0:
                        g: ViewportGizmo::Gizmo = StudioScene::gizmo_for(c, frame_now(), bone, gizmo_mode)
                        _ = catch ViewportGizmo::draw(&list, &vp.camera, &g, GizmoPolicy::NONE, active_handle()):
                            value: value
                            error failure: 0
                    _ = catch Viewport::tick(&vp, &list):
                        value: value
                        error failure: false
                action: i32 = present(i, vp, rect)
                if action == UiHostedSurface::APPLY:
                    _ = Viewport::acknowledge(&vp, vp.published_frame)
                if vp.dirty != 0:
                    UiCore::request_frame_after(0.016)
                put_view(i, vp)

        # Re-skin the mesh when the frame or the clip changed (MESH on only).
        # A drawable character model wins over the take's own mesh.
        def refresh_skin(c: StudioModel::Clip&) -> void:
            return if not StudioScene::on(flags, StudioScene::MESH)
            bind_character(c)
            return if skinned_frame == frame_now() and skinned_revision == revision
            if character_ready():
                if character is ch:
                    if character_binding is b:
                        posed_character: darray[Geometry::Vec3] = StudioCharacter::pose(ch, b, c, frame_now())
                        skinned <- posed_character
                        skinned_frame <- frame_now()
                        skinned_revision <- revision
                return
            if mesh is m:
                posed: darray[Geometry::Vec3] = StudioScene::pose_mesh(c, m, frame_now())
                skinned <- posed
                skinned_frame <- frame_now()
                skinned_revision <- revision

        # Refreshes the cached base pose and solves the gizmo chain preview. It reads and
        # writes heap globals, so its allocations live in the never-freed static region;
        # keeping it out of draw_list confines that to frames with an active gizmo goal.
        def chain_preview_of(c: StudioModel::Clip&, goal: Geometry::Transform) -> darray[Geometry::Transform]:
            r: PoseOverride::Rig = StudioModel::rig(c)
            if base_frame != frame_now() or base_built != built:
                base_models <- StudioModel::models(c, r, frame_now(), false)
                base_locals <- StudioClip::locals_at(c.cleaned, c.anim, frame_now(), c.nodes, c.slot)
                base_frame <- frame_now()
                base_built <- built
            p: StudioPerf::Preview = StudioPerf::chain_preview(r, base_models, base_locals, bone, goal)
            preview_moved <- p.moved
            return move p.models

        def draw_list(cam: ViewportCamera::Camera&, c: StudioModel::Clip&, empty_mesh: GlbSkinMesh::Mesh&, no_points: darray[Geometry::Vec3]&) -> ViewportDraw::List:
            mutable preview: darray[Geometry::Transform] = []
            if StudioOverlay::preview(gizmo_view, gizmo_drag != null, bone):
                if gizmo_goal is goal:
                    preview <- chain_preview_of(c, goal)
            if character_ready():
                if character is ch:
                    if skinned is p:
                        return StudioScene::build_with(cam, c, &ch.mesh, p, frame_now(), flags, bone, &preview)
                return StudioScene::build_with(cam, c, empty_mesh, no_points, frame_now(), flags, bone, &preview)
            if mesh is m:
                if skinned is p:
                    return StudioScene::build_with(cam, c, m, p, frame_now(), flags, bone, &preview)
            return StudioScene::build_with(cam, c, empty_mesh, no_points, frame_now(), flags, bone, &preview)

        def present(i: i64, vp: Viewport::Viewport&, rect: UiHostedSurface::Rect) -> i32:
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            if i == 0:
                return UiAppKitCanvas::present_hosted(&shown0, 0, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)
            if i == 1:
                return UiAppKitCanvas::present_hosted(&shown1, 1, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)
            UiAppKitCanvas::present_hosted(&shown2, 2, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)

        # ---- lifecycle -------------------------------------------------
        def init() -> void:
            UiHandles::reset()
            # The AppKit host asks UiBack before forwarding Escape. Keep the
            # Studio workspace on the shared back stack so its own ordered
            # escape layers (help, gestures, popovers, selection) get first
            # refusal instead of an unhandled Escape closing the window.
            _ = UiNavigation::push(1, UiNavigation::BackPolicy.Allow, false)
            init_accessibility_toolbar()
            initial: StackState::Stack = StudioModel::initial_stack()
            HistoryState::reset(&history, initial)
            history_ready <- true
            if path_slot >= 0:
                loaded: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(path):
                    value: value
                    error failure: GlbSkinMesh::empty()
                if GlbSkinMesh::vertex_count(&loaded) > 0:
                    mesh <- loaded
            if model_requested:
                load_character(model_path)
            rebuild()
            if clip is c:
                timeline <- TimelineState::create(c.frames)
                bone <- StudioModel::default_bone(c)
                _ = puts("studio: clip loaded")
            else:
                timeline <- TimelineState::create(1)
                if path_slot >= 0:
                    _ = puts("studio: clip not found; tried path / animation:")
                    _ = puts(path)
                    _ = puts(anim_name)
                    _ = puts("studio: quote a path that contains spaces")
            view0 <- open_view(0)
            view1 <- open_view(1)
            view2 <- open_view(2)
            if view0 == null:
                status <- "no Metal device"
                nudged_row <- -1
                status_file <- null
            last_time <- UiAppKitCanvas::monotonic_time()

        def advance() -> void:
            now: f64 = UiAppKitCanvas::monotonic_time()
            elapsed: f64 = now - last_time
            last_time <- now
            if timeline is t:
                if t.playing:
                    # The timeline kernels count frames at Timeline::RATE;
                    # scale wall time so the clip plays at its own rate.
                    us: i64 = (elapsed * 1000000.0 * rate().f64() / Timeline::RATE.f64()).i64()
                    n: TimelineState::State = TimelineState::tick(t, us)
                    timeline <- n
                    if n.frame != drawn_frame:
                        revision <- revision + 1
                    UiCore::request_frame_after(0.008)

        # Shift-F overlay: the last rebuild's stage times and the last draw.
        def perf_panel(c: StudioModel::Clip&) -> void:
            x: f32 = 16.0
            y: f32 = 44.0
            StudioDraw::rect(x - 6.0, y - 4.0, 250.0, 96.0, StudioDraw::color(10, 12, 16))
            StudioDraw::text(x, y, 12.0, StudioText::number("evaluate us ", c.evaluate_us), StudioDraw::ink())
            StudioDraw::text(x, y + 15.0, 12.0, StudioText::number("detectors us ", c.detect_us), StudioDraw::ink())
            StudioDraw::text(x, y + 30.0, 12.0, StudioText::number("draw us ", draw_us), StudioDraw::ink())
            StudioDraw::text(x, y + 45.0, 12.0, StudioText::number("poses evaluated ", c.poses), StudioDraw::muted())
            StudioDraw::text(x, y + 60.0, 12.0, StudioText::number("ops rerun ", c.ops_run), StudioDraw::muted())
            StudioDraw::text(x, y + 75.0, 12.0, StudioText::number("drag bones moved ", preview_moved), StudioDraw::muted())

        def frame() -> void:
            draw_start: f64 = UiAppKitCanvas::monotonic_time()
            advance()
            if not framed and clip != null:
                framed <- true
                frame_all()
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            UiCore::clear(StudioDraw::color(17, 20, 27))
            s: StackState::Stack = current_stack()
            mutable cursor: i64 = 0
            mutable count: i64 = 1
            mutable can_undo: bool = false
            mutable can_redo: bool = false
            mutable is_dirty: bool = false
            if history_ready:
                cursor <- history.cursor
                count <- history.count
                can_undo <- HistoryPolicy::can_undo(history.cursor)
                can_redo <- HistoryPolicy::can_redo(history.cursor, history.count)
                is_dirty <- HistoryState::dirty(&history)
            if timeline is t:
                StudioPanels::toolbar(t, flags, can_undo, can_redo)
                StudioDraw::text(StudioPanels::button_x(StudioPanels::BUTTONS) + 8.0, 16.0, 12.0, "?  shortcuts", StudioDraw::muted())
                for i in 0..<3 |i|:
                    b: StudioPanels::Box = view_box(i)
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(38, 40, 46))
                if clip is c:
                    first: i64 = -1
                    last: i64 = -1
                    if StackState::valid(s, s.selected):
                        op: Ops::Operation = s.ops[s.selected]
                        StudioPanels::timeline(StudioPanels::timeline_box(w, h), c, t, op.first, op.last if op.last < c.frames else c.frames - 1)
                    else:
                        StudioPanels::timeline(StudioPanels::timeline_box(w, h), c, t, first, last)
                    StudioPanels::curves(StudioPanels::curve_box(w, h), c, bone, t.frame, curve_mode, &curve_memo, built)
                    perf_panel(c) if perf_overlay
                    StudioPanels::stack_panel(StudioPanels::sidebar_box(w, h), s, c, cursor, count)
                    StudioPanels::reset_menu_panel(StudioPanels::sidebar_box(w, h), s, reset_menu_open)
                    draw_issue_browser(w, h, issues_revision != built, false)
                    contact_valid: bool = StudioContactEditor::selection_valid(contact_selected_side, contact_selected_frame, c.frames)
                    contact_edit_index: i64 = StackState::edit_index_at(s, contact_selected_side, contact_selected_frame) if contact_valid else -1
                    mutable contact_edit_first: i64 = -1
                    mutable contact_edit_last: i64 = -1
                    if contact_edit_index >= 0:
                        selected_edit: StackState::FootEdit = s.edits[contact_edit_index]
                        contact_edit_first <- selected_edit.first
                        contact_edit_last <- selected_edit.last
                    contact_reset_available: bool = contact_edit_index >= 0
                    contact_merge_available: bool = StackState::can_merge_edit_at(s, contact_selected_side, contact_selected_frame)
                    contact_split_available: bool = StackState::can_split_edit_at(s, contact_selected_side, contact_selected_frame)
                    StudioPanels::contact_editor_panel(StudioPanels::timeline_box(w, h),
                        contact_selected_side, contact_selected_frame, c.frames,
                        contact_reset_available, contact_edit_first, contact_edit_last,
                        contact_merge_available, contact_split_available,
                        contact_draft_target, contact_draft_value())
                    StudioPanels::foot_marks(StudioPanels::timeline_box(w, h), c, hover_row)
                    StudioPanels::contact_selection_marker(StudioPanels::timeline_box(w, h),
                        contact_selected_side, contact_selected_frame, c.frames)
                    StudioRetime::overlay(StudioPanels::timeline_box(w, h), c, &s, &selection, t.frame)
                    StudioRetime::controls(StudioPanels::curve_box(w, h), RetimeState::ready(&selection) or band_focus >= 0, retime_speed, typing, typed_view())
                    StudioPanels::cleanup_readout(StudioPanels::sidebar_box(w, h), c, readout_value(shown_slide, c.slide_after), readout_value(shown_sink, c.sink_after), readout_value(shown_hand_slide, c.hand_slide_after), s.blend)
                else:
                    draw_issue_browser(w, h, issues_revision != built,
                        not load_failed)
                    UiCore::request_frame_after(0.016) if readout_progress() < StudioFoot::FULL
                    drawn_frame <- t.frame
            screen: i64 = StudioChrome::chrome_screen(clip != null, load_failed)
            if screen != StudioChrome::SCREEN_EDIT:
                StudioPanels::guide(w, h, screen)
            StudioPanels::file_menu_panel(StudioPanels::sidebar_box(w, h),
                file_menu_open and not storage_screen_open, clip != null,
                file_menu_focus, file_menu_hover)
            StudioPanels::storage_panel(w, h, storage_screen_open,
                storage_visible_entries, storage_visible_statuses, storage_visible_reasons,
                storage_selected, storage_focus, storage_message,
                storage_protected_records, storage_unverified_records,
                storage_restore_available(), storage_restore_review,
                storage_present_bytes, storage_trash_bytes, storage_scan_seconds)
            StudioPanels::status_bar(StudioPanels::status_box(w, h), frame_now(), frames(), rate(), s.selected if StackState::valid(s, s.selected) else -1, gain_slide, gain_spikes, is_dirty, message(s))
            StudioPanels::tooltip(hover_button)
            StudioPanels::help_sheet(w, h) if help_open
            StudioPanels::replacement_prompt_panel(w, h, replacement_prompt_open, replacement_focus, replacement_save_failed, replacement_is_close, replacement_is_termination)
            StudioPanels::legacy_session_prompt_panel(w, h, legacy_prompt_open, legacy_prompt_focus)
            if export_review_open and clip is c:
                StudioPanels::export_review_panel(w, h, true, export_review_path, anim_name, c, s,
                    current_export_warnings(), export_review_acknowledged, export_review_focus,
                    export_review_warning_selected)
            if export_warning_detail_open and clip is c:
                StudioPanels::export_warning_detail_panel(w, h, true, c,
                    current_export_warning_kind(export_warning_detail_index),
                    export_warning_detail_index, current_export_warnings(),
                    export_warning_detail_focus)
            if export_path_inspector_open:
                StudioPanels::export_path_inspector_panel(w, h, true, export_review_path,
                    export_path_inspector_page, export_path_inspector_focus)
            if export_result_open:
                StudioPanels::export_result_panel(w, h, true, export_result_path, export_result_focus, export_report_saved)
            if storage_screen_open:
                publish_storage_accessibility(w, h)
            elif screen == StudioChrome::SCREEN_EDIT and not help_open and not replacement_prompt_open and not legacy_prompt_open:
                if timeline is current_timeline:
                    publish_accessibility(w, h, s, current_timeline)
            elif screen != StudioChrome::SCREEN_EDIT and not help_open and not replacement_prompt_open and not legacy_prompt_open:
                publish_file_accessibility(w, h, true)
            scale: f32 = UiAppKitCanvas::backing_scale()
            sync_view(0, scale)
            sync_view(1, scale)
            sync_view(2, scale)
            draw_us <- ((UiAppKitCanvas::monotonic_time() - draw_start) * 1000000.0).i64()

        # Status message, with the live value of a running drag or the
        # parameter just nudged, in its unit.
        def message(s: StackState::Stack&) -> sview:
            if gizmo_drag != null and readout_angle >= 0:
                StudioText::begin()
                StudioText::put("rotate ")
                StudioText::put_i(readout_angle / 10)
                StudioText::put(".")
                StudioText::put_i(readout_angle % 10)
                StudioText::put("°   move ")
                StudioText::put_i(readout_mm)
                StudioText::put(" mm   (Esc cancels)")
                return StudioText::view()
            if nudged_row == -2:
                StudioText::begin()
                StudioText::put("blend ")
                StudioPanels::frames_put(s.blend)
                return StudioText::view()
            if nudged_row >= 0 and StackState::valid(s, nudged_row):
                op: Ops::Operation = s.ops[nudged_row]
                StudioText::begin()
                StudioText::put(StackState::kind_label(op.kind))
                StudioText::put(": ")
                StudioPanels::param_put(op)
                return StudioText::view()
            if status_file is file:
                StudioText::begin()
                StudioText::put(status)
                StudioText::put(" ")
                StudioPanels::file_name_put(file)
                return StudioText::view()
            return status

        def init_accessibility_toolbar() -> void:
            UiFlat::reset()
            transparent: UiCore::Color = UiCore::Color{r: 0, g: 0, b: 0, a: 0}
            for action in 0..<StudioPanels::BUTTONS:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0,
                    transparent, transparent, transparent)
                return if widget == UiFlat::NONE or widget != action.usize()
                accessibility_toolbar_widgets[action.usize()] <- widget
            accessibility_toolbar_ready <- true
            accessibility_file_trigger_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable file_widgets_ready: bool = accessibility_file_trigger_widget != UiFlat::NONE
            for row in 0..<StudioFilePolicy::ROWS |row, file_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_file_menu_widgets[row.usize()] <- widget
                file_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_file_ready <- file_widgets_ready
            mutable storage_widgets_ready: bool = true
            for action in 0..<StudioPanels::STORAGE_ACTION_COUNT |action, storage_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_storage_action_widgets[action.usize()] <- widget
                storage_widgets_ready <- false if widget == UiFlat::NONE
            for row in 0..<StudioStorageAccessibilityPolicy::ROW_COUNT |row, storage_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_storage_row_widgets[row.usize()] <- widget
                accessibility_storage_row_indices[row.usize()] <- -1
                storage_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_storage_ready <- storage_widgets_ready
            accessibility_review_ack_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_destination_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_cancel_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_export_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable warning_widgets_ready: bool = true
            for index in 0..<StudioExportReview::MAX_WARNINGS |index, warning_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_review_warning_widgets[index.usize()] <- widget
                warning_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_review_ready <- accessibility_review_ack_widget != UiFlat::NONE and accessibility_review_destination_widget != UiFlat::NONE and accessibility_review_cancel_widget != UiFlat::NONE and accessibility_review_export_widget != UiFlat::NONE and warning_widgets_ready
            accessibility_warning_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_ready <- accessibility_warning_previous_widget != UiFlat::NONE and accessibility_warning_next_widget != UiFlat::NONE and accessibility_warning_done_widget != UiFlat::NONE
            accessibility_path_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_ready <- accessibility_path_previous_widget != UiFlat::NONE and accessibility_path_next_widget != UiFlat::NONE and accessibility_path_done_widget != UiFlat::NONE
            accessibility_result_open_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_folder_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_ready <- accessibility_result_open_widget != UiFlat::NONE and accessibility_result_folder_widget != UiFlat::NONE and accessibility_result_done_widget != UiFlat::NONE
            accessibility_contact_plant_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_lift_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_reset_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_delete_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_merge_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_split_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_ready <- accessibility_contact_plant_widget != UiFlat::NONE and accessibility_contact_lift_widget != UiFlat::NONE and accessibility_contact_reset_widget != UiFlat::NONE and accessibility_contact_delete_widget != UiFlat::NONE and accessibility_contact_merge_widget != UiFlat::NONE and accessibility_contact_split_widget != UiFlat::NONE
            accessibility_reset_trigger_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_contacts_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_corrections_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_source_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_reset_ready <- accessibility_reset_trigger_widget != UiFlat::NONE and accessibility_reset_contacts_widget != UiFlat::NONE and accessibility_reset_corrections_widget != UiFlat::NONE and accessibility_reset_source_widget != UiFlat::NONE
            accessibility_stack_duplicate_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_stack_ready <- accessibility_stack_duplicate_widget != UiFlat::NONE
            accessibility_issue_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_worst_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable issue_widgets_ready: bool = accessibility_issue_previous_widget != UiFlat::NONE and accessibility_issue_next_widget != UiFlat::NONE and accessibility_issue_worst_widget != UiFlat::NONE
            mutable issue_filter_widgets_ready: bool = true
            for index in 0..<4 |index, issue_filter_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_issue_filter_widgets[index.usize()] <- widget
                issue_filter_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_issue_filter_reset_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_intent_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_issue_filter_ready <- issue_filter_widgets_ready and accessibility_issue_filter_reset_widget != UiFlat::NONE and accessibility_issue_intent_widget != UiFlat::NONE
            for index in 0..<StudioPanels::ISSUE_FILTERED_ROWS |index, issue_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_issue_row_widgets[index.usize()] <- widget
                issue_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_issue_ready <- issue_widgets_ready

        def toolbar_accessibility_role(action: i64) -> UiCore::AccessibilityRole:
            return UiCore::AccessibilityRole.CheckBox if action == StudioPanels::A_LOOP or action == StudioPanels::A_TRAILS or action == StudioPanels::A_CONTACTS or action == StudioPanels::A_HEAT or action == StudioPanels::A_ONION or action == StudioPanels::A_GHOST or action == StudioPanels::A_XRAY or action == StudioPanels::A_MESH or action == StudioPanels::A_BALANCE
            UiCore::AccessibilityRole.Button

        def toolbar_accessibility_enabled(action: i64, can_undo: bool, can_redo: bool) -> bool:
            return can_undo if action == StudioPanels::A_UNDO
            return can_redo if action == StudioPanels::A_REDO
            true

        def toolbar_accessibility_value(action: i64, t: TimelineState::State&) -> sview:
            return TimelineState::speed_label(t.divisor) if action == StudioPanels::A_SPEED
            return "Playing" if t.playing and action == StudioPanels::A_PLAY
            return "Paused" if action == StudioPanels::A_PLAY
            ""

        def toolbar_accessibility_selected(action: i64, flags: i64, t: TimelineState::State&) -> bool:
            return StudioPanels::lit(action, flags, t) if toolbar_accessibility_role(action) == UiCore::AccessibilityRole.CheckBox
            false

        def toolbar_accessibility_action(widget: usize, event: i32) -> void:
            if event == UiConst::WidgetEvent.Click.i32() and accessibility_file_ready:
                if widget == accessibility_file_trigger_widget:
                    file_menu_open <- not file_menu_open
                    file_menu_focus <- 0 if file_menu_open
                    file_menu_hover <- -1
                    touch()
                    return
                if file_menu_open:
                    for row in 0..<StudioFilePolicy::ROWS |row, widget|:
                        if widget == accessibility_file_menu_widgets[row.usize()]:
                            activate_file_menu(row)
                            return
            if event == UiConst::WidgetEvent.Click.i32() and storage_screen_open and accessibility_storage_ready:
                for slot in 0..<StudioStorageAccessibilityPolicy::ROW_COUNT |slot, widget, storage_selected, storage_focus|:
                    if widget == accessibility_storage_row_widgets[slot.usize()] and accessibility_storage_row_indices[slot.usize()] >= 0:
                        storage_selected <- accessibility_storage_row_indices[slot.usize()]
                        storage_restore_review <- false
                        storage_focus <- -1
                        touch()
                        return
                for action in 0..<StudioPanels::STORAGE_ACTION_COUNT |action, widget, storage_focus|:
                    if widget == accessibility_storage_action_widgets[action.usize()]:
                        storage_focus <- action
                        storage_action(action)
                        return
            if accessibility_stack_ready and event == UiConst::WidgetEvent.Click.i32() and widget == accessibility_stack_duplicate_widget:
                reset_menu_open <- false
                duplicate_selected()
                return
            if accessibility_reset_ready and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_reset_trigger_widget:
                    reset_menu_open <- not reset_menu_open
                    touch()
                    return
                if reset_menu_open:
                    reset_menu_open <- false
                    if widget == accessibility_reset_contacts_widget:
                        reset_cleanup(StudioResetScope::CLEAR_CONTACTS)
                    elif widget == accessibility_reset_corrections_widget:
                        reset_cleanup(StudioResetScope::CLEAR_CORRECTIONS)
                    elif widget == accessibility_reset_source_widget:
                        reset_cleanup(StudioResetScope::RESTORE_SOURCE)
                    else:
                        touch()
                    return
            if accessibility_issue_ready and event == UiConst::WidgetEvent.Click.i32():
                if accessibility_issue_filter_ready:
                    for field in 0..<4 |field, widget|:
                        if widget == accessibility_issue_filter_widgets[field.usize()]:
                            cycle_issue_filter(field)
                            return
                    if widget == accessibility_issue_filter_reset_widget:
                        reset_issue_filters()
                        return
                    elif widget == accessibility_issue_intent_widget:
                        toggle_issue_intent()
                        return
                if widget == accessibility_issue_previous_widget:
                    issue_navigation(StudioPanels::ISSUE_PREVIOUS)
                    return
                elif widget == accessibility_issue_next_widget:
                    issue_navigation(StudioPanels::ISSUE_NEXT)
                    return
                elif widget == accessibility_issue_worst_widget:
                    issue_navigation(StudioPanels::ISSUE_WORST)
                    return
                for index in 0..<StudioPanels::ISSUE_FILTERED_ROWS |index, widget|:
                    if widget == accessibility_issue_row_widgets[index.usize()] and StudioPanels::issue_row_route_enabled(index, StudioPanels::ISSUE_FILTERED_ROWS, issues_revision == built):
                        navigate_issue(visible_issue_first() + index)
                        return
            if accessibility_contact_ready and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_contact_plant_widget:
                    contact_apply(StudioContactEditor::PLANT)
                    return
                elif widget == accessibility_contact_lift_widget:
                    contact_apply(StudioContactEditor::LIFT)
                    return
                elif widget == accessibility_contact_reset_widget:
                    contact_apply(StudioContactEditor::RESET)
                    return
                elif widget == accessibility_contact_delete_widget:
                    contact_apply(StudioContactEditor::DELETE)
                    return
                elif widget == accessibility_contact_merge_widget:
                    contact_apply(StudioContactEditor::MERGE)
                    return
                elif widget == accessibility_contact_split_widget:
                    contact_apply(StudioContactEditor::SPLIT)
                    return
            if accessibility_warning_ready and export_warning_detail_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_warning_previous_widget:
                    activate_export_warning_detail(StudioExportPathReview::PREVIOUS)
                    return
                elif widget == accessibility_warning_next_widget:
                    activate_export_warning_detail(StudioExportPathReview::NEXT)
                    return
                elif widget == accessibility_warning_done_widget:
                    activate_export_warning_detail(StudioExportPathReview::DONE)
                    return
            if accessibility_path_ready and export_path_inspector_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_path_previous_widget:
                    activate_export_path_inspector(StudioExportPathReview::PREVIOUS)
                    return
                elif widget == accessibility_path_next_widget:
                    activate_export_path_inspector(StudioExportPathReview::NEXT)
                    return
                elif widget == accessibility_path_done_widget:
                    activate_export_path_inspector(StudioExportPathReview::DONE)
                    return
            if accessibility_result_ready and export_result_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_result_open_widget:
                    activate_export_result(StudioExportResult::OPEN)
                    return
                elif widget == accessibility_result_folder_widget:
                    activate_export_result(StudioExportResult::SHOW_IN_FOLDER)
                    return
                elif widget == accessibility_result_done_widget:
                    activate_export_result(StudioExportResult::DONE)
                    return
            if accessibility_review_ready and export_review_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_review_ack_widget:
                    activate_export_review(StudioExportReview::ACKNOWLEDGE)
                    return
                elif widget == accessibility_review_destination_widget:
                    activate_export_review(StudioExportReview::DESTINATION)
                    return
                elif widget == accessibility_review_cancel_widget:
                    activate_export_review(StudioExportReview::CANCEL)
                    return
                elif widget == accessibility_review_export_widget:
                    activate_export_review(StudioExportReview::EXPORT)
                    return
                for index in 0..<current_export_warnings() |index, widget|:
                    if widget == accessibility_review_warning_widgets[index.usize()]:
                        open_export_warning_detail(index)
                        return
            return if not accessibility_toolbar_ready or event != UiConst::WidgetEvent.Click.i32()
            action: i64 = StudioAccessibility::toolbar_action_for_widget(widget)
            toolbar_action(action) if action >= 0

        # Publish stable region landmarks and actionable toolbar controls.
        def accessibility_node(role: UiCore::AccessibilityRole, label: sview, help_text: sview, b: StudioPanels::Box, id: usize, parent_id: usize, first_child_id: usize, next_sibling_id: usize, action: usize, enabled: bool, selected: bool, text_value: sview) -> void:
            selected_warning_node: bool = export_review_open and current_export_warnings() > 0 and id == StudioAccessibility::export_review_warning_id(export_review_warning_selected)
            detail_control_focused: bool = (id == StudioAccessibility::WARNING_DETAIL_PREVIOUS and export_warning_detail_focus == StudioExportPathReview::PREVIOUS) or (id == StudioAccessibility::WARNING_DETAIL_NEXT and export_warning_detail_focus == StudioExportPathReview::NEXT) or (id == StudioAccessibility::WARNING_DETAIL_DONE and export_warning_detail_focus == StudioExportPathReview::DONE)
            file_menu_focused: bool = file_menu_open and file_menu_focus >= 0 and file_menu_focus < StudioFilePolicy::ROWS and id == StudioStorageAccessibilityPolicy::file_command_id(file_menu_focus.usize())
            storage_action_focused: bool = storage_screen_open and storage_focus >= 0 and storage_focus < StudioPanels::STORAGE_ACTION_COUNT and id == StudioStorageAccessibilityPolicy::REFRESH + storage_focus.usize()
            mutable storage_row_focused: bool = false
            if storage_screen_open and storage_focus < 0:
                for row in 0..<StudioStorageAccessibilityPolicy::ROW_COUNT |row, id, storage_selected, storage_row_focused|:
                    storage_row_focused <- true if id == StudioStorageAccessibilityPolicy::row_id(row.usize()) and accessibility_storage_row_indices[row.usize()] == storage_selected
            focused: bool = file_menu_focused or storage_action_focused or storage_row_focused or (export_review_open and ((id == StudioAccessibility::REVIEW_ACKNOWLEDGEMENT and export_review_focus == StudioExportReview::ACKNOWLEDGE) or (id == StudioAccessibility::REVIEW_DESTINATION and export_review_focus == StudioExportReview::DESTINATION) or (id == StudioAccessibility::REVIEW_CANCEL and export_review_focus == StudioExportReview::CANCEL) or (id == StudioAccessibility::REVIEW_EXPORT and export_review_focus == StudioExportReview::EXPORT) or (selected_warning_node and export_review_focus == StudioExportReview::INSPECT_WARNINGS))) or (export_warning_detail_open and detail_control_focused) or (export_path_inspector_open and ((id == StudioAccessibility::PATH_PREVIOUS and export_path_inspector_focus == StudioExportPathReview::PREVIOUS) or (id == StudioAccessibility::PATH_NEXT and export_path_inspector_focus == StudioExportPathReview::NEXT) or (id == StudioAccessibility::PATH_DONE and export_path_inspector_focus == StudioExportPathReview::DONE))) or (export_result_open and ((id == StudioAccessibility::RESULT_OPEN and export_result_focus == StudioExportResult::OPEN) or (id == StudioAccessibility::RESULT_SHOW_IN_FOLDER and export_result_focus == StudioExportResult::SHOW_IN_FOLDER) or (id == StudioAccessibility::RESULT_DONE and export_result_focus == StudioExportResult::DONE)))
            UiCore::accessibility_with_metadata(role, label, help_text,
                UiCore::Rect(b.x, b.y, b.w, b.h), id, action,
                enabled, focused, selected, 0.0,
                text_value, "", revision.usize(), 0, 0, parent_id,
                first_child_id, next_sibling_id, 0.0, 1.0, false)

        def publish_file_accessibility(w: f32, h: f32, standalone: bool) -> void:
            return if not accessibility_file_ready
            none: usize = StudioAccessibility::NO_NODE
            sidebar: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
            if standalone:
                accessibility_node(UiCore::AccessibilityRole.Group,
                    "Mocap Studio workspace",
                    "File commands are available before a take is loaded.",
                    StudioPanels::box(0.0, 0.0, w, h), StudioAccessibility::WORKSPACE,
                    none, StudioStorageAccessibilityPolicy::FILE_TRIGGER, none,
                    none, true, false, "")
            UiFlat::set_enabled(accessibility_file_trigger_widget, true)
            accessibility_node(UiCore::AccessibilityRole.Button,
                StudioStorageAccessibilityCopy::file_trigger_name(),
                "Open the File menu. Storage & Recovery is available without a loaded take.",
                StudioPanels::file_button_box(sidebar),
                StudioStorageAccessibilityPolicy::FILE_TRIGGER,
                StudioAccessibility::WORKSPACE,
                StudioStorageAccessibilityPolicy::file_first_child(StudioStorageAccessibilityPolicy::FILE_TRIGGER) if file_menu_open else none,
                none, accessibility_file_trigger_widget, true, file_menu_open,
                "Open" if not file_menu_open else "Close")
            if file_menu_open:
                accessibility_node(UiCore::AccessibilityRole.List,
                    StudioStorageAccessibilityCopy::file_menu_name(),
                    "Seven File commands. Commands that require a take are disabled until one is loaded.",
                    StudioPanels::file_popup_box(sidebar),
                    StudioStorageAccessibilityPolicy::FILE_MENU,
                    StudioStorageAccessibilityPolicy::FILE_TRIGGER,
                    StudioStorageAccessibilityPolicy::file_first_child(StudioStorageAccessibilityPolicy::FILE_MENU),
                    none, none, true, false, "")
                for row in 0..<StudioFilePolicy::ROWS |row, w, h|:
                    id: usize = StudioStorageAccessibilityPolicy::file_command_id(row.usize())
                    widget: usize = accessibility_file_menu_widgets[row.usize()]
                    enabled: bool = StudioStorageAccessibilityPolicy::file_command_enabled(id, clip != null)
                    UiFlat::set_enabled(widget, enabled)
                    accessibility_node(UiCore::AccessibilityRole.Button,
                        StudioStorageAccessibilityCopy::file_command_name(row),
                        StudioStorageAccessibilityCopy::file_command_help(row, clip != null),
                        StudioPanels::file_menu_row_box(sidebar, row), id,
                        StudioStorageAccessibilityPolicy::FILE_MENU, none,
                        StudioStorageAccessibilityPolicy::file_next_sibling(id),
                        widget, enabled, row == file_menu_focus,
                        StudioPanels::file_menu_shortcut(row))

        def publish_storage_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_storage_ready
            none: usize = StudioAccessibility::NO_NODE
            dialog: StudioPanels::Box = StudioPanels::storage_dialog_box(w, h)
            count: i64 = storage_visible_entries.count.i64()
            visible_count: i64 = StudioPanels::storage_visible_count(w, h, count, storage_selected)
            first: i64 = StudioPanels::storage_first_visible(w, h, count, storage_selected)
            UiFlat::set_enabled(accessibility_storage_action_widgets[StudioPanels::STORAGE_REFRESH.usize()], true)
            UiFlat::set_enabled(accessibility_storage_action_widgets[StudioPanels::STORAGE_DONE.usize()], true)
            UiFlat::set_enabled(accessibility_storage_action_widgets[StudioPanels::STORAGE_RESTORE.usize()], storage_restore_available())
            accessibility_node(UiCore::AccessibilityRole.Dialog,
                StudioStorageAccessibilityCopy::dialog_name(storage_restore_review),
                StudioStorageAccessibilityCopy::dialog_help(storage_restore_review),
                dialog, StudioStorageAccessibilityPolicy::DIALOG, none,
                StudioStorageAccessibilityPolicy::first_child(StudioStorageAccessibilityPolicy::DIALOG, visible_count),
                none, none, true, false, "")
            mutable total_value: sview = "No registered items"
            if count > 0:
                total_value <- StudioText::pair("Visible records: ", visible_count, " of ", count)
            list_box: StudioPanels::Box = StudioPanels::box(dialog.x + 22.0, dialog.y + 178.0,
                dialog.w - 44.0, dialog.h - 300.0)
            accessibility_node(UiCore::AccessibilityRole.List,
                "Studio-managed inventory",
                "Select a file by name. Each row also reports its file kind, verification status, and protection reason.",
                list_box, StudioStorageAccessibilityPolicy::INVENTORY,
                StudioStorageAccessibilityPolicy::DIALOG,
                StudioStorageAccessibilityPolicy::first_child(StudioStorageAccessibilityPolicy::INVENTORY, visible_count),
                StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::INVENTORY, visible_count),
                none, true, false, total_value)
            mutable entries: darray[StudioStorageManifest::Entry] = storage_visible_entries
            mutable statuses: darray[i64] = storage_visible_statuses
            reasons: darray[i64] = storage_visible_reasons
            for slot in 0..<StudioStorageAccessibilityPolicy::ROW_COUNT |visible_count, first, entries, statuses, reasons, storage_selected, w, h|:
                accessibility_storage_row_indices[slot.usize()] <- -1
                if slot < visible_count:
                    index: i64 = first + slot
                    entry: StudioStorageManifest::Entry = entries[index]
                    status: i64 = statuses[index] if index < statuses.count.i64() else StudioPanels::STORAGE_STATUS_UNVERIFIED
                    copy: StudioStorageAccessibilityCopy::RowCopy = StudioStorageAccessibilityCopy::row_copy(entry.kind, status, index == storage_selected)
                    StudioText::begin()
                    StudioText::put(copy.kind)
                    StudioText::put(". ")
                    StudioText::put(copy.status)
                    StudioText::put(". ")
                    StudioText::put(copy.selection)
                    StudioText::put(". ")
                    StudioText::put(copy.help)
                    StudioText::put(". Size: ")
                    StudioText::put_i(entry.size_bytes)
                    StudioText::put(" bytes. ")
                    if status == StudioPanels::STORAGE_STATUS_PRESENT:
                        StudioText::put(StudioPanels::storage_protection_label(reasons[index] if index < reasons.count.i64() else StudioStorageCleanupPolicy::PROTECT_IDENTITY_UNVERIFIED))
                    id: usize = StudioStorageAccessibilityPolicy::row_id(slot.usize())
                    widget: usize = accessibility_storage_row_widgets[slot.usize()]
                    accessibility_storage_row_indices[slot.usize()] <- index
                    UiFlat::set_enabled(widget, true)
                    accessibility_node(UiCore::AccessibilityRole.RadioButton,
                        StudioPanels::storage_entry_name(entries, index), StudioText::view(),
                        StudioPanels::storage_row_box(w, h, slot), id,
                        StudioStorageAccessibilityPolicy::INVENTORY, none,
                        StudioStorageAccessibilityPolicy::next_sibling(id, visible_count),
                        widget, true, index == storage_selected, copy.selection)
            hidden_value: sview = StudioText::pair("Unverified: ", storage_unverified_records, " · hidden/protected: ", storage_protected_records)
            accessibility_node(UiCore::AccessibilityRole.Label,
                "Protected records",
                StudioStorageAccessibilityCopy::protected_summary(storage_unverified_records, storage_protected_records),
                StudioPanels::box(dialog.x + 24.0, dialog.y + 72.0, dialog.w - 48.0, 22.0),
                StudioStorageAccessibilityPolicy::PROTECTED,
                StudioStorageAccessibilityPolicy::DIALOG, none,
                StudioStorageAccessibilityPolicy::next_sibling(StudioStorageAccessibilityPolicy::PROTECTED, visible_count),
                none, true, false, hidden_value)
            mutable restore_ready: bool = storage_restore_available()
            for action in 0..<StudioPanels::STORAGE_ACTION_COUNT |w, h, storage_restore_review, restore_ready|:
                id: usize = StudioStorageAccessibilityPolicy::REFRESH + action.usize()
                widget: usize = accessibility_storage_action_widgets[action.usize()]
                enabled: bool = StudioStorageAccessibilityPolicy::action_enabled(action, restore_ready)
                UiFlat::set_enabled(widget, enabled)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    StudioStorageAccessibilityCopy::action_name(action, storage_restore_review),
                    StudioStorageAccessibilityCopy::action_help(action, restore_ready, storage_restore_review),
                    StudioPanels::storage_button_box(w, h, action), id,
                    StudioStorageAccessibilityPolicy::DIALOG, none,
                    StudioStorageAccessibilityPolicy::next_sibling(id, visible_count),
                    widget, enabled, false, "")
            mutable message_role: UiCore::AccessibilityRole = UiCore::AccessibilityRole.Status
            message_role <- UiCore::AccessibilityRole.Alert if StudioStorageAccessibilityPolicy::result_is_alert(storage_message)
            accessibility_node(message_role,
                "Storage result",
                "The latest Storage & Recovery result.",
                StudioPanels::box(dialog.x + 24.0, dialog.y + dialog.h - 90.0, dialog.w - 48.0, 24.0),
                StudioStorageAccessibilityPolicy::ANNOUNCEMENT,
                StudioStorageAccessibilityPolicy::DIALOG, none, none,
                none, true, false,
                StudioStorageAccessibilityCopy::result_announcement(storage_message))

        def publish_export_review_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_review_ready
            if clip is c:
                none: usize = StudioAccessibility::NO_NODE
                warnings: i64 = current_export_warnings()
                dialog: StudioPanels::Box = StudioPanels::export_review_dialog_box(w, h)
                accessibility_node(UiCore::AccessibilityRole.Dialog,
                    "Review cleaned export",
                    "Review the destination, retained animation details, cleanup steps, and quality notes before exporting.",
                    dialog, StudioAccessibility::EXPORT_REVIEW, none,
                    StudioAccessibility::export_review_first_child(warnings), none,
                    none, true, false, "")
                if warnings > 0:
                    mutable acknowledgement: sview = "Not acknowledged"
                    acknowledgement <- "Acknowledged" if export_review_acknowledged
                    accessibility_node(UiCore::AccessibilityRole.CheckBox,
                        "I reviewed the quality notes",
                        "Required before exporting while quality warnings are present.",
                        StudioPanels::export_review_ack_box(w, h),
                        StudioAccessibility::REVIEW_ACKNOWLEDGEMENT,
                        StudioAccessibility::EXPORT_REVIEW,
                        none, StudioAccessibility::export_review_next_sibling(
                            StudioAccessibility::REVIEW_ACKNOWLEDGEMENT, warnings),
                        accessibility_review_ack_widget, true,
                        export_review_acknowledged, acknowledgement)
                for index in 0..<warnings |index, w, h, warnings|:
                    kind: i64 = current_export_warning_kind(index)
                    id: usize = StudioAccessibility::export_review_warning_id(index)
                    accessibility_node(UiCore::AccessibilityRole.Button,
                        StudioPanels::export_warning_detail_title(kind),
                        "Open the before/after metric and available frame evidence for this warning.",
                        StudioPanels::export_review_warning_box(w, h, index),
                        id, StudioAccessibility::EXPORT_REVIEW, none,
                        StudioAccessibility::export_review_next_sibling(id, warnings),
                        accessibility_review_warning_widgets[index.usize()], true,
                        false, StudioPanels::export_warning_detail_metric(c, kind))
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Inspect full destination path",
                    "Open a read-only view of the entire export destination.",
                    StudioPanels::export_review_destination_box(w, h),
                    StudioAccessibility::REVIEW_DESTINATION,
                    StudioAccessibility::EXPORT_REVIEW,
                    none, StudioAccessibility::export_review_next_sibling(
                        StudioAccessibility::REVIEW_DESTINATION, warnings),
                    accessibility_review_destination_widget, true, false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Cancel export review", "Close this review without writing a file.",
                    StudioPanels::export_review_button_box(w, h, StudioExportReview::CANCEL),
                    StudioAccessibility::REVIEW_CANCEL, StudioAccessibility::EXPORT_REVIEW,
                    none, StudioAccessibility::REVIEW_EXPORT,
                    accessibility_review_cancel_widget, true, false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Export GLB", "Write and validate the cleaned GLB at the displayed destination.",
                    StudioPanels::export_review_button_box(w, h, StudioExportReview::EXPORT),
                    StudioAccessibility::REVIEW_EXPORT, StudioAccessibility::EXPORT_REVIEW,
                    none, none, accessibility_review_export_widget,
                    StudioExportReview::export_enabled(warnings, export_review_acknowledged),
                    false, "")

        def publish_contact_editor_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_contact_ready
            if clip is c:
                valid: bool = StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames)
                UiFlat::set_enabled(accessibility_contact_plant_widget, valid)
                UiFlat::set_enabled(accessibility_contact_lift_widget, valid)
                mutable current: StackState::Stack = current_stack()
                reset_enabled: bool = valid and StackState::has_edit_at(current, contact_selected_side, contact_selected_frame)
                UiFlat::set_enabled(accessibility_contact_reset_widget, reset_enabled)
                UiFlat::set_enabled(accessibility_contact_delete_widget, reset_enabled)
                merge_enabled: bool = valid and StackState::can_merge_edit_at(current, contact_selected_side, contact_selected_frame)
                UiFlat::set_enabled(accessibility_contact_merge_widget, merge_enabled)
                split_enabled: bool = valid and StackState::can_split_edit_at(current, contact_selected_side, contact_selected_frame)
                UiFlat::set_enabled(accessibility_contact_split_widget, split_enabled)
                none: usize = StudioAccessibility::NO_NODE
                next: usize = StudioAccessibility::CONTACT_EDITOR_LIFT
                mutable value: sview = "Select a contact row and frame first"
                if valid:
                    StudioText::begin()
                    StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                    StudioText::put(" frame ")
                    StudioText::put_i(contact_selected_frame + 1)
                    selected_index: i64 = StackState::edit_index_at(current, contact_selected_side, contact_selected_frame)
                    if selected_index >= 0:
                        selected_edit: StackState::FootEdit = current.edits[selected_index]
                        StudioText::put(" · interval ")
                        StudioText::put_i(selected_edit.first + 1)
                        StudioText::put(" to ")
                        StudioText::put_i(selected_edit.last + 1)
                    value <- StudioText::view()
                tb: StudioPanels::Box = StudioPanels::timeline_box(w, h)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Plant selected contact frame",
                    "Override automatic contact detection as planted on the selected frame. This edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::PLANT),
                    StudioAccessibility::CONTACT_EDITOR_PLANT,
                    StudioAccessibility::TIMELINE, none, next,
                    accessibility_contact_plant_widget, valid, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Lift selected contact frame",
                    "Override automatic contact detection as lifted on the selected frame. This edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::LIFT),
                    StudioAccessibility::CONTACT_EDITOR_LIFT,
                    StudioAccessibility::TIMELINE, none, StudioAccessibility::CONTACT_EDITOR_RESET,
                    accessibility_contact_lift_widget, valid, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Reset selected contact frame to automatic detection",
                    "Remove authored contact overrides from only this output frame so the detector's result is used. The edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::RESET),
                    StudioAccessibility::CONTACT_EDITOR_RESET,
                    StudioAccessibility::TIMELINE, none, StudioAccessibility::CONTACT_EDITOR_DELETE,
                    accessibility_contact_reset_widget, reset_enabled, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Delete selected contact interval",
                    "Remove the newest authored contact interval covering the selected frame. Earlier overrides or automatic detection become visible again. The edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::DELETE),
                    StudioAccessibility::CONTACT_EDITOR_DELETE,
                    StudioAccessibility::TIMELINE, none, StudioAccessibility::CONTACT_EDITOR_MERGE,
                    accessibility_contact_delete_widget, reset_enabled, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Merge adjacent contact interval",
                    "Merge the selected interval with a directly adjacent interval only when both have the same side and planted or lifted state. The resulting contact track is unchanged. The edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::MERGE),
                    StudioAccessibility::CONTACT_EDITOR_MERGE,
                    StudioAccessibility::TIMELINE, none, StudioAccessibility::CONTACT_EDITOR_SPLIT,
                    accessibility_contact_merge_widget, merge_enabled, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Split selected contact interval before selected frame",
                    "Split the newest authored interval immediately before the selected frame. The selected frame begins the right interval; both intervals keep the same planted or lifted state. Contact output is unchanged. The edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::SPLIT),
                    StudioAccessibility::CONTACT_EDITOR_SPLIT,
                    StudioAccessibility::TIMELINE, none, none,
                    accessibility_contact_split_widget, split_enabled, false, value)

        def publish_reset_accessibility(w: f32, h: f32, s: StackState::Stack&) -> void:
            return if not accessibility_reset_ready
            none: usize = StudioAccessibility::NO_NODE
            sb: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
            contacts_enabled: bool = s.edit_count > 0
            corrections_enabled: bool = s.fix_count > 0
            source_enabled: bool = StackState::has_cleanup(s)
            UiFlat::set_enabled(accessibility_reset_trigger_widget, true)
            UiFlat::set_enabled(accessibility_reset_contacts_widget, contacts_enabled)
            UiFlat::set_enabled(accessibility_reset_corrections_widget, corrections_enabled)
            UiFlat::set_enabled(accessibility_reset_source_widget, source_enabled)
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Cleanup reset actions",
                "Clear cleanup by scope. Each action is one undoable change.",
                StudioPanels::reset_menu_button_box(sb), StudioAccessibility::RESET_GROUP,
                StudioAccessibility::SIDEBAR, StudioAccessibility::RESET_TRIGGER,
                none, none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Reset cleanup menu",
                "Open or close actions to clear contacts, clear local corrections, or restore the source result.",
                StudioPanels::reset_menu_button_box(sb), StudioAccessibility::RESET_TRIGGER,
                StudioAccessibility::RESET_GROUP,
                StudioAccessibility::reset_next_sibling(StudioAccessibility::RESET_TRIGGER, reset_menu_open),
                none, accessibility_reset_trigger_widget, true, reset_menu_open,
                "Open" if not reset_menu_open else "Close")
            if reset_menu_open:
                mutable contacts_value: sview = "No contact overrides to clear"
                if contacts_enabled:
                    StudioText::begin()
                    StudioText::put_i(s.edit_count)
                    StudioText::put(" authored contact overrides")
                    contacts_value <- StudioText::view()
                mutable corrections_value: sview = "No local corrections to clear"
                if corrections_enabled:
                    StudioText::begin()
                    StudioText::put_i(s.fix_count)
                    StudioText::put(" local corrections")
                    corrections_value <- StudioText::view()
                mutable source_value: sview = "No cleanup to remove"
                if source_enabled:
                    source_value <- "Removes all cleanup and retiming"
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Clear contacts",
                    "Remove authored contact overrides. Automatic contact detection becomes visible again. One undo step.",
                    StudioPanels::reset_menu_item_box(sb, 0), StudioAccessibility::RESET_CLEAR_CONTACTS,
                    StudioAccessibility::RESET_GROUP,
                    none, StudioAccessibility::RESET_CLEAR_CORRECTIONS,
                    accessibility_reset_contacts_widget, contacts_enabled, false, contacts_value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Clear local corrections",
                    "Remove local pose corrections while keeping cleanup operations and contact overrides. One undo step.",
                    StudioPanels::reset_menu_item_box(sb, 1), StudioAccessibility::RESET_CLEAR_CORRECTIONS,
                    StudioAccessibility::RESET_GROUP,
                    none, StudioAccessibility::RESET_SOURCE_RESULT,
                    accessibility_reset_corrections_widget, corrections_enabled, false, corrections_value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Restore source result",
                    "Remove cleanup operations, retiming, contact overrides, locks, blend settings, and local corrections. One undo step.",
                    StudioPanels::reset_menu_item_box(sb, 2), StudioAccessibility::RESET_SOURCE_RESULT,
                    StudioAccessibility::RESET_GROUP,
                    none, none, accessibility_reset_source_widget, source_enabled, false, source_value)

        def publish_stack_accessibility(w: f32, h: f32, s: StackState::Stack&) -> void:
            return if not accessibility_stack_ready
            sb: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
            none: usize = StudioAccessibility::NO_NODE
            duplicate_enabled: bool = StudioOperationDuplicatePolicy::available(s.count, s.selected)
            UiFlat::set_enabled(accessibility_stack_duplicate_widget, duplicate_enabled)
            mutable value: sview = "Select an operation before duplicating"
            value <- "Stack is full (16 of 16)" if s.count >= StudioOperationDuplicatePolicy::MAX_OPS
            value <- "Copy is inserted after the selected step" if duplicate_enabled
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Cleanup stack actions",
                "Actions for the selected cleanup operation.",
                StudioPanels::duplicate_button_box(sb), StudioAccessibility::STACK_GROUP,
                StudioAccessibility::SIDEBAR, StudioAccessibility::STACK_DUPLICATE,
                none, none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Duplicate selected operation",
                "Insert an exact copy after the selected operation and select the copy. Cmd-D. One undo step.",
                StudioPanels::duplicate_button_box(sb), StudioAccessibility::STACK_DUPLICATE,
                StudioAccessibility::STACK_GROUP, none, none,
                accessibility_stack_duplicate_widget, duplicate_enabled, false, value)

        def publish_export_warning_detail_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_warning_ready
            if clip is c:
                none: usize = StudioAccessibility::NO_NODE
                dialog: StudioPanels::Box = StudioPanels::export_warning_detail_dialog_box(w, h)
                kind: i64 = current_export_warning_kind(export_warning_detail_index)
                StudioText::begin()
                StudioText::put("Details for ")
                StudioText::put(StudioPanels::export_warning_detail_title(kind))
                accessibility_node(UiCore::AccessibilityRole.Dialog,
                    StudioText::view(),
                    "The export review stays open behind this read-only metric detail.",
                    dialog, StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_first_child(), none,
                    none, true, false, "")
                accessibility_node(UiCore::AccessibilityRole.Label,
                    "Before and after metric", "The warning's matching export metric.",
                    StudioPanels::box(dialog.x + 24.0, dialog.y + 56.0, dialog.w - 48.0, 28.0),
                    StudioAccessibility::WARNING_DETAIL_METRIC,
                    StudioAccessibility::WARNING_DETAIL,
                    none, StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_METRIC),
                    none, true, false, StudioPanels::export_warning_detail_metric(c, kind))
                accessibility_node(UiCore::AccessibilityRole.Label,
                    "Available frame evidence",
                    "Frame evidence is shown only when the retained data supports it.",
                    StudioPanels::box(dialog.x + 24.0, dialog.y + 96.0, dialog.w - 48.0, 42.0),
                    StudioAccessibility::WARNING_DETAIL_EVIDENCE,
                    StudioAccessibility::WARNING_DETAIL,
                    none, StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_EVIDENCE),
                    none, true, false, StudioPanels::export_warning_detail_evidence(c, kind))
                previous_enabled: bool = StudioExportPathReview::enabled(
                    StudioExportPathReview::PREVIOUS, export_warning_detail_index,
                    current_export_warnings())
                next_enabled: bool = StudioExportPathReview::enabled(
                    StudioExportPathReview::NEXT, export_warning_detail_index,
                    current_export_warnings())
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Previous warning", "Show the previous export warning.",
                    StudioPanels::export_warning_detail_button_box(w, h,
                        StudioExportPathReview::PREVIOUS),
                    StudioAccessibility::WARNING_DETAIL_PREVIOUS,
                    StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_PREVIOUS),
                    accessibility_warning_previous_widget, previous_enabled,
                    false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Next warning", "Show the next export warning.",
                    StudioPanels::export_warning_detail_button_box(w, h,
                        StudioExportPathReview::NEXT),
                    StudioAccessibility::WARNING_DETAIL_NEXT,
                    StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_NEXT),
                    accessibility_warning_next_widget, next_enabled,
                    false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Return to export review",
                    "Close warning details while preserving the destination and acknowledgement.",
                    StudioPanels::export_warning_detail_button_box(w, h,
                        StudioExportPathReview::DONE),
                    StudioAccessibility::WARNING_DETAIL_DONE,
                    StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_DONE),
                    accessibility_warning_done_widget, true, false, "")

        def publish_export_path_inspector_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_path_ready
            none: usize = StudioAccessibility::NO_NODE
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            visible_lines: i64 = StudioPanels::export_path_visible_lines(
                export_review_path, export_path_inspector_page)
            dialog: StudioPanels::Box = StudioPanels::export_path_inspector_dialog_box(w, h)
            accessibility_node(UiCore::AccessibilityRole.Dialog,
                "Full export destination",
                "Read the complete destination path across the displayed path lines. Previous and Next show the adjacent page.",
                dialog, StudioAccessibility::EXPORT_REVIEW, none,
                StudioAccessibility::export_path_inspector_first_child(), none,
                none, true, false, "")
            for row in 0..<visible_lines |row, w, h, dialog, export_path_inspector_page, export_review_path, visible_lines|:
                id: usize = StudioAccessibility::PATH_LINE_FIRST + row.usize()
                next: usize = StudioAccessibility::export_path_inspector_next_sibling(id, visible_lines)
                line_box: StudioPanels::Box = StudioPanels::box(dialog.x + 24.0,
                    dialog.y + 76.0 + row.f32() * 49.0, dialog.w - 48.0, 38.0)
                label: sview = StudioText::number("Path line ", row + 1)
                accessibility_node(UiCore::AccessibilityRole.Label, label,
                    "Read-only exact segment of the export destination.", line_box,
                    id, StudioAccessibility::EXPORT_REVIEW, none, next, none,
                    true, false, StudioPanels::export_path_line(export_review_path,
                        export_path_inspector_page, row))
            prev_enabled: bool = StudioExportPathReview::enabled(
                StudioExportPathReview::PREVIOUS, export_path_inspector_page, pages)
            next_enabled: bool = StudioExportPathReview::enabled(
                StudioExportPathReview::NEXT, export_path_inspector_page, pages)
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Previous path page", "Show the previous destination path page.",
                StudioPanels::export_path_inspector_button_box(w, h, StudioExportPathReview::PREVIOUS),
                StudioAccessibility::PATH_PREVIOUS, StudioAccessibility::EXPORT_REVIEW,
                none, StudioAccessibility::PATH_NEXT, accessibility_path_previous_widget,
                prev_enabled, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Next path page", "Show the next destination path page.",
                StudioPanels::export_path_inspector_button_box(w, h, StudioExportPathReview::NEXT),
                StudioAccessibility::PATH_NEXT, StudioAccessibility::EXPORT_REVIEW,
                none, StudioAccessibility::PATH_DONE, accessibility_path_next_widget,
                next_enabled, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Done", "Return to the export review without changing its destination or acknowledgement.",
                StudioPanels::export_path_inspector_button_box(w, h, StudioExportPathReview::DONE),
                StudioAccessibility::PATH_DONE, StudioAccessibility::EXPORT_REVIEW,
                none, none, accessibility_path_done_widget, true, false, "")

