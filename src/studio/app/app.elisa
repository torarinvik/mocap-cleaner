# The studio window: three hosted engine viewports (perspective, front,
# side), the curve view, the timeline and the operation stack, wired to the
# state modules. Every stack edit is recorded in history and rebuilds the
# cleaned clip (live preview through the same clean_animation the CLI
# exports with, posed with PoseOverride).
#
# State lives in optional module globals: stage1 declines struct and darray
# global initialisers. Heap data stored into a global survives only with the
# studio-globals stage1 (functions that store into globals allocate from a
# static region instead of a freed auto arena; see scripts/build_studio.sh).
# That region is never reclaimed, so each rebuild keeps its clip's memory.
include "../../../../elisa-ui/src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "../../../../elisa-engine-mocap/src/viewport/viewport.elisa"
include "../../../../elisa-engine-mocap/src/ui/file_panel.elisa"
include "scene.elisa"
include "panels.elisa"
include "retime_panel.elisa"
include "../shortcuts.elisa"
include "../focus.elisa"
include "../replacement.elisa"
include "../accessibility.elisa"
include "../export_policy.elisa"
include "../export_review.elisa"
include "../export_result.elisa"
include "export_publisher.elisa"
include "../state/session_state.elisa"
include "../state/readout.elisa"

extern puts(text: cstr) -> i64

module Studio:
    public:
        const EXPORT_PATH: cstr = "build/studio_export.glb"
        const SESSION_PATH: cstr = "build/studio_session.txt"
        const PATH_CAPACITY: usize = 4096

        global mutable path: cstr = "../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"
        # The native file-drop callback borrows its UTF-8 path only until it
        # returns. Two fixed buffers let us stage a new path and keep the
        # current take's path intact if loading the new take fails.
        global mutable path_bytes0: u8[4096] = zeroed
        global mutable path_bytes1: u8[4096] = zeroed
        # Replacement prompts outlive native chooser callbacks; session paths
        # need storage independent of both the take and pending file buffers.
        global mutable pending_path_bytes: u8[4096] = zeroed
        global mutable session_path_bytes: u8[4096] = zeroed
        global mutable path_slot: i64 = -1
        global mutable anim_name: cstr = "jab"
        global mutable clip: StudioModel::Clip? = null
        global mutable history: HistoryState::History = zeroed
        global mutable history_ready: bool = false
        global mutable timeline: TimelineState::State? = null
        global mutable flags: i64 = StudioScene::DEFAULT_FLAGS
        global mutable bone: i64 = 0
        global mutable last_time: f64 = 0.0
        global mutable drawn_frame: i64 = -1
        global mutable revision: i64 = 0
        global mutable status: sview = "ready"
        # Live drag readouts: gizmo angle (tenths of a degree) and offset
        # (mm), -1 when no gizmo drag is running; and the stack row whose
        # strength was just nudged, -1 for none.
        global mutable readout_angle: i64 = -1
        global mutable readout_mm: i64 = -1
        global mutable nudged_row: i64 = -1
        # File the status line names (appended after `status`), or null.
        global mutable status_file: cstr? = null
        # Where Cmd-S saves the session and E exports; Save As / Export As
        # (native panels) change them.
        global mutable session_path: cstr = "build/studio_session.txt"
        global mutable export_path: cstr = "build/studio_export.glb"
        const REPLACE_TAKE: i64 = 1
        const REPLACE_SESSION: i64 = 2
        const REPLACE_CLOSE: i64 = 3
        global mutable pending_replacement: i64 = 0
        global mutable pending_replacement_allows_legacy: bool = false
        global mutable pending_session_stack: StackState::Stack = zeroed
        global mutable pending_session_ready: bool = false
        # Chrome: the "?" sheet, whether the take failed to load, and the
        # toolbar button under the pointer (for its tooltip).
        global mutable help_open: bool = false
        global mutable load_failed: bool = false
        global mutable hover_button: i64 = -1
        # The sidebar File menu is keyboard navigable as well as clickable.
        global mutable file_menu_open: bool = false
        global mutable file_menu_focus: i64 = 0
        global mutable file_menu_hover: i64 = -1
        global mutable export_review_open: bool = false
        global mutable export_review_acknowledged: bool = false
        global mutable export_review_focus: i64 = StudioExportReview::EXPORT
        global mutable export_review_path: cstr = ""
        global mutable export_review_overwrite: bool = false
        global mutable export_review_warning_selected: i64 = 0
        global mutable export_warning_detail_open: bool = false
        global mutable export_warning_detail_index: i64 = 0
        global mutable export_warning_detail_focus: i64 = StudioExportPathReview::DONE
        global mutable export_path_inspector_open: bool = false
        global mutable export_path_inspector_page: i64 = 0
        global mutable export_path_inspector_focus: i64 = StudioExportPathReview::DONE
        global mutable export_result_open: bool = false
        global mutable export_result_path: cstr = ""
        global mutable export_result_focus: i64 = StudioExportResult::OPEN
        global mutable replacement_prompt_open: bool = false
        global mutable replacement_is_close: bool = false
        global mutable replacement_is_termination: bool = false
        global mutable replacement_focus: i64 = StudioReplacement::FOCUS_SAVE
        global mutable replacement_save_failed: bool = false
        global mutable legacy_prompt_open: bool = false
        global mutable legacy_prompt_focus: i64 = StudioLegacyPrompt::FOCUS_CANCEL
        # One-shot authorization consumed by the synchronous native close
        # callback after Save or Discard is chosen in the confirmation panel.
        global mutable close_authorized: bool = false
        global mutable termination_authorized: bool = false
        # Last one-click clean: permille of slide and spikes removed, or -1.
        global mutable gain_slide: i64 = -1
        global mutable gain_spikes: i64 = -1
        # Skinned mesh of the clip's character, loaded once, and its pose
        # cached per (frame, revision).
        global mutable mesh: GlbSkinMesh::Mesh? = null
        global mutable skinned: darray[Geometry::Vec3]? = null
        global mutable skinned_frame: i64 = -1
        global mutable skinned_revision: i64 = -1
        # Gizmo: GizmoPolicy mode, or -1 when hidden; the drag and its view.
        global mutable gizmo_mode: i64 = -1
        global mutable gizmo_drag: ViewportGizmo::Drag? = null
        global mutable gizmo_view: i64 = -1
        # Pose goal of the running gizmo drag, for the live preview.
        global mutable gizmo_goal: Geometry::Transform? = null
        # Curve view channel (StudioOverlay::ROTATION or POSITION).
        global mutable curve_mode: i64 = 0
        # Held modifiers (StudioShortcuts mask).
        global mutable modifiers: i64 = 0
        # Phase 6 caches: the loaded take and op caches, the stack the clip
        # was built from, a counter bumped per rebuild, the curve memo, the
        # drag preview's base pose (per frame and build), and the Shift-F
        # frame-time overlay with the last draw time.
        global mutable memo: StudioModel::Memo? = null
        global mutable built_stack: StackState::Stack? = null
        global mutable built: i64 = 0
        global mutable rig_source_revision: i64 = 0
        global mutable curve_memo: StudioPerf::Curves = zeroed
        global mutable base_models: darray[Geometry::Transform] = zeroed
        global mutable base_locals: darray[Geometry::Transform] = zeroed
        global mutable base_frame: i64 = -1
        global mutable base_built: i64 = -1
        global mutable perf_overlay: bool = false
        global mutable draw_us: i64 = 0
        global mutable preview_moved: i64 = 0

        global mutable view0: Viewport::Viewport? = null
        global mutable view1: Viewport::Viewport? = null
        global mutable view2: Viewport::Viewport? = null
        global mutable seen0: i64 = -1
        global mutable seen1: i64 = -1
        global mutable seen2: i64 = -1
        global mutable shown0: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable shown1: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable shown2: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable framed: bool = false
        global mutable accessibility_toolbar_widgets: usize[StudioPanels::BUTTONS.usize()] = zeroed
        global mutable accessibility_toolbar_ready: bool = false
        global mutable accessibility_review_ack_widget: usize = 0
        global mutable accessibility_review_destination_widget: usize = 0
        global mutable accessibility_review_cancel_widget: usize = 0
        global mutable accessibility_review_export_widget: usize = 0
        global mutable accessibility_review_warning_widgets: usize[StudioExportReview::MAX_WARNINGS.usize()] = zeroed
        global mutable accessibility_review_ready: bool = false
        global mutable accessibility_warning_previous_widget: usize = 0
        global mutable accessibility_warning_next_widget: usize = 0
        global mutable accessibility_warning_done_widget: usize = 0
        global mutable accessibility_warning_ready: bool = false
        global mutable accessibility_path_previous_widget: usize = 0
        global mutable accessibility_path_next_widget: usize = 0
        global mutable accessibility_path_done_widget: usize = 0
        global mutable accessibility_path_ready: bool = false
        global mutable accessibility_result_open_widget: usize = 0
        global mutable accessibility_result_folder_widget: usize = 0
        global mutable accessibility_result_done_widget: usize = 0
        global mutable accessibility_result_ready: bool = false
        global mutable accessibility_contact_plant_widget: usize = 0
        global mutable accessibility_contact_lift_widget: usize = 0
        global mutable accessibility_contact_reset_widget: usize = 0
        global mutable accessibility_contact_ready: bool = false

        global mutable drag_view: i64 = -1
        global mutable drag_button: i32 = -1
        global mutable scrubbing: bool = false
        global mutable last_x: f32 = 0.0
        global mutable last_y: f32 = 0.0
        global mutable down_x: f32 = 0.0
        global mutable down_y: f32 = 0.0
        # Foot cleanup: the contact-bar press in progress, the hovered
        # contact row (StackState::LEFT/RIGHT or -1), and the readout
        # transition (values shown before the last rebuild, and its start).
        global mutable foot_press: FootState::Press = FootState::Press{side: -1, part: 0, first: -1, last: -1, frame: -1}
        global mutable contact_selected_side: i64 = StudioContactEditor::NO_SIDE
        global mutable contact_selected_frame: i64 = -1
        global mutable hover_row: i64 = -1
        global mutable shown_slide: i64 = 0
        global mutable shown_sink: i64 = 0
        global mutable shown_hand_slide: i64 = 0
        global mutable readout_start: f64 = 0.0
        # Retiming: Shift-drag selection (output frames), band edge drag,
        # focused band (Delete removes it), slider and typed speed.
        global mutable selection: RetimeState::Selection = RetimeState::Selection{active: false, anchor: -1, head: -1}
        global mutable selecting: bool = false
        global mutable edge_drag: RetimeState::EdgeDrag = RetimeState::EdgeDrag{band: -1, last_edge: false}
        global mutable band_focus: i64 = -1
        global mutable slider_drag: bool = false
        global mutable retime_speed: i64 = 1000
        global mutable slider_start_speed: i64 = 1000
        global mutable typing: bool = false
        global mutable typed: u8[8] = zeroed
        global mutable typed_len: i64 = 0
        const READOUT_MS: i64 = 250

        def spare_path_slot() -> i64:
            return 0 if path_slot == 1
            1

        def copy_path(p: cstr, slot: i64) -> bool can Unsafe.PointerCast:
            return false if slot != 0 and slot != 1
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                if c == 0:
                    if slot == 0:
                        path_bytes0[i] <- 0
                    else:
                        path_bytes1[i] <- 0
                    return true
                return false if i == PATH_CAPACITY - 1
                if slot == 0:
                    path_bytes0[i] <- c
                else:
                    path_bytes1[i] <- c
                i <- i + 1
            false

        def stored_path(slot: i64) -> cstr can Unsafe.PointerCast:
            return (&path_bytes0[0]).cast[cstr] if slot == 0
            (&path_bytes1[0]).cast[cstr]

        def stage_pending_path(p: cstr) -> bool can Unsafe.PointerCast:
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                if c == 0:
                    pending_path_bytes[i] <- 0
                    return true
                return false if i == PATH_CAPACITY - 1
                pending_path_bytes[i] <- c
                i <- i + 1
            false

        def pending_path() -> cstr can Unsafe.PointerCast:
            (&pending_path_bytes[0]).cast[cstr]

        def set_session_path(p: cstr) -> bool can Unsafe.PointerCast:
            mutable i: usize = 0
            while i < PATH_CAPACITY and p[i] != 0:
                i <- i + 1
            return false if i == PATH_CAPACITY
            mutable copied: usize = 0
            while copied <= i:
                session_path_bytes[copied] <- p[copied]
                copied <- copied + 1
            session_path <- (&session_path_bytes[0]).cast[cstr]
            true

        def set_path(p: cstr) -> void can Unsafe.PointerCast:
            slot: i64 = spare_path_slot()
            if copy_path(p, slot):
                path_slot <- slot
                path <- stored_path(slot)
            else:
                status <- "take path exceeds 4095 bytes"
                status_file <- null

        def set_anim(a: cstr) -> void:
            anim_name <- a

        # ---- per-view globals ------------------------------------------
        def put_view(i: i64, vp: Viewport::Viewport) -> void:
            if i == 0:
                view0 <- vp
            elif i == 1:
                view1 <- vp
            else:
                view2 <- vp

        def view(i: i64) -> Viewport::Viewport?:
            return view0 if i == 0
            return view1 if i == 1
            view2

        def seen(i: i64) -> i64:
            return seen0 if i == 0
            return seen1 if i == 1
            seen2

        def put_seen(i: i64, r: i64) -> void:
            if i == 0:
                seen0 <- r
            elif i == 1:
                seen1 <- r
            else:
                seen2 <- r

        def open_view(i: i64) -> Viewport::Viewport?:
            mutable vp: Viewport::Viewport = catch Viewport::create(320, 240):
                value: value
                error failure: return null
            if i == 1:
                vp.camera <- ViewportCamera::create_ortho(320, 240, ViewportCamera::FRONT)
            if i == 2:
                vp.camera <- ViewportCamera::create_ortho(320, 240, ViewportCamera::SIDE)
            return move vp

        def rect_of(b: StudioPanels::Box) -> UiHostedSurface::Rect:
            UiHostedSurface::Rect{x: b.x, y: b.y, width: b.w, height: b.h}

        def view_box(i: i64) -> StudioPanels::Box:
            StudioPanels::view_box(i.usize(), UiCore::viewport_width(), UiCore::viewport_height())

        # ---- state helpers -----------------------------------------------
        def frame_now() -> i64:
            if timeline is t:
                return t.frame
            0

        def frames() -> i64:
            if clip is c:
                return c.frames
            1

        # Frames per second of the loaded clip, from its key times.
        def rate() -> i64:
            if clip is c:
                return c.rate if c.rate >= 1 else Timeline::RATE
            Timeline::RATE

        # Document nodes of the loaded take (gizmo corrections name them).
        def node_total() -> i64:
            if clip is c:
                return GlbDocument::node_count(&c.source).i64()
            0

        def current_stack() -> StackState::Stack:
            if history_ready:
                return HistoryState::current(&history)
            StackState::empty()

        def session_identity(c: StudioModel::Clip) -> SessionState::SourceIdentity:
            SessionState::SourceIdentity{first: c.source_fingerprint.first, second: c.source_fingerprint.second, animation: c.anim.i64(), frames: c.source_frames, nodes: GlbDocument::node_count(&c.source).i64()}

        def touch() -> void:
            revision <- revision + 1
            UiCore::request_frame_after(0.001)

        # Rebuild the cleaned clip from the current stack (live preview).
        def rebuild() -> void:
            s: StackState::Stack = current_stack()
            if clip is old:
                shown_slide <- readout_value(shown_slide, old.slide_after)
                shown_sink <- readout_value(shown_sink, old.sink_after)
                shown_hand_slide <- readout_value(shown_hand_slide, old.hand_slide_after)
            readout_start <- UiAppKitCanvas::monotonic_time()
            if memo == null:
                memo <- StudioModel::load(path, anim_name)
            mutable result: StudioModel::Clip? = null
            if memo is held:
                mutable m: StudioModel::Memo = held
                memo <- null
                if built_stack is prior:
                    rig_source_revision <- rig_source_revision + 1 if not StackState::same_rig_source(prior, s)
                else:
                    rig_source_revision <- rig_source_revision + 1
                w: mutable StudioPerf::Window = StudioPerf::full(m.frames)
                if clip is c:
                    if built_stack is old:
                        w <- StudioPerf::edit_window(old, s, m.frames, m.shortest)
                    result <- StudioModel::build_with(&m, s, c.points, c.problems, c.peaks, w, rig_source_revision)
                else:
                    none_p: darray[Geometry::Vec3] = []
                    none_i: darray[i64] = []
                    result <- StudioModel::build_with(&m, s, none_p, none_i, none_i, w, rig_source_revision)
                memo <- move m
            if result == null:
                status <- "clip failed to load"
                nudged_row <- -1
                status_file <- null
                load_failed <- true
                return
            load_failed <- false
            clip <- move result
            StudioPanels::set_rate(rate())
            sync_count()
            built_stack <- s
            built <- built + 1
            touch()

        # A retime changes the clip length: keep the playhead on the same
        # source frame.
        def sync_count() -> void:
            if timeline is t:
                n: i64 = frames()
                if t.count != n:
                    mutable u: TimelineState::State = TimelineState::create(n)
                    u.looping <- t.looping
                    u.divisor <- t.divisor
                    set_timeline(TimelineState::scrub(u, t.frame * n / t.count))
                    contact_selected_side <- StudioContactEditor::NO_SIDE
                    contact_selected_frame <- -1

        # ---- retiming ------------------------------------------------------
        # Speed for the selection (a new band or the band under it), else for
        # the focused band.
        def retime_to(speed: i64) -> void:
            retime_speed <- Retime::clamp_speed(speed)
            if clip is c:
                mutable s: StackState::Stack = current_stack()
                mutable ok: bool = false
                if RetimeState::ready(&selection):
                    first: i64 = StudioModel::source_frame(c, RetimeState::lo(&selection))
                    last: i64 = StudioModel::source_frame(c, RetimeState::hi(&selection))
                    ok <- RetimeState::apply_speed(&s, first, last, retime_speed, c.source_frames)
                    band_focus <- StackState::band_at(&s, first)
                elif band_focus >= 0:
                    ok <- StackState::set_band_speed(&s, band_focus, retime_speed)
                if ok:
                    selection <- RetimeState::none()
                    commit(s, true)
                    status <- StudioText::number("retime permille ", retime_speed)
                else:
                    status <- "retime: Shift-drag a range (no overlap with a band)"
                touch()

        def typed_view() -> sview can Unsafe.PointerCast:
            StudioText::begin()
            StudioText::put("speed: ")
            for i in 0..<typed_len.usize():
                StudioText::byte(typed[i])
            StudioText::byte(95)
            return StudioText::view()

        def typed_speed() -> i64:
            StudioText::begin()
            for i in 0..<typed_len.usize():
                StudioText::byte(typed[i])
            return RetimeState::parse_speed(StudioText::view())

        def text_input(text: sview) -> void:
            return if not typing or text.len <= 0 or text.data == null
            for i in 0..<text.len.usize():
                if typed_len < 8 and text.data[i] != 61:
                    typed[typed_len.usize()] <- text.data[i]
                    typed_len <- typed_len + 1
            touch()

        # Shift-1..7: speed presets 0.5x .. 2x.
        def preset_key(code: UiCore::Key) -> i64:
            return 0 if code == UiCore::Key.Digit1
            return 1 if code == UiCore::Key.Digit2
            return 2 if code == UiCore::Key.Digit3
            return 3 if code == UiCore::Key.Digit4
            return 4 if code == UiCore::Key.Digit5
            return 5 if code == UiCore::Key.Digit6
            return 6 if code == UiCore::Key.Digit7
            return -1

        def remove_band() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::remove_band(&s, band_focus):
                band_focus <- -1
                commit(s, true)
                status <- "retime band removed"

        # Record an edited stack and preview it; selection-only edits are
        # recorded too so undo restores the row the user was on.
        def commit(s: StackState::Stack, preview: bool) -> void:
            if history_ready:
                changed: bool = HistoryState::record(&history, s)
                if changed and preview:
                    rebuild()
                touch()

        def undo() -> void:
            if history_ready:
                if HistoryState::undo(&history):
                    rebuild()
                    status <- "undo"
                    nudged_row <- -1
                    status_file <- null

        def redo() -> void:
            if history_ready:
                if HistoryState::redo(&history):
                    rebuild()
                    status <- "redo"
                    nudged_row <- -1
                    status_file <- null

        # ---- foot cleanup ------------------------------------------------
        # Readout transition progress (StudioFoot::FULL when settled).
        def readout_progress() -> i64:
            ms: f64 = (UiAppKitCanvas::monotonic_time() - readout_start) * 1000.0
            elapsed: i64 = 0 if ms < 0.0 else (READOUT_MS if ms > READOUT_MS.f64() else ms.i64())
            return StudioFoot::progress(elapsed, READOUT_MS)

        def readout_value(shown: i64, target: i64) -> i64:
            return target if target < -StudioFoot::LIMIT or target > StudioFoot::LIMIT
            return target if shown < -StudioFoot::LIMIT or shown > StudioFoot::LIMIT
            return StudioFoot::mix(shown, target, readout_progress())

        # K: foot cleanup on/off, recorded in history.
        def toggle_feet() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::set_feet(&s, not s.feet):
                commit(s, true)
                status <- "feet fixed" if s.feet else "feet off"
                nudged_row <- -1
                status_file <- null

        # J: opt-in hand contact cleanup, recorded in history.
        def toggle_hands() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::set_hands(&s, not s.hands):
                commit(s, true)
                status <- "hands fixed" if s.hands else "hands off"
                nudged_row <- -1
                status_file <- null

        # , and .: shorter or longer carry blend.
        def nudge_blend(up: bool) -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::nudge_blend(&s, up):
                commit(s, true)
                status <- "blend"
                nudged_row <- -2

        # W: scrub to the worst planted slide, select that foot and frame it.
        def jump_worst() -> void:
            if clip is c:
                return if c.worst_frame < 0 or c.worst_frame >= c.frames
                scrub_to(c.worst_frame)
                role: i64 = Roles::LEFT_FOOT if c.worst_side == StackState::LEFT else Roles::RIGHT_FOOT
                bone <- StudioClip::slot_of_role(c.cleaned, c.slot, role)
                track: darray[Geometry::Vec3] = c.left_foot if c.worst_side == StackState::LEFT else c.right_foot
                if c.worst_frame < track.count.i64():
                    p: Geometry::Vec3 = track[c.worst_frame.usize()]
                    pts: darray[Geometry::Vec3] = [Geometry::vec3_add(p, Geometry::Vec3{x: -0.25, y: -0.05, z: -0.25}), Geometry::vec3_add(p, Geometry::Vec3{x: 0.25, y: 0.35, z: 0.25})]
                    for i in 0..<3 |i, pts|:
                        if view(i) is opened:
                            mutable vp: Viewport::Viewport = opened
                            _ = ViewportCamera::frame_points(&vp.camera, &pts, 1.15)
                            Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                            put_view(i, vp)
                status <- "worst slide"
                nudged_row <- -1
                status_file <- null
                touch()

        # A press on a contact row; true when it was one.
        def contact_down(x: f32, y: f32) -> bool:
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            row: i64 = StudioPanels::contact_row(tb, y)
            return false if row < 0
            if clip is c:
                st: StudioPanels::Box = StudioPanels::strip(tb)
                mutable fl: darray[bool] = c.left_contact
                fl <- c.right_contact if row == StackState::RIGHT
                fl <- c.left_hand_contact if row == StackState::LEFT_HAND
                fl <- c.right_hand_contact if row == StackState::RIGHT_HAND
                foot_press <- FootState::press(fl, row, (x - st.x).i64(), st.w.i64())
                return true
            false

        def contact_up(x: f32) -> void:
            p: FootState::Press = foot_press
            foot_press <- FootState::idle()
            delta_x: i64 = (x - down_x).i64()
            if not StudioContactEditor::is_drag(delta_x):
                contact_selected_side <- p.side
                contact_selected_frame <- p.frame
                scrub_to(p.frame)
                status <- "contact frame selected; choose Plant frame or Lift frame"
                nudged_row <- -1
                status_file <- null
                touch()
                return
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            if p.part != StudioFoot::FIRST and p.part != StudioFoot::LAST:
                contact_selected_side <- p.side
                contact_selected_frame <- p.frame
                scrub_to(p.frame)
                status <- "select a frame first or drag a run endpoint"
                touch()
                return
            mutable s: StackState::Stack = current_stack()
            if FootState::release(&s, &p, StudioPanels::timeline_frame(tb, x, frames()), frames()):
                commit(s, true)
                status <- "contact endpoint moved"
                nudged_row <- -1
                status_file <- null
            contact_selected_side <- p.side
            contact_selected_frame <- StudioPanels::timeline_frame(tb, x, frames())
            touch()

        # Apply an explicit Plant/Lift action to the selected output frame.
        def contact_apply(action: i64) -> void:
            return if not StudioContactEditor::action_valid(action)
            if clip is c:
                if not StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames):
                    status <- "select a contact row and frame first"
                    touch()
                    return
                mutable s: StackState::Stack = current_stack()
                if action == StudioContactEditor::RESET:
                    if StackState::reset_edit_at(&s, contact_selected_side, contact_selected_frame):
                        commit(s, true)
                        StudioText::begin()
                        StudioText::put("Restored ")
                        StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                        StudioText::put(" frame ")
                        StudioText::put_i(contact_selected_frame + 1)
                        StudioText::put(" to automatic detection")
                        status <- StudioText::view()
                    elif StackState::has_edit_at(s, contact_selected_side, contact_selected_frame):
                        status <- "cannot reset this frame: contact edit capacity would be exceeded"
                    else:
                        status <- "this frame already follows automatic detection"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return
                if StackState::add_edit(&s, contact_selected_side,
                    contact_selected_frame, contact_selected_frame,
                    StudioContactEditor::plants(action)):
                    commit(s, true)
                    StudioText::begin()
                    StudioText::put("Planted " if action == StudioContactEditor::PLANT else "Lifted ")
                    StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                    StudioText::put(" at frame ")
                    StudioText::put_i(contact_selected_frame + 1)
                    status <- StudioText::view()
                else:
                    status <- "contact edit limit reached; undo an edit before adding another"
                nudged_row <- -1
                status_file <- null
                touch()

        def set_timeline(t: TimelineState::State) -> void:
            timeline <- t
            touch()

        def scrub_to(f: i64) -> void:
            if timeline is t:
                set_timeline(TimelineState::scrub(t, f))

        def step_frames(d: i64) -> void:
            if timeline is t:
                set_timeline(TimelineState::step_by(t, d))

        def toggle_play() -> void:
            if timeline is t:
                last_time <- UiAppKitCanvas::monotonic_time()
                set_timeline(TimelineState::toggle_play(t))

        def cycle_speed() -> void:
            if timeline is t:
                set_timeline(TimelineState::cycle_speed(t))

        def toggle_loop() -> void:
            if timeline is t:
                mutable n: TimelineState::State = t
                n.looping <- not n.looping
                set_timeline(n)

        def toggle_flag(bit: i64) -> void:
            flags <- StudioScene::toggle(flags, bit)
            touch()

        # ---- stack edits -----------------------------------------------
        def add_op(k: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::add(&s, StudioModel::new_operation(k, frames())):
                StackState::select(&s, s.count - 1)
                commit(s, true)
                status <- "operation added"
                nudged_row <- -1
                status_file <- null

        def edit_selected(kind: i64, amount: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            at: i64 = s.selected
            return if not StackState::valid(s, at)
            mutable ok: bool = false
            if kind == StudioPanels::HIT_TOGGLE:
                ok <- StackState::toggle(&s, at)
            elif kind == StudioPanels::HIT_REMOVE:
                ok <- StackState::remove(&s, at)
            elif kind == StudioPanels::HIT_UP:
                ok <- StackState::move(&s, at, -1)
            elif kind == StudioPanels::HIT_DOWN:
                ok <- StackState::move(&s, at, 1)
            elif kind == 7:
                ok <- StudioModel::nudge(&s, at, amount)
                nudged_row <- at if ok else -1
            elif kind == 8:
                ok <- StackState::cycle_bones(&s, at)
            elif kind == 9:
                op: Ops::Operation = s.ops[at]
                ok <- StackState::set_scope(&s, at, frame_now(), op.last, frames())
            elif kind == 10:
                op: Ops::Operation = s.ops[at]
                ok <- StackState::set_scope(&s, at, op.first, frame_now(), frames())
            if ok:
                commit(s, true)

        def select_row(i: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            StackState::select(&s, i)
            commit(s, false)

        def row_action(hit: i64) -> void:
            kind: i64 = hit / 100
            row: i64 = hit % 100
            if kind == StudioPanels::HIT_ADD:
                add_op(row)
                return
            select_row(row)
            edit_selected(kind, 0) if kind != StudioPanels::HIT_SELECT

        # One click Fix all: the boxing preset plus foot and hand locks as one
        # undoable edit; the sidebar shows every detector's before/after.
        def clean_with_preset() -> void:
            commit(StudioModel::fix_all_stack(), true)
            if clip is c:
                gain_slide <- gain(c.slide_before, c.slide_after)
                gain_spikes <- gain(c.spikes_before, c.spikes_after)
            status <- "Fix all applied (Cmd-Z to undo)"
            nudged_row <- -1
            status_file <- null
            touch()

        def gain(before: i64, after: i64) -> i64:
            return 0 if before < 0 or after < 0 or before > StudioChrome::CHROME_SIZE or after > StudioChrome::CHROME_SIZE
            StudioChrome::clean_gain(before, after)

        # Status line naming a file: "<s> <file name>".
        def say_file(s: sview, file: cstr) -> void:
            status <- s
            nudged_row <- -1
            status_file <- file

        def save_session_to_current_path() -> bool:
            mutable ok: bool = false
            if clip is c:
                ok <- SessionState::save_session(current_stack(), session_identity(c), session_path)
            if ok:
                HistoryState::mark_saved(&history)
                say_file("session saved to", session_path)
                FilePanel::note_recent(session_path)
            else:
                say_file("session save failed; check path, permissions or disk space", session_path)
            touch()
            ok

        def save_session() -> void:
            _ = save_session_to_current_path()

        def install_session(p: cstr, loaded: StackState::Stack, allow_legacy: bool) -> void:
            commit(loaded, true)
            HistoryState::mark_saved(&history)
            _ = set_session_path(p)
            mutable loaded_message: sview = "session loaded (Cmd-Z to undo) from"
            loaded_message <- "legacy session loaded; verify joints (Cmd-Z to undo) from" if allow_legacy
            say_file(loaded_message, session_path)
            FilePanel::note_recent(session_path)
            touch()

        def resolve_legacy_session(choice: i64) -> void can Unsafe.PointerCast:
            action: i64 = StudioLegacyPrompt::resolve(legacy_prompt_open, choice)
            return if action == StudioLegacyPrompt::NONE
            if action == StudioLegacyPrompt::CANCEL:
                legacy_prompt_open <- false
                pending_replacement <- 0
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                say_file("legacy session cancelled; current cleanup unchanged", pending_path())
                touch()
                return
            p: cstr = pending_path()
            legacy_prompt_open <- false
            touch()
            request_replacement(p, REPLACE_SESSION, true)

        def path_bytes(p: cstr) -> darray[u8] can Unsafe.PointerCast:
            mutable out: darray[u8] = []
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                return out if c == 0
                out.push(c)
                i <- i + 1
            []

        def export_reason(destination: cstr, overwrite_confirmed: bool) -> i64 can Unsafe.PointerCast:
            mutable reason: i64 = StudioExportPolicy::PATH_UNRESOLVED
            if FilePanel::resolve_path("build") is root_path:
                if FilePanel::resolve_path(destination) is target_path:
                    root_facts: i64 = FilePanel::path_facts(root_path)
                    target_facts: i64 = FilePanel::path_facts(target_path)
                    if root_facts >= 0 and target_facts >= 0:
                        if (root_facts & FilePanel::PATH_DIRECTORY) == 0:
                            reason <- StudioExportPolicy::OUTSIDE_BUILD
                        else:
                            root_bytes: darray[u8] = path_bytes(root_path)
                            target_bytes: darray[u8] = path_bytes(target_path)
                            if root_bytes.count > 0 and target_bytes.count > 0:
                                reason <- StudioExportPolicy::decision(
                                    true,
                                    StudioExportPolicy::inside_build(root_bytes, target_bytes),
                                    FilePanel::same_identity(path, target_path),
                                    (target_facts & FilePanel::PATH_EXISTS) != 0,
                                    (target_facts & FilePanel::PATH_SYMLINK) != 0,
                                    (target_facts & FilePanel::PATH_REGULAR) != 0,
                                    overwrite_confirmed)
                    FilePanel::release_path(target_path)
                FilePanel::release_path(root_path)
            reason

        def export_error(reason: i64) -> sview:
            return "Export blocked: destination could not be resolved" if reason == StudioExportPolicy::PATH_UNRESOLVED
            return "Export blocked: choose a file inside the build folder" if reason == StudioExportPolicy::OUTSIDE_BUILD
            return "Export blocked: destination is the source take" if reason == StudioExportPolicy::SOURCE_COLLISION
            return "Export blocked: destination is a symbolic link" if reason == StudioExportPolicy::SYMBOLIC_LINK
            return "Export blocked: destination is not a regular file" if reason == StudioExportPolicy::NOT_REGULAR_FILE
            return "Export blocked: replace confirmation is required"

        def current_export_warnings() -> i64:
            if clip is c:
                return StudioExportPolicy::warning_count(
                    c.impossible_frames,
                    c.spikes_before, c.spikes_after,
                    c.slide_before, c.slide_after,
                    c.sink_before, c.sink_after,
                    c.hand_slide_before, c.hand_slide_after)
            0

        # Warning rows are ordered exactly as their presentation: balance,
        # spikes, foot slide, foot sink, then hand slide. Only present rows
        # occupy an index, keeping keyboard and pointer navigation compact.
        def export_warning_kind(index: i64, c: StudioModel::Clip&) -> i64:
            requires index >= 0 and index < StudioExportReview::MAX_WARNINGS
            mutable row: i64 = 0
            if c.impossible_frames > 0:
                return StudioExportReview::BALANCE_WARNING if row == index
                row <- row + 1
            if c.spikes_after > c.spikes_before:
                return StudioExportReview::SPIKE_WARNING if row == index
                row <- row + 1
            if c.slide_after > c.slide_before:
                return StudioExportReview::FOOT_SLIDE_WARNING if row == index
                row <- row + 1
            if c.sink_after > c.sink_before:
                return StudioExportReview::FOOT_SINK_WARNING if row == index
                row <- row + 1
            if c.hand_slide_after > c.hand_slide_before:
                return StudioExportReview::HAND_SLIDE_WARNING if row == index
            StudioExportReview::NO_WARNING

        def current_export_warning_kind(index: i64) -> i64:
            if clip is c and index >= 0 and index < current_export_warnings():
                return export_warning_kind(index, c)
            StudioExportReview::NO_WARNING

        def request_export(destination: cstr, overwrite_confirmed: bool) -> void:
            if clip is c:
                reason: i64 = export_reason(destination, overwrite_confirmed)
                if reason != StudioExportPolicy::ALLOW and reason != StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                    say_file(export_error(reason), destination)
                    touch()
                    return
                export_review_open <- true
                export_review_path <- destination
                export_review_overwrite <- overwrite_confirmed
                export_review_acknowledged <- false
                export_review_focus <- StudioExportReview::initial_focus(current_export_warnings())
                export_review_warning_selected <- 0
                export_warning_detail_open <- false
                export_warning_detail_index <- 0
                export_warning_detail_focus <- StudioExportPathReview::DONE
                help_open <- false
                file_menu_open <- false
                touch()

        def cancel_export_review() -> void:
            return if not export_review_open
            destination: cstr = export_review_path
            export_path_inspector_open <- false
            export_warning_detail_open <- false
            export_warning_detail_index <- 0
            export_warning_detail_focus <- StudioExportPathReview::DONE
            export_review_open <- false
            export_review_path <- ""
            export_review_acknowledged <- false
            say_file("Export cancelled; no file was written", destination)
            touch()

        def open_export_path_inspector() -> void:
            return if not export_review_open
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            return if pages < 1 or pages > StudioExportPathReview::MAX_PAGES
            export_path_inspector_page <- 0
            export_path_inspector_focus <- StudioExportPathReview::initial_focus(0, pages)
            export_path_inspector_open <- true
            touch()

        def close_export_path_inspector() -> void:
            return if not export_path_inspector_open
            export_path_inspector_open <- false
            touch()

        def close_export_warning_detail() -> void:
            return if not export_warning_detail_open
            export_warning_detail_open <- false
            export_review_warning_selected <- export_warning_detail_index
            touch()

        def open_export_warning_detail(index: i64) -> void:
            warnings: i64 = current_export_warnings()
            return if not export_review_open or index < 0 or index >= warnings
            export_review_warning_selected <- index
            export_review_focus <- StudioExportReview::INSPECT_WARNINGS
            export_warning_detail_index <- index
            export_warning_detail_focus <- StudioExportPathReview::initial_focus(index, warnings)
            export_warning_detail_open <- true
            touch()

        def activate_export_warning_detail(action: i64) -> void:
            return if not export_warning_detail_open
            warnings: i64 = current_export_warnings()
            return if warnings < 1 or warnings > StudioExportReview::MAX_WARNINGS
            if action == StudioExportPathReview::DONE:
                close_export_warning_detail()
                return
            return if not StudioExportPathReview::enabled(action, export_warning_detail_index, warnings)
            direction: i64 = -1 if action == StudioExportPathReview::PREVIOUS else 1
            export_warning_detail_index <- StudioExportPathReview::move_page(
                export_warning_detail_index, direction, warnings)
            export_review_warning_selected <- export_warning_detail_index
            export_warning_detail_focus <- action if StudioExportPathReview::enabled(
                action, export_warning_detail_index, warnings)
            export_warning_detail_focus <- StudioExportPathReview::initial_focus(
                export_warning_detail_index, warnings) if not StudioExportPathReview::enabled(
                action, export_warning_detail_index, warnings)
            touch()

        def export_warning_detail_key(code: UiCore::Key) -> void:
            warnings: i64 = current_export_warnings()
            if code == UiCore::Key.Escape:
                close_export_warning_detail()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                activate_export_warning_detail(StudioExportPathReview::PREVIOUS) if StudioExportPathReview::enabled(StudioExportPathReview::PREVIOUS, export_warning_detail_index, warnings)
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                activate_export_warning_detail(StudioExportPathReview::NEXT) if StudioExportPathReview::enabled(StudioExportPathReview::NEXT, export_warning_detail_index, warnings)
            elif code == UiCore::Key.Tab:
                export_warning_detail_focus <- StudioExportPathReview::move_focus(
                    export_warning_detail_focus,
                    -1 if StudioShortcuts::shift(modifiers) else 1,
                    export_warning_detail_index, warnings)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_warning_detail(export_warning_detail_focus)

        def activate_export_path_inspector(action: i64) -> void:
            return if not export_path_inspector_open
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            return if pages < 1 or pages > StudioExportPathReview::MAX_PAGES
            if action == StudioExportPathReview::DONE:
                close_export_path_inspector()
                return
            return if not StudioExportPathReview::enabled(action, export_path_inspector_page, pages)
            direction: i64 = -1 if action == StudioExportPathReview::PREVIOUS else 1
            export_path_inspector_page <- StudioExportPathReview::move_page(
                export_path_inspector_page, direction, pages)
            export_path_inspector_focus <- action if StudioExportPathReview::enabled(
                action, export_path_inspector_page, pages)
            export_path_inspector_focus <- StudioExportPathReview::initial_focus(
                export_path_inspector_page, pages) if not StudioExportPathReview::enabled(
                action, export_path_inspector_page, pages)
            touch()

        def export_path_inspector_key(code: UiCore::Key) -> void:
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            if code == UiCore::Key.Escape:
                close_export_path_inspector()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                activate_export_path_inspector(StudioExportPathReview::PREVIOUS) if StudioExportPathReview::enabled(StudioExportPathReview::PREVIOUS, export_path_inspector_page, pages)
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                activate_export_path_inspector(StudioExportPathReview::NEXT) if StudioExportPathReview::enabled(StudioExportPathReview::NEXT, export_path_inspector_page, pages)
            elif code == UiCore::Key.Tab:
                export_path_inspector_focus <- StudioExportPathReview::move_focus(
                    export_path_inspector_focus,
                    -1 if StudioShortcuts::shift(modifiers) else 1,
                    export_path_inspector_page, pages)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_path_inspector(export_path_inspector_focus)

        def activate_export_review(focus: i64) -> void:
            return if not export_review_open
            if focus == StudioExportReview::ACKNOWLEDGE:
                if current_export_warnings() > 0:
                    export_review_acknowledged <- not export_review_acknowledged
                    touch()
                return
            if focus == StudioExportReview::DESTINATION:
                open_export_path_inspector()
                return
            if focus == StudioExportReview::INSPECT_WARNINGS:
                open_export_warning_detail(export_review_warning_selected)
                return
            if focus == StudioExportReview::CANCEL:
                cancel_export_review()
                return
            warnings: i64 = current_export_warnings()
            if not StudioExportReview::export_enabled(warnings, export_review_acknowledged):
                export_review_focus <- StudioExportReview::ACKNOWLEDGE
                say_file("Review the quality notes before exporting", export_review_path)
                touch()
                return
            destination: cstr = export_review_path
            overwrite_confirmed: bool = export_review_overwrite
            export_path_inspector_open <- false
            export_warning_detail_open <- false
            export_warning_detail_index <- 0
            export_warning_detail_focus <- StudioExportPathReview::DONE
            export_review_open <- false
            export_review_path <- ""
            export_review_acknowledged <- false
            _ = perform_export(destination, overwrite_confirmed)

        def export_review_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                cancel_export_review()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                export_review_focus <- StudioExportReview::move_focus(export_review_focus, -1, current_export_warnings())
                touch()
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                export_review_focus <- StudioExportReview::move_focus(export_review_focus, 1, current_export_warnings())
                touch()
            elif code == UiCore::Key.Tab:
                export_review_focus <- StudioExportReview::move_focus(export_review_focus, -1 if StudioShortcuts::shift(modifiers) else 1, current_export_warnings())
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_review(export_review_focus)

        def cancel_export_result() -> void:
            return if not export_result_open
            export_result_open <- false
            export_result_path <- ""
            touch()

        def activate_export_result(action: i64) -> void:
            return if not export_result_open
            destination: cstr = export_result_path
            if action == StudioExportResult::DONE:
                cancel_export_result()
                return
            if action == StudioExportResult::OPEN:
                if FilePanel::open_file(destination):
                    cancel_export_result()
                    say_file("opened exported result", destination)
                else:
                    say_file("could not open the result in its default application", destination)
                    touch()
                return
            if action == StudioExportResult::SHOW_IN_FOLDER:
                if FilePanel::show_in_folder(destination):
                    cancel_export_result()
                    say_file("showing exported result in Finder", destination)
                else:
                    say_file("could not show the result in Finder", destination)
                    touch()

        def export_result_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                cancel_export_result()
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                export_result_focus <- StudioExportResult::move_focus(export_result_focus, -1)
                touch()
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                export_result_focus <- StudioExportResult::move_focus(export_result_focus, 1)
                touch()
            elif code == UiCore::Key.Tab:
                export_result_focus <- StudioExportResult::move_focus(export_result_focus, -1 if StudioShortcuts::shift(modifiers) else 1)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_export_result(export_result_focus)

        def perform_export(destination: cstr, overwrite_confirmed: bool) -> bool:
            if clip is c:
                mutable allows_overwrite: bool = overwrite_confirmed
                mutable reason: i64 = export_reason(destination, allows_overwrite)
                if reason == StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                    if FilePanel::confirm_replace(destination):
                        allows_overwrite <- true
                        reason <- export_reason(destination, true)
                    else:
                        say_file("Export cancelled; existing file kept", destination)
                        touch()
                        return false
                if reason != StudioExportPolicy::ALLOW:
                    say_file(export_error(reason), destination)
                    touch()
                    return false

                if StudioExportPublisher::prepare(c.cleaned, destination) is temporary:
                    # Recheck after writing and validating the temporary so a
                    # destination that changed during export cannot be silently
                    # replaced. Publication is a single same-directory rename.
                    reason <- export_reason(destination, allows_overwrite)
                    if reason == StudioExportPolicy::OVERWRITE_UNCONFIRMED:
                        if FilePanel::confirm_replace(destination):
                            allows_overwrite <- true
                            reason <- export_reason(destination, true)
                        else:
                            StudioExportPublisher::discard(temporary)
                            FilePanel::release_path(temporary)
                            say_file("Export cancelled; existing file kept", destination)
                            touch()
                            return false
                    if reason != StudioExportPolicy::ALLOW:
                        StudioExportPublisher::discard(temporary)
                        FilePanel::release_path(temporary)
                        say_file(export_error(reason), destination)
                        touch()
                        return false
                    if StudioExportPublisher::commit(temporary, destination):
                        FilePanel::release_path(temporary)
                        export_path <- destination
                        say_file("exported and validated", destination)
                        FilePanel::note_recent(destination)
                        _ = puts(destination)
                        export_result_path <- destination
                        export_result_focus <- StudioExportResult::OPEN
                        export_result_open <- true
                        touch()
                        return true
                    StudioExportPublisher::discard(temporary)
                    FilePanel::release_path(temporary)
                    say_file("export failed; destination kept", destination)
                else:
                    say_file("export failed validation or could not be written", destination)
                touch()
            false

        # ---- native file panels (modal) --------------------------------
        def save_session_as() -> void:
            if FilePanel::save("txt", session_path, "Save the operation stack and contacts as a session") is chosen:
                if set_session_path(chosen):
                    save_session()
                else:
                    say_file("session path exceeds 4095 bytes", chosen)
                    touch()

        def open_session() -> void:
            if clip == null:
                status <- "open a take before loading a session"
                status_file <- null
                touch()
                return
            if FilePanel::open("txt", "Open a saved session for this take") is chosen:
                request_replacement(chosen, REPLACE_SESSION, false)

        def export_as() -> void:
            return if clip == null
            if FilePanel::save("glb", export_path, "Export the cleaned take") is chosen:
                request_export(chosen, true)

        def dispatch_file_action(action: i64) -> void:
            if action == StudioFilePolicy::OPEN_TAKE:
                open_take()
            elif action == StudioFilePolicy::OPEN_SESSION:
                open_session()
            elif action == StudioFilePolicy::SAVE:
                save_session()
            elif action == StudioFilePolicy::SAVE_AS:
                save_session_as()
            elif action == StudioFilePolicy::EXPORT_CURRENT:
                request_export(export_path, false)
            elif action == StudioFilePolicy::EXPORT_AS:
                export_as()

        def activate_file_menu(row: i64) -> void:
            return if row < 0 or row >= StudioFilePolicy::ROWS
            action: i64 = StudioFilePolicy::activate(row, clip != null)
            return if action == StudioFilePolicy::NONE
            file_menu_open <- false
            file_menu_hover <- -1
            touch()
            dispatch_file_action(action)

        def file_menu_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                file_menu_open <- false
                file_menu_hover <- -1
                touch()
            elif code == UiCore::Key.Up:
                file_menu_focus <- StudioFilePolicy::next_enabled(file_menu_focus, -1, clip != null)
                touch()
            elif code == UiCore::Key.Down:
                file_menu_focus <- StudioFilePolicy::next_enabled(file_menu_focus, 1, clip != null)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_file_menu(file_menu_focus)

        def replacement_action_for_focus() -> i64:
            return StudioReplacement::SAVE if replacement_focus == StudioReplacement::FOCUS_SAVE
            return StudioReplacement::DISCARD if replacement_focus == StudioReplacement::FOCUS_DISCARD
            StudioReplacement::CANCEL

        def finish_close() -> void can[Ui.Window]:
            replacement_prompt_open <- false
            replacement_is_close <- false
            replacement_save_failed <- false
            pending_replacement <- 0
            pending_replacement_allows_legacy <- false
            pending_session_ready <- false
            touch()
            if replacement_is_termination:
                termination_authorized <- true
                UiAppKitCanvas::terminate()
            else:
                close_authorized <- true
                UiAppKitCanvas::close()

        def perform_replacement(kind: i64, p: cstr, allow_legacy: bool) -> void can Unsafe.PointerCast:
            replacement_prompt_open <- false
            legacy_prompt_open <- false
            replacement_is_close <- false
            replacement_is_termination <- false
            replacement_save_failed <- false
            file_menu_open <- false
            pending_replacement <- 0
            pending_replacement_allows_legacy <- false
            touch()
            if kind == REPLACE_TAKE:
                pending_session_ready <- false
                load_take_now(p)
            elif kind == REPLACE_SESSION:
                if pending_session_ready:
                    loaded: StackState::Stack = pending_session_stack
                    pending_session_ready <- false
                    install_session(p, loaded, allow_legacy)
                else:
                    say_file("session validation expired; open it again", p)
                    touch()

        def request_replacement(p: cstr, kind: i64, allow_legacy: bool) -> void can Unsafe.PointerCast:
            return if kind != REPLACE_TAKE and kind != REPLACE_SESSION
            cancel_export_result() if export_result_open
            cancel_export_review() if export_review_open
            if replacement_prompt_open or legacy_prompt_open:
                status <- "finish or cancel the pending replacement first"
                status_file <- null
                touch()
                return
            if not stage_pending_path(p):
                status <- "file path exceeds 4095 bytes"
                status_file <- null
                touch()
                return
            pending_session_ready <- false
            if kind == REPLACE_SESSION:
                if clip is c:
                    if SessionState::load_session(p, frames(), node_total(), session_identity(c), allow_legacy) is prepared:
                        pending_session_stack <- prepared
                        pending_session_ready <- true
                    else:
                        if not allow_legacy and SessionState::load_error() == SessionState::LOAD_ERROR_LEGACY:
                            legacy_prompt_open <- true
                            legacy_prompt_focus <- StudioLegacyPrompt::initial_focus()
                            file_menu_open <- false
                            help_open <- false
                            touch()
                            return
                        mutable failure: sview = "session cannot be read; it may be damaged or unsupported"
                        failure <- "session source, animation or rig does not match this take" if SessionState::load_error() == SessionState::LOAD_ERROR_SOURCE
                        failure <- "session file could not be read" if SessionState::load_error() == SessionState::LOAD_ERROR_READ
                        say_file(failure, p)
                        touch()
                        return
                else:
                    say_file("open a take before loading a session", p)
                    touch()
                    return
            pending_replacement <- kind
            pending_replacement_allows_legacy <- allow_legacy
            replacement_is_close <- false
            replacement_is_termination <- false
            mutable dirty: bool = false
            if history_ready:
                dirty <- HistoryState::dirty(&history)
            if StudioReplacement::needs_prompt(clip != null, dirty):
                replacement_prompt_open <- true
                replacement_focus <- StudioReplacement::initial_focus()
                replacement_save_failed <- false
                file_menu_open <- false
                help_open <- false
                touch()
                return
            perform_replacement(kind, pending_path(), allow_legacy)

        def resolve_replacement(choice: i64) -> void:
            action: i64 = StudioReplacement::resolve(replacement_prompt_open, choice)
            return if action == StudioReplacement::NONE
            if action == StudioReplacement::CANCEL:
                mutable cancelled: sview = "replacement cancelled; session unchanged"
                cancelled <- "close cancelled; session unchanged" if replacement_is_close
                cancelled <- "quit cancelled; session unchanged" if replacement_is_termination
                replacement_prompt_open <- false
                replacement_is_close <- false
                replacement_is_termination <- false
                replacement_save_failed <- false
                pending_replacement <- 0
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                say_file(cancelled, path)
                touch()
                return
            pending: cstr = pending_path()
            kind: i64 = pending_replacement
            allow_legacy: bool = pending_replacement_allows_legacy
            if action == StudioReplacement::SAVE:
                if not save_session_to_current_path():
                    replacement_save_failed <- true
                    touch()
                    return
            if kind == REPLACE_CLOSE:
                finish_close()
                return
            perform_replacement(kind, pending, allow_legacy)

        def request_window_close() -> void can[Ui.Window]:
            # AppKit may ask once for application termination and again for the
            # owned window close. Keep this authorization live through both.
            if termination_authorized:
                return
            # This bit is set only for the second, programmatic close request
            # made after the user chooses Save or Discard in the prompt.
            if close_authorized:
                close_authorized <- false
                return
            cancel_export_result() if export_result_open
            cancel_export_review() if export_review_open
            if legacy_prompt_open:
                legacy_prompt_open <- false
                pending_replacement <- 0
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                UiAppKitCanvas::veto_close()
                say_file("legacy session cancelled; current cleanup unchanged", pending_path())
                touch()
                return
            if replacement_prompt_open:
                pending_replacement <- REPLACE_CLOSE
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                replacement_is_close <- true
                replacement_is_termination <- UiAppKitCanvas::is_termination_request()
                UiAppKitCanvas::veto_close()
                touch()
                return
            mutable dirty: bool = false
            if history_ready:
                dirty <- HistoryState::dirty(&history)
            if StudioReplacement::needs_prompt(clip != null, dirty):
                pending_replacement <- REPLACE_CLOSE
                pending_replacement_allows_legacy <- false
                pending_session_ready <- false
                replacement_prompt_open <- true
                replacement_is_close <- true
                replacement_is_termination <- UiAppKitCanvas::is_termination_request()
                replacement_focus <- StudioReplacement::initial_focus()
                replacement_save_failed <- false
                file_menu_open <- false
                help_open <- false
                UiAppKitCanvas::veto_close()
                touch()

        def replacement_prompt_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                resolve_replacement(StudioReplacement::CANCEL)
            elif code == UiCore::Key.S:
                resolve_replacement(StudioReplacement::SAVE)
            elif code == UiCore::Key.D:
                resolve_replacement(StudioReplacement::DISCARD)
            elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                replacement_focus <- StudioReplacement::move_focus(replacement_focus, -1)
                touch()
            elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                replacement_focus <- StudioReplacement::move_focus(replacement_focus, 1)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                resolve_replacement(replacement_action_for_focus())

        def open_take() -> void:
            if FilePanel::open("glb", "Open a motion-capture take") is chosen:
                load_take(chosen)

        # Swap in another take. The file is read first; if it holds no
        # usable animation the current take stays untouched. Otherwise every
        # per-take cache, the playhead, the gizmo and the undo history start
        # fresh (undo never reaches back into a different take).
        def load_take(p: cstr) -> void can Unsafe.PointerCast:
            request_replacement(p, REPLACE_TAKE, false)

        def load_take_now(p: cstr) -> void can Unsafe.PointerCast:
            candidate_slot: i64 = spare_path_slot()
            if not copy_path(p, candidate_slot):
                status <- "take path exceeds 4095 bytes"
                status_file <- null
                touch()
                return
            candidate_path: cstr = stored_path(candidate_slot)
            fresh: StudioModel::Memo? = StudioModel::load(candidate_path, anim_name)
            if fresh == null:
                say_file("no animation could be read from", candidate_path)
                touch()
                return
            path_slot <- candidate_slot
            path <- candidate_path
            memo <- move fresh
            clip <- null
            contact_selected_side <- StudioContactEditor::NO_SIDE
            contact_selected_frame <- -1
            built_stack <- null
            shown_slide <- 0
            shown_sink <- 0
            shown_hand_slide <- 0
            built <- built + 1
            curve_memo <- zeroed
            base_frame <- -1
            base_built <- -1
            skinned <- null
            skinned_frame <- -1
            skinned_revision <- -1
            mesh <- null
            loaded: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(path):
                value: value
                error failure: GlbSkinMesh::empty()
            if GlbSkinMesh::vertex_count(&loaded) > 0:
                mesh <- loaded
            gizmo_drag <- null
            gizmo_goal <- null
            gizmo_view <- -1
            readout_angle <- -1
            readout_mm <- -1
            gain_slide <- -1
            gain_spikes <- -1
            drag_view <- -1
            drag_button <- -1
            scrubbing <- false
            foot_press <- FootState::Press{side: -1, part: 0, first: -1, last: -1, frame: -1}
            hover_row <- -1
            drawn_frame <- -1
            HistoryState::reset(&history, StudioModel::initial_stack())
            history_ready <- true
            rebuild()
            if clip is c:
                timeline <- TimelineState::create(c.frames)
                bone <- StudioModel::default_bone(c)
                framed <- false
                say_file("opened (undo history starts fresh)", path)
                FilePanel::note_recent(path)
            else:
                timeline <- TimelineState::create(1)
            touch()

        # ---- views -----------------------------------------------------
        def frame_all() -> void:
            if clip is c:
                pts: darray[Geometry::Vec3] = StudioScene::points(c, frame_now())
                for i in 0..<3 |i, pts|:
                    if view(i) is opened:
                        mutable vp: Viewport::Viewport = opened
                        _ = ViewportCamera::frame_points(&vp.camera, &pts, 1.15)
                        Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                        put_view(i, vp)
                touch()

        def view_at(x: f32, y: f32) -> i64:
            for i in 0..<3 |i, x, y|:
                return i if StudioPanels::inside(view_box(i), x, y)
            -1

        def sync_view(i: i64, scale: f32) -> void:
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                rect: UiHostedSurface::Rect = rect_of(view_box(i))
                _ = catch Viewport::resize(&vp, UiHostedSurface::pixel_extent(rect.width, scale), UiHostedSurface::pixel_extent(rect.height, scale)):
                    value: value
                    error failure: false
                if seen(i) != revision:
                    Viewport::invalidate(&vp, ViewportPolicy::DIRTY_SCENE)
                    put_seen(i, revision)
                if clip is c:
                    refresh_skin(c)
                    empty_mesh: GlbSkinMesh::Mesh = GlbSkinMesh::empty()
                    no_points: darray[Geometry::Vec3] = []
                    mutable list: ViewportDraw::List = draw_list(&vp.camera, c, &empty_mesh, &no_points)
                    if gizmo_mode >= 0 and bone >= 0:
                        g: ViewportGizmo::Gizmo = StudioScene::gizmo_for(c, frame_now(), bone, gizmo_mode)
                        _ = catch ViewportGizmo::draw(&list, &vp.camera, &g, GizmoPolicy::NONE, active_handle()):
                            value: value
                            error failure: 0
                    _ = catch Viewport::tick(&vp, &list):
                        value: value
                        error failure: false
                action: i32 = present(i, vp, rect)
                if action == UiHostedSurface::APPLY:
                    _ = Viewport::acknowledge(&vp, vp.published_frame)
                if vp.dirty != 0:
                    UiCore::request_frame_after(0.016)
                put_view(i, vp)

        # Re-skin the mesh when the frame or the clip changed (MESH on only).
        def refresh_skin(c: StudioModel::Clip&) -> void:
            return if not StudioScene::on(flags, StudioScene::MESH)
            return if skinned_frame == frame_now() and skinned_revision == revision
            if mesh is m:
                posed: darray[Geometry::Vec3] = StudioScene::pose_mesh(c, m, frame_now())
                skinned <- posed
                skinned_frame <- frame_now()
                skinned_revision <- revision

        # Refreshes the cached base pose and solves the gizmo chain preview. It reads and
        # writes heap globals, so its allocations live in the never-freed static region;
        # keeping it out of draw_list confines that to frames with an active gizmo goal.
        def chain_preview_of(c: StudioModel::Clip&, goal: Geometry::Transform) -> darray[Geometry::Transform]:
            r: PoseOverride::Rig = StudioModel::rig(c)
            if base_frame != frame_now() or base_built != built:
                base_models <- StudioModel::models(c, r, frame_now(), false)
                base_locals <- StudioClip::locals_at(c.cleaned, c.anim, frame_now(), c.nodes, c.slot)
                base_frame <- frame_now()
                base_built <- built
            p: StudioPerf::Preview = StudioPerf::chain_preview(r, base_models, base_locals, bone, goal)
            preview_moved <- p.moved
            return move p.models

        def draw_list(cam: ViewportCamera::Camera&, c: StudioModel::Clip&, empty_mesh: GlbSkinMesh::Mesh&, no_points: darray[Geometry::Vec3]&) -> ViewportDraw::List:
            mutable preview: darray[Geometry::Transform] = []
            if StudioOverlay::preview(gizmo_view, gizmo_drag != null, bone):
                if gizmo_goal is goal:
                    preview <- chain_preview_of(c, goal)
            if mesh is m:
                if skinned is p:
                    return StudioScene::build_with(cam, c, m, p, frame_now(), flags, bone, &preview)
            return StudioScene::build_with(cam, c, empty_mesh, no_points, frame_now(), flags, bone, &preview)

        def present(i: i64, vp: Viewport::Viewport&, rect: UiHostedSurface::Rect) -> i32:
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            if i == 0:
                return UiAppKitCanvas::present_hosted(&shown0, 0, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)
            if i == 1:
                return UiAppKitCanvas::present_hosted(&shown1, 1, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)
            UiAppKitCanvas::present_hosted(&shown2, 2, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)

        # ---- lifecycle -------------------------------------------------
        def init() -> void:
            UiHandles::reset()
            init_accessibility_toolbar()
            initial: StackState::Stack = StudioModel::initial_stack()
            HistoryState::reset(&history, initial)
            history_ready <- true
            loaded: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(path):
                value: value
                error failure: GlbSkinMesh::empty()
            if GlbSkinMesh::vertex_count(&loaded) > 0:
                mesh <- loaded
            rebuild()
            if clip is c:
                timeline <- TimelineState::create(c.frames)
                bone <- StudioModel::default_bone(c)
                _ = puts("studio: clip loaded")
            else:
                timeline <- TimelineState::create(1)
                _ = puts("studio: clip not found; tried path / animation:")
                _ = puts(path)
                _ = puts(anim_name)
                _ = puts("studio: quote a path that contains spaces")
            view0 <- open_view(0)
            view1 <- open_view(1)
            view2 <- open_view(2)
            if view0 == null:
                status <- "no Metal device"
                nudged_row <- -1
                status_file <- null
            last_time <- UiAppKitCanvas::monotonic_time()

        def advance() -> void:
            now: f64 = UiAppKitCanvas::monotonic_time()
            elapsed: f64 = now - last_time
            last_time <- now
            if timeline is t:
                if t.playing:
                    # The timeline kernels count frames at Timeline::RATE;
                    # scale wall time so the clip plays at its own rate.
                    us: i64 = (elapsed * 1000000.0 * rate().f64() / Timeline::RATE.f64()).i64()
                    n: TimelineState::State = TimelineState::tick(t, us)
                    timeline <- n
                    if n.frame != drawn_frame:
                        revision <- revision + 1
                    UiCore::request_frame_after(0.008)

        # Shift-F overlay: the last rebuild's stage times and the last draw.
        def perf_panel(c: StudioModel::Clip&) -> void:
            x: f32 = 16.0
            y: f32 = 44.0
            StudioDraw::rect(x - 6.0, y - 4.0, 250.0, 96.0, StudioDraw::color(10, 12, 16))
            StudioDraw::text(x, y, 12.0, StudioText::number("evaluate us ", c.evaluate_us), StudioDraw::ink())
            StudioDraw::text(x, y + 15.0, 12.0, StudioText::number("detectors us ", c.detect_us), StudioDraw::ink())
            StudioDraw::text(x, y + 30.0, 12.0, StudioText::number("draw us ", draw_us), StudioDraw::ink())
            StudioDraw::text(x, y + 45.0, 12.0, StudioText::number("poses evaluated ", c.poses), StudioDraw::muted())
            StudioDraw::text(x, y + 60.0, 12.0, StudioText::number("ops rerun ", c.ops_run), StudioDraw::muted())
            StudioDraw::text(x, y + 75.0, 12.0, StudioText::number("drag bones moved ", preview_moved), StudioDraw::muted())

        def frame() -> void:
            draw_start: f64 = UiAppKitCanvas::monotonic_time()
            advance()
            if not framed and clip != null:
                framed <- true
                frame_all()
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            UiCore::clear(StudioDraw::color(17, 20, 27))
            s: StackState::Stack = current_stack()
            mutable cursor: i64 = 0
            mutable count: i64 = 1
            mutable can_undo: bool = false
            mutable can_redo: bool = false
            mutable is_dirty: bool = false
            if history_ready:
                cursor <- history.cursor
                count <- history.count
                can_undo <- HistoryPolicy::can_undo(history.cursor)
                can_redo <- HistoryPolicy::can_redo(history.cursor, history.count)
                is_dirty <- HistoryState::dirty(&history)
            if timeline is t:
                StudioPanels::toolbar(t, flags, can_undo, can_redo)
                StudioDraw::text(StudioPanels::button_x(StudioPanels::BUTTONS) + 8.0, 16.0, 12.0, "?  shortcuts", StudioDraw::muted())
                for i in 0..<3 |i|:
                    b: StudioPanels::Box = view_box(i)
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(38, 40, 46))
                if clip is c:
                    first: i64 = -1
                    last: i64 = -1
                    if StackState::valid(s, s.selected):
                        op: Ops::Operation = s.ops[s.selected]
                        StudioPanels::timeline(StudioPanels::timeline_box(w, h), c, t, op.first, op.last if op.last < c.frames else c.frames - 1)
                    else:
                        StudioPanels::timeline(StudioPanels::timeline_box(w, h), c, t, first, last)
                    StudioPanels::curves(StudioPanels::curve_box(w, h), c, bone, t.frame, curve_mode, &curve_memo, built)
                    perf_panel(c) if perf_overlay
                    StudioPanels::stack_panel(StudioPanels::sidebar_box(w, h), s, c, cursor, count)
                    contact_reset_available: bool = StudioContactEditor::selection_valid(contact_selected_side, contact_selected_frame, c.frames) and StackState::has_edit_at(s, contact_selected_side, contact_selected_frame)
                    StudioPanels::contact_editor_panel(StudioPanels::timeline_box(w, h),
                        contact_selected_side, contact_selected_frame, c.frames, contact_reset_available)
                    StudioPanels::foot_marks(StudioPanels::timeline_box(w, h), c, hover_row)
                    StudioPanels::contact_selection_marker(StudioPanels::timeline_box(w, h),
                        contact_selected_side, contact_selected_frame, c.frames)
                    StudioRetime::overlay(StudioPanels::timeline_box(w, h), c, &s, &selection, t.frame)
                    StudioRetime::controls(StudioPanels::curve_box(w, h), RetimeState::ready(&selection) or band_focus >= 0, retime_speed, typing, typed_view())
                    StudioPanels::cleanup_readout(StudioPanels::sidebar_box(w, h), c, readout_value(shown_slide, c.slide_after), readout_value(shown_sink, c.sink_after), readout_value(shown_hand_slide, c.hand_slide_after), s.blend)
                    StudioPanels::file_menu_panel(StudioPanels::sidebar_box(w, h), file_menu_open, true, file_menu_focus, file_menu_hover)
                    UiCore::request_frame_after(0.016) if readout_progress() < StudioFoot::FULL
                    drawn_frame <- t.frame
            screen: i64 = StudioChrome::chrome_screen(clip != null, load_failed)
            if screen != StudioChrome::SCREEN_EDIT:
                StudioPanels::guide(w, h, screen)
            StudioPanels::status_bar(StudioPanels::status_box(w, h), frame_now(), frames(), rate(), s.selected if StackState::valid(s, s.selected) else -1, gain_slide, gain_spikes, is_dirty, message(s))
            StudioPanels::tooltip(hover_button)
            StudioPanels::help_sheet(w, h) if help_open
            StudioPanels::replacement_prompt_panel(w, h, replacement_prompt_open, replacement_focus, replacement_save_failed, replacement_is_close, replacement_is_termination)
            StudioPanels::legacy_session_prompt_panel(w, h, legacy_prompt_open, legacy_prompt_focus)
            if export_review_open and clip is c:
                StudioPanels::export_review_panel(w, h, true, export_review_path, anim_name, c, s,
                    current_export_warnings(), export_review_acknowledged, export_review_focus,
                    export_review_warning_selected)
            if export_warning_detail_open and clip is c:
                StudioPanels::export_warning_detail_panel(w, h, true, c,
                    current_export_warning_kind(export_warning_detail_index),
                    export_warning_detail_index, current_export_warnings(),
                    export_warning_detail_focus)
            if export_path_inspector_open:
                StudioPanels::export_path_inspector_panel(w, h, true, export_review_path,
                    export_path_inspector_page, export_path_inspector_focus)
            if export_result_open:
                StudioPanels::export_result_panel(w, h, true, export_result_path, export_result_focus)
            if screen == StudioChrome::SCREEN_EDIT and not help_open and not file_menu_open and not replacement_prompt_open and not legacy_prompt_open:
                if timeline is current_timeline:
                    publish_accessibility(w, h, s, current_timeline)
            scale: f32 = UiAppKitCanvas::backing_scale()
            sync_view(0, scale)
            sync_view(1, scale)
            sync_view(2, scale)
            draw_us <- ((UiAppKitCanvas::monotonic_time() - draw_start) * 1000000.0).i64()

        # Status message, with the live value of a running drag or the
        # parameter just nudged, in its unit.
        def message(s: StackState::Stack&) -> sview:
            if gizmo_drag != null and readout_angle >= 0:
                StudioText::begin()
                StudioText::put("rotate ")
                StudioText::put_i(readout_angle / 10)
                StudioText::put(".")
                StudioText::put_i(readout_angle % 10)
                StudioText::put("°   move ")
                StudioText::put_i(readout_mm)
                StudioText::put(" mm   (Esc cancels)")
                return StudioText::view()
            if nudged_row == -2:
                StudioText::begin()
                StudioText::put("blend ")
                StudioPanels::frames_put(s.blend)
                return StudioText::view()
            if nudged_row >= 0 and StackState::valid(s, nudged_row):
                op: Ops::Operation = s.ops[nudged_row]
                StudioText::begin()
                StudioText::put(StackState::kind_label(op.kind))
                StudioText::put(": ")
                StudioPanels::param_put(op)
                return StudioText::view()
            if status_file is file:
                StudioText::begin()
                StudioText::put(status)
                StudioText::put(" ")
                StudioPanels::file_name_put(file)
                return StudioText::view()
            return status

        def init_accessibility_toolbar() -> void:
            UiFlat::reset()
            transparent: UiCore::Color = UiCore::Color{r: 0, g: 0, b: 0, a: 0}
            for action in 0..<StudioPanels::BUTTONS:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0,
                    transparent, transparent, transparent)
                return if widget == UiFlat::NONE or widget != action.usize()
                accessibility_toolbar_widgets[action.usize()] <- widget
            accessibility_toolbar_ready <- true
            accessibility_review_ack_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_destination_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_cancel_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_review_export_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            mutable warning_widgets_ready: bool = true
            for index in 0..<StudioExportReview::MAX_WARNINGS |index, warning_widgets_ready, transparent|:
                widget: usize = UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
                accessibility_review_warning_widgets[index.usize()] <- widget
                warning_widgets_ready <- false if widget == UiFlat::NONE
            accessibility_review_ready <- accessibility_review_ack_widget != UiFlat::NONE and accessibility_review_destination_widget != UiFlat::NONE and accessibility_review_cancel_widget != UiFlat::NONE and accessibility_review_export_widget != UiFlat::NONE and warning_widgets_ready
            accessibility_warning_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_warning_ready <- accessibility_warning_previous_widget != UiFlat::NONE and accessibility_warning_next_widget != UiFlat::NONE and accessibility_warning_done_widget != UiFlat::NONE
            accessibility_path_previous_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_next_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_path_ready <- accessibility_path_previous_widget != UiFlat::NONE and accessibility_path_next_widget != UiFlat::NONE and accessibility_path_done_widget != UiFlat::NONE
            accessibility_result_open_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_folder_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_done_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_result_ready <- accessibility_result_open_widget != UiFlat::NONE and accessibility_result_folder_widget != UiFlat::NONE and accessibility_result_done_widget != UiFlat::NONE
            accessibility_contact_plant_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_lift_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_reset_widget <- UiFlat::button(UiFlat::NONE, 1.0, 1.0, transparent, transparent, transparent)
            accessibility_contact_ready <- accessibility_contact_plant_widget != UiFlat::NONE and accessibility_contact_lift_widget != UiFlat::NONE and accessibility_contact_reset_widget != UiFlat::NONE

        def toolbar_accessibility_role(action: i64) -> UiCore::AccessibilityRole:
            return UiCore::AccessibilityRole.CheckBox if action == StudioPanels::A_LOOP or action == StudioPanels::A_TRAILS or action == StudioPanels::A_CONTACTS or action == StudioPanels::A_HEAT or action == StudioPanels::A_ONION or action == StudioPanels::A_GHOST or action == StudioPanels::A_XRAY or action == StudioPanels::A_MESH or action == StudioPanels::A_BALANCE
            UiCore::AccessibilityRole.Button

        def toolbar_accessibility_enabled(action: i64, can_undo: bool, can_redo: bool) -> bool:
            return can_undo if action == StudioPanels::A_UNDO
            return can_redo if action == StudioPanels::A_REDO
            true

        def toolbar_accessibility_value(action: i64, t: TimelineState::State&) -> sview:
            return TimelineState::speed_label(t.divisor) if action == StudioPanels::A_SPEED
            return "Playing" if t.playing and action == StudioPanels::A_PLAY
            return "Paused" if action == StudioPanels::A_PLAY
            ""

        def toolbar_accessibility_selected(action: i64, flags: i64, t: TimelineState::State&) -> bool:
            return StudioPanels::lit(action, flags, t) if toolbar_accessibility_role(action) == UiCore::AccessibilityRole.CheckBox
            false

        def toolbar_accessibility_action(widget: usize, event: i32) -> void:
            if accessibility_contact_ready and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_contact_plant_widget:
                    contact_apply(StudioContactEditor::PLANT)
                    return
                elif widget == accessibility_contact_lift_widget:
                    contact_apply(StudioContactEditor::LIFT)
                    return
                elif widget == accessibility_contact_reset_widget:
                    contact_apply(StudioContactEditor::RESET)
                    return
            if accessibility_warning_ready and export_warning_detail_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_warning_previous_widget:
                    activate_export_warning_detail(StudioExportPathReview::PREVIOUS)
                    return
                elif widget == accessibility_warning_next_widget:
                    activate_export_warning_detail(StudioExportPathReview::NEXT)
                    return
                elif widget == accessibility_warning_done_widget:
                    activate_export_warning_detail(StudioExportPathReview::DONE)
                    return
            if accessibility_path_ready and export_path_inspector_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_path_previous_widget:
                    activate_export_path_inspector(StudioExportPathReview::PREVIOUS)
                    return
                elif widget == accessibility_path_next_widget:
                    activate_export_path_inspector(StudioExportPathReview::NEXT)
                    return
                elif widget == accessibility_path_done_widget:
                    activate_export_path_inspector(StudioExportPathReview::DONE)
                    return
            if accessibility_result_ready and export_result_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_result_open_widget:
                    activate_export_result(StudioExportResult::OPEN)
                    return
                elif widget == accessibility_result_folder_widget:
                    activate_export_result(StudioExportResult::SHOW_IN_FOLDER)
                    return
                elif widget == accessibility_result_done_widget:
                    activate_export_result(StudioExportResult::DONE)
                    return
            if accessibility_review_ready and export_review_open and event == UiConst::WidgetEvent.Click.i32():
                if widget == accessibility_review_ack_widget:
                    activate_export_review(StudioExportReview::ACKNOWLEDGE)
                    return
                elif widget == accessibility_review_destination_widget:
                    activate_export_review(StudioExportReview::DESTINATION)
                    return
                elif widget == accessibility_review_cancel_widget:
                    activate_export_review(StudioExportReview::CANCEL)
                    return
                elif widget == accessibility_review_export_widget:
                    activate_export_review(StudioExportReview::EXPORT)
                    return
                for index in 0..<current_export_warnings() |index, widget|:
                    if widget == accessibility_review_warning_widgets[index.usize()]:
                        open_export_warning_detail(index)
                        return
            return if not accessibility_toolbar_ready or event != UiConst::WidgetEvent.Click.i32()
            action: i64 = StudioAccessibility::toolbar_action_for_widget(widget)
            toolbar_action(action) if action >= 0

        # Publish stable region landmarks and actionable toolbar controls.
        def accessibility_node(role: UiCore::AccessibilityRole, label: sview, help_text: sview, b: StudioPanels::Box, id: usize, parent_id: usize, first_child_id: usize, next_sibling_id: usize, action: usize, enabled: bool, selected: bool, text_value: sview) -> void:
            selected_warning_node: bool = export_review_open and current_export_warnings() > 0 and id == StudioAccessibility::export_review_warning_id(export_review_warning_selected)
            detail_control_focused: bool = (id == StudioAccessibility::WARNING_DETAIL_PREVIOUS and export_warning_detail_focus == StudioExportPathReview::PREVIOUS) or (id == StudioAccessibility::WARNING_DETAIL_NEXT and export_warning_detail_focus == StudioExportPathReview::NEXT) or (id == StudioAccessibility::WARNING_DETAIL_DONE and export_warning_detail_focus == StudioExportPathReview::DONE)
            focused: bool = (export_review_open and ((id == StudioAccessibility::REVIEW_ACKNOWLEDGEMENT and export_review_focus == StudioExportReview::ACKNOWLEDGE) or (id == StudioAccessibility::REVIEW_DESTINATION and export_review_focus == StudioExportReview::DESTINATION) or (id == StudioAccessibility::REVIEW_CANCEL and export_review_focus == StudioExportReview::CANCEL) or (id == StudioAccessibility::REVIEW_EXPORT and export_review_focus == StudioExportReview::EXPORT) or (selected_warning_node and export_review_focus == StudioExportReview::INSPECT_WARNINGS))) or (export_warning_detail_open and detail_control_focused) or (export_path_inspector_open and ((id == StudioAccessibility::PATH_PREVIOUS and export_path_inspector_focus == StudioExportPathReview::PREVIOUS) or (id == StudioAccessibility::PATH_NEXT and export_path_inspector_focus == StudioExportPathReview::NEXT) or (id == StudioAccessibility::PATH_DONE and export_path_inspector_focus == StudioExportPathReview::DONE))) or (export_result_open and ((id == StudioAccessibility::RESULT_OPEN and export_result_focus == StudioExportResult::OPEN) or (id == StudioAccessibility::RESULT_SHOW_IN_FOLDER and export_result_focus == StudioExportResult::SHOW_IN_FOLDER) or (id == StudioAccessibility::RESULT_DONE and export_result_focus == StudioExportResult::DONE)))
            UiCore::accessibility_with_metadata(role, label, help_text,
                UiCore::Rect(b.x, b.y, b.w, b.h), id, action,
                enabled, focused, selected, 0.0,
                text_value, "", revision.usize(), 0, 0, parent_id,
                first_child_id, next_sibling_id, 0.0, 1.0, false)

        def publish_export_review_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_review_ready
            if clip is c:
                none: usize = StudioAccessibility::NO_NODE
                warnings: i64 = current_export_warnings()
                dialog: StudioPanels::Box = StudioPanels::export_review_dialog_box(w, h)
                accessibility_node(UiCore::AccessibilityRole.Dialog,
                    "Review cleaned export",
                    "Review the destination, retained animation details, cleanup steps, and quality notes before exporting.",
                    dialog, StudioAccessibility::EXPORT_REVIEW, none,
                    StudioAccessibility::export_review_first_child(warnings), none,
                    none, true, false, "")
                if warnings > 0:
                    mutable acknowledgement: sview = "Not acknowledged"
                    acknowledgement <- "Acknowledged" if export_review_acknowledged
                    accessibility_node(UiCore::AccessibilityRole.CheckBox,
                        "I reviewed the quality notes",
                        "Required before exporting while quality warnings are present.",
                        StudioPanels::export_review_ack_box(w, h),
                        StudioAccessibility::REVIEW_ACKNOWLEDGEMENT,
                        StudioAccessibility::EXPORT_REVIEW,
                        none, StudioAccessibility::export_review_next_sibling(
                            StudioAccessibility::REVIEW_ACKNOWLEDGEMENT, warnings),
                        accessibility_review_ack_widget, true,
                        export_review_acknowledged, acknowledgement)
                for index in 0..<warnings |index, w, h, warnings|:
                    kind: i64 = current_export_warning_kind(index)
                    id: usize = StudioAccessibility::export_review_warning_id(index)
                    accessibility_node(UiCore::AccessibilityRole.Button,
                        StudioPanels::export_warning_detail_title(kind),
                        "Open the before/after metric and available frame evidence for this warning.",
                        StudioPanels::export_review_warning_box(w, h, index),
                        id, StudioAccessibility::EXPORT_REVIEW, none,
                        StudioAccessibility::export_review_next_sibling(id, warnings),
                        accessibility_review_warning_widgets[index.usize()], true,
                        false, StudioPanels::export_warning_detail_metric(c, kind))
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Inspect full destination path",
                    "Open a read-only view of the entire export destination.",
                    StudioPanels::export_review_destination_box(w, h),
                    StudioAccessibility::REVIEW_DESTINATION,
                    StudioAccessibility::EXPORT_REVIEW,
                    none, StudioAccessibility::export_review_next_sibling(
                        StudioAccessibility::REVIEW_DESTINATION, warnings),
                    accessibility_review_destination_widget, true, false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Cancel export review", "Close this review without writing a file.",
                    StudioPanels::export_review_button_box(w, h, StudioExportReview::CANCEL),
                    StudioAccessibility::REVIEW_CANCEL, StudioAccessibility::EXPORT_REVIEW,
                    none, StudioAccessibility::REVIEW_EXPORT,
                    accessibility_review_cancel_widget, true, false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Export GLB", "Write and validate the cleaned GLB at the displayed destination.",
                    StudioPanels::export_review_button_box(w, h, StudioExportReview::EXPORT),
                    StudioAccessibility::REVIEW_EXPORT, StudioAccessibility::EXPORT_REVIEW,
                    none, none, accessibility_review_export_widget,
                    StudioExportReview::export_enabled(warnings, export_review_acknowledged),
                    false, "")

        def publish_contact_editor_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_contact_ready
            if clip is c:
                valid: bool = StudioContactEditor::selection_valid(
                    contact_selected_side, contact_selected_frame, c.frames)
                UiFlat::set_enabled(accessibility_contact_plant_widget, valid)
                UiFlat::set_enabled(accessibility_contact_lift_widget, valid)
                mutable current: StackState::Stack = current_stack()
                reset_enabled: bool = valid and StackState::has_edit_at(current, contact_selected_side, contact_selected_frame)
                UiFlat::set_enabled(accessibility_contact_reset_widget, reset_enabled)
                none: usize = StudioAccessibility::NO_NODE
                next: usize = StudioAccessibility::CONTACT_EDITOR_LIFT
                mutable value: sview = "Select a contact row and frame first"
                if valid:
                    StudioText::begin()
                    StudioText::put(StudioPanels::contact_side_label(contact_selected_side))
                    StudioText::put(" frame ")
                    StudioText::put_i(contact_selected_frame + 1)
                    value <- StudioText::view()
                tb: StudioPanels::Box = StudioPanels::timeline_box(w, h)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Plant selected contact frame",
                    "Override automatic contact detection as planted on the selected frame. This edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::PLANT),
                    StudioAccessibility::CONTACT_EDITOR_PLANT,
                    StudioAccessibility::TIMELINE, none, next,
                    accessibility_contact_plant_widget, valid, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Lift selected contact frame",
                    "Override automatic contact detection as lifted on the selected frame. This edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::LIFT),
                    StudioAccessibility::CONTACT_EDITOR_LIFT,
                    StudioAccessibility::TIMELINE, none, StudioAccessibility::CONTACT_EDITOR_RESET,
                    accessibility_contact_lift_widget, valid, false, value)
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Reset selected contact frame to automatic detection",
                    "Remove authored contact overrides from only this output frame so the detector's result is used. The edit is undoable and saved with the session.",
                    StudioPanels::contact_editor_button_box(tb, StudioContactEditor::RESET),
                    StudioAccessibility::CONTACT_EDITOR_RESET,
                    StudioAccessibility::TIMELINE, none, none,
                    accessibility_contact_reset_widget, reset_enabled, false, value)

        def publish_export_warning_detail_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_warning_ready
            if clip is c:
                none: usize = StudioAccessibility::NO_NODE
                dialog: StudioPanels::Box = StudioPanels::export_warning_detail_dialog_box(w, h)
                kind: i64 = current_export_warning_kind(export_warning_detail_index)
                StudioText::begin()
                StudioText::put("Details for ")
                StudioText::put(StudioPanels::export_warning_detail_title(kind))
                accessibility_node(UiCore::AccessibilityRole.Dialog,
                    StudioText::view(),
                    "The export review stays open behind this read-only metric detail.",
                    dialog, StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_first_child(), none,
                    none, true, false, "")
                accessibility_node(UiCore::AccessibilityRole.Label,
                    "Before and after metric", "The warning's matching export metric.",
                    StudioPanels::box(dialog.x + 24.0, dialog.y + 56.0, dialog.w - 48.0, 28.0),
                    StudioAccessibility::WARNING_DETAIL_METRIC,
                    StudioAccessibility::WARNING_DETAIL,
                    none, StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_METRIC),
                    none, true, false, StudioPanels::export_warning_detail_metric(c, kind))
                accessibility_node(UiCore::AccessibilityRole.Label,
                    "Available frame evidence",
                    "Frame evidence is shown only when the retained data supports it.",
                    StudioPanels::box(dialog.x + 24.0, dialog.y + 96.0, dialog.w - 48.0, 42.0),
                    StudioAccessibility::WARNING_DETAIL_EVIDENCE,
                    StudioAccessibility::WARNING_DETAIL,
                    none, StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_EVIDENCE),
                    none, true, false, StudioPanels::export_warning_detail_evidence(c, kind))
                previous_enabled: bool = StudioExportPathReview::enabled(
                    StudioExportPathReview::PREVIOUS, export_warning_detail_index,
                    current_export_warnings())
                next_enabled: bool = StudioExportPathReview::enabled(
                    StudioExportPathReview::NEXT, export_warning_detail_index,
                    current_export_warnings())
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Previous warning", "Show the previous export warning.",
                    StudioPanels::export_warning_detail_button_box(w, h,
                        StudioExportPathReview::PREVIOUS),
                    StudioAccessibility::WARNING_DETAIL_PREVIOUS,
                    StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_PREVIOUS),
                    accessibility_warning_previous_widget, previous_enabled,
                    false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Next warning", "Show the next export warning.",
                    StudioPanels::export_warning_detail_button_box(w, h,
                        StudioExportPathReview::NEXT),
                    StudioAccessibility::WARNING_DETAIL_NEXT,
                    StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_NEXT),
                    accessibility_warning_next_widget, next_enabled,
                    false, "")
                accessibility_node(UiCore::AccessibilityRole.Button,
                    "Return to export review",
                    "Close warning details while preserving the destination and acknowledgement.",
                    StudioPanels::export_warning_detail_button_box(w, h,
                        StudioExportPathReview::DONE),
                    StudioAccessibility::WARNING_DETAIL_DONE,
                    StudioAccessibility::WARNING_DETAIL, none,
                    StudioAccessibility::warning_detail_next_sibling(
                        StudioAccessibility::WARNING_DETAIL_DONE),
                    accessibility_warning_done_widget, true, false, "")

        def publish_export_path_inspector_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_path_ready
            none: usize = StudioAccessibility::NO_NODE
            pages: i64 = StudioPanels::export_path_pages(export_review_path)
            visible_lines: i64 = StudioPanels::export_path_visible_lines(
                export_review_path, export_path_inspector_page)
            dialog: StudioPanels::Box = StudioPanels::export_path_inspector_dialog_box(w, h)
            accessibility_node(UiCore::AccessibilityRole.Dialog,
                "Full export destination",
                "Read the complete destination path across the displayed path lines. Previous and Next show the adjacent page.",
                dialog, StudioAccessibility::EXPORT_REVIEW, none,
                StudioAccessibility::export_path_inspector_first_child(), none,
                none, true, false, "")
            for row in 0..<visible_lines |row, w, h, dialog, export_path_inspector_page, export_review_path, visible_lines|:
                id: usize = StudioAccessibility::PATH_LINE_FIRST + row.usize()
                next: usize = StudioAccessibility::export_path_inspector_next_sibling(id, visible_lines)
                line_box: StudioPanels::Box = StudioPanels::box(dialog.x + 24.0,
                    dialog.y + 76.0 + row.f32() * 49.0, dialog.w - 48.0, 38.0)
                label: sview = StudioText::number("Path line ", row + 1)
                accessibility_node(UiCore::AccessibilityRole.Label, label,
                    "Read-only exact segment of the export destination.", line_box,
                    id, StudioAccessibility::EXPORT_REVIEW, none, next, none,
                    true, false, StudioPanels::export_path_line(export_review_path,
                        export_path_inspector_page, row))
            prev_enabled: bool = StudioExportPathReview::enabled(
                StudioExportPathReview::PREVIOUS, export_path_inspector_page, pages)
            next_enabled: bool = StudioExportPathReview::enabled(
                StudioExportPathReview::NEXT, export_path_inspector_page, pages)
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Previous path page", "Show the previous destination path page.",
                StudioPanels::export_path_inspector_button_box(w, h, StudioExportPathReview::PREVIOUS),
                StudioAccessibility::PATH_PREVIOUS, StudioAccessibility::EXPORT_REVIEW,
                none, StudioAccessibility::PATH_NEXT, accessibility_path_previous_widget,
                prev_enabled, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Next path page", "Show the next destination path page.",
                StudioPanels::export_path_inspector_button_box(w, h, StudioExportPathReview::NEXT),
                StudioAccessibility::PATH_NEXT, StudioAccessibility::EXPORT_REVIEW,
                none, StudioAccessibility::PATH_DONE, accessibility_path_next_widget,
                next_enabled, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Done", "Return to the export review without changing its destination or acknowledgement.",
                StudioPanels::export_path_inspector_button_box(w, h, StudioExportPathReview::DONE),
                StudioAccessibility::PATH_DONE, StudioAccessibility::EXPORT_REVIEW,
                none, none, accessibility_path_done_widget, true, false, "")

        def publish_export_result_accessibility(w: f32, h: f32) -> void:
            return if not accessibility_result_ready
            none: usize = StudioAccessibility::NO_NODE
            dialog: StudioPanels::Box = StudioPanels::export_result_dialog_box(w, h)
            accessibility_node(UiCore::AccessibilityRole.Dialog,
                "Export complete",
                "The cleaned GLB was published and validated. Choose Open Result, Show in Folder, or Done.",
                dialog, StudioAccessibility::EXPORT_RESULT, none,
                StudioAccessibility::export_result_first_child(), none,
                none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Open Result", "Open the committed GLB in your default application.",
                StudioPanels::export_result_button_box(w, h, StudioExportResult::OPEN),
                StudioAccessibility::RESULT_OPEN, StudioAccessibility::EXPORT_RESULT,
                none, StudioAccessibility::RESULT_SHOW_IN_FOLDER,
                accessibility_result_open_widget, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Show in Folder", "Reveal the committed GLB in Finder.",
                StudioPanels::export_result_button_box(w, h, StudioExportResult::SHOW_IN_FOLDER),
                StudioAccessibility::RESULT_SHOW_IN_FOLDER, StudioAccessibility::EXPORT_RESULT,
                none, StudioAccessibility::RESULT_DONE,
                accessibility_result_folder_widget, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Button,
                "Done", "Close the result panel and return to Studio.",
                StudioPanels::export_result_button_box(w, h, StudioExportResult::DONE),
                StudioAccessibility::RESULT_DONE, StudioAccessibility::EXPORT_RESULT,
                none, none, accessibility_result_done_widget, true, false, "")

        def publish_toolbar_accessibility(t: TimelineState::State&, can_undo: bool, can_redo: bool) -> void:
            return if not accessibility_toolbar_ready
            none: usize = StudioAccessibility::NO_NODE
            for i in 0..<StudioPanels::BUTTONS |i, t|:
                widget: usize = accessibility_toolbar_widgets[i.usize()]
                enabled: bool = toolbar_accessibility_enabled(i, can_undo, can_redo)
                UiFlat::set_enabled(widget, enabled)
                id: usize = StudioAccessibility::toolbar_control_id(i)
                next: usize = StudioAccessibility::next_sibling(id)
                role: UiCore::AccessibilityRole = toolbar_accessibility_role(i)
                accessibility_node(role, StudioPanels::tip_of(i),
                    "Activate this toolbar action.", StudioPanels::button_box(i),
                    id, StudioAccessibility::TOOLBAR, none, next, widget,
                    enabled, toolbar_accessibility_selected(i, flags, t),
                    toolbar_accessibility_value(i, t))

        def publish_accessibility(w: f32, h: f32, s: StackState::Stack&, t: TimelineState::State&) -> void:
            none: usize = StudioAccessibility::NO_NODE
            return if not accessibility_toolbar_ready
            if export_warning_detail_open:
                publish_export_warning_detail_accessibility(w, h)
                return
            if export_path_inspector_open:
                publish_export_path_inspector_accessibility(w, h)
                return
            if export_result_open:
                publish_export_result_accessibility(w, h)
                return
            if export_review_open:
                publish_export_review_accessibility(w, h)
                return
            workspace: StudioPanels::Box = StudioPanels::box(0.0, 0.0, w, h)
            views: StudioPanels::Box = StudioPanels::box(StudioPanels::GAP,
                StudioPanels::TOOLBAR, StudioPanels::main_width(w),
                StudioPanels::views_height(h))
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Mocap Studio workspace",
                "Editing regions for inspecting and cleaning character motion.",
                workspace, StudioAccessibility::WORKSPACE, none,
                StudioAccessibility::TOOLBAR, none, none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Playback and editing toolbar",
                "Playback, undo, file, display, and cleanup actions.",
                StudioPanels::box(0.0, 0.0, w, StudioPanels::TOOLBAR),
                StudioAccessibility::TOOLBAR, StudioAccessibility::WORKSPACE,
                StudioAccessibility::toolbar_control_id(0),
                StudioAccessibility::VIEWPORTS, none, true, false, "")
            publish_toolbar_accessibility(t, HistoryPolicy::can_undo(history.cursor), HistoryPolicy::can_redo(history.cursor, history.count))
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Character views",
                "Perspective, front, and side views of the character.",
                views, StudioAccessibility::VIEWPORTS,
                StudioAccessibility::WORKSPACE, none,
                StudioAccessibility::CURVES, none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Motion curves",
                "Animation curves for the selected joint.",
                StudioPanels::curve_box(w, h), StudioAccessibility::CURVES,
                StudioAccessibility::WORKSPACE, none,
                StudioAccessibility::TIMELINE, none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Timeline and foot contacts",
                "Animation timeline, operation range, and foot contact markers.",
                StudioPanels::timeline_box(w, h), StudioAccessibility::TIMELINE,
                StudioAccessibility::WORKSPACE, StudioAccessibility::CONTACT_EDITOR_PLANT,
                StudioAccessibility::SIDEBAR, none, true, false, "")
            accessibility_node(UiCore::AccessibilityRole.Group,
                "Cleanup operations",
                "Operation stack, cleanup settings, and parameters.",
                StudioPanels::sidebar_box(w, h), StudioAccessibility::SIDEBAR,
                StudioAccessibility::WORKSPACE, none,
                StudioAccessibility::STATUS, none, true, false, "")
            publish_contact_editor_accessibility(w, h)
            accessibility_node(UiCore::AccessibilityRole.Status,
                "Studio status",
                "Current editing, cleanup, and playback status.",
                StudioPanels::status_box(w, h), StudioAccessibility::STATUS,
                StudioAccessibility::WORKSPACE, none, none, none, true, false,
                message(s))

        def camera_input(i: i64, dx: f32, dy: f32) -> void:
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                scale: f32 = UiAppKitCanvas::backing_scale()
                if drag_button == 0:
                    _ = ViewportCamera::orbit(&vp.camera, (dx * scale).i64(), (dy * scale).i64())
                else:
                    _ = ViewportCamera::pan(&vp.camera, dx * scale, dy * scale)
                Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                put_view(i, vp)
                UiCore::request_frame_after(0.001)

        def zoom(i: i64, notches: i64) -> void:
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                _ = ViewportCamera::zoom(&vp.camera, notches)
                Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                put_view(i, vp)
                UiCore::request_frame_after(0.001)

        # A click (no drag) in a view picks the joint under it.
        def pick(i: i64, x: f32, y: f32) -> void:
            if view(i) is opened:
                if clip is c:
                    b: StudioPanels::Box = view_box(i)
                    scale: f32 = UiAppKitCanvas::backing_scale()
                    hit: i64 = StudioScene::pick(opened.camera, c, frame_now(), flags, (x - b.x) * scale, (y - b.y) * scale)
                    if hit >= 0:
                        bone <- hit
                        status <- "bone selected"
                        nudged_row <- -1
                        status_file <- null
                        touch()

        def toolbar_action(a: i64) -> void:
            if a == StudioPanels::A_PLAY:
                toggle_play()
            elif a == StudioPanels::A_BACK:
                step_frames(-1)
            elif a == StudioPanels::A_FORWARD:
                step_frames(1)
            elif a == StudioPanels::A_SPEED:
                cycle_speed()
            elif a == StudioPanels::A_LOOP:
                toggle_loop()
            elif a == StudioPanels::A_UNDO:
                undo()
            elif a == StudioPanels::A_REDO:
                redo()
            elif a == StudioPanels::A_TRAILS:
                toggle_flag(StudioScene::TRAILS)
            elif a == StudioPanels::A_CONTACTS:
                toggle_flag(StudioScene::CONTACTS)
            elif a == StudioPanels::A_HEAT:
                toggle_flag(StudioScene::HEAT)
            elif a == StudioPanels::A_ONION:
                toggle_flag(StudioScene::ONION)
            elif a == StudioPanels::A_GHOST:
                toggle_flag(StudioScene::GHOST)
            elif a == StudioPanels::A_XRAY:
                toggle_flag(StudioScene::XRAY)
            elif a == StudioPanels::A_MESH:
                toggle_flag(StudioScene::MESH)
                status <- ("mesh on" if StudioScene::on(flags, StudioScene::MESH) else "mesh off") if mesh != null else "mesh: no skinned mesh in this file"
                nudged_row <- -1
                status_file <- null
            elif a == StudioPanels::A_FRAME:
                frame_all()
            elif a == StudioPanels::A_OPEN:
                open_take()
            elif a == StudioPanels::A_EXPORT:
                request_export(export_path, false)
            elif a == StudioPanels::A_BALANCE:
                toggle_flag(StudioScene::BALANCE)
                if clip is c:
                    status <- StudioText::number("balance impossible frames: ", c.impossible_frames)
                    nudged_row <- -1
                    status_file <- null

        def pointer_down(x: f32, y: f32, button: i32) -> void:
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            down_x <- x
            down_y <- y
            last_x <- x
            last_y <- y
            if export_warning_detail_open:
                hit: i64 = StudioPanels::export_warning_detail_hit(w, h, x, y)
                warnings: i64 = current_export_warnings()
                if button == 0 and hit >= 0 and StudioExportPathReview::enabled(
                    hit, export_warning_detail_index, warnings):
                    export_warning_detail_focus <- hit
                    activate_export_warning_detail(hit)
                return
            if export_path_inspector_open:
                hit: i64 = StudioPanels::export_path_inspector_hit(w, h, x, y)
                pages: i64 = StudioPanels::export_path_pages(export_review_path)
                if button == 0 and hit >= 0 and StudioExportPathReview::enabled(hit, export_path_inspector_page, pages):
                    export_path_inspector_focus <- hit
                    activate_export_path_inspector(hit)
                return
            if export_result_open:
                hit: i64 = StudioPanels::export_result_hit(w, h, x, y)
                if button == 0 and hit >= 0:
                    export_result_focus <- hit
                    activate_export_result(hit)
                return
            if export_review_open:
                warning_index: i64 = StudioPanels::export_review_warning_index_at(
                    w, h, x, y, current_export_warnings())
                if button == 0 and warning_index >= 0:
                    open_export_warning_detail(warning_index)
                    return
                hit: i64 = StudioPanels::export_review_hit(w, h, x, y, current_export_warnings())
                if button == 0 and hit >= 0:
                    export_review_focus <- hit
                    activate_export_review(hit)
                return
            if legacy_prompt_open:
                index: i64 = StudioPanels::legacy_session_button_hit(w, h, x, y)
                if button == 0 and index >= 0:
                    resolve_legacy_session(StudioLegacyPrompt::LOAD if index == StudioLegacyPrompt::FOCUS_LOAD else StudioLegacyPrompt::CANCEL)
                return
            if replacement_prompt_open:
                index: i64 = StudioPanels::replacement_button_hit(w, h, x, y)
                if button == 0 and index >= 0:
                    mutable choice: i64 = StudioReplacement::SAVE
                    choice <- StudioReplacement::DISCARD if index == StudioReplacement::FOCUS_DISCARD
                    choice <- StudioReplacement::CANCEL if index == StudioReplacement::FOCUS_CANCEL
                    resolve_replacement(choice)
                return
            sb: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
            if file_menu_open:
                if StudioPanels::inside(StudioPanels::file_button_box(sb), x, y):
                    file_menu_open <- false
                    file_menu_hover <- -1
                    touch()
                    return
                if StudioPanels::file_popup_contains(sb, x, y):
                    activate_file_menu(StudioPanels::file_popup_row(sb, x, y)) if button == 0
                    return
                file_menu_open <- false
                file_menu_hover <- -1
                touch()
            a: i64 = StudioPanels::toolbar_hit(x, y)
            if a >= 0:
                toolbar_action(a)
                return
            tb: StudioPanels::Box = StudioPanels::timeline_box(w, h)
            if StudioPanels::inside(tb, x, y) and StudioPanels::contact_editor_contains(tb, x, y):
                contact_action: i64 = StudioPanels::contact_editor_hit(tb, x, y)
                contact_apply(contact_action) if button == 0 and contact_action >= 0
                return
            if button == 0:
                return if retime_down(tb, StudioPanels::curve_box(w, h), x, y)
            if StudioPanels::inside(tb, x, y) and button == 0:
                return if contact_down(x, y)
            if StudioPanels::inside(tb, x, y) or StudioPanels::inside(StudioPanels::curve_box(w, h), x, y):
                scrubbing <- true
                scrub_to(StudioPanels::timeline_frame(tb, x, frames()))
                return
            if StudioPanels::inside(sb, x, y):
                if clip != null and StudioPanels::inside(StudioPanels::file_button_box(sb), x, y) and button == 0:
                    file_menu_open <- true
                    file_menu_focus <- 0
                    file_menu_hover <- -1
                    help_open <- false
                    touch()
                    return
                s: StackState::Stack = current_stack()
                hit: i64 = StudioPanels::stack_hit(sb, s, x, y)
                if hit >= 0:
                    row_action(hit)
                return
            v: i64 = view_at(x, y)
            if v >= 0 and button == 0 and gizmo_mode >= 0:
                return if gizmo_press(v, x, y)
            if v >= 0:
                drag_view <- v
                drag_button <- button

        # Shift-drag selects, a band edge drags, a band click focuses it,
        # presets and the slider set the speed.
        def retime_down(tb: StudioPanels::Box, cb: StudioPanels::Box, x: f32, y: f32) -> bool:
            k: i64 = StudioRetime::preset_hit(cb, x, y)
            if k >= 0:
                retime_to(RetimeState::preset(k))
                return true
            if StudioPanels::inside(StudioRetime::slider_box(cb), x, y):
                slider_drag <- true
                slider_start_speed <- retime_speed
                retime_speed <- StudioRetime::slider_speed(cb, x)
                touch()
                return true
            return false if not StudioPanels::inside(tb, x, y)
            f: i64 = StudioPanels::timeline_frame(tb, x, frames())
            if StudioShortcuts::shift(modifiers):
                selection <- RetimeState::begin(f)
                selecting <- true
                touch()
                return true
            if clip is c:
                if StudioRetime::band_row(tb, y):
                    s: StackState::Stack = current_stack()
                    src: i64 = StudioModel::source_frame(c, f)
                    reach: i64 = 1 + c.source_frames / 200
                    edge_drag <- RetimeState::edge_near(&s, src, reach)
                    band_focus <- edge_drag.band if edge_drag.band >= 0 else StackState::band_at(&s, src)
                    if band_focus >= 0:
                        retime_speed <- s.bands[band_focus].speed
                        status <- "retime band (Del removes, presets set speed)"
                        touch()
                        return true
            return false

        def pointer_move(x: f32, y: f32) -> void:
            if export_warning_detail_open:
                hit: i64 = StudioPanels::export_warning_detail_hit(
                    UiCore::viewport_width(), UiCore::viewport_height(), x, y)
                warnings: i64 = current_export_warnings()
                if hit >= 0 and StudioExportPathReview::enabled(
                    hit, export_warning_detail_index, warnings) and hit != export_warning_detail_focus:
                    export_warning_detail_focus <- hit
                    touch()
                return
            if export_path_inspector_open:
                hit: i64 = StudioPanels::export_path_inspector_hit(UiCore::viewport_width(), UiCore::viewport_height(), x, y)
                pages: i64 = StudioPanels::export_path_pages(export_review_path)
                if hit >= 0 and StudioExportPathReview::enabled(hit, export_path_inspector_page, pages) and hit != export_path_inspector_focus:
                    export_path_inspector_focus <- hit
                    touch()
                return
            if export_result_open:
                hit: i64 = StudioPanels::export_result_hit(UiCore::viewport_width(), UiCore::viewport_height(), x, y)
                if hit >= 0 and hit != export_result_focus:
                    export_result_focus <- hit
                    touch()
                return
            if export_review_open:
                w: f32 = UiCore::viewport_width()
                h: f32 = UiCore::viewport_height()
                warning_index: i64 = StudioPanels::export_review_warning_index_at(
                    w, h, x, y, current_export_warnings())
                if warning_index >= 0 and (warning_index != export_review_warning_selected or export_review_focus != StudioExportReview::INSPECT_WARNINGS):
                    export_review_warning_selected <- warning_index
                    export_review_focus <- StudioExportReview::INSPECT_WARNINGS
                    touch()
                else:
                    hit: i64 = StudioPanels::export_review_hit(w, h, x, y, current_export_warnings())
                    if hit >= 0 and hit != export_review_focus:
                        export_review_focus <- hit
                        touch()
                return
            if legacy_prompt_open:
                index: i64 = StudioPanels::legacy_session_button_hit(UiCore::viewport_width(), UiCore::viewport_height(), x, y)
                if index >= 0 and index != legacy_prompt_focus:
                    legacy_prompt_focus <- index
                    touch()
                return
            if replacement_prompt_open:
                index: i64 = StudioPanels::replacement_button_hit(UiCore::viewport_width(), UiCore::viewport_height(), x, y)
                if index >= 0 and index != replacement_focus:
                    replacement_focus <- index
                    touch()
                return
            if file_menu_open:
                sb: StudioPanels::Box = StudioPanels::sidebar_box(UiCore::viewport_width(), UiCore::viewport_height())
                row: i64 = StudioPanels::file_popup_row(sb, x, y)
                if row != file_menu_hover:
                    file_menu_hover <- row
                    if row >= 0 and StudioFilePolicy::enabled(StudioFilePolicy::action(row), clip != null):
                        file_menu_focus <- row
                    touch()
                return
            over: i64 = StudioPanels::toolbar_hit(x, y)
            if over != hover_button:
                hover_button <- over
                touch()
            if selecting or slider_drag:
                w: f32 = UiCore::viewport_width()
                h: f32 = UiCore::viewport_height()
                if selecting:
                    selection <- RetimeState::drag(selection, StudioPanels::timeline_frame(StudioPanels::timeline_box(w, h), x, frames()))
                else:
                    retime_speed <- StudioRetime::slider_speed(StudioPanels::curve_box(w, h), x)
                touch()
                return
            tbh: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            timeline_strip: StudioPanels::Box = StudioPanels::strip(tbh)
            row: i64 = StudioPanels::contact_row(tbh, y) if StudioPanels::inside(timeline_strip, x, y) else -1
            if row != hover_row:
                hover_row <- row
                touch()
            if gizmo_view >= 0:
                gizmo_preview(x, y)
                last_x <- x
                last_y <- y
                return
            if scrubbing:
                tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
                scrub_to(StudioPanels::timeline_frame(tb, x, frames()))
            elif drag_view >= 0:
                camera_input(drag_view, x - last_x, y - last_y)
            last_x <- x
            last_y <- y

        def pointer_up(x: f32, y: f32) -> void:
            return if export_result_open
            return if export_review_open
            return if legacy_prompt_open
            if selecting:
                selecting <- false
                selection <- RetimeState::none() if not RetimeState::ready(&selection) else selection
                status <- "range selected: preset, slider or = to set speed, Esc cancels" if selection.active else status
                touch()
                return
            if slider_drag:
                slider_drag <- false
                retime_to(retime_speed)
                return
            if edge_drag.band >= 0:
                if clip is c:
                    tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
                    src: i64 = StudioModel::source_frame(c, StudioPanels::timeline_frame(tb, x, frames()))
                    mutable s: StackState::Stack = current_stack()
                    if StackState::move_band_edge(&s, edge_drag.band, edge_drag.last_edge, src, c.source_frames):
                        commit(s, true)
                        status <- "retime band edge moved"
                edge_drag <- RetimeState::no_drag()
                return
            if FootState::active(&foot_press):
                contact_up(x)
                return
            if gizmo_view >= 0:
                gizmo_release(x, y)
                return
            if drag_view >= 0 and drag_button == 0:
                moved: f32 = (x - down_x) * (x - down_x) + (y - down_y) * (y - down_y)
                if moved < 9.0:
                    pick(drag_view, x, y)
            drag_view <- -1
            drag_button <- -1
            scrubbing <- false

        # ---- gizmo (Phase 3 corrections) ---------------------------------
        def active_handle() -> i64:
            if gizmo_drag is d:
                return d.handle
            GizmoPolicy::NONE

        def set_gizmo(mode: i64) -> void:
            gizmo_mode <- -1 if gizmo_mode == mode else mode
            gizmo_view <- -1
            gizmo_drag <- null
            status <- ("gizmo: rotate (drag a ring)" if gizmo_mode == GizmoPolicy::ROTATE else "gizmo: translate (drag an arrow)") if gizmo_mode >= 0 else "gizmo off"
            nudged_row <- -1
            status_file <- null
            touch()

        # Pixel of window point (x, y) in view `i`.
        def view_px(i: i64, x: f32) -> f32:
            b: StudioPanels::Box = view_box(i)
            (x - b.x) * UiAppKitCanvas::backing_scale()

        def view_py(i: i64, y: f32) -> f32:
            b: StudioPanels::Box = view_box(i)
            (y - b.y) * UiAppKitCanvas::backing_scale()

        # Start a gizmo drag when (x, y) hits a handle of the selected bone.
        def gizmo_press(i: i64, x: f32, y: f32) -> bool:
            if view(i) is opened:
                if clip is c:
                    return false if bone < 0
                    g: ViewportGizmo::Gizmo = StudioScene::gizmo_for(c, frame_now(), bone, gizmo_mode)
                    handle: i64 = ViewportGizmo::pick(&opened.camera, &g, view_px(i, x), view_py(i, y))
                    return false if handle == GizmoPolicy::NONE
                    r: PoseOverride::Rig = StudioModel::rig(c)
                    held: PoseOverride::Overrides = PoseOverride::overrides(&r)
                    mutable d: ViewportGizmo::Drag = ViewportGizmo::idle()
                    ok: bool = catch ViewportGizmo::begin(&d, &opened.camera, &g, handle, view_px(i, x), view_py(i, y), &held, &r, bone.usize(), StudioScene::bone_model(c, frame_now(), bone)):
                        value: value
                        error failure: false
                    return false if not ok
                    gizmo_drag <- d
                    gizmo_view <- i
                    status <- "gizmo drag"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return true
            false

        # Track the drag goal so the scene draws the live preview.
        def gizmo_preview(x: f32, y: f32) -> void:
            i: i64 = gizmo_view
            if gizmo_drag is d:
                if view(i) is opened:
                    goal: Geometry::Transform = ViewportGizmo::goal(d, &opened.camera, view_px(i, x), view_py(i, y))
                    gizmo_goal <- goal
                    if clip is c:
                        r: PoseOverride::Rig = StudioModel::rig(c)
                        fix: Corrections::Correction = StudioModel::correction_for(c, r, bone, frame_now(), goal)
                        readout_angle <- StudioReadout::angle_tenths(fix.rotation)
                        readout_mm <- StudioReadout::millimetres(fix.translation)
                    touch()

        # Key the dragged pose at the current frame as a correction.
        def gizmo_release(x: f32, y: f32) -> void:
            i: i64 = gizmo_view
            gizmo_view <- -1
            if gizmo_drag is d:
                if view(i) is opened:
                    if clip is c:
                        goal: Geometry::Transform = ViewportGizmo::goal(d, &opened.camera, view_px(i, x), view_py(i, y))
                        r: PoseOverride::Rig = StudioModel::rig(c)
                        fix: Corrections::Correction = StudioModel::correction_for(c, r, bone, frame_now(), goal)
                        mutable s: StackState::Stack = current_stack()
                        if StackState::add_fix(&s, fix):
                            commit(s, true)
                            status <- "correction keyed"
                            nudged_row <- -1
                            status_file <- null
                        else:
                            status <- "corrections full (16)"
                            nudged_row <- -1
                            status_file <- null
            gizmo_drag <- null
            gizmo_goal <- null
            readout_angle <- -1
            readout_mm <- -1
            touch()

        def gizmo_cancel() -> void:
            readout_angle <- -1
            readout_mm <- -1
            gizmo_view <- -1
            gizmo_drag <- null
            gizmo_goal <- null
            status <- "gizmo drag cancelled"
            nudged_row <- -1
            status_file <- null
            touch()

        # A native focus loss may suppress the matching pointer-up. Cancel
        # every unfinished gesture so it cannot commit when focus returns.
        def focus_lost() -> void:
            was_gizmo: bool = gizmo_view >= 0
            mutable f: StudioFocus::Interaction = StudioFocus::Interaction{
                modifiers: modifiers,
                drag_view: drag_view,
                drag_button: drag_button.i64(),
                scrubbing: scrubbing,
                selecting: selecting,
                slider_drag: slider_drag,
                retime_speed: retime_speed,
                slider_start_speed: slider_start_speed,
                edge_drag_band: edge_drag.band,
                contact_press: FootState::active(&foot_press),
                gizmo_view: gizmo_view,
                typing: typing,
                selection_active: selection.active,
                gizmo_mode: gizmo_mode
            }
            f <- StudioFocus::after_focus_lost(f)
            file_menu_open <- false
            file_menu_hover <- -1
            modifiers <- f.modifiers
            drag_view <- f.drag_view
            drag_button <- f.drag_button.i32()
            scrubbing <- f.scrubbing
            selecting <- f.selecting
            slider_drag <- f.slider_drag
            retime_speed <- f.retime_speed
            edge_drag <- RetimeState::no_drag()
            foot_press <- FootState::idle()
            gizmo_view <- f.gizmo_view
            typing <- f.typing
            typed_len <- 0
            selection <- RetimeState::none() if not f.selection_active else selection
            if was_gizmo:
                gizmo_cancel()
            else:
                gizmo_drag <- null
                gizmo_goal <- null
                readout_angle <- -1
                readout_mm <- -1
            touch()

        # Escape peels one layer: the sheet, a drag, a contact press, the
        # gizmo, then the selection (StudioChrome::escape_layer).
        def escape() -> void:
            s: StackState::Stack = current_stack()
            layer: i64 = StudioChrome::escape_layer(help_open, gizmo_view >= 0, FootState::active(&foot_press), gizmo_mode >= 0, StackState::valid(s, s.selected))
            if layer == StudioChrome::ESC_HELP:
                help_open <- false
            elif layer == StudioChrome::ESC_DRAG:
                gizmo_cancel()
            elif layer == StudioChrome::ESC_PRESS:
                foot_press <- FootState::idle()
                status <- "contact edit cancelled"
                nudged_row <- -1
                status_file <- null
            elif layer == StudioChrome::ESC_GIZMO:
                set_gizmo(gizmo_mode)
            elif layer == StudioChrome::ESC_SELECT:
                select_row(-1)
                status <- "selection cleared"
                nudged_row <- -1
                status_file <- null
            touch()

        def key(code: UiCore::Key) -> void:
            if typing and code == UiCore::Key.Enter:
                typing <- false
                v: i64 = typed_speed()
                if v > 0:
                    retime_to(v)
                else:
                    status <- "speed must be 0.1 to 4"
                touch()
            elif typing and code == UiCore::Key.Backspace:
                typed_len <- typed_len - 1 if typed_len > 0 else 0
                touch()
            elif typing and code != UiCore::Key.Escape:
                pass
            elif code == UiCore::Key.Equal:
                typing <- true
                typed_len <- 0
                touch()
            elif StudioShortcuts::shift(modifiers) and preset_key(code) >= 0:
                retime_to(RetimeState::preset(preset_key(code)))
            elif StudioShortcuts::shift(modifiers) and code == UiCore::Key.P:
                contact_apply(StudioContactEditor::PLANT)
            elif StudioShortcuts::shift(modifiers) and code == UiCore::Key.L:
                contact_apply(StudioContactEditor::LIFT)
            elif StudioShortcuts::shift(modifiers) and code == UiCore::Key.U:
                contact_apply(StudioContactEditor::RESET)
            elif band_focus >= 0 and (code == UiCore::Key.Delete or code == UiCore::Key.Backspace):
                remove_band()
            elif code == UiCore::Key.R:
                set_gizmo(GizmoPolicy::ROTATE)
            elif code == UiCore::Key.V:
                set_gizmo(GizmoPolicy::TRANSLATE)
            elif code == UiCore::Key.Escape and not help_open and (typing or selection.active):
                typing <- false
                selection <- RetimeState::none()
                status <- "retime selection cancelled"
                touch()
            elif code == UiCore::Key.Escape:
                escape()
            elif code == UiCore::Key.A:
                clean_with_preset()
            elif code == UiCore::Key.Space:
                toggle_play()
            elif code == UiCore::Key.Left:
                step_frames(-1)
            elif code == UiCore::Key.Right:
                step_frames(1)
            elif code == UiCore::Key.Z:
                undo()
            elif code == UiCore::Key.Y:
                redo()
            elif code == UiCore::Key.L:
                toggle_loop()
            elif code == UiCore::Key.S:
                cycle_speed()
            elif code == UiCore::Key.T:
                toggle_flag(StudioScene::TRAILS)
            elif code == UiCore::Key.C:
                toggle_flag(StudioScene::CONTACTS)
            elif code == UiCore::Key.H:
                toggle_flag(StudioScene::HEAT)
            elif code == UiCore::Key.N:
                toggle_flag(StudioScene::ONION)
            elif code == UiCore::Key.G:
                toggle_flag(StudioScene::GHOST)
            elif code == UiCore::Key.X:
                toggle_flag(StudioScene::XRAY)
            elif code == UiCore::Key.Q:
                toolbar_action(StudioPanels::A_BALANCE)
            elif code == UiCore::Key.P:
                curve_mode <- StudioOverlay::next_mode(curve_mode)
                status <- "curves: position" if curve_mode == StudioOverlay::POSITION else "curves: rotation"
                nudged_row <- -1
                status_file <- null
                touch()
            elif code == UiCore::Key.K:
                toggle_feet()
            elif code == UiCore::Key.J:
                toggle_hands()
            elif code == UiCore::Key.W:
                jump_worst()
            elif code == UiCore::Key.Comma:
                nudge_blend(false)
            elif code == UiCore::Key.Period:
                nudge_blend(true)
            elif code == UiCore::Key.M:
                toggle_action_mesh()
            elif code == UiCore::Key.F and StudioShortcuts::shift(modifiers):
                perf_overlay <- not perf_overlay
                status <- "frame times on" if perf_overlay else "frame times off"
                nudged_row <- -1
                status_file <- null
                touch()
            elif code == UiCore::Key.F:
                frame_all()
            elif code == UiCore::Key.E:
                request_export(export_path, false)
            elif code == UiCore::Key.LeftBracket:
                edit_selected(7, -1)
            elif code == UiCore::Key.RightBracket:
                edit_selected(7, 1)
            elif code == UiCore::Key.B:
                edit_selected(8, 0)
            elif code == UiCore::Key.I:
                edit_selected(9, 0)
            elif code == UiCore::Key.O:
                edit_selected(10, 0)
            elif code == UiCore::Key.D:
                edit_selected(StudioPanels::HIT_TOGGLE, 0)
            elif code == UiCore::Key.Delete or code == UiCore::Key.Backspace:
                edit_selected(StudioPanels::HIT_REMOVE, 0)
            elif code == UiCore::Key.PageUp:
                edit_selected(StudioPanels::HIT_UP, 0)
            elif code == UiCore::Key.PageDown:
                edit_selected(StudioPanels::HIT_DOWN, 0)
            elif code == UiCore::Key.Up:
                s: StackState::Stack = current_stack()
                select_row(s.selected - 1) if s.selected > 0
            elif code == UiCore::Key.Down:
                s: StackState::Stack = current_stack()
                select_row(s.selected + 1) if s.selected + 1 < s.count
            elif code == UiCore::Key.Digit1:
                add_op(0)
            elif code == UiCore::Key.Digit2:
                add_op(1)
            elif code == UiCore::Key.Digit3:
                add_op(2)
            elif code == UiCore::Key.Digit4:
                add_op(3)
            elif code == UiCore::Key.Digit5:
                add_op(4)

        # Track Cmd/Ctrl and Shift; true when `code` was a modifier.
        def modifier(code: UiCore::Key, down: bool) -> bool:
            command: bool = code == UiCore::Key.LeftSuper or code == UiCore::Key.RightSuper or code == UiCore::Key.LeftControl or code == UiCore::Key.RightControl
            shift: bool = code == UiCore::Key.LeftShift or code == UiCore::Key.RightShift
            if command:
                modifiers <- StudioShortcuts::command_down(modifiers) if down else StudioShortcuts::command_up(modifiers)
            elif shift:
                modifiers <- StudioShortcuts::shift_down(modifiers) if down else StudioShortcuts::shift_up(modifiers)
            return command or shift

        # Cmd-Z undo, Cmd-Shift-Z redo; other Cmd chords are ignored and
        # plain keys go to the single-key bindings.
        def key_down(code: UiCore::Key) -> void:
            return if modifier(code, true)
            if export_warning_detail_open:
                export_warning_detail_key(code)
                return
            if export_path_inspector_open:
                export_path_inspector_key(code)
                return
            if export_result_open:
                export_result_key(code)
                return
            if export_review_open:
                export_review_key(code)
                return
            if legacy_prompt_open:
                if code == UiCore::Key.Escape:
                    resolve_legacy_session(StudioLegacyPrompt::CANCEL)
                elif code == UiCore::Key.L and not StudioShortcuts::command(modifiers):
                    resolve_legacy_session(StudioLegacyPrompt::LOAD)
                elif code == UiCore::Key.Left or code == UiCore::Key.Up:
                    legacy_prompt_focus <- StudioLegacyPrompt::move_focus(legacy_prompt_focus, -1)
                    touch()
                elif code == UiCore::Key.Right or code == UiCore::Key.Down:
                    legacy_prompt_focus <- StudioLegacyPrompt::move_focus(legacy_prompt_focus, 1)
                    touch()
                elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                    resolve_legacy_session(StudioLegacyPrompt::LOAD if legacy_prompt_focus == StudioLegacyPrompt::FOCUS_LOAD else StudioLegacyPrompt::CANCEL)
                return
            if replacement_prompt_open:
                replacement_prompt_key(code)
                return
            command: bool = StudioShortcuts::command(modifiers)
            mutable file: i64 = StudioShortcuts::FILE_NONE
            if code == UiCore::Key.O:
                file <- StudioShortcuts::o_chord(modifiers)
            elif code == UiCore::Key.S:
                file <- StudioShortcuts::s_chord(modifiers)
            elif code == UiCore::Key.E:
                file <- StudioShortcuts::e_chord(modifiers)
            if file != StudioShortcuts::FILE_NONE:
                modifiers <- 0
                dispatch_file_action(StudioFilePolicy::OPEN_TAKE) if file == StudioShortcuts::OPEN_TAKE
                dispatch_file_action(StudioFilePolicy::OPEN_SESSION) if file == StudioShortcuts::OPEN_SESSION
                dispatch_file_action(StudioFilePolicy::SAVE) if file == StudioShortcuts::SAVE
                dispatch_file_action(StudioFilePolicy::SAVE_AS) if file == StudioShortcuts::SAVE_AS
                dispatch_file_action(StudioFilePolicy::EXPORT_AS) if file == StudioShortcuts::EXPORT_AS
                return
            if file_menu_open:
                file_menu_key(code)
                return
            if code == UiCore::Key.Slash and not command:
                help_open <- StudioChrome::help_after(help_open, true, false)
                touch()
                return
            if help_open and code != UiCore::Key.Escape:
                return
            action: i64 = StudioShortcuts::z_chord(modifiers) if code == UiCore::Key.Z else StudioShortcuts::other_chord(modifiers)
            if action == StudioShortcuts::UNDO:
                undo()
            elif action == StudioShortcuts::REDO:
                redo()
            elif action == StudioShortcuts::PLAIN:
                key(code)

        def toggle_action_mesh() -> void:
            toolbar_action(StudioPanels::A_MESH)

        def event(incoming: UiCore::Event) -> void:
            match incoming:
                UiCore::Event.Quit:
                    request_window_close()
                UiCore::PointerEvent.Down(at, button):
                    pointer_down(at.x, at.y, button)
                UiCore::PointerEvent.Up(at, button):
                    pointer_up(at.x, at.y)
                UiCore::PointerEvent.Move(at):
                    pointer_move(at.x, at.y)
                UiCore::PointerEvent.Scroll(at, delta):
                    if not export_result_open and not export_review_open and not legacy_prompt_open and not replacement_prompt_open:
                        v: i64 = view_at(at.x, at.y)
                        if v >= 0:
                            zoom(v, 1 if delta.y > 0.0 else (-1 if delta.y < 0.0 else 0))
                UiCore::KeyEvent.Down(code):
                    key_down(code)
                UiCore::KeyEvent.Up(code):
                    modifier(code, false)
                UiCore::Event.FocusLost:
                    focus_lost()
                _:
                    pass
            UiCore::request_frame_after(0.001)

def app_init() -> void:
    Studio::init()

def app_widget_event(widget: usize, event: i32) -> void:
    Studio::toolbar_accessibility_action(widget, event)

def app_event(event: UiCore::Event) -> void:
    Studio::event(event)

def app_text_input(text: sview) -> void:
    Studio::text_input(text)

def app_validate() -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void:
    Studio::frame()

def appkit_canvas_file_drop_callback(window_handle: usize, path: cstr) -> void can Unsafe.PointerCast:
    return if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle()
    Studio::load_take(path)

export fn elisa_appkit_canvas_file_drop(window_handle: usize, path: cstr) -> void can Unsafe.PointerCast = appkit_canvas_file_drop_callback
