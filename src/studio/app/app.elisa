def app_init() -> void can[Global{Read, Write}]:
    Studio::init()

def app_widget_event(widget: usize, event: i32) -> void can[Threads, Unsafe{PointerCast, RawExtern}, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
    if Studio::session_locate_modal_open():
        _ = Studio::session_locate_accessibility_action(widget, event)
        return
    return if Studio::prepared_batch_accessibility_action(widget, event)
    return if Studio::generation_review_accessibility_action(widget, event)
    return if Studio::session_locate_accessibility_action(widget, event)
    return if Studio::goto_accessibility_action(widget, event)
    Studio::toolbar_accessibility_action(widget, event)

def app_goto_frame() -> void can[Global{Read, Write}]:
    Studio::request_goto_frame()

def app_event(event: UiCore::Event) -> void can[Threads, Ui.Window, Unsafe{PointerCast, RawExtern}, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
    Studio::event(event)

def app_text_input(text: sview) -> void can[Global{Read, Write}]:
    Studio::text_input(text)

def app_validate() -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void can[Threads, Ui.Window, Unsafe{PointerCast, RawExtern}, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
    Studio::frame()

def appkit_canvas_file_drop_callback(window_handle: usize, path: cstr) -> void can[Unsafe.PointerCast, Global{Read, Write}]:
    return if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle()
    return if Studio::session_locate_modal_open()
    return if Studio::prepared_batch_modal_open()
    return if Studio::storage_modal_open()
    Studio::load_take(path)

export fn elisa_appkit_canvas_file_drop(window_handle: usize, path: cstr) -> void can[Unsafe.PointerCast, Global{Read, Write}] = appkit_canvas_file_drop_callback
