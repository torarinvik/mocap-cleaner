# The studio window: three hosted engine viewports (perspective, front,
# side), the curve view, the timeline and the operation stack, wired to the
# state modules. Every stack edit is recorded in history and rebuilds the
# cleaned clip (live preview through the same clean_animation the CLI
# exports with, posed with PoseOverride).
#
# State lives in optional module globals: stage1 declines struct and darray
# global initialisers. Heap data stored into a global survives only with the
# studio-globals stage1 (functions that store into globals allocate from a
# static region instead of a freed auto arena; see scripts/build_studio.sh).
# That region is never reclaimed, so each rebuild keeps its clip's memory.
include "../../../../elisa-ui/src/platform/appkit/ui_appkit_canvas_flat.elisa"
include "../../../../elisa-engine-mocap/src/viewport/viewport.elisa"
include "../../../../elisa-engine-mocap/src/ui/file_panel.elisa"
include "scene.elisa"
include "panels.elisa"
include "retime_panel.elisa"
include "../shortcuts.elisa"
include "../focus.elisa"
include "../state/session_state.elisa"
include "../state/readout.elisa"

extern puts(text: cstr) -> i64

module Studio:
    public:
        const EXPORT_PATH: cstr = "build/studio_export.glb"
        const SESSION_PATH: cstr = "build/studio_session.txt"
        const PATH_CAPACITY: usize = 4096

        global mutable path: cstr = "../elisa-boxing-game/build/dual-stance/black/black-boxer.glb"
        # The native file-drop callback borrows its UTF-8 path only until it
        # returns. Two fixed buffers let us stage a new path and keep the
        # current take's path intact if loading the new take fails.
        global mutable path_bytes0: u8[4096] = zeroed
        global mutable path_bytes1: u8[4096] = zeroed
        global mutable path_slot: i64 = -1
        global mutable anim_name: cstr = "jab"
        global mutable clip: StudioModel::Clip? = null
        global mutable history: HistoryState::History = zeroed
        global mutable history_ready: bool = false
        global mutable timeline: TimelineState::State? = null
        global mutable flags: i64 = StudioScene::DEFAULT_FLAGS
        global mutable bone: i64 = 0
        global mutable last_time: f64 = 0.0
        global mutable drawn_frame: i64 = -1
        global mutable revision: i64 = 0
        global mutable status: sview = "ready"
        # Live drag readouts: gizmo angle (tenths of a degree) and offset
        # (mm), -1 when no gizmo drag is running; and the stack row whose
        # strength was just nudged, -1 for none.
        global mutable readout_angle: i64 = -1
        global mutable readout_mm: i64 = -1
        global mutable nudged_row: i64 = -1
        # File the status line names (appended after `status`), or null.
        global mutable status_file: cstr? = null
        # Where Cmd-S saves the session and E exports; Save As / Export As
        # (native panels) change them.
        global mutable session_path: cstr = "build/studio_session.txt"
        global mutable export_path: cstr = "build/studio_export.glb"
        # Chrome: the "?" sheet, whether the take failed to load, and the
        # toolbar button under the pointer (for its tooltip).
        global mutable help_open: bool = false
        global mutable load_failed: bool = false
        global mutable hover_button: i64 = -1
        # The sidebar File menu is keyboard navigable as well as clickable.
        global mutable file_menu_open: bool = false
        global mutable file_menu_focus: i64 = 0
        global mutable file_menu_hover: i64 = -1
        # Last one-click clean: permille of slide and spikes removed, or -1.
        global mutable gain_slide: i64 = -1
        global mutable gain_spikes: i64 = -1
        # Skinned mesh of the clip's character, loaded once, and its pose
        # cached per (frame, revision).
        global mutable mesh: GlbSkinMesh::Mesh? = null
        global mutable skinned: darray[Geometry::Vec3]? = null
        global mutable skinned_frame: i64 = -1
        global mutable skinned_revision: i64 = -1
        # Gizmo: GizmoPolicy mode, or -1 when hidden; the drag and its view.
        global mutable gizmo_mode: i64 = -1
        global mutable gizmo_drag: ViewportGizmo::Drag? = null
        global mutable gizmo_view: i64 = -1
        # Pose goal of the running gizmo drag, for the live preview.
        global mutable gizmo_goal: Geometry::Transform? = null
        # Curve view channel (StudioOverlay::ROTATION or POSITION).
        global mutable curve_mode: i64 = 0
        # Held modifiers (StudioShortcuts mask).
        global mutable modifiers: i64 = 0
        # Phase 6 caches: the loaded take and op caches, the stack the clip
        # was built from, a counter bumped per rebuild, the curve memo, the
        # drag preview's base pose (per frame and build), and the Shift-F
        # frame-time overlay with the last draw time.
        global mutable memo: StudioModel::Memo? = null
        global mutable built_stack: StackState::Stack? = null
        global mutable built: i64 = 0
        global mutable rig_source_revision: i64 = 0
        global mutable curve_memo: StudioPerf::Curves = zeroed
        global mutable base_models: darray[Geometry::Transform] = zeroed
        global mutable base_locals: darray[Geometry::Transform] = zeroed
        global mutable base_frame: i64 = -1
        global mutable base_built: i64 = -1
        global mutable perf_overlay: bool = false
        global mutable draw_us: i64 = 0
        global mutable preview_moved: i64 = 0

        global mutable view0: Viewport::Viewport? = null
        global mutable view1: Viewport::Viewport? = null
        global mutable view2: Viewport::Viewport? = null
        global mutable seen0: i64 = -1
        global mutable seen1: i64 = -1
        global mutable seen2: i64 = -1
        global mutable shown0: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable shown1: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable shown2: UiHostedSurface::Shown = UiHostedSurface::Shown{surface: 0, generation: 0, frame: -1, rect: UiHostedSurface::Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
        global mutable framed: bool = false

        global mutable drag_view: i64 = -1
        global mutable drag_button: i32 = -1
        global mutable scrubbing: bool = false
        global mutable last_x: f32 = 0.0
        global mutable last_y: f32 = 0.0
        global mutable down_x: f32 = 0.0
        global mutable down_y: f32 = 0.0
        # Foot cleanup: the contact-bar press in progress, the hovered
        # contact row (StackState::LEFT/RIGHT or -1), and the readout
        # transition (values shown before the last rebuild, and its start).
        global mutable foot_press: FootState::Press = FootState::Press{side: -1, part: 0, first: -1, last: -1, frame: -1}
        global mutable hover_row: i64 = -1
        global mutable shown_slide: i64 = 0
        global mutable shown_sink: i64 = 0
        global mutable shown_hand_slide: i64 = 0
        global mutable readout_start: f64 = 0.0
        # Retiming: Shift-drag selection (output frames), band edge drag,
        # focused band (Delete removes it), slider and typed speed.
        global mutable selection: RetimeState::Selection = RetimeState::Selection{active: false, anchor: -1, head: -1}
        global mutable selecting: bool = false
        global mutable edge_drag: RetimeState::EdgeDrag = RetimeState::EdgeDrag{band: -1, last_edge: false}
        global mutable band_focus: i64 = -1
        global mutable slider_drag: bool = false
        global mutable retime_speed: i64 = 1000
        global mutable slider_start_speed: i64 = 1000
        global mutable typing: bool = false
        global mutable typed: u8[8] = zeroed
        global mutable typed_len: i64 = 0
        const READOUT_MS: i64 = 250

        def spare_path_slot() -> i64:
            return 0 if path_slot == 1
            1

        def copy_path(p: cstr, slot: i64) -> bool can Unsafe.PointerCast:
            return false if slot != 0 and slot != 1
            mutable i: usize = 0
            while i < PATH_CAPACITY:
                c: u8 = p[i]
                if c == 0:
                    if slot == 0:
                        path_bytes0[i] <- 0
                    else:
                        path_bytes1[i] <- 0
                    return true
                return false if i == PATH_CAPACITY - 1
                if slot == 0:
                    path_bytes0[i] <- c
                else:
                    path_bytes1[i] <- c
                i <- i + 1
            false

        def stored_path(slot: i64) -> cstr can Unsafe.PointerCast:
            return (&path_bytes0[0]).cast[cstr] if slot == 0
            (&path_bytes1[0]).cast[cstr]

        def set_path(p: cstr) -> void can Unsafe.PointerCast:
            slot: i64 = spare_path_slot()
            if copy_path(p, slot):
                path_slot <- slot
                path <- stored_path(slot)
            else:
                status <- "take path exceeds 4095 bytes"
                status_file <- null

        def set_anim(a: cstr) -> void:
            anim_name <- a

        # ---- per-view globals ------------------------------------------
        def put_view(i: i64, vp: Viewport::Viewport) -> void:
            if i == 0:
                view0 <- vp
            elif i == 1:
                view1 <- vp
            else:
                view2 <- vp

        def view(i: i64) -> Viewport::Viewport?:
            return view0 if i == 0
            return view1 if i == 1
            view2

        def seen(i: i64) -> i64:
            return seen0 if i == 0
            return seen1 if i == 1
            seen2

        def put_seen(i: i64, r: i64) -> void:
            if i == 0:
                seen0 <- r
            elif i == 1:
                seen1 <- r
            else:
                seen2 <- r

        def open_view(i: i64) -> Viewport::Viewport?:
            mutable vp: Viewport::Viewport = catch Viewport::create(320, 240):
                value: value
                error failure: return null
            if i == 1:
                vp.camera <- ViewportCamera::create_ortho(320, 240, ViewportCamera::FRONT)
            if i == 2:
                vp.camera <- ViewportCamera::create_ortho(320, 240, ViewportCamera::SIDE)
            return move vp

        def rect_of(b: StudioPanels::Box) -> UiHostedSurface::Rect:
            UiHostedSurface::Rect{x: b.x, y: b.y, width: b.w, height: b.h}

        def view_box(i: i64) -> StudioPanels::Box:
            StudioPanels::view_box(i.usize(), UiCore::viewport_width(), UiCore::viewport_height())

        # ---- state helpers -----------------------------------------------
        def frame_now() -> i64:
            if timeline is t:
                return t.frame
            0

        def frames() -> i64:
            if clip is c:
                return c.frames
            1

        # Frames per second of the loaded clip, from its key times.
        def rate() -> i64:
            if clip is c:
                return c.rate if c.rate >= 1 else Timeline::RATE
            Timeline::RATE

        # Document nodes of the loaded take (gizmo corrections name them).
        def node_total() -> i64:
            if clip is c:
                return GlbDocument::node_count(&c.source).i64()
            0

        def current_stack() -> StackState::Stack:
            if history_ready:
                return HistoryState::current(&history)
            StackState::empty()

        def touch() -> void:
            revision <- revision + 1
            UiCore::request_frame_after(0.001)

        # Rebuild the cleaned clip from the current stack (live preview).
        def rebuild() -> void:
            s: StackState::Stack = current_stack()
            if clip is old:
                shown_slide <- readout_value(shown_slide, old.slide_after)
                shown_sink <- readout_value(shown_sink, old.sink_after)
                shown_hand_slide <- readout_value(shown_hand_slide, old.hand_slide_after)
            readout_start <- UiAppKitCanvas::monotonic_time()
            if memo == null:
                memo <- StudioModel::load(path, anim_name)
            mutable result: StudioModel::Clip? = null
            if memo is held:
                mutable m: StudioModel::Memo = held
                memo <- null
                if built_stack is prior:
                    rig_source_revision <- rig_source_revision + 1 if not StackState::same_rig_source(prior, s)
                else:
                    rig_source_revision <- rig_source_revision + 1
                w: mutable StudioPerf::Window = StudioPerf::full(m.frames)
                if clip is c:
                    if built_stack is old:
                        w <- StudioPerf::edit_window(old, s, m.frames, m.shortest)
                    result <- StudioModel::build_with(&m, s, c.points, c.problems, c.peaks, w, rig_source_revision)
                else:
                    none_p: darray[Geometry::Vec3] = []
                    none_i: darray[i64] = []
                    result <- StudioModel::build_with(&m, s, none_p, none_i, none_i, w, rig_source_revision)
                memo <- move m
            if result == null:
                status <- "clip failed to load"
                nudged_row <- -1
                status_file <- null
                load_failed <- true
                return
            load_failed <- false
            clip <- move result
            StudioPanels::set_rate(rate())
            sync_count()
            built_stack <- s
            built <- built + 1
            touch()

        # A retime changes the clip length: keep the playhead on the same
        # source frame.
        def sync_count() -> void:
            if timeline is t:
                n: i64 = frames()
                if t.count != n:
                    mutable u: TimelineState::State = TimelineState::create(n)
                    u.looping <- t.looping
                    u.divisor <- t.divisor
                    set_timeline(TimelineState::scrub(u, t.frame * n / t.count))

        # ---- retiming ------------------------------------------------------
        # Speed for the selection (a new band or the band under it), else for
        # the focused band.
        def retime_to(speed: i64) -> void:
            retime_speed <- Retime::clamp_speed(speed)
            if clip is c:
                mutable s: StackState::Stack = current_stack()
                mutable ok: bool = false
                if RetimeState::ready(&selection):
                    first: i64 = StudioModel::source_frame(c, RetimeState::lo(&selection))
                    last: i64 = StudioModel::source_frame(c, RetimeState::hi(&selection))
                    ok <- RetimeState::apply_speed(&s, first, last, retime_speed, c.source_frames)
                    band_focus <- StackState::band_at(&s, first)
                elif band_focus >= 0:
                    ok <- StackState::set_band_speed(&s, band_focus, retime_speed)
                if ok:
                    selection <- RetimeState::none()
                    commit(s, true)
                    status <- StudioText::number("retime permille ", retime_speed)
                else:
                    status <- "retime: Shift-drag a range (no overlap with a band)"
                touch()

        def typed_view() -> sview can Unsafe.PointerCast:
            StudioText::begin()
            StudioText::put("speed: ")
            for i in 0..<typed_len.usize():
                StudioText::byte(typed[i])
            StudioText::byte(95)
            return StudioText::view()

        def typed_speed() -> i64:
            StudioText::begin()
            for i in 0..<typed_len.usize():
                StudioText::byte(typed[i])
            return RetimeState::parse_speed(StudioText::view())

        def text_input(text: sview) -> void:
            return if not typing or text.len <= 0 or text.data == null
            for i in 0..<text.len.usize():
                if typed_len < 8 and text.data[i] != 61:
                    typed[typed_len.usize()] <- text.data[i]
                    typed_len <- typed_len + 1
            touch()

        # Shift-1..7: speed presets 0.5x .. 2x.
        def preset_key(code: UiCore::Key) -> i64:
            return 0 if code == UiCore::Key.Digit1
            return 1 if code == UiCore::Key.Digit2
            return 2 if code == UiCore::Key.Digit3
            return 3 if code == UiCore::Key.Digit4
            return 4 if code == UiCore::Key.Digit5
            return 5 if code == UiCore::Key.Digit6
            return 6 if code == UiCore::Key.Digit7
            return -1

        def remove_band() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::remove_band(&s, band_focus):
                band_focus <- -1
                commit(s, true)
                status <- "retime band removed"

        # Record an edited stack and preview it; selection-only edits are
        # recorded too so undo restores the row the user was on.
        def commit(s: StackState::Stack, preview: bool) -> void:
            if history_ready:
                changed: bool = HistoryState::record(&history, s)
                if changed and preview:
                    rebuild()
                touch()

        def undo() -> void:
            if history_ready:
                if HistoryState::undo(&history):
                    rebuild()
                    status <- "undo"
                    nudged_row <- -1
                    status_file <- null

        def redo() -> void:
            if history_ready:
                if HistoryState::redo(&history):
                    rebuild()
                    status <- "redo"
                    nudged_row <- -1
                    status_file <- null

        # ---- foot cleanup ------------------------------------------------
        # Readout transition progress (StudioFoot::FULL when settled).
        def readout_progress() -> i64:
            ms: f64 = (UiAppKitCanvas::monotonic_time() - readout_start) * 1000.0
            elapsed: i64 = 0 if ms < 0.0 else (READOUT_MS if ms > READOUT_MS.f64() else ms.i64())
            return StudioFoot::progress(elapsed, READOUT_MS)

        def readout_value(shown: i64, target: i64) -> i64:
            return target if target < -StudioFoot::LIMIT or target > StudioFoot::LIMIT
            return target if shown < -StudioFoot::LIMIT or shown > StudioFoot::LIMIT
            return StudioFoot::mix(shown, target, readout_progress())

        # K: foot cleanup on/off, recorded in history.
        def toggle_feet() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::set_feet(&s, not s.feet):
                commit(s, true)
                status <- "feet fixed" if s.feet else "feet off"
                nudged_row <- -1
                status_file <- null

        # J: opt-in hand contact cleanup, recorded in history.
        def toggle_hands() -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::set_hands(&s, not s.hands):
                commit(s, true)
                status <- "hands fixed" if s.hands else "hands off"
                nudged_row <- -1
                status_file <- null

        # , and .: shorter or longer carry blend.
        def nudge_blend(up: bool) -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::nudge_blend(&s, up):
                commit(s, true)
                status <- "blend"
                nudged_row <- -2

        # W: scrub to the worst planted slide, select that foot and frame it.
        def jump_worst() -> void:
            if clip is c:
                return if c.worst_frame < 0 or c.worst_frame >= c.frames
                scrub_to(c.worst_frame)
                role: i64 = Roles::LEFT_FOOT if c.worst_side == StackState::LEFT else Roles::RIGHT_FOOT
                bone <- StudioClip::slot_of_role(c.cleaned, c.slot, role)
                track: darray[Geometry::Vec3] = c.left_foot if c.worst_side == StackState::LEFT else c.right_foot
                if c.worst_frame < track.count.i64():
                    p: Geometry::Vec3 = track[c.worst_frame.usize()]
                    pts: darray[Geometry::Vec3] = [Geometry::vec3_add(p, Geometry::Vec3{x: -0.25, y: -0.05, z: -0.25}), Geometry::vec3_add(p, Geometry::Vec3{x: 0.25, y: 0.35, z: 0.25})]
                    for i in 0..<3 |i, pts|:
                        if view(i) is opened:
                            mutable vp: Viewport::Viewport = opened
                            _ = ViewportCamera::frame_points(&vp.camera, &pts, 1.15)
                            Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                            put_view(i, vp)
                status <- "worst slide"
                nudged_row <- -1
                status_file <- null
                touch()

        # A press on a contact row; true when it was one.
        def contact_down(x: f32, y: f32) -> bool:
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            row: i64 = StudioPanels::contact_row(tb, y)
            return false if row < 0
            if clip is c:
                st: StudioPanels::Box = StudioPanels::strip(tb)
                mutable fl: darray[bool] = c.left_contact
                fl <- c.right_contact if row == StackState::RIGHT
                fl <- c.left_hand_contact if row == StackState::LEFT_HAND
                fl <- c.right_hand_contact if row == StackState::RIGHT_HAND
                foot_press <- FootState::press(fl, row, (x - st.x).i64(), st.w.i64())
                return true
            false

        def contact_up(x: f32) -> void:
            p: FootState::Press = foot_press
            foot_press <- FootState::idle()
            tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            mutable s: StackState::Stack = current_stack()
            if FootState::release(&s, &p, StudioPanels::timeline_frame(tb, x, frames()), frames()):
                commit(s, true)
                status <- "contact edited"
                nudged_row <- -1
                status_file <- null

        def set_timeline(t: TimelineState::State) -> void:
            timeline <- t
            touch()

        def scrub_to(f: i64) -> void:
            if timeline is t:
                set_timeline(TimelineState::scrub(t, f))

        def step_frames(d: i64) -> void:
            if timeline is t:
                set_timeline(TimelineState::step_by(t, d))

        def toggle_play() -> void:
            if timeline is t:
                last_time <- UiAppKitCanvas::monotonic_time()
                set_timeline(TimelineState::toggle_play(t))

        def cycle_speed() -> void:
            if timeline is t:
                set_timeline(TimelineState::cycle_speed(t))

        def toggle_loop() -> void:
            if timeline is t:
                mutable n: TimelineState::State = t
                n.looping <- not n.looping
                set_timeline(n)

        def toggle_flag(bit: i64) -> void:
            flags <- StudioScene::toggle(flags, bit)
            touch()

        # ---- stack edits -----------------------------------------------
        def add_op(k: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            if StackState::add(&s, StudioModel::new_operation(k, frames())):
                StackState::select(&s, s.count - 1)
                commit(s, true)
                status <- "operation added"
                nudged_row <- -1
                status_file <- null

        def edit_selected(kind: i64, amount: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            at: i64 = s.selected
            return if not StackState::valid(s, at)
            mutable ok: bool = false
            if kind == StudioPanels::HIT_TOGGLE:
                ok <- StackState::toggle(&s, at)
            elif kind == StudioPanels::HIT_REMOVE:
                ok <- StackState::remove(&s, at)
            elif kind == StudioPanels::HIT_UP:
                ok <- StackState::move(&s, at, -1)
            elif kind == StudioPanels::HIT_DOWN:
                ok <- StackState::move(&s, at, 1)
            elif kind == 7:
                ok <- StudioModel::nudge(&s, at, amount)
                nudged_row <- at if ok else -1
            elif kind == 8:
                ok <- StackState::cycle_bones(&s, at)
            elif kind == 9:
                op: Ops::Operation = s.ops[at]
                ok <- StackState::set_scope(&s, at, frame_now(), op.last, frames())
            elif kind == 10:
                op: Ops::Operation = s.ops[at]
                ok <- StackState::set_scope(&s, at, op.first, frame_now(), frames())
            if ok:
                commit(s, true)

        def select_row(i: i64) -> void:
            mutable s: StackState::Stack = current_stack()
            StackState::select(&s, i)
            commit(s, false)

        def row_action(hit: i64) -> void:
            kind: i64 = hit / 100
            row: i64 = hit % 100
            if kind == StudioPanels::HIT_ADD:
                add_op(row)
                return
            select_row(row)
            edit_selected(kind, 0) if kind != StudioPanels::HIT_SELECT

        # One click Fix all: the boxing preset plus foot and hand locks as one
        # undoable edit; the sidebar shows every detector's before/after.
        def clean_with_preset() -> void:
            commit(StudioModel::fix_all_stack(), true)
            if clip is c:
                gain_slide <- gain(c.slide_before, c.slide_after)
                gain_spikes <- gain(c.spikes_before, c.spikes_after)
            status <- "Fix all applied (Cmd-Z to undo)"
            nudged_row <- -1
            status_file <- null
            touch()

        def gain(before: i64, after: i64) -> i64:
            return 0 if before < 0 or after < 0 or before > StudioChrome::CHROME_SIZE or after > StudioChrome::CHROME_SIZE
            StudioChrome::clean_gain(before, after)

        # Status line naming a file: "<s> <file name>".
        def say_file(s: sview, file: cstr) -> void:
            status <- s
            nudged_row <- -1
            status_file <- file

        def save_session() -> void:
            ok: bool = SessionState::save_session(current_stack(), session_path)
            if ok:
                HistoryState::mark_saved(&history)
                say_file("session saved to", session_path)
                FilePanel::note_recent(session_path)
            else:
                say_file("could not save the session to", session_path)
            touch()

        def load_session() -> void:
            if SessionState::load_session(session_path, frames(), node_total()) is loaded:
                commit(loaded, true)
                HistoryState::mark_saved(&history)
                say_file("session loaded (Cmd-Z to undo) from", session_path)
                FilePanel::note_recent(session_path)
            else:
                say_file("no readable session at", session_path)
            touch()

        def export_clip() -> void:
            if clip is c:
                if StudioModel::save_cleaned(c, export_path):
                    say_file("exported", export_path)
                    FilePanel::note_recent(export_path)
                else:
                    say_file("export failed for", export_path)
                _ = puts(export_path)
                touch()

        # ---- native file panels (modal) --------------------------------
        def save_session_as() -> void:
            if FilePanel::save("txt", session_path, "Save the operation stack and contacts as a session") is chosen:
                session_path <- chosen
                save_session()

        def open_session() -> void:
            if FilePanel::open("txt", "Open a saved session for this take") is chosen:
                session_path <- chosen
                load_session()

        def export_as() -> void:
            return if clip == null
            if FilePanel::save("glb", export_path, "Export the cleaned take") is chosen:
                export_path <- chosen
                export_clip()

        def dispatch_file_action(action: i64) -> void:
            if action == StudioFilePolicy::OPEN_TAKE:
                open_take()
            elif action == StudioFilePolicy::OPEN_SESSION:
                open_session()
            elif action == StudioFilePolicy::SAVE:
                save_session()
            elif action == StudioFilePolicy::SAVE_AS:
                save_session_as()
            elif action == StudioFilePolicy::EXPORT_CURRENT:
                export_clip()
            elif action == StudioFilePolicy::EXPORT_AS:
                export_as()

        def activate_file_menu(row: i64) -> void:
            return if row < 0 or row >= StudioFilePolicy::ROWS
            action: i64 = StudioFilePolicy::activate(row, clip != null)
            return if action == StudioFilePolicy::NONE
            file_menu_open <- false
            file_menu_hover <- -1
            touch()
            dispatch_file_action(action)

        def file_menu_key(code: UiCore::Key) -> void:
            if code == UiCore::Key.Escape:
                file_menu_open <- false
                file_menu_hover <- -1
                touch()
            elif code == UiCore::Key.Up:
                file_menu_focus <- StudioFilePolicy::next_enabled(file_menu_focus, -1, clip != null)
                touch()
            elif code == UiCore::Key.Down:
                file_menu_focus <- StudioFilePolicy::next_enabled(file_menu_focus, 1, clip != null)
                touch()
            elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                activate_file_menu(file_menu_focus)

        def open_take() -> void:
            if FilePanel::open("glb", "Open a motion-capture take") is chosen:
                load_take(chosen)

        # Swap in another take. The file is read first; if it holds no
        # usable animation the current take stays untouched. Otherwise every
        # per-take cache, the playhead, the gizmo and the undo history start
        # fresh (undo never reaches back into a different take).
        def load_take(p: cstr) -> void can Unsafe.PointerCast:
            candidate_slot: i64 = spare_path_slot()
            if not copy_path(p, candidate_slot):
                status <- "take path exceeds 4095 bytes"
                status_file <- null
                touch()
                return
            candidate_path: cstr = stored_path(candidate_slot)
            fresh: StudioModel::Memo? = StudioModel::load(candidate_path, anim_name)
            if fresh == null:
                say_file("no animation could be read from", candidate_path)
                touch()
                return
            path_slot <- candidate_slot
            path <- candidate_path
            memo <- move fresh
            clip <- null
            built_stack <- null
            shown_slide <- 0
            shown_sink <- 0
            shown_hand_slide <- 0
            built <- built + 1
            curve_memo <- zeroed
            base_frame <- -1
            base_built <- -1
            skinned <- null
            skinned_frame <- -1
            skinned_revision <- -1
            mesh <- null
            loaded: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(path):
                value: value
                error failure: GlbSkinMesh::empty()
            if GlbSkinMesh::vertex_count(&loaded) > 0:
                mesh <- loaded
            gizmo_drag <- null
            gizmo_goal <- null
            gizmo_view <- -1
            readout_angle <- -1
            readout_mm <- -1
            gain_slide <- -1
            gain_spikes <- -1
            drag_view <- -1
            drag_button <- -1
            scrubbing <- false
            foot_press <- FootState::Press{side: -1, part: 0, first: -1, last: -1, frame: -1}
            hover_row <- -1
            drawn_frame <- -1
            HistoryState::reset(&history, StudioModel::initial_stack())
            history_ready <- true
            rebuild()
            if clip is c:
                timeline <- TimelineState::create(c.frames)
                bone <- StudioModel::default_bone(c)
                framed <- false
                say_file("opened (undo history starts fresh)", path)
                FilePanel::note_recent(path)
            else:
                timeline <- TimelineState::create(1)
            touch()

        # ---- views -----------------------------------------------------
        def frame_all() -> void:
            if clip is c:
                pts: darray[Geometry::Vec3] = StudioScene::points(c, frame_now())
                for i in 0..<3 |i, pts|:
                    if view(i) is opened:
                        mutable vp: Viewport::Viewport = opened
                        _ = ViewportCamera::frame_points(&vp.camera, &pts, 1.15)
                        Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                        put_view(i, vp)
                touch()

        def view_at(x: f32, y: f32) -> i64:
            for i in 0..<3 |i, x, y|:
                return i if StudioPanels::inside(view_box(i), x, y)
            -1

        def sync_view(i: i64, scale: f32) -> void:
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                rect: UiHostedSurface::Rect = rect_of(view_box(i))
                _ = catch Viewport::resize(&vp, UiHostedSurface::pixel_extent(rect.width, scale), UiHostedSurface::pixel_extent(rect.height, scale)):
                    value: value
                    error failure: false
                if seen(i) != revision:
                    Viewport::invalidate(&vp, ViewportPolicy::DIRTY_SCENE)
                    put_seen(i, revision)
                if clip is c:
                    refresh_skin(c)
                    empty_mesh: GlbSkinMesh::Mesh = GlbSkinMesh::empty()
                    no_points: darray[Geometry::Vec3] = []
                    mutable list: ViewportDraw::List = draw_list(&vp.camera, c, &empty_mesh, &no_points)
                    if gizmo_mode >= 0 and bone >= 0:
                        g: ViewportGizmo::Gizmo = StudioScene::gizmo_for(c, frame_now(), bone, gizmo_mode)
                        _ = catch ViewportGizmo::draw(&list, &vp.camera, &g, GizmoPolicy::NONE, active_handle()):
                            value: value
                            error failure: 0
                    _ = catch Viewport::tick(&vp, &list):
                        value: value
                        error failure: false
                action: i32 = present(i, vp, rect)
                if action == UiHostedSurface::APPLY:
                    _ = Viewport::acknowledge(&vp, vp.published_frame)
                if vp.dirty != 0:
                    UiCore::request_frame_after(0.016)
                put_view(i, vp)

        # Re-skin the mesh when the frame or the clip changed (MESH on only).
        def refresh_skin(c: StudioModel::Clip&) -> void:
            return if not StudioScene::on(flags, StudioScene::MESH)
            return if skinned_frame == frame_now() and skinned_revision == revision
            if mesh is m:
                posed: darray[Geometry::Vec3] = StudioScene::pose_mesh(c, m, frame_now())
                skinned <- posed
                skinned_frame <- frame_now()
                skinned_revision <- revision

        # Refreshes the cached base pose and solves the gizmo chain preview. It reads and
        # writes heap globals, so its allocations live in the never-freed static region;
        # keeping it out of draw_list confines that to frames with an active gizmo goal.
        def chain_preview_of(c: StudioModel::Clip&, goal: Geometry::Transform) -> darray[Geometry::Transform]:
            r: PoseOverride::Rig = StudioModel::rig(c)
            if base_frame != frame_now() or base_built != built:
                base_models <- StudioModel::models(c, r, frame_now(), false)
                base_locals <- StudioClip::locals_at(c.cleaned, c.anim, frame_now(), c.nodes, c.slot)
                base_frame <- frame_now()
                base_built <- built
            p: StudioPerf::Preview = StudioPerf::chain_preview(r, base_models, base_locals, bone, goal)
            preview_moved <- p.moved
            return move p.models

        def draw_list(cam: ViewportCamera::Camera&, c: StudioModel::Clip&, empty_mesh: GlbSkinMesh::Mesh&, no_points: darray[Geometry::Vec3]&) -> ViewportDraw::List:
            mutable preview: darray[Geometry::Transform] = []
            if StudioOverlay::preview(gizmo_view, gizmo_drag != null, bone):
                if gizmo_goal is goal:
                    preview <- chain_preview_of(c, goal)
            if mesh is m:
                if skinned is p:
                    return StudioScene::build_with(cam, c, m, p, frame_now(), flags, bone, &preview)
            return StudioScene::build_with(cam, c, empty_mesh, no_points, frame_now(), flags, bone, &preview)

        def present(i: i64, vp: Viewport::Viewport&, rect: UiHostedSurface::Rect) -> i32:
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            if i == 0:
                return UiAppKitCanvas::present_hosted(&shown0, 0, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)
            if i == 1:
                return UiAppKitCanvas::present_hosted(&shown1, 1, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)
            UiAppKitCanvas::present_hosted(&shown2, 2, Viewport::published_surface(vp), vp.generation, vp.published_frame, rect, w, h)

        # ---- lifecycle -------------------------------------------------
        def init() -> void:
            UiHandles::reset()
            initial: StackState::Stack = StudioModel::initial_stack()
            HistoryState::reset(&history, initial)
            history_ready <- true
            loaded: GlbSkinMesh::Mesh = catch GlbSkinMesh::load(path):
                value: value
                error failure: GlbSkinMesh::empty()
            if GlbSkinMesh::vertex_count(&loaded) > 0:
                mesh <- loaded
            rebuild()
            if clip is c:
                timeline <- TimelineState::create(c.frames)
                bone <- StudioModel::default_bone(c)
                _ = puts("studio: clip loaded")
            else:
                timeline <- TimelineState::create(1)
                _ = puts("studio: clip not found; tried path / animation:")
                _ = puts(path)
                _ = puts(anim_name)
                _ = puts("studio: quote a path that contains spaces")
            view0 <- open_view(0)
            view1 <- open_view(1)
            view2 <- open_view(2)
            if view0 == null:
                status <- "no Metal device"
                nudged_row <- -1
                status_file <- null
            last_time <- UiAppKitCanvas::monotonic_time()

        def advance() -> void:
            now: f64 = UiAppKitCanvas::monotonic_time()
            elapsed: f64 = now - last_time
            last_time <- now
            if timeline is t:
                if t.playing:
                    # The timeline kernels count frames at Timeline::RATE;
                    # scale wall time so the clip plays at its own rate.
                    us: i64 = (elapsed * 1000000.0 * rate().f64() / Timeline::RATE.f64()).i64()
                    n: TimelineState::State = TimelineState::tick(t, us)
                    timeline <- n
                    if n.frame != drawn_frame:
                        revision <- revision + 1
                    UiCore::request_frame_after(0.008)

        # Shift-F overlay: the last rebuild's stage times and the last draw.
        def perf_panel(c: StudioModel::Clip&) -> void:
            x: f32 = 16.0
            y: f32 = 44.0
            StudioDraw::rect(x - 6.0, y - 4.0, 250.0, 96.0, StudioDraw::color(10, 12, 16))
            StudioDraw::text(x, y, 12.0, StudioText::number("evaluate us ", c.evaluate_us), StudioDraw::ink())
            StudioDraw::text(x, y + 15.0, 12.0, StudioText::number("detectors us ", c.detect_us), StudioDraw::ink())
            StudioDraw::text(x, y + 30.0, 12.0, StudioText::number("draw us ", draw_us), StudioDraw::ink())
            StudioDraw::text(x, y + 45.0, 12.0, StudioText::number("poses evaluated ", c.poses), StudioDraw::muted())
            StudioDraw::text(x, y + 60.0, 12.0, StudioText::number("ops rerun ", c.ops_run), StudioDraw::muted())
            StudioDraw::text(x, y + 75.0, 12.0, StudioText::number("drag bones moved ", preview_moved), StudioDraw::muted())

        def frame() -> void:
            draw_start: f64 = UiAppKitCanvas::monotonic_time()
            advance()
            if not framed and clip != null:
                framed <- true
                frame_all()
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            UiCore::clear(StudioDraw::color(17, 20, 27))
            s: StackState::Stack = current_stack()
            mutable cursor: i64 = 0
            mutable count: i64 = 1
            mutable can_undo: bool = false
            mutable can_redo: bool = false
            mutable is_dirty: bool = false
            if history_ready:
                cursor <- history.cursor
                count <- history.count
                can_undo <- HistoryPolicy::can_undo(history.cursor)
                can_redo <- HistoryPolicy::can_redo(history.cursor, history.count)
                is_dirty <- HistoryState::dirty(&history)
            if timeline is t:
                StudioPanels::toolbar(t, flags, can_undo, can_redo)
                StudioDraw::text(StudioPanels::button_x(StudioPanels::BUTTONS) + 8.0, 16.0, 12.0, "?  shortcuts", StudioDraw::muted())
                for i in 0..<3 |i|:
                    b: StudioPanels::Box = view_box(i)
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(38, 40, 46))
                if clip is c:
                    first: i64 = -1
                    last: i64 = -1
                    if StackState::valid(s, s.selected):
                        op: Ops::Operation = s.ops[s.selected]
                        StudioPanels::timeline(StudioPanels::timeline_box(w, h), c, t, op.first, op.last if op.last < c.frames else c.frames - 1)
                    else:
                        StudioPanels::timeline(StudioPanels::timeline_box(w, h), c, t, first, last)
                    StudioPanels::curves(StudioPanels::curve_box(w, h), c, bone, t.frame, curve_mode, &curve_memo, built)
                    perf_panel(c) if perf_overlay
                    StudioPanels::stack_panel(StudioPanels::sidebar_box(w, h), s, c, cursor, count)
                    StudioPanels::foot_marks(StudioPanels::timeline_box(w, h), c, hover_row)
                    StudioRetime::overlay(StudioPanels::timeline_box(w, h), c, &s, &selection, t.frame)
                    StudioRetime::controls(StudioPanels::curve_box(w, h), RetimeState::ready(&selection) or band_focus >= 0, retime_speed, typing, typed_view())
                    StudioPanels::cleanup_readout(StudioPanels::sidebar_box(w, h), c, readout_value(shown_slide, c.slide_after), readout_value(shown_sink, c.sink_after), readout_value(shown_hand_slide, c.hand_slide_after), s.blend)
                    StudioPanels::file_menu_panel(StudioPanels::sidebar_box(w, h), file_menu_open, true, file_menu_focus, file_menu_hover)
                    UiCore::request_frame_after(0.016) if readout_progress() < StudioFoot::FULL
                    drawn_frame <- t.frame
            screen: i64 = StudioChrome::chrome_screen(clip != null, load_failed)
            if screen != StudioChrome::SCREEN_EDIT:
                StudioPanels::guide(w, h, screen)
            StudioPanels::status_bar(StudioPanels::status_box(w, h), frame_now(), frames(), rate(), s.selected if StackState::valid(s, s.selected) else -1, gain_slide, gain_spikes, is_dirty, message(s))
            StudioPanels::tooltip(hover_button)
            StudioPanels::help_sheet(w, h) if help_open
            scale: f32 = UiAppKitCanvas::backing_scale()
            sync_view(0, scale)
            sync_view(1, scale)
            sync_view(2, scale)
            draw_us <- ((UiAppKitCanvas::monotonic_time() - draw_start) * 1000000.0).i64()

        # Status message, with the live value of a running drag or the
        # parameter just nudged, in its unit.
        def message(s: StackState::Stack&) -> sview:
            if gizmo_drag != null and readout_angle >= 0:
                StudioText::begin()
                StudioText::put("rotate ")
                StudioText::put_i(readout_angle / 10)
                StudioText::put(".")
                StudioText::put_i(readout_angle % 10)
                StudioText::put("°   move ")
                StudioText::put_i(readout_mm)
                StudioText::put(" mm   (Esc cancels)")
                return StudioText::view()
            if nudged_row == -2:
                StudioText::begin()
                StudioText::put("blend ")
                StudioPanels::frames_put(s.blend)
                return StudioText::view()
            if nudged_row >= 0 and StackState::valid(s, nudged_row):
                op: Ops::Operation = s.ops[nudged_row]
                StudioText::begin()
                StudioText::put(StackState::kind_label(op.kind))
                StudioText::put(": ")
                StudioPanels::param_put(op)
                return StudioText::view()
            if status_file is file:
                StudioText::begin()
                StudioText::put(status)
                StudioText::put(" ")
                StudioPanels::file_name_put(file)
                return StudioText::view()
            return status

        def camera_input(i: i64, dx: f32, dy: f32) -> void:
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                scale: f32 = UiAppKitCanvas::backing_scale()
                if drag_button == 0:
                    _ = ViewportCamera::orbit(&vp.camera, (dx * scale).i64(), (dy * scale).i64())
                else:
                    _ = ViewportCamera::pan(&vp.camera, dx * scale, dy * scale)
                Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                put_view(i, vp)
                UiCore::request_frame_after(0.001)

        def zoom(i: i64, notches: i64) -> void:
            if view(i) is opened:
                mutable vp: Viewport::Viewport = opened
                _ = ViewportCamera::zoom(&vp.camera, notches)
                Viewport::invalidate(&vp, ViewportPolicy::DIRTY_CAMERA)
                put_view(i, vp)
                UiCore::request_frame_after(0.001)

        # A click (no drag) in a view picks the joint under it.
        def pick(i: i64, x: f32, y: f32) -> void:
            if view(i) is opened:
                if clip is c:
                    b: StudioPanels::Box = view_box(i)
                    scale: f32 = UiAppKitCanvas::backing_scale()
                    hit: i64 = StudioScene::pick(opened.camera, c, frame_now(), flags, (x - b.x) * scale, (y - b.y) * scale)
                    if hit >= 0:
                        bone <- hit
                        status <- "bone selected"
                        nudged_row <- -1
                        status_file <- null
                        touch()

        def toolbar_action(a: i64) -> void:
            if a == StudioPanels::A_PLAY:
                toggle_play()
            elif a == StudioPanels::A_BACK:
                step_frames(-1)
            elif a == StudioPanels::A_FORWARD:
                step_frames(1)
            elif a == StudioPanels::A_SPEED:
                cycle_speed()
            elif a == StudioPanels::A_LOOP:
                toggle_loop()
            elif a == StudioPanels::A_UNDO:
                undo()
            elif a == StudioPanels::A_REDO:
                redo()
            elif a == StudioPanels::A_TRAILS:
                toggle_flag(StudioScene::TRAILS)
            elif a == StudioPanels::A_CONTACTS:
                toggle_flag(StudioScene::CONTACTS)
            elif a == StudioPanels::A_HEAT:
                toggle_flag(StudioScene::HEAT)
            elif a == StudioPanels::A_ONION:
                toggle_flag(StudioScene::ONION)
            elif a == StudioPanels::A_GHOST:
                toggle_flag(StudioScene::GHOST)
            elif a == StudioPanels::A_XRAY:
                toggle_flag(StudioScene::XRAY)
            elif a == StudioPanels::A_MESH:
                toggle_flag(StudioScene::MESH)
                status <- ("mesh on" if StudioScene::on(flags, StudioScene::MESH) else "mesh off") if mesh != null else "mesh: no skinned mesh in this file"
                nudged_row <- -1
                status_file <- null
            elif a == StudioPanels::A_FRAME:
                frame_all()
            elif a == StudioPanels::A_OPEN:
                open_take()
            elif a == StudioPanels::A_EXPORT:
                export_clip()
            elif a == StudioPanels::A_BALANCE:
                toggle_flag(StudioScene::BALANCE)
                if clip is c:
                    status <- StudioText::number("balance impossible frames: ", c.impossible_frames)
                    nudged_row <- -1
                    status_file <- null

        def pointer_down(x: f32, y: f32, button: i32) -> void:
            w: f32 = UiCore::viewport_width()
            h: f32 = UiCore::viewport_height()
            down_x <- x
            down_y <- y
            last_x <- x
            last_y <- y
            sb: StudioPanels::Box = StudioPanels::sidebar_box(w, h)
            if file_menu_open:
                if StudioPanels::inside(StudioPanels::file_button_box(sb), x, y):
                    file_menu_open <- false
                    file_menu_hover <- -1
                    touch()
                    return
                if StudioPanels::file_popup_contains(sb, x, y):
                    activate_file_menu(StudioPanels::file_popup_row(sb, x, y)) if button == 0
                    return
                file_menu_open <- false
                file_menu_hover <- -1
                touch()
            a: i64 = StudioPanels::toolbar_hit(x, y)
            if a >= 0:
                toolbar_action(a)
                return
            tb: StudioPanels::Box = StudioPanels::timeline_box(w, h)
            if button == 0:
                return if retime_down(tb, StudioPanels::curve_box(w, h), x, y)
            if StudioPanels::inside(tb, x, y) and button == 0:
                return if contact_down(x, y)
            if StudioPanels::inside(tb, x, y) or StudioPanels::inside(StudioPanels::curve_box(w, h), x, y):
                scrubbing <- true
                scrub_to(StudioPanels::timeline_frame(tb, x, frames()))
                return
            if StudioPanels::inside(sb, x, y):
                if clip != null and StudioPanels::inside(StudioPanels::file_button_box(sb), x, y) and button == 0:
                    file_menu_open <- true
                    file_menu_focus <- 0
                    file_menu_hover <- -1
                    help_open <- false
                    touch()
                    return
                s: StackState::Stack = current_stack()
                hit: i64 = StudioPanels::stack_hit(sb, s, x, y)
                if hit >= 0:
                    row_action(hit)
                return
            v: i64 = view_at(x, y)
            if v >= 0 and button == 0 and gizmo_mode >= 0:
                return if gizmo_press(v, x, y)
            if v >= 0:
                drag_view <- v
                drag_button <- button

        # Shift-drag selects, a band edge drags, a band click focuses it,
        # presets and the slider set the speed.
        def retime_down(tb: StudioPanels::Box, cb: StudioPanels::Box, x: f32, y: f32) -> bool:
            k: i64 = StudioRetime::preset_hit(cb, x, y)
            if k >= 0:
                retime_to(RetimeState::preset(k))
                return true
            if StudioPanels::inside(StudioRetime::slider_box(cb), x, y):
                slider_drag <- true
                slider_start_speed <- retime_speed
                retime_speed <- StudioRetime::slider_speed(cb, x)
                touch()
                return true
            return false if not StudioPanels::inside(tb, x, y)
            f: i64 = StudioPanels::timeline_frame(tb, x, frames())
            if StudioShortcuts::shift(modifiers):
                selection <- RetimeState::begin(f)
                selecting <- true
                touch()
                return true
            if clip is c:
                if StudioRetime::band_row(tb, y):
                    s: StackState::Stack = current_stack()
                    src: i64 = StudioModel::source_frame(c, f)
                    reach: i64 = 1 + c.source_frames / 200
                    edge_drag <- RetimeState::edge_near(&s, src, reach)
                    band_focus <- edge_drag.band if edge_drag.band >= 0 else StackState::band_at(&s, src)
                    if band_focus >= 0:
                        retime_speed <- s.bands[band_focus].speed
                        status <- "retime band (Del removes, presets set speed)"
                        touch()
                        return true
            return false

        def pointer_move(x: f32, y: f32) -> void:
            if file_menu_open:
                sb: StudioPanels::Box = StudioPanels::sidebar_box(UiCore::viewport_width(), UiCore::viewport_height())
                row: i64 = StudioPanels::file_popup_row(sb, x, y)
                if row != file_menu_hover:
                    file_menu_hover <- row
                    if row >= 0 and StudioFilePolicy::enabled(StudioFilePolicy::action(row), clip != null):
                        file_menu_focus <- row
                    touch()
                return
            over: i64 = StudioPanels::toolbar_hit(x, y)
            if over != hover_button:
                hover_button <- over
                touch()
            if selecting or slider_drag:
                w: f32 = UiCore::viewport_width()
                h: f32 = UiCore::viewport_height()
                if selecting:
                    selection <- RetimeState::drag(selection, StudioPanels::timeline_frame(StudioPanels::timeline_box(w, h), x, frames()))
                else:
                    retime_speed <- StudioRetime::slider_speed(StudioPanels::curve_box(w, h), x)
                touch()
                return
            tbh: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
            row: i64 = StudioPanels::contact_row(tbh, y) if StudioPanels::inside(tbh, x, y) else -1
            if row != hover_row:
                hover_row <- row
                touch()
            if gizmo_view >= 0:
                gizmo_preview(x, y)
                last_x <- x
                last_y <- y
                return
            if scrubbing:
                tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
                scrub_to(StudioPanels::timeline_frame(tb, x, frames()))
            elif drag_view >= 0:
                camera_input(drag_view, x - last_x, y - last_y)
            last_x <- x
            last_y <- y

        def pointer_up(x: f32, y: f32) -> void:
            if selecting:
                selecting <- false
                selection <- RetimeState::none() if not RetimeState::ready(&selection) else selection
                status <- "range selected: preset, slider or = to set speed, Esc cancels" if selection.active else status
                touch()
                return
            if slider_drag:
                slider_drag <- false
                retime_to(retime_speed)
                return
            if edge_drag.band >= 0:
                if clip is c:
                    tb: StudioPanels::Box = StudioPanels::timeline_box(UiCore::viewport_width(), UiCore::viewport_height())
                    src: i64 = StudioModel::source_frame(c, StudioPanels::timeline_frame(tb, x, frames()))
                    mutable s: StackState::Stack = current_stack()
                    if StackState::move_band_edge(&s, edge_drag.band, edge_drag.last_edge, src, c.source_frames):
                        commit(s, true)
                        status <- "retime band edge moved"
                edge_drag <- RetimeState::no_drag()
                return
            if FootState::active(&foot_press):
                contact_up(x)
                return
            if gizmo_view >= 0:
                gizmo_release(x, y)
                return
            if drag_view >= 0 and drag_button == 0:
                moved: f32 = (x - down_x) * (x - down_x) + (y - down_y) * (y - down_y)
                if moved < 9.0:
                    pick(drag_view, x, y)
            drag_view <- -1
            drag_button <- -1
            scrubbing <- false

        # ---- gizmo (Phase 3 corrections) ---------------------------------
        def active_handle() -> i64:
            if gizmo_drag is d:
                return d.handle
            GizmoPolicy::NONE

        def set_gizmo(mode: i64) -> void:
            gizmo_mode <- -1 if gizmo_mode == mode else mode
            gizmo_view <- -1
            gizmo_drag <- null
            status <- ("gizmo: rotate (drag a ring)" if gizmo_mode == GizmoPolicy::ROTATE else "gizmo: translate (drag an arrow)") if gizmo_mode >= 0 else "gizmo off"
            nudged_row <- -1
            status_file <- null
            touch()

        # Pixel of window point (x, y) in view `i`.
        def view_px(i: i64, x: f32) -> f32:
            b: StudioPanels::Box = view_box(i)
            (x - b.x) * UiAppKitCanvas::backing_scale()

        def view_py(i: i64, y: f32) -> f32:
            b: StudioPanels::Box = view_box(i)
            (y - b.y) * UiAppKitCanvas::backing_scale()

        # Start a gizmo drag when (x, y) hits a handle of the selected bone.
        def gizmo_press(i: i64, x: f32, y: f32) -> bool:
            if view(i) is opened:
                if clip is c:
                    return false if bone < 0
                    g: ViewportGizmo::Gizmo = StudioScene::gizmo_for(c, frame_now(), bone, gizmo_mode)
                    handle: i64 = ViewportGizmo::pick(&opened.camera, &g, view_px(i, x), view_py(i, y))
                    return false if handle == GizmoPolicy::NONE
                    r: PoseOverride::Rig = StudioModel::rig(c)
                    held: PoseOverride::Overrides = PoseOverride::overrides(&r)
                    mutable d: ViewportGizmo::Drag = ViewportGizmo::idle()
                    ok: bool = catch ViewportGizmo::begin(&d, &opened.camera, &g, handle, view_px(i, x), view_py(i, y), &held, &r, bone.usize(), StudioScene::bone_model(c, frame_now(), bone)):
                        value: value
                        error failure: false
                    return false if not ok
                    gizmo_drag <- d
                    gizmo_view <- i
                    status <- "gizmo drag"
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return true
            false

        # Track the drag goal so the scene draws the live preview.
        def gizmo_preview(x: f32, y: f32) -> void:
            i: i64 = gizmo_view
            if gizmo_drag is d:
                if view(i) is opened:
                    goal: Geometry::Transform = ViewportGizmo::goal(d, &opened.camera, view_px(i, x), view_py(i, y))
                    gizmo_goal <- goal
                    if clip is c:
                        r: PoseOverride::Rig = StudioModel::rig(c)
                        fix: Corrections::Correction = StudioModel::correction_for(c, r, bone, frame_now(), goal)
                        readout_angle <- StudioReadout::angle_tenths(fix.rotation)
                        readout_mm <- StudioReadout::millimetres(fix.translation)
                    touch()

        # Key the dragged pose at the current frame as a correction.
        def gizmo_release(x: f32, y: f32) -> void:
            i: i64 = gizmo_view
            gizmo_view <- -1
            if gizmo_drag is d:
                if view(i) is opened:
                    if clip is c:
                        goal: Geometry::Transform = ViewportGizmo::goal(d, &opened.camera, view_px(i, x), view_py(i, y))
                        r: PoseOverride::Rig = StudioModel::rig(c)
                        fix: Corrections::Correction = StudioModel::correction_for(c, r, bone, frame_now(), goal)
                        mutable s: StackState::Stack = current_stack()
                        if StackState::add_fix(&s, fix):
                            commit(s, true)
                            status <- "correction keyed"
                            nudged_row <- -1
                            status_file <- null
                        else:
                            status <- "corrections full (16)"
                            nudged_row <- -1
                            status_file <- null
            gizmo_drag <- null
            gizmo_goal <- null
            readout_angle <- -1
            readout_mm <- -1
            touch()

        def gizmo_cancel() -> void:
            readout_angle <- -1
            readout_mm <- -1
            gizmo_view <- -1
            gizmo_drag <- null
            gizmo_goal <- null
            status <- "gizmo drag cancelled"
            nudged_row <- -1
            status_file <- null
            touch()

        # A native focus loss may suppress the matching pointer-up. Cancel
        # every unfinished gesture so it cannot commit when focus returns.
        def focus_lost() -> void:
            was_gizmo: bool = gizmo_view >= 0
            mutable f: StudioFocus::Interaction = StudioFocus::Interaction{
                modifiers: modifiers,
                drag_view: drag_view,
                drag_button: drag_button.i64(),
                scrubbing: scrubbing,
                selecting: selecting,
                slider_drag: slider_drag,
                retime_speed: retime_speed,
                slider_start_speed: slider_start_speed,
                edge_drag_band: edge_drag.band,
                contact_press: FootState::active(&foot_press),
                gizmo_view: gizmo_view,
                typing: typing,
                selection_active: selection.active,
                gizmo_mode: gizmo_mode
            }
            f <- StudioFocus::after_focus_lost(f)
            file_menu_open <- false
            file_menu_hover <- -1
            modifiers <- f.modifiers
            drag_view <- f.drag_view
            drag_button <- f.drag_button.i32()
            scrubbing <- f.scrubbing
            selecting <- f.selecting
            slider_drag <- f.slider_drag
            retime_speed <- f.retime_speed
            edge_drag <- RetimeState::no_drag()
            foot_press <- FootState::idle()
            gizmo_view <- f.gizmo_view
            typing <- f.typing
            typed_len <- 0
            selection <- RetimeState::none() if not f.selection_active else selection
            if was_gizmo:
                gizmo_cancel()
            else:
                gizmo_drag <- null
                gizmo_goal <- null
                readout_angle <- -1
                readout_mm <- -1
            touch()

        # Escape peels one layer: the sheet, a drag, a contact press, the
        # gizmo, then the selection (StudioChrome::escape_layer).
        def escape() -> void:
            s: StackState::Stack = current_stack()
            layer: i64 = StudioChrome::escape_layer(help_open, gizmo_view >= 0, FootState::active(&foot_press), gizmo_mode >= 0, StackState::valid(s, s.selected))
            if layer == StudioChrome::ESC_HELP:
                help_open <- false
            elif layer == StudioChrome::ESC_DRAG:
                gizmo_cancel()
            elif layer == StudioChrome::ESC_PRESS:
                foot_press <- FootState::idle()
                status <- "contact edit cancelled"
                nudged_row <- -1
                status_file <- null
            elif layer == StudioChrome::ESC_GIZMO:
                set_gizmo(gizmo_mode)
            elif layer == StudioChrome::ESC_SELECT:
                select_row(-1)
                status <- "selection cleared"
                nudged_row <- -1
                status_file <- null
            touch()

        def key(code: UiCore::Key) -> void:
            if typing and code == UiCore::Key.Enter:
                typing <- false
                v: i64 = typed_speed()
                if v > 0:
                    retime_to(v)
                else:
                    status <- "speed must be 0.1 to 4"
                touch()
            elif typing and code == UiCore::Key.Backspace:
                typed_len <- typed_len - 1 if typed_len > 0 else 0
                touch()
            elif typing and code != UiCore::Key.Escape:
                pass
            elif code == UiCore::Key.Equal:
                typing <- true
                typed_len <- 0
                touch()
            elif StudioShortcuts::shift(modifiers) and preset_key(code) >= 0:
                retime_to(RetimeState::preset(preset_key(code)))
            elif band_focus >= 0 and (code == UiCore::Key.Delete or code == UiCore::Key.Backspace):
                remove_band()
            elif code == UiCore::Key.R:
                set_gizmo(GizmoPolicy::ROTATE)
            elif code == UiCore::Key.V:
                set_gizmo(GizmoPolicy::TRANSLATE)
            elif code == UiCore::Key.Escape and not help_open and (typing or selection.active):
                typing <- false
                selection <- RetimeState::none()
                status <- "retime selection cancelled"
                touch()
            elif code == UiCore::Key.Escape:
                escape()
            elif code == UiCore::Key.A:
                clean_with_preset()
            elif code == UiCore::Key.Space:
                toggle_play()
            elif code == UiCore::Key.Left:
                step_frames(-1)
            elif code == UiCore::Key.Right:
                step_frames(1)
            elif code == UiCore::Key.Z:
                undo()
            elif code == UiCore::Key.Y:
                redo()
            elif code == UiCore::Key.L:
                toggle_loop()
            elif code == UiCore::Key.S:
                cycle_speed()
            elif code == UiCore::Key.T:
                toggle_flag(StudioScene::TRAILS)
            elif code == UiCore::Key.C:
                toggle_flag(StudioScene::CONTACTS)
            elif code == UiCore::Key.H:
                toggle_flag(StudioScene::HEAT)
            elif code == UiCore::Key.N:
                toggle_flag(StudioScene::ONION)
            elif code == UiCore::Key.G:
                toggle_flag(StudioScene::GHOST)
            elif code == UiCore::Key.X:
                toggle_flag(StudioScene::XRAY)
            elif code == UiCore::Key.Q:
                toolbar_action(StudioPanels::A_BALANCE)
            elif code == UiCore::Key.P:
                curve_mode <- StudioOverlay::next_mode(curve_mode)
                status <- "curves: position" if curve_mode == StudioOverlay::POSITION else "curves: rotation"
                nudged_row <- -1
                status_file <- null
                touch()
            elif code == UiCore::Key.K:
                toggle_feet()
            elif code == UiCore::Key.J:
                toggle_hands()
            elif code == UiCore::Key.W:
                jump_worst()
            elif code == UiCore::Key.Comma:
                nudge_blend(false)
            elif code == UiCore::Key.Period:
                nudge_blend(true)
            elif code == UiCore::Key.M:
                toggle_action_mesh()
            elif code == UiCore::Key.F and StudioShortcuts::shift(modifiers):
                perf_overlay <- not perf_overlay
                status <- "frame times on" if perf_overlay else "frame times off"
                nudged_row <- -1
                status_file <- null
                touch()
            elif code == UiCore::Key.F:
                frame_all()
            elif code == UiCore::Key.E:
                export_clip()
            elif code == UiCore::Key.LeftBracket:
                edit_selected(7, -1)
            elif code == UiCore::Key.RightBracket:
                edit_selected(7, 1)
            elif code == UiCore::Key.B:
                edit_selected(8, 0)
            elif code == UiCore::Key.I:
                edit_selected(9, 0)
            elif code == UiCore::Key.O:
                edit_selected(10, 0)
            elif code == UiCore::Key.D:
                edit_selected(StudioPanels::HIT_TOGGLE, 0)
            elif code == UiCore::Key.Delete or code == UiCore::Key.Backspace:
                edit_selected(StudioPanels::HIT_REMOVE, 0)
            elif code == UiCore::Key.PageUp:
                edit_selected(StudioPanels::HIT_UP, 0)
            elif code == UiCore::Key.PageDown:
                edit_selected(StudioPanels::HIT_DOWN, 0)
            elif code == UiCore::Key.Up:
                s: StackState::Stack = current_stack()
                select_row(s.selected - 1) if s.selected > 0
            elif code == UiCore::Key.Down:
                s: StackState::Stack = current_stack()
                select_row(s.selected + 1) if s.selected + 1 < s.count
            elif code == UiCore::Key.Digit1:
                add_op(0)
            elif code == UiCore::Key.Digit2:
                add_op(1)
            elif code == UiCore::Key.Digit3:
                add_op(2)
            elif code == UiCore::Key.Digit4:
                add_op(3)
            elif code == UiCore::Key.Digit5:
                add_op(4)

        # Track Cmd/Ctrl and Shift; true when `code` was a modifier.
        def modifier(code: UiCore::Key, down: bool) -> bool:
            command: bool = code == UiCore::Key.LeftSuper or code == UiCore::Key.RightSuper or code == UiCore::Key.LeftControl or code == UiCore::Key.RightControl
            shift: bool = code == UiCore::Key.LeftShift or code == UiCore::Key.RightShift
            if command:
                modifiers <- StudioShortcuts::command_down(modifiers) if down else StudioShortcuts::command_up(modifiers)
            elif shift:
                modifiers <- StudioShortcuts::shift_down(modifiers) if down else StudioShortcuts::shift_up(modifiers)
            return command or shift

        # Cmd-Z undo, Cmd-Shift-Z redo; other Cmd chords are ignored and
        # plain keys go to the single-key bindings.
        def key_down(code: UiCore::Key) -> void:
            return if modifier(code, true)
            command: bool = StudioShortcuts::command(modifiers)
            mutable file: i64 = StudioShortcuts::FILE_NONE
            if code == UiCore::Key.O:
                file <- StudioShortcuts::o_chord(modifiers)
            elif code == UiCore::Key.S:
                file <- StudioShortcuts::s_chord(modifiers)
            elif code == UiCore::Key.E:
                file <- StudioShortcuts::e_chord(modifiers)
            if file != StudioShortcuts::FILE_NONE:
                modifiers <- 0
                dispatch_file_action(StudioFilePolicy::OPEN_TAKE) if file == StudioShortcuts::OPEN_TAKE
                dispatch_file_action(StudioFilePolicy::OPEN_SESSION) if file == StudioShortcuts::OPEN_SESSION
                dispatch_file_action(StudioFilePolicy::SAVE) if file == StudioShortcuts::SAVE
                dispatch_file_action(StudioFilePolicy::SAVE_AS) if file == StudioShortcuts::SAVE_AS
                dispatch_file_action(StudioFilePolicy::EXPORT_AS) if file == StudioShortcuts::EXPORT_AS
                return
            if file_menu_open:
                file_menu_key(code)
                return
            if code == UiCore::Key.Slash and not command:
                help_open <- StudioChrome::help_after(help_open, true, false)
                touch()
                return
            if help_open and code != UiCore::Key.Escape:
                return
            action: i64 = StudioShortcuts::z_chord(modifiers) if code == UiCore::Key.Z else StudioShortcuts::other_chord(modifiers)
            if action == StudioShortcuts::UNDO:
                undo()
            elif action == StudioShortcuts::REDO:
                redo()
            elif action == StudioShortcuts::PLAIN:
                key(code)

        def toggle_action_mesh() -> void:
            toolbar_action(StudioPanels::A_MESH)

        def event(incoming: UiCore::Event) -> void:
            match incoming:
                UiCore::PointerEvent.Down(at, button):
                    pointer_down(at.x, at.y, button)
                UiCore::PointerEvent.Up(at, button):
                    pointer_up(at.x, at.y)
                UiCore::PointerEvent.Move(at):
                    pointer_move(at.x, at.y)
                UiCore::PointerEvent.Scroll(at, delta):
                    v: i64 = view_at(at.x, at.y)
                    if v >= 0:
                        zoom(v, 1 if delta.y > 0.0 else (-1 if delta.y < 0.0 else 0))
                UiCore::KeyEvent.Down(code):
                    key_down(code)
                UiCore::KeyEvent.Up(code):
                    modifier(code, false)
                UiCore::Event.FocusLost:
                    focus_lost()
                _:
                    pass
            UiCore::request_frame_after(0.001)

def app_init() -> void:
    Studio::init()

def app_widget_event(widget: usize, event: i32) -> void:
    pass

def app_event(event: UiCore::Event) -> void:
    Studio::event(event)

def app_text_input(text: sview) -> void:
    Studio::text_input(text)

def app_validate() -> void:
    pass

def app_text_editing(text: sview, selected_start: i32, selected_length: i32) -> void:
    pass

def app_frame() -> void:
    Studio::frame()

def appkit_canvas_file_drop_callback(window_handle: usize, path: cstr) -> void can Unsafe.PointerCast:
    return if not UiAppKitCanvas::live() or window_handle != UiAppKitCanvas::window_handle()
    Studio::load_take(path)

export fn elisa_appkit_canvas_file_drop(window_handle: usize, path: cstr) -> void can Unsafe.PointerCast = appkit_canvas_file_drop_callback
