include "../report_text_policy.elisa"

# Export formatting has at most 146 simultaneous views at current stack limits.
# Each operation, band, contact or correction-scope description fits 512 bytes
# even with full i64 fields. Views remain separate until both reports serialize.
module StudioReportText:
    private:
        global mutable buffer: u8[81920] = zeroed
        global mutable slot: i64 = 0
        global mutable start: usize = 0
        global mutable length: usize = 0
        global mutable snapshot_overflowed: bool = false
        global mutable snapshot_views: i64 = 0

        # Keep the accumulator negative so i64 minimum never needs negation.
        def negative_digits(value: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                negative_digits(value / 10) if value <= -10
                byte((48 - value % 10).u8())

        def u32_ref(value: u32&) -> u32:
            value

        # Same binary32 load representation used by the engine GLB writer.
        # This is a native representation boundary, not numeric rounding.
        def float_bits(value: f32) -> u32 can Unsafe.PointerCast:
            u32_ref((&value).cast[u32&])

    public:
        # Every view belongs to this synchronous report preparation. An
        # oversized field invalidates the complete snapshot, not just its view.
        def begin_snapshot() -> void can[Global.Write]:
            can Global.Write:
                snapshot_overflowed <- false
                snapshot_views <- 0
                slot <- 0

        def snapshot_complete() -> bool can[Global.Read]:
            can Global.Read:
                return not snapshot_overflowed

        def put_f32_bits(value: f32) -> void can[Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                put_i(StudioReportTextPolicy::bits_integer(float_bits(value)))

        def begin() -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                length <- 0
                if snapshot_overflowed or not StudioReportTextPolicy::view_admitted(snapshot_views):
                    snapshot_overflowed <- true
                    return
                snapshot_views <- snapshot_views + 1
                start <- StudioReportTextPolicy::offset(slot).usize()
                slot <- StudioReportTextPolicy::next_slot(slot)

        def byte(value: u8) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if snapshot_overflowed
                if not StudioReportTextPolicy::byte_admitted(length.i64()):
                    snapshot_overflowed <- true
                    return
                buffer[start + length] <- value
                length <- length + 1

        def put(value: sview) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if value.len <= 0 or value.data == null
                for index in 0..<value.len.usize():
                    byte(value.data[index])

        def put_i(value: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                if value < 0:
                    byte(45)
                    negative_digits(value)
                else:
                    negative_digits(0 - value)

        def view() -> sview can[Unsafe.PointerCast, Global.Read]:
            can Global.Read:
                return UiText::fixed_bytes_view_range[81920](buffer, start, length)
