# Shared dimensions for retime drawing and hit targets.
module StudioRetime:
    public:
        const module Geometry:
            PRESET_W: f32 = 44.0
            ROW_H: f32 = 18.0
            SLIDER_W: f32 = 140.0
            # Band row inside the timeline strip.
            BAND_Y: f32 = 2.0
            BAND_H: f32 = 11.0
