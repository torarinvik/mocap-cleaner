# Per-frame text for the studio's immediate-mode panels. elisa-ui draws a
# TextRun as a view that must outlive the frame, so numbers are formatted
# into fixed slots of one static buffer (never a per-frame allocation) and
# each slot is viewed once per frame. Slots wrap; a frame uses fewer than
# SLOTS runs of formatted text.
include "../text_truncation_policy.elisa"

module StudioText:
    public:
        const module Buffer:
            SLOTS: usize = 96
            WIDTH: usize = 128
            CAPACITY: usize = 12288

    private:
        global mutable buffer: u8[Buffer::CAPACITY] = zeroed
        global mutable next: usize = 0
        global mutable start: usize = 0
        global mutable length: usize = 0

    public:
        # Start formatting into the next slot.
        def begin() -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                start <- (next % Buffer::SLOTS) * Buffer::WIDTH
                next <- next + 1
                length <- 0

        def byte(b: u8) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if length >= Buffer::WIDTH
                buffer[start + length] <- b
                length <- length + 1

        def put(text: sview) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if text.len <= 0 or text.data == null
                for i in 0..<text.len.usize():
                    byte(text.data[i])

        def put_i(value: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                if value < 0:
                    byte(45)
                    if value > -1000000000000:
                        put_i(0 - value)
                    return
                if value >= 10:
                    put_i(value / 10)
                byte((48 + value % 10).u8())

        # Fixed-point micro-units (GlbTracks::FixedPoint::SCALE) with three decimals.
        def put_fixed3(value: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                if value < 0:
                    byte(45)
                v: i64 = value if value >= 0 else 0 - value
                put_i(v / 1000000)
                byte(46)
                m: i64 = (v % 1000000) / 1000
                byte((48 + m / 100).u8())
                byte((48 + (m / 10) % 10).u8())
                byte((48 + m % 10).u8())

        # Exact nonnegative clip-relative microseconds, without truncation.
        def put_seconds6(value: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                v: i64 = value if value >= 0 else 0
                put_i(v / 1000000)
                byte(46)
                divisor: mutable i64 = 100000
                for digit in 0..<6:
                    byte((48 + (v / divisor) % 10).u8())
                    divisor <- divisor / 10

        def view() -> sview can[Unsafe.PointerCast, Global.Read]:
            can Global.Read:
                # A slot can fill halfway through a filename's UTF-8 scalar. Keep
                # the raw bytes for later appends, but expose only complete text.
                raw: sview = UiText::fixed_bytes_view_range(buffer, start, length)
                complete: usize = UiText::valid_utf8_prefix(raw, length)
                return UiText::fixed_bytes_view_range(buffer, start, complete)

        # Finish a shortened label only at a complete UTF-8 scalar boundary.
        # The caller retains the complete original path for inspection.
        def truncated_view() -> sview can[Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                capacity: usize = StudioTextTruncationPolicy::prefix_capacity(Buffer::WIDTH)
                length <- UiText::valid_utf8_prefix(view(), capacity)
                put("...")
                return view()

        # One-call helpers: "<label><n>" and "<label><a><mid><b>".
        def number(label: sview, n: i64) -> sview can[Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                StudioText::begin()
                put(label)
                put_i(n)
                return view()

        def pair(label: sview, a: i64, mid: sview, b: i64) -> sview can[Unsafe.PointerCast, Global{Read, Write}]:
            can Global{Read, Write}:
                StudioText::begin()
                put(label)
                put_i(a)
                put(mid)
                put_i(b)
                return view()
