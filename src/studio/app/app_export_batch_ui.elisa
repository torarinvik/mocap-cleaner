include "app_export_batch_warning_review.elisa"

# Single modal entry point for eventual app composition. The report receives
# input before its underlying sheet; outside clicks are consumed while open.
extend Studio:
    private:
        def prepared_batch_modal_open() -> bool:
            prepared_report_open or prepared_sheet_open()

        def prepared_batch_key(code: UiCore::Key) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            if prepared_report_open:
                prepared_report_key(code)
                return true
            if prepared_sheet_open():
                prepared_sheet_key(code)
                return true
            false

        def prepared_batch_pointer(w: f32, h: f32, x: f32, y: f32) -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            if prepared_report_open:
                prepared_report_pointer(w, h, x, y)
                return true
            if prepared_sheet_open():
                prepared_sheet_pointer(w, h, x, y)
                return true
            false

        def draw_prepared_batch(w: f32, h: f32) -> void:
            draw_prepared_sheet(w, h)
            draw_prepared_report(w, h)
