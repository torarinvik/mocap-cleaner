include "panels_geometry.elisa"
include "../workspace_path_display_policy.elisa"
include "../workspace_entry_layout_policy.elisa"
include "../session_locate_policy.elisa"

extend StudioPanels:
    public:
        def file_button_box(sb: Box) -> Box:
            box(sb.x + StudioWorkspaceEntryLayoutPolicy::Geometry::LEFT, sb.y + StudioWorkspaceEntryLayoutPolicy::Geometry::TOP,
                StudioWorkspaceEntryLayoutPolicy::Geometry::WIDTH, StudioWorkspaceEntryLayoutPolicy::Geometry::HEIGHT)

        def file_popup_box(sb: Box, create_pending: bool) -> Box:
            box(sb.x + StudioWorkspaceEntryLayoutPolicy::Geometry::LEFT, sb.y + StudioWorkspaceEntryLayoutPolicy::Geometry::POPUP_TOP, Menu::FILE_WIDTH, Menu::FILE_ROW * StudioFilePolicy::row_count(create_pending).f32() + 32.0)

        def file_popup_contains(sb: Box, px: f32, py: f32, create_pending: bool) -> bool:
            inside(file_popup_box(sb, create_pending), px, py)

        def file_popup_row(sb: Box, px: f32, py: f32, create_pending: bool) -> i64:
            p: Box = file_popup_box(sb, create_pending)
            return -1 if not inside(p, px, py)
            offset: i64 = (py - p.y).i64()
            StudioFilePolicy::row_at_offset(offset, Menu::FILE_ROW.i64(), create_pending)

        def file_menu_row_box(sb: Box, row: i64, create_pending: bool) -> Box:
            requires row >= 0
            requires row < StudioFilePolicy::row_count(create_pending)
            p: Box = file_popup_box(sb, create_pending)
            box(p.x + 4.0, p.y + StudioFilePolicy::Count::HEADER_HEIGHT.f32() + row.f32() * Menu::FILE_ROW,
                p.w - 8.0, Menu::FILE_ROW)

        def file_menu_header_box(sb: Box, create_pending: bool) -> Box:
            p: Box = file_popup_box(sb, create_pending)
            box(p.x + 4.0, p.y + 2.0, p.w - 8.0, StudioFilePolicy::Count::HEADER_HEIGHT.f32() - 4.0)

    private:
        def file_menu_label(row: i64) -> sview:
            return "Open Take (GLB/FBX)..." if row == 0
            return "Open Session..." if row == 1
            return "Save Session" if row == 2
            return "Save Session As..." if row == 3
            return "Export Cleaned GLB" if row == 4
            return "Export As..." if row == 5
            return "Storage & Recovery" if row == 6
            return "Load Character GLB..." if row == 7
            return "Locate workspace..." if row == StudioFilePolicy::Count::BASE_ROWS - 1
            return "Create build/ here" if row == StudioFilePolicy::Count::BASE_ROWS
            "Cancel workspace setup"

    public:
        def file_menu_shortcut(row: i64) -> sview:
            return "Cmd-O" if row == 0
            return "Cmd-Shift-O" if row == 1
            return "Cmd-S" if row == 2
            return "Cmd-Shift-S" if row == 3
            return "E" if row == 4
            return "Cmd-E" if row == 5
            return "Shift-M" if row == 7
            ""

        def file_menu_panel(sb: Box, opened: bool, has_take: bool, workspace_ready: bool, create_pending: bool, workspace_root: cstr?, focus: i64, hover: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                button: Box = file_button_box(sb)
                StudioDraw::rect(button.x, button.y, button.w, button.h, StudioDraw::color(58, 52, 40) if opened else StudioDraw::color(49, 55, 66))
                StudioDraw::bold(button.x + 10.0, button.y + 8.0, 12.0,
                    StudioWorkspaceEntryLayoutPolicy::trigger_label(workspace_ready, create_pending), StudioDraw::ink())
                StudioDraw::tri(button.x + button.w - 17.0, button.y + 12.0, button.x + button.w - 7.0, button.y + 12.0, button.x + button.w - 12.0, button.y + 18.0, StudioDraw::muted())
                return if not opened
                popup: Box = file_popup_box(sb, create_pending)
                StudioDraw::rect(popup.x, popup.y, popup.w, popup.h, StudioDraw::color(21, 24, 31))
                StudioText::begin()
                StudioText::put("Workspace: ")
                if workspace_root is root:
                    mutable root_bytes: i64 = 0
                    while root_bytes < StudioWorkspacePathDisplayPolicy::Limit::MAX_PATH_BYTES and root[root_bytes.usize()] != 0:
                        root_bytes <- root_bytes + 1
                    mutable index: usize = 0
                    while index < StudioWorkspacePathDisplayPolicy::Limit::ROOT_PREVIEW_BYTES.usize() and root[index] != 0:
                        StudioText::byte(root[index])
                        index <- index + 1
                    truncated: bool = StudioWorkspacePathDisplayPolicy::needs_ellipsis(root_bytes)
                    if truncated:
                        StudioText::put("...")
                else:
                    StudioText::put("unavailable")
                StudioDraw::text(popup.x + 12.0, popup.y + 8.0, 10.0, StudioText::view(), StudioDraw::muted())
                StudioDraw::segment(popup.x, popup.y, popup.x + popup.w, popup.y, 1.0, StudioDraw::color(82, 91, 108))
                StudioDraw::segment(popup.x + popup.w, popup.y, popup.x + popup.w, popup.y + popup.h, 1.0, StudioDraw::color(82, 91, 108))
                StudioDraw::segment(popup.x + popup.w, popup.y + popup.h, popup.x, popup.y + popup.h, 1.0, StudioDraw::color(82, 91, 108))
                StudioDraw::segment(popup.x, popup.y + popup.h, popup.x, popup.y, 1.0, StudioDraw::color(82, 91, 108))
                for row in 0..<StudioFilePolicy::row_count(create_pending) |row, popup, focus, hover, has_take, workspace_ready, create_pending|:
                    y: f32 = popup.y + StudioFilePolicy::Count::HEADER_HEIGHT.f32() + row.f32() * Menu::FILE_ROW
                    command: i64 = StudioFilePolicy::action_for(row, create_pending)
                    enabled: bool = StudioFilePolicy::available(command, has_take, workspace_ready)
                    label: sview = file_menu_label(row)
                    col: UiCore::Color = StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117)
                    if row == focus or row == hover:
                        StudioDraw::rect(popup.x + 4.0, y, popup.w - 8.0, Menu::FILE_ROW, StudioDraw::color(47, 55, 70))
                        StudioDraw::rect(popup.x + 4.0, y + 4.0, 2.0, Menu::FILE_ROW - 8.0, StudioDraw::accent()) if row == focus
                    StudioDraw::text(popup.x + 14.0, y + 7.0, 12.0, label, col)
                    StudioDraw::text(popup.x + popup.w - 78.0, y + 7.0, 10.0, file_menu_shortcut(row), StudioDraw::muted() if enabled else StudioDraw::color(75, 80, 91))

    private:
        def replacement_dialog_box(w: f32, h: f32) -> Box:
            box((w - 500.0) / 2.0, (h - 210.0) / 2.0, 500.0, 210.0)

        def replacement_button_box(w: f32, h: f32, index: i64) -> Box:
            d: Box = replacement_dialog_box(w, h)
            box(d.x + 22.0 + index.f32() * 152.0, d.y + 150.0, 136.0, 38.0)

    public:
        def replacement_button_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for index in 0..<StudioReplacement::Count::CHOICES |index, w, h, px, py|:
                return index if inside(replacement_button_box(w, h, index), px, py)
            -1

        def replacement_prompt_panel(w: f32, h: f32, opened: bool, focus: i64, save_failed: bool, closing: bool, quitting: bool) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if not opened
                d: Box = replacement_dialog_box(w, h)
                StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
                StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::bold(d.x + 22.0, d.y + 20.0, 18.0, "Unsaved session changes", StudioDraw::ink())
                mutable message: sview = "Opening another file replaces the current cleanup session."
                message <- "Closing the studio would discard the current cleanup session." if closing
                message <- "Quitting the studio would discard the current cleanup session." if quitting
                StudioDraw::text(d.x + 22.0, d.y + 58.0, 13.0, message, StudioDraw::ink())
                message <- "Save writes the current session before opening the selected file."
                message <- "Save writes the current session before closing the studio." if closing
                message <- "Save writes the current session before quitting the studio." if quitting
                StudioDraw::text(d.x + 22.0, d.y + 80.0, 12.0, message, StudioDraw::muted())
                StudioDraw::text(d.x + 22.0, d.y + 104.0, 12.0, "Save failed. Check the status bar, then retry, discard or cancel.", StudioDraw::color(245, 145, 100)) if save_failed
                StudioDraw::text(d.x + 22.0, d.y + 124.0, 11.0, "Left/Right choose   Enter select   S save   D discard   Esc cancel", StudioDraw::muted())
                for index in 0..<StudioReplacement::Count::CHOICES |index, w, h, focus|:
                    b: Box = replacement_button_box(w, h, index)
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if index == focus else StudioDraw::panel())
                    mutable label: sview = "Save and Open"
                    label <- "Save and Close" if closing
                    label <- "Save and Quit" if quitting
                    label <- "Discard and Open" if index == StudioReplacement::Focus.Discard.i64()
                    label <- "Discard and Close" if closing and index == StudioReplacement::Focus.Discard.i64()
                    label <- "Discard and Quit" if quitting and index == StudioReplacement::Focus.Discard.i64()
                    label <- "Cancel" if index == StudioReplacement::Focus.Cancel.i64()
                    StudioDraw::bold(b.x + 10.0, b.y + 11.0, 12.0, label, StudioDraw::ink())
                    StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if index == focus

    private:
        def legacy_session_dialog_box(w: f32, h: f32) -> Box:
            box((w - 560.0) / 2.0, (h - 260.0) / 2.0, 560.0, 260.0)

        def legacy_session_button_box(w: f32, h: f32, index: i64) -> Box:
            d: Box = legacy_session_dialog_box(w, h)
            box(d.x + 74.0 + index.f32() * 250.0, d.y + 204.0, 162.0, 38.0)

    public:
        def legacy_session_button_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for index in 0..<StudioLegacyPrompt::Count::CHOICES |index, w, h, px, py|:
                return index if inside(legacy_session_button_box(w, h, index), px, py)
            -1

        def legacy_session_prompt_panel(w: f32, h: f32, opened: bool, focus: i64) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if not opened
                d: Box = legacy_session_dialog_box(w, h)
                StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
                StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(245, 170, 92))
                StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::bold(d.x + 24.0, d.y + 22.0, 18.0, "Older session has no source identity", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, d.y + 62.0, 13.0, "This file cannot confirm which take, animation or rig it was saved for.", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, d.y + 88.0, 12.0, "Its operations may fit another take; corrections may affect different joints.", StudioDraw::muted())
                StudioDraw::text(d.x + 24.0, d.y + 111.0, 12.0, "Load it only if you know it matches the open take and rig.", StudioDraw::muted())
                StudioDraw::text(d.x + 24.0, d.y + 139.0, 11.0, "Unsaved edits get a separate Save, Discard or Cancel choice.", StudioDraw::muted())
                StudioDraw::text(d.x + 24.0, d.y + 164.0, 11.0, "Left/Right choose   Enter select   L load   Esc cancel", StudioDraw::muted())
                for index in 0..<StudioLegacyPrompt::Count::CHOICES |index, w, h, focus|:
                    b: Box = legacy_session_button_box(w, h, index)
                    selected: bool = index == focus
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                    label: sview = "Load legacy session" if index == StudioLegacyPrompt::Focus.Load.i64() else "Cancel"
                    StudioDraw::bold(b.x + 11.0, b.y + 11.0, 12.0, label, StudioDraw::ink())
                    StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

    public:
        def session_locate_dialog_box(w: f32, h: f32) -> Box:
            box((w - 600.0) / 2.0, (h - 320.0) / 2.0, 600.0, 320.0)

        def session_locate_button_box(w: f32, h: f32, choice: StudioSessionLocatePolicy::Choice) -> Box:
            d: Box = session_locate_dialog_box(w, h)
            slot: i64 = choice.i64() - 1
            column: i64 = slot % 2
            row: i64 = slot / 2
            box(d.x + 20.0 + column.f32() * 284.0, d.y + 220.0 + row.f32() * 44.0, 268.0, 36.0)

    public:
        def session_locate_button_hit(w: f32, h: f32, px: f32, py: f32,
                candidate_valid: bool, source_valid: bool,
                comparison: StudioSessionSourcePolicy::Comparison) -> StudioSessionLocatePolicy::Choice:
            for choice in [StudioSessionLocatePolicy::Choice.Locate,
                           StudioSessionLocatePolicy::Choice.RestoreSession,
                           StudioSessionLocatePolicy::Choice.OpenAsNewTake,
                           StudioSessionLocatePolicy::Choice.Cancel] |choice, w, h, px, py, candidate_valid, source_valid, comparison|:
                if StudioSessionLocatePolicy::action_enabled(candidate_valid, source_valid, comparison, choice) and inside(session_locate_button_box(w, h, choice), px, py):
                    return choice
            StudioSessionLocatePolicy::Choice.None

        def session_locate_panel(w: f32, h: f32, opened: bool,
            can Global{Read, Write}:
                    candidate_valid: bool, loading: bool, source_valid: bool,
                    comparison: StudioSessionSourcePolicy::Comparison,
                    focus: StudioSessionLocatePolicy::Focus) -> void can[Global{Read, Write}]:
                return if not opened
                d: Box = session_locate_dialog_box(w, h)
                StudioDraw::rect(d.x, d.y, d.w, d.h, StudioDraw::color(24, 28, 37))
                StudioDraw::segment(d.x, d.y, d.x + d.w, d.y, 1.2, StudioDraw::color(245, 170, 92))
                StudioDraw::segment(d.x + d.w, d.y, d.x + d.w, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x + d.w, d.y + d.h, d.x, d.y + d.h, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::segment(d.x, d.y + d.h, d.x, d.y, 1.2, StudioDraw::color(104, 115, 134))
                StudioDraw::bold(d.x + 24.0, d.y + 22.0, 18.0, "Locate the source for this session", StudioDraw::ink())
                StudioDraw::text(d.x + 24.0, d.y + 62.0, 13.0, "Choose a GLB. Studio compares saved fingerprint residues, animation, frame count and node count.", StudioDraw::ink())
                mutable detail: sview = "The source is not loaded. Locate the original take to restore this session."
                detail <- "Reading the selected source. You can cancel and keep your current work." if loading
                detail <- "Saved metadata matches. Review Restore session to apply the saved indexed edits." if source_valid and comparison == StudioSessionSourcePolicy::Comparison.Matching
                detail <- "Saved fingerprint residues differ. Version 4 stores indexed corrections without a semantic bone map." if source_valid and comparison == StudioSessionSourcePolicy::Comparison.ChangedBytes
                detail <- "The source animation differs from the saved session." if source_valid and comparison == StudioSessionSourcePolicy::Comparison.ChangedAnimation
                detail <- "The source shape differs from the saved session." if source_valid and comparison == StudioSessionSourcePolicy::Comparison.ChangedShape
                StudioDraw::text(d.x + 24.0, d.y + 92.0, 12.0, detail, StudioDraw::color(245, 170, 92) if source_valid and comparison != StudioSessionSourcePolicy::Comparison.Matching else StudioDraw::muted())
                StudioDraw::text(d.x + 24.0, d.y + 119.0, 12.0, "Metadata match does not prove byte identity. Changed sources cannot reuse saved joint indices.", StudioDraw::muted())
                StudioDraw::text(d.x + 24.0, d.y + 158.0, 11.0, "L locate another   R restore reviewed match   N open as new take   Esc cancel", StudioDraw::muted())
                for choice in [StudioSessionLocatePolicy::Choice.Locate,
                               StudioSessionLocatePolicy::Choice.RestoreSession,
                               StudioSessionLocatePolicy::Choice.OpenAsNewTake,
                               StudioSessionLocatePolicy::Choice.Cancel] |choice, w, h, candidate_valid, source_valid, comparison, focus|:
                    enabled: bool = StudioSessionLocatePolicy::action_enabled(candidate_valid, source_valid, comparison, choice)
                    b: Box = session_locate_button_box(w, h, choice)
                    selected: bool = (choice == StudioSessionLocatePolicy::Choice.Locate and focus == StudioSessionLocatePolicy::Focus.Locate) or (choice == StudioSessionLocatePolicy::Choice.RestoreSession and focus == StudioSessionLocatePolicy::Focus.RestoreSession) or (choice == StudioSessionLocatePolicy::Choice.OpenAsNewTake and focus == StudioSessionLocatePolicy::Focus.OpenAsNewTake) or (choice == StudioSessionLocatePolicy::Choice.Cancel and focus == StudioSessionLocatePolicy::Focus.Cancel)
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(58, 52, 40) if selected else StudioDraw::panel())
                    mutable label: sview = "Locate another source..."
                    label <- "Restore reviewed session" if choice == StudioSessionLocatePolicy::Choice.RestoreSession
                    label <- "Open as new take" if choice == StudioSessionLocatePolicy::Choice.OpenAsNewTake
                    label <- "Cancel" if choice == StudioSessionLocatePolicy::Choice.Cancel
                    color: UiCore::Color = StudioDraw::ink() if enabled else StudioDraw::color(100, 105, 117)
                    StudioDraw::bold(b.x + 10.0, b.y + 11.0, 12.0, label, color)
                    StudioDraw::rect(b.x + 4.0, b.y + 5.0, 2.0, b.h - 10.0, StudioDraw::accent()) if selected

        def export_review_dialog_box(w: f32, h: f32) -> Box:
            box((w - 700.0) / 2.0, (h - 620.0) / 2.0, 700.0, 620.0)

        def export_review_ack_box(w: f32, h: f32) -> Box:
            d: Box = export_review_dialog_box(w, h)
            box(d.x + 24.0, d.y + 529.0, d.w - 48.0, 28.0)

        def export_review_button_box(w: f32, h: f32, focus: i64) -> Box:
            d: Box = export_review_dialog_box(w, h)
            slot: f32 = 0.0 if focus == StudioExportReview::Control.CANCEL.i64() else (1.0 if focus == StudioExportReview::Control.EXPORT.i64() else 2.0)
            box(d.x + 24.0 + slot * 220.0, d.y + 574.0, 212.0, 38.0)

        def export_review_destination_box(w: f32, h: f32) -> Box:
            d: Box = export_review_dialog_box(w, h)
            box(d.x + 510.0, d.y + 91.0, 160.0, 28.0)

        def export_review_warning_box(w: f32, h: f32, row: i64) -> Box:
            d: Box = export_review_dialog_box(w, h)
            box(d.x + 24.0, d.y + 445.0 + row.f32() * 16.0, d.w - 48.0, 15.0)

        def export_review_warning_index_at(w: f32, h: f32, px: f32, py: f32,
                                           warnings: i64) -> i64:
            for row in 0..<warnings |row, w, h, px, py|:
                return row if inside(export_review_warning_box(w, h, row), px, py)
            -1

        def export_review_hit(w: f32, h: f32, px: f32, py: f32, warnings: i64) -> i64:
            if inside(export_review_destination_box(w, h), px, py):
                return StudioExportReview::Control.DESTINATION.i64()
            if export_review_warning_index_at(w, h, px, py, warnings) >= 0:
                return StudioExportReview::Control.INSPECT_WARNINGS.i64()
            if warnings > 0 and inside(export_review_ack_box(w, h), px, py):
                return StudioExportReview::Control.ACKNOWLEDGE.i64()
            return StudioExportReview::Control.CANCEL.i64() if inside(export_review_button_box(w, h, StudioExportReview::Control.CANCEL.i64()), px, py)
            return StudioExportReview::Control.EXPORT.i64() if inside(export_review_button_box(w, h, StudioExportReview::Control.EXPORT.i64()), px, py)
            return StudioExportReview::Control.QUEUE.i64() if inside(export_review_button_box(w, h, StudioExportReview::Control.QUEUE.i64()), px, py)
            -1

        def export_result_dialog_box(w: f32, h: f32) -> Box:
            box((w - 620.0) / 2.0, (h - 310.0) / 2.0, 620.0, 310.0)

        def export_result_button_box(w: f32, h: f32, action: i64) -> Box:
            d: Box = export_result_dialog_box(w, h)
            box(d.x + 24.0 + action.f32() * 174.0, d.y + 244.0, 150.0, 38.0)

        def export_result_hit(w: f32, h: f32, px: f32, py: f32) -> i64:
            for action in 0..<StudioExportResult::Action::COUNT |action, w, h, px, py|:
                return action if inside(export_result_button_box(w, h, action), px, py)
            -1
