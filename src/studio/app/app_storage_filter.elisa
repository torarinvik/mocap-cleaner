include "app_state.elisa"

extend Studio:
    private:
        # A view change uses the refreshed snapshot only. It never edits the
        # manifest, cleanup selection, retention or reviewed batch version.
        def apply_storage_list_filter() -> void:
            mutable inspected: StudioStorageManifest::Entry? = null
            if storage_selected >= 0 and storage_selected < storage_visible_entries.count.i64():
                old_rows: darray[StudioStorageManifest::Entry] = storage_visible_entries
                inspected <- old_rows[storage_selected]
            if not StudioStorageListFilterPolicy::valid_mode(storage_filter_mode):
                storage_filter_mode <- StudioStorageListFilterPolicy::Filter::ALL
            entries: darray[StudioStorageManifest::Entry] = storage_inventory_entries
            statuses: darray[i64] = storage_inventory_statuses
            reasons: darray[i64] = storage_inventory_reasons
            mutable rows: darray[StudioStorageManifest::Entry] = []
            mutable row_statuses: darray[i64] = []
            mutable row_reasons: darray[i64] = []
            storage_selected <- -1
            for index in 0..<entries.count |entries, statuses, reasons, inspected, rows, row_statuses, row_reasons|:
                if index < statuses.count and index < reasons.count:
                    entry: StudioStorageManifest::Entry = entries[index]
                    if StudioStorageListFilterPolicy::matches(storage_filter_mode, entry.kind,
                            statuses[index] == StudioPanels::STORAGE_STATUS_IN_TRASH,
                            storage_inventory_row_eligible(index.i64())):
                        if inspected is previous:
                            storage_selected <- rows.count.i64() if storage_identity_matches(previous, entry)
                        rows.push(entry)
                        row_statuses.push(statuses[index])
                        row_reasons.push(reasons[index])
            storage_visible_entries <- rows
            storage_visible_statuses <- row_statuses
            storage_visible_reasons <- row_reasons

        def cycle_storage_list_filter() -> void:
            return if storage_batch_state == StudioStorageBatchPolicy::STATE_RUNNING
            storage_filter_mode <- StudioStorageListFilterPolicy::next_mode(storage_filter_mode)
            apply_storage_list_filter()
            storage_restore_review <- false
            storage_move_review <- false
            touch()
