include "app_export_batch_sheet.elisa"
include "../export_batch_report_view.elisa"
include "../export_report_warning_parser.elisa"
include "panels_export_batch_report.elisa"

extend Studio:
    private:
        const module PreparedReportPage:
            ROWS: usize = StudioExportBatchReportView::Limit::SEGMENTS_PER_PAGE
            LINE_BYTES: usize = StudioExportBatchReportView::Limit::MAX_SEGMENT_BYTES
            BUFFER_BYTES: usize = StudioExportBatchReportView::Limit::MAX_PAGE_BYTES

        global mutable prepared_report_open: bool = false
        global mutable prepared_report_snapshot: StudioExportBatchDisplayProjection::Snapshot = zeroed
        global mutable prepared_report_model: StudioExportBatchReportView::Model? = null
        global mutable prepared_report_ticket: StudioExportBatchWarningReviewPolicy::Ticket = zeroed
        global mutable prepared_report_page: usize = 0
        global mutable prepared_report_layout: bool = false
        global mutable prepared_report_format_valid: bool = false
        global mutable prepared_report_model_valid: bool = false
        global mutable prepared_report_buffer: u8[PreparedReportPage::BUFFER_BYTES] = zeroed
        global mutable prepared_report_lengths: usize[PreparedReportPage::ROWS] = zeroed
        global mutable prepared_report_lines: usize = 0
        global mutable prepared_report_line_views: darray[sview] = []
        global mutable prepared_report_message: sview = ""
        global mutable prepared_report_focus: StudioExportBatchWarningReviewPolicy::Control = StudioExportBatchWarningReviewPolicy::Control.Back

        def close_prepared_report() -> void can[Memory.Release, Global{Read, Write}]:
            can Global{Read, Write}:
                # Closed reports retain no payload or approval context.
                prepared_report_open <- false
                prepared_report_line_views <- []
                prepared_report_layout <- false
                prepared_report_format_valid <- false
                prepared_report_model_valid <- false
                prepared_report_lines <- 0
                prepared_report_page <- 0
                prepared_report_ticket <- StudioExportBatchWarningReviewPolicy::Ticket{epoch: -1, index: -1, attempt: 0}
                prepared_report_snapshot <- zeroed
                prepared_report_model <- null
                prepared_report_message <- ""
                prepared_report_focus <- StudioExportBatchWarningReviewPolicy::Control.Back
                prepared_report_buffer <- zeroed
                prepared_report_lengths <- zeroed

        def cache_prepared_report_page() -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                prepared_report_layout <- false
                prepared_report_line_views <- []
                prepared_report_lines <- 0
                # Only open/close replace this private model; paging never mutates it.
                return if not prepared_report_model_valid
                # The model is created and validated once at open, then only read
                # until close; paging must not rescan its report bytes.
                if prepared_report_model is model:
                    cache_prepared_report_page_for(model)

        def cache_prepared_report_page_for(model: StudioExportBatchReportView::Model&) -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            requires StudioExportBatchReportView::valid(model)
            can Global{Read, Write}:
                return if StudioExportBatchReportView::status(model) != StudioExportBatchReportView::Status.Ready
                pages: usize = StudioExportBatchReportView::page_count(model)
                return if prepared_report_page >= pages
                start: usize = StudioExportBatchReportView::page_start(model, prepared_report_page)
                count: usize = StudioExportBatchReportView::page_segment_count(model, prepared_report_page)
                return if count > PreparedReportPage::ROWS
                for row in 0..<count |row, start, model|:
                    span: StudioExportBatchReportView::Segment = StudioExportBatchReportView::segment(model, start + row)
                    return if span.byte_count > PreparedReportPage::LINE_BYTES or span.byte_start > prepared_report_snapshot.warning_text_bytes.count
                    return if span.byte_count > prepared_report_snapshot.warning_text_bytes.count - span.byte_start
                    prepared_report_lengths[row] <- span.byte_count
                    for byte in 0..<span.byte_count |byte, span, row|:
                        prepared_report_buffer[row * PreparedReportPage::LINE_BYTES + byte] <- prepared_report_snapshot.warning_text_bytes[span.byte_start + byte]
                prepared_report_lines <- count
                for row in 0..<count |row|:
                    prepared_report_line_views.push(prepared_report_line(row))
                prepared_report_layout <- true

        def open_prepared_warning_review() -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not prepared_sheet_open()
                index: i64 = prepared_sheet.selected
                if prepared_export_queue is queue:
                    return if not StudioExportBatchReviewBinding::valid(queue) or index < 0 or index >= StudioExportBatchReviewBinding::item_count(queue).i64()
                    snapshot: StudioExportBatchDisplayProjection::Snapshot = StudioExportBatchReviewBinding::display_projection(queue, index)
                    return if snapshot.warning_count <= 0
                    prepared_report_snapshot <- snapshot
                    mutable parsed_warnings: i64 = 0
                    prepared_report_format_valid <- StudioExportReportWarningParser::warning_count(snapshot.warning_json_bytes, snapshot.warning_text_bytes, &parsed_warnings) and parsed_warnings == snapshot.warning_count
                    prepared_report_ticket <- StudioExportBatchWarningReviewPolicy::Ticket{epoch: prepared_revision, index: index, attempt: snapshot.attempt}
                    mutable loaded_model: StudioExportBatchReportView::Model = StudioExportBatchReportView::create()
                    prepared_report_model_valid <- false
                    loaded: StudioExportBatchReportView::Status = StudioExportBatchReportView::load(&loaded_model, prepared_report_snapshot.warning_text_bytes)
                    prepared_report_model_valid <- StudioExportBatchReportView::valid(loaded_model)
                    prepared_report_model <- move loaded_model
                    prepared_report_page <- 0
                    prepared_report_open <- true
                    prepared_report_message <- StudioExportBatchReportView::refusal_message(loaded)
                    if loaded == StudioExportBatchReportView::Status.Ready:
                        prepared_report_message <- "Warnings already reviewed for this captured result." if snapshot.approved else "Inspect the captured report. Acknowledge only if you accept its warnings."
                        prepared_report_message <- "Report warning counts do not match this item. Acknowledgement is unavailable." if not prepared_report_format_valid
                    prepared_report_focus <- StudioExportBatchWarningReviewPolicy::Control.Back
                    cache_prepared_report_page()
                    touch()

        def prepared_report_current(exact_bytes: bool) -> bool can[Global.Read]:
            can Global.Read:
                return false if not prepared_report_open or not prepared_sheet_open()
                if prepared_export_queue is queue:
                    index: i64 = prepared_sheet.selected
                    return false if not StudioExportBatchReviewBinding::valid(queue) or index < 0 or index >= StudioExportBatchReviewBinding::item_count(queue).i64()
                    observed: StudioExportBatchWarningReviewPolicy::Ticket = StudioExportBatchWarningReviewPolicy::Ticket{epoch: prepared_revision, index: index, attempt: StudioExportBatchReviewBinding::item_attempt(queue, index)}
                    return false if not StudioExportBatchWarningReviewPolicy::current(prepared_report_ticket, observed)
                    metadata: StudioExportBatchQueue::Item = StudioExportBatchReviewBinding::item(queue, index)
                    return false if metadata.warning_count != prepared_report_snapshot.warning_count
                    return true if not exact_bytes
                    current: StudioExportBatchDisplayProjection::Snapshot = StudioExportBatchReviewBinding::display_projection(queue, index)
                    return false if not StudioExportBatchDisplayProjection::bytes_equal(current.warning_json_bytes, prepared_report_snapshot.warning_json_bytes)
                    return StudioExportBatchDisplayProjection::bytes_equal(current.warning_text_bytes, prepared_report_snapshot.warning_text_bytes)
                return false

        def prepared_report_ack_available() -> bool can[Global.Read]:
            can Global.Read:
                return false if not prepared_workspace_writable()
                return false if prepared_report_snapshot.approved
                return false if not prepared_report_layout or not prepared_report_format_valid or not prepared_report_current(false)
                return StudioExportBatchWarningReviewPolicy::acknowledge_admitted(prepared_report_ticket, prepared_report_ticket,
                    true, StudioExportBatchReportView::status_if_present(prepared_report_model) == StudioExportBatchReportView::Status.Ready,
                    prepared_report_snapshot.warning_count, true)

        def acknowledge_prepared_report() -> void can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not prepared_report_ack_available()
                descriptor: i32 = begin_storage_transaction()
                if descriptor < 0:
                    prepared_report_message <- "Workspace lock unavailable. Warning approval was not changed."
                    touch()
                    return
                mutable approved: bool = false
                if prepared_export_queue is queue:
                    if prepared_report_current(true):
                        approved <- StudioExportBatchReviewBinding::acknowledge_recovered_warning(&queue, prepared_report_ticket.index, true, descriptor)
                        prepared_export_queue <- queue
                released: bool = end_storage_transaction(descriptor)
                if not released:
                    prepared_report_message <- "Workspace lock release is uncertain. Restart before another workspace write."
                    touch()
                    return
                if approved:
                    close_prepared_report()
                    prepared_message <- "Warnings acknowledged for this exact result and attempt."
                    refresh_prepared_sheet()
                else:
                    prepared_report_message <- "Warning approval was refused. Refresh and review the current report."
                touch()

        def prepared_report_previous() -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                pages: usize = StudioExportBatchReportView::page_count_if_present(prepared_report_model)
                return if pages == 0 or prepared_report_page == 0 or prepared_report_page >= pages
                prepared_report_page <- prepared_report_page - 1
                cache_prepared_report_page()
                touch()

        def prepared_report_next() -> void can[Unsafe.PointerCast, Memory.Allocate, Global{Read, Write}]:
            can Global{Read, Write}:
                return if prepared_report_page + 1 >= StudioExportBatchReportView::page_count_if_present(prepared_report_model)
                prepared_report_page <- prepared_report_page + 1
                cache_prepared_report_page()
                touch()

        def prepared_report_line(row: usize) -> sview can[Unsafe.PointerCast, Global.Read]:
            can Global.Read:
                return "" if row >= prepared_report_lines
                return UiText::unsafe_sview_bounded_bytes(&prepared_report_buffer[row * PreparedReportPage::LINE_BYTES], prepared_report_lengths[row])

        def prepared_report_controls() -> StudioExportBatchWarningReviewPolicy::Controls can[Global.Read]:
            can Global.Read:
                pages: usize = StudioExportBatchReportView::page_count_if_present(prepared_report_model)
                return StudioExportBatchWarningReviewPolicy::Controls{previous: pages > 0 and prepared_report_page > 0 and prepared_report_page < pages,
                    next: pages > 0 and prepared_report_page + 1 < pages,
                    acknowledge: prepared_report_ack_available()}

        def prepared_report_action(control: StudioExportBatchWarningReviewPolicy::Control) -> void can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not prepared_report_open
                return if not StudioExportBatchWarningReviewPolicy::control_enabled(control, prepared_report_controls())
                if control == StudioExportBatchWarningReviewPolicy::Control.Previous:
                    prepared_report_previous()
                elif control == StudioExportBatchWarningReviewPolicy::Control.Next:
                    prepared_report_next()
                elif control == StudioExportBatchWarningReviewPolicy::Control.Acknowledge:
                    acknowledge_prepared_report()
                elif control == StudioExportBatchWarningReviewPolicy::Control.Back:
                    close_prepared_report()
                    touch()

        def prepared_report_pointer(w: f32, h: f32, x: f32, y: f32) -> void can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not prepared_report_open
                if StudioPanels::export_batch_report_control_hit(w, h, x, y) is control:
                    return if not StudioExportBatchWarningReviewPolicy::control_enabled(control, prepared_report_controls())
                    prepared_report_focus <- control
                    prepared_report_action(control)

        def draw_prepared_report(w: f32, h: f32) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                return if not prepared_report_open
                StudioPanels::export_batch_report_panel(w, h, prepared_report_line_views,
                    prepared_report_page, StudioExportBatchReportView::page_count_if_present(prepared_report_model),
                    prepared_report_focus, prepared_report_controls(), prepared_report_message)

        def prepared_report_key(code: UiCore::Key) -> void can[Unsafe.PointerCast, Blocking.IO, Memory{Allocate, Release}, Global{Read, Write}]:
            can Global{Read, Write}:
                return if not prepared_report_open
                if code == UiCore::Key.Escape:
                    prepared_report_action(StudioExportBatchWarningReviewPolicy::Control.Back)
                elif code == UiCore::Key.Tab:
                    prepared_report_focus <- StudioExportBatchWarningReviewPolicy::move_control(prepared_report_focus,
                        StudioShortcuts::shift(modifiers), prepared_report_controls())
                    touch()
                elif code == UiCore::Key.Left:
                    prepared_report_action(StudioExportBatchWarningReviewPolicy::Control.Previous)
                elif code == UiCore::Key.Right:
                    prepared_report_action(StudioExportBatchWarningReviewPolicy::Control.Next)
                elif code == UiCore::Key.Enter or code == UiCore::Key.Space:
                    prepared_report_action(prepared_report_focus)
