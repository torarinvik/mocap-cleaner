# Mocap Studio: `build/mocap_studio [clip.glb [animation [model.glb]]]`.
# The optional model is a skinned character drawn over the take.
# Build: scripts/build_studio.sh.
include "../generation_lease.elisa"
include "app.elisa"

def main(argc: i64, argv: mutable void&) -> i64 can[Blocking.IO, Unsafe.PointerCast]:
    lease_status: StudioGenerationLeasePolicy::AcquireStatus = StudioGenerationLease::acquire()
    return 2 if not StudioGenerationLeasePolicy::admitted(lease_status)
    args: mutable cstr&& = argv.cast[mutable cstr&&]
    if argc > 1:
        first: cstr = args[1]
        Studio::set_path(first)
    if argc > 2:
        second: cstr = args[2]
        Studio::set_anim(second)
    if argc > 3:
        third: cstr = args[3]
        Studio::set_model(third)
    run_status: i64 = UiAppKitCanvas::run_with_min_size("Mocap Studio", 1440.0, 900.0, 1100.0, 720.0)
    return 3 if not StudioGenerationLease::release()
    run_status
