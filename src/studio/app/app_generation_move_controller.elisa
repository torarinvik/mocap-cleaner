include "app_generation_review.elisa"
include "../io/build_generation_move_worker.elisa"
include "../state/generation_move_confirmation_policy.elisa"

extend Studio:
    private:
        global mutable generation_move_state: StudioGenerationMoveConfirmationPolicy::State = StudioGenerationMoveConfirmationPolicy::State.Inspecting
        global mutable generation_move_wire: StudioBuildGenerationMoveWire::Wire? = null
        global mutable generation_move_task: Thread[StudioBuildGenerationMoveWorker::Result, Joinable]? = null
        global mutable generation_move_reply: StudioBuildGenerationMoveWorker::Result? = null
        global mutable generation_move_ticket: i64 = 0

        def generation_move_action_label() -> sview:
            match generation_move_state:
                StudioGenerationMoveConfirmationPolicy::State.Reviewing(key): return "Confirm Move"
                StudioGenerationMoveConfirmationPolicy::State.Inspecting: return "Review Move"
                StudioGenerationMoveConfirmationPolicy::State.Confirmed(key): return "Confirm Move"
                StudioGenerationMoveConfirmationPolicy::State.Running(key, job_ticket): return "Moving…"
                StudioGenerationMoveConfirmationPolicy::State.Draining(key, job_ticket): return "Finishing…"
                StudioGenerationMoveConfirmationPolicy::State.RecoveryPending(job_ticket): return "Recovery pending"
                StudioGenerationMoveConfirmationPolicy::State.Resolved(job_ticket): return "Review Move"

        def generation_move_action_help() -> sview:
            "Review one verified older generation, then confirm moving it to recoverable storage. Files remain on disk."

        def generation_move_current_key() -> StudioGenerationMoveConfirmationPolicy::ReviewKey:
            StudioGenerationMoveConfirmationPolicy::ReviewKey{scan_ticket: generation_scan_ticket, row_index: generation_inspected_row, retention_days: StudioStorageSelectionPolicy::retention_days(storage_retention_preset)}

        def generation_move_action_enabled() -> bool:
            return false if generation_move_task != null or generation_move_reply != null or generation_scan_task != null or generation_scan_requested or storage_release_uncertain
            return false if storage_move_review or storage_restore_review or storage_batch_state == StudioStorageBatchPolicy::State.Running.i64()
            if generation_inventory is snapshot:
                return false if snapshot.outcome != StudioBuildGenerationCandidateProvider::Outcome.Complete or snapshot.retention_days != StudioStorageSelectionPolicy::retention_days(storage_retention_preset)
                return false if generation_inspected_row < 0 or generation_inspected_row >= snapshot.rows.count.i64()
                row: StudioBuildGenerationCandidateProvider::Row = snapshot.rows[generation_inspected_row]
                return StudioBuildGenerationCandidateProvider::row_valid(row) and row.protection == StudioBuildGenerationCandidateProvider::Protection.Eligible and StudioBuildGenerationMoveWire::age_admitted(row.age, row.retention_days)
            false

        def generation_move_source_current() -> bool can[Unsafe.PointerCast, Memory.Allocate]:
            return false if not generation_move_action_enabled()
            current_root: darray[u8] = path_bytes(workspace_build_directory())
            StudioBuildGenerationCandidateProvider::bytes_equal(generation_scan_root, current_root)

        def generation_move_review_action() -> void can[Threads, Unsafe.PointerCast, Memory.Allocate, Memory.Release]:
            return if generation_move_task != null or generation_move_reply != null
            if not generation_move_source_current():
                generation_move_state <- StudioGenerationMoveConfirmationPolicy::State.Inspecting
                generation_move_wire <- null
                touch()
                return
            current: StudioGenerationMoveConfirmationPolicy::ReviewKey = generation_move_current_key()
            if StudioGenerationMoveConfirmationPolicy::may_confirm(generation_move_state, current, true, true, false):
                return if generation_move_ticket == StudioGenerationCandidateScanWorkerPolicy::Ticket::MAX
                if generation_move_wire is captured:
                    generation_move_ticket <- generation_move_ticket + 1
                    review: StudioGenerationReviewBindingPolicy::Review = StudioGenerationReviewBindingPolicy::Review{selected: true, reviewed: true, confirmed: true, inventory_revision: current.scan_ticket, confirmed_revision: current.scan_ticket, reviewed_retention_days: current.retention_days, current_retention_days: current.retention_days}
                    generation_move_state <- StudioGenerationMoveConfirmationPolicy::State.Confirmed(key: current)
                    if StudioGenerationMoveConfirmationPolicy::may_start(generation_move_state, current, true, true, false):
                        job: StudioBuildGenerationMoveWorker::Job = StudioBuildGenerationMoveWorker::Job{ticket: generation_move_ticket, review: review, wire: captured}
                        generation_move_task <- StudioBuildGenerationMoveWorker::start(move job)
                        generation_move_state <- StudioGenerationMoveConfirmationPolicy::State.Running(key: current, job_ticket: generation_move_ticket)
                        UiCore::request_frame_after(0.016)
            elif generation_inventory is snapshot:
                row: StudioBuildGenerationCandidateProvider::Row = snapshot.rows[generation_inspected_row]
                root: darray[u8] = path_bytes(workspace_build_directory())
                captured: StudioBuildGenerationMoveWire::Wire = StudioBuildGenerationMoveWire::capture(row, root)
                if captured.valid:
                    generation_move_wire <- captured
                    generation_move_state <- StudioGenerationMoveConfirmationPolicy::State.Reviewing(key: current)
            touch()

        def cancel_generation_move_review() -> void:
            generation_move_state <- StudioGenerationMoveConfirmationPolicy::cancel(generation_move_state)
            generation_move_wire <- null if generation_move_task == null and generation_move_reply == null

        def poll_generation_move() -> void can[Threads, Memory.Allocate, Memory.Release]:
            if generation_move_task is active:
                generation_move_task <- null
                readiness: ThreadReadiness[StudioBuildGenerationMoveWorker::Result] = poll_ready(move active)
                if not readiness.complete:
                    generation_move_task <- move readiness.thread
                    UiCore::request_frame_after(0.016)
                    return
                mutable reply: StudioBuildGenerationMoveWorker::Result = join(move readiness.thread)
                completed_ticket: i64 = reply.ticket
                recovered: bool = reply.recoverable
                publish: bool = StudioGenerationMoveConfirmationPolicy::may_publish_success(generation_move_state, completed_ticket, recovered, true, reply.remaining_handle)
                # Retain the entire owning reply even after cancellation. The
                # operation ID and any native handle must survive UI suppression.
                generation_move_reply <- move reply
                generation_move_state <- StudioGenerationMoveConfirmationPolicy::State.Resolved(job_ticket: completed_ticket) if publish else StudioGenerationMoveConfirmationPolicy::State.RecoveryPending(job_ticket: completed_ticket)
                request_generation_inventory()
                touch()

        def generation_move_message() -> sview:
            match generation_move_state:
                StudioGenerationMoveConfirmationPolicy::State.Running(key, job_ticket): return "Moving generation; recovery evidence is retained."
                StudioGenerationMoveConfirmationPolicy::State.Draining(key, job_ticket): return "Cancellation requested; finishing the owned filesystem operation."
                StudioGenerationMoveConfirmationPolicy::State.Reviewing(key): return "Review the selected generation and retention, then choose Confirm Move."
                StudioGenerationMoveConfirmationPolicy::State.Confirmed(key): return "Starting the confirmed generation move."
                StudioGenerationMoveConfirmationPolicy::State.Resolved(job_ticket): return "Moved to recoverable storage. Files remain on disk."
                StudioGenerationMoveConfirmationPolicy::State.RecoveryPending(job_ticket): return "Recovery evidence retained. Further generation moves are paused."
                StudioGenerationMoveConfirmationPolicy::State.Inspecting: return generation_inventory_message()
