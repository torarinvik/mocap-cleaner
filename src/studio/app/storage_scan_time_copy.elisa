# Shared visible and accessible UTC scan timestamp copy.
include "text.elisa"
include "storage_accessibility_copy.elisa"
include "../storage_scan_time_policy.elisa"

module StudioStorageScanTimeCopy:
    public:
        # Append without resetting the caller's existing summary.
        def append(timestamp: i64) -> void can[Global{Read, Write}]:
            if not StudioStorageScanTimePolicy::supported(timestamp):
                StudioText::put(StudioStorageAccessibilityCopy::last_scan_unknown())
                return
            scan_time: StudioStorageScanTimePolicy::UtcParts = StudioStorageScanTimePolicy::utc_parts(timestamp)
            StudioText::put(StudioStorageAccessibilityCopy::last_scan_prefix())
            StudioText::put_i(scan_time.year)
            StudioText::put("-")
            StudioText::put("0") if scan_time.month < 10
            StudioText::put_i(scan_time.month)
            StudioText::put("-")
            StudioText::put("0") if scan_time.day < 10
            StudioText::put_i(scan_time.day)
            StudioText::put(" ")
            StudioText::put("0") if scan_time.hour < 10
            StudioText::put_i(scan_time.hour)
            StudioText::put(":")
            StudioText::put("0") if scan_time.minute < 10
            StudioText::put_i(scan_time.minute)
            StudioText::put(":")
            StudioText::put("0") if scan_time.second < 10
            StudioText::put_i(scan_time.second)
