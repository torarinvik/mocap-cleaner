include "app_state.elisa"
include "../correction_result_policy.elisa"
include "../edit_transaction_policy.elisa"

# Owns staged edit intents, candidate evaluation and committed publication.
extend Studio:
    private:
        global mutable pending_edit_stack: StackState::Stack? = null
        global mutable pending_edit_base: StudioEditTransactionPolicy::Base = zeroed
        global mutable pending_edit_intent: StudioEditTransactionPolicy::Intent = StudioEditTransactionPolicy::Intent.Record

        def pending_edit_active() -> bool:
            pending_edit_stack != null

        def discard_pending_edit() -> void:
            pending_edit_stack <- null
            pending_edit_base <- zeroed
            pending_edit_intent <- StudioEditTransactionPolicy::Intent.Record
            contact_preview_rebuild_pending <- false

        def stage_pending_edit(s: StackState::Stack, intent: StudioEditTransactionPolicy::Intent) -> bool:
            observed: StudioEditTransactionPolicy::Base = edit_transaction_base()
            if not StudioEditTransactionPolicy::stage_admitted(pending_edit_active(), pending_edit_base, observed):
                discard_pending_edit()
                status <- "Queued edit discarded because its source or history changed. Review the current result and try again."
                status_file <- null
                touch()
                return false
            if not pending_edit_active():
                pending_edit_base <- observed
            pending_edit_stack <- s
            pending_edit_intent <- intent
            contact_preview_rebuild_pending <- true
            status <- "Edit queued for evaluation. Existing history and result remain unchanged until it succeeds."
            status_file <- null
            touch()
            true

        def finish_deferred_rebuild() -> void:
            if pending_edit_stack is draft:
                current: bool = StudioEditTransactionPolicy::current(pending_edit_base, edit_transaction_base())
                intent: StudioEditTransactionPolicy::Intent = pending_edit_intent
                discard_pending_edit()
                if not current:
                    status <- "Queued edit discarded because its source or history changed. Existing edits kept."
                    touch()
                    return
                mutable accepted: bool = false
                if intent == StudioEditTransactionPolicy::Intent.Record:
                    committed: StackState::Stack = HistoryState::current(&history)
                    if StackState::same(draft, committed):
                        status <- "Queued edits are unchanged. No history entry added."
                        status_file <- null
                        touch()
                        return
                    accepted <- commit(draft, true)
                else:
                    accepted <- apply_history_target(draft, intent == StudioEditTransactionPolicy::Intent.Redo)
                if accepted:
                    status <- "Queued edits evaluated. The displayed result is current and ready for review."
                    status_file <- null
                    touch()
                return
            previous: i64 = built
            contact_preview_rebuild_pending <- false
            rebuild()
            if StudioCorrectionResultPolicy::completed(previous, built, load_failed):
                status <- "Queued edits evaluated. The displayed result is current and ready for review."
                nudged_row <- -1
                status_file <- null
                touch()

        def candidate_revision_for(s: StackState::Stack&) -> i64:
            if built_stack is prior:
                return rig_source_revision if StackState::same_rig_source(prior, s)
            rig_source_revision + 1

        # Evaluation owns Memo temporarily but does not publish history,
        # the visible clip, readouts or generations. Exact-keyed cache entries
        # may be retained even when a candidate correction is refused.
        def evaluate_candidate(s: StackState::Stack&, candidate_revision: i64) -> StudioModel::Clip?:
            requires contact_preview_task == null
            if memo == null:
                memo <- StudioModel::load(path, anim_name)
            mutable result: StudioModel::Clip? = null
            if memo is held:
                mutable m: StudioModel::Memo = held
                memo <- null
                w: mutable StudioPerf::Window = StudioPerf::full(m.frames)
                if clip is c:
                    if built_stack is old:
                        w <- StudioPerf::edit_window(old, s, m.frames, m.shortest)
                    result <- StudioModel::build_with(&m, s, c.points, c.problems, c.peaks, w, candidate_revision)
                else:
                    none_p: darray[Geometry::Vec3] = []
                    none_i: darray[i64] = []
                    result <- StudioModel::build_with(&m, s, none_p, none_i, none_i, w, candidate_revision)
                memo <- move m
            move result

        # Publication accepts only a successfully evaluated owned candidate.
        def publish_candidate(s: StackState::Stack, result: StudioModel::Clip?, candidate_revision: i64) -> void:
            requires result != null
            load_failed <- false
            if clip is old:
                shown_slide <- readout_value(shown_slide, old.slide_after)
                shown_sink <- readout_value(shown_sink, old.sink_after)
                shown_hand_slide <- readout_value(shown_hand_slide, old.hand_slide_after)
            readout_start <- UiAppKitCanvas::monotonic_time()
            rig_source_revision <- candidate_revision
            clip <- move result
            StudioPanels::set_rate(rate())
            sync_count()
            built_stack <- s
            built <- built + 1
            if clip is c:
                collect_issues(c)
            touch()

        # Record an edited stack and preview it; selection-only edits are
        # recorded too so undo restores the row the user was on.
        def commit(s: StackState::Stack, preview: bool) -> bool:
            foot_press <- FootState::idle()
            contact_preview_active <- false
            return false if not history_ready
            if not preview and pending_edit_active():
                return stage_pending_edit(s, pending_edit_intent)
            if preview and contact_preview_task != null:
                return stage_pending_edit(s, StudioEditTransactionPolicy::Intent.Record)
            active: StackState::Stack = current_stack()
            return false if StackState::same(active, s)
            if preview and contact_preview_task == null and path_slot >= 0:
                base: StudioEditTransactionPolicy::Base = edit_transaction_base()
                revision: i64 = candidate_revision_for(s)
                mutable candidate: StudioModel::Clip? = evaluate_candidate(s, revision)
                if candidate == null:
                    status <- "Edit not applied: the proposed result could not be evaluated. Existing edits and result kept. Try a smaller change or reopen the source."
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return false
                if not StudioEditTransactionPolicy::current(base, edit_transaction_base()):
                    status <- "Edit not applied: its source or history changed during evaluation. Existing edits kept. Review the current result and try again."
                    nudged_row <- -1
                    status_file <- null
                    touch()
                    return false
                return false if not HistoryState::record(&history, s)
                stack_generation <- stack_generation + 1
                publish_candidate(s, move candidate, revision)
                return true
            if history_ready:
                changed: bool = HistoryState::record(&history, s)
                stack_generation <- stack_generation + 1 if changed
                if changed and preview:
                    rebuild()
                touch()
                return changed
            false

        def edit_transaction_base() -> StudioEditTransactionPolicy::Base:
            StudioEditTransactionPolicy::Base{take: take_serial, result_generation: built,
                stack_generation: stack_generation, cursor: history.cursor, count: history.count}

        def undo() -> void:
            foot_press <- FootState::idle()
            contact_preview_active <- false
            if pending_edit_active():
                discard_pending_edit()
                status <- "Queued edits cancelled. Committed history and result kept."
                status_file <- null
                touch()
                return
            if history_ready:
                if contact_preview_task != null:
                    if HistoryState::undo_target(&history) is target:
                        _ = stage_pending_edit(target, StudioEditTransactionPolicy::Intent.Undo)
                    return
                if contact_preview_task == null and path_slot >= 0:
                    if HistoryState::undo_target(&history) is target:
                        if apply_history_target(target, false):
                            history_rebuild_feedback("Undo applied. Result updated.", "Undo is waiting for evaluation.")
                    return
                if HistoryState::undo(&history):
                    stack_generation <- stack_generation + 1
                    rebuild()
                    history_rebuild_feedback("Undo applied. Result updated.", "Undo recorded. Rebuilding after the current preview finishes; the previous result remains visible.")

        def redo() -> void:
            foot_press <- FootState::idle()
            contact_preview_active <- false
            if pending_edit_active():
                discard_pending_edit()
            if history_ready:
                if contact_preview_task != null:
                    if HistoryState::redo_target(&history) is target:
                        _ = stage_pending_edit(target, StudioEditTransactionPolicy::Intent.Redo)
                    return
                if contact_preview_task == null and path_slot >= 0:
                    if HistoryState::redo_target(&history) is target:
                        if apply_history_target(target, true):
                            history_rebuild_feedback("Redo applied. Result updated.", "Redo is waiting for evaluation.")
                    return
                if HistoryState::redo(&history):
                    stack_generation <- stack_generation + 1
                    rebuild()
                    history_rebuild_feedback("Redo applied. Result updated.", "Redo recorded. Rebuilding after the current preview finishes; the previous result remains visible.")

        def apply_history_target(target: StackState::Stack&, redo_requested: bool) -> bool:
            requires contact_preview_task == null
            base: StudioEditTransactionPolicy::Base = edit_transaction_base()
            revision: i64 = candidate_revision_for(target)
            mutable candidate: StudioModel::Clip? = evaluate_candidate(target, revision)
            if candidate == null:
                status <- "History change not applied: its result could not be evaluated. Existing history position and result kept. Reopen the source if this continues."
                nudged_row <- -1
                status_file <- null
                touch()
                return false
            if not StudioEditTransactionPolicy::current(base, edit_transaction_base()):
                status <- "History change not applied: source or history changed during evaluation. Existing result kept. Try again from the current state."
                nudged_row <- -1
                status_file <- null
                touch()
                return false
            moved: bool = HistoryState::redo(&history) if redo_requested else HistoryState::undo(&history)
            return false if not moved
            stack_generation <- stack_generation + 1
            publish_candidate(target, move candidate, revision)
            true

        def history_rebuild_feedback(ready_text: sview, pending_text: sview) -> void:
            outcome: StudioCorrectionResultPolicy::Outcome = StudioCorrectionResultPolicy::outcome(contact_preview_rebuild_pending, load_failed)
            if outcome == StudioCorrectionResultPolicy::Outcome.Deferred:
                status <- pending_text
            elif outcome == StudioCorrectionResultPolicy::Outcome.Ready:
                status <- ready_text
            # On refusal, keep rebuild's explanation and recovery guidance.
            nudged_row <- -1
            status_file <- null
            touch()

