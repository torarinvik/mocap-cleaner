include "panels_geometry.elisa"
include "../../../../elisa-ui/src/widgets/ui_text_measure_layout.elisa"
include "../failure_guide_layout_policy.elisa"
include "../status_bar_layout_policy.elisa"
include "../tooltip_layout_policy.elisa"

extend StudioPanels:
    public:
        def is_clean_action(action: i64) -> bool:
            action == PrivateToolbarAction::Clean
    private:
        const module Tooltip:
            PADDING: f32 = 16.0
            HEIGHT: i64 = 22
            TEXT_SIZE: f32 = 12.0
            GAP: f32 = 4.0

        def tooltip_pixels(value: f32) -> i64:
            ensure result >= 0 and result <= StudioTooltipLayoutPolicy::Limit::EXTENT
            return StudioTooltipLayoutPolicy::Limit::EXTENT if value >= StudioTooltipLayoutPolicy::Limit::EXTENT.f32()
            value.i64() if value > 0.0 else 0

        def icon_of(action: i64, playing: bool) -> StudioIcons::Icon:
            return (StudioIcons::Icon.Pause if playing else StudioIcons::Icon.Play) if action == ToolbarAction.Play.i64()
            return StudioIcons::Icon.Back if action == ToolbarAction.Back.i64()
            return StudioIcons::Icon.Forward if action == ToolbarAction.Forward.i64()
            return StudioIcons::Icon.Loop if action == ToolbarAction.Loop.i64()
            return StudioIcons::Icon.Undo if action == ToolbarAction.Undo.i64()
            return StudioIcons::Icon.Redo if action == ToolbarAction.Redo.i64()
            return StudioIcons::Icon.Trails if action == ToolbarAction.Trails.i64()
            return StudioIcons::Icon.Contacts if action == ToolbarAction.Contacts.i64()
            return StudioIcons::Icon.Heat if action == ToolbarAction.Heat.i64()
            return StudioIcons::Icon.Onion if action == ToolbarAction.Onion.i64()
            return StudioIcons::Icon.Ghost if action == ToolbarAction.Ghost.i64()
            return StudioIcons::Icon.Xray if action == ToolbarAction.Xray.i64()
            return StudioIcons::Icon.Mesh if action == ToolbarAction.Mesh.i64()
            return StudioIcons::Icon.Frame if action == ToolbarAction.Frame.i64()
            return StudioIcons::Icon.Open if action == ToolbarAction.Open.i64()
            return StudioIcons::Icon.Export if action == ToolbarAction.Export.i64()
            return StudioIcons::Icon.Balance if action == ToolbarAction.Balance.i64()
            return StudioIcons::Icon.Clean if action == PrivateToolbarAction::Clean
            StudioIcons::Icon.None

        # Tooltip of a toolbar button: what it does, then its shortcut.
    public:
        def tip_of(action: i64) -> sview:
            return "Play / pause  (Space)" if action == ToolbarAction.Play.i64()
            return "Previous frame  (Left)" if action == ToolbarAction.Back.i64()
            return "Next frame  (Right)" if action == ToolbarAction.Forward.i64()
            return "Playback speed  (S)" if action == ToolbarAction.Speed.i64()
            return "Loop playback  (L)" if action == ToolbarAction.Loop.i64()
            return "Undo  (Cmd-Z)" if action == ToolbarAction.Undo.i64()
            return "Redo  (Cmd-Shift-Z)" if action == ToolbarAction.Redo.i64()
            return "Motion trails  (T)" if action == ToolbarAction.Trails.i64()
            return "Foot contacts  (C)" if action == ToolbarAction.Contacts.i64()
            return "Problem heat map  (H)" if action == ToolbarAction.Heat.i64()
            return "Onion skin  (N)" if action == ToolbarAction.Onion.i64()
            return "Source ghost  (G)" if action == ToolbarAction.Ghost.i64()
            return "X-ray skeleton  (X)" if action == ToolbarAction.Xray.i64()
            return "Character / skeleton  (M)" if action == ToolbarAction.Mesh.i64()
            return "Frame the character  (F)" if action == ToolbarAction.Frame.i64()
            return "Open a take  (Cmd-O)" if action == ToolbarAction.Open.i64()
            return "Export cleaned GLB  (E)" if action == ToolbarAction.Export.i64()
            return "Balance overlay  (Q)" if action == ToolbarAction.Balance.i64()
            return "Review boxing cleanup suggestion  (A)" if action == PrivateToolbarAction::Clean
            ""

        def tooltip(action: i64, window_width: f32, window_height: f32, text: sview) -> void:
            return if action < 0 or action >= PanelLimit::BUTTONS
            available_width: i64 = tooltip_pixels(window_width)
            available_height: i64 = tooltip_pixels(window_height)
            return if available_width == 0 or available_height == 0
            b: Box = button_box(action)
            # Round measured width upward before bounding it to the viewport.
            measured: f32 = UiTextMetrics::width(text, Tooltip::TEXT_SIZE, false)
            width: i64 = StudioTooltipLayoutPolicy::extent(available_width, tooltip_pixels(measured + Tooltip::PADDING + 1.0))
            height: i64 = StudioTooltipLayoutPolicy::extent(available_height, Tooltip::HEIGHT)
            x: i64 = StudioTooltipLayoutPolicy::origin(available_width, width, tooltip_pixels(b.x))
            y: i64 = StudioTooltipLayoutPolicy::origin(available_height, height, tooltip_pixels(b.y + b.h + Tooltip::GAP))
            UiCore::set_clip(UiCore::Rect(x.f32(), y.f32(), width.f32(), height.f32()))
            StudioDraw::rect(x.f32(), y.f32(), width.f32(), height.f32(), StudioDraw::color(240, 236, 220))
            StudioDraw::text(x.f32() + 8.0, y.f32() + 4.0, Tooltip::TEXT_SIZE, text, StudioDraw::color(20, 22, 28))
            UiCore::clear_clip()

        # Shortcut sheet ("?"): every binding, grouped.
    private:
        const HELP_LINES: i64 = 34
        def help_line(i: i64) -> sview:
            return "PLAYBACK" if i == 0
            return "Space  play / pause       Left / Right  step a frame" if i == 1
            return "S  speed (1, 1/2, 1/4)    L  loop" if i == 2
            return "EDITING" if i == 3
            return "A  Preview boxing cleanup; review before applying" if i == 4
            return "1-5  add despike / smooth / median / limit channel deviation / seam" if i == 5
            return "Up / Down  select operation    D  enable / disable" if i == 6
            return "[ / ]  strength    B  bones    I / O  scope in / out at playhead" if i == 7
            return "PgUp / PgDn  move operation    Delete  remove" if i == 8
            return "K feet  J hands    , / . blend    W worst foot slide" if i == 9
            return "Contacts: select; Shift-P plant, Shift-L lift, Shift-U reset" if i == 10
            return "R / V  rotate / translate gizmo (drag to key a correction)" if i == 11
            return "Cmd-Z  undo    Cmd-Shift-Z (or Y)  redo" if i == 12
            return "FILE" if i == 13
            return "Cmd-S  save session    Cmd-Shift-S  save as    Cmd-Shift-O  open session" if i == 14
            return "Cmd-O  open take    E  export    Cmd-E  export as" if i == 15
            return "VIEW" if i == 16
            return "F  frame character    Shift-F  frame times    P  position / rotation curves" if i == 17
            return "T trails  C contacts  H heat  N onion  G ghost  X x-ray  M character / skeleton  Shift-M load GLB character  Q balance" if i == 18
            return "Drag a view to orbit, right-drag to pan, scroll to zoom, click a bone to select" if i == 19
            return "Retime: Shift-drag the timeline, Shift-1..7 preset, = type a speed" if i == 20
            return "Escape cancels one thing at a time: this sheet, a drag, a contact" if i == 21
            return "press, the gizmo, then the selection." if i == 22
            return "Drag a speed band edge to move it, Delete removes the band" if i == 23
            return "?  show / hide this sheet" if i == 24
            return "Contact interval: Shift+Left/Right move; Shift+[/] first; Shift+Up/Down last" if i == 25
            return "Click First/Last, type a 1-based frame, Enter applies; Escape cancels" if i == 26
            return "Reset… clears contacts, local corrections, or restores source result" if i == 27
            return "Restore removes cleanup and retiming; each reset is one Cmd-Z step" if i == 28
            return "Cmd-D  duplicate the selected operation after itself" if i == 29
            return "Cmd-G  frame (1-based); Cmd-Shift-G  clip time in seconds" if i == 30
            return "Home / End  first / last frame; Shift-Home / End  selection start / end" if i == 31
            return "Cmd-Up / Down  previous / next contact-state transition" if i == 32
            return "Cmd-PgUp / PgDn  previous / next enabled correction key" if i == 33
            ""

    public:
        def help_sheet(w: f32, h: f32) -> void:
            sw: f32 = 620.0
            sh: f32 = 60.0 + HELP_LINES.f32() * 19.0
            x: f32 = (w - sw) * 0.5
            y: f32 = (h - sh) * 0.5
            StudioDraw::rect(0.0, 0.0, w, h, UiCore::Color{r: 0, g: 0, b: 0, a: 150})
            StudioDraw::rect(x, y, sw, sh, StudioDraw::color(30, 33, 41))
            StudioDraw::bold(x + 24.0, y + 18.0, 16.0, "Keyboard shortcuts", StudioDraw::ink())
            for i in 0..<HELP_LINES |i, x, y|:
                line: sview = help_line(i)
                heading: bool = i == 0 or i == 3 or i == 13 or i == 16
                if heading:
                    StudioDraw::bold(x + 24.0, y + 52.0 + i.f32() * 19.0, 11.0, line, StudioDraw::accent())
                else:
                    StudioDraw::text(x + 24.0, y + 52.0 + i.f32() * 19.0, 12.0, line, StudioDraw::ink())

        # First-run guide or load failure, drawn over the empty views.
        def guide(w: f32, h: f32, screen: StudioChrome::Screen, failure_message: sview) -> void:
            b: Box = view_box(0, w, h)
            # Titles and retry guidance must stay inside the empty viewport too.
            UiCore::set_clip(UiCore::Rect(b.x, b.y, b.w, b.h))
            x: f32 = b.x + 40.0
            y: f32 = b.y + 40.0
            if screen == StudioChrome::Screen.Failed:
                StudioDraw::bold(x, y, 18.0, "Could not open the take", StudioDraw::severity_color(2))
                # Use the same platform font metrics as ordinary UI widgets.
                # The shared planner keeps breaks at grapheme boundaries; draw
                # every borrowed line before another layout replaces its cache.
                detail: sview = failure_message if failure_message.len > 0 else "Check the GLB or FBX and animation name, then try opening another take."
                width: i64 = StudioFailureGuideLayoutPolicy::Layout::MAX_EXTENT if b.w > StudioFailureGuideLayoutPolicy::Layout::MAX_EXTENT.f32() else b.w.i64() if b.w > 0.0 else 0
                height: i64 = StudioFailureGuideLayoutPolicy::Layout::MAX_EXTENT if b.h > StudioFailureGuideLayoutPolicy::Layout::MAX_EXTENT.f32() else b.h.i64() if b.h > 0.0 else 0
                planned: UiTextMeasureLayout::Layout = UiTextMeasureLayout::layout(detail,
                    StudioFailureGuideLayoutPolicy::content_width(width).f32(), 13.0)
                visible: usize = min(planned.line_count, StudioFailureGuideLayoutPolicy::rows(height).usize())
                for line in 0..<visible |line, detail, x, y|:
                    StudioDraw::text(x, y + 30.0 + line.f32() * StudioFailureGuideLayoutPolicy::Layout::LINE_PITCH.f32(), 13.0,
                        UiTextMeasureLayout::line_view(detail, line), StudioDraw::accent())
                StudioDraw::text(x, y + 38.0 + visible.f32() * StudioFailureGuideLayoutPolicy::Layout::LINE_PITCH.f32(), 12.0,
                    "Cmd-O to retry. Full details: accessible status message." if planned.overflowed or planned.line_count > visible else "Open a GLB or FBX with the folder button or Cmd-O to retry.", StudioDraw::muted())
                UiCore::clear_clip()
                return
            else:
                StudioDraw::bold(x, y, 18.0, "Open a take to start", StudioDraw::ink())
                StudioDraw::text(x, y + 30.0, 13.0, "Open a GLB or FBX with the folder button or Cmd-O.", StudioDraw::ink())
            StudioDraw::text(x, y + 84.0, 13.0, "Inspect findings, preview a repair, compare with the source, then export.", StudioDraw::ink())
            StudioDraw::text(x, y + 106.0, 13.0, "Your source take stays unchanged. Press ? for shortcuts and help.", StudioDraw::muted())
            UiCore::clear_clip()

        # Status bar: frame, clip time, rate, selection and the last message.
        def status_bar(sb: Box, frame: i64, count: i64, rate: i64, time_us: i64, selected: i64, slide: i64, spikes: i64, dirty: bool, message: sview) -> void:
            StudioDraw::rect(sb.x, sb.y, sb.w, sb.h, StudioDraw::color(24, 27, 34))
            width: i64 = StudioStatusBarLayoutPolicy::Layout::MAX_WIDTH if sb.w > StudioStatusBarLayoutPolicy::Layout::MAX_WIDTH.f32() else sb.w.i64() if sb.w > 0.0 else 0
            start: i64 = StudioStatusBarLayoutPolicy::message_start(width)
            message_space: i64 = StudioStatusBarLayoutPolicy::message_width(width)
            if message_space > 0:
                UiCore::set_clip(UiCore::Rect(sb.x + start.f32(), sb.y, message_space.f32(), sb.h))
                StudioDraw::text(sb.x + start.f32(), sb.y + 5.0, 12.0, message, StudioDraw::accent())
                UiCore::clear_clip()
            StudioText::begin()
            StudioText::put("Frame ")
            StudioText::put_i(StudioChrome::shown_frame(frame, count) if frame >= 0 and frame < count and count >= 1 and count <= StudioChrome::Frame::MAX_FRAMES else 0)
            StudioText::put(" / ")
            StudioText::put_i(count)
            StudioText::put("   ")
            if time_us >= 0:
                StudioText::put_seconds6(time_us)
                StudioText::put(" s   ")
            else:
                StudioText::put("time unavailable   ")
            StudioText::put("~")
            StudioText::put_i(rate)
            StudioText::put(" fps   ")
            if selected >= 0:
                StudioText::put("operation ")
                StudioText::put_i(selected + 1)
            else:
                StudioText::put("no selection")
            if dirty:
                StudioText::put("   * Unsaved changes")
            summary_space: i64 = StudioStatusBarLayoutPolicy::summary_width(width)
            if summary_space > 0:
                UiCore::set_clip(UiCore::Rect(sb.x + 12.0, sb.y, summary_space.f32(), sb.h))
                StudioDraw::text(sb.x + 12.0, sb.y + 5.0, 12.0, StudioText::view(), StudioDraw::ink())
                UiCore::clear_clip()

        # Whether a toggle button is lit.
        def lit(action: i64, flags: i64, t: TimelineState::State&) -> bool:
            return t.looping if action == ToolbarAction.Loop.i64()
            return StudioScene::on(flags, StudioScene::Flags::TRAILS) if action == ToolbarAction.Trails.i64()
            return StudioScene::on(flags, StudioScene::Flags::CONTACTS) if action == ToolbarAction.Contacts.i64()
            return StudioScene::on(flags, StudioScene::Flags::HEAT) if action == ToolbarAction.Heat.i64()
            return StudioScene::on(flags, StudioScene::Flags::ONION) if action == ToolbarAction.Onion.i64()
            return StudioScene::on(flags, StudioScene::Flags::GHOST) if action == ToolbarAction.Ghost.i64()
            return StudioScene::on(flags, StudioScene::Flags::XRAY) if action == ToolbarAction.Xray.i64()
            return StudioScene::on(flags, StudioScene::Flags::MESH) if action == ToolbarAction.Mesh.i64()
            return StudioScene::on(flags, StudioScene::Flags::BALANCE) if action == ToolbarAction.Balance.i64()
            false

        def toolbar(t: TimelineState::State&, flags: i64, can_undo: bool, can_redo: bool, can_play: bool, character_available: bool) -> void:
            for i in 0..<PanelLimit::BUTTONS |i, t, flags, can_undo, can_redo, can_play, character_available|:
                b: Box = button_box(i)
                on: bool = lit(i, flags, t) and (i != ToolbarAction.Mesh.i64() or character_available)
                StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(70, 60, 40) if on else StudioDraw::panel())
                dim: bool = (i == ToolbarAction.Play.i64() and not can_play) or (i == ToolbarAction.Undo.i64() and not can_undo) or (i == ToolbarAction.Redo.i64() and not can_redo) or (i == ToolbarAction.Mesh.i64() and not character_available)
                c: UiCore::Color = StudioDraw::accent() if on else (StudioDraw::color(80, 86, 100) if dim else StudioDraw::ink())
                if i == ToolbarAction.Speed.i64():
                    StudioDraw::text(b.x + 3.0, b.y + 9.0, 12.0, TimelineState::speed_label(t.divisor), c)
                elif i == PrivateToolbarAction::Clean:
                    StudioDraw::rect(b.x, b.y, b.w, b.h, StudioDraw::color(52, 72, 60))
                    StudioIcons::draw(StudioIcons::Icon.Clean, b.x + 6.0, b.y + 6.0, 20.0, StudioDraw::ink())
                else:
                    StudioIcons::draw(icon_of(i, t.playing), b.x + 6.0, b.y + 6.0, 20.0, c)

        # Left edge of `frame`; frames at or past the end map to the strip's
        # right edge (x_of_frame requires 0 <= frame < count).
