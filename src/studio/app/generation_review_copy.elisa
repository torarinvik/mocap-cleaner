include "../io/build_generation_candidate_provider.elisa"
include "../state/generation_receipt_control_policy.elisa"

module StudioGenerationReviewCopy:
    public:
        def protection(row: StudioBuildGenerationCandidateProvider::Row) -> sview:
            return "Verified older generation. Review before moving to recoverable storage." if row.protection == StudioBuildGenerationCandidateProvider::Protection.Eligible
            return "Current product or retained previous package. Keep protected." if row.protection == StudioBuildGenerationCandidateProvider::Protection.Current
            return "In use, or exclusive access is unavailable. Keep protected." if row.protection == StudioBuildGenerationCandidateProvider::Protection.Active
            return "Recovery metadata is unresolved. Preserve it until recovery is checked." if row.protection == StudioBuildGenerationCandidateProvider::Protection.Recovery
            return "Incomplete build. Preserve it for recovery." if row.protection == StudioBuildGenerationCandidateProvider::Protection.Unsealed
            if row.protection == StudioBuildGenerationCandidateProvider::Protection.Retention:
                match row.age:
                    StudioBuildGenerationCandidateProvider::AgeEvidence.Unknown:
                        return "Age could not be verified. Retention cannot authorize cleanup."
                    StudioBuildGenerationCandidateProvider::AgeEvidence.Verified(days, origin):
                        return "Within the chosen retention period. Keep protected."
            "Ownership or integrity could not be verified. Keep protected."

        def receipt_scope(scope: StudioGenerationReceiptControlPolicy::Evidence) -> sview:
            return "Recovery checked the recorded product, inventory, lease and reviewed metadata." if scope == StudioGenerationReceiptControlPolicy::Evidence.ReviewedControls
            return "Legacy recovery checks product, inventory and lease; reviewed metadata was not recorded." if scope == StudioGenerationReceiptControlPolicy::Evidence.Legacy
            "Recovery evidence could not be verified. Restore is unavailable."

        def moved_bytes_explanation() -> sview:
            "Moving to recoverable storage keeps the files on disk. Moved bytes are not freed space."
