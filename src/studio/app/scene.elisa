# The 3D scene of one studio view, as an engine draw list: ground grid,
# before/after ghost (the raw source pose), onion skins, joint trails (plain
# or acceleration heat), foot contacts and the skeleton overlay of the
# cleaned pose. Every overlay is an engine feature (MotionOverlay,
# SkeletonOverlay); this file only chooses what to show. The same list feeds
# the on-screen Metal viewports and the headless raster capture.
include "model.elisa"
include "../../../../elisa-engine-mocap/src/viewport/skeleton_overlay.elisa"
include "../../../../elisa-engine-mocap/src/viewport/motion_overlay.elisa"
include "../../../../elisa-engine-mocap/src/viewport/mesh_overlay.elisa"
include "../../../../elisa-engine-mocap/src/viewport/gizmo.elisa"
include "../../../../elisa-engine-mocap/src/viewport/balance_overlay.elisa"

module StudioScene:
    public:
        # Overlay switches (a bit mask).
        const TRAILS: i64 = 1
        const CONTACTS: i64 = 2
        const HEAT: i64 = 4
        const ONION: i64 = 8
        const GHOST: i64 = 16
        const XRAY: i64 = 32
        const MESH: i64 = 64
        # Centre of mass and support polygon (Phase 4).
        const BALANCE: i64 = 128
        const DEFAULT_FLAGS: i64 = 1 + 2 + 16 + 32 + 128

        const TRAIL_BEFORE: i64 = 60
        const TRAIL_AFTER: i64 = 60
        const ONION_COUNT: i64 = 3
        const ONION_STEP: i64 = 8

        def on(flags: i64, bit: i64) -> bool:
            return (flags / bit) % 2 == 1

        def toggle(flags: i64, bit: i64) -> i64:
            return flags - bit if on(flags, bit) else flags + bit

        def style(flags: i64) -> SkeletonOverlay::Style:
            mutable s: SkeletonOverlay::Style = SkeletonOverlay::default_style()
            s.xray <- on(flags, XRAY)
            # The mesh itself is drawn by `build` (MeshOverlay).
            s.show_mesh <- on(flags, MESH)
            return s

        def draw_trail(list: mutable ViewportDraw::List&, track: darray[Geometry::Vec3]&, frame: i64, flags: i64, color: u32) -> i64:
            if on(flags, HEAT):
                heat: MotionOverlay::Heat = MotionOverlay::Heat{mode: MotionOverlay::ACCELERATION, low: 0.0, high: 60.0, fps: Timeline::RATE.f32()}
                return catch MotionOverlay::heat_trail(list, track, frame, TRAIL_BEFORE, TRAIL_AFTER, &heat, ViewportDraw::TOP):
                    value: value.i64()
                    error failure: 0
            return catch MotionOverlay::trail(list, track, frame, TRAIL_BEFORE, TRAIL_AFTER, color, ViewportDraw::TOP):
                value: value.i64()
                error failure: 0

        # Planted stretches of a foot trail, drawn over the trail as a
        # bright doubled line so the frames the foot cleanup pins read apart
        # from the swing. Returns the segments drawn.
        def draw_planted(list: mutable ViewportDraw::List&, track: darray[Geometry::Vec3]&, planted: darray[bool]&, frame: i64, color: u32) -> i64:
            n: i64 = track.count.i64()
            return 0 if n < 2 or planted.count.i64() != n
            lo: i64 = frame - TRAIL_BEFORE if frame - TRAIL_BEFORE > 0 else 0
            hi: i64 = frame + TRAIL_AFTER if frame + TRAIL_AFTER < n - 1 else n - 1
            mutable drawn: i64 = 0
            for f in lo..<hi |f, list, track, planted, color, drawn|:
                if planted[f.usize()] and planted[(f + 1).usize()]:
                    a: Geometry::Vec3 = track[f.usize()]
                    b: Geometry::Vec3 = track[(f + 1).usize()]
                    up: Geometry::Vec3 = Geometry::Vec3{x: 0.0, y: 0.006, z: 0.0}
                    ok: i64 = catch ViewportDraw::line(list, a, b, color, ViewportDraw::TOP):
                        value: 1
                        error failure: 0
                    _ = catch ViewportDraw::line(list, Geometry::vec3_add(a, up), Geometry::vec3_add(b, up), color, ViewportDraw::TOP):
                        value: 0
                        error failure: 0
                    drawn <- drawn + ok
            return drawn

        def draw_contacts(list: mutable ViewportDraw::List&, cam: ViewportCamera::Camera&, track: darray[Geometry::Vec3]&, frame: i64, ground: f32, color: u32) -> i64:
            return catch MotionOverlay::contacts(list, cam, track, frame, TRAIL_BEFORE, TRAIL_AFTER, Timeline::RATE.f32(), ground, 0.04, 0.4, 4.0, color, ViewportDraw::TOP):
                value: value.i64()
                error failure: 0

        # Everything one view draws at `frame`. `selected` is a rig slot
        # (-1 for none). Returns the list; drawing failures (vertex budget)
        # drop that overlay only.
        # `skinned` is `mesh` posed at `frame` (pose_mesh); the mesh is drawn
        # when MESH is on and it has vertices.
        def build(cam: ViewportCamera::Camera&, c: StudioModel::Clip&, mesh: GlbSkinMesh::Mesh&, skinned: darray[Geometry::Vec3]&, frame: i64, flags: i64, selected: i64) -> ViewportDraw::List:
            none: darray[Geometry::Transform] = []
            return build_with(cam, c, mesh, skinned, frame, flags, selected, &none)

        # `build`, plus the gizmo's live drag preview: `preview` is the
        # whole rig's model transforms with the dragged bone at its goal
        # (preview_models), drawn as an accent skeleton; empty for none.
        def build_with(cam: ViewportCamera::Camera&, c: StudioModel::Clip&, mesh: GlbSkinMesh::Mesh&, skinned: darray[Geometry::Vec3]&, frame: i64, flags: i64, selected: i64, preview: darray[Geometry::Transform]&) -> ViewportDraw::List:
            mutable list: ViewportDraw::List = ViewportDraw::create()
            _ = catch ViewportDraw::grid(&list, 0.25, 12, ViewportDraw::rgba(70, 74, 84, 255)):
                value: 0
                error failure: 1
            if on(flags, MESH) and skinned.count > 0 and skinned.count == mesh.positions.count:
                light: Geometry::Vec3 = Geometry::Vec3{x: 0.4, y: 0.8, z: 0.6}
                _ = catch MeshOverlay::draw(&list, mesh, skinned, light, MeshOverlay::default_style()):
                    value: value
                    error failure: 0
            r: PoseOverride::Rig = StudioModel::rig(c)
            if on(flags, GHOST):
                raw: darray[Geometry::Transform] = StudioModel::models(c, r, frame, true)
                _ = catch MotionOverlay::ghost(&list, r, raw, ViewportDraw::rgba(235, 80, 120, 200), ViewportDraw::TOP):
                    value: value
                    error failure: 0
            if on(flags, ONION):
                for i in 0..<(2 * ONION_COUNT) |i, list, r, c, frame|:
                    k: i64 = i.i64() - ONION_COUNT if i.i64() < ONION_COUNT else i.i64() - ONION_COUNT + 1
                    f: i64 = MotionOverlay::ghost_frame(frame, k, ONION_STEP, c.frames)
                    m: darray[Geometry::Transform] = StudioModel::models(c, r, f, false)
                    _ = catch MotionOverlay::ghost(&list, r, m, MotionOverlay::ghost_color(k, ONION_COUNT), ViewportDraw::DEPTH):
                        value: value
                        error failure: 0
            if on(flags, TRAILS) or on(flags, HEAT):
                _ = draw_trail(&list, c.left_hand, frame, flags, ViewportDraw::rgba(80, 200, 255, 255))
                _ = draw_trail(&list, c.right_hand, frame, flags, ViewportDraw::rgba(255, 120, 80, 255))
                _ = draw_trail(&list, c.left_foot, frame, flags, ViewportDraw::rgba(120, 220, 120, 255))
                _ = draw_trail(&list, c.right_foot, frame, flags, ViewportDraw::rgba(240, 220, 90, 255))
                _ = draw_planted(&list, c.left_foot, c.left_contact, frame, ViewportDraw::rgba(220, 255, 230, 255))
                _ = draw_planted(&list, c.right_foot, c.right_contact, frame, ViewportDraw::rgba(255, 250, 215, 255))
            if on(flags, CONTACTS):
                _ = draw_contacts(&list, cam, c.left_foot, frame, c.ground, ViewportDraw::rgba(120, 255, 140, 255))
                _ = draw_contacts(&list, cam, c.right_foot, frame, c.ground, ViewportDraw::rgba(255, 230, 90, 255))
            if on(flags, BALANCE):
                _ = draw_balance(&list, cam, c, frame)
            if preview.count > 0:
                _ = catch MotionOverlay::ghost(&list, r, preview, ViewportDraw::rgba(255, 170, 40, 255), ViewportDraw::TOP):
                    value: value
                    error failure: 0
            models: darray[Geometry::Transform] = StudioModel::models(c, r, frame, false)
            st: SkeletonOverlay::Style = style(flags)
            target: SkeletonOverlay::Target = SkeletonOverlay::joint(selected) if selected >= 0 else SkeletonOverlay::nothing()
            _ = catch SkeletonOverlay::draw(&list, cam, r, models, st, target, SkeletonOverlay::nothing()):
                value: value
                error failure: 0
            return move list

        # Centre of mass, plumb line and support polygon at `frame`; the
        # marker turns red on frames the balance detector reports as
        # impossible. Returns primitives drawn (0 when unavailable).
        def draw_balance(list: mutable ViewportDraw::List&, cam: ViewportCamera::Camera&, c: StudioModel::Clip&, frame: i64) -> i64:
            return 0 if frame < 0 or frame >= c.frames or frame.usize() >= c.com.count or frame.usize() >= c.balance.count
            support: darray[Geometry::Vec3] = StudioModel::support_at(c, frame)
            ok: bool = not StudioOverlay::marked(c.balance[frame.usize()])
            return catch BalanceOverlay::draw(list, cam, c.com[frame.usize()], c.balance_ground, &support, ok, BalanceOverlay::default_style(), ViewportDraw::TOP):
                value: value.i64()
                error failure: 0

        # Model transforms of the cleaned pose at `frame` with rig slot `bone`
        # moved to model transform `goal` (its children follow): the gizmo's
        # live drag preview. Empty when `bone` is out of range.
        def preview_models(c: StudioModel::Clip&, frame: i64, bone: i64, goal: Geometry::Transform) -> darray[Geometry::Transform]:
            r: PoseOverride::Rig = StudioModel::rig(c)
            models: darray[Geometry::Transform] = StudioModel::models(c, r, frame, false)
            mutable none: darray[Geometry::Transform] = []
            return none if bone < 0 or bone.usize() >= models.count
            mutable locals: darray[Geometry::Transform] = StudioClip::locals_at(c.cleaned, c.anim, frame, c.nodes, c.slot)
            return none if locals.count != models.count
            parent: i64 = PoseOverride::rig_parent(r, bone.usize())
            locals[bone.usize()] <- Geometry::transform_apply_inverse(models[parent.usize()], goal) if parent >= 0 else goal
            mutable held: PoseOverride::Overrides = PoseOverride::overrides(r)
            for k in 0..<locals.count |k, held, locals|:
                _ = PoseOverride::set_override(&held, k, locals[k])
            mutable out: darray[Geometry::Transform] = []
            _ = catch PoseOverride::evaluate_rest(r, held, &out):
                value: 0
                error failure: 1
            return out

        # `mesh` skinned by the cleaned pose at `frame`. Skin joints outside
        # the rig keep the identity transform. Empty on any mismatch.
        def pose_mesh(c: StudioModel::Clip&, mesh: GlbSkinMesh::Mesh&, frame: i64) -> darray[Geometry::Vec3]:
            mutable out: darray[Geometry::Vec3] = []
            return out if GlbSkinMesh::vertex_count(mesh) == 0
            r: PoseOverride::Rig = StudioModel::rig(c)
            models: darray[Geometry::Transform] = StudioModel::models(c, r, frame, false)
            mutable joints: darray[Geometry::Transform] = []
            for j in 0..<GlbSkinMesh::joint_count(mesh) |j, joints, mesh, c, models|:
                node: i64 = GlbSkinMesh::joint_node(mesh, j)
                s: i64 = c.slot[node.usize()] if node >= 0 and node.usize() < c.slot.count else -1
                if s >= 0 and s.usize() < models.count:
                    joints.push(models[s.usize()])
                else:
                    joints.push(Geometry::transform_identity())
            _ = catch MeshOverlay::skin(mesh, &joints, &out):
                value: value
                error failure: 0
            return out

        # Rig slot `bone`'s model transform at `frame` (identity when out of range).
        def bone_model(c: StudioModel::Clip&, frame: i64, bone: i64) -> Geometry::Transform:
            r: PoseOverride::Rig = StudioModel::rig(c)
            models: darray[Geometry::Transform] = StudioModel::models(c, r, frame, false)
            return Geometry::transform_identity() if bone < 0 or bone.usize() >= models.count
            return models[bone.usize()]

        # The gizmo (GizmoPolicy mode) on the selected bone, local axes.
        def gizmo_for(c: StudioModel::Clip&, frame: i64, bone: i64, mode: i64) -> Gizmo::Gizmo:
            return Gizmo::create(mode, Gizmo::LOCAL, bone_model(c, frame, bone))

        # Joint positions of the cleaned pose at `frame` (for framing).
        def points(c: StudioModel::Clip&, frame: i64) -> darray[Geometry::Vec3]:
            r: PoseOverride::Rig = StudioModel::rig(c)
            models: darray[Geometry::Transform] = StudioModel::models(c, r, frame, false)
            out: mutable darray[Geometry::Vec3] = []
            for m in models |m, out|:
                out.push(m.position)
            return out

        # Rig slot of the joint under pixel (px, py), or -1.
        def pick(cam: ViewportCamera::Camera&, c: StudioModel::Clip&, frame: i64, flags: i64, px: f32, py: f32) -> i64:
            r: PoseOverride::Rig = StudioModel::rig(c)
            models: darray[Geometry::Transform] = StudioModel::models(c, r, frame, false)
            st: SkeletonOverlay::Style = style(flags)
            hit: SkeletonOverlay::Hit = SkeletonOverlay::pick(cam, r, models, st, px, py)
            return hit.bone if hit.kind == SkeletonPickPolicy::JOINT or hit.kind == SkeletonPickPolicy::BONE
            return -1
