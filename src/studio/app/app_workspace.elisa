# Canonical D01 workspace state and root-relative derived paths. The root is
# loaded from per-user host preferences, never inferred from process cwd.
include "app_state.elisa"
include "../workspace_root_adapter.elisa"

extend Studio:
    private:
        const module WorkspaceLimit:
            PATH_CAPACITY: usize = 4096
            MAX_ROOT_BYTES: usize = 4000
            MAX_LEAF_BYTES: usize = 255

        global mutable workspace_ready: bool = false
        global mutable workspace_create_pending: bool = false
        global mutable workspace_root_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_pending_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_export_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_session_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_manifest_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_lock_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_preferences_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_exemptions_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_build_bytes: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_root: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_export: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_session: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_manifest: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_lock: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_preferences: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_exemptions: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed
        global mutable workspace_candidate_build: u8[WorkspaceLimit::PATH_CAPACITY] = zeroed

        def copy_path_bytes(destination: mutable u8[4096]&, source: cstr) -> bool can Unsafe.PointerCast:
            mutable index: usize = 0
            while index < WorkspaceLimit::PATH_CAPACITY:
                value: u8 = source[index]
                destination[index] <- value
                if value == 0:
                    return index > 0
                index <- index + 1
            false

        def append_leaf(destination: mutable u8[4096]&, source_root: u8[4096]&,
                        prefix_bytes: usize, leaf: cstr) -> bool can Unsafe.PointerCast:
            return false if prefix_bytes == 0 or prefix_bytes >= WorkspaceLimit::PATH_CAPACITY - 2
            mutable index: usize = 0
            while index < prefix_bytes:
                destination[index] <- source_root[index]
                index <- index + 1
            if destination[index - 1] != 47:
                destination[index] <- 47
                index <- index + 1
            for byte in [98, 117, 105, 108, 100, 47]:
                return false if index >= WorkspaceLimit::PATH_CAPACITY - 1
                destination[index] <- byte.u8()
                index <- index + 1
            mutable leaf_index: usize = 0
            return false if leaf[0] == 0 or leaf[0] == 47
            while leaf_index < WorkspaceLimit::MAX_LEAF_BYTES and leaf[leaf_index] != 0:
                return false if leaf[leaf_index] == 47 or leaf[leaf_index] == 92
                return false if index >= WorkspaceLimit::PATH_CAPACITY - 1
                destination[index] <- leaf[leaf_index]
                index <- index + 1
                leaf_index <- leaf_index + 1
            return false if leaf_index == WorkspaceLimit::MAX_LEAF_BYTES or (leaf_index == 1 and leaf[0] == 46) or (leaf_index == 2 and leaf[0] == 46 and leaf[1] == 46)
            destination[index] <- 0
            true

        def append_build_dir(destination: mutable u8[WorkspaceLimit::PATH_CAPACITY]&, source_root: u8[WorkspaceLimit::PATH_CAPACITY]&, prefix_bytes: usize) -> bool:
            return false if prefix_bytes == 0 or prefix_bytes >= WorkspaceLimit::PATH_CAPACITY - 7
            mutable index: usize = 0
            while index < prefix_bytes:
                destination[index] <- source_root[index]
                index <- index + 1
            if destination[index - 1] != 47:
                destination[index] <- 47
                index <- index + 1
            for byte in [98, 117, 105, 108, 100]:
                destination[index] <- byte.u8()
                index <- index + 1
            destination[index] <- 0
            true

        def workspace_root_copy(path: cstr) -> bool can Unsafe.PointerCast:
            mutable index: usize = 0
            while index < WorkspaceLimit::PATH_CAPACITY:
                value: u8 = path[index]
                workspace_candidate_root[index] <- value
                return index > 0 if value == 0
                index <- index + 1
            false

        def stage_workspace_paths(path: cstr) -> bool can[Unsafe.PointerCast, Memory.Allocate, Memory.Release]:
            mutable root_length: usize = 0
            while root_length < WorkspaceLimit::PATH_CAPACITY and path[root_length] != 0:
                root_length <- root_length + 1
            return false if root_length == 0 or root_length > WorkspaceLimit::MAX_ROOT_BYTES
            return false if not workspace_root_copy(path)
            return false if not append_leaf(&workspace_candidate_export, &workspace_candidate_root, root_length, "studio_export.glb".cast[cstr])
            return false if not append_leaf(&workspace_candidate_session, &workspace_candidate_root, root_length, "studio_session.txt".cast[cstr])
            return false if not append_leaf(&workspace_candidate_manifest, &workspace_candidate_root, root_length, "studio_storage_manifest.txt".cast[cstr])
            return false if not append_leaf(&workspace_candidate_lock, &workspace_candidate_root, root_length, "studio_storage_manifest.lock".cast[cstr])
            return false if not append_leaf(&workspace_candidate_preferences, &workspace_candidate_root, root_length, "studio_storage_preferences.txt".cast[cstr])
            return false if not append_leaf(&workspace_candidate_exemptions, &workspace_candidate_root, root_length, "studio_storage_exemptions.txt".cast[cstr])
            return false if not append_build_dir(&workspace_candidate_build, &workspace_candidate_root, root_length)
            true

        def commit_workspace_paths() -> void can Unsafe.PointerCast:
            for index in 0..<WorkspaceLimit::PATH_CAPACITY |index|:
                workspace_root_bytes[index] <- workspace_candidate_root[index]
                workspace_export_bytes[index] <- workspace_candidate_export[index]
                workspace_session_bytes[index] <- workspace_candidate_session[index]
                workspace_manifest_bytes[index] <- workspace_candidate_manifest[index]
                workspace_lock_bytes[index] <- workspace_candidate_lock[index]
                workspace_preferences_bytes[index] <- workspace_candidate_preferences[index]
                workspace_exemptions_bytes[index] <- workspace_candidate_exemptions[index]
                workspace_build_bytes[index] <- workspace_candidate_build[index]
            export_path <- (&workspace_export_bytes[0]).cast[cstr]
            EXPORT_PATH <- export_path
            session_path <- (&workspace_session_bytes[0]).cast[cstr]
            SESSION_PATH <- session_path
            STORAGE_MANIFEST_PATH <- (&workspace_manifest_bytes[0]).cast[cstr]
            STORAGE_LOCK_PATH <- (&workspace_lock_bytes[0]).cast[cstr]
            STORAGE_PREFERENCES_PATH <- (&workspace_preferences_bytes[0]).cast[cstr]
            STORAGE_EXEMPTIONS_PATH <- (&workspace_exemptions_bytes[0]).cast[cstr]

        def workspace_operation_active() -> bool:
            storage_batch_state == StudioStorageBatchPolicy::State.Running.i64() or export_review_open or export_result_open

        def pending_root() -> cstr can Unsafe.PointerCast:
            (&workspace_pending_bytes[0]).cast[cstr]

        def workspace_path_fits(path: cstr) -> bool can Unsafe.PointerCast:
            mutable length: usize = 0
            while length <= WorkspaceLimit::MAX_ROOT_BYTES and path[length] != 0:
                length <- length + 1
            length > 0 and length <= WorkspaceLimit::MAX_ROOT_BYTES

        def workspace_reset_storage_context() -> void:
            storage_cleanup_selection <- []
            storage_inventory_entries <- []
            storage_inventory_statuses <- []
            storage_inventory_reasons <- []
            storage_visible_entries <- []
            storage_visible_statuses <- []
            storage_visible_reasons <- []
            storage_entries <- []
            storage_manifest_state <- 0
            storage_preferences_valid <- false
            storage_exemptions_valid <- false
            storage_selection_bytes <- 0
            storage_selection_removed <- 0
            storage_selected <- -1
            storage_restore_review <- false
            storage_move_review <- false
            storage_retained_receipt <- null
            storage_move_entry <- zeroed
            storage_move_outcome <- StudioStorageMovePolicy::OUTCOME_NOT_STARTED
            storage_batch_cancel <- true if storage_batch_state == StudioStorageBatchPolicy::State.Running.i64()
            storage_batch_entries <- [] if storage_batch_state != StudioStorageBatchPolicy::State.Running.i64()
            storage_batch_items <- [] if storage_batch_state != StudioStorageBatchPolicy::State.Running.i64()
            storage_batch_state <- StudioStorageBatchPolicy::State.Idle.i64() if storage_batch_state != StudioStorageBatchPolicy::State.Running.i64()

    public:
        def initialize_workspace_root() -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            if StudioWorkspaceRootAdapter::load() is stored:
                decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootAdapter::inspect(stored, false, false)
                if decision == StudioWorkspaceRootPolicy::Decision.READY:
                    staged: bool = stage_workspace_paths(stored)
                    if StudioWorkspaceRootPolicy::commit_admitted(decision, true, staged, workspace_operation_active()):
                        commit_workspace_paths()
                        workspace_ready <- true
                StudioWorkspaceRootAdapter::release(stored)
            if not workspace_ready:
                export_path <- ""
                session_path <- ""
                EXPORT_PATH <- ""
                SESSION_PATH <- ""
                STORAGE_MANIFEST_PATH <- ""
                STORAGE_LOCK_PATH <- ""
                STORAGE_PREFERENCES_PATH <- ""
                STORAGE_EXEMPTIONS_PATH <- ""
                status <- "Workspace unavailable. Choose Locate workspace to select a writable build folder."
                status_file <- null
            workspace_ready

        # Null choice and validation failures leave the active root and
        # document unchanged. Missing build/ is held pending for explicit UI
        # confirmation; this method never creates a directory implicitly.
        def locate_workspace_root() -> StudioWorkspaceRootPolicy::Decision can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            if workspace_operation_active():
                status <- "Finish the active Storage or export action before changing workspace."
                status_file <- null
                touch()
                return StudioWorkspaceRootPolicy::Decision.UNWRITABLE
            workspace_create_pending <- false
            workspace_pending_bytes[0] <- 0
            mutable current: cstr? = null
            if workspace_ready:
                current <- (&workspace_root_bytes[0]).cast[cstr]
            if StudioWorkspaceRootAdapter::choose(current) is chosen:
                decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootAdapter::inspect(chosen, false, false)
                if decision == StudioWorkspaceRootPolicy::Decision.READY:
                    staged: bool = workspace_path_fits(chosen) and stage_workspace_paths(chosen)
                    persisted: bool = staged and StudioWorkspaceRootAdapter::persist(chosen, decision)
                    if StudioWorkspaceRootPolicy::commit_admitted(decision, persisted, staged, workspace_operation_active()):
                        _ = workspace_reset_storage_context()
                        commit_workspace_paths()
                        workspace_ready <- true
                        workspace_create_pending <- false
                        status <- "Workspace ready"
                        status_file <- null
                        refresh_storage_inventory() if storage_screen_open
                    else:
                        status <- "Workspace could not be saved. The current document and workspace remain active."
                elif decision == StudioWorkspaceRootPolicy::Decision.NEEDS_BUILD:
                    workspace_create_pending <- workspace_path_fits(chosen) and copy_path_bytes(&workspace_pending_bytes, chosen)
                    status <- "This workspace has no build folder. Choose Create build to continue." if workspace_create_pending
                    status <- "Workspace path is too long. Choose another folder." if not workspace_create_pending
                    status_file <- null
                elif decision == StudioWorkspaceRootPolicy::Decision.UNWRITABLE:
                    status <- "Workspace build folder is not writable. Choose another workspace."
                    status_file <- null
                else:
                    status <- "Workspace could not be verified. Choose another folder."
                    status_file <- null
                StudioWorkspaceRootAdapter::release(chosen)
                return decision
            StudioWorkspaceRootPolicy::Decision.CANCELLED

        # This must be called only after an explicit Create build action.
        def create_workspace_build() -> bool can[Unsafe.PointerCast, Blocking.IO, Memory.Allocate, Memory.Release]:
            return false if not workspace_create_pending
            if workspace_operation_active():
                status <- "Finish the active Storage or export action before creating build/."
                status_file <- null
                touch()
                return false
            return false if not workspace_path_fits(pending_root())
            decision: StudioWorkspaceRootPolicy::Decision = StudioWorkspaceRootAdapter::inspect(pending_root(), true, false)
            return false if decision != StudioWorkspaceRootPolicy::Decision.CREATE_BUILD
            staged: bool = stage_workspace_paths(pending_root())
            created: bool = staged and StudioWorkspaceRootAdapter::create_build(pending_root(), decision)
            if created:
                if StudioWorkspaceRootPolicy::commit_admitted(StudioWorkspaceRootPolicy::Decision.READY, created, staged, workspace_operation_active()):
                    _ = workspace_reset_storage_context()
                    commit_workspace_paths()
                    workspace_ready <- true
                    workspace_create_pending <- false
                    status <- "Workspace ready"
                    status_file <- null
                    refresh_storage_inventory() if storage_screen_open
                else:
                    status <- "Could not commit workspace paths. The current document and workspace remain active."
                    status_file <- null
            else:
                status <- "Could not create or verify build/. The current document and workspace remain active."
                status_file <- pending_root()
            created and workspace_ready

        def workspace_available() -> bool:
            workspace_ready

        def workspace_needs_build_confirmation() -> bool:
            workspace_create_pending

        def workspace_root_path() -> cstr? can Unsafe.PointerCast:
            return null if not workspace_ready
            (&workspace_root_bytes[0]).cast[cstr]

        def workspace_display_path() -> cstr? can Unsafe.PointerCast:
            return pending_root() if workspace_create_pending
            workspace_root_path()

        def workspace_build_dir() -> cstr? can Unsafe.PointerCast:
            return null if not workspace_ready
            (&workspace_build_bytes[0]).cast[cstr]

        def workspace_build_directory() -> cstr can Unsafe.PointerCast:
            return (&workspace_build_bytes[0]).cast[cstr] if workspace_ready
            "".cast[cstr]

        # Produces a bounded absolute path into the caller-owned output array.
        def workspace_build_path(leaf: cstr, output: mutable u8[WorkspaceLimit::PATH_CAPACITY]&) -> cstr? can Unsafe.PointerCast:
            return null if not workspace_ready
            mutable root_length: usize = 0
            while root_length < WorkspaceLimit::PATH_CAPACITY and workspace_root_bytes[root_length] != 0:
                root_length <- root_length + 1
            return null if not append_leaf(output, &workspace_root_bytes, root_length, leaf)
            (&output[0]).cast[cstr]
