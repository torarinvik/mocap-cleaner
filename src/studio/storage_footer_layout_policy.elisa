# Integer layout decisions shared by Storage drawing and hit/accessibility boxes.
module StudioStorageFooterLayoutPolicy:
    public:
        const module Layout:
            ACTION_COUNT: i64 = 5
            HORIZONTAL_MARGIN: i64 = 48
            COLUMN_PITCH: i64 = 140
            COLUMN_GAP: i64 = 8
            ROW_PITCH: i64 = 42

        def columns(dialog_width: i64) -> i64:
            ensure result >= 1 and result <= Layout::ACTION_COUNT
            return 1 if dialog_width < Layout::HORIZONTAL_MARGIN + Layout::COLUMN_PITCH - Layout::COLUMN_GAP
            available: i64 = dialog_width - Layout::HORIZONTAL_MARGIN
            count: i64 = (available + Layout::COLUMN_GAP) / Layout::COLUMN_PITCH
            Layout::ACTION_COUNT if count > Layout::ACTION_COUNT else count

        def rows(dialog_width: i64) -> i64:
            ensure result >= 1 and result <= Layout::ACTION_COUNT
            count: i64 = columns(dialog_width)
            (Layout::ACTION_COUNT + count - 1) / count

        def extra_height(dialog_width: i64) -> i64:
            ensure result >= 0 and result <= 168
            (rows(dialog_width) - 1) * Layout::ROW_PITCH

        def header_height(dialog_width: i64) -> i64:
            ensure result == 0 or result == Layout::ROW_PITCH
            Layout::ROW_PITCH if dialog_width < 740 else 0

        def content_height(dialog_width: i64) -> i64:
            ensure result == 0 or result == 84
            header_height(dialog_width) * 2
