# Numeric speed drafts remain bound to the history and target that opened them.
module StudioRetimeDraftPolicy:
    public:
        struct Target:
            generation: i64
            range_selected: bool
            first: i64
            last: i64
            band: i64

        def current(captured: Target, now: Target) -> bool:
            ensure result == (captured.generation >= 0 and captured.generation == now.generation and captured.range_selected == now.range_selected and captured.first == now.first and captured.last == now.last and captured.band == now.band)
            captured.generation >= 0 and captured.generation == now.generation and captured.range_selected == now.range_selected and captured.first == now.first and captured.last == now.last and captured.band == now.band
