# Deterministic filters for typed motion findings. Subject identity remains
# explicit: -1 denotes an aggregate/unknown subject and is never reassigned.
include "issues.elisa"
module StudioIssueFilterPolicy:
    public:
        const ANY_DETECTOR: i64 = -1
        const ANY_SUBJECT: i64 = -2
        const UNRESOLVED: i64 = 0
        const IGNORED: i64 = 1
        const ANY_STATUS: i64 = 2
        const MAX_SEVERITY: i64 = 1000

        struct Filter:
            detector: i64
            subject: i64
            minimum_severity: i64
            status: i64

        # Disposition is user annotation state supplied separately from the
        # finding. This policy does not mutate the issue or animation.
        def valid_filter(f: Filter) -> bool:
            return f.detector >= ANY_DETECTOR and f.subject >= ANY_SUBJECT and f.minimum_severity >= 0 and f.minimum_severity <= MAX_SEVERITY and (f.status == UNRESOLVED or f.status == IGNORED or f.status == ANY_STATUS)

        def valid_disposition(disposition: i64) -> bool:
            return disposition == UNRESOLVED or disposition == IGNORED

        def detector_matches(issue_detector: i64, filter_detector: i64) -> bool:
            ensure result == (filter_detector == ANY_DETECTOR or issue_detector == filter_detector)
            return filter_detector == ANY_DETECTOR or issue_detector == filter_detector

        def subject_matches(issue_subject: i64, filter_subject: i64) -> bool:
            ensure result == (filter_subject == ANY_SUBJECT or issue_subject == filter_subject)
            return filter_subject == ANY_SUBJECT or issue_subject == filter_subject

        def status_matches(disposition: i64, filter_status: i64) -> bool:
            ensure result == (filter_status == ANY_STATUS or disposition == filter_status)
            return filter_status == ANY_STATUS or disposition == filter_status

        def severity_matches(issue_severity: i64, minimum_severity: i64) -> bool:
            ensure result == (issue_severity >= minimum_severity)
            issue_severity >= minimum_severity

        def matches(issue: StudioIssues::Issue, f: Filter, disposition: i64) -> bool:
            requires valid_filter(f)
            requires valid_disposition(disposition)
            requires f.minimum_severity >= 0 and f.minimum_severity <= MAX_SEVERITY
            requires issue.issue_type >= 0
            requires issue.subject_id >= -1
            requires issue.severity >= 0 and issue.severity <= MAX_SEVERITY
            ensure result == (issue.selectable and detector_matches(issue.issue_type, f.detector) and subject_matches(issue.subject_id, f.subject) and issue.severity >= f.minimum_severity and status_matches(disposition, f.status))
            issue.selectable and detector_matches(issue.issue_type, f.detector) and subject_matches(issue.subject_id, f.subject) and severity_matches(issue.severity, f.minimum_severity) and status_matches(disposition, f.status)
