# Publication outcomes distinguish each sidecar after the GLB was published.
# They describe successful write calls, not crash durability or quality review.
module StudioExportPublicationPolicy:
    public:
        const enum Outcome of i64:
            GlbOnly = 0
            GlbAndJson = 1
            GlbAndText = 2
            Complete = 3

        def sidecar_outcome(json_saved: bool, text_saved: bool) -> Outcome:
            ensure json_saved and text_saved implies result == Outcome.Complete
            ensure json_saved and not text_saved implies result == Outcome.GlbAndJson
            ensure not json_saved and text_saved implies result == Outcome.GlbAndText
            ensure not json_saved and not text_saved implies result == Outcome.GlbOnly
            return Outcome.Complete if json_saved and text_saved
            return Outcome.GlbAndJson if json_saved
            return Outcome.GlbAndText if text_saved
            Outcome.GlbOnly

        def reports_complete(outcome: Outcome) -> bool:
            ensure result == (outcome == Outcome.Complete)
            outcome == Outcome.Complete

        def message(outcome: Outcome) -> sview:
            return "GLB exported and validated; JSON report saved, text report could not be saved" if outcome == Outcome.GlbAndJson
            return "GLB exported and validated; text report saved, JSON report could not be saved" if outcome == Outcome.GlbAndText
            return "exported and validated; both report sidecars saved" if outcome == Outcome.Complete
            "GLB exported and validated; neither report sidecar was saved"

        def result_title(outcome: Outcome) -> sview:
            "Export files saved" if reports_complete(outcome) else "GLB exported; reports incomplete"

        def result_detail(outcome: Outcome) -> sview:
            return "Both reports saved beside the GLB." if outcome == Outcome.Complete
            return "JSON saved; text report not saved. Any existing text report was kept." if outcome == Outcome.GlbAndJson
            return "Text saved; JSON report not saved. Any existing JSON report was kept." if outcome == Outcome.GlbAndText
            "Neither report saved for this export. Existing reports were kept; choose a new export filename to save new reports."

        def accessibility_detail(outcome: Outcome, durability_unknown: bool) -> sview:
            return result_detail(outcome) if not durability_unknown
            return "Both reports saved. Directory durability is unconfirmed; the published files exist." if outcome == Outcome.Complete
            return "JSON saved; text report not saved. Any existing text report was kept. Directory durability is unconfirmed; the published files exist." if outcome == Outcome.GlbAndJson
            return "Text saved; JSON report not saved. Any existing JSON report was kept. Directory durability is unconfirmed; the published files exist." if outcome == Outcome.GlbAndText
            "Neither report saved; existing reports were kept. GLB directory durability is unconfirmed; the published GLB exists."
