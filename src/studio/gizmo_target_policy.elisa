# A drag must remain attached to the pose and document it started editing.
module StudioGizmoTargetPolicy:
    public:
        struct Target:
            generation: i64
            result_generation: i64
            bone: i64
            frame: i64
            view: i64
            mode: i64

        def current(captured: Target, active: Target) -> bool:
            ensure result == (captured.generation >= 0 and captured.result_generation >= 0 and captured.bone >= 0 and captured.frame >= 0 and captured.view >= 0 and captured.mode >= 0 and captured.generation == active.generation and captured.result_generation == active.result_generation and captured.bone == active.bone and captured.frame == active.frame and captured.view == active.view and captured.mode == active.mode)
            captured.generation >= 0 and captured.result_generation >= 0 and captured.bone >= 0 and captured.frame >= 0 and captured.view >= 0 and captured.mode >= 0 and captured.generation == active.generation and captured.result_generation == active.result_generation and captured.bone == active.bone and captured.frame == active.frame and captured.view == active.view and captured.mode == active.mode
