include "state/stack_state.elisa"

module StudioPendingEditPolicy:
    public:
        def same(captured: StackState::Stack?, observed: StackState::Stack?) -> bool:
            ensure captured != null or observed != null or result
            ensure (captured == null) == (observed == null) or not result
            if captured is first:
                if observed is second:
                    return StackState::same(first, second)
                return false
            observed == null
