include "state/stack_state.elisa"

module StudioPendingEditPolicy:
    public:
        def same(captured: StackState::Stack?, observed: StackState::Stack?) -> bool:
            ensure captured != null or observed != null or result
            ensure (captured == null) == (observed == null) or not result
            if captured is first:
                if observed is second:
                    return StackState::same(first, second)
                return false
            observed == null

        # Undo and Redo cancel a pending draft before changing committed history.
        # Keep both actions available so pointer, keyboard and VoiceOver dispatch
        # expose the same cancellation behavior while evaluation is pending.
        def undo_available(pending_draft: bool, committed_undo: bool) -> bool:
            ensure result == (pending_draft or committed_undo)
            pending_draft or committed_undo

        def redo_available(pending_draft: bool, committed_redo: bool) -> bool:
            ensure result == (pending_draft or committed_redo)
            pending_draft or committed_redo
