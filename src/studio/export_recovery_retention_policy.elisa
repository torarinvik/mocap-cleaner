# In-session payload bounds for recovery records kept after export UI closes.
module StudioExportRecoveryRetentionPolicy:
    public:
        const module Capacity:
            MAX_RECORDS: i64 = 16
            # Logical retained bytes only. Compiler arena rehome and native
            # allocation high-water are separate, currently unqualified facts.
            MAX_PAYLOAD_BYTES: i64 = 100000000

        def retain_admitted(current_records: i64, current_bytes: i64,
                            incoming_bytes: i64) -> bool:
            ensure result implies current_records >= 0 and current_records < Capacity::MAX_RECORDS
            ensure result implies current_bytes >= 0 and current_bytes <= Capacity::MAX_PAYLOAD_BYTES
            ensure result implies incoming_bytes > 0 and incoming_bytes <= Capacity::MAX_PAYLOAD_BYTES - current_bytes
            current_records >= 0 and current_records < Capacity::MAX_RECORDS and current_bytes >= 0 and current_bytes <= Capacity::MAX_PAYLOAD_BYTES and incoming_bytes > 0 and incoming_bytes <= Capacity::MAX_PAYLOAD_BYTES - current_bytes
