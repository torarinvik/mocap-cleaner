# Stable semantic identities and parent/sibling relationships for the
# immediate-mode studio canvas. The app publishes roles and geometry through
# elisa-ui; these IDs keep its landmark tree stable across frames.
module StudioAccessibility:
    public:
        const NO_NODE: usize = UiCore::MAX_ACCESSIBILITY_NODES
        const WORKSPACE: usize = 240
        const TOOLBAR: usize = 241
        const VIEWPORTS: usize = 242
        const CURVES: usize = 243
        const TIMELINE: usize = 244
        const SIDEBAR: usize = 245
        const STATUS: usize = 246
        const EXPORT_REVIEW: usize = 247
        const REVIEW_ACKNOWLEDGEMENT: usize = 248
        const REVIEW_CANCEL: usize = 249
        const REVIEW_EXPORT: usize = 250
        const REVIEW_DESTINATION: usize = 255
        const REVIEW_WARNING_FIRST: usize = 200
        const REVIEW_WARNING_COUNT: i64 = 5
        const WARNING_DETAIL: usize = 205
        const WARNING_DETAIL_METRIC: usize = 206
        const WARNING_DETAIL_EVIDENCE: usize = 207
        const WARNING_DETAIL_PREVIOUS: usize = 208
        const WARNING_DETAIL_NEXT: usize = 209
        const WARNING_DETAIL_DONE: usize = 210
        const CONTACT_EDITOR_PLANT: usize = 211
        const CONTACT_EDITOR_LIFT: usize = 212
        const CONTACT_EDITOR_RESET: usize = 213
        const CONTACT_EDITOR_DELETE: usize = 214
        const EXPORT_RESULT: usize = 251
        const RESULT_OPEN: usize = 252
        const RESULT_SHOW_IN_FOLDER: usize = 253
        const RESULT_DONE: usize = 254
        const PATH_LINE_FIRST: usize = 248
        const PATH_LINE_COUNT: i64 = 5
        const PATH_PREVIOUS: usize = 253
        const PATH_NEXT: usize = 254
        const PATH_DONE: usize = 255
        const TOOLBAR_CONTROL_FIRST: usize = 220
        const TOOLBAR_ACTION_COUNT: i64 = 19
        const TOOLBAR_CONTROL_END: usize = 239

        # The top-level workspace owns each navigable region. IDs stay below
        # elisa-ui's sentinel so malformed relationships cannot escape its
        # bounded semantic-node table.
        def is_toolbar_control(id: usize) -> bool:
            id >= TOOLBAR_CONTROL_FIRST and id < TOOLBAR_CONTROL_END

        def is_workspace_node(id: usize) -> bool:
            id == WORKSPACE or id == TOOLBAR or id == VIEWPORTS or id == CURVES or id == TIMELINE or id == SIDEBAR or id == STATUS or is_toolbar_control(id) or is_contact_editor_node(id)

        def is_contact_editor_node(id: usize) -> bool:
            id == CONTACT_EDITOR_PLANT or id == CONTACT_EDITOR_LIFT or id == CONTACT_EDITOR_RESET or id == CONTACT_EDITOR_DELETE

        def is_export_review_node(id: usize) -> bool:
            id == EXPORT_REVIEW or id == REVIEW_ACKNOWLEDGEMENT or id == REVIEW_CANCEL or id == REVIEW_EXPORT or id == REVIEW_DESTINATION or is_export_review_warning(id)

        def is_export_review_warning(id: usize) -> bool:
            id >= REVIEW_WARNING_FIRST and id < REVIEW_WARNING_FIRST + REVIEW_WARNING_COUNT.usize()

        def export_review_warning_id(index: i64) -> usize:
            requires index >= 0 and index < REVIEW_WARNING_COUNT
            REVIEW_WARNING_FIRST + index.usize()

        def is_export_warning_detail_node(id: usize) -> bool:
            id == WARNING_DETAIL or id == WARNING_DETAIL_METRIC or id == WARNING_DETAIL_EVIDENCE or id == WARNING_DETAIL_PREVIOUS or id == WARNING_DETAIL_NEXT or id == WARNING_DETAIL_DONE

        def is_export_path_inspector_node(id: usize) -> bool:
            id == EXPORT_REVIEW or (id >= PATH_LINE_FIRST and id <= PATH_DONE)

        def is_export_result_node(id: usize) -> bool:
            id == EXPORT_RESULT or id == RESULT_OPEN or id == RESULT_SHOW_IN_FOLDER or id == RESULT_DONE

        def export_result_parent(id: usize) -> usize:
            return NO_NODE if id == EXPORT_RESULT
            return EXPORT_RESULT if id == RESULT_OPEN or id == RESULT_SHOW_IN_FOLDER or id == RESULT_DONE
            NO_NODE

        def export_result_first_child() -> usize:
            RESULT_OPEN

        def export_result_next_sibling(id: usize) -> usize:
            return RESULT_SHOW_IN_FOLDER if id == RESULT_OPEN
            return RESULT_DONE if id == RESULT_SHOW_IN_FOLDER
            NO_NODE

        def export_review_parent(id: usize) -> usize:
            return NO_NODE if id == EXPORT_REVIEW
            return EXPORT_REVIEW if id == REVIEW_ACKNOWLEDGEMENT or id == REVIEW_CANCEL or id == REVIEW_EXPORT or id == REVIEW_DESTINATION or is_export_review_warning(id)
            NO_NODE

        def export_review_first_child(warnings: i64) -> usize:
            return REVIEW_ACKNOWLEDGEMENT if warnings > 0
            REVIEW_DESTINATION

        def export_review_next_sibling(id: usize, warnings: i64) -> usize:
            requires warnings >= 0 and warnings <= REVIEW_WARNING_COUNT
            return REVIEW_WARNING_FIRST if id == REVIEW_ACKNOWLEDGEMENT and warnings > 0
            return REVIEW_DESTINATION if id == REVIEW_ACKNOWLEDGEMENT
            warning_index: i64 = (id - REVIEW_WARNING_FIRST).i64() if is_export_review_warning(id) else -1
            return id + 1 if warning_index >= 0 and warning_index + 1 < warnings
            return REVIEW_DESTINATION if warning_index >= 0 and warning_index < warnings
            return REVIEW_CANCEL if id == REVIEW_DESTINATION
            return REVIEW_EXPORT if id == REVIEW_CANCEL
            NO_NODE

        def warning_detail_parent(id: usize) -> usize:
            return NO_NODE if id == WARNING_DETAIL
            return WARNING_DETAIL if id == WARNING_DETAIL_METRIC or id == WARNING_DETAIL_EVIDENCE or id == WARNING_DETAIL_PREVIOUS or id == WARNING_DETAIL_NEXT or id == WARNING_DETAIL_DONE
            NO_NODE

        def warning_detail_first_child() -> usize:
            WARNING_DETAIL_METRIC

        def warning_detail_next_sibling(id: usize) -> usize:
            return WARNING_DETAIL_EVIDENCE if id == WARNING_DETAIL_METRIC
            return WARNING_DETAIL_PREVIOUS if id == WARNING_DETAIL_EVIDENCE
            return WARNING_DETAIL_NEXT if id == WARNING_DETAIL_PREVIOUS
            return WARNING_DETAIL_DONE if id == WARNING_DETAIL_NEXT
            NO_NODE

        def export_path_inspector_parent(id: usize) -> usize:
            return NO_NODE if id == EXPORT_REVIEW
            return EXPORT_REVIEW if id >= PATH_LINE_FIRST and id <= PATH_DONE
            NO_NODE

        def export_path_inspector_first_child() -> usize:
            PATH_LINE_FIRST

        def export_path_inspector_next_sibling(id: usize, line_count: i64) -> usize:
            requires line_count >= 1 and line_count <= PATH_LINE_COUNT
            return id + 1 if id >= PATH_LINE_FIRST and id < PATH_LINE_FIRST + (line_count - 1).usize()
            return PATH_PREVIOUS if id == PATH_LINE_FIRST + (line_count - 1).usize()
            return PATH_NEXT if id == PATH_PREVIOUS
            return PATH_DONE if id == PATH_NEXT
            NO_NODE

        def toolbar_control_id(action: i64) -> usize:
            return NO_NODE if action < 0 or action >= TOOLBAR_ACTION_COUNT
            TOOLBAR_CONTROL_FIRST + action.usize()

        def toolbar_action_for_control(id: usize) -> i64:
            return (id - TOOLBAR_CONTROL_FIRST).i64() if is_toolbar_control(id)
            -1

        # The toolbar's hidden UiFlat action buttons are created in display
        # order after UiFlat::reset, so their bounded widget index is the
        # existing StudioPanels action code.
        def toolbar_action_for_widget(widget: usize) -> i64:
            return widget.i64() if widget < TOOLBAR_ACTION_COUNT.usize()
            -1

        def parent(id: usize) -> usize:
            if is_toolbar_control(id):
                return TOOLBAR
            if is_contact_editor_node(id):
                return TIMELINE
            if id == WORKSPACE:
                return NO_NODE
            elif id == TOOLBAR or id == VIEWPORTS or id == CURVES or id == TIMELINE or id == SIDEBAR or id == STATUS:
                return WORKSPACE
            return NO_NODE

        def first_child(id: usize) -> usize:
            if id == WORKSPACE:
                return TOOLBAR
            if id == TOOLBAR:
                return TOOLBAR_CONTROL_FIRST
            if id == TIMELINE:
                return CONTACT_EDITOR_PLANT
            return NO_NODE

        def next_sibling(id: usize) -> usize:
            if is_toolbar_control(id) and id + 1 < TOOLBAR_CONTROL_END:
                return id + 1
            if id == CONTACT_EDITOR_PLANT:
                return CONTACT_EDITOR_LIFT
            if id == CONTACT_EDITOR_LIFT:
                return CONTACT_EDITOR_RESET
            if id == CONTACT_EDITOR_RESET:
                return CONTACT_EDITOR_DELETE
            if id == CONTACT_EDITOR_DELETE:
                return NO_NODE
            if id == TOOLBAR:
                return VIEWPORTS
            elif id == VIEWPORTS:
                return CURVES
            elif id == CURVES:
                return TIMELINE
            elif id == TIMELINE:
                return SIDEBAR
            elif id == SIDEBAR:
                return STATUS
            return NO_NODE
