# Stable semantic identities and parent/sibling relationships for the
# immediate-mode studio canvas. The app publishes roles and geometry through
# elisa-ui; these IDs keep its landmark tree stable across frames.
include "../../../elisa-ui/src/core/ui_core.elisa"
include "issue_browser_policy.elisa"
include "storage_accessibility_policy.elisa"
module StudioAccessibility:
    public:
        # IDs and ranges are shared by mutually exclusive sheets.
        const module SemanticId:
            NO_NODE: usize = UiCore::MAX_ACCESSIBILITY_NODES
            WORKSPACE: usize = 240
            TOOLBAR: usize = 241
            VIEWPORTS: usize = 242
            CURVES: usize = 243
            TIMELINE: usize = 244
            SIDEBAR: usize = 245
            STATUS: usize = 246
            EXPORT_REVIEW: usize = 247
            REVIEW_ACKNOWLEDGEMENT: usize = 248
            REVIEW_CANCEL: usize = 249
            REVIEW_EXPORT: usize = 250
            REVIEW_DESTINATION: usize = 255
            REVIEW_QUEUE: usize = 268
            QUEUE_ENTRY: usize = 269
            WARNING_DETAIL: usize = 205
            WARNING_DETAIL_METRIC: usize = 206
            WARNING_DETAIL_EVIDENCE: usize = 207
            WARNING_DETAIL_PREVIOUS: usize = 208
            WARNING_DETAIL_NEXT: usize = 209
            WARNING_DETAIL_DONE: usize = 210
            CONTACT_EDITOR_PLANT: usize = 211
            CONTACT_EDITOR_LIFT: usize = 212
            CONTACT_EDITOR_RESET: usize = 213
            CONTACT_EDITOR_DELETE: usize = 214
            CONTACT_EDITOR_MERGE: usize = 215
            CONTACT_EDITOR_SPLIT: usize = 216
            EXPORT_RESULT: usize = 251
            RESULT_OPEN: usize = 252
            RESULT_SHOW_IN_FOLDER: usize = 253
            RESULT_DONE: usize = 254
            PATH_PREVIOUS: usize = 253
            PATH_NEXT: usize = 254
            PATH_DONE: usize = 255
            RESET_GROUP: usize = 150
            RESET_TRIGGER: usize = 151
            RESET_CLEAR_CONTACTS: usize = 152
            RESET_CLEAR_CORRECTIONS: usize = 153
            RESET_SOURCE_RESULT: usize = 154
            STACK_GROUP: usize = 190
            STACK_DUPLICATE: usize = 191
            SUGGESTION_GROUP: usize = 256

        const module Range:
            REVIEW_WARNING_FIRST: usize = 200
            PATH_LINE_FIRST: usize = 248
            TOOLBAR_CONTROL_FIRST: usize = 220
            TOOLBAR_CONTROL_END: usize = 239
            SUGGESTION_ACTION_FIRST: usize = 257

        const module Capacity:
            REVIEW_WARNING_COUNT: i64 = 5
            PATH_LINE_COUNT: i64 = 5
            TOOLBAR_ACTION_COUNT: i64 = 19
            SUGGESTION_ACTION_COUNT: i64 = 11

        const module ContactEndpoint:
            const FIRST: usize = 217
            const LAST: usize = 218

        const module Goto:
            const GROUP: usize = 270
            const FRAME: usize = 271
            const APPLY: usize = 272
            const CANCEL: usize = 273

        # The top-level workspace owns each navigable region. IDs stay below
        # elisa-ui's sentinel so malformed relationships cannot escape its
        # bounded semantic-node table.
        def is_toolbar_control(id: usize) -> bool:
            id >= Range::TOOLBAR_CONTROL_FIRST and id < Range::TOOLBAR_CONTROL_END

        def is_workspace_node(id: usize) -> bool:
            id == SemanticId::WORKSPACE or id == SemanticId::TOOLBAR or id == SemanticId::VIEWPORTS or id == SemanticId::CURVES or id == SemanticId::TIMELINE or id == SemanticId::SIDEBAR or id == SemanticId::STATUS or id == SemanticId::QUEUE_ENTRY or id == StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER or is_toolbar_control(id) or is_contact_editor_node(id) or is_reset_node(id) or is_stack_node(id) or StudioIssueBrowserPolicy::is_issue_node(id)

        def is_reset_node(id: usize) -> bool:
            id == SemanticId::RESET_GROUP or id == SemanticId::RESET_TRIGGER or id == SemanticId::RESET_CLEAR_CONTACTS or id == SemanticId::RESET_CLEAR_CORRECTIONS or id == SemanticId::RESET_SOURCE_RESULT

        def is_stack_node(id: usize) -> bool:
            id == SemanticId::STACK_GROUP or id == SemanticId::STACK_DUPLICATE

        def is_contact_editor_node(id: usize) -> bool:
            id == SemanticId::CONTACT_EDITOR_PLANT or id == SemanticId::CONTACT_EDITOR_LIFT or id == SemanticId::CONTACT_EDITOR_RESET or id == SemanticId::CONTACT_EDITOR_DELETE or id == SemanticId::CONTACT_EDITOR_MERGE or id == SemanticId::CONTACT_EDITOR_SPLIT or id == ContactEndpoint::FIRST or id == ContactEndpoint::LAST

        def is_export_review_node(id: usize) -> bool:
            id == SemanticId::EXPORT_REVIEW or id == SemanticId::REVIEW_ACKNOWLEDGEMENT or id == SemanticId::REVIEW_CANCEL or id == SemanticId::REVIEW_EXPORT or id == SemanticId::REVIEW_DESTINATION or id == SemanticId::REVIEW_QUEUE or is_export_review_warning(id)

        def is_export_review_warning(id: usize) -> bool:
            id >= Range::REVIEW_WARNING_FIRST and id < Range::REVIEW_WARNING_FIRST + Capacity::REVIEW_WARNING_COUNT.usize()

        def export_review_warning_id(index: i64) -> usize:
            requires index >= 0 and index < Capacity::REVIEW_WARNING_COUNT
            Range::REVIEW_WARNING_FIRST + index.usize()

        def is_export_warning_detail_node(id: usize) -> bool:
            id == SemanticId::WARNING_DETAIL or id == SemanticId::WARNING_DETAIL_METRIC or id == SemanticId::WARNING_DETAIL_EVIDENCE or id == SemanticId::WARNING_DETAIL_PREVIOUS or id == SemanticId::WARNING_DETAIL_NEXT or id == SemanticId::WARNING_DETAIL_DONE

        def is_export_path_inspector_node(id: usize) -> bool:
            id == SemanticId::EXPORT_REVIEW or (id >= Range::PATH_LINE_FIRST and id <= SemanticId::PATH_DONE)

        def is_export_result_node(id: usize) -> bool:
            id == SemanticId::EXPORT_RESULT or id == SemanticId::RESULT_OPEN or id == SemanticId::RESULT_SHOW_IN_FOLDER or id == SemanticId::RESULT_DONE

        def export_result_parent(id: usize) -> usize:
            return SemanticId::NO_NODE if id == SemanticId::EXPORT_RESULT
            return SemanticId::EXPORT_RESULT if id == SemanticId::RESULT_OPEN or id == SemanticId::RESULT_SHOW_IN_FOLDER or id == SemanticId::RESULT_DONE
            SemanticId::NO_NODE

        def export_result_first_child() -> usize:
            SemanticId::RESULT_OPEN

        def export_result_next_sibling(id: usize) -> usize:
            return SemanticId::RESULT_SHOW_IN_FOLDER if id == SemanticId::RESULT_OPEN
            return SemanticId::RESULT_DONE if id == SemanticId::RESULT_SHOW_IN_FOLDER
            SemanticId::NO_NODE

        def export_review_parent(id: usize) -> usize:
            return SemanticId::NO_NODE if id == SemanticId::EXPORT_REVIEW
            return SemanticId::EXPORT_REVIEW if id == SemanticId::REVIEW_ACKNOWLEDGEMENT or id == SemanticId::REVIEW_CANCEL or id == SemanticId::REVIEW_EXPORT or id == SemanticId::REVIEW_DESTINATION or id == SemanticId::REVIEW_QUEUE or is_export_review_warning(id)
            SemanticId::NO_NODE

        def export_review_first_child(warnings: i64) -> usize:
            return SemanticId::REVIEW_ACKNOWLEDGEMENT if warnings > 0
            SemanticId::REVIEW_DESTINATION

        def export_review_next_sibling(id: usize, warnings: i64) -> usize:
            requires warnings >= 0 and warnings <= Capacity::REVIEW_WARNING_COUNT
            return Range::REVIEW_WARNING_FIRST if id == SemanticId::REVIEW_ACKNOWLEDGEMENT and warnings > 0
            return SemanticId::REVIEW_DESTINATION if id == SemanticId::REVIEW_ACKNOWLEDGEMENT
            warning_index: i64 = (id - Range::REVIEW_WARNING_FIRST).i64() if is_export_review_warning(id) else -1
            return id + 1 if warning_index >= 0 and warning_index + 1 < warnings
            return SemanticId::REVIEW_DESTINATION if warning_index >= 0 and warning_index < warnings
            return SemanticId::REVIEW_CANCEL if id == SemanticId::REVIEW_DESTINATION
            return SemanticId::REVIEW_EXPORT if id == SemanticId::REVIEW_CANCEL
            return SemanticId::REVIEW_QUEUE if id == SemanticId::REVIEW_EXPORT
            SemanticId::NO_NODE

        def warning_detail_parent(id: usize) -> usize:
            return SemanticId::NO_NODE if id == SemanticId::WARNING_DETAIL
            return SemanticId::WARNING_DETAIL if id == SemanticId::WARNING_DETAIL_METRIC or id == SemanticId::WARNING_DETAIL_EVIDENCE or id == SemanticId::WARNING_DETAIL_PREVIOUS or id == SemanticId::WARNING_DETAIL_NEXT or id == SemanticId::WARNING_DETAIL_DONE
            SemanticId::NO_NODE

        def warning_detail_first_child() -> usize:
            SemanticId::WARNING_DETAIL_METRIC

        def warning_detail_next_sibling(id: usize) -> usize:
            return SemanticId::WARNING_DETAIL_EVIDENCE if id == SemanticId::WARNING_DETAIL_METRIC
            return SemanticId::WARNING_DETAIL_PREVIOUS if id == SemanticId::WARNING_DETAIL_EVIDENCE
            return SemanticId::WARNING_DETAIL_NEXT if id == SemanticId::WARNING_DETAIL_PREVIOUS
            return SemanticId::WARNING_DETAIL_DONE if id == SemanticId::WARNING_DETAIL_NEXT
            SemanticId::NO_NODE

        def export_path_inspector_parent(id: usize) -> usize:
            return SemanticId::NO_NODE if id == SemanticId::EXPORT_REVIEW
            return SemanticId::EXPORT_REVIEW if id >= Range::PATH_LINE_FIRST and id <= SemanticId::PATH_DONE
            SemanticId::NO_NODE

        def export_path_inspector_first_child() -> usize:
            Range::PATH_LINE_FIRST

        def export_path_inspector_next_sibling(id: usize, line_count: i64) -> usize:
            requires line_count >= 1 and line_count <= Capacity::PATH_LINE_COUNT
            return id + 1 if id >= Range::PATH_LINE_FIRST and id < Range::PATH_LINE_FIRST + (line_count - 1).usize()
            return SemanticId::PATH_PREVIOUS if id == Range::PATH_LINE_FIRST + (line_count - 1).usize()
            return SemanticId::PATH_NEXT if id == SemanticId::PATH_PREVIOUS
            return SemanticId::PATH_DONE if id == SemanticId::PATH_NEXT
            SemanticId::NO_NODE

        def toolbar_control_id(action: i64) -> usize:
            return SemanticId::NO_NODE if action < 0 or action >= Capacity::TOOLBAR_ACTION_COUNT
            Range::TOOLBAR_CONTROL_FIRST + action.usize()

        def toolbar_action_for_control(id: usize) -> i64:
            return (id - Range::TOOLBAR_CONTROL_FIRST).i64() if is_toolbar_control(id)
            -1

        # The toolbar's hidden UiFlat action buttons are created in display
        # order after UiFlat::reset, so their bounded widget index is the
        # existing StudioPanels action code.
        def toolbar_action_for_widget(widget: usize) -> i64:
            return widget.i64() if widget < Capacity::TOOLBAR_ACTION_COUNT.usize()
            -1

        def parent(id: usize) -> usize:
            if StudioIssueBrowserPolicy::is_issue_node(id):
                return StudioIssueBrowserPolicy::node_parent(id, SemanticId::SIDEBAR, SemanticId::NO_NODE)
            if is_toolbar_control(id):
                return SemanticId::TOOLBAR
            if is_contact_editor_node(id):
                return SemanticId::TIMELINE
            if id == SemanticId::RESET_GROUP:
                return SemanticId::SIDEBAR
            if id == SemanticId::RESET_TRIGGER or id == SemanticId::RESET_CLEAR_CONTACTS or id == SemanticId::RESET_CLEAR_CORRECTIONS or id == SemanticId::RESET_SOURCE_RESULT:
                return SemanticId::RESET_GROUP
            if id == SemanticId::STACK_GROUP:
                return SemanticId::SIDEBAR
            if id == SemanticId::STACK_DUPLICATE:
                return SemanticId::STACK_GROUP
            if id == SemanticId::WORKSPACE:
                return SemanticId::NO_NODE
            elif id == SemanticId::TOOLBAR or id == SemanticId::VIEWPORTS or id == SemanticId::CURVES or id == SemanticId::TIMELINE or id == SemanticId::SIDEBAR or id == SemanticId::STATUS or id == SemanticId::QUEUE_ENTRY or id == StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER:
                return SemanticId::WORKSPACE
            return SemanticId::NO_NODE

        def first_child(id: usize) -> usize:
            if id == SemanticId::WORKSPACE:
                return SemanticId::TOOLBAR
            if id == SemanticId::TOOLBAR:
                return Range::TOOLBAR_CONTROL_FIRST
            if id == SemanticId::TIMELINE:
                return SemanticId::CONTACT_EDITOR_PLANT
            if id == SemanticId::SIDEBAR:
                return StudioIssueBrowserPolicy::Accessibility::GROUP_ID
            if id == SemanticId::RESET_GROUP:
                return SemanticId::RESET_TRIGGER
            if id == SemanticId::STACK_GROUP:
                return SemanticId::STACK_DUPLICATE
            return SemanticId::NO_NODE

        def reset_next_sibling(id: usize, open: bool) -> usize:
            return SemanticId::RESET_CLEAR_CONTACTS if id == SemanticId::RESET_TRIGGER and open
            return SemanticId::RESET_CLEAR_CORRECTIONS if id == SemanticId::RESET_CLEAR_CONTACTS and open
            return SemanticId::RESET_SOURCE_RESULT if id == SemanticId::RESET_CLEAR_CORRECTIONS and open
            return SemanticId::NO_NODE if id == SemanticId::RESET_TRIGGER or id == SemanticId::RESET_CLEAR_CONTACTS or id == SemanticId::RESET_CLEAR_CORRECTIONS or id == SemanticId::RESET_SOURCE_RESULT
            SemanticId::NO_NODE

        def toolbar_next_sibling(id: usize) -> usize:
            return id + 1 if is_toolbar_control(id) and id + 1 < Range::TOOLBAR_CONTROL_END
            SemanticId::NO_NODE

        def contact_editor_next_sibling(id: usize) -> usize:
            return SemanticId::CONTACT_EDITOR_LIFT if id == SemanticId::CONTACT_EDITOR_PLANT
            return SemanticId::CONTACT_EDITOR_RESET if id == SemanticId::CONTACT_EDITOR_LIFT
            return SemanticId::CONTACT_EDITOR_DELETE if id == SemanticId::CONTACT_EDITOR_RESET
            return SemanticId::CONTACT_EDITOR_MERGE if id == SemanticId::CONTACT_EDITOR_DELETE
            return SemanticId::CONTACT_EDITOR_SPLIT if id == SemanticId::CONTACT_EDITOR_MERGE
            return ContactEndpoint::FIRST if id == SemanticId::CONTACT_EDITOR_SPLIT
            return ContactEndpoint::LAST if id == ContactEndpoint::FIRST
            SemanticId::NO_NODE

        def reset_tree_next_sibling(id: usize) -> usize:
            return reset_next_sibling(id, true) if id == SemanticId::RESET_TRIGGER or id == SemanticId::RESET_CLEAR_CONTACTS or id == SemanticId::RESET_CLEAR_CORRECTIONS or id == SemanticId::RESET_SOURCE_RESULT
            return SemanticId::STACK_GROUP if id == SemanticId::RESET_GROUP
            return SemanticId::NO_NODE

        def sidebar_next_sibling(id: usize) -> usize:
            return reset_tree_next_sibling(id) if id == SemanticId::RESET_GROUP or id == SemanticId::RESET_TRIGGER or id == SemanticId::RESET_CLEAR_CONTACTS or id == SemanticId::RESET_CLEAR_CORRECTIONS or id == SemanticId::RESET_SOURCE_RESULT
            return SemanticId::NO_NODE if id == SemanticId::STACK_GROUP or id == SemanticId::STACK_DUPLICATE
            return SemanticId::RESET_GROUP if id == StudioIssueBrowserPolicy::Accessibility::GROUP_ID
            SemanticId::NO_NODE

        def workspace_next_sibling(id: usize) -> usize:
            workspace_next_sibling_with_queue(id, false)

        def workspace_next_sibling_with_queue(id: usize, queue_entry_available: bool) -> usize:
            return SemanticId::VIEWPORTS if id == SemanticId::TOOLBAR
            return SemanticId::CURVES if id == SemanticId::VIEWPORTS
            return SemanticId::TIMELINE if id == SemanticId::CURVES
            return SemanticId::SIDEBAR if id == SemanticId::TIMELINE
            return SemanticId::STATUS if id == SemanticId::SIDEBAR
            return SemanticId::QUEUE_ENTRY if id == SemanticId::STATUS and queue_entry_available
            return StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER if id == SemanticId::STATUS
            return StudioStorageAccessibilityPolicy::Node::FILE_TRIGGER if id == SemanticId::QUEUE_ENTRY
            SemanticId::NO_NODE

        def next_sibling(id: usize) -> usize:
            if is_toolbar_control(id):
                return toolbar_next_sibling(id)
            if is_contact_editor_node(id):
                return contact_editor_next_sibling(id)
            if id == SemanticId::RESET_GROUP or id == SemanticId::RESET_TRIGGER or id == SemanticId::RESET_CLEAR_CONTACTS or id == SemanticId::RESET_CLEAR_CORRECTIONS or id == SemanticId::RESET_SOURCE_RESULT or id == SemanticId::STACK_GROUP or id == SemanticId::STACK_DUPLICATE or id == StudioIssueBrowserPolicy::Accessibility::GROUP_ID:
                return sidebar_next_sibling(id)
            workspace_next_sibling(id)
