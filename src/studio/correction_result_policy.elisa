module StudioCorrectionResultPolicy:
    public:
        const enum Outcome of i64:
            Ready = 0
            Deferred = 1
            Refused = 2

        def completed(previous: i64, current: i64, failed: bool) -> bool:
            ensure result == (not failed and current != previous)
            not failed and current != previous

        def completion_feedback_admitted(pending: bool, failed: bool) -> bool:
            ensure result == (not pending and not failed)
            not pending and not failed

        def outcome(pending: bool, failed: bool) -> Outcome:
            ensure not pending or result == Outcome.Deferred
            ensure pending or not failed or result == Outcome.Refused
            ensure pending or failed or result == Outcome.Ready
            if pending:
                return Outcome.Deferred
            if failed:
                return Outcome.Refused
            Outcome.Ready
