# Stateless selection and retention policy for the bounded Storage inventory.
# Row eligibility is supplied from the freshly checked cleanup facts; required
# recovery snapshots receive an additional explicit selection veto.
include "storage_totals_kernel.elisa"

module StudioStorageSelectionPolicy:
    public:
        const module Capacity:
            MAX_ROWS: i64 = StudioStorageTotalsKernel::Capacity::MAX_ITEMS
            MAX_BYTES: i64 = StudioStorageTotalsKernel::Capacity::MAX_TOTAL_BYTES

        const enum RetentionPreset of i64:
            SevenDays = 0
            Default = 1
            NinetyDays = 2
            Year = 3

        const module Retention:
            PRESET_COUNT: i64 = 4
            DEFAULT_DAYS: i64 = 30
            MIN_DAYS: i64 = 7

        def retention_preset_valid(preset: i64) -> bool:
            ensure result == (preset >= RetentionPreset.SevenDays.i64() and preset < Retention::PRESET_COUNT)
            preset >= RetentionPreset.SevenDays.i64() and preset < Retention::PRESET_COUNT

        # A default of 30 days, with shorter and longer reviewable choices.
        # This changes eligibility only; it never moves files.
        def retention_days(preset: i64) -> i64:
            requires preset >= RetentionPreset.SevenDays.i64() and preset < Retention::PRESET_COUNT
            return 7 if preset == RetentionPreset.SevenDays.i64()
            return Retention::DEFAULT_DAYS if preset == RetentionPreset.Default.i64()
            return 90 if preset == RetentionPreset.NinetyDays.i64()
            365

        def row_may_be_selected(eligible: bool, recovery_required: bool) -> bool:
            ensure result == (eligible and not recovery_required)
            eligible and not recovery_required

        # Toggle is allowed only for a bounded row. Existing selection can
        # always be cleared, including when a refresh has made it protected.
        def may_toggle(row_count: i64, row_index: i64, eligible: bool,
                       recovery_required: bool, already_selected: bool,
                       selected_count: i64) -> bool:
            return false if row_count < 0 or row_count > Capacity::MAX_ROWS
            return false if row_index < 0 or row_index >= row_count
            return false if selected_count < 0 or selected_count > row_count
            return true if already_selected
            row_may_be_selected(eligible, recovery_required) and selected_count < row_count

        # A selected row that no longer passes a fresh safety scan or is now
        # required for recovery must be removed from the active selection.
        def must_clear_stale_selection(selected: bool, eligible: bool,
                                      recovery_required: bool) -> bool:
            ensure result == (selected and (not eligible or recovery_required))
            selected and (not eligible or recovery_required)

        # Counts and bytes advance via the shared overflow-safe totals kernel.
        # `row_count` is the complete bounded inventory size. A filtered view
        # must not shrink the bound for selections retained outside that view.
        def can_add_selected(row_count: i64, selected_count: i64,
                             selected_bytes: i64, size_bytes: i64) -> bool:
            return false if row_count < 0 or row_count > Capacity::MAX_ROWS
            return false if selected_count < 0 or selected_count >= row_count
            StudioStorageTotalsKernel::add_allowed(selected_count, selected_bytes, size_bytes)

        def next_selected_count(selected_count: i64, row_count: i64) -> i64:
            requires row_count >= 1 and row_count <= Capacity::MAX_ROWS
            requires selected_count >= 0 and selected_count < row_count
            requires selected_count < StudioStorageTotalsKernel::Capacity::MAX_ITEMS
            StudioStorageTotalsKernel::next_count(selected_count)

        def next_selected_bytes(selected_bytes: i64, size_bytes: i64) -> i64:
            requires selected_bytes >= 0 and selected_bytes <= Capacity::MAX_BYTES
            requires size_bytes >= 0 and size_bytes <= StudioStorageTotalsKernel::Capacity::MAX_ITEM_BYTES
            requires selected_bytes <= Capacity::MAX_BYTES - size_bytes
            requires selected_bytes <= StudioStorageTotalsKernel::Capacity::MAX_TOTAL_BYTES - size_bytes
            ensure result == selected_bytes + size_bytes
            StudioStorageTotalsKernel::next_total(selected_bytes, size_bytes)
