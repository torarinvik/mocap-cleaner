include "publication_durability_policy.elisa"

# Pure receipt vocabulary and native-result decoding; no filesystem adapters.
module StudioExportBatchPublication:
    public:
        const enum ArtifactStage of i64:
            Pending = 0
            NotPublished = 1
            PublishedDurabilityUnknown = 2
            PublishedDirectorySynced = 3
            ExistingExact = 4
            ConflictingOrUnavailable = 5

        const enum StagingDisposition of i64:
            NotInspected = 0
            StillPresent = 1
            Removed = 2
            Unknown = 3

        struct Receipt:
            glb: ArtifactStage
            glb_bytes_verified: bool
            json: ArtifactStage
            json_bytes_verified: bool
            text: ArtifactStage
            text_bytes_verified: bool
            staging: StagingDisposition

        def outputs_verified(receipt: Receipt) -> bool:
            ensure result == (receipt.glb_bytes_verified and receipt.json_bytes_verified and receipt.text_bytes_verified)
            receipt.glb_bytes_verified and receipt.json_bytes_verified and receipt.text_bytes_verified

        def stage_for_native_status(status: i32) -> ArtifactStage:
            ensure result == (ArtifactStage.PublishedDirectorySynced if status == 1 else ArtifactStage.PublishedDurabilityUnknown if status == 2 else ArtifactStage.ExistingExact if status == 3 else ArtifactStage.ConflictingOrUnavailable)
            return ArtifactStage.PublishedDirectorySynced if status == 1
            return ArtifactStage.PublishedDurabilityUnknown if status == 2
            return ArtifactStage.ExistingExact if status == 3
            ArtifactStage.ConflictingOrUnavailable

        def native_bytes_verified(status: i32) -> bool:
            ensure result == (status == 1 or status == 2 or status == 3)
            status == 1 or status == 2 or status == 3

        def stage_for_result(result: StudioPublicationDurabilityPolicy::Result) -> ArtifactStage:
            return ArtifactStage.NotPublished if result == StudioPublicationDurabilityPolicy::Result.NotPublished
            return ArtifactStage.PublishedDurabilityUnknown if result == StudioPublicationDurabilityPolicy::Result.PublishedDurabilityUnknown
            ArtifactStage.PublishedDirectorySynced

