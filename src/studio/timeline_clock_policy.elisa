# One integer clock for a validated uniform evaluated frame grid.
# Input key spacing must be validated separately; an average rate is insufficient.
include "timeline_rational_clock_policy.elisa"
module StudioTimelineClockPolicy:
    public:
        const module Domain:
            MAX_FRAMES: i64 = 10000000
            MAX_RATE: i64 = 1000
            MICROS_PER_SECOND: i64 = 1000000
            MAX_TIME_US: i64 = 10000000000000
            MAX_STEP_US: i64 = 250000

        def rate_valid(rate: i64) -> bool:
            ensure result == (rate >= 1 and rate <= Domain::MAX_RATE)
            rate >= 1 and rate <= Domain::MAX_RATE

        # Round starts upward so the floor conversion selects the same frame.
        def frame_start_us(frame: i64, rate: i64) -> i64:
            requires frame >= 0 and frame < Domain::MAX_FRAMES
            requires rate >= 1 and rate <= Domain::MAX_RATE
            ensure result >= 0 and result < Domain::MAX_TIME_US
            ensure frame != 0 or result == 0
            StudioTimelineRationalClockPolicy::boundary_us(frame, rate, 1)

        # Exclusive end of the final frame's interval, rounded upward.
        def duration_us(count: i64, rate: i64) -> i64:
            requires count >= 1 and count <= Domain::MAX_FRAMES
            requires rate >= 1 and rate <= Domain::MAX_RATE
            ensure result >= 1 and result <= Domain::MAX_TIME_US
            StudioTimelineRationalClockPolicy::boundary_us(count, rate, 1)

        def frame_at_us(time: i64, rate: i64, count: i64) -> i64:
            requires time >= 0 and time <= Domain::MAX_TIME_US + Domain::MAX_STEP_US
            requires rate >= 1 and rate <= Domain::MAX_RATE
            requires count >= 1 and count <= Domain::MAX_FRAMES
            ensure result >= 0 and result < count
            ensure time != 0 or result == 0
            StudioTimelineRationalClockPolicy::frame_at_us(time, rate, 1, count)

        # Keep sub-frame phase when one tick crosses several short loops.
        def loop_time(time: i64, duration: i64) -> i64:
            requires time >= 0 and time <= Domain::MAX_TIME_US + Domain::MAX_STEP_US
            requires duration >= 1 and duration <= Domain::MAX_TIME_US
            ensure result >= 0 and result < duration
            ensure time >= duration or result == time
            time % duration
