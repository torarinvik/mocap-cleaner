# Stable semantic identity, hierarchy, and action policy for Storage & Recovery.
# The app supplies geometry and file names when publishing these nodes.
module StudioStorageAccessibilityPolicy:
    public:
        const module Node:
            NO_NODE: usize = 320
            WORKSPACE: usize = 240
            DIALOG: usize = 160
            INVENTORY: usize = 161
            ROW_FIRST: usize = 162
            ROW_COUNT: i64 = 6
            PROTECTED: usize = 168
            REFRESH: usize = 169
            DONE: usize = 170
            RESTORE: usize = 171
            ANNOUNCEMENT: usize = 172
            INSPECT_PATH: usize = 173
            FILE_TRIGGER: usize = 174
            FILE_MENU: usize = 175
            FILE_COMMAND_FIRST: usize = 176
            TRASH: usize = 185
            RETENTION: usize = 186
            SELECT_ELIGIBLE: usize = 187
            CLEAR_SELECTION: usize = 188
            EXEMPTION: usize = 189
            FILTER: usize = 192
            FILE_CREATE_BUILD: usize = 193
            FILE_CANCEL_SETUP: usize = 194
            PENDING_WORKSPACE_PATH: usize = 195

        const module FileCommand:
            FILE_COMMAND_COUNT: i64 = 10
            FILE_OPEN_TAKE: i64 = 1
            FILE_OPEN_SESSION: i64 = 2
            FILE_SAVE: i64 = 3
            FILE_SAVE_AS: i64 = 4
            FILE_EXPORT_CURRENT: i64 = 5
            FILE_EXPORT_AS: i64 = 6
            FILE_OPEN_STORAGE: i64 = 7
            FILE_WORKSPACE: i64 = 8
            FILE_CREATE_BUILD: i64 = 9
            FILE_CANCEL_SETUP: i64 = 10

        # These action numbers match StudioPanels storage actions.
        const module Action:
            ACTION_REFRESH: i64 = 0
            ACTION_DONE: i64 = 1
            ACTION_RESTORE: i64 = 2
            ACTION_TRASH: i64 = 3
            ACTION_RETENTION: i64 = 4
            ACTION_SELECT_ELIGIBLE: i64 = 5
            ACTION_CLEAR_SELECTION: i64 = 6
            ACTION_EXEMPTION: i64 = 7
            ACTION_INSPECT_PATH: i64 = 8
            ACTION_FILTER: i64 = 9
            ACTION_COUNT: i64 = 10

        # These message codes match app.elisa's storage_message transitions.
        const module Message:
            MESSAGE_MANIFEST_FAILED: i64 = 1
            MESSAGE_BUILD_UNVERIFIED: i64 = 2
            MESSAGE_REFRESHED: i64 = 3
            MESSAGE_ITEMS_UNVERIFIED: i64 = 4
            MESSAGE_RECEIPT_SAVE_FAILED: i64 = 5
            MESSAGE_RESTORED: i64 = 6
            MESSAGE_RESTORE_FAILED: i64 = 7
            MESSAGE_RESTORED_SAVE_FAILED: i64 = 8
            MESSAGE_RECEIPT_CHANGED: i64 = 9
            MESSAGE_TRASH_RECORDED: i64 = 10
            MESSAGE_TRASH_FAILED_ORIGINAL_CONFIRMED: i64 = 11
            MESSAGE_TRASH_ROLLED_BACK: i64 = 12
            MESSAGE_TRASH_ROLLBACK_FAILED: i64 = 13
            MESSAGE_TRASH_LOCATION_UNKNOWN: i64 = 15
            MESSAGE_PREFERENCES_READ_FAILED: i64 = 16
            MESSAGE_PREFERENCES_SAVE_FAILED: i64 = 17
            MESSAGE_EXEMPTIONS_READ_FAILED: i64 = 18
            MESSAGE_EXEMPTION_SAVE_FAILED: i64 = 19
            MESSAGE_EXEMPTION_SAVED: i64 = 20
            MESSAGE_LOCK_UNAVAILABLE: i64 = 21
            MESSAGE_LOCK_RELEASE_UNCERTAIN: i64 = 22

        # Rows are bounded to the six visible rows in panels.elisa.
        def row_id(index: usize) -> usize:
            requires index < Node::ROW_COUNT.usize()
            Node::ROW_FIRST + index

        def row_index(id: usize) -> i64:
            return (id - Node::ROW_FIRST).i64() if id >= Node::ROW_FIRST and id < Node::ROW_FIRST + Node::ROW_COUNT.usize()
            -1

        def is_row(id: usize) -> bool:
            id >= Node::ROW_FIRST and id < Node::ROW_FIRST + Node::ROW_COUNT.usize()

        def is_node(id: usize) -> bool:
            ensure id != Node::INSPECT_PATH or result
            ensure id != Node::EXEMPTION or result
            ensure id != Node::FILTER or result
            id == Node::DIALOG or id == Node::INVENTORY or is_row(id) or id == Node::PROTECTED or id == Node::REFRESH or id == Node::DONE or id == Node::RESTORE or id == Node::TRASH or id == Node::RETENTION or id == Node::SELECT_ELIGIBLE or id == Node::CLEAR_SELECTION or id == Node::EXEMPTION or id == Node::INSPECT_PATH or id == Node::ANNOUNCEMENT or id == Node::FILTER or is_file_node(id)

        def is_file_command(id: usize) -> bool:
            file_command_index(id) >= 0

        def is_file_node(id: usize) -> bool:
            id == Node::FILE_TRIGGER or id == Node::FILE_MENU or id == Node::PENDING_WORKSPACE_PATH or is_file_command(id)

        def file_command_id(index: usize) -> usize:
            requires index < FileCommand::FILE_COMMAND_COUNT.usize()
            return Node::FILE_CREATE_BUILD if index == 8
            return Node::FILE_CANCEL_SETUP if index == 9
            Node::FILE_COMMAND_FIRST + index

        def file_command_index(id: usize) -> i64:
            ensure result >= -1
            ensure result < FileCommand::FILE_COMMAND_COUNT
            return 0 if id == Node::FILE_COMMAND_FIRST
            return 1 if id == Node::FILE_COMMAND_FIRST + 1
            return 2 if id == Node::FILE_COMMAND_FIRST + 2
            return 3 if id == Node::FILE_COMMAND_FIRST + 3
            return 4 if id == Node::FILE_COMMAND_FIRST + 4
            return 5 if id == Node::FILE_COMMAND_FIRST + 5
            return 6 if id == Node::FILE_COMMAND_FIRST + 6
            return 7 if id == Node::FILE_COMMAND_FIRST + 7
            return 8 if id == Node::FILE_CREATE_BUILD
            return 9 if id == Node::FILE_CANCEL_SETUP
            -1

        def file_first_child(id: usize, create_pending: bool) -> usize:
            return Node::FILE_MENU if id == Node::FILE_TRIGGER
            return Node::PENDING_WORKSPACE_PATH if id == Node::FILE_MENU and create_pending
            return Node::FILE_COMMAND_FIRST if id == Node::FILE_MENU
            Node::NO_NODE

        def file_next_sibling(id: usize, create_pending: bool) -> usize:
            return Node::FILE_COMMAND_FIRST if id == Node::PENDING_WORKSPACE_PATH and create_pending
            index: i64 = file_command_index(id)
            visible: i64 = 8 if not create_pending else FileCommand::FILE_COMMAND_COUNT
            return file_command_id((index + 1).usize()) if index >= 0 and index + 1 < visible
            Node::NO_NODE

        # IDs follow the File menu's displayed row order. StudioFilePolicy is
        # tested as the authority for matching these scalar command codes.
        def file_command(id: usize) -> i64:
            ensure result >= -1
            ensure result <= FileCommand::FILE_CANCEL_SETUP
            row: i64 = file_command_index(id)
            return -1 if row < 0
            row + 1

        def file_command_enabled(id: usize, has_take: bool) -> bool:
            command: i64 = file_command(id)
            return true if command == FileCommand::FILE_OPEN_TAKE or command == FileCommand::FILE_OPEN_STORAGE or command == FileCommand::FILE_WORKSPACE or command == FileCommand::FILE_CREATE_BUILD or command == FileCommand::FILE_CANCEL_SETUP
            return false if command < FileCommand::FILE_OPEN_SESSION or command > FileCommand::FILE_EXPORT_AS
            has_take

        # Modal root belongs to the existing Studio workspace. Inventory rows
        # are children of a list; the reason, actions, and live result are
        # ordered siblings beneath the dialog.
        def parent(id: usize) -> usize:
            ensure id != Node::INSPECT_PATH or result == Node::DIALOG
            ensure id != Node::EXEMPTION or result == Node::DIALOG
            ensure id != Node::FILTER or result == Node::DIALOG
            return Node::NO_NODE if id == Node::DIALOG
            return Node::DIALOG if id == Node::INVENTORY or id == Node::PROTECTED or id == Node::REFRESH or id == Node::DONE or id == Node::RESTORE or id == Node::TRASH or id == Node::RETENTION or id == Node::SELECT_ELIGIBLE or id == Node::CLEAR_SELECTION or id == Node::EXEMPTION or id == Node::INSPECT_PATH or id == Node::ANNOUNCEMENT or id == Node::FILTER
            return Node::INVENTORY if is_row(id)
            return Node::WORKSPACE if id == Node::FILE_TRIGGER
            return Node::FILE_TRIGGER if id == Node::FILE_MENU
            return Node::FILE_MENU if id == Node::PENDING_WORKSPACE_PATH
            return Node::FILE_MENU if is_file_command(id)
            Node::NO_NODE

        def first_child(id: usize, visible_count: i64) -> usize:
            requires visible_count >= 0
            requires visible_count <= Node::ROW_COUNT
            return Node::INVENTORY if id == Node::DIALOG
            return Node::ROW_FIRST if id == Node::INVENTORY and visible_count > 0
            Node::NO_NODE

        def next_sibling_general(id: usize, visible_count: i64) -> usize:
            requires visible_count >= 0
            requires visible_count <= Node::ROW_COUNT
            row: i64 = row_index(id)
            return id + 1 if row >= 0 and row + 1 < visible_count
            return Node::NO_NODE if row >= 0
            return Node::PROTECTED if id == Node::INVENTORY
            return Node::REFRESH if id == Node::PROTECTED
            return Node::DONE if id == Node::REFRESH
            return Node::RESTORE if id == Node::DONE
            return Node::TRASH if id == Node::RESTORE
            return Node::RETENTION if id == Node::TRASH
            return Node::SELECT_ELIGIBLE if id == Node::RETENTION
            return Node::CLEAR_SELECTION if id == Node::SELECT_ELIGIBLE
            Node::NO_NODE

        def next_sibling(id: usize, visible_count: i64) -> usize:
            requires visible_count >= 0
            requires visible_count <= Node::ROW_COUNT
            ensure id != Node::ANNOUNCEMENT or result == Node::INSPECT_PATH
            ensure id != Node::INSPECT_PATH or result == Node::FILTER
            ensure id != Node::CLEAR_SELECTION or result == Node::EXEMPTION
            ensure id != Node::EXEMPTION or result == Node::ANNOUNCEMENT
            ensure id != Node::FILTER or result == Node::NO_NODE
            return Node::INSPECT_PATH if id == Node::ANNOUNCEMENT
            return Node::FILTER if id == Node::INSPECT_PATH
            return Node::NO_NODE if id == Node::FILTER
            return Node::EXEMPTION if id == Node::CLEAR_SELECTION
            return Node::ANNOUNCEMENT if id == Node::EXEMPTION
            next_sibling_general(id, visible_count)

        def action_for_node(id: usize) -> i64:
            ensure id != Node::INSPECT_PATH or result == Action::ACTION_INSPECT_PATH
            ensure id != Node::EXEMPTION or result == Action::ACTION_EXEMPTION
            ensure id != Node::FILTER or result == Action::ACTION_FILTER
            return Action::ACTION_INSPECT_PATH if id == Node::INSPECT_PATH
            return Action::ACTION_FILTER if id == Node::FILTER
            return Action::ACTION_EXEMPTION if id == Node::EXEMPTION
            return Action::ACTION_REFRESH if id == Node::REFRESH
            return Action::ACTION_DONE if id == Node::DONE
            return Action::ACTION_RESTORE if id == Node::RESTORE
            return Action::ACTION_TRASH if id == Node::TRASH
            return Action::ACTION_RETENTION if id == Node::RETENTION
            return Action::ACTION_SELECT_ELIGIBLE if id == Node::SELECT_ELIGIBLE
            return Action::ACTION_CLEAR_SELECTION if id == Node::CLEAR_SELECTION
            -1

        # Stable node IDs are explicit; callers must not derive them by adding
        # action indices to Node::REFRESH because the hierarchy has reserved gaps.
        def action_id(action: i64) -> usize:
            ensure action != Action::ACTION_INSPECT_PATH or result == Node::INSPECT_PATH
            ensure action != Action::ACTION_EXEMPTION or result == Node::EXEMPTION
            ensure action != Action::ACTION_FILTER or result == Node::FILTER
            return Node::INSPECT_PATH if action == Action::ACTION_INSPECT_PATH
            return Node::FILTER if action == Action::ACTION_FILTER
            return Node::EXEMPTION if action == Action::ACTION_EXEMPTION
            return Node::REFRESH if action == Action::ACTION_REFRESH
            return Node::DONE if action == Action::ACTION_DONE
            return Node::RESTORE if action == Action::ACTION_RESTORE
            return Node::TRASH if action == Action::ACTION_TRASH
            return Node::RETENTION if action == Action::ACTION_RETENTION
            return Node::SELECT_ELIGIBLE if action == Action::ACTION_SELECT_ELIGIBLE
            return Node::CLEAR_SELECTION if action == Action::ACTION_CLEAR_SELECTION
            Node::NO_NODE

        def filter_admitted(running: bool, reviewing: bool) -> bool:
            ensure result == (not running and not reviewing)
            not running and not reviewing

        # Refresh and Done are always available while this modal is open.
        # Restore uses the app's existing fully verified receipt predicate.
        def action_enabled(action: i64, restore_available: bool) -> bool:
            return true if action == Action::ACTION_REFRESH or action == Action::ACTION_DONE
            return restore_available if action == Action::ACTION_RESTORE
            false

        def action_enabled_with_cleanup(action: i64, restore_available: bool,
                                        trash_available: bool) -> bool:
            ensure action != Action::ACTION_SELECT_ELIGIBLE or result
            ensure action != Action::ACTION_CLEAR_SELECTION or result
            return true if action == Action::ACTION_REFRESH or action == Action::ACTION_DONE or action == Action::ACTION_RETENTION or action == Action::ACTION_SELECT_ELIGIBLE or action == Action::ACTION_CLEAR_SELECTION
            return restore_available if action == Action::ACTION_RESTORE
            return trash_available if action == Action::ACTION_TRASH
            false

        def action_enabled_with_exemption(action: i64, restore_available: bool,
                                          trash_available: bool,
                                          exemption_available: bool) -> bool:
            ensure action == Action::ACTION_EXEMPTION or result == action_enabled_with_cleanup(action, restore_available, trash_available)
            ensure action != Action::ACTION_EXEMPTION or result == exemption_available
            return exemption_available if action == Action::ACTION_EXEMPTION
            action_enabled_with_cleanup(action, restore_available, trash_available)

        def row_selected(index: i64, selected: i64) -> bool:
            index >= 0 and index == selected

        # Changed identities and failed checks must be announced as protected
        # records; only verified Trash receipts can enable Restore.
        def status_protected(status: i64) -> bool:
            status == 2 or status == 3

        def result_is_alert(message: i64) -> bool:
            ensure result == (message == Message::MESSAGE_EXEMPTIONS_READ_FAILED or message == Message::MESSAGE_EXEMPTION_SAVE_FAILED or message == Message::MESSAGE_PREFERENCES_READ_FAILED or message == Message::MESSAGE_PREFERENCES_SAVE_FAILED or message == Message::MESSAGE_MANIFEST_FAILED or message == Message::MESSAGE_BUILD_UNVERIFIED or message == Message::MESSAGE_RECEIPT_SAVE_FAILED or message == Message::MESSAGE_RESTORE_FAILED or message == Message::MESSAGE_RESTORED_SAVE_FAILED or message == Message::MESSAGE_RECEIPT_CHANGED or message == Message::MESSAGE_TRASH_FAILED_ORIGINAL_CONFIRMED or message == Message::MESSAGE_TRASH_ROLLED_BACK or message == Message::MESSAGE_TRASH_ROLLBACK_FAILED or message == Message::MESSAGE_TRASH_LOCATION_UNKNOWN or message == Message::MESSAGE_LOCK_UNAVAILABLE or message == Message::MESSAGE_LOCK_RELEASE_UNCERTAIN)
            message == Message::MESSAGE_EXEMPTIONS_READ_FAILED or message == Message::MESSAGE_EXEMPTION_SAVE_FAILED or message == Message::MESSAGE_PREFERENCES_READ_FAILED or message == Message::MESSAGE_PREFERENCES_SAVE_FAILED or message == Message::MESSAGE_MANIFEST_FAILED or message == Message::MESSAGE_BUILD_UNVERIFIED or message == Message::MESSAGE_RECEIPT_SAVE_FAILED or message == Message::MESSAGE_RESTORE_FAILED or message == Message::MESSAGE_RESTORED_SAVE_FAILED or message == Message::MESSAGE_RECEIPT_CHANGED or message == Message::MESSAGE_TRASH_FAILED_ORIGINAL_CONFIRMED or message == Message::MESSAGE_TRASH_ROLLED_BACK or message == Message::MESSAGE_TRASH_ROLLBACK_FAILED or message == Message::MESSAGE_TRASH_LOCATION_UNKNOWN or message == Message::MESSAGE_LOCK_UNAVAILABLE or message == Message::MESSAGE_LOCK_RELEASE_UNCERTAIN
