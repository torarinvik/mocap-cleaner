# Stable semantic identity, hierarchy, and action policy for Storage & Recovery.
# The app supplies geometry and file names when publishing these nodes.
module StudioStorageAccessibilityPolicy:
    public:
        const NO_NODE: usize = 256
        const WORKSPACE: usize = 240
        const DIALOG: usize = 160
        const INVENTORY: usize = 161
        const ROW_FIRST: usize = 162
        const ROW_COUNT: i64 = 6
        const PROTECTED: usize = 168
        const REFRESH: usize = 169
        const DONE: usize = 170
        const RESTORE: usize = 171
        const ANNOUNCEMENT: usize = 172
        const TRASH: usize = 185
        const RETENTION: usize = 186
        const SELECT_ELIGIBLE: usize = 187
        const CLEAR_SELECTION: usize = 188
        const EXEMPTION: usize = 189
        const FILE_TRIGGER: usize = 174
        const FILE_MENU: usize = 175
        const FILE_COMMAND_FIRST: usize = 176
        const FILE_COMMAND_COUNT: i64 = 7
        const FILE_OPEN_TAKE: i64 = 1
        const FILE_OPEN_SESSION: i64 = 2
        const FILE_SAVE: i64 = 3
        const FILE_SAVE_AS: i64 = 4
        const FILE_EXPORT_CURRENT: i64 = 5
        const FILE_EXPORT_AS: i64 = 6
        const FILE_OPEN_STORAGE: i64 = 7

        # These action numbers match StudioPanels storage actions.
        const ACTION_REFRESH: i64 = 0
        const ACTION_DONE: i64 = 1
        const ACTION_RESTORE: i64 = 2
        const ACTION_TRASH: i64 = 3
        const ACTION_RETENTION: i64 = 4
        const ACTION_SELECT_ELIGIBLE: i64 = 5
        const ACTION_CLEAR_SELECTION: i64 = 6
        const ACTION_EXEMPTION: i64 = 7
        const ACTION_COUNT: i64 = 8

        # These message codes match app.elisa's storage_message transitions.
        const MESSAGE_MANIFEST_FAILED: i64 = 1
        const MESSAGE_BUILD_UNVERIFIED: i64 = 2
        const MESSAGE_REFRESHED: i64 = 3
        const MESSAGE_ITEMS_UNVERIFIED: i64 = 4
        const MESSAGE_RECEIPT_SAVE_FAILED: i64 = 5
        const MESSAGE_RESTORED: i64 = 6
        const MESSAGE_RESTORE_FAILED: i64 = 7
        const MESSAGE_RESTORED_SAVE_FAILED: i64 = 8
        const MESSAGE_RECEIPT_CHANGED: i64 = 9
        const MESSAGE_TRASH_RECORDED: i64 = 10
        const MESSAGE_TRASH_FAILED_ORIGINAL_CONFIRMED: i64 = 11
        const MESSAGE_TRASH_ROLLED_BACK: i64 = 12
        const MESSAGE_TRASH_ROLLBACK_FAILED: i64 = 13
        const MESSAGE_TRASH_LOCATION_UNKNOWN: i64 = 15
        const MESSAGE_PREFERENCES_READ_FAILED: i64 = 16
        const MESSAGE_PREFERENCES_SAVE_FAILED: i64 = 17
        const MESSAGE_EXEMPTIONS_READ_FAILED: i64 = 18
        const MESSAGE_EXEMPTION_SAVE_FAILED: i64 = 19
        const MESSAGE_EXEMPTION_SAVED: i64 = 20

        # Rows are bounded to the six visible rows in panels.elisa.
        def row_id(index: usize) -> usize:
            requires index < ROW_COUNT.usize()
            ROW_FIRST + index

        def row_index(id: usize) -> i64:
            return (id - ROW_FIRST).i64() if id >= ROW_FIRST and id < ROW_FIRST + ROW_COUNT.usize()
            -1

        def is_row(id: usize) -> bool:
            id >= ROW_FIRST and id < ROW_FIRST + ROW_COUNT.usize()

        def is_node(id: usize) -> bool:
            ensure id != EXEMPTION or result
            id == DIALOG or id == INVENTORY or is_row(id) or id == PROTECTED or id == REFRESH or id == DONE or id == RESTORE or id == TRASH or id == RETENTION or id == SELECT_ELIGIBLE or id == CLEAR_SELECTION or id == EXEMPTION or id == ANNOUNCEMENT or is_file_node(id)

        def is_file_command(id: usize) -> bool:
            id >= FILE_COMMAND_FIRST and id < FILE_COMMAND_FIRST + FILE_COMMAND_COUNT.usize()

        def is_file_node(id: usize) -> bool:
            id == FILE_TRIGGER or id == FILE_MENU or is_file_command(id)

        def file_command_id(index: usize) -> usize:
            requires index < FILE_COMMAND_COUNT.usize()
            FILE_COMMAND_FIRST + index

        def file_command_index(id: usize) -> i64:
            ensure result >= -1
            ensure result < FILE_COMMAND_COUNT
            return 0 if id == FILE_COMMAND_FIRST
            return 1 if id == FILE_COMMAND_FIRST + 1
            return 2 if id == FILE_COMMAND_FIRST + 2
            return 3 if id == FILE_COMMAND_FIRST + 3
            return 4 if id == FILE_COMMAND_FIRST + 4
            return 5 if id == FILE_COMMAND_FIRST + 5
            return 6 if id == FILE_COMMAND_FIRST + 6
            -1

        def file_first_child(id: usize) -> usize:
            return FILE_MENU if id == FILE_TRIGGER
            return FILE_COMMAND_FIRST if id == FILE_MENU
            NO_NODE

        def file_next_sibling(id: usize) -> usize:
            return id + 1 if is_file_command(id) and id + 1 < FILE_COMMAND_FIRST + FILE_COMMAND_COUNT.usize()
            NO_NODE

        # IDs follow the File menu's displayed row order. StudioFilePolicy is
        # tested as the authority for matching these scalar command codes.
        def file_command(id: usize) -> i64:
            ensure result >= -1
            ensure result <= FILE_OPEN_STORAGE
            row: i64 = file_command_index(id)
            return -1 if row < 0
            row + 1

        def file_command_enabled(id: usize, has_take: bool) -> bool:
            command: i64 = file_command(id)
            return true if command == FILE_OPEN_TAKE or command == FILE_OPEN_STORAGE
            return false if command < FILE_OPEN_SESSION or command > FILE_EXPORT_AS
            has_take

        # Modal root belongs to the existing Studio workspace. Inventory rows
        # are children of a list; the reason, actions, and live result are
        # ordered siblings beneath the dialog.
        def parent(id: usize) -> usize:
            ensure id != EXEMPTION or result == DIALOG
            return NO_NODE if id == DIALOG
            return DIALOG if id == INVENTORY or id == PROTECTED or id == REFRESH or id == DONE or id == RESTORE or id == TRASH or id == RETENTION or id == SELECT_ELIGIBLE or id == CLEAR_SELECTION or id == EXEMPTION or id == ANNOUNCEMENT
            return INVENTORY if is_row(id)
            return WORKSPACE if id == FILE_TRIGGER
            return FILE_TRIGGER if id == FILE_MENU
            return FILE_MENU if is_file_command(id)
            NO_NODE

        def first_child(id: usize, visible_count: i64) -> usize:
            requires visible_count >= 0
            requires visible_count <= ROW_COUNT
            return INVENTORY if id == DIALOG
            return ROW_FIRST if id == INVENTORY and visible_count > 0
            NO_NODE

        def next_sibling(id: usize, visible_count: i64) -> usize:
            requires visible_count >= 0
            requires visible_count <= ROW_COUNT
            ensure id != CLEAR_SELECTION or result == EXEMPTION
            ensure id != EXEMPTION or result == ANNOUNCEMENT
            return EXEMPTION if id == CLEAR_SELECTION
            return ANNOUNCEMENT if id == EXEMPTION
            row: i64 = row_index(id)
            return id + 1 if row >= 0 and row + 1 < visible_count
            return NO_NODE if row >= 0
            return PROTECTED if id == INVENTORY
            return REFRESH if id == PROTECTED
            return DONE if id == REFRESH
            return RESTORE if id == DONE
            return TRASH if id == RESTORE
            return RETENTION if id == TRASH
            return SELECT_ELIGIBLE if id == RETENTION
            return CLEAR_SELECTION if id == SELECT_ELIGIBLE
            NO_NODE

        def action_for_node(id: usize) -> i64:
            ensure id != EXEMPTION or result == ACTION_EXEMPTION
            return ACTION_EXEMPTION if id == EXEMPTION
            return ACTION_REFRESH if id == REFRESH
            return ACTION_DONE if id == DONE
            return ACTION_RESTORE if id == RESTORE
            return ACTION_TRASH if id == TRASH
            return ACTION_RETENTION if id == RETENTION
            return ACTION_SELECT_ELIGIBLE if id == SELECT_ELIGIBLE
            return ACTION_CLEAR_SELECTION if id == CLEAR_SELECTION
            -1

        # Stable node IDs are explicit; callers must not derive them by adding
        # action indices to REFRESH because the hierarchy has reserved gaps.
        def action_id(action: i64) -> usize:
            ensure action != ACTION_EXEMPTION or result == EXEMPTION
            return EXEMPTION if action == ACTION_EXEMPTION
            return REFRESH if action == ACTION_REFRESH
            return DONE if action == ACTION_DONE
            return RESTORE if action == ACTION_RESTORE
            return TRASH if action == ACTION_TRASH
            return RETENTION if action == ACTION_RETENTION
            return SELECT_ELIGIBLE if action == ACTION_SELECT_ELIGIBLE
            return CLEAR_SELECTION if action == ACTION_CLEAR_SELECTION
            NO_NODE

        # Refresh and Done are always available while this modal is open.
        # Restore uses the app's existing fully verified receipt predicate.
        def action_enabled(action: i64, restore_available: bool) -> bool:
            return true if action == ACTION_REFRESH or action == ACTION_DONE
            return restore_available if action == ACTION_RESTORE
            false

        def action_enabled_with_cleanup(action: i64, restore_available: bool,
                                        trash_available: bool) -> bool:
            ensure action != ACTION_SELECT_ELIGIBLE or result
            ensure action != ACTION_CLEAR_SELECTION or result
            return true if action == ACTION_REFRESH or action == ACTION_DONE or action == ACTION_RETENTION or action == ACTION_SELECT_ELIGIBLE or action == ACTION_CLEAR_SELECTION
            return restore_available if action == ACTION_RESTORE
            return trash_available if action == ACTION_TRASH
            false

        def action_enabled_with_exemption(action: i64, restore_available: bool,
                                          trash_available: bool,
                                          exemption_available: bool) -> bool:
            ensure action == ACTION_EXEMPTION or result == action_enabled_with_cleanup(action, restore_available, trash_available)
            ensure action != ACTION_EXEMPTION or result == exemption_available
            return exemption_available if action == ACTION_EXEMPTION
            action_enabled_with_cleanup(action, restore_available, trash_available)

        def row_selected(index: i64, selected: i64) -> bool:
            index >= 0 and index == selected

        # Changed identities and failed checks must be announced as protected
        # records; only verified Trash receipts can enable Restore.
        def status_protected(status: i64) -> bool:
            status == 2 or status == 3

        def result_is_alert(message: i64) -> bool:
            ensure result == (message == MESSAGE_EXEMPTIONS_READ_FAILED or message == MESSAGE_EXEMPTION_SAVE_FAILED or message == MESSAGE_PREFERENCES_READ_FAILED or message == MESSAGE_PREFERENCES_SAVE_FAILED or message == MESSAGE_MANIFEST_FAILED or message == MESSAGE_BUILD_UNVERIFIED or message == MESSAGE_RECEIPT_SAVE_FAILED or message == MESSAGE_RESTORE_FAILED or message == MESSAGE_RESTORED_SAVE_FAILED or message == MESSAGE_RECEIPT_CHANGED or message == MESSAGE_TRASH_FAILED_ORIGINAL_CONFIRMED or message == MESSAGE_TRASH_ROLLED_BACK or message == MESSAGE_TRASH_ROLLBACK_FAILED or message == MESSAGE_TRASH_LOCATION_UNKNOWN)
            message == MESSAGE_EXEMPTIONS_READ_FAILED or message == MESSAGE_EXEMPTION_SAVE_FAILED or message == MESSAGE_PREFERENCES_READ_FAILED or message == MESSAGE_PREFERENCES_SAVE_FAILED or message == MESSAGE_MANIFEST_FAILED or message == MESSAGE_BUILD_UNVERIFIED or message == MESSAGE_RECEIPT_SAVE_FAILED or message == MESSAGE_RESTORE_FAILED or message == MESSAGE_RESTORED_SAVE_FAILED or message == MESSAGE_RECEIPT_CHANGED or message == MESSAGE_TRASH_FAILED_ORIGINAL_CONFIRMED or message == MESSAGE_TRASH_ROLLED_BACK or message == MESSAGE_TRASH_ROLLBACK_FAILED or message == MESSAGE_TRASH_LOCATION_UNKNOWN
