# A source-capture reply may be published only into the document that asked for it.
module StudioSessionSaveSourceJobPolicy:
    public:
        const enum Reply of i64:
            Refuse = 0
            Publish = 1

        def reply(ticket: i64, current_ticket: i64, cancelled: bool,
                  same_take: bool, same_stack: bool, same_document: bool, same_source_path: bool,
                  same_runtime_path: bool, no_pending_edit: bool, worker_ready: bool) -> Reply:
            ensure result == Reply.Publish implies ticket > 0 and ticket == current_ticket
            ensure result == Reply.Publish implies not cancelled and same_take and same_stack and same_document and same_source_path and same_runtime_path and no_pending_edit and worker_ready
            if ticket > 0 and ticket == current_ticket and not cancelled and same_take and same_stack and same_document and same_source_path and same_runtime_path and no_pending_edit and worker_ready:
                return Reply.Publish
            Reply.Refuse
