# The non-destructive operation stack: a source track plus ordered operations,
# each toggled and scoped to a frame span and a bone mask.
include "../tools/track.elisa"
include "../core/stack_cache.elisa"
include "../core/cache_identity_policy.elisa"

# Process CPU clock (microseconds on macOS and Linux) for per-op profiling.
@link_name("clock")
extern s_clock() -> i64

module Ops:
    public:
        enum Kind:
            Despike
            PinContacts
            CloseSeam
            SmoothPath
            LimitWring
            Median

        struct Operation:
            kind: Kind
            enabled: bool
            first: i64
            last: i64
            bones: i64
            strength: i64      # passes for Despike/SmoothPath, window for CloseSeam, limit for LimitWring
            edge: i64          # fade frames at the scope edges

        def despike(first: i64, last: i64, bones: i64, passes: i64) -> Operation:
            return Operation{kind: Kind.Despike, enabled: true, first: first, last: last, bones: bones, strength: passes, edge: 8}

        # Path smoothing (pelvis path): binomial passes, so a landing does not snap.
        def smooth_path(first: i64, last: i64, bones: i64, passes: i64) -> Operation:
            return Operation{kind: Kind.SmoothPath, enabled: true, first: first, last: last, bones: bones, strength: passes, edge: 8}

        # Knee/elbow stability: soft-limit wring about the guard pose.
        def limit_wring(first: i64, last: i64, bones: i64, limit: i64) -> Operation:
            return Operation{kind: Kind.LimitWring, enabled: true, first: first, last: last, bones: bones, strength: limit, edge: 8}

        # Wide running median (radius frames each side).
        def median(first: i64, last: i64, bones: i64, radius: i64) -> Operation:
            return Operation{kind: Kind.Median, enabled: true, first: first, last: last, bones: bones, strength: radius, edge: 8}

        def seam(window: i64) -> Operation:
            return Operation{kind: Kind.CloseSeam, enabled: true, first: 0, last: 1000000, bones: -1, strength: window, edge: 1}

        # The operation's candidate result for the whole track, before gating.
        def candidate(op: Operation, values: darray[i64]&, looping: bool) -> darray[i64]:
            match op.kind:
                Ops::Kind.Despike:
                    return Track::despike(values, op.strength, 1, looping)
                Ops::Kind.SmoothPath:
                    return Track::smooth(values, op.strength, 1, looping)
                Ops::Kind.LimitWring:
                    return Track::limit_wring(values, op.strength)
                Ops::Kind.Median:
                    return Track::median(values, op.strength, 1)
                Ops::Kind.CloseSeam:
                    return Track::close_seam(values, op.strength)
                Ops::Kind.PinContacts:
                    flags: darray[bool] = Track::contacts(values, values, 10, 20, 1000000000)
                    return Track::pin(values, flags, 0)

        # Apply one operation to one bone channel. Frames outside the span, a
        # disabled operation, and unselected bones come back unchanged.
        def apply(op: Operation, bone: i64, values: darray[i64]&, looping: bool) -> darray[i64]:
            selected: mutable bool = false
            if bone >= 0 and bone < 62:
                selected <- Gate::bone_selected(op.bones, bone)
            if op.enabled and selected:
                fixed: darray[i64] = candidate(op, values, looping)
                return gated(op.first, op.last, op.edge, true, values, &fixed)
            empty: darray[i64] = []
            return gated(op.first, op.last, op.edge, false, values, &empty)

        # Last frame of the span clipped to the clip, as `gated` uses it.
        def span_end(first: i64, last: i64, count: i64) -> i64:
            return first if first > count - 1
            return Order::clamp(last, first, count - 1)

        # Edge fade of frame `f` inside an operation span: FULL outside the
        # ramp's domain or when the span reaches both clip ends, the same
        # cases the original inline condition fell through on.
        def frame_fade(f: i64, first: i64, last: i64, edge: i64, count: i64) -> i64:
            ensure result >= 0
            ensure result <= Fade::Domain::FULL_PERMILLE
            if f >= first and f <= last and first >= 0 and edge >= 1 and edge <= Fade::Domain::MAX_EDGE:
                span_last: i64 = span_end(first, last, count)
                local_last: i64 = span_last - first
                at: i64 = f - first
                ramps: bool = first > 0 or span_last < count - 1
                if ramps and at >= 0 and local_last >= 0 and local_last < Fade::Domain::MAX_FRAMES and at <= local_last:
                    return Fade::ramp(at, local_last, edge)
                else:
                    return Fade::Domain::FULL_PERMILLE
            else:
                return Fade::Domain::FULL_PERMILLE

        # Per-frame gating loop of `apply`, over the operation's span fields;
        # `active` is enabled-and-selected.
        def gated(first: i64, last: i64, edge: i64, active: bool, values: darray[i64]&, fixed: darray[i64]&) -> darray[i64]:
            out: mutable darray[i64] = []
            count: i64 = values.count.i64()
            for i in 0..<values.count:
                f: i64 = i.i64()
                inside: bool = Span::contains(first, last, f)
                fade: i64 = frame_fade(f, first, last, edge, count)
                w: i64 = Gate::weight(active, inside, active, fade)
                source: i64 = values[i]
                if w > 0 and i < fixed.count:
                    out.push(Track::blend(source, fixed[i], w))
                else:
                    out.push(source)
            return out

        # Evaluate the stack in order.
        def evaluate(ops: darray[Operation]&, bone: i64, source: darray[i64]&, looping: bool) -> darray[i64]:
            current: mutable darray[i64] = []
            for v in source |current|:
                current.push(v)
            for op in ops |op, current, bone, looping|:
                current <- apply(op, bone, current, looping)
            return current

        # Per-operation cache: keys[i] is the chained key after op i (see
        # StackCache) and results holds the channel after each op, op i at
        # i * frames (the frame count is part of the source key). `evaluations`
        # counts ops actually run, so callers and tests can see reuse.
        struct Cache:
            keys: mutable darray[i64]
            results: mutable darray[i64]
            frames: mutable i64
            evaluations: mutable i64
            source_snapshot: mutable darray[i64]
            operations: mutable darray[Operation]
            bone: mutable i64
            looping: mutable bool

        def new_cache() -> Cache:
            return Cache{keys: [], results: [], frames: 0, evaluations: 0, source_snapshot: [], operations: [], bone: 0, looping: false}

        def kind_code(kind: Ops::Kind) -> i64:
            match kind:
                Ops::Kind.Despike:
                    return 1
                Ops::Kind.PinContacts:
                    return 2
                Ops::Kind.CloseSeam:
                    return 3
                Ops::Kind.SmoothPath:
                    return 4
                Ops::Kind.LimitWring:
                    return 5
                Ops::Kind.Median:
                    return 6

        # Fingerprint of everything that shapes one op's effect on one bone.
        def params_key(op: Operation, bone: i64) -> i64:
            k: mutable i64 = StackCache::mix(StackCache::Fingerprint::SEED, kind_code(op.kind))
            k <- StackCache::mix(k, op.first)
            k <- StackCache::mix(k, op.last)
            k <- StackCache::mix(k, op.bones)
            k <- StackCache::mix(k, op.strength)
            k <- StackCache::mix(k, op.edge)
            return StackCache::mix(k, bone)

        # Fingerprint of the stack input.
        def source_key(source: darray[i64]&, looping: bool) -> i64:
            k: mutable i64 = StackCache::mix(StackCache::Fingerprint::SEED, source.count.i64())
            k <- StackCache::mix(k, 1 if looping else 0)
            for v in source |k|:
                k <- StackCache::mix(k, v)
            return k

        def copy(values: darray[i64]&) -> darray[i64]:
            out: mutable darray[i64] = []
            out.extend(values)
            return out

        # Evaluate the stack in order, reusing cached results for the longest
        # unchanged prefix and running only the ops after it. The output is
        # identical to `evaluate`.
        def evaluate_cached(ops: darray[Operation]&, bone: i64, source: darray[i64]&, looping: bool, cache: mutable Cache&) -> darray[i64]:
            unused: mutable darray[i64] = []
            return evaluate_timed(ops, bone, source, looping, cache, &unused, false)

        # evaluate_cached that also adds each op's CPU time (clock units) to
        # times[i] when `timed` (times grows to ops.count as needed). Timing
        # never changes the result.
        def evaluate_timed(ops: darray[Operation]&, bone: i64, source: darray[i64]&, looping: bool, cache: mutable Cache&, times: mutable darray[i64]&, timed: bool) -> darray[i64]:
            while timed and times.count < ops.count |times|:
                times.push(0)
            count: i64 = ops.count.i64()
            if count >= StackCache::Capacity::MAX_OPS:
                cache.keys.clear()
                cache.results.clear()
                cache.source_snapshot.clear()
                cache.operations.clear()
                cache.evaluations <- cache.evaluations + count
                return evaluate(ops, bone, source, looping)
            key: mutable i64 = source_key(source, looping)
            keys: mutable darray[i64] = []
            prefix: mutable i64 = 0
            cached: i64 = cache.keys.count.i64()
            exact_input: bool = source_matches(cache, source, bone, looping)
            storage_valid: mutable bool = cache.frames == source.count.i64() and cache.operations.count.i64() >= cached
            storage_valid <- storage_valid and cache.results.count.i64() / source.count.i64() >= cached if source.count > 0
            for i in 0..<ops.count |i, ops, bone, key, keys, prefix, cache, cached, exact_input, storage_valid|:
                key <- StackCache::op_key(key, params_key(ops[i], bone), ops[i].enabled)
                keys.push(key)
                index: i64 = i.i64()
                exact_operation: bool = i < cache.operations.count and operation_matches(cache.operations[i], ops[i])
                same: bool = CacheIdentityPolicy::reuse_admitted(index < cached and cache.keys[i] == key, exact_input, exact_operation, storage_valid)
                prefix <- StackCache::scan(prefix, index, same)
            frames: i64 = source.count.i64()
            reuse: i64 = StackCache::reusable(cached, prefix, count)
            current: mutable darray[i64] = copy(source)
            evaluated: mutable i64 = 0
            for i in 0..<ops.count |i, ops, bone, looping, reuse, current, cache, evaluated, frames, times, timed|:
                index: i64 = i.i64()
                if StackCache::needs_eval(index, reuse):
                    if ops[i].enabled:
                        start: i64 = s_clock() if timed else 0
                        current <- apply(ops[i], bone, current, looping)
                        evaluated <- evaluated + 1
                        times[i] <- times[i] + s_clock() - start if timed
                    base: i64 = index * frames
                    for f in 0..<current.count |f, base, current, cache|:
                        at: i64 = base + f.i64()
                        if at < cache.results.count.i64():
                            cache.results[at.usize()] <- current[f]
                        else:
                            cache.results.push(current[f])
                else:
                    base: i64 = index * frames
                    for f in 0..<current.count |f, base, current, cache|:
                        current[f] <- cache.results[(base + f.i64()).usize()]
            while cache.results.count.i64() > count * frames:
                cache.results.pop()
            cache.frames <- frames
            cache.keys.clear()
            for k in keys |cache|:
                cache.keys.push(k)
            cache.source_snapshot.clear()
            cache.source_snapshot.extend(source)
            cache.operations.clear()
            cache.operations.extend(ops)
            cache.bone <- bone
            cache.looping <- looping
            cache.evaluations <- cache.evaluations + evaluated
            return current

    private:
        # Hash equality is only an accelerator. Compare the actual input and
        # effective operation parameters before admitting any cached result.
        def source_matches(cache: Cache&, source: darray[i64]&, bone: i64, looping: bool) -> bool:
            return false if cache.bone != bone or cache.looping != looping or cache.source_snapshot.count != source.count
            for index in 0..<source.count:
                return false if cache.source_snapshot[index] != source[index]
            true

        def operation_matches(before: Operation, after: Operation) -> bool:
            return true if not before.enabled and not after.enabled
            before.enabled == after.enabled and before.kind == after.kind and before.first == after.first and before.last == after.last and before.bones == after.bones and before.strength == after.strength and before.edge == after.edge
