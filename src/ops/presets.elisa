# Cleanup presets per capture source.
include "stack.elisa"
include "rig_stack.elisa"

module Presets:
    public:
        enum Preset:
            Boxing       # Mixamo-derived 120 Hz boxing clips: light de-spike
            Raw          # raw optical/inertial capture: stronger de-spike
            Rokoko       # inertial suit takes: raw de-spike plus rig fixes (twist, pole, pelvis, foot lock)
            Unknown

        def parse(name: sview) -> Preset:
            return Preset.Boxing if name == "boxing"
            return Preset.Raw if name == "raw"
            return Preset.Rokoko if name == "rokoko"
            return Preset.Unknown

        def spike_threshold(preset: Preset) -> i64:
            ensure result > 0
            match preset:
                Preset.Raw:
                    return 10000
                Preset.Rokoko:
                    return 10000
                _:
                    return 20000

        def operations(preset: Preset) -> darray[Ops::Operation]:
            mutable ops: darray[Ops::Operation] = []
            match preset:
                Preset.Raw:
                    ops.push(Ops::despike(0, 1000000, -1, 3))
                Preset.Rokoko:
                    ops.push(Ops::despike(0, 1000000, -1, 3))
                _:
                    ops.extend([
                        Ops::median(0, 1000000, 2, 20),  # legs: 41-frame median
                        Ops::smooth_path(0, 1000000, 2, 32),  # binomial, sigma ~4 frames
                        Ops::despike(0, 1000000, -1, 2)
                    ])
            return ops

        const module Timing:
            # The presets are tuned on 120 Hz takes.
            TUNED_RATE: i64 = 120
            MIN_RATE: i64 = 1
            MAX_RATE: i64 = 1000

        # A median radius tuned at 120 Hz, in frames at `rate`, so it spans the
        # same time: 20 frames (166 ms) becomes 5 frames at 30 Hz.
        def scaled_radius(radius: i64, rate: i64) -> i64:
            requires radius >= 1 and radius <= 1000
            requires rate >= Timing::MIN_RATE and rate <= Timing::MAX_RATE
            ensure result >= 1
            ensure rate != Timing::TUNED_RATE or result == radius
            scaled: i64 = (radius * rate + Timing::TUNED_RATE / 2) / Timing::TUNED_RATE
            return scaled if scaled >= 1 else 1

        # Binomial smoothing passes at `rate`: the kernel's variance grows with
        # the pass count, so keeping its width in time scales passes by rate².
        def scaled_passes(passes: i64, rate: i64) -> i64:
            requires passes >= 1 and passes <= 1000
            requires rate >= Timing::MIN_RATE and rate <= Timing::MAX_RATE
            ensure result >= 1
            ensure rate != Timing::TUNED_RATE or result == passes
            square: i64 = Timing::TUNED_RATE * Timing::TUNED_RATE
            scaled: i64 = (passes * rate * rate + square / 2) / square
            return scaled if scaled >= 1 else 1

        # The spike threshold for a take sampled at `rate` Hz. The test is a
        # per-frame second difference: the same physical acceleration reads
        # (120 / rate)² larger per frame at lower rates, while a one-frame
        # glitch keeps its size. Scaling by 120 / rate sits between the two.
        # On a 30 fps Unreal take it left 2 flagged frames instead of 29 (1
        # at 8x and 16x). Rates outside the domain keep the tuned threshold.
        def spike_threshold_at(preset: Preset, rate: i64) -> i64:
            requires rate >= Timing::MIN_RATE and rate <= Timing::MAX_RATE
            ensure result > 0
            ensure rate != Timing::TUNED_RATE or result == spike_threshold(preset)
            base: i64 = spike_threshold(preset)
            scaled: i64 = (base * Timing::TUNED_RATE + rate / 2) / rate
            return scaled if scaled > 0 else base

        # `preset`'s operations retuned for a take sampled at `rate` Hz.
        # Despike works on single frames and keeps its passes; an unknown or
        # out-of-range rate keeps the 120 Hz tuning.
        def operations_at(preset: Preset, rate: i64) -> darray[Ops::Operation]:
            mutable ops: darray[Ops::Operation] = operations(preset)
            return ops if rate < Timing::MIN_RATE or rate > Timing::MAX_RATE or rate == Timing::TUNED_RATE
            for i in 0..<ops.count |ops, rate|:
                op: Ops::Operation = ops[i]
                if op.kind == Ops::Kind.Median and op.strength >= 1 and op.strength <= 1000:
                    ops[i] <- Ops::median(op.first, op.last, op.bones, scaled_radius(op.strength, rate))
                elif op.kind == Ops::Kind.SmoothPath and op.strength >= 1 and op.strength <= 1000:
                    ops[i] <- Ops::smooth_path(op.first, op.last, op.bones, scaled_passes(op.strength, rate))
            return ops

        # Rig-level fixes per preset. Boxing keeps none, so its output (and
        # the parity gate) is exactly the channel stack's.
        def rig_operations(preset: Preset) -> darray[RigOps::RigOp]:
            mutable ops: darray[RigOps::RigOp] = []
            match preset:
                Preset.Rokoko:
                    ops.extend([
                        RigOps::twist(RigOps::Selection::ALL, 280000, 500),  # <=16 degrees; half twist to roll bones
                        RigOps::pole(RigOps::Selection::ALL, 2, 0),
                        RigOps::pelvis(4),
                        RigOps::foot_lock(4)
                    ])
                _:
                    ops <- ops
            return ops
