# Keyed pose corrections (studio Phase 3): a bone's local rotation and
# translation offset, keyed at one frame and faded to nothing at the scope
# ends by the proved KeyWeight ramp. Corrections run after the operation
# stack, on the cleaned document, so the CLI export and the studio preview
# see the same clip. Key index is the frame, as for every other operation.
include "../io/glb_tracks.elisa"
include "../core/key_weight.elisa"
include "../core/correction_scope_policy.elisa"
include "../core/storage_range_policy.elisa"

module Corrections:
    public:
        const MAX: i64 = 16

        const module StoreDomain:
            MAX_COMPONENT: f32 = 3.4e38

        struct Correction:
            enabled: bool
            # Document node of the corrected bone.
            node: i64
            key: i64
            first: i64
            last: i64
            # Local offset at the key: rotation pre-multiplied onto the
            # bone's local rotation, translation added to its local position.
            rotation: Geometry::Quat
            translation: Geometry::Vec3

        # The correction that takes local transform `current` of `node` to
        # `wanted` at frame `key`, faded over [first, last].
        def keyed(node: i64, key: i64, first: i64, last: i64, current: Geometry::Transform, wanted: Geometry::Transform) -> Correction:
            mutable d: Geometry::Quat = Geometry::quat_normalize(Geometry::quat_mul(wanted.rotation, Geometry::quat_conjugate(current.rotation)))
            if d.w < 0.0:
                d <- Geometry::Quat{x: 0.0 - d.x, y: 0.0 - d.y, z: 0.0 - d.z, w: 0.0 - d.w}
            lo: i64 = first if first <= key else key
            hi: i64 = last if last >= key else key
            Correction{enabled: true, node: node, key: key, first: lo if lo >= 0 else 0, last: hi, rotation: d, translation: Geometry::vec3_sub(wanted.position, current.position)}

        def same(a: Correction&, b: Correction&) -> bool:
            return false if a.enabled != b.enabled or a.node != b.node or a.key != b.key or a.first != b.first or a.last != b.last
            return false if a.rotation.x != b.rotation.x or a.rotation.y != b.rotation.y or a.rotation.z != b.rotation.z or a.rotation.w != b.rotation.w
            return a.translation.x == b.translation.x and a.translation.y == b.translation.y and a.translation.z == b.translation.z

        # Exact identity only; this deliberately does not impose a tolerance
        # that could discard a small intentional edit. keyed keeps w positive.
        def identity(c: Correction&) -> bool:
            ensure result == (c.rotation.x == 0.0 and c.rotation.y == 0.0 and c.rotation.z == 0.0 and c.rotation.w == 1.0 and c.translation.x == 0.0 and c.translation.y == 0.0 and c.translation.z == 0.0)
            c.rotation.x == 0.0 and c.rotation.y == 0.0 and c.rotation.z == 0.0 and c.rotation.w == 1.0 and c.translation.x == 0.0 and c.translation.y == 0.0 and c.translation.z == 0.0

        def transform_admitted(c: Correction&) -> bool:
            ensure result == (Geometry::quat_is_finite(c.rotation) and Geometry::vec3_is_finite(c.translation) and Geometry::quat_length(c.rotation) - Geometry::quat_length(c.rotation) == 0.0 and Geometry::quat_length(c.rotation) > 0.0)
            length: f32 = Geometry::quat_length(c.rotation)
            Geometry::quat_is_finite(c.rotation) and Geometry::vec3_is_finite(c.translation) and length - length == 0.0 and length > 0.0

        # Rotation offset scaled to `weight` permille (normalised lerp from
        # identity; the offset is kept on the short arc by `keyed`).
        def partial(d: Geometry::Quat, weight: i64) -> Geometry::Quat:
            t: f32 = weight.f32() / KeyWeight::Domain::FULL_PERMILLE.f32()
            s: f32 = 1.0 - t
            Geometry::quat_normalize(Geometry::Quat{x: d.x * t, y: d.y * t, z: d.z * t, w: s + d.w * t})

        def scalar_storable(value: f32) -> bool:
            ensure result == (value - value == 0.0 and value >= -StoreDomain::MAX_COMPONENT and value <= StoreDomain::MAX_COMPONENT)
            value - value == 0.0 and value >= -StoreDomain::MAX_COMPONENT and value <= StoreDomain::MAX_COMPONENT

        # Preflight every affected key before the first channel write. The
        # engine refuses individual invalid components; without this pass an
        # overflowing translation could otherwise update only two axes.
        def outputs_admitted(doc: GlbDocument::Document&, anim: usize, c: Correction&) -> bool:
            for at in 0..<GlbDocument::channel_count(doc, anim) |at, doc, anim, c|:
                held: GlbDocument::Channel = GlbDocument::channel(doc, anim, at)
                continue if held.node.i64() != c.node or held.interpolation == GlbDocument::Interpolation.CubicSpline
                rotation: bool = held.path == GlbDocument::TargetPath.Rotation
                translation: bool = held.path == GlbDocument::TargetPath.Translation
                continue if not rotation and not translation
                # A shared output accessor would couple different channels
                # or apply this correction twice after a one-pass preflight.
                for other_at in 0..<GlbDocument::channel_count(doc, anim) |other_at, at, doc, anim, held|:
                    continue if other_at == at
                    other: GlbDocument::Channel = GlbDocument::channel(doc, anim, other_at)
                    return false if other.output == held.output
                track: GlbDocument::Track = GlbDocument::track(doc, held.output)
                return false if track.components != (4 if rotation else 3)
                if storage_length(doc, track) is length:
                    for other_slot in 0..<GlbDocument::track_count(doc) |other_slot, doc, held, track, length|:
                        continue if other_slot == held.output
                        other: GlbDocument::Track = GlbDocument::track(doc, other_slot)
                        if storage_length(doc, other) is other_length:
                            return false if StorageRangePolicy::overlaps(track.byte_start, length, other.byte_start, other_length)
                        else:
                            return false
                else:
                    return false
                for k in 0..<track.count |k, doc, held, c, rotation|:
                    continue if not KeyWeight::admits_index(k, c.first, c.last)
                    weight: i64 = KeyWeight::weight(k.i64(), c.first, c.key, c.last)
                    continue if weight <= 0
                    if rotation:
                        q: Geometry::Quat = Geometry::Quat{x: GlbDocument::track_value(doc, held.output, k, 0), y: GlbDocument::track_value(doc, held.output, k, 1), z: GlbDocument::track_value(doc, held.output, k, 2), w: GlbDocument::track_value(doc, held.output, k, 3)}
                        r: Geometry::Quat = Geometry::quat_normalize(Geometry::quat_mul(partial(c.rotation, weight), q))
                        return false if not scalar_storable(r.x) or not scalar_storable(r.y) or not scalar_storable(r.z) or not scalar_storable(r.w)
                        norm: f32 = Geometry::quat_length(r)
                        return false if norm - norm != 0.0 or norm <= 0.0
                    else:
                        t: f32 = weight.f32() / KeyWeight::Domain::FULL_PERMILLE.f32()
                        return false if not scalar_storable(GlbDocument::track_value(doc, held.output, k, 0) + c.translation.x * t)
                        return false if not scalar_storable(GlbDocument::track_value(doc, held.output, k, 1) + c.translation.y * t)
                        return false if not scalar_storable(GlbDocument::track_value(doc, held.output, k, 2) + c.translation.z * t)
            true

        # Number of keys moved, or -1 on refusal before any channel write.
        def apply(doc: mutable GlbDocument::Document&, anim: usize, c: Correction&) -> i64:
            return 0 if not c.enabled
            return -1 if not CorrectionScopePolicy::valid(c.node, c.first, c.key, c.last) or not transform_admitted(c)
            return -1 if not outputs_admitted(doc, anim, c)
            mutable moved: i64 = 0
            for at in 0..<GlbDocument::channel_count(doc, anim) |at, doc, anim, c, moved|:
                held: GlbDocument::Channel = GlbDocument::channel(doc, anim, at)
                continue if held.node.i64() != c.node
                continue if held.interpolation == GlbDocument::Interpolation.CubicSpline
                rotation: bool = held.path == GlbDocument::TargetPath.Rotation
                translation: bool = held.path == GlbDocument::TargetPath.Translation
                continue if not rotation and not translation
                keys: usize = GlbDocument::key_count(doc, held.output)
                for k in 0..<keys |k, doc, held, c, moved, rotation|:
                    # Out-of-scope keys are untouched, including indices too
                    # large for the signed frame domain of the weight kernel.
                    continue if not KeyWeight::admits_index(k, c.first, c.last)
                    w: i64 = KeyWeight::weight(k.i64(), c.first, c.key, c.last)
                    if w > 0:
                        if rotation:
                            q: Geometry::Quat = Geometry::Quat{x: GlbDocument::track_value(doc, held.output, k, 0), y: GlbDocument::track_value(doc, held.output, k, 1), z: GlbDocument::track_value(doc, held.output, k, 2), w: GlbDocument::track_value(doc, held.output, k, 3)}
                            r: Geometry::Quat = Geometry::quat_normalize(Geometry::quat_mul(partial(c.rotation, w), q))
                            _ = GlbDocument::set_track_value(doc, held.output, k, 0, r.x)
                            _ = GlbDocument::set_track_value(doc, held.output, k, 1, r.y)
                            _ = GlbDocument::set_track_value(doc, held.output, k, 2, r.z)
                            _ = GlbDocument::set_track_value(doc, held.output, k, 3, r.w)
                        else:
                            t: f32 = w.f32() / KeyWeight::Domain::FULL_PERMILLE.f32()
                            _ = GlbDocument::set_track_value(doc, held.output, k, 0, GlbDocument::track_value(doc, held.output, k, 0) + c.translation.x * t)
                            _ = GlbDocument::set_track_value(doc, held.output, k, 1, GlbDocument::track_value(doc, held.output, k, 1) + c.translation.y * t)
                            _ = GlbDocument::set_track_value(doc, held.output, k, 2, GlbDocument::track_value(doc, held.output, k, 2) + c.translation.z * t)
                        moved <- moved + 1
            return moved

    private:
        def storage_length(doc: GlbDocument::Document&, track: GlbDocument::Track) -> usize?:
            StorageRangePolicy::float_span_length(GlbDocument::byte_count(doc), track.byte_start, track.count, track.components)
