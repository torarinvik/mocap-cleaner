# Rig-stack cache split at the contact-edit boundary. RigOps::run_clip runs
# the enabled non-pin ops in order, then the pins; only foot lock reads the
# foot contacts (detected, then overridden by ContactEdit ops). The cache
# snapshots the clip after the steps before the first contact reader, keyed
# by PerfCache::plain_key over those steps; the steps from the reader on fold
# in the contact-edit key (PerfCache::step_key). A contact edit, or an edit to
# any step at or after the boundary, reruns only that downstream part; the
# result is identical to RigOps::run_clip.
include "rig_stack.elisa"
include "../core/perf_cache.elisa"

module RigCache:
    public:
        affine struct Cache:
            valid: mutable bool
            prefix_key: mutable i64
            prefix_steps: mutable i64
            snapshot: mutable Rig::Clip
            summary: mutable RigOps::Summary
            # The whole stack's output, keyed by every step and the contacts.
            final_valid: mutable bool
            final_key: mutable i64
            result: mutable Rig::Clip
            final_summary: mutable RigOps::Summary
            # Steps (ops) actually run, across calls.
            evaluations: mutable i64

        def new_cache() -> Cache:
            return Cache{valid: false, prefix_key: 0, prefix_steps: 0, snapshot: Rig::empty_clip(), summary: RigOps::empty_summary(), final_valid: false, final_key: 0, result: Rig::empty_clip(), final_summary: RigOps::empty_summary(), evaluations: 0}

        def copy_clip(c: Rig::Clip&) -> Rig::Clip:
            mutable out: Rig::Clip = Rig::empty_clip()
            for j in c.joints |out|:
                out.joints.push(j)
            for r in c.roles |out|:
                out.roles.push(r)
            for o in c.order |out|:
                out.order.push(o)
            out.frames <- c.frames
            for t in c.times |out|:
                out.times.push(t)
            for q in c.rot |out|:
                out.rot.push(q)
            for p in c.pos |out|:
                out.pos.push(p)
            for s in c.scl |out|:
                out.scl.push(s)
            for d in c.rot_dirty |out|:
                out.rot_dirty.push(d)
            for d in c.pos_dirty |out|:
                out.pos_dirty.push(d)
            return out

        def kind_code(kind: RigOps::RigKind) -> i64:
            match kind:
                RigOps::RigKind.Twist:
                    return 1
                RigOps::RigKind.Pole:
                    return 2
                RigOps::RigKind.PelvisPath:
                    return 3
                RigOps::RigKind.FootLock:
                    return 4
                RigOps::RigKind.PinEffector:
                    return 5
                RigOps::RigKind.OffsetLayer:
                    return 6
                RigOps::RigKind.KeyedOffset:
                    return 7
                RigOps::RigKind.ContactEdit:
                    return 8
                RigOps::RigKind.HandLock:
                    return 9
                RigOps::RigKind.Retime:
                    return 10

        def params_key(op: RigOps::RigOp) -> i64:
            k: mutable i64 = StackCache::mix(StackCache::SEED, kind_code(op.kind))
            k <- StackCache::mix(k, 1 if op.enabled else 0)
            k <- StackCache::mix(k, op.first)
            k <- StackCache::mix(k, op.last)
            k <- StackCache::mix(k, op.role)
            k <- StackCache::mix(k, op.axis)
            k <- StackCache::mix(k, op.amount)
            k <- StackCache::mix(k, op.passes)
            return StackCache::mix(k, op.edge)

        # Fingerprint of every contact edit (what foot_contacts reads).
        def contacts_key(ops: darray[RigOps::RigOp]&) -> i64:
            k: mutable i64 = StackCache::SEED
            for op in ops |k|:
                k <- StackCache::mix(k, params_key(op)) if op.kind == RigOps::RigKind.ContactEdit
            return k

        def reads_contacts(op: RigOps::RigOp) -> bool:
            return op.kind == RigOps::RigKind.FootLock or op.kind == RigOps::RigKind.HandLock

        # The ops RigOps::run_clip executes, in its order.
        def schedule(ops: darray[RigOps::RigOp]&) -> darray[i64]:
            out: mutable darray[i64] = []
            for round in 0..<2 |round, ops, out|:
                for i in 0..<ops.count |i, round, ops, out|:
                    op: RigOps::RigOp = ops[i]
                    continue if not op.enabled or op.kind == RigOps::RigKind.ContactEdit or op.kind == RigOps::RigKind.Retime
                    is_pin: bool = op.kind == RigOps::RigKind.PinEffector
                    continue if (round == 0) == is_pin
                    out.push(i.i64())
            return out

        def one(ops: darray[RigOps::RigOp]&, at: i64) -> darray[RigOps::RigOp]:
            out: mutable darray[RigOps::RigOp] = []
            out.push(ops[at.usize()])
            return out

        # Run step `at` exactly as run_clip does (contact edits stay visible
        # to foot lock through the full list).
        def run_step(c: mutable Rig::Clip&, ops: darray[RigOps::RigOp]&, at: i64, threshold: i64, s: mutable RigOps::Summary&) -> void:
            op: RigOps::RigOp = ops[at.usize()]
            if op.kind == RigOps::RigKind.FootLock:
                s.ops <- s.ops + 1
                RigOps::lock_leg(c, op, ops, 0, s) if RigOps::role_selected(op, Roles::LEFT_FOOT)
                RigOps::lock_leg(c, op, ops, 1, s) if RigOps::role_selected(op, Roles::RIGHT_FOOT)
                return
            if op.kind == RigOps::RigKind.HandLock:
                s.ops <- s.ops + 1
                RigOps::lock_arm(c, op, ops, 0, s) if RigOps::role_selected(op, Roles::LEFT_HAND)
                RigOps::lock_arm(c, op, ops, 1, s) if RigOps::role_selected(op, Roles::RIGHT_HAND)
                return
            single: darray[RigOps::RigOp] = one(ops, at)
            part: RigOps::Summary = RigOps::run_clip(c, single, threshold)
            add(s, &part)

        def add(total: mutable RigOps::Summary&, p: RigOps::Summary&) -> void:
            total.ops <- total.ops + p.ops
            total.changed <- total.changed + p.changed
            total.twist_max <- p.twist_max if p.twist_max > total.twist_max else total.twist_max
            total.pole_before <- total.pole_before + p.pole_before
            total.pole_after <- total.pole_after + p.pole_after
            total.slide_before <- total.slide_before + p.slide_before
            total.slide_after <- total.slide_after + p.slide_after
            total.pelvis_before <- total.pelvis_before + p.pelvis_before
            total.pelvis_after <- total.pelvis_after + p.pelvis_after
            total.sink_before <- total.sink_before + p.sink_before
            total.sink_after <- total.sink_after + p.sink_after
            total.hand_before <- total.hand_before + p.hand_before
            total.hand_after <- total.hand_after + p.hand_after

        # run_clip with the boundary cache. `source` fingerprints the input
        # clip (callers key it by what produced the clip).
        def run_clip_cached(c: mutable Rig::Clip&, ops: darray[RigOps::RigOp]&, threshold: i64, source: i64, cache: mutable Cache&) -> RigOps::Summary:
            order: darray[i64] = schedule(ops)
            boundary: mutable i64 = order.count.i64()
            for k in 0..<order.count |k, order, ops, boundary|:
                boundary <- k.i64() if boundary == order.count.i64() and reads_contacts(ops[order[k].usize()])
            key: mutable i64 = StackCache::mix(StackCache::SEED, source)
            for k in 0..<order.count |k, order, ops, key, boundary|:
                key <- PerfCache::plain_key(key, params_key(ops[order[k].usize()])) if k.i64() < boundary
            key <- StackCache::mix(key, boundary)
            whole: mutable i64 = key
            for k in 0..<order.count |k, order, ops, whole, boundary|:
                whole <- PerfCache::plain_key(whole, params_key(ops[order[k].usize()])) if k.i64() >= boundary
            final: i64 = PerfCache::step_key(whole, true, contacts_key(ops))
            if cache.final_valid and cache.final_key == final:
                c <- copy_clip(&cache.result)
                return cache.final_summary
            mutable s: RigOps::Summary = RigOps::empty_summary()
            if cache.valid and cache.prefix_key == key and cache.prefix_steps == boundary:
                c <- copy_clip(&cache.snapshot)
                s <- cache.summary
            else:
                for k in 0..<order.count |k, order, ops, c, threshold, s, boundary|:
                    run_step(c, ops, order[k], threshold, &s) if k.i64() < boundary
                cache.evaluations <- cache.evaluations + boundary
                cache.snapshot <- copy_clip(c)
                cache.summary <- s
                cache.prefix_key <- key
                cache.prefix_steps <- boundary
                cache.valid <- true
            for k in 0..<order.count |k, order, ops, c, threshold, s, boundary, cache|:
                if k.i64() >= boundary:
                    run_step(c, ops, order[k], threshold, &s)
                    cache.evaluations <- cache.evaluations + 1
            cache.result <- copy_clip(c)
            cache.final_summary <- s
            cache.final_key <- final
            cache.final_valid <- true
            return s
