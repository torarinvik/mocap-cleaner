# Rig-stack cache split at the contact-edit boundary. RigOps::run_clip runs
# the enabled non-pin ops in order, then the pins; foot and hand locks read
# contacts (detected, then overridden by ContactEdit ops). The cache
# snapshots the clip after the steps before the first contact reader, keyed
# by PerfCache::plain_key over those steps; the steps from the reader on fold
# in the contact-edit key (PerfCache::step_key). A contact edit, or an edit to
# any step at or after the boundary, reruns only that downstream part; the
# result is identical to RigOps::run_clip.
include "rig_cache_schema.elisa"
include "../core/perf_cache.elisa"
include "../core/cache_identity_policy.elisa"
include "../core/rig_cache_budget_policy.elisa"

extend RigCache:
    public:
        def new_cache() -> Cache:
            return Cache{valid: false, prefix_key: 0, prefix_steps: 0, snapshot: Rig::empty_clip(), summary: RigOps::empty_summary(), final_valid: false, final_key: 0, result: Rig::empty_clip(), final_summary: RigOps::empty_summary(), evaluations: 0, input_snapshot: Rig::empty_clip(), input_valid: false, input_source: 0, input_threshold: 0, operations: [], step_order: []}

        def copy_clip(c: Rig::Clip&) -> Rig::Clip:
            mutable out: Rig::Clip = Rig::empty_clip()
            out.joints.extend(c.joints)
            out.roles.extend(c.roles)
            out.order.extend(c.order)
            out.frames <- c.frames
            out.times.extend(c.times)
            out.rot.extend(c.rot)
            out.pos.extend(c.pos)
            out.scl.extend(c.scl)
            out.rot_dirty.extend(c.rot_dirty)
            out.pos_dirty.extend(c.pos_dirty)
            return move out

        def kind_code(kind: RigOps::RigKind) -> i64:
            match kind:
                RigOps::RigKind.Twist:
                    return 1
                RigOps::RigKind.Pole:
                    return 2
                RigOps::RigKind.PelvisPath:
                    return 3
                RigOps::RigKind.FootLock:
                    return 4
                RigOps::RigKind.PinEffector:
                    return 5
                RigOps::RigKind.OffsetLayer:
                    return 6
                RigOps::RigKind.KeyedOffset:
                    return 7
                RigOps::RigKind.ContactEdit:
                    return 8
                RigOps::RigKind.HandLock:
                    return 9
                RigOps::RigKind.Retime:
                    return 10

        def params_key(op: RigOps::RigOp) -> i64:
            k: mutable i64 = StackCache::mix(StackCache::Fingerprint::SEED, kind_code(op.kind))
            k <- StackCache::mix(k, 1 if op.enabled else 0)
            k <- StackCache::mix(k, op.first)
            k <- StackCache::mix(k, op.last)
            k <- StackCache::mix(k, op.role)
            k <- StackCache::mix(k, op.axis)
            k <- StackCache::mix(k, op.amount)
            k <- StackCache::mix(k, op.passes)
            return StackCache::mix(k, op.edge)

        # Fingerprint of every contact edit (what foot_contacts reads).
        def contacts_key(ops: darray[RigOps::RigOp]&) -> i64:
            k: mutable i64 = StackCache::Fingerprint::SEED
            for op in ops |k|:
                k <- StackCache::mix(k, params_key(op)) if op.kind == RigOps::RigKind.ContactEdit
            return k

        def reads_contacts(op: RigOps::RigOp) -> bool:
            return op.kind == RigOps::RigKind.FootLock or op.kind == RigOps::RigKind.HandLock

        # The ops RigOps::run_clip executes, in its order.
        def schedule(ops: darray[RigOps::RigOp]&) -> darray[i64]:
            out: mutable darray[i64] = []
            for round in 0..<2 |round, ops, out|:
                for i in 0..<ops.count |i, round, ops, out|:
                    op: RigOps::RigOp = ops[i]
                    continue if not op.enabled or op.kind == RigOps::RigKind.ContactEdit or op.kind == RigOps::RigKind.Retime
                    is_pin: bool = op.kind == RigOps::RigKind.PinEffector
                    continue if (round == 0) == is_pin
                    out.push(i.i64())
            return out

        def one(ops: darray[RigOps::RigOp]&, at: i64) -> darray[RigOps::RigOp]:
            out: mutable darray[RigOps::RigOp] = []
            out.push(ops[at.usize()])
            return out

        # Run step `at` exactly as run_clip does (contact edits stay visible
        # to foot lock through the full list).
        def run_step(c: mutable Rig::Clip&, ops: darray[RigOps::RigOp]&, at: i64, threshold: i64, s: mutable RigOps::Summary&) -> void can[Global{Read, Write}]:
            can Global{Read, Write}:
                op: RigOps::RigOp = ops[at.usize()]
                if op.kind == RigOps::RigKind.FootLock:
                    s.ops <- s.ops + 1
                    RigOps::lock_leg(c, op, ops, 0, s) if RigOps::role_selected(op, Roles::Joint.LeftFoot.i64())
                    RigOps::lock_leg(c, op, ops, 1, s) if RigOps::role_selected(op, Roles::Joint.RightFoot.i64())
                    return
                if op.kind == RigOps::RigKind.HandLock:
                    s.ops <- s.ops + 1
                    RigOps::lock_arm(c, op, ops, 0, s) if RigOps::role_selected(op, Roles::Joint.LeftHand.i64())
                    RigOps::lock_arm(c, op, ops, 1, s) if RigOps::role_selected(op, Roles::Joint.RightHand.i64())
                    return
                single: darray[RigOps::RigOp] = one(ops, at)
                part: RigOps::Summary = RigOps::run_clip(c, single, threshold)
                add(s, &part)

        def add(total: mutable RigOps::Summary&, p: RigOps::Summary&) -> void:
            total.ops <- total.ops + p.ops
            total.changed <- total.changed + p.changed
            total.twist_max <- p.twist_max if p.twist_max > total.twist_max else total.twist_max
            total.pole_before <- total.pole_before + p.pole_before
            total.pole_after <- total.pole_after + p.pole_after
            total.slide_before <- total.slide_before + p.slide_before
            total.slide_after <- total.slide_after + p.slide_after
            total.pelvis_before <- total.pelvis_before + p.pelvis_before
            total.pelvis_after <- total.pelvis_after + p.pelvis_after
            total.sink_before <- total.sink_before + p.sink_before
            total.sink_after <- total.sink_after + p.sink_after
            total.hand_before <- total.hand_before + p.hand_before
            total.hand_after <- total.hand_after + p.hand_after

        # run_clip with the boundary cache. `source` fingerprints the input
        # clip (callers key it by what produced the clip).
        def run_clip_cached(c: mutable Rig::Clip&, ops: darray[RigOps::RigOp]&, threshold: i64, source: i64, cache: mutable Cache&) -> RigOps::Summary can[Global{Read, Write}]:
            can Global{Read, Write}:
                if not budget_admitted(c, ops.count.i64()):
                    cache.valid <- false
                    cache.final_valid <- false
                    cache.input_valid <- false
                    cache.snapshot <- Rig::empty_clip()
                    cache.result <- Rig::empty_clip()
                    cache.input_snapshot <- Rig::empty_clip()
                    cache.operations.clear()
                    cache.step_order.clear()
                    full: RigOps::Summary = RigOps::run_clip(c, ops, threshold)
                    cache.evaluations <- cache.evaluations + full.ops
                    return full
                order: darray[i64] = schedule(ops)
                boundary: mutable i64 = order.count.i64()
                for k in 0..<order.count |k, order, ops, boundary|:
                    boundary <- k.i64() if boundary == order.count.i64() and reads_contacts(ops[order[k].usize()])
                key: mutable i64 = StackCache::mix(StackCache::Fingerprint::SEED, source)
                for k in 0..<order.count |k, order, ops, key, boundary|:
                    key <- PerfCache::plain_key(key, params_key(ops[order[k].usize()])) if k.i64() < boundary
                key <- StackCache::mix(key, boundary)
                whole: mutable i64 = key
                for k in 0..<order.count |k, order, ops, whole, boundary|:
                    whole <- PerfCache::plain_key(whole, params_key(ops[order[k].usize()])) if k.i64() >= boundary
                final: i64 = PerfCache::step_key(whole, true, contacts_key(ops))
                exact_input: bool = cache.input_valid and cache.input_source == source and cache.input_threshold == threshold and input_matches(&cache.input_snapshot, c)
                exact_prefix: bool = prefix_matches(cache, ops, order, boundary)
                exact_operations: bool = operations_match(&cache.operations, ops)
                if CacheIdentityPolicy::reuse_admitted(cache.final_key == final, exact_input, exact_operations, cache.final_valid):
                    c <- copy_clip(&cache.result)
                    return cache.final_summary
                mutable next_input: Rig::Clip = copy_clip(c)
                mutable s: RigOps::Summary = RigOps::empty_summary()
                if CacheIdentityPolicy::reuse_admitted(cache.prefix_key == key, exact_input, exact_prefix, cache.valid and cache.prefix_steps == boundary):
                    c <- copy_clip(&cache.snapshot)
                    s <- cache.summary
                else:
                    for k in 0..<order.count |k, order, ops, c, threshold, s, boundary|:
                        run_step(c, ops, order[k], threshold, &s) if k.i64() < boundary
                    cache.evaluations <- cache.evaluations + boundary
                    cache.snapshot <- copy_clip(c)
                    cache.summary <- s
                    cache.prefix_key <- key
                    cache.prefix_steps <- boundary
                    cache.valid <- true
                for k in 0..<order.count |k, order, ops, c, threshold, s, boundary, cache|:
                    if k.i64() >= boundary:
                        run_step(c, ops, order[k], threshold, &s)
                        cache.evaluations <- cache.evaluations + 1
                cache.result <- copy_clip(c)
                cache.final_summary <- s
                cache.final_key <- final
                cache.final_valid <- true
                cache.input_snapshot <- move next_input
                cache.input_valid <- true
                cache.input_source <- source
                cache.input_threshold <- threshold
                cache.operations.clear()
                cache.operations.extend(ops)
                cache.step_order.clear()
                cache.step_order.extend(order)
                return s

    private:
        def budget_admitted(c: Rig::Clip&, operations: i64) -> bool:
            bytes: mutable i64 = RigCacheBudgetPolicy::add_array(0, c.joints.count.i64(), RigCacheBudgetPolicy::LogicalSize::JOINT_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.roles.count.i64(), RigCacheBudgetPolicy::LogicalSize::INDEX_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.order.count.i64(), RigCacheBudgetPolicy::LogicalSize::INDEX_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.times.count.i64(), RigCacheBudgetPolicy::LogicalSize::INDEX_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.rot.count.i64(), RigCacheBudgetPolicy::LogicalSize::QUATERNION_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.pos.count.i64(), RigCacheBudgetPolicy::LogicalSize::VECTOR_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.scl.count.i64(), RigCacheBudgetPolicy::LogicalSize::VECTOR_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.rot_dirty.count.i64(), RigCacheBudgetPolicy::LogicalSize::FLAG_BYTES)
            bytes <- RigCacheBudgetPolicy::add_array(bytes, c.pos_dirty.count.i64(), RigCacheBudgetPolicy::LogicalSize::FLAG_BYTES)
            RigCacheBudgetPolicy::admits(bytes, operations)

include "rig_cache_identity.elisa"
