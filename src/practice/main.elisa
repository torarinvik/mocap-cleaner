# practice_take SOURCE.glb OUTPUT.glb [ANIMATION-INDEX]
# Writes a beginner practice copy of SOURCE (see PracticeTake) to OUTPUT.
# OUTPUT must sit inside a build/ folder and differ from SOURCE: source
# takes are never modified.
include "../io/practice_take.elisa"
include "../io/shared_grid.elisa"

extern puts(text: cstr) -> i64

def has_build_folder(path: cstr) -> bool:
    mutable n: usize = 0
    while n < 4096 and path[n] != 0 |n|:
        if n + 7 <= 4096 and path[n] == 47 and path[n + 1] == 98 and path[n + 2] == 117 and path[n + 3] == 105 and path[n + 4] == 108 and path[n + 5] == 100 and path[n + 6] == 47:
            return true
        if n == 0 and path[0] == 98 and path[1] == 117 and path[2] == 105 and path[3] == 108 and path[4] == 100 and path[5] == 47:
            return true
        n <- n + 1
    false

def same_path(a: cstr, b: cstr) -> bool:
    mutable n: usize = 0
    while n < 4096 |n|:
        return false if a[n] != b[n]
        return true if a[n] == 0
        n <- n + 1
    false

def main(argc: i64, argv: mutable void&) -> i64 can[Unsafe.PointerCast, Global{Read, Write}]:
    can Global{Read, Write}:
        if argc < 3:
            _ = puts("usage: practice_take SOURCE.glb OUTPUT.glb [ANIMATION-INDEX]")
            return 2
        slots: mutable cstr&& = argv.cast[mutable cstr&&]
        source: cstr = slots[1].cast[cstr]
        output: cstr = slots[2].cast[cstr]
        mutable anim: usize = 0
        if argc >= 4:
            digits: cstr = slots[3].cast[cstr]
            mutable k: usize = 0
            while k < 6 and digits[k] >= 48 and digits[k] <= 57 |k, anim, digits|:
                anim <- anim * 10 + (digits[k] - 48).usize()
                k <- k + 1
        if not has_build_folder(output) or same_path(source, output):
            _ = puts("practice_take: OUTPUT must be inside a build/ folder and differ from SOURCE")
            return 3
        mutable doc: GlbDocument::Document = catch GlbDocument::load(source):
            value: value
            error failure:
                _ = puts("practice_take: could not read SOURCE as a GLB")
                return 4
        if SharedGrid::align(&doc, anim) is grid:
            doc <- move grid
        if PracticeTake::make(&doc, anim) is practice:
            _ = catch GlbDocument::save(practice, output):
                value: value
                error failure:
                    _ = puts("practice_take: could not write OUTPUT")
                    return 5
            _ = puts("practice_take: wrote a practice take with a two-frame burst and two spikes on arm and leg bones")
            return 0
        _ = puts("practice_take: this animation is too short or has no arm or leg rotations to practise on")
        return 6
